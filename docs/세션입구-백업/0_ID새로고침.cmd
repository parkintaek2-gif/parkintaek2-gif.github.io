@echo off
chcp 65001 >nul
title 세션 ID 새로고침
REM ────────────────────────────────────────────────────────────
REM  여섯 개 cmd 의 세션 ID 를 실물에 맞춘다.
REM
REM  ■ 언제 쓰나
REM     - 버튼을 눌렀는데 엉뚱한 세션이 열릴 때
REM     - PC 를 오래 껐다 켠 뒤 (그 사이 세션이 새로 생겼을 수 있다)
REM     - 그냥 가끔. 눌러서 손해 볼 것이 없다
REM
REM  ■ 안 눌러도 되는 이유
REM     각 버튼이 못 열리면 스스로 실물 ID 를 찾아 다시 엽니다.
REM     이 파일은 그 결과를 **파일에 굳혀** 다음부터 빨리 열리게 하는 것입니다.
REM
REM  ■ 무엇을 고치나
REM     각 cmd 의 `claude --resume <ID>` 한 줄뿐입니다. 다른 줄은 안 건드립니다.
REM ────────────────────────────────────────────────────────────
echo.
node "%~dp0_세션ID-찾기.mjs"
if errorlevel 9009 (
  echo.
  echo  [!] node 를 찾지 못했습니다. Node.js 가 설치돼 있어야 합니다.
  echo.
)
echo.
pause
