---
import Masthead from '../components/Masthead.astro';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import { SITE, SITE_URL, PUBLISHER, ADS } from '../consts';
import { cleanPath } from '../lib/format';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 기사 페이지에서 넘기는 JSON-LD 객체 */
  jsonLd?: unknown;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  /**
   * 이 페이지에는 광고를 **절대** 붙이지 않는다.
   *
   * ⚠ 2026-08-03 KST — 약속이 아니라 코드로 막는 자리다.
   *   Riot 개발자 약관은 **Production 승인 전에 광고를 붙이는 것을 금지**한다.
   *   그런데 `/esports` 는 다른 페이지와 같은 레이아웃을 쓰므로, 나중에 누군가
   *   `ADS.client` 를 채우는 순간 **아무도 의도하지 않은 채로 위반이 된다.**
   *   그리고 그 위반의 벌은 API 접근 영구 박탈이다.
   *
   *   Riot 신청서에 「승인 전에는 광고를 켜지 않는다」고 적었다.
   *   문서에만 적어 두면 언젠가 어긋난다. 여기서 막는다.
   */
  noAds?: boolean;
}

const {
  title,
  description,
  jsonLd,
  ogType = 'website',
  image,
  noindex = false,
  noAds = false,
} = Astro.props;

const path = cleanPath(Astro.url.pathname);
const canonical = path === '/' ? SITE_URL : new URL(path, SITE_URL).href;

// AdSense 「저가치 콘텐츠」 방지(2026-08-24 주의 확인) — 비편집·법무·얇은 지면엔 광고를 아예 싣지 않는다.
// 광고는 실제 편집 콘텐츠(기사·홈·갈래 목록·데이터 지면)에만. noAds prop 이거나 아래 경로면 끈다.
const 비편집경로 = /^\/(terms|privacy|refund|contact|newsletter|community|about|pricing|404)\/?$/.test(path);
const 광고끔 = noAds || 비편집경로;
const ogImage = new URL(image ?? '/og-default.png', SITE_URL).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

const adsPush =
  "document.querySelectorAll('ins.adsbygoogle').forEach(function(){(window.adsbygoogle=window.adsbygoogle||[]).push({})});";

// 사이트 전역 Organization/WebSite 마크업 — YMYL 심사에서 발행 주체 식별에 쓰인다.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE.name,
  legalName: PUBLISHER.legalName,
  url: SITE_URL,
  email: PUBLISHER.email,
  foundingDate: String(PUBLISHER.foundedYear),
  address: { '@type': 'PostalAddress', streetAddress: PUBLISHER.address, addressCountry: 'KR' },
  publishingPrinciples: `${SITE_URL}/about`,
  diversityPolicy: `${SITE_URL}/about`,
  ethicsPolicy: `${SITE_URL}/about`,
};
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      네이버 소유확인 (2026-08-08 · 사장님이 서치어드바이저에서 받아 주신 코드).
      ⚠ `HundredYear.astro` 에 「영문 매체에는 넣지 않는다 — 독자가 해외다」라고 적혀 있었다.
        그건 우리 판단이었고, 사장님이 오늘 직접 서울마켓을 네이버에 등록하셨다.
        한국에서 한국 시장 데이터를 찾는 손님은 네이버로 온다.
      ⛔ 소유확인이 끝나도 **이 태그를 지우지 않는다.** 지우면 확인이 풀린다.
    */}
    <meta name="naver-site-verification" content="fb7b0650be3bca9b51c81a625dc82e78f4fcad0e" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

    {/* 광고를 붙이기 전까지 이 사이트가 부르는 외부 스크립트는 0개다.
        ⚠ noAds 인 페이지에서는 **스크립트 자체를 안 부른다.** 슬롯만 빼면
          Auto Ads 가 스크립트만 보고 알아서 광고를 꽂을 수 있기 때문이다. */}
    {
      ADS.client !== '' && !noAds && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/*
      인쇄본에만 나오는 발행 정보. 화면에서는 보이지 않는다.

      ⚠ 인쇄하면 머리말·꼬리말을 숨기므로 **종이에는 발행 주체가 사라진다.**
        금융(YMYL) 기사에서 누가 냈는지 없는 인쇄본은 출처를 잃은 종이다.
        인쇄된 것도 우리 매체의 얼굴이라는 것이 필수지시 9의 뜻이다.
        (「리포트도, 웹페이지도 고객이 보는 시작과 결과는 엔진보다 더 치밀해야 한다」)
    */}
    <p class="print-only print-imprint">
      {SITE.name} · {PUBLISHER.legalName} · <span>{canonical}</span>
    </p>
    {/* ins 하나당 한 번씩 광고 요청. 페이지당 스크립트 한 줄로 끝낸다. */}
    {ADS.client !== '' && !noAds && <script is:inline set:html={adsPush} />}
  </body>
</html>
