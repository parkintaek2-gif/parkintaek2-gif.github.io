---
/**
 * NextQuestionBrief — **목록·입구 지면**에 다는 짧은 나가는 길.
 *
 * 왜 (2026-08-08 01:2x · 2번)
 * ─────────────────────────────────────────────────────────────────────
 * 1번이 실측으로 잡아 줬다 — **상세 4,206장은 살아 있는데 입구 14장이 비어 있다.**
 * 유입 길을 만들어 놓고 **문 하나를 안 단 것**이었다.
 * 목록에서 들어온 손님은 KLifeMap 으로 갈 자리가 없었다.
 *
 * ⛔ `NextQuestion` 을 그대로 못 쓴다. 그 글은 **낱장에서 숫자를 본 사람**에게 하는 말이다
 *    (「여기까지 보신 숫자는 …입니다」). 목록에는 아직 본 숫자가 없다.
 *    같은 말을 목록에 붙이면 **읽는 사람이 우리가 아무 데나 붙였다는 것을 안다.**
 *
 * ⚠ 지면 규칙은 그대로다 —
 *    · 「해야 한다」·「늦었다」를 쓰지 않는다
 *    · 다른 사이트로 나간다는 것을 밝힌다
 *    · 남의 서비스인 척하지 않는다
 */
import { KLIFEMAP_적성, KLIFEMAP_밝힘, 입구주소 } from '../lib/klifemap';

interface Props {
  /** 이 목록이 무엇을 모아 놓은 것인지 — 「학과 837개」처럼 구체로 */
  모은것: string;
}
const { 모은것 } = Astro.props as Props;
const 나가는주소 = 입구주소(Astro.url?.pathname);
---

{
  KLIFEMAP_적성.준비됨 && 나가는주소 && (
    <section class="nextq-brief">
      <p>
        여기 모아 둔 것은 <strong>{모은것}</strong>입니다. 여럿을 묶은 값이라{' '}
        <strong>한 사람에 대해서는 아무것도 말하지 않습니다.</strong>
      </p>
      <p>
        <a href={나가는주소} rel="noopener">
          {KLIFEMAP_적성.이름} →
        </a>{' '}
        — {KLIFEMAP_적성.설명}
      </p>
      <p class="note">
        ⚠ 누르시면 <strong>{KLIFEMAP_밝힘}</strong> 지면으로 넘어갑니다. 백년지도가 아닙니다.
        로그인 없이 열립니다.
      </p>
    </section>
  )
}

<style is:inline>
  /* ⚠ `is:global` 을 쓰지 않는다 — /_astro/*.css 로 빠져나가 접두사(/100y) 아래서 404 가 난다 */
  .nextq-brief { margin: 30px 0 6px; padding-top: 14px; border-top: 1px solid var(--line); }
  .nextq-brief p { margin: 6px 0; }
  /* 🔴 **21px 이었다** (2026-08-09 05:2x · 375px 실측). 이 구성요소가 4,206장에 붙어 있어
     한 자리를 못 고치면 4,206장이 같이 못 고쳐진다.
     ⚠ 공용 규칙(`.note > a:only-child`)이 여기엔 안 걸린다 — 뒤에 설명 글이 붙어 있어
       `:only-child` 가 아니다. 그래서 이 자리에 따로 적는다. */
  .nextq-brief a { display: inline-flex; align-items: center; min-height: 44px; vertical-align: middle; }
</style>
