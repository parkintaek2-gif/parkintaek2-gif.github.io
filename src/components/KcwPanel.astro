---
/**
 * K Culture Wire — **무엇을 대고 쟀나**(위키백과 판·나라) 한 줄.
 *
 * ── 왜 이 조각이 생겼나 (2026-08-22) ─────────────────────────
 * `check-data-keys-shown` 을 끝까지 돌려 보니 `editionNames` 가 여섯 장, `countryNames` 가
 * 두 장에서 **세어 두고 안 보여 주는 열쇠**로 걸렸다. 지면 글에는 「Indonesia, Vietnam,
 * Thailand and Malaysia」가 **손으로 박혀** 있었다.
 *
 * ⭐ 손으로 박은 이름은 자료가 바뀌어도 안 따라온다. 판을 하나 늘리면 그날부터
 *   지면이 거짓말을 한다. 그러니 **자료에서 읽어 낸다.**
 * ⭐ 이 줄은 손님이 우리를 확인할 수 있게 하는 줄이다 — 「어디를 재고 어디를 안 쟀나」.
 *
 * ⚠ `look-vs-fly` 는 `editionNames` 에 **나라 이름**이 들어 있다(판 이름이 아니다).
 *   그래서 나라표가 없을 때는 문장을 바꿔 쓴다 — 없는 것을 있는 것처럼 읽히게 하지 않는다.
 */
interface Props {
  editionNames?: Record<string, string> | null;
  countryNames?: Record<string, string> | null;
  /** 이 판을 고른 까닭을 자료가 들고 있으면 그대로 낸다 */
  why?: string | null;
}
const { editionNames, countryNames, why } = Astro.props as Props;

const 판 = Object.values(editionNames ?? {});
const 나라 = Object.values(countryNames ?? {});
const 잇기 = (xs: string[]) =>
  xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;
---

{판.length > 0 && (
  <p class="note panel">
    {나라.length > 0 ? (
      <span>
        <b>What this was measured on.</b> {판.length} Wikipedias — the {잇기(판)} editions — which are
        the ones read in {잇기(나라)}. Someone read mostly in another language is under-counted here,
        and we do not correct for it.
      </span>
    ) : (
      <span>
        <b>What this was measured on.</b> {판.length} Wikipedias, covering {잇기(판)}. Reading done
        anywhere else is outside this count, and we do not estimate it.
      </span>
    )}
    {why && <span> {why}</span>}
  </p>
)}

<style>
  .panel { max-width: 46rem; }
</style>
