---
/**
 * K Culture Wire — 이 지면의 자료로 쓴 기사를 스스로 건다.
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 * 2026-08-07 에 세어 보니 기사 12편 중 **7편이 아무 지면에도 안 걸려** 있었다.
 * 첫 화면은 최신 3편만 세우고 사이트맵에는 있지만, **사람이 찾아 들어오는 자리는 지면**이다.
 * 만들고 문을 안 내면 없는 것과 같다.
 *
 * 지면마다 손으로 걸면 **다음 기사 때 또 빠진다.** 그래서 관계를 기사 앞말(`pages`)에 두고
 * 지면은 그걸 **읽기만** 한다. 기사를 내는 순간 지면에 저절로 걸린다.
 *
 * 쓰는 법 — 지면 안에 한 줄
 *   <KcwRelatedArticles page="/watched" />
 *
 * ⛔ 걸린 기사가 없으면 **아무것도 안 그린다.** 빈 「관련 기사」 상자는 없는 것만 못하다.
 */
import { getCollection } from 'astro:content';

interface Props {
  /** 이 지면의 주소. 기사 앞말의 `pages` 와 글자 그대로 맞춘다. */
  page: string;
  /** 제목을 바꾸고 싶을 때만. 기본값이면 그대로 둔다. */
  heading?: string;
}
const { page, heading = 'What we wrote from this data' } = Astro.props;

const 기사 = (await getCollection('kcwArticles'))
  .filter((e) => !e.data.draft && e.data.pages.includes(page))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const 날짜 = (v: Date) =>
  new Date(v).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

{기사.length > 0 && (
  <section class="kcw-rel">
    <h2>{heading}</h2>
    <ul>
      {기사.map((a) => (
        <li>
          <a href={`/article/${a.id}`}>{a.data.title}</a>
          <p class="dek">{a.data.dek}</p>
          <p class="when">
            {날짜(a.data.pubDate)}
            {a.data.corrections.length > 0 && <span class="fix"> · corrected</span>}
          </p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .kcw-rel { margin: 0 0 2.5rem; }
  .kcw-rel h2 { font-size: 1.1rem; margin: 0 0 .7rem; letter-spacing: -.01em; }
  .kcw-rel ul { list-style: none; margin: 0; padding: 0; }
  .kcw-rel li { border-top: 1px solid var(--line); padding: .85rem 0; }
  .kcw-rel a { font-weight: 700; font-size: .96rem; }
  .dek { font-size: .84rem; color: var(--muted); line-height: 1.6; margin: .3rem 0 .25rem; }
  .when { font-size: .76rem; color: var(--muted); margin: 0; }
  /* 정정이 붙은 기사는 목록에서도 그렇게 보인다. 숨기지 않는다. */
  .fix { font-style: italic; }
</style>
