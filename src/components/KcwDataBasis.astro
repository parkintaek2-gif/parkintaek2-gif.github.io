---
/**
 * K Culture Wire — **이 지면의 자료가 무엇이고 무엇이 아닌가**를 손님에게 낸다.
 *
 * ── 왜 이 조각이 생겼나 (2026-09-02) ─────────────────────────
 * `check-data-keys-shown` 을 끝까지 돌려 보니 **44건**이 걸렸다 — 자료 아홉 벌이
 * `whatThisIs`·`whatThisIsNot`·`why…`·센 수를 들고 있으면서 **어느 지면도 안 보여 주고**
 * 있었다. 그 자는 npm test 앞쪽 실패에 막혀 8월 22일 뒤로 한 번도 안 돌았다.
 *
 * ⭐ 이것은 곁가지가 아니라 우리 일의 본체다. 모토와-철학 ③ —
 *   「못 잰 것은 못 쟀다고 적는다」. 세어 두고 안 보여 주면 **안 센 것과 읽기가 같다.**
 * ⭐ 그리고 리스크관리의 자리다 — 「그것이 틀렸을 때 무엇을 잃는가」를 손님 화면에 둔다.
 *
 * ⛔ 조각으로 뽑는 까닭: 지면마다 손으로 적으면 다음 지면에서 또 빠진다.
 *   `KcwMethodLimits.astro` 가 2026-08-22 에 같은 까닭으로 나왔다. 같은 결을 따른다.
 *
 * ── ⚠ 왜 «명시 인자»인가 (자료 덩이를 통째로 안 받는다) ──────
 * 두 까닭이 있고 둘 다 겪은 것이다.
 *   ① 검사가 지면 소스에서 **`변수.열쇠`** 글자를 찾는다. 덩이를 넘기면 그 글자가 안 생겨
 *     「지면이 보여 준다」로 세어지지 않는다. 지면이 열쇠 이름을 «적어야» 한다.
 *   ② 🔴 2026-08-22 에 `KcwMethodLimits` 가 붙은 직후 화면에 **「[object Object]」가 나갔다.**
 *     자료 둘이 `method` 를 객체로 들고 있었는데 전부 문자열이라 여기고 `String(...)` 을 씌운 탓이다.
 *     ⇒ 꼴을 짐작하지 않는다. 지면이 무엇을 어떻게 낼지 «적어» 넘긴다.
 *
 * ⚠ 값이 비면 그 칸을 **안 낸다.** 「없음」이라고 쓰지 않는다 —
 *   재 보지 않은 것과 없는 것은 다른 말이다.
 * ⛔ 화면에 한국어를 안 낸다. 넘기는 글이 한국어면 그 줄을 «버린다» —
 *   영문 매체에 우리말이 새는 것이 빈칸보다 나쁘다(check-kcw-korean-leak 이 잡는다).
 */
interface 수줄 {
  label: string;
  /** 수·글자·목록 중 하나. 목록이면 길이를 낸다 */
  value: unknown;
}
interface Props {
  whatThisIs?: unknown;
  whatThisIsNot?: unknown;
  /** 「왜 이렇게 했나·왜 안 만들었나」 글들. 손님이 우리를 확인하는 글이다 */
  notes?: unknown[];
  counts?: 수줄[];
  heading?: string;
}
const {
  whatThisIs, whatThisIsNot, notes = [], counts = [], heading = 'What this data is',
} = Astro.props;

/** 낼 수 있는 글인가 — 비었거나 우리말이 섞였으면 안 낸다 */
const 낼글 = (v: unknown): string | null => {
  if (typeof v !== 'string') return null;
  const t = v.trim();
  if (!t) return null;
  if (/[가-힣]/.test(t)) return null;
  return t;
};

const 첫글 = 낼글(whatThisIs);
const 아닌글 = 낼글(whatThisIsNot);
const 까닭들 = notes.map(낼글).filter((x): x is string => x !== null);

const 줄들: { 이름: string; 값: string }[] = [];
for (const { label, value } of counts) {
  if (typeof value === 'number' && Number.isFinite(value)) {
    줄들.push({ 이름: label, 값: value.toLocaleString('en-US') });
    continue;
  }
  if (Array.isArray(value)) {
    /* ⚠ 0 이면 낼 것이 없다. 「0개」를 자랑하지 않는다 */
    if (value.length > 0) 줄들.push({ 이름: label, 값: value.length.toLocaleString('en-US') });
    continue;
  }
  const g = 낼글(value);
  if (g) 줄들.push({ 이름: label, 값: g });
  /* ⛔ 그 밖의 꼴은 «아예 안 낸다». 지어내서 옮기지 않는다 */
}

const 낼것있나 = !!첫글 || !!아닌글 || 까닭들.length > 0 || 줄들.length > 0;
---

{낼것있나 && (
  <section class="basis">
    <h2>{heading}</h2>
    {첫글 && <p class="fine">{첫글}</p>}
    {아닌글 && <p class="fine"><b>Not this.</b> {아닌글}</p>}
    {까닭들.map((t) => <p class="fine">{t}</p>)}
    {줄들.length > 0 && (
      <dl class="basis-counts">
        {줄들.map((r) => (
          <>
            <dt>{r.이름}</dt>
            <dd>{r.값}</dd>
          </>
        ))}
      </dl>
    )}
  </section>
)}

<style>
  .basis { margin-top: 2.4rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .basis h2 { font-size: 1.02rem; margin: 0 0 .4rem; }
  .basis .fine { color: var(--muted); font-size: .84rem; margin: .35rem 0; max-width: 64ch; }
  /* 이름과 값을 두 칸으로. ⚠ 좁은 화면에서는 한 줄씩 쌓는다 — 표는 가로로 밀린다 */
  .basis-counts {
    display: grid; grid-template-columns: 1fr auto; gap: .1rem .8rem;
    margin: .7rem 0 0; max-width: 40rem; font-size: .84rem;
  }
  .basis-counts dt { color: var(--muted); }
  .basis-counts dd {
    margin: 0; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink);
  }
  @media (max-width: 30rem) {
    .basis-counts { grid-template-columns: 1fr; }
    .basis-counts dd { text-align: left; margin-bottom: .35rem; }
  }
</style>
