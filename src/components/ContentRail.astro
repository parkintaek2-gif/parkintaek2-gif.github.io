---
/**
 * ContentRail.astro — **콘텐트 옆에 붙는 «우리 콘텐트로 가는 입구» 열.**
 *
 * ── 🔴 왜 만드나 (2026-09-16 · 사장님) ───────────────────────────────────
 *
 * > 「**1칼럼(1열)로 되어있는 걸 2칼럼(2열)로 바꾸자는 뜻...
 * >  상품소개하는 칼럼이 가로가 많이 짧게 해야 하겠지**」
 * > 「**케이컬쳐와이어와 백년지도에는 «자기 콘텐트로 가는 입구»를 만들어**」
 *
 * ⛔ 이 두 사이트에는 «상품»을 붙이지 않는다. 팔 것이 그 손님 것이 아니다.
 *   대신 붙이는 것은 «우리 콘텐트»다 — 갈래·더 읽을 것·자료 지면.
 *
 * ⚠ SeoulMarkets 쪽은 ProductRail.astro 다. 둘을 합치지 않는다 —
 *   같은 틀에 넣으면 언젠가 K팝 지면에 재무데이터가 뜬다.
 *
 * ── 지키는 것 ────────────────────────────────────────────────────────────
 * ```
 * ✅ 1,080px 이상에서만 열로 선다. 좁으면 사라지고 본문이 온 폭을 쓴다
 * ⛔ 모바일에서 본문 «위»에 쌓지 않는다 — 본문 전에 다른 것이 오면 그냥 나간다
 * ⛔ 열이 화면보다 길어지지 않게 한다. 길면 스크롤이 갇힌다
 * ⛔ 목록을 길게 늘어놓지 않는다 — 고르기 힘들면 아무것도 안 누른다
 * ```
 */
interface 칸 { href: string; 이름: string; 한줄?: string; 딱지?: string }
interface Props {
  제목?: string;
  칸들: 칸[];
  더보기?: { href: string; 글: string } | null;
  꼬리?: string | null;
}
const { 제목 = 'More from us', 칸들 = [], 더보기 = null, 꼬리 = null } = Astro.props as Props;
---

{칸들.length > 0 && (
  <aside class="crail" aria-label={제목}>
    <div class="crail-in">
      <span class="crail-kicker">{제목}</span>
      <ul class="crail-list">
        {칸들.slice(0, 6).map((x) => (
          <li>
            <a href={x.href}>
              {x.딱지 && <span class="cl-tag">{x.딱지}</span>}
              <span class="cl-name">{x.이름}</span>
              {x.한줄 && <span class="cl-one">{x.한줄}</span>}
            </a>
          </li>
        ))}
      </ul>
      {더보기 && <a class="crail-more" href={더보기.href}>{더보기.글} &rarr;</a>}
      {꼬리 && <span class="crail-fine">{꼬리}</span>}
    </div>
  </aside>
)}

<style>
  .crail { display: none; }

  @media (min-width: 1080px) {
    .crail { display: block; }
    .crail-in {
      position: sticky; top: 1.2rem;
      max-height: calc(100vh - 2.4rem); overflow-y: auto;
      padding: 1rem 1.05rem;
      border: 1px solid var(--line, #e5e5e5); border-radius: 10px;
      background: var(--card, transparent);
      font-size: .84rem; line-height: 1.5;
    }
  }

  .crail-kicker {
    display: block; font-size: .68rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    color: var(--accent, #0f4c81); margin-bottom: .6rem;
  }
  .crail-list { list-style: none; margin: 0 0 .7rem; padding: 0; }
  .crail-list li + li { margin-top: .7rem; padding-top: .7rem; border-top: 1px solid var(--line, #eee); }
  .crail-list a { text-decoration: none; color: inherit; display: block; }
  .crail-list a:hover .cl-name { color: var(--accent, #0f4c81); }
  .cl-tag { display: block; font-size: .62rem; font-weight: 700; letter-spacing: .05em;
    text-transform: uppercase; color: var(--accent, #0f4c81); }
  .cl-name { display: block; font-weight: 650; margin: .05rem 0; }
  .cl-one { display: block; font-size: .76rem; color: var(--muted, #666); }
  .crail-more {
    display: block; margin-top: .3rem; padding: .5rem;
    border-radius: 6px; background: var(--accent, #0f4c81); color: #fff;
    text-align: center; font-weight: 700; text-decoration: none; font-size: .82rem;
  }
  .crail-more:hover { opacity: .88; }
  .crail-fine { display: block; margin-top: .5rem; font-size: .7rem; color: var(--muted, #777); line-height: 1.45; }
</style>
