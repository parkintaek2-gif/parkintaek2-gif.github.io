---
/**
 * K Culture Wire — **카드뉴스로 가는 문.**
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 * 🔴 2026-08-14 에 세어 보니 카드뉴스 15장이 서버에 올라가 있는데
 *   **사이트맵에도 어느 지면에도 안 걸려 있었다.** 만든 값이 0이었다.
 * 🔴 사장님(8/13): 「이건 **외부유입용** 콘텐트 역할도 하고, 우리를 알리는 거니까」
 *   → 그러면 사람이 **집어 갈 수 있어야** 한다. 서버에 있는 것과 걸린 것은 다르다.
 *
 * ── ⛔ 지키는 것 ──────────────────────────────────────────────
 * ⛔ 벌이 없으면 **아무것도 안 그린다.** 빈 「카드뉴스」 상자는 없는 것만 못하다.
 * ⚠ 넘겨 보게 하지 않는다 — 다섯 장을 **한 줄로 늘어놓고** 옆으로 밀게 한다.
 *   넘김 단추를 만들면 자바스크립트가 필요하고, 정적 지면에서 그것은 값이 안 맞는다.
 */
import headlines from '../data/wikitip-headlines.json';
import { 대체글 } from '../../scripts/build-kcw-headlines.mjs';

interface Props {
  /** 벌 이름. `public/wikitip/cardnews/<벌>/01.png` 다 */
  set: string;
  /** 몇 장인가. ⚠ 손으로 적지 않게 부르는 쪽에서 넘긴다 */
  count?: number;
  heading?: string;
}
const { set, count = 5, heading = 'Card set — free to share' } = Astro.props;

/*
 * 🔴 2026-08-25 저녁, 사장님 —
 *   「영상만 얘기하는 게 아니고, **텍스트, 카드, 카드뉴스** 등 다양한 유형의 콘텐트를
 *    **SEO와 적절한 검색어 선택**, 해시태그 등을 생각하며 만들라는 뜻」
 *
 * 그 말씀으로 재 보니 이 자리의 대체글이 **「Card 1 of 5」**였다. 105장이 그랬다.
 * 구글 이미지가 읽는 것이 바로 그 글자다 — **어떤 말로도 안 걸린다.**
 * ⚠ 그림이라 검색과 무관하다고 여겨 오래 빠뜨린 자리다. 기사 지면 948장은 이미
 *   머리글을 넣고 있었는데, 자료 지면 21장만 이 부품을 써서 빠져 있었다.
 *
 * ⭐ 부르는 쪽 21곳을 고치지 않는다 — **여기 한 곳**에서 지면 주소로 머리글을 찾는다.
 *   `build-kcw-headlines.mjs` 가 «지어진 지면»에서 읽어 둔 것이라 수까지 진짜다.
 * ⛔ 못 찾으면 「Card n of m」으로 되돌아가지 않는다 — 벌 이름이라도 말이 되게 편다.
 *   대체글이 없는 것보다 나쁜 것은 «아무 뜻 없는 대체글»이다.
 */

/*
 * ⚠ 주소가 «한 꼴이 아니다». 지어질 때는 `/wikitip/malaysia` 인데 손님이 보는 주소는
 *   `/malaysia` 이고, 표의 열쇠는 뒤엣것이다. 끝의 빗금과 `.html` 도 붙었다 뗐다 한다.
 * 🔴 처음에 한 꼴만 맞춰 봤다가 **105장이 전부 벌 이름으로 떨어졌다** — 「actors — card 1 of 5」.
 *   ⛔ 이때 화면이 «그럴듯해» 보였다. 떨어진 것을 눈으로 못 알아본다. 그래서 재서 알았다.
 * ⭐ 그러니 있을 수 있는 꼴을 모두 대 보고, **그래도 못 찾으면 벌 이름으로 편다**.
 */
const 날주소 = (Astro.url?.pathname ?? '').replace(/\.html$/, '').replace(/\/+$/, '');
const 후보 = [
  날주소,
  날주소.replace(/^\/wikitip/, ''),
  날주소 ? '/' + 날주소.split('/').filter(Boolean).pop() : '',
].filter(Boolean);
const 머리 = 후보.map((k) => (headlines.headlines as any)[k]).find(Boolean) ?? null;
const 벌펴기 = String(set).replace(/[-_]+/g, ' ').trim();
const 대체 = (i: number) => 대체글(머리 ?? 벌펴기, i, count);
const 장 = Array.from({ length: count }, (_, i) => `/cardnews/${set}/${String(i + 1).padStart(2, '0')}.png`);
---

<section class="kcw-cards">
  <h2>{heading}</h2>
  <p class="note">
    Five cards, 1080×1350. Every figure on them is in the table on this page. Take them.
  </p>
  <div class="strip">
    {장.map((src, i) => (
      <a href={src} target="_blank" rel="noopener">
        <img src={src} alt={대체(i + 1)} width="216" height="270" loading="lazy" />
      </a>
    ))}
  </div>
</section>

<style>
  .kcw-cards { margin: 2.5rem 0; }
  .strip {
    display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem;
    scroll-snap-type: x mandatory;
  }
  .strip a { flex: none; scroll-snap-align: start; }
  .strip img {
    display: block; width: 216px; height: auto; border-radius: 6px;
    border: 1px solid #2a2438;
  }
</style>
