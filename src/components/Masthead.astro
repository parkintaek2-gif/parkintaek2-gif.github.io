---
import { SITE, CATEGORIES } from '../consts';
import { cleanPath } from '../lib/format';

const path = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => (path === href ? 'page' : undefined);

// 붙여 쓴 이름이라 공백 없이 이어 붙인다 — Seoul + Markets
const [head, ...tail] = SITE.nameParts;
---

<header class="masthead">
  <div class="wrap masthead__bar">
    <a class="logo" href="/" aria-label={SITE.name}>{head}<span>{tail.join('')}</span></a>
    <nav class="nav" aria-label="Sections">
      {/* 🔴 [2026-09-12 · 5번] 사장님 지시로 «상품»을 차림표 맨 앞에 세웠다.
          > 「메뉴도 제일 앞에 주식이 아닌 우리 상품 소개가 제일 앞에 있어야 한다.
          >  주력이 뭔지 염두에 둬야지」
          ⛔ 전에는 Equities 가 맨 앞이었다. 그러면 손님은 이곳을 «증시 소식 읽는 곳»으로 읽는다.
             우리 주력은 자료이고, 차림표 첫 칸이 그것을 말해야 한다.
          ⚠ 이름도 Data → «Data Products» 로 바꾼다. 「Data」한 마디는 무료 자료로 읽힌다. */}
      <a class="nav-lead" href="/data" aria-current={isCurrent('/data')}>Data Products</a>
      {
        CATEGORIES.map((c) => (
          <a href={`/${c.slug}`} aria-current={isCurrent(`/${c.slug}`)}>
            {c.label}
          </a>
        ))
      }
      {/* 영상 갤러리 — 가장 센 방문 축(구글 비디오). 모든 지면 내비에서 걸어 사람·크롤러가 닿게 한다(2026-08-24). */}
      <a href="/video" aria-current={isCurrent('/video')}>Video</a>
      <a href="/api" aria-current={isCurrent('/api')}>API</a>
      <a href="/about" aria-current={isCurrent('/about')}>About</a>
    </nav>
  </div>
</header>

<style>
  /* 🔴 주력을 차림표에서 «보이게» 한다 — 맨 앞에 두는 것만으로는 옆 칸과 똑같아 보인다.
     ⚠ 폰(<480px)에서 차림표는 가로로 스크롤되는 통이다. 줄바꿈을 막아 두 줄로 깨지지 않게 한다. */
  .nav-lead {
    font-weight: 700;
    white-space: nowrap;
    padding-right: .55rem;
    margin-right: .15rem;
    border-right: 1px solid var(--line, #d7d7d7);
  }
</style>
