---
/**
 * RankBars — **순위를 막대로 그린다.** 유닛 공용 부품.
 *
 * ── 왜 이 부품이 생겼나 (2026-09-01 · 5번) ────────────────────────────
 * 사장님: 「콘텐트 제목도 사람들의 이목을 끌어 클릭할 수 있게 만들어, **그래프**도 만들고,
 *   그 안에서 우리가 하고 싶은 얘기를 해, **데이터로**… **댓글**을 달 수 있게 해」
 *   「사람들의 관심을 갖는 순위를 다 찾아 공개해」
 *
 * ⚠ 우리 순위 지면(`/most-read`)에는 **표만 있고 그래프가 하나도 없었다.** 표는 백 줄을
 *   훑어야 모양이 보인다. 막대는 한눈에 보인다 — 사장님이 「그래프도 만들고」라고
 *   이르신 까닭이다.
 * ⭐ 3번·6번도 순위 지면을 내라는 지시를 같이 받았다. 그래서 지면에 박지 않고 «부품»으로 뺀다.
 *
 * ── 색은 지어내지 않았다 ─────────────────────────────────────────────
 * dataviz 지침의 검증기(`validate_palette.js`)를 우리 지면의 «실제» 바탕색에 대고 돌렸다.
 * ```
 * 밝은 지면 #f6f4fa   #6b3fa0 · #eb6834   전 항목 통과
 *                     ⚠ 주황은 바탕 대비 2.93:1 — 3:1 미만이라 «값을 글자로 직접» 적어야 한다
 *                       (그래서 막대 끝마다 수를 적는다. 표도 같은 지면에 있다)
 * 어두운 지면 #1c1826  #9a72d6 · #d95926   전 항목 통과
 *                     ⛔ 지면 강조색 #b491e8 을 그대로 쓰면 밝기 띠(L 0.48~0.67)를 벗어나
 *                       FAIL 이 났다. 어두운 쪽만 한 단 내려 잡았다
 * ```
 * ⛔ 두 자(읽힌 수 · 언어 수)를 «한 그림에 두 축»으로 겹치지 않는다. 눈금이 다른 것을
 *   한 축에 얹으면 없는 관계가 보인다. 그래서 부품을 «두 번» 부른다.
 */
interface 줄 { name: string; value: number; href?: string | null; note?: string | null }
interface Props {
  rows: 줄[];
  /** 값이 무엇인지 — 축 이름이자 도움말에 들어간다 */
  valueLabel: string;
  /** 'a' 읽힌 수(보라) · 'b' 견주는 자(주황) */
  tone?: 'a' | 'b';
  /** 막대 밑에 붙는 한 줄 — 이 그림이 무엇으로 «줄 세워졌는지»를 반드시 적는다 */
  caption?: string;
  /** 순위 번호를 붙이나 */
  numbered?: boolean;
}
const { rows, valueLabel, tone = 'a', caption, numbered = true } = Astro.props as Props;

/* ⛔ 빈 자료를 0 으로 채워 그리지 않는다 — 「못 쟀다」고 적고 그림을 안 낸다 */
const 성한줄 = (rows ?? []).filter((r) => r && Number.isFinite(r.value));
const 못쓴줄 = (rows ?? []).length - 성한줄.length;
const 가장큰값 = 성한줄.reduce((a, r) => Math.max(a, r.value), 0);

/* 얼개 — 줄 높이·막대 두께는 지침(얇은 막대·4px 둥근 끝)을 따른다 */
const 줄높이 = 24, 막대두께 = 12, 이름칸 = 168, 값칸 = 92, 왼여백 = 4;
const 폭 = 760;
const 그림높이 = 성한줄.length * 줄높이 + 8;
const 막대칸 = 폭 - 이름칸 - 값칸 - 왼여백;
const 길이 = (v: number) => (가장큰값 > 0 ? Math.max(2, (v / 가장큰값) * 막대칸) : 2);
const 수 = (v: number) => v.toLocaleString('en-US');
---

{성한줄.length === 0 ? (
  <p class="rb-none">We could not measure this — nothing is drawn here rather than a chart of zeros.</p>
) : (
  <figure class={`rb rb-${tone}`}>
    <div class="rb-scroll">
      <svg viewBox={`0 0 ${폭} ${그림높이}`} width="100%" height={그림높이}
        role="img" aria-label={`${valueLabel} — ${성한줄.length} rows, largest ${수(가장큰값)}`}>
        {성한줄.map((r, i) => {
          const y = i * 줄높이 + 4;
          const w = 길이(r.value);
          return (
            <g>
              {/* 실선 눈금은 안 깐다 — 막대 끝에 수를 직접 적으므로 격자가 없어도 읽힌다 */}
              <title>{`${r.name} — ${수(r.value)} ${valueLabel}`}</title>
              {numbered && (
                <text x={왼여백 + 18} y={y + 막대두께 - 1} class="rb-rank" text-anchor="end">{i + 1}</text>
              )}
              <text x={왼여백 + 26} y={y + 막대두께 - 1} class="rb-name">{r.name}</text>
              {/* 4px 둥근 끝 · 바탕과 2px 틈이 생기도록 줄높이(24)보다 얇게(12) 둔다 */}
              <rect x={이름칸} y={y} width={w} height={막대두께} rx="4" class="rb-bar" />
              <text x={이름칸 + w + 8} y={y + 막대두께 - 1} class="rb-val">{수(r.value)}</text>
            </g>
          );
        })}
      </svg>
    </div>
    {caption && <figcaption class="rb-cap">{caption}</figcaption>}
    {못쓴줄 > 0 && (
      <figcaption class="rb-cap rb-warn">
        {못쓴줄} {못쓴줄 === 1 ? 'row' : 'rows'} carried no number and were left out of the chart —
        they are absent, not zero.
      </figcaption>
    )}
  </figure>
)}

<style>
  .rb { margin: 0.6rem 0 1rem; }
  .rb-scroll { overflow-x: auto; }
  .rb-scroll svg { min-width: 520px; display: block; }

  /* 색 — 지면 바탕에 대고 검증기를 돌려 고른 값이다. ⛔ 눈으로 골라 바꾸지 않는다 */
  .rb-a { --bar: #6b3fa0; }
  .rb-b { --bar: #eb6834; }
  @media (prefers-color-scheme: dark) {
    /* ⛔ 지면 강조색 #b491e8 은 어두운 쪽 밝기 띠를 벗어나 FAIL 이었다 — 한 단 내려 잡는다 */
    .rb-a { --bar: #9a72d6; }
    .rb-b { --bar: #d95926; }
  }

  .rb-bar { fill: var(--bar); }
  /* 글자는 계열색을 입지 않는다 — 지침 그대로. 이름·값은 잉크색으로 둔다 */
  .rb-name { fill: var(--ink); font-size: 12.5px; }
  .rb-val  { fill: var(--ink); font-size: 12.5px; font-variant-numeric: tabular-nums; }
  .rb-rank { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .rb-cap { color: var(--muted); font-size: .82rem; margin-top: .35rem; }
  .rb-warn { color: #b45309; }
  .rb-none { color: #b45309; font-size: .9rem; }

  @media (max-width: 520px) {
    .rb-name { font-size: 11.5px; }
    .rb-val { font-size: 11.5px; }
  }
</style>
