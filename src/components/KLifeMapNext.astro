---
/**
 * KCW 지면 끝의 「Where to go next」에 붙는 **KLifeMap 입구 한 줄.**
 *
 * ⛔ 배너가 아니다. 2번 지시 — *「배너를 붙이지 마십시오. 그 지면에서 이어지는
 *   «다음 물음»으로 적습니다」*. 그래서 `<li>` 하나로 나가고, 목록의 다른 줄과 같은 꼴이다.
 *
 * ⚠ 다른 사이트로 넘어간다는 것을 **반드시 밝힌다.** 안 밝히면 손님이 우리 지면인 줄
 *   알고 눌렀다가 뒤로 나간다 — 그건 유입이 아니라 이탈이다.
 *
 * ⚠ `준비됨` 이 false 인 입구는 **아무것도 그리지 않는다.** 도착지가 로그인 화면이거나
 *   404 면 링크를 거는 뜻이 없다(3번이 겪은 것을 그대로 가져왔다).
 */
import { 다른사이트밝힘, type 입구 } from '../lib/klifemap-en';

interface Props {
  입구: 입구;
  /** 이 지면의 맥락 한 조각 — 있으면 물음 앞에 붙는다 (예: 인물 이름) */
  맥락?: string;
}
const { 입구: 문, 맥락 } = Astro.props as Props;
---

{문.준비됨 && (
  <li class="klm">
    <a href={문.주소} rel="noopener">
      {맥락 ? `${맥락}’s date — and yours: ` : ''}{문.물음}
    </a>
    {' '}<span class="fine">&mdash; {문.까닭} Opens {다른사이트밝힘}.</span>
  </li>
)}

<style>
  .klm .fine { opacity: .75; font-size: .9em; }
</style>
