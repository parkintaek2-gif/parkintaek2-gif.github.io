---
/* 🔴 사장님 지시 (2026-09-27) — 한국경제 기사에서 「구글 검색 선호 출처로 추가」 단추를 보시고
 *   「**이게 뭔지 알아보고 도입할 수 있으면 도입하자**」
 *
 * 무엇인가 — Google Preferred Sources.
 *   손님이 구글 계정에 우리를 「선호하는 출처」로 담아 두면 **Top Stories 에 우리 기사가
 *   더 자주 올라간다.** 구글이 낸 실측은 「Top Stories 유입 2배」다.
 *   뉴스 승인은 필요 없다. 도메인·서브도메인 단위이고 모든 언어를 받는다.
 *
 * 🔴 2026-09-27 에 네 도메인의 자격을 «실측»했다 (구글 도구에 넣어 보았다) —
 *     100yearmap.com   ✅ 뜬다        klifemap.ai   ✅ 뜬다
 *     seoulmarkets.com 🔴 결과 없음   kculturewire.com 🔴 결과 없음
 *   대조군으로 hankyung.com 을 넣어 「한국경제 hankyung.com」이 뜨는 것을 확인했다 —
 *   자가 맞다. 서치콘솔 속성 꼴은 넷이 같고(sc-domain), 노출은 오히려 klifemap 이 제일
 *   적다(28일 8회). ⇒ 가른 것은 **구글이 그 도메인을 «출처»로 아는가**였다.
 *   그래서 Publisher Center 에 Seoul Markets · K Culture Wire 를 간행물로 직접 넣었다.
 *
 * ⭐ 그래서 이 조각은 **자격이 없어도 달아 둔다.** 구글이 출처로 잡지 못하면 단추가
 *   안 그려질 뿐이고, 잡는 날 저절로 켜진다. 그날 사람이 기억해서 붙일 일이 없다.
 * ⛔ 단추가 안 그려졌는데 안내 글만 남지 않게 한다 — 안 켜지면 칸 자체를 안 낸다.
 *
 * ⛔ klifemap.ai 에는 달지 않는다. 자격은 있으나 뉴스를 내는 곳이 아니라
 *   Top Stories 에 오를 일이 없고, 값을 받는 화면의 CSP 를 넓히는 비용만 남는다.
 */
/* ⚠ props 이름은 «영문»으로 둔다 — 앞서 한글 이름으로 두었더니 레이아웃이 넘긴 값이
 *   조용히 안 닿아 백년지도가 영어 문구로 나갔다. 컴포넌트 이름도 같은 까닭으로 대문자다
 *   (Astro 는 소문자로 시작하는 태그를 HTML 요소로 보고 통째로 버린다 — 실제로 한 번 버렸다). */
interface Props { lang?: 'ko' | 'en' }
const { lang = 'en' } = Astro.props;

const 글 = lang === 'ko'
  ? {
      머리: '구글 검색에서 더 자주 보기',
      밑: '구글 계정에 선호하는 출처로 담아 두면, 구글 검색 상단 뉴스에 우리 글이 더 자주 나옵니다.',
    }
  : {
      머리: 'See us more often on Google',
      밑: 'Add us as a preferred source and our reporting appears more often in Google’s Top Stories.',
    };
---

<div id="prefsrc" class="prefsrc" hidden>
  <p class="prefsrc-h">{글.머리}</p>
  <p class="prefsrc-s">{글.밑}</p>
  <div google-add-preferred-source-btn></div>
</div>

<script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
<script is:inline>
  /* 구글이 단추를 실제로 그렸을 때만 칸을 보인다.
     ⛔ 「스크립트를 넣었다」를 「단추가 떴다」로 세지 않는다 — 자격이 없으면 안 그려진다. */
  (function () {
    var 칸 = document.getElementById('prefsrc');
    if (!칸) return;
    var 자리 = 칸.querySelector('[google-add-preferred-source-btn]');
    if (!자리) return;
    var 켠다 = function () {
      if (자리.childElementCount > 0) { 칸.hidden = false; return true; }
      return false;
    };
    if (켠다()) return;
    var 보는눈 = new MutationObserver(function () { if (켠다()) 보는눈.disconnect(); });
    보는눈.observe(자리, { childList: true, subtree: true });
    /* 15초 안에 안 그려지면 구글이 우리를 출처로 모르는 것이다. 조용히 접는다. */
    setTimeout(function () { 보는눈.disconnect(); }, 15000);
  })();
</script>

<style>
  .prefsrc {
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 10px;
    max-width: 34rem;
  }
  .prefsrc-h { margin: 0 0 0.2rem; font-weight: 600; font-size: 0.95rem; }
  .prefsrc-s { margin: 0 0 0.7rem; font-size: 0.85rem; opacity: 0.78; line-height: 1.5; }
</style>
