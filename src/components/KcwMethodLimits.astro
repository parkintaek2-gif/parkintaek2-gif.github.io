---
/**
 * K Culture Wire — **어떻게 쟀나 · 무엇을 못 말하나** 두 칸.
 *
 * ── 왜 이 조각이 생겼나 (2026-08-22) ─────────────────────────
 * `check-data-keys-shown` 을 끝까지 돌려 보니 **70건**이 걸렸고, 그중 26건이
 * `method`(14) 와 `limitation`(12) 이었다 — 지면 열다섯 장이 **어떻게 쟀는지도,
 * 무엇을 못 말하는지도 손님에게 안 알려 주고** 있었다. 자료 파일 안에만 있었다.
 *
 * ⭐ 이것은 곁가지가 아니라 우리 일의 본체다. 모토와-철학 ③ —
 *   「못 잰 것은 못 쟀다고 적는다」. 잰 한계를 안 적으면 그 지면의 수는 규범으로 읽힌다.
 * ⭐ 리스크관리의 자리이기도 하다 — 「그것이 틀렸을 때 무엇을 잃는가」를 손님 화면에 둔다.
 *
 * ⛔ 조각으로 뽑는 까닭: 열다섯 장에 손으로 적으면 열여섯 번째 장에서 또 빠진다.
 * ⚠ 값이 비면 **그 칸을 아예 안 낸다.** 「한계 없음」이라고 쓰지 않는다 —
 *   재 보지 않은 것과 한계가 없는 것은 다른 말이다.
 *
 * 🔴🔴 2026-08-22 — 붙인 직후 `check-visitor-walk` 가 잡았다: `/wave-and-floor` 화면에
 *   **「[object Object]」가 나갔다.** 두 파일은 `method` 를 **객체**로 들고 있다
 *   (`wikitip-wave-floor.json`·`wikitip-one-out.json`). 나는 전부 문자열이라 여기고
 *   `String(...)` 을 씌웠다. 짐작한 꼴로 화면을 만들면 그 꼴이 아닌 날 손님이 쓰레기를 본다.
 *   ⭐ 객체는 **칸을 갈라** 낸다. 그것이 자료가 그 꼴로 있는 까닭이다.
 *   ⛔ 못 읽는 꼴이면 **아예 안 낸다** — 지어내서 옮기지 않는다.
 */
interface Props {
  method?: unknown;
  limitation?: unknown;
  /** 이 지면의 자를 쓰는 다른 지면·조각으로 보내는 줄. 없으면 안 낸다 */
  note?: string | null;
}
const { method, limitation, note } = Astro.props as Props;

/**
 * 값 하나를 화면에 낼 꼴로 바꾼다.
 * 문자열·수 → 한 줄 / 객체 → 칸 목록 / 그 밖(배열·null) → 안 낸다
 *
 * 🔴 2026-08-22 — 이 함수에 `export` 를 붙였다가 **빌드가 죽었다**
 *   (`ReferenceError: 칸이름 is not defined`). Astro 는 `export` 한 함수를 딴 스코프로 옮기므로
 *   조각 안의 다른 상수가 안 보인다. `[slug].astro` 에 같은 덫이 적혀 있었는데 또 밟았다.
 *   ⭐ 그래서 `export` 를 안 하고, 쓰는 값도 **함수 안**에 둔다. 시험은 자 쪽에 있다
 *   (`scripts/check-kcw-object-leak.mjs`).
 */
function 낼꼴(값: unknown): { 꼴: 'none' } | { 꼴: 'text'; 글: string } | { 꼴: 'rows'; 줄: { 이름: string; 글: string }[] } {
  /** 사람이 읽는 이름으로 바꾼다. ⚠ 모르는 이름은 그대로 둔다 — 지어내지 않는다 */
  const 칸이름: Record<string, string> = {
    name: 'Name', how: 'How it works', why: 'Why this one', note: 'Note',
    origin: 'Origin', knownFailure: 'Known failure', threshold: 'Threshold',
    floorMonths: 'Months of floor', waveMonths: 'Months of wave',
    thinFloorBelow: 'Counted as too thin below', secondWaveAbove: 'Counted as a second wave above',
  };
  if (값 === null || 값 === undefined || 값 === '') return { 꼴: 'none' };
  if (typeof 값 === 'string' || typeof 값 === 'number' || typeof 값 === 'boolean') {
    return { 꼴: 'text', 글: String(값) };
  }
  if (Array.isArray(값)) {
    const 글들 = 값.filter((x) => typeof x === 'string' || typeof x === 'number').map(String);
    return 글들.length ? { 꼴: 'text', 글: 글들.join(' ') } : { 꼴: 'none' };
  }
  if (typeof 값 === 'object') {
    const 줄 = Object.entries(값 as Record<string, unknown>)
      .filter(([, v]) => typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean')
      .map(([k, v]) => ({ 이름: 칸이름[k] ?? k, 글: String(v) }));
    return 줄.length ? { 꼴: 'rows', 줄 } : { 꼴: 'none' };
  }
  return { 꼴: 'none' };
}

const 쓸것 = [
  { 제목: 'How this was measured', 값: 낼꼴(method) },
  { 제목: 'What this cannot tell you', 값: 낼꼴(limitation) },
].filter((x) => x.값.꼴 !== 'none');
---

{쓸것.length > 0 && (
  <section class="src method-limits">
    {쓸것.map((x) => (
      <div>
        <h2>{x.제목}</h2>
        {x.값.꼴 === 'text' && <p class="note">{(x.값 as any).글}</p>}
        {x.값.꼴 === 'rows' && (
          <ul>
            {(x.값 as any).줄.map((r: any) => (
              <li class="note"><b>{r.이름}</b> — {r.글}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
    {note && <p class="note">{note}</p>}
  </section>
)}

<style>
  .method-limits h2 { margin-top: 1.1rem; }
  .method-limits p, .method-limits li { max-width: 46rem; }
</style>
