---
/**
 * `/trial` — **체험 신청(Request a trial).**
 *
 * 🔴 [2026-09-28 · 5번] 사장님이 한경에이셀(aiceltech.com)을 보라 하셨다.
 *   그쪽 상품 지면과 우리 것을 나란히 놓고 보니, **에이셀에 있고 우리에게만
 *   없던 입구가 이것 하나**였다 — 값을 보고 마음이 동한 기관 손님이
 *   「일단 한 번 써 보겠다」고 말할 자리.
 *
 *   우리 `/pricing` 에는 값 셋과 「Buy →」만 있었다. B2B 자료를 값만 보고
 *   카드부터 꺼내는 손님은 드물다. **먼저 표본을 받아 보고, 쓸 만하면 산다.**
 *   그 사이 단계가 없으면 손님은 값만 보고 조용히 떠나고, 우리는 떠난 줄도 모른다.
 *
 * ⛔ 이 폼은 «결제»가 아니다. 카드·계좌를 묻지 않는다.
 * ⛔ 손님 이메일은 저장소에 적히지 않는다 — 서버가 해시 이름으로 스토리지에 넣는다.
 * ⚠ 값은 여기 다시 적지 않고 /pricing 으로 보낸다. 값이 두 곳에 있으면 언젠가 어긋난다.
 */
import Base from '../layouts/Base.astro';

const TITLE = 'Request a trial';
const DESC = 'Get a sample file and the current licensing terms for any SeoulMarkets dataset — '
  + 'Korea, Japan, Taiwan, Hong Kong and the UAE. No card, no account.';

/* ⚠ 이 목록의 값(value)은 src/lib/trial.mjs 의 「아는상품」과 짝이어야 한다.
   어긋나면 서버가 전부 'other' 로 받아 무엇을 달라는지 영영 모른다. */
const 상품들 = [
  ['korea-segments', 'Korea — segment P&L (business divisions)'],
  ['korea-financials', 'Korea — company financials (DART)'],
  ['korea-disclosures', 'Korea — material disclosures'],
  ['korea-trade', 'Korea — trade by partner country'],
  ['uae-disclosures', 'UAE — material disclosures (ADX + DFM)'],
  ['uae-financials', 'UAE — company financials'],
  ['japan', 'Japan — EDINET filings'],
  ['taiwan', 'Taiwan — TWSE listings'],
  ['hongkong', 'Hong Kong — listings and financials'],
  ['all', 'Everything in the catalogue'],
  ['other', 'Something else — I will describe it below'],
];
---

<Base title={TITLE} description={DESC} noAds>
  <div class="wrap">
    <article class="tp">
      <p class="kicker">SeoulMarkets</p>
      <h1>Request a trial</h1>
      <p class="lead">
        Tell us which dataset you need and we send a <b>sample file</b> — real rows, the data
        dictionary, and the current licensing terms. No card, no account, no sales call.
      </p>

      <ul class="what">
        <li><b>A real extract</b>, not a brochure — the same columns as the paid tape.</li>
        <li><b>The dictionary</b> — every field, its unit, and what it excludes.</li>
        <li><b>What we could not measure</b>, written down. We do not fill gaps with zeros.</li>
      </ul>

      <form id="trialform" novalidate>
        <div class="row">
          <label for="t-email">Work email <span class="req">required</span></label>
          <input id="t-email" name="email" type="email" autocomplete="email"
                 placeholder="you@firm.com" required />
        </div>
        <div class="two">
          <div class="row">
            <label for="t-org">Organisation</label>
            <input id="t-org" name="org" type="text" autocomplete="organization"
                   placeholder="Fund, bank, university, desk" />
          </div>
          <div class="row">
            <label for="t-role">Your role</label>
            <input id="t-role" name="role" type="text" autocomplete="organization-title"
                   placeholder="Analyst, PM, researcher" />
          </div>
        </div>
        <div class="row">
          <label for="t-want">Which dataset</label>
          <select id="t-want" name="want">
            {상품들.map(([v, 글]) => <option value={v}>{글}</option>)}
          </select>
        </div>
        <div class="row">
          <label for="t-note">What are you trying to do?</label>
          <textarea id="t-note" name="note" rows="3"
            placeholder="Which markets, which years, and what you need it for. The more specific, the better the sample."></textarea>
        </div>
        {/* 봇 덫 — 사람 눈에 안 보인다. 채워져 오면 자동 제출이다.
            ⛔ aria-hidden 과 tabindex=-1 을 함께 둔다. 화면낭독기 손님이 이 칸에 걸리면 안 된다 */}
        <div class="hp" aria-hidden="true">
          <label for="t-hp">Leave this empty</label>
          <input id="t-hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="t-send">Send request →</button>
        <p class="note" id="t-note-out" role="status" aria-live="polite"></p>
      </form>

      <p class="fine">
        We reply from <a href="mailto:admin@klifedesign.net">admin@klifedesign.net</a> within one
        business day. We keep your address only to answer you and to tell you when a file changes —
        see our <a href="/privacy">privacy policy</a>. Already know what you want?{' '}
        <a href="/pricing">See pricing</a> or <a href="/data">browse the catalogue</a>.
      </p>
    </article>
  </div>
</Base>

<script>
  /* ⚠ 폼을 기본 제출(page reload)로 두지 않는다 — 정적 지면이라 돌아올 자리가 없다.
     ⛔ 보내는 동안 단추를 잠근다. 두 번 눌러 두 건이 들어오면 손님이 두 명으로 세어진다. */
  const f = document.getElementById('trialform');
  const 단추 = document.getElementById('t-send');
  const 말 = document.getElementById('t-note-out');
  if (f && 단추 && 말) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const email = String(d.get('email') || '').trim();
      if (!email || !email.includes('@')) {
        말.textContent = 'Please enter an email address we can reply to.';
        말.className = 'note bad';
        return;
      }
      단추.disabled = true;
      const 옛 = 단추.textContent;
      단추.textContent = 'Sending…';
      말.textContent = '';
      말.className = 'note';
      try {
        const r = await fetch('/v1/trial', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            org: String(d.get('org') || ''),
            role: String(d.get('role') || ''),
            want: String(d.get('want') || ''),
            note: String(d.get('note') || ''),
            hp: String(d.get('hp') || ''),
          }),
        });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) {
          말.textContent = j.message || 'Request received. We will be in touch.';
          말.className = 'note good';
          f.querySelectorAll('input, textarea, select').forEach((el) => { el.disabled = true; });
          단추.textContent = 'Sent ✓';
          return;
        }
        말.textContent = j.message || 'Something went wrong. Please email admin@klifedesign.net.';
        말.className = 'note bad';
      } catch (err) {
        /* ⛔ 실패를 조용히 삼키지 않는다 — 손님이 보냈다고 믿고 기다리게 된다 */
        말.textContent = 'Could not reach the server. Please email admin@klifedesign.net.';
        말.className = 'note bad';
      }
      단추.disabled = false;
      단추.textContent = 옛;
    });
  }
</script>

<style>
  .wrap { padding: 0 1rem; }
  .tp { max-width: 40rem; margin: 0 auto; }
  .kicker { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent);
            font-weight: 700; margin: 1.2rem 0 .3rem; }
  .tp h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.2; margin: 0 0 .6rem; }
  .tp .lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.2rem; }
  .what { list-style: none; padding: 0; margin: 0 0 1.6rem; }
  /* 🔴 [2026-09-28] 처음에 `1px solid var(--line)` 로 뒀더니 **화면에서 안 보였다.**
     이 사이트의 --line 은 거의 투명해서 큰 카드에는 맞지만 작은 칸에는 사라진다.
     떠서 눈으로 보고 잡았다. ⛔ 「변수를 썼으니 맞겠지」로 두지 않는다 — 떠서 본다.
     ⚠ 회색 겹침(rgba 127)을 쓰는 까닭 — 밝은 바탕에서도 어두운 바탕에서도 같이 보인다. */
  .what li { padding: .55rem .9rem; margin: 0 0 .45rem; background: var(--card);
             border: 1px solid rgba(127, 127, 127, .35); border-radius: 7px;
             font-size: .92rem; line-height: 1.55; }
  form { margin: 0 0 1.4rem; }
  .row { margin: 0 0 .85rem; display: flex; flex-direction: column; gap: .3rem; }
  /* ⚠ 좁은 화면(400px)에서 두 칸이 옆으로 밀리지 않게 — auto-fit 으로 스스로 접힌다 */
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0 .7rem; }
  label { font-size: .85rem; font-weight: 600; }
  .req { font-weight: 500; color: var(--muted); font-size: .78rem; margin-left: .3rem; }
  /* 🔴 손님이 «칠 자리»를 알아봐야 한다. 테두리가 묻히면 폼이 폼으로 안 보인다 */
  input, select, textarea {
    width: 100%; box-sizing: border-box; padding: .6rem .75rem; font: inherit; font-size: .95rem;
    color: var(--ink); background: var(--card);
    border: 1px solid rgba(127, 127, 127, .5); border-radius: 7px;
  }
  input:hover, select:hover, textarea:hover { border-color: rgba(127, 127, 127, .8); }
  input::placeholder, textarea::placeholder { color: var(--muted); opacity: .85; }
  textarea { resize: vertical; line-height: 1.55; }
  input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible {
    outline: 2px solid var(--accent, #b4884a); outline-offset: 2px;
  }
  /* 봇 덫 — 화면에서 치운다. display:none 은 일부 봇이 알아채므로 자리만 뺀다 */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  button { margin-top: .3rem; padding: .7rem 1.3rem; border: 0; border-radius: 7px; cursor: pointer;
           background: var(--accent, #b4884a); color: #fff; font-weight: 700; font-size: 1rem; }
  button:hover:not(:disabled) { filter: brightness(1.08); }
  button:disabled { opacity: .6; cursor: default; }
  .note { margin: .7rem 0 0; font-size: .9rem; line-height: 1.55; min-height: 1.2em; }
  .note.good { color: var(--accent, #b4884a); font-weight: 600; }
  .note.bad { color: #c0392b; font-weight: 600; }
  .tp a { color: var(--accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .tp a:hover { color: var(--ink); }
  .fine { font-size: .84rem; color: var(--muted); line-height: 1.65; }
</style>
