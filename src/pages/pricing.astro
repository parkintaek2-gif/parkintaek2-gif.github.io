---
/**
 * `/pricing` — 값을 묻는 손님이 처음 치는 주소. 404 였다(2번 8/21). 카탈로그로 잇는다.
 * 파는 지면들은 /data 에 있고, 첫 유료 상품은 /data/korea-trade-dataset 다.
 *
 * 🔴 [2026-09-15 · 6번 · 사장님 지시(2번 폰 창구)] 「서울마켓이 아직 있음/ 한국 시장
 *   데이터셋만 보이네...서울, 두바이, 아부다비, 상하이...등 상품들이 한눈에 다 볼 수
 *   있도록」 — 사장님이 보신 자리가 바로 이 화면이다. 여기가 한국만 보이면 손님도
 *   여기서 「한국뿐이구나」로 읽고 만다. /data 는 이미 시장 축을 올렸다(5번, 14e00ca56) —
 *   이 문 앞에도 같은 커버리지 줄을 놓아 들어오자마자 보이게 한다.
 */
import Base from '../layouts/Base.astro';

const TITLE = 'Pricing';
const DESC = 'What SeoulMarkets offers, market by market — Korea, Japan, Taiwan and the UAE now, more in build. '
  + 'The data is free to download; packaged value-added products are priced on the catalogue.';
---

<Base title={TITLE} description={DESC} noAds>
  <div class="wrap">
    <article class="pp">
      <p class="kicker">SeoulMarkets</p>
      <h1>Pricing</h1>
      <p class="lead">
        We build datasets from public filings — Korea (KRX/DART), and now the UAE (ADX+DFM) — and hand
        them over in English. Right now the raw counts are <b>free</b> to read and download on every
        market page below. Packaged, licensed files — full tapes, panels and disclosure feeds — are
        priced on the catalogue.
      </p>
      <p class="coverage">
        <b>Live</b> — Seoul (KRX / DART) · Tokyo (EDINET) · Taipei (TWSE) · Abu Dhabi &amp; Dubai (ADX / DFM).{' '}
        <b>In build</b> — Shanghai, Hong Kong, India and Saudi Arabia.{' '}
        <span>Same schema, same licence, same price. A new market is not a new contract.</span>
      </p>

      {/* 🔴 [2026-09-20 · 5번] 사장님 「매출이 아직도 0이다」
          이 지면은 «Pricing» 이라는 이름을 달고도 값이 한 군데(＄990)뿐이었고
          **살 수 있는 단추가 0개**였다. 값을 물으러 온 손님이 여기서 살 수 없으면
          그 손님은 거기서 끝난다. 회사 규칙에 이미 적혀 있던 것이다 —
          「파는 지면은 맨 위에 값과 결제창이 뜨고, 글이 길면 중간과 마지막에도 있어야 한다」.
          ⇒ 값 셋을 맨 위에 세우고, 위·아래 두 곳에서 결제창(/data#buy)으로 바로 보낸다.
          ⛔ 값만 적어 두고 「자세한 것은 카탈로그에서」로 넘기지 않는다. 그것이 지금까지였다. */}
      <div class="tiers">
        <div class="tier">
          <p class="tname">Academic</p>
          <p class="tprice">$79<span>one-time</span></p>
          <p class="tnote">One dataset for a thesis or paper. Cite us and we list your work.</p>
          <a class="tbuy" href="/data#buy">Buy →</a>
        </div>
        <div class="tier best">
          <p class="tname">Single dataset</p>
          <p class="tprice">$990<span>per year</span></p>
          <p class="tnote">One dataset complete — CSV + Parquet + dictionary — and every release for twelve months.</p>
          <a class="tbuy" href="/data#buy">Buy →</a>
        </div>
        <div class="tier">
          <p class="tname">All datasets</p>
          <p class="tprice">$2,990<span>per year</span></p>
          <p class="tnote">Every dataset in the catalogue, plus every release for twelve months.</p>
          <a class="tbuy" href="/data#buy">Buy →</a>
        </div>
      </div>
      <p class="freeline">
        Every dataset also has a <b>free page and sample file</b> — no registration, no card.
        Read it first, then buy the full tape.
      </p>
      <ul class="list">
        <li>
          <a href="/data/korea-trade-dataset"><b>Korea trade dataset</b></a> — every partner country,
          every month, exports/imports/balance. <b>Free</b> — CSV and live API.
          <span class="free"><a href="/data/korea-trade-balance.csv">download the CSV</a> · <a href="/v1/trade/exports?country=vietnam">query the API</a></span>
        </li>
        <li>
          <a href="/data#licence"><b>UAE material disclosures (ADX+DFM)</b></a> — every Abu Dhabi and
          Dubai filing, ranked by likely price impact against US SEC Form 8-K categories.
          <span class="free">from $990/yr — licensing</span>
        </li>
        <li>
          <a href="/data"><b>The full data catalogue →</b></a> — filter by market (Seoul · Abu Dhabi ·
          Dubai) and see every dataset, free page, download and licensed file in one place.
        </li>
      </ul>
      {/* 아래에도 한 번 더 — 글을 끝까지 읽은 손님이 다시 위로 올라가게 하지 않는다 */}
      <p class="closing">
        <a class="tbuy big" href="/data#buy">Choose a licence and pay →</a>
        <span class="closenote">PayPal · billed in US dollars · invoice on request
          (<a href="mailto:admin@klifedesign.net">admin@klifedesign.net</a>)</span>
      </p>

      <p class="fine">Source data is published by Korean and UAE exchanges/agencies under licences we
        checked market by market. We parse, normalise and translate. Not investment advice.</p>
    </article>
  </div>
</Base>

<style>
  .wrap { padding: 0 1rem; }
  .pp { max-width: 42rem; margin: 0 auto; }
  .kicker { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent);
            font-weight: 700; margin: 1.2rem 0 .3rem; }
  .pp h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.2; margin: 0 0 .6rem; }
  .pp .lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.6rem; }
  .coverage { margin: 0 0 1.4rem; padding: .7rem .9rem; border-left: 3px solid var(--accent, #b4884a);
              background: var(--paper-2, rgba(127,127,127,.07)); font-size: .92rem; line-height: 1.6; }
  .coverage b { color: var(--ink); }
  /* ⚠ 좁은 화면(400px)에서 석 장이 옆으로 밀리지 않게 — auto-fit 으로 스스로 접힌다 */
  .tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
           gap: .7rem; margin: 0 0 .9rem; }
  .tier { padding: .95rem 1rem; background: var(--card); border: 1px solid var(--line);
          border-radius: 8px; display: flex; flex-direction: column; }
  .tier.best { border-color: var(--accent, #b4884a); border-width: 2px; }
  .tname { margin: 0 0 .25rem; font-weight: 700; font-size: .95rem; }
  .tprice { margin: 0 0 .45rem; font-size: 1.5rem; font-weight: 800; line-height: 1.1; }
  .tprice span { display: block; font-size: .76rem; font-weight: 500; color: var(--muted); }
  .tnote { margin: 0 0 .8rem; font-size: .85rem; line-height: 1.55; color: var(--muted); flex: 1 1 auto; }
  .tbuy { display: inline-block; text-align: center; padding: .55rem .9rem; border-radius: 7px;
          background: var(--accent, #b4884a); color: #fff !important; font-weight: 700;
          font-size: .9rem; border-bottom: 0 !important; text-decoration: none; }
  .tbuy:hover { filter: brightness(1.08); color: #fff !important; }
  .tbuy.big { font-size: 1rem; padding: .7rem 1.3rem; }
  .freeline { margin: 0 0 1.6rem; font-size: .88rem; line-height: 1.6; color: var(--muted); }
  .closing { margin: 0 0 1.2rem; }
  .closenote { display: block; margin-top: .45rem; font-size: .82rem; color: var(--muted); }
  .list { list-style: none; padding: 0; margin: 0 0 2rem; }
  .list li { padding: 1rem 1.1rem; margin: 0 0 .8rem; background: var(--card);
             border: 1px solid var(--line); border-radius: 8px; line-height: 1.6; font-size: .95rem; }
  .list .free { display: block; margin-top: .3rem; font-size: .85rem; color: var(--muted); }
  .pp a { color: var(--accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .pp a:hover { color: var(--ink); }
  .fine { font-size: .82rem; color: var(--muted); line-height: 1.6; }
</style>
