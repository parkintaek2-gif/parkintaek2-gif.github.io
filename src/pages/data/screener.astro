---
/**
 * /data/screener — **거르는 지면. 우리가 여는 시장을 다 담는다.**
 *
 * 사장님(2026-09-15): 「스크리너를 정교하게 만들어. 원하는 자료를 쉽게 고객들이 찾을 수 있게」
 * 사장님(2026-09-15): **「한국시장 뿐만 아니라 우리가 서비스하는 시장 관련 데이터도
 *                        스크리너로 볼 수 있게 하는 거지?」**
 *   ⇒ 한국 전용으로 지었던 것을 시장 축이 있는 꼴로 다시 짰다. 지금 다섯 시장 —
 *     KOSPI · KOSDAQ · KONEX · ADX(아부다비) · DFM(두바이).
 *
 * ── 🔴 이 지면이 남의 스크리너와 다른 한 가지 ───────────────────────────────
 *   조건을 걸면 수가 줄어든다. 까닭이 «둘»인데 보통은 하나만 보여 준다 —
 *     1. 조건에 안 맞아서 빠졌다        ← 손님이 바라는 것
 *     2. 그 칸이 «비어 있어서» 빠졌다    ← 손님이 모르는 채로 잃는 것
 *
 *   **시장을 섞으면 2번이 훨씬 커진다.** 걸프에는 PER 이 «한 곳도» 없다.
 *   남들처럼 지으면 UAE 를 고른 손님이 조건 하나에 125곳을 통째로 잃고도 그 사실을
 *   모른다. 이 지면은 그 수를 빨간 칸에 적는다.
 *
 * 🔴 [2026-09-16 · 5번] 여기 「ADX 는 시가총액을 주는 우물을 아직 못 찾아」라고 적혀
 *   있었고, 그 말이 손님 화면에까지 「아부다비가 안 낸다」로 나가 있었다. **사실이 아니다.**
 *   우물은 있었다 — /adx/marketwatch/1.1/securityBoard/marketwatch (128/128 에 시총이 있다).
 *   우리가 «-delayed» 옆 문을 부르고 있었을 뿐이다. 지금은 받아서 쓴다(ADX 76/76).
 *   ⛔ 그래도 PER 은 여전히 안 낸다 — 걸프 신고서가 «분기»라, 한 분기 이익에 오늘 값을
 *     붙이면 우리가 책임질 수 없는 수가 된다. 까닭이 바뀌었으면 «까닭»을 고쳐 적는다.
 *
 * ⛔ 점수·등급·추천을 만들지 않는다. 사실만 놓고 판단은 손님이 한다.
 * ⛔ 화면에 한국어를 내지 않는다 — 손님이 영어권이다(자료 만드는 자에 관문이 있다).
 * 🔴 판정 셈은 src/lib/screener.mjs 가 정본이다(자가시험 41가지). 아래 브라우저 셈은
 *   그것과 «같은 규칙»을 옮긴 것이다 — 고칠 때는 두 곳을 같이 고친다.
 * 🔴 define:vars 에 넘기는 이름은 «아스키»여야 한다. 한글로 넘겼더니 Astro 가 한글을
 *   떼어 내 「… is not defined」로 지면이 빈 채 섰다(2026-09-15 실측).
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import 메타 from '../../data/screener-meta.json';
import { 수칸 } from '../../lib/screener.mjs';
import BuyBar from '../../components/BuyBar.astro';

const M = 메타 as any;
const 줄수 = M._meta.rows as number;
const dataUrl = M.dataUrl as string;
const 시장목록 = M.markets as Array<{ code: string; name: string; country: string; ccy: string; rows: number; filled: Record<string, number> }>;
const 업종들 = M.industries as string[];
const fx = M._meta.fx as { asOf: string; aedPerUsd: number; krwPerUsd: number };
const 지은때 = String(M._meta.builtAt || '').slice(0, 10);

/* 나라별로 묶어 보인다 — 손님은 「UAE 를 보고 싶다」로 생각하지 코드로 생각하지 않는다 */
const 나라들: Array<{ 이름: string; 시장: typeof 시장목록 }> = [];
for (const m of 시장목록) {
  let 통 = 나라들.find((x) => x.이름 === m.country);
  if (!통) { 통 = { 이름: m.country, 시장: [] }; 나라들.push(통); }
  통.시장.push(m);
}

/* 이 지면이 존재하는 까닭을 수로 말한다 — 「PER 을 걸면 몇 곳이 조용히 사라지나」 */
const PER있는곳 = 시장목록.reduce((a, m) => a + m.filled.p, 0);
const PER없는곳 = 줄수 - PER있는곳;
const UAE줄 = 시장목록.filter((m) => m.country === 'UAE').reduce((a, m) => a + m.rows, 0);
/* 🔴 걸프에 시가총액이 «있는» 곳. 예전엔 0 이었고, 그래서 지면이 「그쪽이 안 낸다」고
   말하고 있었다. 이제 받아 오므로 수가 산다 — 수가 바뀌면 문장도 저절로 따라간다. */
const UAE시총 = 시장목록.filter((m) => m.country === 'UAE').reduce((a, m) => a + m.filled.c, 0);
/* 🔴 [2026-09-17] 걸프에 PBR 이 섰다. 지면이 그 사실을 말하게 한다 —
 *   아래 글은 「걸프는 PER 을 못 낸다」까지만 말하고 있었다. 그건 지금도 맞지만,
 *   그 옆에 «그래도 PBR 은 낸다»가 빠지면 손님은 걸프 칸이 통째로 빈 줄 안다.
 *   ⚠ 수를 여기서 세어 쓴다 — 글에 숫자를 박으면 다음 달에 조용히 틀린다. */
const UAE_PBR = 시장목록.filter((m) => m.country === 'UAE').reduce((a, m) => a + (m.filled.b || 0), 0);

/* 손님이 자주 찾는 칸을 «한 번 눌러» 채우는 지름길.
   ⛔ 이름을 「Value」·「Quality」로 짓지 않는다 — 그러면 우리가 좋다/나쁘다를 말한 것이 된다.
   ✅ 조건 «그 자체»를 이름으로 쓴다. 그러면 사실이지 권유가 아니다. */
const 지름길 = [
  { 이름: 'PER under 10', 건다: { p: { max: 10 } } },
  { 이름: 'PBR under 1', 건다: { b: { max: 1 } } },
  { 이름: 'ROE over 15%', 건다: { r: { min: 15 } } },
  { 이름: 'Debt/equity under 100%', 건다: { d: { max: 100 } } },
  { 이름: 'Market cap over $1bn', 건다: { c: { min: 1000 } } },
  { 이름: 'Revenue over $1bn', 건다: { v: { min: 1000 } } },
];

const TITLE = 'Asia and Gulf stock screener — filter listed companies by the figures they filed';
const DESC = 'Screen ' + 줄수.toLocaleString('en-US') + ' companies listed in Seoul, Abu Dhabi and Dubai '
  + 'by market cap, revenue, profit, PER, PBR, ROE and debt. Unlike other screeners, this one counts '
  + 'the companies each filter removes because the figure does not exist.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'SMarkets Screener — Asia and Gulf',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  description: DESC,
  url: `${SITE_URL}/data/screener`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isPartOf: { '@id': `${SITE_URL}/#organization` },
};
---

<Base title={TITLE} description={DESC} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="page-head">
      <p class="kicker">Sources &amp; Markets · free tool</p>
      <h1>Asia &amp; Gulf screener</h1>
      <BuyBar 자리="top" />
      <p>
        Filter <b>{줄수.toLocaleString('en-US')}</b> listed companies across{' '}
        {시장목록.map((m, i) => (
          <>{i > 0 ? (i === 시장목록.length - 1 ? ' and ' : ', ') : ''}<b>{m.name}</b> ({m.rows.toLocaleString('en-US')})</>
        ))} by the figures they actually filed.
      </p>
      <p class="coverage">
        <b>What this screener tells you that others don't.</b> When a filter removes a company
        because the figure <i>does not exist</i> — not because it failed your test — we count those
        companies and say so, in red, above the table. A PER screen on its own removes{' '}
        <b>{PER없는곳.toLocaleString('en-US')}</b> of {줄수.toLocaleString('en-US')} companies that
        way, and that includes <b>every one of the {UAE줄} Gulf listings</b> — not because the
        exchanges withhold anything. Abu Dhabi and Dubai both publish market capitalisation, and we
        carry it for <b>{UAE시총}</b> of the {UAE줄}. What they file is <i>quarterly</i>, so a PER
        built on one quarter of earnings and today&rsquo;s price would be a number we could not stand
        behind. We leave it empty and say why, on the row itself. Most screeners drop these companies
        in silence, and the market then looks smaller and tidier than it really is.
      </p>
      <p class="coverage">
        <b>What we could reach, we went and got.</b> Price-to-book asks nothing of a quarter — the
        market cap and the book value are both figures from one day — so the quarterly problem above
        does not touch it. Getting there meant reading the balance sheet out of the audited PDF, and
        for many Gulf filers that page is a scan with no text in it at all: we render the page and
        read it. A figure only stands if assets equal liabilities plus equity to within 0.5% and the
        filing states the scale it is written in — thousands, millions, dirhams or dollars, which
        differs by company. <b>{UAE_PBR}</b> of the {UAE줄} Gulf listings now carry a price-to-book
        ratio on that basis. The rest stay empty, and the row says why.
      </p>
    </div>

    <section class="panel" aria-label="Filters">
      <div class="row">
        <label class="fld grow">
          <span>Name or ticker</span>
          <input type="search" id="q" placeholder="Samsung, 005930, Emaar, FAB…" autocomplete="off" />
        </label>
        <label class="fld grow">
          <span>Industry</span>
          <select id="ind">
            <option value="">All industries ({업종들.length})</option>
            {업종들.map((x) => <option value={x}>{x}</option>)}
          </select>
        </label>
      </div>

      <fieldset class="mkts">
        <legend>Markets</legend>
        {나라들.map((c) => (
          <div class="country">
            <button type="button" class="ctry" data-country={c.이름}>{c.이름}</button>
            {c.시장.map((m) => (
              <label class="chip">
                <input type="checkbox" class="mk" value={m.code} data-country={c.이름} checked />
                {m.name} <em>{m.rows.toLocaleString('en-US')}</em>
              </label>
            ))}
          </div>
        ))}
      </fieldset>

      <div class="shortcuts">
        <span class="sc-lab">Quick filters</span>
        {지름길.map((s) => (
          <button type="button" class="sc" data-set={JSON.stringify(s.건다)}>{s.이름}</button>
        ))}
      </div>

      {/* 🔴 폰에서는 접어 둔다 — 안 접으면 손수 치는 칸 여덟을 다 지나야 표에 닿는다 */}
      <details class="ranges" id="ranges">
        <summary>Set your own ranges</summary>
        <div class="grid" id="nums">
          {수칸.map((f: any) => (
            <div class="num" data-key={f.key}>
              <span class="lab">{f.이름} <em>{f.단위}</em></span>
              <div class="mm">
                <input type="number" class="mn" placeholder="min" step="any" aria-label={f.이름 + ' minimum'} />
                <span class="tilde">–</span>
                <input type="number" class="mx" placeholder="max" step="any" aria-label={f.이름 + ' maximum'} />
              </div>
              {/* ⭐ 고른 시장에서 이 칸이 몇 곳에 «있는지»를 걸기 전에 보인다.
                  시장마다 크게 다르므로 짓는 때 박아 두지 않고 브라우저가 다시 센다 */}
              <span class="have" data-have={f.key}>—</span>
            </div>
          ))}
        </div>
      </details>

      <div class="acts">
        <button type="button" id="reset">Clear all filters</button>
        <button type="button" id="copy">Copy link to this screen</button>
        <span class="hint" id="count">Loading {줄수.toLocaleString('en-US')} companies…</span>
      </div>
    </section>

    {/* 🔴 이 칸이 이 지면의 이유다 — 말없이 빠진 곳을 «크게» 적는다 */}
    <p class="dropped" id="dropped" hidden></p>

    <div class="tablewrap">
      <table id="tbl">
        <thead>
          <tr>
            <th scope="col">Company</th>
            <th scope="col" data-sort="m">Market</th>
            <th scope="col" data-sort="c" class="n">Market cap</th>
            <th scope="col" data-sort="v" class="n">Revenue</th>
            <th scope="col" data-sort="np" class="n">Net profit</th>
            <th scope="col" data-sort="e" class="n">EPS</th>
            <th scope="col" data-sort="p" class="n">PER</th>
            <th scope="col" data-sort="b" class="n">PBR</th>
            <th scope="col" data-sort="r" class="n">ROE %</th>
            <th scope="col" data-sort="d" class="n">Debt/eq %</th>
          </tr>
        </thead>
        <tbody id="rows"><tr><td colspan="10" class="empty">Loading…</td></tr></tbody>
      </table>
    </div>

    <p class="more" id="more" hidden><button type="button" id="showmore">Show 100 more</button></p>

    <p class="note">
      <b>Read the period before you compare.</b> Korean rows are a full financial year; Gulf rows are
      the filing period shown under the company name — usually a quarter. They are not the same
      thing, and sorting by revenue across both mixes a year with three months.
      <br /><br />
      <b>Money is shown in US dollars</b> so that markets can sit in one table, converted at the
      Central Bank of the UAE rates published on {fx.asOf}: 1 USD = {fx.aedPerUsd} AED
      = {Math.round(fx.krwPerUsd).toLocaleString('en-US')} KRW. Hover any money figure to see the
      amount in the currency the company actually filed.
      <br /><br />
      <b>Why Gulf rows have no PER, PBR or ROE.</b> The filed balance sheets do not state a consistent
      scale — some are in dirhams and some in thousands of dirhams — so any ratio built from them
      could be wrong by a factor of a thousand. We check each filing's stated earnings per share
      against its profit before we publish a money figure at all, and withhold the row's figures when
      that check fails. The reason appears on the row.
      <br /><br />
      <b>No score, no grade, no recommendation.</b> These are filed figures and a price; what you
      make of them is your call. A dash means the figure does not exist for that company, never zero.
      Data built {지은때}. This is not investment advice.
      <br /><br />
      This page is a sample. The full tapes — every field, every company, as a file — are licensed
      datasets: see <a href="/data">Data Products</a>.
    </p>
  </div>

  <script define:vars={{ dataUrl }}>
    (function () {
      var 줄들 = null;
      var 시장 = {};
      var 통화 = {};
      var 칸이름 = {
        c: 'market cap', v: 'revenue', np: 'net profit', e: 'EPS',
        p: 'PER', b: 'PBR', r: 'ROE', d: 'debt/equity', i: 'industry',
      };
      var 곱 = { c: 1e6, v: 1e6, np: 1e6 };
      var 보인수 = 100;
      var 정렬칸 = 'c', 내림 = true;

      var $ = function (id) { return document.getElementById(id); };
      function 있나(v) { return !(v === null || v === undefined || v === '') && isFinite(Number(v)); }

      function 돈글(달러) {
        if (!있나(달러)) return '—';
        var n = Number(달러), a = Math.abs(n);
        if (a >= 1e12) return '$' + (n / 1e12).toFixed(2) + 'T';
        if (a >= 1e9) return '$' + (n / 1e9).toFixed(1) + 'B';
        if (a >= 1e6) return '$' + Math.round(n / 1e6).toLocaleString('en-US') + 'M';
        return '$' + Math.round(n).toLocaleString('en-US');
      }
      function 원글(값, cur) {
        if (!있나(값)) return '';
        var n = Number(값), a = Math.abs(n);
        if (a >= 1e12) return (n / 1e12).toFixed(2) + 'tn ' + cur;
        if (a >= 1e9) return (n / 1e9).toFixed(1) + 'bn ' + cur;
        if (a >= 1e6) return Math.round(n / 1e6).toLocaleString('en-US') + 'm ' + cur;
        return Math.round(n).toLocaleString('en-US') + ' ' + cur;
      }
      function 수글(v, 자리) { return 있나(v) ? Number(v).toFixed(자리 === undefined ? 1 : 자리) : '—'; }
      function 칸(k) { return document.querySelector('#nums .num[data-key="' + k + '"]'); }
      function 벗(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }

      function 고른시장() {
        var 것 = [], 상자 = document.querySelectorAll('.mk');
        for (var i = 0; i < 상자.length; i += 1) if (상자[i].checked) 것.push(상자[i].value);
        return 것;
      }

      function 조건읽기() {
        var 것 = [], 칸들 = document.querySelectorAll('#nums .num');
        for (var i = 0; i < 칸들.length; i += 1) {
          var el = 칸들[i];
          var k = el.getAttribute('data-key');
          var mn = el.querySelector('.mn').value, mx = el.querySelector('.mx').value;
          if (mn === '' && mx === '') continue;
          var g = 곱[k] || 1;
          것.push({ key: k, min: mn === '' ? null : Number(mn) * g, max: mx === '' ? null : Number(mx) * g });
        }
        return 것;
      }

      function 주소에적는다() {
        var p = new URLSearchParams();
        if ($('q').value.trim()) p.set('q', $('q').value.trim());
        if ($('ind').value) p.set('ind', $('ind').value);
        var 고른 = 고른시장();
        if (고른.length < document.querySelectorAll('.mk').length) p.set('mkt', 고른.join(','));
        var 칸들 = document.querySelectorAll('#nums .num');
        for (var i = 0; i < 칸들.length; i += 1) {
          var el = 칸들[i], k = el.getAttribute('data-key');
          if (el.querySelector('.mn').value !== '') p.set(k + '_min', el.querySelector('.mn').value);
          if (el.querySelector('.mx').value !== '') p.set(k + '_max', el.querySelector('.mx').value);
        }
        if (정렬칸 !== 'c' || !내림) p.set('sort', 정렬칸 + (내림 ? '' : '_asc'));
        var 글 = p.toString();
        history.replaceState(null, '', location.pathname + (글 ? '?' + 글 : ''));
      }

      function 주소에서읽는다() {
        var p = new URLSearchParams(location.search);
        if (p.get('q')) $('q').value = p.get('q');
        if (p.get('ind')) $('ind').value = p.get('ind');
        if (p.get('mkt')) {
          var 쓸것 = p.get('mkt').split(',');
          var 상자 = document.querySelectorAll('.mk');
          for (var i = 0; i < 상자.length; i += 1) 상자[i].checked = 쓸것.indexOf(상자[i].value) >= 0;
        }
        var 칸들 = document.querySelectorAll('#nums .num');
        for (var j = 0; j < 칸들.length; j += 1) {
          var el = 칸들[j], k = el.getAttribute('data-key');
          if (p.get(k + '_min')) el.querySelector('.mn').value = p.get(k + '_min');
          if (p.get(k + '_max')) el.querySelector('.mx').value = p.get(k + '_max');
        }
        var s = p.get('sort');
        if (s) { 내림 = s.indexOf('_asc') < 0; 정렬칸 = s.replace('_asc', ''); }
      }

      function 거른다() {
        var 조건 = 조건읽기();
        var 글 = ($('q').value || '').trim().toLowerCase();
        var 고른 = 고른시장();
        var 업종 = $('ind').value;
        var 시장안 = [], 남은 = [], 안맞음 = 0, 값없음 = 0, 칸별 = {};

        for (var i = 0; i < 줄들.length; i += 1) {
          var r = 줄들[i];
          if (고른.indexOf(r.m) < 0) continue;
          if (글 && ((r.n || '') + ' ' + (r.k || '') + ' ' + (r.t || '')).toLowerCase().indexOf(글) < 0) continue;
          시장안.push(r);

          var 까닭 = null;
          if (업종) {
            if (!r.i) { 까닭 = 'missing'; 칸별.i = (칸별.i || 0) + 1; }
            else if (r.i !== 업종) 까닭 = 'fail';
          }
          if (!까닭) {
            for (var j = 0; j < 조건.length; j += 1) {
              var c = 조건[j], v = r[c.key];
