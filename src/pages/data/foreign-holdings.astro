---
/**
 * **Who holds Korean securities abroad** — 무료 영문 지면. (seoulmarkets.com/data/foreign-holdings)
 *
 * ── 왜 (5번 2026-09-16 11:5x 물음, 6번 2026-09-17) ─────────────────────────
 * 5번이 던진 물음은 「어느 나라의 어느 부문이 한국 증권을 얼마나 들고 있나」였다.
 *
 * 🔴 처음엔 리포터=KOR·ACCOUNTING_ENTRY=A(자산) 로 받았는데, 그건 **정반대** —
 *   「한국이 해외에 들고 있는 것」이지 「누가 한국 증권을 들고 있나」가 아니었다.
 *   CPIS/PIP 는 «자산»만 걷는다. 리포터=KOR·ACCOUNTING_ENTRY=L(부채)로 물으면
 *   실측(2026-09-17) 관측값 **0건** — 부채 조사가 이 안에 따로 없다.
 *
 * ✅ 그래서 **거울(mirror)** 로 구한다 — 다른 나라들이 「내 자산」으로 신고한 값 가운데
 *   COUNTERPART_COUNTRY=KOR 인 것을 전부 더한다. A국이 「한국 증권을 30억 든다」고 신고한
 *   값들의 합이 곧 「한국 증권을 든 사람들」이다. (collect-imf-pip-mirror.mjs)
 *
 * ⛔ 이 지면이 지키는 것
 * ⛔ **하한선이라고 분명히 적는다** — 리포터로 안 낸 나라(중국 등 다수)는 이 합계에 없다.
 * ⛔ 「저평가·고평가」를 말하지 않는다. 투자자문이 아니다.
 * ⛔ 화면에 한국어를 내지 않는다.
 * ⛔ 값이 없는 나라를 0 으로 채우지 않는다 — 아예 목록에서 빠진다(75개국만 낸다).
 *
 * 🔴 Astro 앞말은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import tape from '../../data/imf-pip-korea.json';

const meta = tape._메모;
const 나라들 = tape.나라들 as { code: string; name: string; value: number; share: number | null; prevValue: number | null }[];
const 총액 = tape.총액;

const fmtB = (v: number) => '$' + (v / 1e9).toLocaleString(undefined, { maximumFractionDigits: 1 }) + 'B';
const fmtPct = (v: number | null) => v == null ? '—' : (v * 100).toFixed(1) + '%';
const yoy = (now: number, prev: number | null) => prev == null || prev === 0 ? null : (now - prev) / prev;

const TITLE = 'Who holds Korean securities abroad — 75 countries, IMF data';
const DESC = `${나라들.length} countries reported holding Korean portfolio securities as of ${meta.최근연도}, `
  + `worth at least ${fmtB(총액)} combined. The United States alone accounts for `
  + `${fmtPct(나라들[0]?.share ?? null)}. Ranked from IMF Coordinated Portfolio Investment Survey mirror data — `
  + 'a lower bound, since not every holder country reports.';

const 최대 = Math.max(...나라들.map((r) => r.value), 1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Dataset',
      name: `Foreign holders of Korean portfolio securities, ${meta.최근연도}`,
      description: DESC,
      url: `${SITE_URL}/data/foreign-holdings`,
      temporalCoverage: String(meta.최근연도),
      creator: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
      isBasedOn: 'https://data.imf.org',
      variableMeasured: 'Portfolio investment position (USD)',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Who holds the most Korean securities?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `As of ${meta.최근연도}, the United States reports the largest holding of Korean portfolio `
              + `securities among countries that disclose to the IMF, at roughly ${fmtB(나라들[0]?.value ?? 0)}. `
              + 'This is a lower bound — see below for why.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why is this a lower bound and not the full total?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'This ranking is built by summing what other countries report holding in Korean securities '
              + '(IMF Coordinated Portfolio Investment Survey). Korea itself does not separately report who '
              + 'holds its securities — only what it holds abroad. Countries that do not participate in the '
              + `survey, including China, are absent from this total. ${meta.리포터수} countries reported for `
              + `${meta.최근연도}.`,
          },
        },
        {
          '@type': 'Question',
          name: 'What counts as "Korean securities" here?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Total portfolio investment position — equity, investment fund shares, and long- and '
              + 'short-term debt securities combined — held by residents of the reporting country in Korean '
              + 'issuers, at the reported valuation date.',
          },
        },
      ],
    },
  ],
};
---

<Base title={TITLE} description={DESC} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="rk">
      <h1>Who holds Korean securities abroad</h1>
      <p class="lead">
        {나라들.length} countries told the IMF how much they hold in Korean portfolio securities —
        equities, bonds, and fund shares — as of {meta.최근연도}. Summed together, that is at least{' '}
        {fmtB(총액)}. This is a floor, not a total: countries that do not report to the survey are
        simply absent, not counted as zero.
      </p>

      <section class="trust">
        <h2>Why you can trust this number — and why it is a floor</h2>
        <ul>
          <li>
            Korea does not report who holds its own securities — the IMF's survey only collects what a
            country holds <em>abroad</em>. We get this ranking by flipping the data around: summing every
            other country's own disclosure of what it holds <em>in Korea</em>.
          </li>
          <li>
            {meta.리포터수} countries disclosed a Korea position for {meta.최근연도}. Major economies that do
            not participate in this IMF survey — China among them — are not in this list at all, not
            counted as zero. The true total is higher than what is shown here.
          </li>
          <li>
            Figures mix onshore and financial-centre holders — Luxembourg, Ireland and the Cayman Islands
            rank highly mostly because global funds are domiciled there, not because those countries'
            own savers hold Korean assets directly.
          </li>
          <li>
            The full computation is open — <code>collect-imf-pip-mirror.mjs</code> and{' '}
            <code>build-foreign-holdings-page.mjs</code> in our repository, sourced from IMF SDMX data with
            no manual adjustment.
          </li>
        </ul>
      </section>

      <p class="count">
        {나라들.length} countries reported a position · {meta.최근연도} · compared with {meta.전년} where filed
      </p>

      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th class="r">#</th>
              <th>Country</th>
              <th class="r">Holding ({meta.최근연도})</th>
              <th class="r">Share</th>
              <th class="r">vs {meta.전년}</th>
            </tr>
          </thead>
          <tbody>
            {나라들.map((r, i) => {
              const change = yoy(r.value, r.prevValue);
              return (
                <tr>
                  <td class="r n">{i + 1}</td>
                  <td class="nm">
                    <span class="bar" style={`width:${(r.value / 최대 * 100).toFixed(1)}%`}></span>
                    <span class="t">{r.name} <span class="tk">{r.code}</span></span>
                  </td>
                  <td class="r v">{fmtB(r.value)}</td>
                  <td class="r e">{fmtPct(r.share)}</td>
                  <td class="r e">{change == null ? '—' : (change >= 0 ? '+' : '') + (change * 100).toFixed(1) + '%'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <section class="meth">
        <h2>Frequently asked</h2>
        <div class="qa">
          <h3>Who holds the most Korean securities?</h3>
          <p>
            As of {meta.최근연도}, the United States reports the largest holding among countries that
            disclose to the IMF, at roughly {fmtB(나라들[0]?.value ?? 0)} — about{' '}
            {fmtPct(나라들[0]?.share ?? null)} of the total shown here. This is a lower bound; see below.
          </p>
        </div>
        <div class="qa">
          <h3>Why is this a lower bound and not the full total?</h3>
          <p>
            This ranking sums what other countries report holding in Korean securities (IMF Coordinated
            Portfolio Investment Survey). Korea itself does not separately report who holds its own
            securities — only what it holds abroad. Countries that do not participate in the survey,
            including China, are absent from this total. {meta.리포터수} countries reported for {meta.최근연도}.
          </p>
        </div>
        <div class="qa">
          <h3>What counts as "Korean securities" here?</h3>
          <p>
            Total portfolio investment position — equity, investment fund shares, and long- and
            short-term debt securities combined — held by residents of the reporting country in Korean
            issuers, at the reported valuation date.
          </p>
        </div>

        <h2>Source</h2>
        <p class="fine">
          International Monetary Fund, Coordinated Portfolio Investment Survey (data.imf.org) — mirror
          method (see above). Data as of {meta.받은때} KST. Not investment advice.
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .rk h1 { font-size: clamp(1.6rem, 4.5vw, 2.2rem); line-height: 1.25; margin: 1rem 0 .7rem; letter-spacing: -.02em; }
  .rk .lead { color: var(--muted); margin: 0 0 1.4rem; max-width: 46rem; }

  .trust { margin: 0 0 1.4rem; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 8px; background: var(--card); }
  .trust h2 { font-size: .95rem; margin: 0 0 .5rem; }
  .trust ul { margin: 0; padding-left: 1.1rem; }
  .trust li { font-size: .87rem; line-height: 1.6; color: var(--muted); margin: 0 0 .3rem; }
  .trust em { color: var(--ink); font-style: normal; font-weight: 600; }

  .count { font-size: .8rem; color: var(--muted); margin: 0 0 .6rem; font-variant-numeric: tabular-nums; }

  .scroll-x { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { padding: .5rem .55rem; border-bottom: 1px solid var(--line); text-align: left; }
  th { font-size: .74rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; white-space: nowrap; }
  .r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .n { color: var(--muted); width: 2.6rem; }
  .v { font-weight: 600; }
  .e { color: var(--muted); }
  .nm { position: relative; min-width: 12rem; overflow: hidden; }
  .bar { position: absolute; left: 0; top: 3px; bottom: 3px; background: var(--card); border-radius: 0 3px 3px 0; }
  .nm .t { position: relative; }
  .tk { color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; letter-spacing: .02em; }

  .meth { margin: 2.5rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .meth h2 { font-size: 1.02rem; margin: 1.4rem 0 .5rem; }
  .meth h2:first-child { margin-top: 0; }
  .qa { margin: 0 0 1.1rem; }
  .qa h3 { font-size: .92rem; margin: 0 0 .3rem; }
  .qa p { font-size: .89rem; line-height: 1.65; color: var(--muted); margin: 0; }
  .fine { font-size: .8rem; color: var(--muted); margin: 0; }
</style>
