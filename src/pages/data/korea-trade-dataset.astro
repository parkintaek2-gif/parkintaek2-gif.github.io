---
/**
 * **Korea trade dataset** — CSV 는 무료, 파는 것은 «가공본»(예정). (seoulmarkets.com/data/korea-trade-dataset)
 *
 * ── 왜 지금 이 꼴인가 (2번 결정 2026-08-21 23:2x) ─────────────────
 *   ① 원자료(이 CSV)는 계속 무료. 가리지 않는다.
 *   ② 파는 것은 **가공본** — 품목(HS코드) 상세·더 긴 시계열·월별 해설. 아직 없다.
 *   ③ ⛔ 결제 단추는 안 올린다. 그 지면 실측 「구매·$29」 0건 · 무료 6건(2026-08-21) —
 *      수요가 안 잡힌 채 단추를 올리면 무료를 가린 값만 치른다.
 *   ④ 대신 **견본 + 「받아보기 신청」(이메일, /v1/subscribe, source=trade-sample)** 으로
 *      수요를 먼저 잰다. 신청 수가 곧 답이다. (PayPal 레일은 이전 안 — 지금은 안 쓴다)
 *
 * 값을 부르기 전에 물건을 보인다 — 무료 CSV 로 잇는다.
 * 데이터는 유료 API /v1/trade/exports 와 **같은 번들 소스**(src/lib/trade-data.mjs)라 어긋날 수 없다.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import { TRADE } from '../../lib/trade-data.mjs';

const COUNTRIES = TRADE.countries.length;
const MONTHS = TRADE.window.months;
const WINDOW = `${TRADE.window.first_month} to ${TRADE.window.latest_month}`;

const TITLE = 'Korea trade dataset — every partner, every month';
const SAMPLE = `${COUNTRIES} partner countries · ${MONTHS} months (${WINDOW}) · CSV`;
const DESC =
  `Korea's exports, imports and trade balance with all ${COUNTRIES} partner countries, month by month, `
  + 'on a customs basis — normalised to English and delivered as one clean CSV. The raw source is Korean, '
  + 'un-normalised and awkward; this is the ready extract. Free to download, yours to keep.';

/** 견준 값 — 실제로 열어 적음(2026-08-21). 화면과 하나의 출처로 묶는다. */
const 비교 = [
  ['data.go.kr / KOSIS (the raw source)', 'Free', 'Korean, un-normalised, one query at a time'],
  ['Trading Economics — website', '$29–199 / month', 'Whole platform, subscription, not this dataset'],
  ['Trading Economics — API', '$149–299 / month', 'Subscription, billed yearly'],
  ['Statista', '$199+ / month (billed yearly)', 'No one-off; subscription only'],
  ['Nasdaq Data Link premium', 'Contact sales', 'À la carte, no public price'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Korea trade dataset — exports, imports and balance by partner country and month',
  description: DESC,
  url: `${SITE_URL}/data/korea-trade-dataset`,
  temporalCoverage: WINDOW.replace(' to ', '/'),
  creator: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  isAccessibleForFree: true,
  license: 'https://www.data.go.kr',
  variableMeasured: ['exports (USD thousand)', 'imports (USD thousand)', 'trade balance (USD thousand)'],
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${SITE_URL}/data/korea-trade-balance.csv` },
};
---

<Base title={TITLE} description={DESC} jsonLd={jsonLd} noAds>
  {/* 2번 지시(8/21 ㉯): 원자료는 무료로 둔다. 가공물이 생기기 전엔 결제 단추를 그리지 않는다.
      PayPal SDK·단추를 뺀다 — 「팔린다」로 읽히는 것을 0 으로. 가공물이 나오면 그때 되살린다. */}
  <div class="wrap">
    <article class="pp">
      <p class="kicker">SeoulMarkets · open trade data</p>
      <h1>Korea trade dataset — every partner, every month</h1>
      <p class="sample">{SAMPLE}</p>
      <p class="lead">
        Korea's customs office publishes what the country sells to, and buys from, <b>every partner on
        earth</b>, month by month. It publishes it in Korean, un-normalised, one awkward query at a time.
        We take the same official figures and hand you <b>one clean CSV</b>: {COUNTRIES} partner
        countries × {MONTHS} months of exports, imports and the balance, in English, with the source
        named on the first line. It is <b>free to download and yours to keep</b> — the raw customs
        record stays free.
      </p>

      <ol class="five">
        <li><b>What it is</b> — exports, imports and trade balance (USD thousand) for all {COUNTRIES}
          partner countries, for each of {MONTHS} months, {WINDOW}. Plus national totals. One CSV.</li>
        <li><b>Why trust it</b> — every figure is the customs value as filed, taken from Statistics
          Korea (KOSIS table DT_1R11006, source: Korea Customs Service). We parse, normalise and
          translate; we do not adjust the numbers.</li>
        <li><b>How current</b> — monthly, following the customs release. Figures are provisional and get
          revised; the latest month is the least settled. We say so, in the file.</li>
        <li><b>The honest limits</b> — this is partner-country × month, not HS-code (product) level.
          Hong Kong includes entrepôt re-exports onward to mainland China. Goods trade, customs basis —
          not the current account.</li>
        <li><b>What it is not</b> — not investment advice, and not a forecast. It is the record.</li>
      </ol>

      <div class="blk">
        <h2>What you get</h2>
        <table class="kv">
          <tr><th>Rows</th><td>{(COUNTRIES + 1) * MONTHS} — {COUNTRIES} partners + national total, × {MONTHS} months</td></tr>
          <tr><th>Columns</th><td><code>country_en, month, exports_usd_thousand, imports_usd_thousand, balance_usd_thousand</code></td></tr>
          <tr><th>Window</th><td>{WINDOW} ({MONTHS} months)</td></tr>
          <tr><th>Format</th><td>UTF-8 CSV, source and licence on the header lines</td></tr>
          <tr><th>Same data as</th><td>our API <code>/v1/trade/exports</code> — one source, they cannot disagree</td></tr>
        </table>
      </div>

      <div class="blk">
        <h2>What this kind of data costs elsewhere</h2>
        <p>Nobody sells this as a one-off. The people who carry Korean trade data sell a whole platform,
          by subscription, or ask you to call. We opened them and wrote down the numbers:</p>
        <table class="press">
          <thead><tr><th>Where</th><th>Price</th><th>What that buys</th></tr></thead>
          <tbody>
            {비교.map(([w, p, n]) => (
              <tr><td class="axis">{w}</td><td class="r">{p}</td><td>{n}</td></tr>
            ))}
          </tbody>
        </table>
        <p>The raw source is free, and so is our clean extract — you can take it right now, below. When we
          package the <b>value-added product</b> (curated time series, charts and written analysis), this
          is the market we will price it against. We will not name a price until that product exists.</p>
      </div>

      <div class="blk">
        <h2>What is already done for you, versus doing it yourself</h2>
        <p>The CSV above is free, and it stays free. But it did not arrive that way — KOSIS publishes
          this as Korean-language tables, one country and one month at a time. Here is what that work
          looks like, counted:</p>
        <table class="press">
          <thead><tr><th>Task</th><th>Doing it yourself from KOSIS</th><th>Already done in this CSV</th></tr></thead>
          <tbody>
            <tr><td class="axis">Country names</td><td>Korean names, official codes — {COUNTRIES}
              separate lookups to get English</td><td>{COUNTRIES} partner countries pre-mapped to
              English names</td></tr>
            <tr><td class="axis">Assembling the series</td><td>One query per country per month —
              {(COUNTRIES + 1) * MONTHS} queries to match this file's row count</td><td>One file,
              already joined</td></tr>
            <tr><td class="axis">Column names</td><td>Korean field labels, several table layouts across
              releases</td><td>One fixed schema: <code>country_en, month, exports_usd_thousand,
              imports_usd_thousand, balance_usd_thousand</code></td></tr>
            <tr><td class="axis">Keeping it current</td><td>Re-pull and re-join by hand every month</td>
              <td>Refreshed on the customs release, same schema each time</td></tr>
          </tbody>
        </table>
        <p class="fine">What is not yet built is the next layer — product (HS-code) detail, a longer
          back-series, and written month-to-month analysis on top of these figures. That is the{' '}
          <b>processed product</b> below, and it does not exist yet — we are not describing a sample of
          something we have not made.</p>
      </div>

      <div class="cta">
        <h2>Take the data — it is free</h2>
        <p class="cta__lead">All {COUNTRIES} partner countries × {MONTHS} months, one CSV, or query it
          live through the API. No charge, no subscription.</p>
        <p class="cta__buttons">
          <a class="btn" href="/data/korea-trade-balance.csv">Download the CSV — free</a>
          <a class="btn ghost" href="/v1/trade/exports?country=vietnam">Query the live API →</a>
        </p>
      </div>

      <section class="cta">
        <h2>Ask to be notified — the processed product</h2>
        <p class="cta__lead">A packaged, value-added layer on top of this free data — product (HS-code)
          detail, a longer back-series, and written analysis — is <b>in preparation</b>. It is not on
          sale, and there is no button to press. Leave an email and we send the sample the day it
          exists, plus the terms at that time. No account, and this is not the newsletter.</p>
        {
          /* ⚠ 사는 길. 죽은 mailto 대신 실제로 도는 /v1/subscribe 로 접수한다(panel 지면과 같은 길).
             source='trade-sample' 로 임금패널·뉴스레터와 갈라 센다 — 신청 수가 곧 수요 판정이다. */
        }
        <form class="ask" method="post" action="/v1/subscribe" data-source="trade-sample">
          <label class="vh" for="trade-ask-email">Email address</label>
          <div class="ask__row">
            <input
              id="trade-ask-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="you@company.com"
              aria-describedby="trade-ask-note"
            />
            <button type="submit">Notify me</button>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="trade-ask-hp">Leave this field empty</label>
            <input id="trade-ask-hp" type="text" name="hp" tabindex="-1" autocomplete="off" />
          </div>
          <p class="ask__note" id="trade-ask-note">We store your address and that you asked about this
            product. We never sell or share it. Questions:{' '}
            <a href="mailto:sibcheongan@gmail.com?subject=Korea%20trade%20data">sibcheongan@gmail.com</a>.</p>
          <p class="ask__msg" role="status" aria-live="polite"></p>
        </form>
      </section>

      <script is:inline>
        (() => {
          const form = document.querySelector('form.ask[data-source="trade-sample"]');
          if (!form) return;
          const input = form.querySelector('input[name="email"]');
          const hp = form.querySelector('input[name="hp"]');
          const btn = form.querySelector('button[type="submit"]');
          const msg = form.querySelector('.ask__msg');
          const say = (state, text) => { msg.dataset.state = state; msg.textContent = text; };
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = input.value.trim();
            if (!email) return;
            btn.disabled = true;
            const was = btn.textContent;
            btn.textContent = 'Sending…';
            delete msg.dataset.state;
            try {
              const res = await fetch('/v1/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, hp: hp.value, source: form.dataset.source || 'trade-sample' }),
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.ok) {
                say('ok', 'Thanks — we will email you when the sample is ready.');
                form.reset();
              } else {
                say('error', data?.error?.message || data?.message || 'Could not send. Please try again.');
              }
            } catch {
              say('error', 'Network error. Please try again.');
            } finally {
              btn.disabled = false;
              btn.textContent = was;
            }
          });
        })();
      </script>

      <p class="fine bottom">
        Source: Statistics Korea (KOSIS), table DT_1R11006 — Korea Customs Service. Licence: Korea Public
        Data Portal, commercial use permitted with attribution. We parse, normalise and translate; figures
        are the customs values as filed. Not investment advice.
      </p>
    </article>
  </div>
</Base>

<style>
  .wrap { padding: 0 1rem; }
  .pp { max-width: 46rem; margin: 0 auto; }
  .kicker { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent);
            font-weight: 700; margin: 1.2rem 0 .3rem; }
  .pp h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.2; margin: 0 0 .5rem; letter-spacing: -.02em; }
  .pp .sample { font-size: .9rem; color: var(--muted); font-variant-numeric: tabular-nums;
                margin: 0 0 1.4rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .pp .lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.8rem; }
  .pp .lead b { font-weight: 650; }

  .five { margin: 0 0 2.4rem; padding: 1.1rem 1.2rem 1.1rem 2.4rem; background: var(--card);
          border: 1px solid var(--line); border-radius: 8px; }
  .five li { margin: 0 0 .5rem; font-size: .92rem; line-height: 1.6; }
  .five li:last-child { margin-bottom: 0; }
  .five li b { color: var(--ink); }

  .blk { margin: 0 0 2.2rem; }
  .blk h2 { font-size: 1.15rem; margin: 0 0 .8rem; letter-spacing: -.01em; }
  .blk p { line-height: 1.7; margin: 0 0 .8rem; }

  table.kv, table.press { width: 100%; border-collapse: collapse; font-size: .9rem; margin: 0 0 .8rem; }
  table.kv th, table.kv td, table.press th, table.press td {
    padding: .55rem .6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  table.kv th { font-weight: 600; color: var(--ink); white-space: nowrap; width: 1%; }
  table.press th { font-size: .74rem; text-transform: uppercase; letter-spacing: .04em;
                   color: var(--muted); font-weight: 600; }
  table.press td.axis { font-weight: 600; color: var(--ink); }
  .r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  code { font-family: var(--mono, ui-monospace, monospace); font-size: .84em;
         background: var(--card); padding: .1em .35em; border-radius: 4px; }

  .cta { margin: 2.4rem 0 0; padding: 1.4rem 1.3rem; border: 2px solid var(--accent);
         border-radius: 10px; background: var(--card); }
  .cta h2 { font-size: 1.25rem; margin: 0 0 .5rem; }
  .cta p { line-height: 1.7; font-size: .95rem; }
  .cta__lead { margin: 0 0 1rem; }
  .cta__also { margin: 1.1rem 0 0; font-size: .88rem; color: var(--muted); }
  .cta a, .pp a { color: var(--accent); text-decoration: none;
                  border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .cta a:hover, .pp a:hover { color: var(--ink); }

  .fine { font-size: .82rem; color: var(--muted); line-height: 1.6; }
  .fine.bottom { margin: 2.4rem 0 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }

  /* 받아보기 신청 폼 — pension-wage-panel.astro 와 같은 결(라벨 숨김·봇 덫·aria-live) */
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .ask__row { display: flex; gap: .5rem; max-width: 30rem; }
  .ask__row input { flex: 1 1 auto; min-width: 0; font: inherit; font-size: .95rem; padding: .6rem .7rem;
    color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; }
  .ask__row input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .ask__row button { flex: 0 0 auto; font: inherit; font-size: .92rem; font-weight: 650; cursor: pointer;
    padding: .6rem 1rem; color: var(--bg); background: var(--ink); border: 1px solid var(--ink); border-radius: 6px; }
  .ask__row button:hover { opacity: .9; }
  .ask__row button[disabled] { opacity: .6; cursor: default; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ask__note { margin: .6rem 0 0; font-size: .8rem; color: var(--muted); line-height: 1.55; }
  .ask__msg { margin: .6rem 0 0; font-size: .88rem; line-height: 1.55; display: none; }
  .ask__msg[data-state] { display: block; }
  .ask__msg[data-state='ok'] { color: var(--up, #1a7f37); }
  .ask__msg[data-state='error'] { color: var(--down, #c0392b); }
  @media (max-width: 30rem) { .ask__row { flex-direction: column; } .ask__row button { width: 100%; } }

  @media (max-width: 560px) { table.kv th { white-space: normal; } .pp .sample { white-space: normal; } }
</style>
