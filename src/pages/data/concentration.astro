---
/*
 * Korea Concentration Index — 무료 지면(미끼·나침반) + 유료 피드로 가는 깔때기.
 *   (seoulmarkets.com/data/concentration)
 *
 * 왜 (사장님 2026-08-22): 「주가로 남들이 생각도 못할 것 + 관세청 엮어라 / 저가로 팔지 마라」
 *   주가(KRX)×무역(관세청)을 «같은 잣대»(Gini·상위4)로 엮은 교차 — 단일피드 벤더가 못 만든다.
 *   무료로 나침반(핵심 숫자·차트·CSV)을 열어 유입을 만들고, 파는 것은 전체 시계열·API(가치기반 高가격).
 *
 * 자료: src/data/concentration-cross.json(교차 스냅샷) · src/data/krx-daily-history.json(일일 지수).
 *   ⚠ 전부 비율/Gini — 시세 스케일 무관·검증가능. 절대 시세는 안 낸다.
 *   ⛔ 값(유료가)은 화면에 안 박는다 — 사장님 확정 대기. 살 뜻만 센다.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import cross from '../../data/concentration-cross.json';
import hist from '../../data/krx-daily-history.json';
import today from '../../data/market-today.json';

const TITLE = 'Korea stock market & trade concentration — KOSPI, KOSDAQ, exports';
const DESC =
  'How concentrated the Korean stock market and trade are: Samsung and SK hynix as a share of KOSPI '
  + 'market cap, KOSDAQ vs KOSPI, and South Korea’s biggest export and import partners (China, US). '
  + 'The top four are about half by every measure, with Gini above 0.9. Free daily data from KRX and '
  + 'Korea Customs. Not investment advice.';

const dims = (cross as any).dims as Array<{ key: string; units: string; gini: number; top4: number; top10: number; half: number }>;
const stockAsOf = (cross as any).stockAsOf as string;
const tradeMonth = (cross as any).tradeMonth as string;
const days = ((hist as any).days || []).length;
const fmtDd = (s: string) => (s && s.length === 8 ? `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}` : s);

// Dataset 스키마 — 구글 데이터셋 검색(datasetsearch.google.com)용으로 강화.
// 웹검색은 저권위로 못 뜨지만 데이터셋 검색은 경쟁이 얕아 니치 한국 데이터셋이 실제로 잡힐 여지가 크다.
// license·keywords·spatialCoverage·측정기법·무료여부를 채워 색인 자격을 최대화한다(2026-08-24, 방문 올인).
const datasetLd = {
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: 'Korea Concentration Index — stock market and trade',
  description: DESC,
  url: `${SITE_URL}/data/concentration`,
  keywords: ['Korea', 'South Korea', 'KOSPI', 'KOSDAQ', 'market concentration', 'Gini coefficient',
    'stock market capitalisation', 'trading value', 'export partners', 'import partners', 'Korea trade',
    'top-four share', 'Samsung weight'],
  creator: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  license: `${SITE_URL}/terms`,
  isAccessibleForFree: true,
  measurementTechnique: 'Gini coefficient and top-four share computed across listed issues (Korea Exchange OPEN API) and partner countries (Korea Customs Service via KOSIS); scale-invariant shares only, no absolute price or dollar levels',
  spatialCoverage: { '@type': 'Place', name: 'Republic of Korea' },
  dateModified: fmtDd(stockAsOf),
  temporalCoverage: `${fmtDd(stockAsOf)}/${fmtDd(stockAsOf)}`,
  variableMeasured: ['market-cap Gini', 'trading-value Gini', 'export-partner Gini', 'import-partner Gini', 'top-four share'],
  distribution: [{ '@type': 'DataDownload', name: 'Korea concentration daily series (CSV)', encodingFormat: 'text/csv', contentUrl: `${SITE_URL}/data/korea-concentration.csv` }],
};

// FAQPage 구조화데이터 — 아래 .faq 지면에 실제로 보이는 6개 Q&A와 문장이 일치해야 한다(구글 규칙).
// 제로 노출을 뚫는 지렛대: 저권위 신규 사이트는 경쟁 질의에서 못 뜨지만, 구조화된 직접답변은
// 스니펫 자격을 얻어 "how much of the kospi is samsung" 류 실수요 질의에 잡힐 여지가 생긴다.
const faq = [
  ['How much of the KOSPI is Samsung?',
   'Samsung Electronics is about 26.7% of the entire Korean stock market (KOSPI + KOSDAQ) by market cap; together with SK hynix, the two chipmakers are close to half.'],
  ['How concentrated is the Korean stock market?',
   `The four largest stocks are ${dims[0].top4}% of total market cap and the top ten are about 60%; the concentration Gini is ${dims[0].gini}. KOSDAQ holds only about 7% of value but a much larger share of daily trading.`],
  ["Who are South Korea's biggest trading partners?",
   'Korea’s top export markets are the United States and China, nearly tied near 20% each; its single biggest import source is China, about a quarter of all imports. The top four partners are roughly half of trade either way.'],
  ['What is the KOSPI vs KOSDAQ market cap split?',
   'KOSPI holds about 93% of total listed market value; KOSDAQ, with nearly twice as many companies, holds about 7%.'],
  ['How many companies are listed on the Korean stock market?',
   'About 2,764 issues are listed across KOSPI (about 940) and KOSDAQ (about 1,820), counting common and preferred lines; the top ten are roughly 60% of all market value.'],
  ['Which country does Korea export to the most?',
   'Korea’s two largest export markets are the United States and China, nearly tied at about 20% each; together they take close to 40% of exports. Its largest single import source is China, about a quarter of all imports.'],
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
const jsonLd = [datasetLd, faqLd];
---

<Base title={TITLE} description={DESC} jsonLd={jsonLd} noAds>
  <div class="wrap">
    <article class="pp">
      <p class="kicker">SeoulMarkets · data for licence</p>
      <h1>Korea Concentration Index</h1>
      <p class="sample">Stocks as of {fmtDd(stockAsOf)} · trade {tradeMonth} · updated every trading day</p>
      <p class="lead">
        Rank Korea's listed stocks by value or by trading, or rank its trading partners by exports or
        imports. Each time, the four largest are <b>about half of the total</b> — and every concentration
        Gini clears <b>0.9</b>, past any nation's income gap. It is one of the most top-heavy major
        economies on earth, whether you weigh it by its market or by its trade. This is the compass,
        free. The full daily history and API are what we licence.
      </p>

      {today?.facts?.length && (
        <aside class="today">
          <p class="today-h">Latest trading day · {today.asOf}</p>
          <ul>
            {today.facts.map((t) => <li>{t}</li>)}
          </ul>
          <p class="today-note">Ratios only — KRX price levels are not published. Updated each trading day.</p>
        </aside>
      )}

      <table class="tbl">
        <thead>
          <tr><th>Measured by</th><th>Across</th><th class="n">Top 4 share</th><th class="n">Half at</th><th class="n">Gini</th></tr>
        </thead>
        <tbody>
          {dims.map((d) => (
            <tr>
              <td class="k">{d.key}</td>
              <td class="u">{d.units}</td>
              <td class="n"><b>{d.top4}%</b></td>
              <td class="n">{d.half}</td>
              <td class="n g">{d.gini}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <figure class="fig">
        <img src="/charts/concentration-top4.svg" alt="The top four are about half of Korea's market cap, stock trading, exports and imports alike." loading="lazy" />
      </figure>
      <figure class="fig">
        <img src="/charts/concentration-gini.svg" alt="Gini concentration of Korea's market and trade, all above 0.9, versus income Gini reference lines." loading="lazy" />
      </figure>

      <div class="get">
        <a class="dl" href="/data/korea-concentration.csv" download>Download the daily index (CSV) →</a>
        <p class="note">
          {days > 0 ? `${days} trading day${days > 1 ? 's' : ''} so far` : 'seeding'} — the series grows every
          trading day. The download here is free.
        </p>
        <ul class="tiers">
          <li><b>Free</b> — this page and the daily CSV, latest snapshot and running history.</li>
          <li><b>Pro — from $99/mo</b> (or $990/yr): full multi-year history, per-sector and per-issue breakdowns, and a queryable API.</li>
          <li><b>Enterprise — from $2,500</b>: custom cuts, redistribution rights and bespoke concentration research.</li>
        </ul>
        <form class="wait" id="wl-form" novalidate>
          <p class="wl-lead">The Pro feed isn’t open yet. Leave your email and we’ll tell you when it is — with pricing, no card now.</p>
          <div class="wl-row">
            <label class="wl-label" for="wl-email">Email address</label>
            <input class="wl-input" id="wl-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com" required />
            <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <button class="wl-btn" type="submit">Join the waitlist</button>
          </div>
          <p class="wl-said" id="wl-said" role="status" aria-live="polite"></p>
        </form>
        <p class="note">Enterprise or bespoke research? <a href="/contact">Contact us</a>.</p>
      </div>

      <p class="read">
        The full write-up:{' '}
        <a href="/article/korea-everything-comes-down-to-four">Korea's stock market and trade: the top four are half of everything</a>.
      </p>

      <script is:inline>
        (function () {
          var f = document.getElementById('wl-form');
          if (!f) return;
          var said = document.getElementById('wl-said');
          f.addEventListener('submit', function (e) {
            e.preventDefault();
            var email = (f.email.value || '').trim();
            if (!email || email.indexOf('@') < 1) { said.textContent = 'That does not look like an email address.'; return; }
            if ((f.hp.value || '').trim() !== '') { said.textContent = 'Thanks.'; return; }
            said.textContent = 'Adding you…';
            fetch('/v1/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: email, source: 'concentration-waitlist', hp: '' }),
            }).then(function (r) {
              if (r.ok) {
                said.textContent = 'You’re on the list. We’ll email when the Pro feed opens.';
                f.email.value = '';
                try { if (window.gtag) window.gtag('event', 'waitlist_join', { feed: 'concentration' }); } catch (err) {}
              } else {
                said.textContent = 'Something went wrong — please try again, or email us.';
              }
            }).catch(function () { said.textContent = 'Something went wrong — please try again, or email us.'; });
          });
        })();
      </script>

      <section class="faq">
        <h2>Korea market &amp; trade concentration — the questions people ask</h2>

        <h3>How much of the KOSPI is Samsung?</h3>
        <p>Samsung Electronics is about <b>26.7%</b> of the entire Korean stock market (KOSPI + KOSDAQ) by
        market cap; with SK hynix, the two chipmakers are close to <b>half</b>. See{' '}
        <a href="/article/korea-four-stocks-half-the-market">four stocks are half of Korea's market</a>.</p>

        <h3>How concentrated is the Korean stock market?</h3>
        <p>The four largest stocks are <b>{dims[0].top4}%</b> of total market cap and the top ten are about 60%;
        the concentration Gini is <b>{dims[0].gini}</b>. KOSDAQ holds only ~7% of value but a much larger share
        of daily trading — see <a href="/article/korea-kosdaq-trades-above-its-weight">KOSDAQ trades above its weight</a>.</p>

        <h3>Who are South Korea's biggest trading partners?</h3>
        <p>Korea's top export markets are <b>the United States and China</b>, nearly tied near 20% each; its
        single biggest import source is <b>China</b>, about a quarter of all imports. The top four partners are
        roughly half of trade either way — see{' '}
        <a href="/article/korea-trade-partners-two-giants-one-supplier">two giants, one supplier</a>.</p>

        <h3>What is the KOSPI vs KOSDAQ market cap split?</h3>
        <p>KOSPI holds about <b>93%</b> of total listed market value; KOSDAQ, with nearly twice as many
        companies, holds about <b>7%</b>.</p>

        <h3>How many companies are listed on the Korean stock market?</h3>
        <p>About <b>2,764</b> issues are listed across KOSPI ({dims?.[0] ? '≈940' : ''} of them) and KOSDAQ
        (≈1,820), counting common and preferred lines; the top ten are roughly 60% of all market value.</p>

        <h3>Which country does Korea export to the most?</h3>
        <p>Korea's two largest export markets are the <b>United States and China</b>, nearly tied at about
        20% each; together they take close to 40% of exports. Its largest single import source is China,
        about a quarter of all imports.</p>
      </section>

      <p class="fine">
        Built from Korea Exchange OPEN API (KOSPI + KOSDAQ daily) and Korea Customs Service partner-country
        trade via KOSIS. Every figure is a <b>share or a Gini</b> — scale-invariant, so it does not depend
        on the price or dollar levels in the raw feeds; absolute prices are not published. The Gini here
        measures concentration across issues or partner countries — the income-Gini comparison is an
        intuition anchor, not an identical calculation. Not investment advice. See our{' '}
        <a href="/terms">terms</a>.
      </p>
    </article>
  </div>
</Base>

<style>
  .pp { max-width: 46rem; margin: 0 auto; }
  .kicker { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent);
            font-weight: 700; margin: 1.2rem 0 .3rem; }
  .pp h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.2; margin: 0 0 .4rem; letter-spacing: -.02em; }
  .sample { font-size: .84rem; color: var(--muted); margin: 0 0 1rem; }
  .lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.6rem; }
  .lead b, .fine b { font-weight: 650; }

  .today { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px;
    padding: .9rem 1.1rem; margin: 0 0 1.8rem; background: var(--card); }
  .today-h { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--accent);
    font-weight: 700; margin: 0 0 .5rem; }
  .today ul { margin: 0; padding-left: 1.1rem; }
  .today li { font-size: .92rem; line-height: 1.6; margin: .2rem 0; }
  .today-note { font-size: .78rem; color: var(--muted); margin: .5rem 0 0; }

  .tbl { width: 100%; border-collapse: collapse; margin: 0 0 1.8rem; font-size: .94rem; }
  .tbl th, .tbl td { text-align: left; padding: .55rem .5rem; border-bottom: 1px solid var(--line); }
  .tbl th.n, .tbl td.n { text-align: right; }
  .tbl thead th { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .tbl .k { font-weight: 650; }
  .tbl .u { color: var(--muted); font-size: .86rem; }
  .tbl .g { color: #b45309; font-weight: 650; }

  .fig { margin: 1.2rem 0; }
  .fig img { width: 100%; height: auto; max-width: 100%; border: 1px solid var(--line); border-radius: 8px; }

  .get { border: 1px solid var(--line); border-radius: 10px; padding: 1.2rem 1.3rem; background: var(--card); margin: 1.8rem 0; }
  .dl { font-size: 1rem; font-weight: 700; color: var(--accent); text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 1px; }
  .dl:hover { color: var(--ink); }
  .get .note { font-size: .86rem; color: var(--muted); line-height: 1.6; margin: .8rem 0 0; }

  .tiers { list-style: none; margin: 1rem 0 .4rem; padding: 0; display: grid; gap: .5rem; }
  .tiers li { font-size: .9rem; line-height: 1.55; padding-left: 1rem; position: relative; }
  .tiers li::before { content: '›'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .tiers b { font-weight: 650; }

  .wait { margin: 1rem 0 .2rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .wl-lead { font-size: .9rem; line-height: 1.55; margin: 0 0 .6rem; color: var(--ink); }
  .wl-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .wl-label { position: absolute; left: -9999px; }
  .wl-input { flex: 1 1 14rem; min-width: 0; padding: .55rem .7rem; font-size: .95rem;
    border: 1px solid var(--line); border-radius: 8px; background: var(--bg, #fff); color: var(--ink); }
  .wl-btn { padding: .55rem 1.1rem; font-size: .92rem; font-weight: 700; border: 0; border-radius: 8px;
    background: var(--accent); color: #fff; cursor: pointer; white-space: nowrap; }
  .wl-btn:hover { filter: brightness(1.08); }
  .wl-said { font-size: .84rem; color: var(--muted); margin: .5rem 0 0; min-height: 1em; }

  .faq { margin: 2rem 0 1rem; }
  .faq h2 { font-size: 1.2rem; margin: 0 0 .8rem; letter-spacing: -.01em; }
  .faq h3 { font-size: 1rem; margin: 1.1rem 0 .3rem; }
  .faq p { font-size: .93rem; line-height: 1.65; margin: 0; color: var(--ink-2, var(--ink)); }
  .faq b { font-weight: 650; }

  .read { font-size: .95rem; margin: 1.4rem 0; }
  .fine { font-size: .82rem; color: var(--muted); line-height: 1.6; margin: 2rem 0 1rem;
          padding-top: 1rem; border-top: 1px solid var(--line); }
</style>
