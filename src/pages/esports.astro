---
import Base from '../layouts/Base.astro';
import { SITE_URL } from '../consts';
import ladder from '../data/riot-ladder.json';

/**
 * e스포츠 — 랭크 사다리 교차지역 비교.
 *
 * ── 왜 이 지면이 있는가 ─────────────────────────────────────────
 * 두 가지를 동시에 한다.
 *  1. **Riot Production Key 신청에 필요한 실물 지면.** 빈 사이트로 신청하면 반려된다.
 *     Riot 이 보는 것은 「무료 이용 층이 있는가」와 「변형된 콘텐츠인가」다.
 *     이 지면은 둘 다 만족한다 — 전부 무료이고, 원본 응답이 아니라 분포다.
 *  2. **WikiTip(한류 매체)의 e스포츠 축 시연.** 동남아 독자가 1차 시장이라
 *     SG·VN 을 KR 과 나란히 놓는 것이 이 비교의 핵심이다.
 *
 * ── 왜 프로 경기가 아니라 사다리인가 ────────────────────────────
 * 기획서는 「한국 선수·팀의 국제 대회 성적」을 전제했는데, **개발자 API 에 없다.**
 * 2026-08-02 에 직접 재서 확인했다(403). 대신 랭크 사다리는 전 지역이 열린다.
 * 그래서 질문을 바꿨다 — 「누가 이겼나」가 아니라 **「모집단이 어떻게 다른가」**.
 * 아무도 매일 세지 않는 숫자이고, 사다리는 소급이 안 되므로 아카이브 자체가 상품이다.
 *
 * ── 데이터가 어디서 오는가 ──────────────────────────────────────
 * `scripts/collect-riot-ladder.mjs` 가 매일 22:00 KST 에 뜨면서
 * `src/data/riot-ladder.json` 에 발행용 요약을 쓴다.
 * ⚠ **`archive/` 를 직접 읽지 않는다.** 그 폴더는 gitignore 라 빌드 컨테이너에 없다.
 *   `/v1/research` 가 바로 그것 때문에 503 이었다. 같은 실수를 반복하지 않는다.
 */

const 지역순서 = ['kr', 'sg2', 'vn2', 'jp1', 'na1', 'euw1'];
const 표기 = {
  kr: { name: 'Korea', note: 'The benchmark' },
  sg2: { name: 'Southeast Asia', note: 'Singapore-hosted regional server' },
  vn2: { name: 'Vietnam', note: 'Split from SEA in 2023' },
  jp1: { name: 'Japan', note: 'Smallest ladder here' },
  na1: { name: 'North America', note: '' },
  euw1: { name: 'Europe West', note: "Riot's largest Western server" },
};

const rows = 지역순서
  .filter((id) => ladder.regions[id])
  .map((id) => {
    const r = ladder.regions[id];
    return {
      id,
      name: 표기[id]?.name ?? r.region_name,
      note: 표기[id]?.note ?? '',
      players: r.challenger.players,
      median: r.challenger.lp.median,
      max: r.challenger.lp.max,
      winRate: r.challenger.win_rate,
      games: r.challenger.games.mean_per_player,
      gm: r.grandmaster.players,
    };
  });

/* 「한국이 왜 강한가」의 답이 여기 있다. 서술 대신 숫자에서 뽑는다 —
   손으로 적어 두면 내일 데이터가 바뀌었을 때 본문만 거짓말이 된다. */
const 최고승률 = rows.reduce((a, b) => (a.winRate >= b.winRate ? a : b));
const 최다판수 = rows.reduce((a, b) => (a.games >= b.games ? a : b));
const 최고LP = rows.reduce((a, b) => (a.median >= b.median ? a : b));
const kr = rows.find((r) => r.id === 'kr');

const 날짜 = ladder.day;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'League of Legends ranked ladder, by region',
  description:
    'Daily snapshot of Challenger and Grandmaster ladder distributions across six regional servers. Aggregate statistics only; no player identifiers are stored.',
  url: `${SITE_URL}/esports`,
  temporalCoverage: 날짜,
  creator: { '@id': `${SITE_URL}/#organization` },
  isAccessibleForFree: true,
  license: 'https://www.riotgames.com/en/legal',
};
---

<Base
  title="Why Korea's ladder looks different"
  description="A daily cross-region comparison of the League of Legends Challenger ladder — Korea, Southeast Asia, Vietnam, Japan, North America and Europe West. Aggregate distributions only, no player data."
  jsonLd={jsonLd}
  noAds
>
  <div class="wrap">
    <article class="article">
      <div class="article__head">
        <p class="kicker">Esports data</p>
        <h1>Why Korea's ladder looks different</h1>
        <p class="article__dek">
          Everyone says Korean solo queue is harder. Almost nobody measures it. This is the
          Challenger ladder of six regional servers, side by side, counted the same way every day.
        </p>
      </div>

      <div class="prose">
        <p class="stamp">
          Snapshot of <strong>{날짜}</strong> · collected {ladder.collected_at_kst} KST ·
          queue RANKED_SOLO_5x5
        </p>

        <h2>The ladder, side by side</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th>Server</th>
                <th class="num">Challenger</th>
                <th class="num">Grandmaster</th>
                <th class="num">Median LP</th>
                <th class="num">Top LP</th>
                <th class="num">Win rate</th>
                <th class="num">Games each</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class={r.id === 'kr' ? 'hi' : ''}>
                  <td>
                    <strong>{r.name}</strong>
                    {r.note && <span class="note">{r.note}</span>}
                  </td>
                  <td class="num">{r.players}</td>
                  <td class="num">{r.gm}</td>
                  <td class="num">{r.median?.toLocaleString()}</td>
                  <td class="num">{r.max?.toLocaleString()}</td>
                  <td class="num">{r.winRate}%</td>
                  <td class="num">{r.games}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>What the numbers say</h2>
        <p>
          The telling column is the one you would look at last. Korea's Challenger players post
          the <strong>lowest win rate of the six servers</strong> — {kr?.winRate}% against
          {' '}{최고승률.winRate}% on {최고승률.name}. A win rate is the one statistic that cannot
          be inflated by playing more: every game has a loser, and in a closed pool it converges
          on 50%. The closer a server sits to 50%, the more evenly matched the people inside it
          are.
        </p>
        <p>
          Read the other columns against that.
          {최다판수.id === 최고LP.id ? (
            <>
              {' '}{최고LP.name} leads on everything volume can buy — {최다판수.games?.toLocaleString()}
              {' '}games per player, the highest median LP ({최고LP.median?.toLocaleString()}) and
              the highest ceiling ({최고LP.max?.toLocaleString()}).
            </>
          ) : (
            <>
              {' '}{최다판수.name} plays the most, at {최다판수.games?.toLocaleString()} games per
              player, while {최고LP.name} carries the highest median LP
              ({최고LP.median?.toLocaleString()}) and the highest ceiling
              ({최고LP.max?.toLocaleString()}).
            </>
          )}
          {' '}But volume and a high ceiling are what a large server produces on its own; neither
          says the games inside it are close. Korea's spread is the narrow one, and that
          narrowness is what people are describing when they say the server is hard.
        </p>
        <p>
          Japan is the useful control. Its Challenger tier holds {rows.find((r) => r.id === 'jp1')?.players}
          {' '}players against roughly 300 elsewhere, because tier size scales with the population
          below it. Comparing raw LP across servers of different sizes is a mistake; comparing
          shape is not.
        </p>

        <h2>Why this is a daily series</h2>
        <p>
          A ladder cannot be reconstructed after the fact. There is no endpoint that returns what
          Challenger looked like last Tuesday — the API answers only for right now. So the record
          only exists if somebody was writing it down at the time. We started on {날짜} and take
          one snapshot a day, at the same hour, whether or not anything interesting happened.
        </p>
        <p>
          That is the same reason we archive provisional trade figures the day they are published:
          the revised number replaces the original everywhere, and the original is gone.
        </p>

        <h2>What we do not collect</h2>
        <p>
          <strong>No player identifiers.</strong> The API returns a <code>puuid</code> for every
          entry; we discard it at collection time and keep only the distribution. We are not
          interested in who is on the ladder, only in what shape it is. Holding identifiers we
          would never use is a liability, not an asset — so we do not hold them.
        </p>
        <p>
          We also do not collect or republish match history, chat, or anything from the
          professional circuit. Pro match data is not part of the developer API, and the
          undocumented endpoints that serve lolesports.com are not ours to use.
        </p>

        <h2>Method</h2>
        <ul>
          <li>Endpoints: <code>LEAGUE-V4</code> challenger and grandmaster leagues, queue <code>RANKED_SOLO_5x5</code>.</li>
          <li>One snapshot per server per day, 22:00 KST.</li>
          <li>Win rate is aggregate: total wins ÷ total games across the tier, not a mean of ratios.</li>
          <li>Median LP is the 50th percentile of the tier, not of all ranked players.</li>
          <li>Missing servers are recorded as missing. A gap is never filled with an estimate.</li>
        </ul>

        <p class="disclaimer">
          SeoulMarkets isn't endorsed by Riot Games and doesn't reflect the views or opinions of
          Riot Games or anyone officially involved in producing or managing Riot Games properties.
          Riot Games and all associated properties are trademarks or registered trademarks of Riot
          Games, Inc. Data via the Riot Games API.
        </p>
        <p class="disclaimer">
          Nothing here is investment advice.
        </p>
      </div>
    </article>
  </div>
</Base>

<style>
  .stamp {
    font-size: 0.9rem;
    opacity: 0.75;
    border-left: 3px solid currentColor;
    padding-left: 0.75rem;
  }
  .tablewrap {
    /* 좁은 화면에서 표가 본문을 밀어내지 않게 표 안에서만 스크롤한다 */
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
  }
  th,
  td {
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid rgba(128, 128, 128, 0.28);
    text-align: left;
    white-space: nowrap;
  }
  th {
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  tr.hi td {
    background: rgba(128, 128, 128, 0.09);
  }
  .note {
    display: block;
    font-size: 0.78rem;
    opacity: 0.6;
    white-space: normal;
  }
  .disclaimer {
    font-size: 0.82rem;
    opacity: 0.65;
    margin-top: 1.5rem;
  }
</style>
