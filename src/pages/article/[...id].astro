---
import { render } from 'astro:content';
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import DataNotes from '../../components/DataNotes.astro';
import AdSlot from '../../components/AdSlot.astro';
import { publishedArticles } from '../../lib/articles';
import { tagsForArticle } from '../../lib/tags';
import { formatDate, formatAsOf, categoryLabel, iso } from '../../lib/format';
import { SITE, SITE_URL, PUBLISHER, DISCLAIMER } from '../../consts';

export async function getStaticPaths() {
  const articles = await publishedArticles();
  return articles.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const url = `${SITE_URL}/article/${entry.id}`;

/**
 * 이 기사만의 공유 카드. scripts/make-og-seoulmarkets.mjs 가 미리 만들어 둔다.
 * 카드가 있으면 og:image 로 쓰고, 없으면(서술형 기사 등) Base 가 og-default 로 떨어진다.
 * 프론트matter 의 image 가 있으면 그게 우선.
 */
const 카드있음 = fs.existsSync(`public/og/${entry.id}.png`);
// og:image 는 X·페북·카카오톡 미리보기 자리인데 **SVG 는 이 플랫폼들이 렌더 못 한다** —
// 프론트matter image 가 SVG 차트면 공유 카드가 통째로 빈다(2026-08-25 6번 실측: 이 기사 og 가 .svg 였음).
// 그래서 래스터(png/jpg) 프론트매터면 그걸 우선, SVG 면 디자인된 PNG 카드로 떨어뜨린다(카드 있을 때).
const 프론트래스터 = d.image && !d.image.endsWith('.svg');
const ogImage = 프론트래스터 ? d.image : (카드있음 ? `/og/${entry.id}.png` : d.image);

/**
 * ⭐ 세로 숏영상(카드뉴스→영상)이 이 기사에 있으면 **지면에 실어** 구글 비디오 검색에 잡히게 한다.
 *   (2026-08-24 5번 총괄 발견: 영상 5편을 만들어 놓고 사이트맵·지면에 0편 — 노출 자리 하나를 통째로 비워둠.
 *    영상 2편이 28일 웹클릭의 5배를 가져온 실측이 있다. 썸네일은 첫 카드뉴스(=디자인된 제목 카드)를 쓴다 —
 *    ffmpeg 없이도 되고, 프레임 추출의 「검은 첫 칸」 함정도 없다. 썸네일 없으면 구글이 버리므로 둘 다 있을 때만 낸다.)
 */
// 태그 칩(본문 «위»에 — 74%가 두 번째 지면을 안 눌러 아래 것은 안 보인다, 5번 실측). 2편↑는 /tag 링크, 1편은 글자만.
const 태그칩 = await tagsForArticle(d.tags);

const 영상있음 = fs.existsSync(`public/video/${entry.id}.mp4`) && fs.existsSync(`public/cardnews/${entry.id}-1.png`);
const videoSrc = `${SITE_URL}/video/${entry.id}.mp4`;
const videoThumb = `${SITE_URL}/cardnews/${entry.id}-1.png`;

/**
 * ⭐ 나가는 길 — **본문 끝에서 다음 기사로 직접 건다.** (2번 지시 2026-08-08)
 *
 * 검색으로 한 편에 들어온 사람은 그 한 편만 읽고 나간다. 카테고리로 가는 backlink 는
 * 하나 있었지만 목록으로만 보내고, **어느 기사로 가라**를 말하지 않았다.
 * 같은 갈래를 먼저, 없으면 최근 것으로 채워 세 편을 직접 건다 —
 * 「이미 쓴 34편이 읽히는 것」이 새 기사를 쓰는 것보다 먼저다.
 *
 * publishedArticles() 는 최신순이라 그대로 자르면 최근 것이 앞에 온다.
 */
const 전체 = await publishedArticles();
const 다른것 = 전체.filter((a) => a.id !== entry.id);
// 「Read next」를 주제로 촘촘히 — 공유 태그가 많은 것 먼저, 다음 같은 갈래, 다음 최신(원래 순서).
// 갈래로만 고르면 나가는 문이 주제와 헐거웠다. 링크는 발행된 기사만이라 404 안 난다(2026-08-26, 5번 「문」 지적).
const 내태그 = new Set(d.tags || []);
const 공유수 = (a: any) => (a.data.tags || []).filter((t: string) => 내태그.has(t)).length;
const 읽을것 = [...다른것]
  .map((a, i) => ({ a, i, shared: 공유수(a), sameCat: a.data.category === d.category }))
  .sort((x, y) => (y.shared - x.shared) || (Number(y.sameCat) - Number(x.sameCat)) || (x.i - y.i))
  .slice(0, 3)
  .map((o) => o.a);

/*
 * 이 기사가 이어지는 데이터 상품 — 주제로 고른다. (2번 46083: 기사 → 상품 직접 링크)
 * 검색으로 한 편에 들어온 사람을 그 데이터를 파는 지면으로 곧장 보낸다.
 */
const 상품들 = {
  sector: { href: '/data/sector-workforce-panel', name: 'the sector workforce panel',
    blurb: 'tenure, pay and the gender pay gap for every listed company, by sector' },
  wage: { href: '/data/pension-wage-panel', name: 'the National Pension wage panel',
    blurb: 'a near-census pay ladder by industry, region and firm size' },
  target: { href: '/data/target-price-accuracy', name: 'broker target-price accuracy',
    blurb: 'every broker target scored against the stock twelve months later' },
  board: { href: '/data/board-composition', name: 'board composition by sector',
    blurb: 'women officers, owner-led firms, CEO tenure and boardroom age, by sector' },
  attention: { href: '/data/analyst-attention', name: 'analyst attention by sector',
    blurb: 'where equity research piles up and where it thins, from our broker-report archive' },
  candour: { href: '/data/broker-candour', name: 'broker candour, the vanishing Sell',
    blurb: 'each brokerage’s Buy/Hold/Sell mix — the Sell rating has all but disappeared' },
  leaders: { href: '/data/sector-leaders', name: 'sector leaders vs the rest',
    blurb: 'how a sector’s biggest companies pay, retain and staff their top differently' },
  concentration: { href: '/data/concentration', name: 'the Korea Concentration Index',
    blurb: 'how top-heavy Korea’s market and trade are — Samsung’s KOSPI weight, top partners, updated daily' },
};
const 관련상품 = /comes-down-to-four|four-stocks|kosdaq-trades|trade-partners|two-giants|concentration|half-the-market|largest-listed|largest-companies/.test(entry.id) ? 상품들.concentration
  : /leader|biggest-companies|market-cap-leaders|pay-more/.test(entry.id) ? 상품들.leaders
  : /candour|vanish|sell-rating|stopped-saying|buy-rating|rating/.test(entry.id) ? 상품들.candour
  : /attention|coverage|unwritten|piles-up|ignored/.test(entry.id) ? 상품들.attention
  : /research|broker|price-target|aim-high|hit-less/.test(entry.id) ? 상품들.target
  : /board|officer|governance|director|owner-led/.test(entry.id) ? 상품들.board
  : /pension|wage|churn|separation|workers-concentrate|bigger-firms|small-firms|oldest-workplace|pension-map/.test(entry.id) ? 상품들.wage
  : /tenure|gender|headcount|workforce|market-cap-per-worker|pay-holding|how-long-industries/.test(entry.id) ? 상품들.sector
  : null;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline: d.title,
  description: d.dek,
  datePublished: iso(d.pubDate),
  dateModified: iso(d.updatedDate ?? d.pubDate),
  articleSection: categoryLabel(d.category),
  inLanguage: SITE.lang,
  url,
  image: [new URL(ogImage ?? '/og-default.png', SITE_URL).href],
  author: { '@type': 'Organization', name: `${d.author}, ${SITE.name}`, url: `${SITE_URL}/about` },
  publisher: {
    '@type': 'NewsMediaOrganization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE.name,
    legalName: PUBLISHER.legalName,
  },
  isAccessibleForFree: true,
  keywords: [...d.tags, ...d.tickers].join(', ') || undefined,
  // 데이터 출처를 기계가 읽을 수 있게 남긴다 — 검증 가능성이 곧 신뢰도다.
  citation: d.sources.map((s) => ({
    '@type': 'CreativeWork',
    name: `${s.org} — ${s.api}`,
    ...(s.url ? { url: s.url } : {}),
  })),
};

// 영상이 있으면 VideoObject 스키마를 함께 낸다(구글 비디오 리치결과 자격). 없으면 기사 스키마 하나만.
const videoLd = 영상있음
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: d.title.slice(0, 100),
      description: d.dek,
      thumbnailUrl: [videoThumb],
      uploadDate: iso(d.pubDate),
      contentUrl: videoSrc,
      embedUrl: url,
      publisher: { '@type': 'Organization', name: SITE.name, '@id': `${SITE_URL}/#organization` },
      isAccessibleForFree: true,
    }
  : null;
const jsonLd = 영상있음 ? [articleLd, videoLd] : articleLd;
---

<Base
  title={d.title}
  description={d.dek}
  jsonLd={jsonLd}
  ogType="article"
  image={ogImage}
>
  <div class="wrap">
    <AdSlot slot="banner" />

    <article class="article">
      <div class="article__head">
        <p class="kicker">
          <a class="tag" href={`/${d.category}`}>{categoryLabel(d.category)}</a>
        </p>
        <h1>{d.title}</h1>
        <p class="article__dek">{d.dek}</p>
      </div>

      <div class="byline">
        <span>By the {d.author}, {SITE.name}</span>
        <span>
          Published <time datetime={iso(d.pubDate)}>{formatDate(d.pubDate)}</time>
        </span>
        {
          d.updatedDate && (
            <span>
              Updated <time datetime={iso(d.updatedDate)}>{formatDate(d.updatedDate)}</time>
            </span>
          )
        }
        <span class="asof">Data as of {formatAsOf(d.dataAsOf)}</span>
      </div>

      <p class="transparency">
        <span aria-hidden="true">◆</span>
        <span>
          <strong>{DISCLAIMER.ai}</strong> Figures are pulled programmatically from the official
          sources listed at the end of this article and checked by an editor before publication.{' '}
          <strong>{DISCLAIMER.short}</strong>
        </span>
      </p>

      {/* 태그 칩 — 본문 «위». 2편↑ 태그는 /tag 허브로 링크(내부 mesh+검색), 1편은 글자만(404 안 만듦). */}
      {
        태그칩.length > 0 && (
          <p class="tagchips">
            {태그칩.map((t) => (t.paged
              ? <a class="tagchip" href={`/tag/${t.slug}`}>{t.label}</a>
              : <span class="tagchip tagchip--plain">{t.label}</span>))}
          </p>
        )
      }

      {/* 세로 숏영상 — 있을 때만. 구글 비디오 검색·캐러셀에 잡히는 자리(2026-08-24 5번 총괄 발견). */}
      {
        영상있음 && (
          <figure style="margin:1.4rem auto;max-width:300px;text-align:center;">
            <video
              controls
              preload="none"
              playsinline
              poster={videoThumb}
              style="width:100%;max-width:270px;border-radius:10px;aspect-ratio:9/16;background:#0d1420;display:block;margin:0 auto;"
            >
              <source src={videoSrc} type="video/mp4" />
            </video>
            <figcaption style="font-size:.8rem;color:var(--muted,#666);margin-top:.4rem;">
              A 20-second visual of this story — silent. Not investment advice.
            </figcaption>
          </figure>
        )
      }

      {
        /**
         * ⭐ **정정은 본문 위에 둔다.** 아래에 두면 이미 읽고 나간 뒤다.
         *
         * 데이터저널리즘에서 정정을 숨기면 **숫자 전체가 의심스러워진다.**
         * 반대로 드러내면 「이 매체는 자기 숫자를 다시 본다」가 된다.
         * 우리가 파는 것이 숫자라서, 이 배너는 **비용이 아니라 신용**이다.
         */
        d.corrections?.length > 0 && (
          <aside class="corrections" role="note" aria-label="Corrections">
            <strong>{d.corrections.length === 1 ? 'Correction' : 'Corrections'}</strong>
            <ul>
              {d.corrections.map((c) => (
                <li>
                  <time datetime={iso(c.date)}>{formatDate(c.date)}</time> — {c.note}
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <DataNotes data={d} />

      {
        관련상품 && (
          <aside class="product-cta">
            <span class="pc-kicker">The data behind this article</span>
            <a class="pc-link" href={관련상품.href}>License {관련상품.name} &rarr;</a>
            <span class="pc-blurb">{관련상품.blurb}</span>
          </aside>
        )
      }

      {
        읽을것.length > 0 && (
          <nav class="readnext" aria-label="Read next">
            <h2>Read next</h2>
            <ul>
              {읽을것.map((a) => (
                <li>
                  <a href={`/article/${a.id}`}>
                    <span class="rn-cat">{categoryLabel(a.data.category)}</span>
                    <span class="rn-title">{a.data.title}</span>
                    <span class="rn-dek">{a.data.dek}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {/**
       * ⭐ 라이프 파이프라인 — KLifeMap 으로 보내는 문 + 딱지. (사장님 지시 2026-08-10 · 2번 경유 77112)
       *   회사 구조가 바뀌었다: 돈 받는 곳은 KLifeMap(시장 1.4조), SeoulMarkets 는 소비자를 그리로 보낸다.
       *   · 딱지 from=smk · at=<갈래(카테고리)> — 어느 갈래가 좋은 문인지 /admin 딱지별로 잰다.
       *   · ⛔ 로그인 화면이 아니라 로그인 없이 열리는 /ilzin.html 로 보낸다(2번·6번이 쟀다).
       *   · ⛔ 데이터 상품(B2B) 지면에는 안 붙인다 — 여긴 소비자 기사면이다. 자기 상품 CTA 뒤에 부차로 둔다.
       *   · ⛔ 남의 서비스인 척하지 않는다 — 「From the same team」으로 밝히고, 다른 사이트라고 적는다.
       */}
      <aside class="klm-door">
        <span class="klm-kicker">From the same team</span>
        <a class="klm-link" href={`https://klifemap.ai/ilzin.html?from=smk&at=${d.category}`} rel="noopener">
          KLifeMap — the same team's life-and-career site &rarr;
        </a>
        <span class="klm-blurb">A separate Korean-language project by the makers of {SITE.name}. Opens without an account.</span>
      </aside>

      <a class="backlink" href={`/${d.category}`}>&larr; More {categoryLabel(d.category)}</a>
    </article>
  </div>
</Base>

<style>
  /* 이 기사의 데이터를 파는 지면으로 곧장 보내는 칸. (2번 46083) */
  .product-cta {
    display: block; margin: 2rem 0 0; padding: 1.1rem 1.2rem;
    border: 1px solid var(--accent); border-radius: 10px; background: var(--accent-soft, var(--card));
  }
  .pc-kicker { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--accent); font-weight: 700; margin-bottom: 0.35rem; }
  .pc-link { display: inline-block; font-family: var(--serif, inherit); font-size: 1.08rem;
    font-weight: 650; color: var(--ink); text-decoration: none; margin-bottom: 0.25rem; }
  .pc-link:hover { color: var(--accent); }
  .pc-blurb { display: block; font-size: 0.88rem; line-height: 1.55; color: var(--muted); }

  /* 라이프 파이프라인 문 — 자기 데이터 상품(product-cta)보다 부차적으로 보이게. 강조 테두리 없이 은은하게. */
  .klm-door { display: block; margin: 1.4rem 0 0; padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule, var(--border)); border-radius: 10px; background: var(--card); }
  .klm-kicker { display: block; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted); font-weight: 700; margin-bottom: 0.3rem; }
  .klm-link { display: inline-block; font-size: 0.98rem; font-weight: 600; color: var(--ink);
    text-decoration: none; margin-bottom: 0.2rem; }
  .klm-link:hover { color: var(--accent); }
  .klm-blurb { display: block; font-size: 0.82rem; line-height: 1.5; color: var(--muted); }

  /* 나가는 길. 본문을 다 읽은 사람에게 다음 세 편을 직접 건다. */
  .readnext {
    margin: 3rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--rule, var(--line));
  }
  .readnext h2 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .readnext ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .readnext a {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule, var(--line));
    border-radius: 8px;
    transition: border-color 0.15s;
  }
  .readnext a:hover {
    border-color: var(--accent);
  }
  .rn-cat {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .rn-title {
    display: block;
    font-family: var(--serif, inherit);
    font-size: 1.02rem;
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .rn-dek {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
    /* 두 줄까지만 — 카드 높이를 고르게 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tagchips { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 0; }
  .tagchip { font-size: .74rem; padding: .2rem .6rem; border-radius: 999px; text-transform: capitalize;
             border: 1px solid var(--line, #d9d9d6); color: var(--ink-2, var(--ink)); text-decoration: none; }
  a.tagchip:hover { border-color: var(--accent, #0f4c81); color: var(--accent, #0f4c81); }
  .tagchip--plain { opacity: .6; }
</style>
