---
/**
 * /100y/ranking-sangjo-brand — 순위는 공개한다, 그러나 전부는 아니다 (시리즈 · 상조 브랜드평판 편)
 *
 * 🔴 사장님 지시(2026-09-17, brikorea.com 벤치마킹) 이행 — 한국기업평판연구소
 *   상조 브랜드평판(2026-09-01 발표)을 그대로 인용한다. 100yearmap이 새로
 *   순위를 매기지 않는다. "순위"라는 낱말을 의도적으로 쓴다 — docs/금지말-대장.json 등록.
 *
 * ⭐ 톤: 화제성 1위와 재무건전성(지급여력비율) 1위가 다르고, 특히 4·5위 두 곳은
 *   자본잠식 상태라는 사실만 짚는다 — 위험하다/안전하다는 판정은 하지 않는다.
 * ⚠ 원자료에 충실할 것: 대명아임레디는 공정위 등록법인명이 (주)소노스테이션이다.
 *   상호가 바뀐 사정을 지면에 그대로 밝힌다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/ranking-sangjo-brand-2026.json';

const 자료 = 원본 as any;
const 순위출처 = 자료.순위출처;
const top5 = 자료.top5 as any[];
const 실측 = 자료.실측대조;
const 회사별 = 실측.회사별 as any[];
const 일위 = top5[0];
const 지급여력1위 = [...회사별].sort((a, b) => b.지급여력비율_해당업체 - a.지급여력비율_해당업체)[0];
const 자본잠식곳 = 회사별.filter((r) => r.자본잠식);

const desc =
  `${순위출처.이름}에서 ${일위.회사}가 브랜드평판지수 ${일위.브랜드평판지수.toLocaleString()}점으로 1위입니다. ` +
  `그런데 공정거래위원회 재무공시로는 지급여력비율 1위가 ${지급여력1위.회사}이고, ${자본잠식곳.length}곳은 자본잠식 상태입니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '이 상조회사 순위는 100yearmap이 매긴 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `아닙니다. ${순위출처.이름}를 그대로 인용했습니다. ${순위출처['⚠원자료']}`,
      },
    },
    {
      '@type': 'Question',
      name: '브랜드평판이 높으면 재무구조도 튼튼한가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `이 표로는 아닙니다. 브랜드평판 1위는 ${일위.회사}이지만, 지급여력비율(업계 평균 대비)이 가장 높은 곳은 ${지급여력1위.회사}입니다. 특히 ${자본잠식곳.map((r: any) => r.회사).join('·')}는 자본총계가 마이너스인 자본잠식 상태입니다.`,
      },
    },
  ],
};
---

<HundredYear
  title={`${일위.회사} 브랜드평판 전체 1위 — 그런데 지급여력비율 1위는 ${지급여력1위.회사}입니다`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>
    {일위.회사} 브랜드평판 전체 1위<br class="pcbr" />
    그런데 지급여력비율 1위는 {지급여력1위.회사}입니다
  </h1>

  <div class="warn">
    <p><strong>⚠ 이 순위는 저희가 매긴 게 아닙니다.</strong></p>
    <p class="note">
      {순위출처.이름}({순위출처.발표일} 발표)를 그대로 인용했습니다. {순위출처['⚠원자료']}
    </p>
  </div>

  <p class="sub">
    2026년 9월 상조회사 브랜드평판 조사 결과, <strong>{일위.회사}</strong>가
    브랜드평판지수 <strong>{일위.브랜드평판지수.toLocaleString()}점</strong>으로 전체 1위입니다.
  </p>

  <h2>브랜드평판 순위표</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>순위</th><th>회사</th><th>브랜드평판지수</th></tr></thead>
      <tbody>
        {top5.map((r) => (
          <tr>
            <td>{r.순위}위</td>
            <td>{r.회사}</td>
            <td><strong>{r.브랜드평판지수.toLocaleString()}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 다섯 곳, 공정거래위원회 재무공시로는 어떨까요?</h2>
  <p>{실측.무엇}({실측.조회일} 조회)입니다.</p>
  <p class="note">⚠ {실측['⚠상호대조']}</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>회사</th><th>자본총계</th><th>지급여력비율<br class="pcbr" />(업계평균=100)</th><th>부채비율<br class="pcbr" />(업계평균=100)</th><th>보전비율</th></tr></thead>
      <tbody>
        {회사별.map((r) => (
          <tr>
            <td>{r.회사}</td>
            <td>
              {r.자본총계_원 < 0 ? '−' : ''}{Math.abs(r.자본총계_원).toLocaleString()}원
              {r.자본잠식 && <strong> (자본잠식)</strong>}
            </td>
            <td>{r.지급여력비율_해당업체}</td>
            <td>{r.부채비율_해당업체}</td>
            <td>{r.보전비율_퍼센트}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">⚠ {실측.정의}</p>
  <div class="warn">
    <p>{실측.요지}</p>
  </div>

  <h2>이 지면이 말하지 않는 것</h2>
  <ul>
    {(자료.이자료가못가르는것 as string[]).map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="note">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong> 이 지면은 두 공개 자료를 나란히
    {' '}놓아 보여줄 뿐, 어느 회사가 더 좋은지 판정하지 않습니다. {자료.덮는범위}
  </p>

  <h2>자주 묻는 말</h2>
  {jsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    출처 — 브랜드평판: 한국기업평판연구소({순위출처.url}) · 재무공시: 공정거래위원회
    {' '}선불식 할부거래업자 정보공개(수시공시)
  </p>

  <p class="note">
    <a href="/ranking-university-brand">← 대학 브랜드평판이 앞선다고 취업률도 앞설까요?</a>
    <br />
    <a href="/ranking-city-brand">← 지자체 브랜드평판이 앞선 곳, 인구는 늘고 있을까요?</a>
  </p>

  <HundredAgeWalk 키="ranking-sangjo-brand" />

  <NextQuestionBrief 모은것="한국기업평판연구소 상조 브랜드평판 + 공정거래위원회 선불식 할부거래업자 정보공개" />

  {/* 2번의 자체(무쿠키·무IP) 댓글 시스템 */}
  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/ranking-sangjo-brand"></div>
</HundredYear>
