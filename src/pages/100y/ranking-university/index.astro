---
/**
 * /100y/ranking-university — 순위는 공개한다, 그러나 전부는 아니다 (시리즈 1편)
 *
 * 🔴 사장님 지시(2026-08-31) — docs/3번-순위콘텐트-지침.md 참고.
 *   「사람들이 관심 많은 순위를 찾아 공개하고, 그 순위가 의미있는지 문제제기하라」
 *
 * ⛔⛔ 이 지면은 100yearmap에서 드문 예외 둘 —
 *   ① "순위"라는 낱말을 의도적으로 쓴다(다른 지면은 안 씀 — docs/금지말-대장.json에
 *      이 지면을 의도적으로 등록해 둔다).
 *   ② 순위 자체는 저희가 매긴 게 아니다 — 이미 공개된 중앙일보 대학평가를 그대로
 *      인용하고, 저희 실측(대학알리미 공시)으로 다른 각도를 보여줄 뿐이다.
 *
 * ⛔ 톤: "중앙일보 순위가 틀렸다"가 아니다. 종합평가는 연구실적·평판도 등 여러 축을
 *   섞은 것이고, 여기서는 그 축 가운데 «재학생이 몸으로 겪는» 축(취업·중도탈락·충원)
 *   만 따로 떼어 보여준다 — 관점이 다를 뿐, 어느 쪽도 "틀렸다/맞다"로 판정하지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/ranking-university-2025.json';
import { 조사 } from '../../../lib/josa';

const 자료 = 원본 as any;
const 항목 = 자료.항목 as any[];

/** 취업률 기준으로 다시 줄을 세운다 — 여기서만 "순위"를 손으로 계산한다(자료는 실측값 그대로) */
const 취업률순 = [...항목].sort((a, b) => b.취업률 - a.취업률);
const 취업률순위표 = new Map(취업률순.map((r, i) => [r.이름, i + 1]));

const 일등 = 항목.find((r) => r.중앙일보순위 === 1);
const 일등의취업률순위 = 취업률순위표.get(일등.이름);
const 취업률1등 = 취업률순[0];

/**
 * 🔴 사장님 지시(2026-08-31, 2번 경유) — 「대학들이 «왜 우리 순위가 이것밖에 안돼»
 *   라는 생각이 들게 공격적으로 대학명을 제목에 기재해」. "8위" 같은 숫자가 아니라
 *   **실명 대 실명**으로 헤드라인에 박는다. 과장 어휘("충격"류)는 여전히 안 쓴다 —
 *   실명+실측 대비 자체가 이미 강하다.
 */
const 헤드라인 = `${일등.이름}${조사(일등.이름, '이가')} 종합 1위인데, 취업률은 ${취업률1등.이름}보다 낮습니다`;

const desc =
  `중앙일보 대학평가 2025 종합 1~10위를 그대로 옮기고, 같은 대학 10곳의 취업률·중도탈락률· ` +
  `충원율(대학알리미 공시)을 나란히 놓았습니다. 종합 1위 ${일등.이름}(취업률 ${일등.취업률}%)은 ` +
  `취업률로 다시 줄을 세우면 ${일등의취업률순위}위이고, 취업률 1위는 ${취업률1등.이름}` +
  `(${취업률1등.취업률}%, 종합 ${취업률1등.중앙일보순위}위)입니다. 순위는 보는 각도에 따라 달라집니다.`;

/** 가로 막대 — ⛔ 라이브러리를 쓰지 않는다. keep-working 지면의 선 그림과 같은 결 */
const 그림 = (() => {
  const 폭 = 640, 줄높이 = 34, 왼 = 190, 오 = 60, 위 = 10;
  const 높 = 위 + 항목.length * 줄높이 + 10;
  const 최대 = Math.max(...항목.map((r) => r.취업률));
  const 최소 = Math.min(...항목.map((r) => r.취업률));
  const 막대폭 = (v: number) => ((v - 최소 + 3) / (최대 - 최소 + 6)) * (폭 - 왼 - 오);
  return { 폭, 줄높이, 왼, 오, 위, 높, 막대폭 };
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '이 순위는 100yearmap이 만든 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '아닙니다. 중앙일보 대학평가 2025 종합순위를 그대로 인용했습니다. 100yearmap은 순위를 새로 매기지 않습니다 — 같은 대학들의 취업률·중도탈락률·충원율(대학알리미 공시)을 나란히 보여줄 뿐입니다.',
      },
    },
    {
      '@type': 'Question',
      name: `왜 ${일등.이름}${조사(일등.이름, '은는')} 종합 1위인데 취업률은 ${일등의취업률순위}위인가요?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: '중앙일보 종합평가는 연구실적·평판도 등 여러 지표를 섞은 값입니다. 취업률은 그 지표 중 하나가 아니라 대학알리미가 따로 공시하는 별개의 실측치입니다. 두 순위가 다른 것은 "틀렸다"가 아니라, 보는 각도가 다르기 때문입니다.',
      },
    },
  ],
};
---

<HundredYear
  title={헤드라인}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>{일등.이름}{조사(일등.이름, '이가')} 종합 1위인데,<br />취업률은 {취업률1등.이름}보다 낮습니다</h1>

  <div class="warn">
    <p><strong>⚠ 이 순위는 저희가 매긴 게 아닙니다.</strong></p>
    <p class="note">
      {자료.순위출처.이름}를 그대로 인용했습니다. {자료.순위출처['⚠원자료']}
    </p>
  </div>

  <p class="sub">
    중앙일보 대학평가 2025 종합 1~10위와, 같은 대학 10곳의 {자료.실측출처.공시연도}년
    {' '}대학알리미 공시 실측치(취업률·중도탈락률·재학생충원율·전임교원확보율)를 나란히 놓았습니다.
    {' '}순위 하나로는 안 보이던 것이 있습니다.
  </p>

  <h2>취업률로 다시 줄을 세우면</h2>
  <p class="note">
    막대 길이는 취업률입니다. 왼쪽 숫자는 중앙일보 종합순위, 오른쪽은 취업률 기준으로
    다시 센 순위입니다. 두 순위가 같은 줄에서 계속 내려가지 않는다는 것이 눈에 보입니다.
  </p>
  <div class="tablewrap">
    <svg viewBox={`0 0 ${그림.폭} ${그림.높}`} width="100%" style="max-width:640px" role="img"
         aria-label={항목.map((r) => `종합 ${r.중앙일보순위}위 ${r.이름} 취업률 ${r.취업률}% (취업률순위 ${취업률순위표.get(r.이름)}위)`).join(', ')}>
      {항목.map((r, i) => {
        const y = 그림.위 + i * 그림.줄높이;
        const w = 그림.막대폭(r.취업률);
        const 취업률순위 = 취업률순위표.get(r.이름);
        const 어긋남 = 취업률순위 !== r.중앙일보순위;
        return (
          <g>
            <text x={그림.왼 - 10} y={y + 18} text-anchor="end" font-size="13" fill="currentColor">
              {r.중앙일보순위}위 {r.이름}
            </text>
            <rect x={그림.왼} y={y + 4} width={Math.max(2, w)} height={18}
                  fill={어긋남 ? '#c9a84c' : '#8b8b96'} />
            <text x={그림.왼 + w + 8} y={y + 18} font-size="13" fill="currentColor">
              {r.취업률}% (취업률 {취업률순위}위)
            </text>
          </g>
        );
      })}
    </svg>
  </div>
  <p class="note">
    ⭐ 색이 다른 줄(금색)은 종합순위와 취업률순위가 다른 대학입니다. 10곳 가운데
    {' '}{항목.filter((r) => 취업률순위표.get(r.이름) !== r.중앙일보순위).length}곳이 그렇습니다.
  </p>

  <h2>표로 다시 보면</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>종합순위</th><th>대학</th><th>취업률</th><th>취업률순위</th><th>중도탈락률</th><th>재학생충원율</th></tr></thead>
      <tbody>
        {항목.map((r) => (
          <tr>
            <td>{r.중앙일보순위}위</td>
            <td><a href={r.url}>{r.이름}</a></td>
            <td>{r.취업률}%</td>
            <td>{취업률순위표.get(r.이름)}위</td>
            <td>{r.중도탈락률}%</td>
            <td>{r.재학생충원율}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    취업률 1위는 {취업률1등.이름}({취업률1등.취업률}%, 종합 {취업률1등.중앙일보순위}위)입니다.
    {' '}출처 — {자료.실측출처.이름}, {자료.실측출처.공시연도}년 공시.
  </p>

  <h2>왜 이렇게 다를까요</h2>
  <p>
    중앙일보 종합평가는 연구실적·교수 1인당 논문·평판도 등 여러 지표를 섞습니다.
    {' '}취업률·중도탈락률·충원율은 그 지표 중 하나가 아니라, 대학알리미가 매년 따로
    {' '}공시하는 별개의 실측치입니다. <strong>어느 쪽이 "진짜 순위"라고 말할 수 없습니다</strong> —
    {' '}무엇을 재는지가 다르기 때문입니다. 연구를 많이 하는 대학과, 졸업 뒤 곧장 일터로
    {' '}가는 대학이 반드시 같을 이유는 없습니다.
  </p>

  <p class="note">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong> 어느 대학이 "더 낫다"는 판정이 아니라,
    {' '}순위라는 것이 무엇을 재느냐에 따라 달라진다는 것을 보여줄 뿐입니다.
  </p>

  <h2>자주 묻는 말</h2>
  {jsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    <a href="/major">← 학과별로 졸업 뒤 어떻게 됐는지 보기</a>
    <br />
    <a href="/ages">← 나이로 보는 문 — 0세부터 100세까지 한 자리에</a>
  </p>

  <NextQuestionBrief 모은것="중앙일보 대학평가 2025 언론 보도 + 대학알리미 공시" />

  {/* 🔴 2번의 자체 댓글 시스템(2026-08-31, 무쿠키·무IP) — docs/세션간-메모.md 160848 참고 */}
  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/ranking-university"></div>
</HundredYear>
