---
/**
 * /100y/university — 대학 찾기
 *
 * ⛔ 「대학 순위」를 만들지 않는다. 지역으로 묶고, 지역 안에서는 가나다순이다.
 *    옆에 붙는 중도탈락률은 **사실**이지 등수가 아니다. 정렬 기준으로 쓰지 않는다.
 *
 * ⚠ 첫 지역만 펼쳐 둔다 — `<details>` 안이 전부 접혀 있으면 검색엔진이
 *   「숨긴 내용」으로 낮게 볼 수 있다(2번 지적, 2026-08-04). 아직 실측한 적은 없다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { 퍼센트 } from '../../../lib/number-format';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredCardnews from '../../../components/HundredCardnews.astro';
import { href } from '../../../lib/hundredyear';
import { 수치있음, 폐교정보 } from '../../../lib/university';
import universities from '../../../data/100yearmap/pages-university.json';

const 묶음 = new Map<string, any[]>();
for (const u of universities as any[]) {
  const k = u.지역 ?? '미분류';
  if (!묶음.has(k)) 묶음.set(k, []);
  묶음.get(k)!.push(u);
}
const 지역목록 = [...묶음.entries()]
  .map(([지역, list]) => ({ 지역, list: list.sort((a, b) => a.표시명.localeCompare(b.표시명, 'ko')) }))
  .sort((a, b) => b.list.length - a.list.length);

const 전체 = (universities as any[]).length;
const 종류별 = new Map<string, number>();
for (const u of universities as any[]) 종류별.set(u.종류, (종류별.get(u.종류) ?? 0) + 1);
const 공시연도 = (universities as any[])[0]?.공시연도;
/** ⚠ 2026-08-05 실측 — 377곳 중 48곳은 지표가 **하나도** 없다. 숨기지 않고 표시한다 */
const 수치없는곳 = (universities as any[]).filter((u) => !수치있음(u) && !폐교정보(u)).length;
/** 🔴 문 닫은 학교 — 2026-08-05 에 한국사학진흥재단 명단으로 확인했다 */
const 폐교한곳 = (universities as any[]).filter((u) => 폐교정보(u)).length;

/**
 * 🔴 구분마다 전국 평균이 따로다 — 자료에서 캔다. ⛔ 손으로 박지 않는다
 * ⚠ 무리 이름도 자료에서 센다(구분 「대학」에 든 종류는 대학교·교육대학). 넘겨짚어 「4년제」로 쓰지 않는다
 */
const 평균캐기 = (지표: string) => {
  const 낸다: Record<string, number> = {};
  for (const x of universities as any[]) {
    const d = x[지표];
    if (d?.전국평균 != null) 낸다[x.구분] = d.전국평균;
  }
  return 낸다;
};
const 종류모음 = (구분: string) =>
  [...new Set((universities as any[]).filter((u) => u.구분 === 구분).map((u) => u.종류))].join('·');
const 취평균 = 평균캐기('취업률');
const 교원평균 = 평균캐기('전임교원확보율');
const 무리평균 = {
  대학이름: 종류모음('대학'),
  전문이름: 종류모음('전문대학'),
  취업: 취평균,
  교원: 교원평균,
  벌어짐: Math.round(Math.abs(교원평균['대학'] - 교원평균['전문대학']) * 10) / 10,
};

const desc =
  `전국 대학 ${전체}곳을 지역별로 정리했습니다. 학교를 고르면 졸업생 100명 가운데 몇 명이 취업했는지, 다니던 100명 중 몇 명이 ` +
  `학교를 떠났는지, 같은 종류 학교들의 가운데값과 얼마나 다른지 볼 수 있습니다.`;
---

<HundredYear title="대학 찾기" description={desc}>
  <h1>대학 찾기</h1>
  <p class="sub">
    {/* 🔴 2026-08-14 — `—` 뒤에 빈칸이 사라져 「377곳입니다 —대학교 222」로 붙어 있었다.
        줄 끝 빈칸은 JSX 가 지운다. **{' '} 로 또렷이 적어야** 남는다.
        폰으로 넘겨 보고 잡았다. 2번이 같은 날 SeoulMarkets 에서 잡은 「KOSPI's06/22」와 같은 결이다 */}
    전국 <strong>{전체}곳</strong>입니다 —{' '}
    {[...종류별.entries()].map(([k, v], i) => (
      <>{i > 0 && ' · '}{k} {v}</>
    ))}
    {공시연도 && <> · {공시연도}년 대학정보공시 기준</>}
  </p>

  <input
    id="q"
    type="search"
    placeholder="학교 이름을 입력하세요 (예: 강릉원주, 교육대)"
    autocomplete="off"
    aria-label="대학 이름 검색"
  />
  <p class="note" id="cnt" aria-live="polite"></p>

  {
    지역목록.map(({ 지역, list }, i) => (
      <details class="grp" data-track={지역} open={i === 0}>
        <summary>
          {지역} <span class="note">{list.length}곳</span>
        </summary>
        <ul class="unis">
          {list.map((u) => (
            <li data-name={u.표시명}>
              <a href={href(u.url)}>{u.표시명}</a>
              <span class="note">
                {' '}{u.종류}
                {u.취업률 && <> · 취업 {퍼센트(u.취업률.값)}</>}
                {/* ⚠ 찾기 지면에서는 **빼지 않는다.** 검색해서 온 사람에게는
                    「수치가 없다」는 것 자체가 답이다. 대신 눌러 보기 전에 알려 준다.
                    ⛔ 「나쁜 학교」 표시가 아니다 — 캠퍼스는 본교에 수치가 몰려 있을 뿐이다
                    🔴 문을 닫은 학교는 **「수치 없음」이 아니라 「폐교」**라고 쓴다.
                       그게 찾는 사람이 실제로 알고 싶은 것이다 (2026-08-05) */}
                {폐교정보(u) ? (
                  <> · <span class="closed-tag">{폐교정보(u)!.폐교년도}년 폐교</span></>
                ) : (
                  !수치있음(u) && <> · <span class="nodata">수치 없음</span></>
                )}
              </span>
            </li>
          ))}
        </ul>
      </details>
    ))
  }

  <hr class="rule" />
  <p class="note">
    출처 — 한국대학교육협의회 대학정보공시(대학알리미), {공시연도}년.
    {/* ⚠ `</strong>` 다음 줄에 글이 오면 JSX 가 줄바꿈을 지워 **공백이 사라진다.** `{' '}` 로 못박는다 */}
    가나다순으로 놓았습니다. <strong>순위가 아닙니다.</strong>{' '}
    취업률·중도탈락률은 학교의 성적표가 아닙니다 — 대학원 진학자는 취업자가 아니고, 자퇴에는 편입·반수·전공 변경이 섞여 있습니다.
  </p>

  {/* 🔴 2026-08-16 — 「전국 평균」이 **하나가 아니다.** 학교 지면마다 어느 무리인지 적어 두었지만,
      이 목록에서 여러 학교를 훑는 사람은 그 차이를 모른 채 나란히 견준다. 여기서 한 번 말한다.
      ⚠ 수는 자료에서 캐서 쓴다. 손으로 안 박는다 — 89.6 − 62.8 = 26.8 도 자료에서 낸다 */}
  <div class="warn">
    <p><strong>⚠ 「전국 평균」은 하나가 아닙니다.</strong></p>
    <p class="note">
      대학정보공시는 <strong>{무리평균.대학이름}</strong>끼리, <strong>{무리평균.전문이름}</strong>끼리
      평균을 따로 냅니다. 취업률만 해도 {무리평균.취업.대학}% 와 {무리평균.취업.전문대학}% 로 다르고,
      전임교원확보율은 {무리평균.교원.대학}% 와 {무리평균.교원.전문대학}% 로{' '}
      <strong>{무리평균.벌어짐}%p</strong> 벌어집니다.{' '}
      그러니 <strong>다른 구분의 학교끼리 「전국 평균 대비」를 나란히 놓고 보시면 안 됩니다.</strong>
      없는 차이가 보이거나, 있는 차이가 가려집니다.
    </p>
  </div>

  {/* ⚠ 「수치 없음」이 왜 붙는지 여기서 한 번 설명한다. 안 하면 「나쁜 학교」로 읽힌다 */}
  <p class="note">
    ⚠ 「수치 없음」은 <strong>{수치없는곳}곳</strong>에 붙어 있습니다. 두 가지 경우입니다 —{' '}
    <strong>제N캠퍼스</strong>는 수치가 본교에 묶여서 나오고(캠퍼스 단위 공시가 없습니다),
    나머지는 공시 명단에 이름은 있는데 숫자가 오지 않는 학교입니다.{' '}
    <strong>학교가 나쁘다는 표시가 아닙니다.</strong>
  </p>
  <p class="note">
    🔴 「○○년 폐교」는 <strong>{폐교한곳}곳</strong>입니다 — 실제로 문을 닫아 더 이상 신입생을 받지
    않는 학교입니다. 지면은 지우지 않았습니다. 그 학교를 나오신 분에게는 <strong>모교</strong>이고,
    졸업증명서를 어디서 떼는지가 필요하실 수 있습니다.
    출처 — 한국사학진흥재단 「폐교 및 법인 해산 현황」.
  </p>  <HundredCardnews 벌="전국평균두개" 장수={6} 머리="「전국 평균」 카드 여섯 장" />

  <NextQuestionBrief 모은것="대학 자료" />
</HundredYear>

<style>
  #q {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    font-size: var(--fs-body);
    font-family: inherit;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    margin: 0 0 0.5rem;
  }
  #q:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .grp {
    border-bottom: 1px solid var(--line);
  }
  .grp > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-weight: 600;
    cursor: pointer;
  }
  .unis {
    list-style: none;
    padding: 0 0 0.75rem;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 30rem) {
    .unis {
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }
  }
  .unis li {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-body);
  }
  /* 🔴 24px 이었다 — 377줄이 27px 로 나왔다(2026-08-09 05:2x · 375px 실측) */
  .unis li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  /* 「수치 없음」 — 눈에 띄되 낙인처럼 보이지 않게. 붉은색을 쓰지 않는다 */
  .nodata {
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0 0.3em;
    font-size: 0.92em;
  }
  /* 🔴 폐교 표시 — 「수치 없음」보다 세게. 그래도 붉은색은 안 쓴다.
     누군가의 모교다. 사고 화면처럼 보이면 안 된다 */
  .closed-tag {
    color: var(--gold-pale);
    border: 1px solid var(--gold-deep);
    border-radius: 3px;
    padding: 0 0.3em;
    font-size: 0.92em;
    white-space: nowrap;
  }
  [hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var q = document.getElementById('q');
    var cnt = document.getElementById('cnt');
    var items = Array.prototype.slice.call(document.querySelectorAll('.unis li'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('.grp'));
    if (!q) return;

    function apply() {
      var v = q.value.trim();
      if (!v) {
        items.forEach(function (li) { li.hidden = false; });
        groups.forEach(function (g, i) { g.hidden = false; g.open = i === 0; });
        cnt.textContent = '';
        return;
      }
      var n = 0;
      items.forEach(function (li) {
        var hit = li.getAttribute('data-name').indexOf(v) >= 0;
        li.hidden = !hit;
        if (hit) n++;
      });
      groups.forEach(function (g) {
        var has = !!g.querySelector('.unis li:not([hidden])');
        g.hidden = !has;
        g.open = has;
      });
      cnt.textContent = n ? '「' + v + '」 ' + n + '곳' : '「' + v + '」 로 찾은 대학이 없습니다';
    }

    q.addEventListener('input', apply);
    var qs = new URLSearchParams(location.search).get('q');
    if (qs) { q.value = qs; apply(); }
  })();
</script>
