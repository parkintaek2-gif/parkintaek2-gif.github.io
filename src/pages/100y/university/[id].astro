---
/**
 * /100y/university/[id] — 대학 페이지 377장
 *
 * 백년지도의 **두 번째 축**이다. 여태는 고등학교밖에 없었다(대학 페이지 0장).
 * 2026-08-04 대학알리미가 열리면서 생겼다.
 *
 * 화면 순서 — 학과 페이지(P1)와 같은 뼈대
 *   ❶ 한 줄 답      — 「100명 중 6명이 학교를 떠났습니다」
 *   ❷ 두 숫자        — 중도탈락률 · 재적학생
 *   ❸ 해석 한 문단   — 규칙이 만든 문장. LLM 이 쓰지 않는다
 *   ❹ 이 숫자는 어디서 왔나 (접어서)
 *   ❺ 다음 걸음
 *
 * ⛔ 「몇 위」·「상위 몇 %」를 쓰지 않는다. 그게 줄세우기다.
 *    쓰는 것은 **같은 종류 학교들의 가운데값과의 차이**뿐이다 — 등수가 아니라 위치다.
 *
 * ⛔ 「좋은 학교/나쁜 학교」로 읽히게 쓰지 않는다.
 *    중도탈락은 학교의 성적표가 아니다. 편입·재수·진로변경이 다 여기 섞여 있다.
 *    그 말을 ❸에 반드시 붙인다. 안 붙이면 우리가 숫자로 거짓말하는 것이 된다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { href, lastSegment } from '../../../lib/hundredyear';
import universities from '../../../data/100yearmap/pages-university.json';

export async function getStaticPaths() {
  return (universities as any[]).map((u) => ({
    params: { id: lastSegment(u.url) },
    props: { uni: u },
  }));
}

const { uni } = Astro.props as { uni: any };

/** 같은 지역 · 같은 종류 학교 — ❺ 다음 걸음에 쓴다. 가나다순(등수가 아니다) */
const 이웃 = (universities as any[])
  .filter((u) => u.schlId !== uni.schlId && u.지역 === uni.지역 && u.종류 === uni.종류)
  .sort((a, b) => a.표시명.localeCompare(b.표시명, 'ko'))
  .slice(0, 12);

const 차이 = uni.가운데값과의차이;
const 떠난 = uni.떠난사람_100명중;

/** ❸ 해석 — 규칙이 만든다. 숫자가 바뀌면 문장도 같이 바뀐다 */
function 해석문() {
  if (uni.중도탈락률 == null) {
    return `${uni.title}의 중도탈락 수치는 ${uni.공시연도}년 공시에 값이 없습니다. 수치가 없다는 것이 「0」이라는 뜻은 아닙니다 — 공시 대상이 아니거나 아직 제출되지 않은 것으로 보이는데, 어느 쪽인지는 저희가 아직 확인하지 못했습니다.`;
  }
  const 남은 = 100 - 떠난;
  const 위치 =
    차이 == null || Math.abs(차이) < 0.5
      ? `전국 ${uni.종류} ${uni.같은종류_표본}곳의 가운데쯤입니다`
      : 차이 > 0
        ? `전국 ${uni.종류} ${uni.같은종류_표본}곳의 가운데값(${uni.같은종류_가운데값}%)보다 ${Math.abs(차이)}%p 높습니다`
        : `전국 ${uni.종류} ${uni.같은종류_표본}곳의 가운데값(${uni.같은종류_가운데값}%)보다 ${Math.abs(차이)}%p 낮습니다`;

  return (
    `${uni.title}에 다니던 100명 가운데 ${남은}명은 그 해에도 학교에 남아 있었고, ${떠난}명은 학교를 떠났습니다. ` +
    `${위치}. ` +
    `다만 이 숫자를 학교의 성적표로 읽으면 안 됩니다 — 자퇴에는 편입, 반수, 재수, 전공을 바꾸려는 결정이 모두 섞여 있습니다. ` +
    `떠난 사람이 많다는 것은 「나쁜 학교」라는 뜻이 아니라, 들어와 보고 생각이 달라진 사람이 그만큼 있었다는 뜻입니다.`
  );
}

/** 표시명은 수집 단계에서 이미 만들어져 있다 — 지면마다 다시 만들면 언젠가 어긋난다 */
const 제목 = uni.표시명;
const desc =
  uni.중도탈락률 != null
    ? `${제목}(${uni.지역} · ${uni.설립} ${uni.종류})에 다니던 100명 중 ${떠난}명이 그 해에 학교를 떠났습니다. ${uni.공시연도}년 대학정보공시 기준입니다.`
    : `${제목}(${uni.지역} · ${uni.설립} ${uni.종류})의 ${uni.공시연도}년 대학정보공시 자료입니다.`;
---

<HundredYear title={제목} description={desc}>
  <h1>{제목}</h1>
  <p class="sub">
    {uni.지역} · {uni.설립} {uni.종류}
    {uni.재적학생 != null && <> · 재적학생 {uni.재적학생.toLocaleString()}명</>}
  </p>

  {
    uni.중도탈락률 != null ? (
      <>
        {/* ❶ 한 줄 답 — 이 문장 하나만 읽어도 답이 되게 한다 */}
        <div class="answer">
          <p class="answer-label">이 학교에 다니던 100명 가운데, 그 해에 학교를 떠난 사람</p>
          <p class="answer-num">{떠난}명</p>
          <p class="answer-sub">
            중도탈락률 {uni.중도탈락률}%
            {차이 !== null && 차이 !== 0 && (
              <>
                {' '}· 전국 {uni.종류} 가운데값보다 {Math.abs(차이)}%p{' '}
                {차이 > 0 ? '높습니다' : '낮습니다'}
              </>
            )}
          </p>
        </div>

        {/* ❷ 두 숫자 */}
        <h2>숫자 두 개</h2>
        <div class="nums">
          <div class="num">
            <span class="n">{uni.중도탈락률}%</span>
            <span class="k">중도탈락률</span>
          </div>
          <div class="num">
            <span class="n">{uni.같은종류_가운데값}%</span>
            <span class="k">전국 {uni.종류} 가운데값</span>
          </div>
          {uni.재적학생 != null && (
            <div class="num">
              <span class="n">{uni.재적학생.toLocaleString()}</span>
              <span class="k">재적학생(명)</span>
            </div>
          )}
        </div>
        <p class="warn">
          ⚠ 「가운데값」은 <strong>전국 {uni.종류} {uni.같은종류_표본}곳</strong>의 중앙값을
          저희가 직접 계산한 것입니다. 대학정보공시가 발표한 값이 아닙니다.
          전문대학과 4년제를 섞으면 숫자가 거짓말을 하기 때문에 같은 종류끼리만 비교했습니다.
        </p>

        {/* ❸ 해석 */}
        <p>{해석문()}</p>
      </>
    ) : (
      <>
        <p class="warn">
          ⚠ {uni.공시연도}년 공시에 이 학교의 중도탈락 수치가 없습니다.
        </p>
        <p>{해석문()}</p>
      </>
    )
  }

  {/* ❹ 어디서 왔나 — 접어 둔다 */}
  <details>
    <summary>이 숫자는 어디서 왔나</summary>
    <div class="card">
      <p class="note">
        <strong>출처</strong> {uni.출처}<br />
        <strong>공시연도</strong> {uni.공시연도}년<br />
        <strong>지표</strong> 중도탈락학생비율(%) · 재적학생(명)<br />
        {uni.전체이름 && <><strong>공시 표기</strong> {uni.전체이름}<br /></>}
        <strong>받은 곳</strong> 공공데이터포털 오픈API (한국대학교육협의회)
      </p>
      <p class="note">
        ⚠ 「전국 가운데값」은 원자료에 있던 값이 아니라, 저희가 받은
        {' '}{uni.같은종류_표본}곳의 값으로 <strong>직접 계산</strong>한 중앙값입니다.
        대학알리미가 함께 주는 지역별 집계표는 단위가 달라 보여, 저희가 확인하기 전에는 쓰지 않았습니다.
      </p>
      <p class="note">
        ⛔ 저희는 대학에 순위를 매기지 않습니다. 이 지면 어디에도 「몇 위」는 없습니다.
      </p>
    </div>
  </details>

  {/* ❺ 다음 걸음 */}
  {
    이웃.length > 0 && (
      <>
        <h2>{uni.지역}의 다른 {uni.종류}</h2>
        <p class="note">가나다순입니다. 순위가 아닙니다.</p>
        <ul class="neighbors">
          {이웃.map((u) => (
            <li>
              <a href={href(u.url)}>{u.표시명}</a>
              {u.중도탈락률 != null && <span class="note"> {u.중도탈락률}%</span>}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <hr class="rule" />
  <p class="note">
    고등학교와 학과는 <a href="/major">학과 찾기</a> · <a href="/school">학교 찾기</a> 에서 볼 수 있습니다.
  </p>
</HundredYear>

<style>
  .neighbors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 30rem) {
    .neighbors {
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }
  }
  .neighbors li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-body);
  }
  .neighbors li a {
    display: inline-block;
    min-height: 24px;
  }
</style>
