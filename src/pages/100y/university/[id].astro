---
/**
 * /100y/university/[id] — 대학 페이지 377장
 *
 * 백년지도의 **두 번째 축**이다. 여태는 고등학교밖에 없었다(대학 페이지 0장).
 * 2026-08-04 대학알리미가 열리면서 생겼다.
 *
 * 화면 순서 — 학과 페이지(P1)와 같은 뼈대
 *   ❶ 한 줄 답      — 「졸업한 100명 중 60명이 취업했습니다」
 *   ❷ 숫자 넷       — 취업률 · 중도탈락률 · 재학생충원율 · 전임교원확보율
 *   ❸ 해석 한 문단   — 규칙이 만든 문장. LLM 이 쓰지 않는다
 *   ❹ 이 숫자는 어디서 왔나 (접어서)
 *   ❺ 다음 걸음
 *
 * ⭐ **첫 숫자는 취업률이다.** 중도탈락이 아니다.
 *   백년지도가 답하기로 한 질문은 「그 길로 가면 **졸업하고 나서** 어떻게 되나」다.
 *   중도탈락은 「들어가서 어떻게 되나」라 그 다음이다.
 *
 * ⛔ 「몇 위」·「상위 몇 %」를 쓰지 않는다. 그게 줄세우기다.
 *    쓰는 것은 **전국 평균과의 차이**뿐이다 — 등수가 아니라 위치다.
 *
 * ⛔ 「좋은 학교/나쁜 학교」로 읽히게 쓰지 않는다.
 *    중도탈락에는 편입·반수·전공변경이 다 섞여 있다. 그 말을 ❸에 반드시 붙인다.
 *    취업률도 마찬가지다 — 대학원에 간 사람은 취업자에 들어가지 않는다.
 *
 * ⭐ 평균은 **공시가 발표한 값**(`indctAvg`)이다. 우리가 계산하지 않았다.
 *    처음엔 우리가 중앙값을 냈었는데, 공식 평균이 있는 걸 알고 전부 바꿨다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { href, lastSegment } from '../../../lib/hundredyear';
import { 수치있음, 캠퍼스인가, 본교찾기, 권할만한 } from '../../../lib/university';
import { 대학연구, 전체편수 } from '../../../lib/research';
import universities from '../../../data/100yearmap/pages-university.json';

/** ⚠ 지면마다 다시 고르면 377번 돈다. 모듈 최상위에서 한 번만 고른다 */
const 관련연구 = 대학연구();

export async function getStaticPaths() {
  return (universities as any[]).map((u) => ({
    params: { id: lastSegment(u.url) },
    props: { uni: u },
  }));
}

const { uni } = Astro.props as { uni: any };

/** 같은 지역 · 같은 종류 학교 — ❺ 다음 걸음. 가나다순(등수가 아니다)
 *  ⚠ 2026-08-05 — **수치가 하나도 없는 학교를 여기서 뺐다.**
 *    강원 지역 대학교 13곳 중 5곳이 그랬다(캠퍼스 4 + 한중대학교).
 *    누르면 텅 빈 지면이 나온다 — 없는 선택지를 학부모에게 내밀고 있었다.
 *  ⛔ 지면을 지운 것이 아니다. **우리 쪽에서 먼저 권하지 않을 뿐**이다. */
const 이웃 = 권할만한(
  (universities as any[]).filter(
    (u) => u.schlId !== uni.schlId && u.지역 === uni.지역 && u.종류 === uni.종류,
  ),
)
  .sort((a, b) => a.표시명.localeCompare(b.표시명, 'ko'))
  .slice(0, 12);

/** 이 지면에 보여 줄 수치가 하나라도 있나 · 캠퍼스면 본교는 어디인가 */
const 값있음 = 수치있음(uni);
const 캠퍼스 = 캠퍼스인가(uni);
const 본교 = 본교찾기(uni, universities as any[]);

const 취 = uni.취업률;
const 탈 = uni.중도탈락률;

/** 「평균보다 2.7%p 낮습니다」 — 등수가 아니라 기준선에서 얼마나 떨어져 있나 */
const 견줌 = (d: any) => {
  if (!d || d.차이 == null) return null;
  if (Math.abs(d.차이) < 0.05) return `전국 평균(${d.전국평균}%)과 거의 같습니다`;
  return `전국 평균 ${d.전국평균}%보다 ${Math.abs(d.차이)}%p ${d.차이 > 0 ? '높습니다' : '낮습니다'}`;
};

/** ❸ 해석 — 규칙이 만든다. 숫자가 바뀌면 문장도 같이 바뀐다 */
function 해석문(): string[] {
  /** ⚠ 수치가 없는 경우의 설명은 지면 위쪽 블록이 이미 한다(캠퍼스인지 아닌지로 갈라서).
   *  여기서 또 쓰면 같은 말이 두 번 나온다. 비워 둔다. */
  if (!취 && !탈) return [];
  const 조각: string[] = [];

  if (취) {
    조각.push(
      `${uni.표시명}를 졸업하고, 취업할 수 있는 자리에 있던 100명 가운데 ${Math.round(취.값)}명이 취업했습니다.` +
        (견줌(취) ? ` ${견줌(취)}.` : '') +
        (uni.취업자 && uni.취업대상자
          ? ` 실제 수로는 ${uni.취업대상자.toLocaleString()}명 중 ${uni.취업자.toLocaleString()}명입니다.`
          : ''),
    );
    조각.push(
      `⚠ 나머지를 「놀고 있는 사람」으로 읽으면 안 됩니다 — 대학원에 간 사람, 군에 간 사람, 시험을 준비하는 사람은 애초에 취업대상자에서 빠집니다.`,
    );
  }

  if (탈) {
    조각.push(
      `이 학교에 다니던 100명 가운데 ${Math.round(탈.값)}명은 그 해에 학교를 떠났습니다.` +
        (견줌(탈) ? ` ${견줌(탈)}.` : ''),
    );
    조각.push(
      `다만 이것을 학교의 성적표로 읽으면 안 됩니다 — 자퇴에는 편입, 반수, 재수, 전공을 바꾸려는 결정이 모두 섞여 있습니다. 떠난 사람이 많다는 것은 「나쁜 학교」라는 뜻이 아니라, 들어와 보고 생각이 달라진 사람이 그만큼 있었다는 뜻입니다.`,
    );
  }
  return 조각;
}

const 문단 = 해석문();
const 제목 = uni.표시명;
const desc = 취
  ? `${제목}(${uni.지역} · ${uni.설립} ${uni.종류}) 졸업생 취업률은 ${취.값}%입니다. 전국 평균은 ${취.전국평균}%입니다. ${uni.공시연도}년 대학정보공시 기준입니다.`
  : `${제목}(${uni.지역} · ${uni.설립} ${uni.종류})의 ${uni.공시연도}년 대학정보공시 자료입니다.`;

/** ❷ 숫자 칸 — 값이 있는 것만 넣는다. 빈 칸을 「—」로 채우면 없는 것이 있는 것처럼 보인다 */
const 칸 = [
  { d: 취, k: '취업률' },
  { d: 탈, k: '중도탈락률' },
  { d: uni.재학생충원율, k: '재학생 충원율' },
  { d: uni.전임교원확보율, k: '전임교원 확보율' },
].filter((x) => x.d);
---

<HundredYear title={제목} description={desc}>
  <h1>{제목}</h1>
  <p class="sub">
    {uni.지역} · {uni.설립} {uni.종류}
    {uni.재적학생 != null && <> · 재적학생 {uni.재적학생.toLocaleString()}명</>}
  </p>

  {
    취 ? (
      /* ❶ 한 줄 답 — 이 문장 하나만 읽어도 답이 되게 한다 */
      <div class="answer">
        <p class="answer-label">졸업하고, 취업할 수 있는 자리에 있던 100명 가운데 취업한 사람</p>
        <p class="answer-num">{Math.round(취.값)}명</p>
        <p class="answer-sub">
          취업률 {취.값}%{견줌(취) && <> · {견줌(취)}</>}
        </p>
      </div>
    ) : 캠퍼스 ? (
      /* ⭐ 제N캠퍼스 — 값이 있는 캠퍼스는 **0곳**이다. 수치가 본교에 몰려 있다.
         「없다」로 끝내면 학부모는 이 학교가 문제인 줄 안다. 그게 아니라고 말해 준다 */
      <div class="card">
        <p>
          <strong>이 캠퍼스는 수치가 따로 공시되지 않습니다.</strong> 대학정보공시는 취업률·중도탈락률을
          <strong> 학교 단위로 묶어서</strong> 냅니다. 이 캠퍼스의 졸업생도 그 안에 함께 들어 있습니다.
        </p>
        {본교 ? (
          <p>
            숫자는 <a href={href(본교.url)}>{본교.표시명}</a> 지면에서 보실 수 있습니다
            {본교.취업률 && <> — 취업률 {본교.취업률.값}%</>}.
          </p>
        ) : (
          <p class="note">
            ⚠ 본교 지면에도 수치가 없어 링크를 걸지 않았습니다. 빈 지면에서 빈 지면으로
            보내 드리는 것은 도움이 되지 않습니다.
          </p>
        )}
        <p class="note">
          ⛔ 캠퍼스가 따로 나오지 않는 것은 <strong>학교의 문제가 아니라 공시 방식</strong>입니다.
        </p>
      </div>
    ) : (
      /* ⚠ 본교인데 지표가 하나도 없는 20곳. **폐교라고 쓰지 않는다 — 못 쟀다** */
      <p class="warn">
        ⚠ <strong>{uni.공시연도}년 공시에 이 학교의 수치가 하나도 없습니다.</strong> 취업률만이 아니라
        중도탈락률·재적학생까지 전부 없습니다. 학교 이름은 공시 명단에 있는데 숫자가 오지 않습니다.
        <br />
        <strong>이 학교가 지금도 신입생을 받는지 저희는 확인하지 못했습니다.</strong> 공시 자료에는
        폐교·통합 여부를 알려 주는 항목이 없어서, 저희가 짐작으로 적지 않겠습니다.
        진학을 생각하신다면 <strong>학교에 직접 확인해 보십시오.</strong>
      </p>
    )
  }

  {
    칸.length > 0 && (
      <>
        <h2>숫자 {칸.length}개</h2>
        <div class="nums">
          {칸.map(({ d, k }) => (
            <div class="num">
              <span class="n">{d.값}%</span>
              <span class="k">
                {k}
                {d.전국평균 != null && (
                  <>
                    <br />전국 {d.전국평균}%
                  </>
                )}
              </span>
            </div>
          ))}
        </div>
        <p class="warn">
          ⚠ 「전국」은 <strong>대학정보공시가 발표한 평균</strong>입니다. 저희가 계산한 값이 아닙니다.
          평균보다 높다고 좋은 학교, 낮다고 나쁜 학교가 아닙니다 —
          학교마다 학과 구성이 다르고, 그것만으로 크게 갈립니다.
        </p>
      </>
    )
  }

  {/* ❸ 해석 */}
  {문단.map((p) => <p>{p}</p>)}

  {/* ❹ 어디서 왔나 — 접어 둔다 */}
  <details>
    <summary>이 숫자는 어디서 왔나?</summary>
    <div class="card">
      <p class="note">
        <strong>출처</strong> {uni.출처}<br />
        <strong>공시연도</strong> {uni.공시연도}년<br />
        {uni.전체이름 && <><strong>공시 표기</strong> {uni.전체이름}<br /></>}
        <strong>받은 곳</strong> 공공데이터포털 오픈API (한국대학교육협의회)
      </p>
      {
        uni.졸업자 != null && (
          <p class="note">
            <strong>취업률 계산</strong> 졸업자 {uni.졸업자.toLocaleString()}명 가운데
            취업할 수 있는 자리에 있던 사람이 {uni.취업대상자?.toLocaleString()}명이고,
            그 가운데 {uni.취업자?.toLocaleString()}명이 취업했습니다.
            대학원 진학자·입대자 등은 <strong>취업대상자에서 빠집니다.</strong>
          </p>
        )
      }
      <p class="note">
        ⚠ 「전국 평균」은 공시가 함께 발표한 값을 그대로 옮긴 것입니다.
        저희가 학교별 값을 모아 계산한 것이 아닙니다.
      </p>
      <p class="note">⛔ 저희는 대학에 순위를 매기지 않습니다. 이 지면 어디에도 등수가 없습니다.</p>
    </div>
  </details>

  {/* ❺ 다음 걸음 */}
  {
    이웃.length > 0 && (
      <>
        <h2>{uni.지역}의 다른 {uni.종류}</h2>
        <p class="note">가나다순입니다. 순위가 아닙니다.</p>
        <ul class="neighbors">
          {이웃.map((u) => (
            <li>
              <a href={href(u.url)}>{u.표시명}</a>
              {u.취업률 && <span class="note"> 취업 {u.취업률.값}%</span>}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {/* ⭐ 숫자 다음에 오는 질문은 「왜 그렇게 되나?」다. 그건 우리가 못 쓴다 — 가리키기만 한다.
      ⛔ **이 학교에 대한 연구가 아니다.** 주제가 같을 뿐이라고 반드시 적는다 */}
  {
    관련연구.length > 0 && (
      <>
        <hr class="rule" />
        <h2>왜 그렇게 되는지를 다룬 연구</h2>
        <p class="note">
          ⚠ <strong>{uni.표시명}에 대한 연구가 아닙니다.</strong> 대학이라는 길 자체를 다룬
          것이라 주제가 닿을 뿐입니다. 저희가 쓴 글이 아니고, 누르면 원문으로 갑니다.
        </p>
        <ul class="papers">
          {관련연구.map((r) => (
            <li>
              <a href={r.url} rel="nofollow noopener" target="_blank">{r.제목}</a>
              <span class="note">
                {r.발행일?.slice(0, 7).replace('-', '년 ') ?? '발행일 미상'}월
                {r.저자.length > 0 && <> · {r.저자.join(', ')}</>}
                {r.종류 && <> · {r.종류}</>}
              </span>
            </li>
          ))}
        </ul>
        <p class="note">
          <a href="/research">국책연구 {전체편수}편 전부 보기 →</a>
        </p>
      </>
    )
  }

  <hr class="rule" />
  <p class="note">
    고등학교와 학과는 <a href="/major">학과 찾기</a> · <a href="/school">학교 찾기</a> 에서 볼 수 있습니다.
  </p>
</HundredYear>

<style>
  .neighbors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 30rem) {
    .neighbors {
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }
  }
  .neighbors li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-body);
  }
  .neighbors li a {
    display: inline-block;
    min-height: 24px;
  }
  /* ⚠ 숫자가 넷이라 셋 기준 격자에 넣으면 하나가 혼자 남는다. 휴대폰은 2×2 로 접는다 */
  .nums {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 30rem) {
    .nums {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
