---
/**
 * /100y/private-school-teacher-exam-2027 — **사립학교 교사 위탁 채용 2027 시도별** — 선발·지원
 *
 * ── 왜 만들었나 (2026-10-27 · 1번 · 「2027 교사 임용 17개 시도」 축, 이슈) ──────────────
 * 이슈   10월 21일 중등 임용 접수 결과와 함께, 사립학교 법인이 교육청에 1차 시험을 맡긴 «사립 위탁» 접수 결과도 나왔다.
 *        공립 경쟁률 기사 끝에 한 줄씩만 붙어 있어 한데 본 곳이 없다.
 * 축     시도 발표를 열어 옮긴 사립 위탁 수(teacher-exam-2027.json 사립위탁). 못 찾은 시도는 미확인.
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 지망 셈법(1지망만/동시지원 포함)이 시도마다 달라 시도끼리 견주지 않는다 — 셈법을 줄마다 적는다.
 * ⛔ 공립과 합치지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원 from '../../../data/100yearmap/teacher-exam-2027.json';

const 전 = 원 as any;
const p = 전.사립위탁;
const 쉼 = (n: number) => n.toLocaleString();
const 행 = p.시도.map((r: any) => ({ ...r, 율: (r.지원 / r.선발).toFixed(2) })).sort((a: any, b: any) => b.선발 - a.선발);
const 선합 = 행.reduce((a: number, r: any) => a + r.선발, 0);
const 지합 = 행.reduce((a: number, r: any) => a + r.지원, 0);
const 공립 = 전.중등.시도;
const 맞댐 = 행.map((r: any) => {
  const g = 공립.find((x: any) => x.시도 === r.시도);
  return { 시도: r.시도, 사립: r.선발, 공립: g ? g.선발 : null };
});
const 맨 = 행[0];

const TITLE = `사립학교 교사 위탁 채용 2027 시도별 — ${행.length}곳 ${쉼(선합)}명 선발`;
const desc =
  `2027학년도 중등 임용시험과 함께 치르는 사립학교 교사 위탁 채용의 원서접수 결과를 시도 발표로 모았습니다. 확인한 ${행.length}개 시도에서 ${쉼(선합)}명을 뽑고, ` +
  `가장 많이 뽑는 곳은 ${맨.시도}(${맨.선발}명)입니다. 서울·경기·인천·세종·강원은 미확인입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '2027학년도 사립학교 교사 위탁 채용 시도별 선발·지원 인원',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    spatialCoverage: '대한민국 시·도',
    variableMeasured: ['사립 위탁 선발 인원', '지원자 수'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '사립학교 교사 위탁 채용이란 무엇인가요?',
        acceptedAnswer: { '@type': 'Answer', text: '사립학교 법인이 신규 교사 선발의 1차 필기시험을 시도교육청에 맡기는 방식입니다. 2027학년도는 공립 중등 임용과 함께 시도교육청이 원서를 받아 10월 21일 접수 결과를 냈습니다.' },
      },
      ...행.slice(0, 6).map((r: any) => ({
        '@type': 'Question',
        name: `2027 ${r.시도} 사립 위탁 채용은 몇 명을 뽑나요?`,
        acceptedAnswer: { '@type': 'Answer', text: `${r.선발}명 선발에 ${r.지원}명이 지원했습니다(${r.기준 ?? '발표 기준'}).` },
      })),
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>사립학교 교사 위탁 채용 2027 —<br class="pcbr" /> 시도별 선발·지원</h1>
  <p class="sub">
    사립 중·고등학교 법인이 교사 선발 1차 시험을 교육청에 맡기는 것이 «사립 위탁»입니다. 10월 21일 공립 접수 결과와 함께 나온 수를 시도마다 열어 모았습니다.
  </p>

  <div class="answer">
    <p class="answer-label">확인한 {행.length}개 시도 — 사립 위탁</p>
    <p class="answer-num">{쉼(선합)}명 선발</p>
    <p class="answer-sub">지원 {쉼(지합)}명(시도마다 지망 셈법이 다름) · 미확인 {p.미확인.join('·')}</p>
  </div>

  <h2>시도별</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시도</th><th>선발</th><th>지원</th><th>지원÷선발</th></tr></thead>
      <tbody>
        {행.map((r: any) => (
          <tr><th>{r.시도}</th><td class="num">{r.선발}</td><td class="num">{r.지원}</td><td class="num">{r.율}</td></tr>
        ))}
        {p.미확인.map((k: string) => (<tr><th>{k}</th><td colspan="3">미확인</td></tr>))}
      </tbody>
    </table>
  </div>

  <h2>지원을 센 방법</h2>
  <ul class="small">
    {행.filter((r: any) => r.기준 || r.전년율).map((r: any) => (
      <li><strong>{r.시도}</strong> — {r.기준 ?? ''}{r.기준 && r.전년율 ? ' · ' : ''}{r.전년율 ? `2026학년도 ${r.전년율.toFixed(2)}대 1` : ''}</li>
    ))}
  </ul>

  <h2>같은 시도의 공립 선발과 나란히</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시도</th><th>사립 위탁</th><th>공립 중등</th></tr></thead>
      <tbody>
        {맞댐.map((r: any) => (<tr><th>{r.시도}</th><td class="num">{r.사립}</td><td class="num">{r.공립 ?? '미확인'}</td></tr>))}
      </tbody>
    </table>
  </div>
  <p class="note">공립 수는 <a href="/teacher-exam-competition-2027">17개 시도 공립 중등</a> 표의 선발입니다. 공립 쪽은 비교과·특수가 들어 있는 시도도 있어 두 수의 비는 적지 않았습니다.</p>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 원서 낸 사람 수와 뽑을 사람 수일 뿐, 어느 법인·학교가 어떤지와는 다릅니다.</li>
    <li>지원 수를 1지망만 센 곳, 공·사립 동시지원을 넣은 곳이 섞여 있습니다. 그래서 시도끼리 지원÷선발을 견주지 않습니다.</li>
    <li>서울·세종·강원은 사립 위탁 결과를 찾지 못했고, 인천·경기는 교육청에 원본이 있으나 저희가 열어 옮기지 못했습니다. 0이 아니라 미확인입니다.</li>
    <li>위탁하지 않고 법인이 스스로 뽑는 사립학교 채용은 이 표에 없습니다.</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    시도교육청 2027학년도 중등교사 임용시험 원서접수 결과(2026-10-21 발표)의 사립 위탁 부분 — 광주·전남·충남은 교육청 원본, 나머지는 발표를 실은 기사 · 저희가 받은 때 {전.만든날}
  </p>

  <NextQuestionBrief 모은것="2027학년도 사립학교 교사 위탁 채용 시도별 원서접수 결과를 교육청 원본·기사로 열어 모은 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .small { font-size: .92em; }
</style>
