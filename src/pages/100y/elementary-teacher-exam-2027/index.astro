---
/**
 * /100y/elementary-teacher-exam-2027 — **2027 초등교사 임용 경쟁률 시도별** — 선발·지원, 1차 11월 7일
 *
 * ── 왜 만들었나 (2026-10-27 · 1번 · 「2027 교사 임용 17개 시도」 축, 이슈) ──────────────
 * 이슈   2027학년도 공립 초등교사 임용 1차 시험이 11월 7일(오늘 D-11)이다. 10월 초 시도교육청마다 원서접수 결과를 냈지만
 *        기사는 제 시도만 다뤘다. 한 표에 모은 곳이 없다.
 * 축     시도교육청 발표를 실은 기사를 시도마다 열어 선발·지원을 옮기고, 경쟁률은 저희가 지원 ÷ 선발로 다시 나눴다
 *        (teacher-exam-2027.json 초등). 못 찾은 시도는 미확인으로 남긴다.
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 시도마다 «초등»에 넣은 범위가 다르다(일반모집만/장애·지역 구분 포함) — 표에 범위 칸을 둔다.
 * ⛔ 「어디가 붙기 쉽다」를 쓰지 않는다. 경쟁률은 원서 낸 사람 ÷ 뽑을 사람일 뿐 합격 가능성이 아니다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원 from '../../../data/100yearmap/teacher-exam-2027.json';

const 전 = 원 as any;
const c = 전.초등;
const 쉼 = (n: number) => n.toLocaleString();
const 율 = (a: number[] | null) => (a && a[0] ? (a[1] / a[0]).toFixed(2) : null);
const 잰곳 = c.시도.filter((r: any) => r.선발 != null);
const 못잰곳 = c.시도.filter((r: any) => r.선발 == null);
const 행 = 잰곳
  .map((r: any) => ({ ...r, 율: (r.지원 / r.선발).toFixed(2), 전율: r.전년 ? 율(r.전년) : r.전년율 != null ? r.전년율.toFixed(2) : null }))
  .sort((a: any, b: any) => b.선발 - a.선발);
const 선발합 = 잰곳.reduce((a: number, r: any) => a + r.선발, 0);
const 지원합 = 잰곳.reduce((a: number, r: any) => a + r.지원, 0);
const 서울 = 행.find((r: any) => r.시도 === '서울');
const 유행 = c.시도.filter((r: any) => r.유치원).map((r: any) => ({ 시도: r.시도, 선발: r.유치원[0], 지원: r.유치원[1], 율: 율(r.유치원) }));
const 유선발 = 유행.reduce((a: number, r: any) => a + r.선발, 0);
const 유지원 = 유행.reduce((a: number, r: any) => a + r.지원, 0);
const 특행 = c.시도.filter((r: any) => r.특수초).map((r: any) => ({ 시도: r.시도, 선발: r.특수초[0], 지원: r.특수초[1], 율: 율(r.특수초) }));

const TITLE = `2027 초등교사 임용 경쟁률 시도별 — ${잰곳.length}곳 ${쉼(선발합)}명 뽑는데 ${쉼(지원합)}명`;
const desc =
  `2027학년도 공립 초등교사 임용시험(1차 11월 7일) 원서접수 결과를 시도교육청 발표 기사로 모았습니다. 확인한 ${잰곳.length}개 시도에서 ${쉼(선발합)}명 선발에 ${쉼(지원합)}명이 지원했고, ` +
  `서울은 ${서울.선발}명에 ${서울.지원}명(${서울.율}대 1)입니다. 경기·인천·전남광주는 결과를 찾지 못해 미확인입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '2027학년도 공립 초등교사 임용시험 시도별 선발·지원 인원',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    spatialCoverage: '대한민국 시·도',
    variableMeasured: ['선발 인원', '지원자 수', '지원 ÷ 선발'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '2027학년도 초등교사 임용시험 1차는 언제인가요?',
        acceptedAnswer: { '@type': 'Answer', text: `시도교육청 공고 기준 2026년 11월 7일(토)입니다. 원서접수 결과는 10월 8~12일 시도마다 발표됐습니다.` },
      },
      ...행.slice(0, 6).map((r: any) => ({
        '@type': 'Question',
        name: `2027 ${r.시도} 초등교사 임용 경쟁률은 얼마인가요?`,
        acceptedAnswer: { '@type': 'Answer', text: `${r.범위} ${r.선발}명 선발에 ${r.지원}명이 지원해 ${r.율}대 1입니다(지원 ÷ 선발).${r.전율 ? ` 2026학년도는 ${r.전율}대 1이었습니다.` : ''}` },
      })),
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>2027 초등교사 임용 경쟁률 —<br class="pcbr" /> 시도별 선발·지원</h1>
  <p class="sub">
    공립 초등교사 임용 1차 시험이 11월 7일, 오늘로 11일 남았습니다. 시도교육청이 10월 초 따로따로 낸 원서접수 결과를 한 표에 모았습니다.
  </p>

  <div class="answer">
    <p class="answer-label">확인한 {잰곳.length}개 시도 — 공립 초등</p>
    <p class="answer-num">{쉼(선발합)}명 선발 · {쉼(지원합)}명 지원</p>
    <p class="answer-sub">미확인 {못잰곳.map((r: any) => r.시도).join('·')} · 경쟁률은 지원 ÷ 선발로 다시 나눈 값</p>
  </div>

  <p>
    확인한 곳 가운데 가장 많이 뽑는 서울은 {서울.선발}명에 {서울.지원}명이 원서를 내 {서울.율}대 1, 1년 전({서울.전율}대 1)보다 낮습니다.
    선발이 한 자릿수인 대전·세종은 몇 명만 더 지원해도 경쟁률이 크게 움직입니다.
  </p>

  <h2>시도별 — 공립 초등</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시도</th><th>선발</th><th>지원</th><th>지원÷선발</th><th>2026학년도</th></tr></thead>
      <tbody>
        {행.map((r: any) => (
          <tr><th>{r.시도}</th><td class="num">{쉼(r.선발)}</td><td class="num">{쉼(r.지원)}</td><td class="num"><strong>{r.율}</strong></td><td class="num">{r.전율 ?? '미확인'}</td></tr>
        ))}
        {못잰곳.map((r: any) => (
          <tr><th>{r.시도}</th><td colspan="4">미확인 — 원서접수 결과를 찾지 못했습니다</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>시도마다 «초등»에 넣은 범위</h2>
  <ul class="small">
    {행.map((r: any) => (<li><strong>{r.시도}</strong> — {r.범위}{r['⚠'] ? ` · ${r['⚠']}` : ''}</li>))}
  </ul>

  <h2>같은 시험의 유치원 교사</h2>
  <p>확인한 {유행.length}개 시도에서 유치원 교사 {쉼(유선발)}명 선발에 {쉼(유지원)}명이 지원했습니다. 초등보다 뽑는 수가 훨씬 적습니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시도</th><th>선발</th><th>지원</th><th>지원÷선발</th></tr></thead>
      <tbody>
        {[...유행].sort((a: any, b: any) => b.선발 - a.선발).map((r: any) => (
          <tr><th>{r.시도}</th><td class="num">{r.선발}</td><td class="num">{쉼(r.지원)}</td><td class="num">{r.율}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>특수학교(초등) 교사</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시도</th><th>선발</th><th>지원</th><th>지원÷선발</th></tr></thead>
      <tbody>
        {[...특행].sort((a: any, b: any) => b.선발 - a.선발).map((r: any) => (
          <tr><th>{r.시도}</th><td class="num">{r.선발}</td><td class="num">{r.지원}</td><td class="num">{r.율}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">서울 특수(초등)는 기사에 경쟁률(3.08대 1)만 있고 인원이 없어 표에서 뺐습니다.</p>

  <h2>이어서 볼 것</h2>
  <ul>
    <li><a href="/teacher-exam-competition-2027">2027 중등교사 임용 경쟁률 17개 시도</a></li>
    <li><a href="/teacher-hiring-outlook-2030">교사 신규채용 전망 2027~2030</a></li>
    <li><a href="/students-per-teacher-2026">교원 1명당 학생 수 2026</a></li>
  </ul>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 원서를 낸 사람 수를 뽑을 사람 수로 나눈 값일 뿐, 누가 붙을지와는 다릅니다. 1차에 실제로 오지 않는 사람도 있습니다.</li>
    <li>시도마다 «초등»에 넣은 범위가 다릅니다(일반모집만, 또는 장애·지역 구분 포함). 위 목록에 시도별로 적었습니다.</li>
    <li>경기·인천·전남광주는 원서접수 결과를 실은 발표를 찾지 못했습니다. 0이 아니라 미확인입니다.</li>
    <li>경쟁률은 저희가 지원 ÷ 선발로 다시 나눴습니다. 기사에 적힌 값과 다른 곳은 범위 목록에 밝혔습니다.</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    시도교육청 원서접수 결과를 실은 기사(2026-10-08~10-12) — 서울·부산·경북 아시아경제, 대구 이로운넷, 대전·세종·충남 충청일보, 울산 웹이코노미,
    강원 강원도민일보, 충북 충청리뷰, 전북 스포탈코리아, 경남 경남도민일보, 제주 미디어제주 · 시도마다 기사를 직접 열어 옮겼습니다 · 저희가 받은 때 {전.만든날}
  </p>

  <NextQuestionBrief 모은것="2027학년도 공립 초등·유치원·특수(초등) 교사 임용시험 시도교육청 원서접수 결과를 시도마다 기사로 열어 모은 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .small { font-size: .92em; }
</style>
