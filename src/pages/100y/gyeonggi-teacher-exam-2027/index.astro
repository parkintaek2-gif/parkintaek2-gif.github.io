---
/**
 * /100y/gyeonggi-teacher-exam-2027 — **경기 중등교사 임용 2027 과목별 경쟁률** — 37과목 선발·지원, 교육청 원본
 *
 * ── 왜 만들었나 (2026-10-27 · 1번 · 「2027 교사 임용 17개 시도」 축, 이슈 · 이름 겨냥) ──────────────
 * 이슈   경기는 17개 시도 가운데 가장 많이 뽑는다(공립 1,862명). 10월 21일 교육청 게시판에 과목별 접수현황 PDF가 올라왔지만
 *        기사는 머리 수 몇 개만 옮겼다. 「경기 임용 국어 경쟁률」처럼 과목 이름으로 찾는 사람에게 37과목을 다 준다.
 * 축     경기도교육청 원본 PDF(2026-10-19 18:00 기준)를 과목마다 옮기고 공립합계로 검산했다(teacher-exam-2027.json 경기과목).
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 「붙기 쉬운 과목」을 쓰지 않는다. 지원 ÷ 선발일 뿐이다.
 * ⛔ 비교과(보건·사서·전문상담·영양)·특수는 교과와 따로 묶는다. 유치원·초등 몫 비교과도 이 시험에 들어 있다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원 from '../../../data/100yearmap/teacher-exam-2027.json';

const 전 = 원 as any;
const g = 전.경기과목;
const 쉼 = (n: number) => n.toLocaleString();
const 율 = (a: number, b: number) => (a ? (b / a).toFixed(2) : '—');
const 모두 = g.과목.map((r: any[]) => {
  const 선 = r[1] + r[2];
  const 지 = r[3] + r[4];
  return { 과: r[0], 선, 지, 율: 율(선, 지), 일반율: 율(r[1], r[3]), 비교과: g.비교과.includes(r[0]) };
});
const 교과 = 모두.filter((r: any) => !r.비교과).sort((a: any, b: any) => Number(b.율) - Number(a.율));
const 비교과 = 모두.filter((r: any) => r.비교과).sort((a: any, b: any) => Number(b.율) - Number(a.율));
const 합 = g.공립합계;
const 선합 = 합[0] + 합[1];
const 지합 = 합[2] + 합[3];
const 교과선 = 교과.reduce((a: number, r: any) => a + r.선, 0);
const 교과지 = 교과.reduce((a: number, r: any) => a + r.지, 0);
const 맨위 = 교과[0];
const 맨아래 = 교과[교과.length - 1];
const 국어 = 모두.find((r: any) => r.과 === '국어');
const 많이뽑는 = [...교과].sort((a: any, b: any) => b.선 - a.선).slice(0, 5);

const TITLE = `경기 중등교사 임용 2027 과목별 경쟁률 — ${맨위.과} ${맨위.율}대 1, ${맨아래.과} ${맨아래.율}대 1`;
const desc =
  `경기도교육청 원본으로 2027학년도 경기 공립 중등교사 등 임용시험 37과목의 선발·지원을 모두 실었습니다. 공립 ${쉼(선합)}명 선발에 ${쉼(지합)}명이 지원했고, ` +
  `교과의 지원 ÷ 선발은 ${맨위.과} ${맨위.율}대 1부터 ${맨아래.과} ${맨아래.율}대 1까지입니다. 국어는 ${국어.선}명에 ${쉼(국어.지)}명입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '2027학년도 경기도 공립 중등교사 등 임용시험 과목별 선발·지원 인원',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: '경기도교육청' },
    spatialCoverage: '경기도',
    variableMeasured: ['과목별 선발 인원', '과목별 지원자 수', '지원 ÷ 선발'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '2027 경기 중등교사 임용 경쟁률은 얼마인가요?',
        acceptedAnswer: { '@type': 'Answer', text: `경기도교육청 접수현황(2026-10-19 18:00 기준) 공립 ${쉼(선합)}명 선발에 ${쉼(지합)}명이 지원해 ${율(선합, 지합)}대 1입니다. 장애 구분을 뺀 일반은 ${쉼(합[0])}명에 ${쉼(합[2])}명(${율(합[0], 합[2])}대 1)입니다.` },
      },
      ...많이뽑는.map((r: any) => ({
        '@type': 'Question',
        name: `2027 경기 ${r.과} 임용 경쟁률은 얼마인가요?`,
        acceptedAnswer: { '@type': 'Answer', text: `경기 ${r.과} 교사는 ${r.선}명 선발(장애 구분 포함)에 ${쉼(r.지)}명이 지원해 ${r.율}대 1입니다. 일반만 보면 ${r.일반율}대 1입니다.` },
      })),
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>경기 중등교사 임용 2027 —<br class="pcbr" /> 37과목 선발·지원</h1>
  <p class="sub">
    17개 시도 가운데 가장 많이 뽑는 경기도교육청이 10월 21일 과목별 접수현황을 올렸습니다. 1차 시험은 11월 28일입니다.
    원본 PDF의 37과목을 하나도 빼지 않고 옮겼습니다.
  </p>

  <div class="answer">
    <p class="answer-label">경기 공립 — 장애 구분 포함</p>
    <p class="answer-num">{쉼(선합)}명 선발 · {쉼(지합)}명 지원</p>
    <p class="answer-sub">{율(선합, 지합)}대 1 · 교과 {교과.length}과목 {쉼(교과선)}명에 {쉼(교과지)}명 · 비교과·특수 {비교과.length}과목</p>
  </div>

  <p>
    교과 가운데 지원 ÷ 선발이 가장 높은 것은 {맨위.과}({맨위.선}명에 {쉼(맨위.지)}명, {맨위.율}대 1), 가장 낮은 것은 {맨아래.과}({맨아래.선}명에 {쉼(맨아래.지)}명, {맨아래.율}대 1)입니다.
    가장 많이 뽑는 과목은 {많이뽑는.slice(0, 3).map((r: any) => `${r.과}(${r.선}명)`).join('·')}입니다.
  </p>

  <h2>교과 {교과.length}과목</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>과목</th><th>선발</th><th>지원</th><th>지원÷선발</th><th>일반만</th></tr></thead>
      <tbody>
        {교과.map((r: any) => (
          <tr><th>{r.과}</th><td class="num">{r.선}</td><td class="num">{쉼(r.지)}</td><td class="num"><strong>{r.율}</strong></td><td class="num">{r.일반율}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>비교과·특수 {비교과.length}과목</h2>
  <p>보건·사서·전문상담·영양은 유치원·초등 몫까지 이 시험에서 함께 뽑습니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>과목</th><th>선발</th><th>지원</th><th>지원÷선발</th><th>일반만</th></tr></thead>
      <tbody>
        {비교과.map((r: any) => (
          <tr><th>{r.과}</th><td class="num">{r.선}</td><td class="num">{쉼(r.지)}</td><td class="num"><strong>{r.율}</strong></td><td class="num">{r.일반율}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">국립 한국선진학교 특수(중등)는 1명 선발에 16명이 지원했습니다. 공립 표에는 넣지 않았습니다.</p>

  <h2>이어서 볼 것</h2>
  <ul>
    <li><a href="/teacher-exam-competition-2027">2027 중등교사 임용 경쟁률 17개 시도</a></li>
    <li><a href="/private-school-teacher-exam-2027">사립학교 교사 위탁 채용 시도별</a></li>
    <li><a href="/teacher-hiring-outlook-2030">교사 신규채용 전망 2027~2030</a></li>
  </ul>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 원서를 낸 사람 수를 뽑을 사람 수로 나눈 값일 뿐, 누가 붙을지를 말하지 않습니다.</li>
    <li>«지원÷선발»은 장애 구분까지 더한 값이고, «일반만»은 장애 구분을 뺀 값입니다. 교육청 원본은 두 가지를 다 싣습니다.</li>
    <li>선발이 4~7명인 과목은 몇 명 차이로 값이 크게 움직입니다.</li>
    <li>다른 시도와 과목을 견주지 않았습니다. 시도마다 과목 구분과 범위가 다릅니다.</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    경기도교육청 「2027학년도 경기도 중등학교교사, 보건·사서·전문상담·영양·특수(중등)교사 임용후보자 선정경쟁시험 응시원서 접수현황 안내」(2026-10-19 18:00 기준, 10-21 게시) 원본 PDF ·
    과목 합이 공립합계(선발 {쉼(선합)}·지원 {쉼(지합)})와 맞는지 검산했습니다 · 저희가 받은 때 {전.만든날}
  </p>

  <NextQuestionBrief 모은것="경기도교육청 2027학년도 중등교사 등 임용시험 접수현황 원본 PDF 37과목을 옮겨 공립합계로 검산한 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
