---
/**
 * /100y/ranking-pizza-brand — 순위는 공개한다, 그러나 전부는 아니다 (시리즈 · 피자전문점 편)
 *
 * 한국표준협회 프리미엄브랜드지수(KS-PBI) 피자전문점 부문 "11년 연속 1위"를 그대로 인용한다.
 * 100yearmap이 새로 순위를 매기지 않는다.
 *
 * ⭐ 톤: 설문 1위가 11년째 안 바뀌는 브랜드와, 그 업종(피자·햄버거·샌드위치) "전체"
 *   사업장은 절반 넘게 3년 안에 문을 닫는다는 것(76%)을 나란히 놓는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/ranking-pizza-brand-2026.json';

const 자료 = 원본 as any;
const 순위출처 = 자료.순위출처;
const top5 = 자료.top5 as any[];
const 실측 = 자료.실측대조;
const 일위 = top5[0];

const desc =
  `${순위출처.이름}에서 ${일위.브랜드}가 ${일위.연속1위_년}년 연속 1위입니다. ` +
  `100yearmap이 실측한 피자·햄버거·샌드위치 업종 전체의 사업장 수명 중앙값은 ${실측.수명중앙값_년}년, ` +
  `3년 안에 문 닫는 비율은 ${실측.삼년내_퍼센트}%입니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '이 피자전문점 순위는 100yearmap이 매긴 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `아닙니다. ${순위출처.이름}를 그대로 인용했습니다. ${순위출처['⚠원자료']}`,
      },
    },
    {
      '@type': 'Question',
      name: '11년 연속 1위인데 업종 전체는 왜 76%가 3년 안에 문을 닫나요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: (자료.이자료가못가르는것 as string[])[0] + ' ' + (자료.이자료가못가르는것 as string[])[1],
      },
    },
  ],
};
---

<HundredYear
  title={`${일위.브랜드} 피자전문점 브랜드지수 ${일위.연속1위_년}년 연속 1위 — 그런데 업종 전체는 3년 안에 ${실측.삼년내_퍼센트}%가 문을 닫습니다`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>
    {일위.브랜드} {일위.연속1위_년}년 연속 브랜드지수 1위<br class="pcbr" />
    업종 전체는 3년 안에 {실측.삼년내_퍼센트}%가 문을 닫습니다
  </h1>

  <div class="warn">
    <p><strong>⚠ 이 순위는 저희가 매긴 게 아닙니다.</strong></p>
    <p class="note">
      {순위출처.이름}({순위출처.발표일} 보도)를 그대로 인용했습니다. {순위출처['⚠원자료']}
    </p>
  </div>

  <p class="sub">
    한국표준협회·서울대 경영연구소가 매년 전국 성인 약 12만 명을 설문해 매기는
    프리미엄브랜드지수(KS-PBI) 피자전문점 부문에서, <strong>{일위.브랜드}</strong>가{' '}
    <strong>{일위.연속1위_년}년 연속</strong> 1위를 지켰습니다(2016~2026년).
  </p>
  <p class="note">⚠ {자료.top5주}</p>

  <h2>브랜드가 아니라 «업종»은 몇 년을 갈까요?</h2>
  <p>{실측.무엇}입니다.</p>
  <div class="warn">
    <p>
      피자·햄버거·샌드위치 및 유사 음식점업 사업장 <strong>{실측.닫은곳.toLocaleString()}곳</strong>이
      국민연금 가입 자격을 잃었고(2026년 6월 기준), {실측.쓰는말}의 중앙값은{' '}
      <strong>{실측.수명중앙값_년}년</strong>입니다.{' '}
      <strong>{실측.일년내_퍼센트}%</strong>가 1년 안에, <strong>{실측.삼년내_퍼센트}%</strong>가
      3년 안에 이 명단에 들었습니다.
    </p>
  </div>
  <p class="note">⚠ {실측.쓰면안되는말}</p>
  <p class="note">⚠ {실측.주의}</p>

  <h2>이 지면이 말하지 않는 것</h2>
  <ul>
    {(자료.이자료가못가르는것 as string[]).map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="note">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong> 이 지면은 두 공개 자료를 나란히
    {' '}놓아 보여줄 뿐, 어느 브랜드가 더 좋은지 판정하지 않습니다.
  </p>

  <h2>자주 묻는 말</h2>
  {jsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    출처 — 브랜드지수: 한국표준협회·서울대 경영연구소 KS-PBI({순위출처.url}) · 실측: 국민연금공단
    {' '}국민연금 가입 사업장 내역(공공데이터포털 15083277)
  </p>

  <p class="note">
    <a href="/ranking-chicken-brand">← 치킨 전문점도 브랜드평판 1위가 업종 생존을 못 이깁니다</a>
    <br />
    <a href="/ranking-bakery-brand">← 제과제빵 전문점, 단일 매장이 프랜차이즈를 눌렀습니다</a>
  </p>

  <HundredAgeWalk 키="ranking-pizza-brand" />

  <NextQuestionBrief 모은것="한국표준협회 KS-PBI 피자전문점 부문 + 국민연금공단 가입 사업장 내역" />

  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/ranking-pizza-brand"></div>
</HundredYear>
