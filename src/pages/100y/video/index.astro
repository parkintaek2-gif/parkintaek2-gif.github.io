---
/**
 * /100y/video — **짧은 영상**
 *
 * 🔴 왜 있나 — 사장님 지시(2026-08-14):
 *   *「텍스트 말고도 카드, 카드뉴스, 숏동영상은 **하루에 하나씩 만들어 배포까지 완료**하도록」*
 *
 *   ⛔ 그전까지 영상은 `out/` 에만 있었다. **out/ 은 gitignore 라 배포에 안 실린다** —
 *     만들기만 하고 «배포»가 없었다. 파일을 `public/100y/video/` 로 옮기고 이 지면을 낸다.
 *   ⭐ 밖(유튜브·인스타)에 올리는 것은 사장님 계정이지만, **우리 자리에 서는 것은 내 몫**이다.
 *     그래야 카드·영상이 «데려올 데」를 갖는다.
 *
 * ⛔ 수를 손으로 적지 않는다. `src/data/100yearmap/videos.json` 한 곳에서 온다.
 * ⛔ 등수·순위를 쓰지 않는다. 영상마다 **출처**와 **그 수가 있는 지면**을 같이 건다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import 대장 from '../../../data/100yearmap/videos.json';

const 영상들 = (대장 as any).영상 as any[];

const desc =
  '백년지도가 만든 짧은 영상입니다. 나이별 월급·초혼·학교 숫자를 14초로 보여 드립니다. ' +
  '영상에 나오는 수는 모두 그 수가 있는 지면을 함께 겁니다.';

/**
 * 🔴 사장님이 넘겨 주신 Search Console 편지(8/21) — 여기가 그 세 문제의 자리였다.
 *   ① 심각    thumbnailUrl 이 없다             ← 이것 때문에 검색에 **안 나왔다**
 *   ② uploadDate 의 datetime 값이 잘못됨        ← 「2026-08-20」은 날짜이고 datetime 이 아니다
 *   ③ uploadDate 에 시간대가 없다
 *
 * ⛔ 고치면서 **시각과 그림을 지어내지 않는다.**
 *   「2026-08-20T00:00:00+09:00」처럼 0시를 박으면 검사는 통과하지만
 *   그 영상은 0시에 안 나갔다 — 검사를 속이려고 거짓을 적는 것이다.
 *   ⇒ `scripts/build-100y-video-meta.mjs` 가 **git 에 실제로 들어간 때**(+09:00 이 붙어 있다)와
 *     **영상 7초 지점을 실제로 뽑은 jpg** 를 대장에 적어 둔다. 여기서는 그것을 읽어 쓴다.
 * ⛔ 그리고 **못 구한 칸은 아예 안 싣는다.** 빈 값을 넣으면 지금 문제가 그대로 되돌아온다.
 */
const 영상틀 = (v: any) => {
  const 것: Record<string, unknown> = {
    '@type': 'VideoObject',
    name: v.이름,
    description: v.한줄,
    contentUrl: `https://100yearmap.com${v.파일}`,
  };
  if (v.그림) 것.thumbnailUrl = [`https://100yearmap.com${v.그림}`];
  if (v.올라간때) 것.uploadDate = v.올라간때;
  if (v.기간) 것.duration = v.기간;
  if (v.유튜브) 것.embedUrl = v.유튜브;
  if (v.댈지면) 것.url = `https://100yearmap.com${v.댈지면}`;
  return 것;
};

/** ⛔ 칸이 빈 영상은 목록에서 뺀다 — 반쪽 구조화 자료가 이 문제의 원인이었다 */
const 실을영상 = 영상들.filter((v) => v.그림 && v.올라간때);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '백년지도 짧은 영상',
  numberOfItems: 실을영상.length,
  itemListElement: 실을영상.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: 영상틀(v),
  })),
};
---

<HundredYear title="짧은 영상" description={desc} jsonLd={jsonLd}>
  <h1>짧은 영상</h1>
  <p class="lead">
    숫자 하나를 <strong>14초</strong>에 담았습니다. 영상에 나오는 수는 모두{' '}
    <strong>그 수가 있는 지면</strong>을 함께 겁니다 — 못 대는 숫자는 영상에서 뺍니다.
  </p>

  {
    영상들.map((v) => (
      <section class="영상">
        <h2>{v.이름}</h2>
        <p class="note">{v.한줄}</p>
        {/* ⚠ preload="none" — 목록에 여럿이 있어 다 받으면 폰에서 느리다 */}
        {/* 🔴 8/21 — 썸네일을 만든 김에 `poster` 로도 건다. preload="none" 이라
            지금까지 손님 화면에 **검은 사각형**이 떠 있었다. 검색만 고치고 화면을 두면 반쪽이다 */}
        <video controls preload="none" playsinline width="270" height="480" src={v.파일}
          poster={v.그림 ?? undefined}>
          이 브라우저는 영상을 재생하지 못합니다. <a href={v.파일}>내려받아 보실 수 있습니다.</a>
        </video>
        <p class="note">
          <a class="gotoarea" href={v.댈지면}>이 숫자가 있는 지면으로 →</a>
          {/* 🔴 2026-08-15 — 사장님 지시 「올린 주소를 자기 지면에 겁니다 — **서로 오가게**」.
              ⛔ 안 올린 영상에는 안 건다. 대장의 「유튜브」 칸이 있을 때만 나온다 */}
          {v.유튜브 && (
            <>
              {' · '}
              <a class="gotoarea" href={v.유튜브} rel="noopener">유튜브에서 보기 →</a>
            </>
          )}
        </p>
        <p class="note small">
          {v.몇살손님} · {v.초}초 · 만든 날 {v.만든날}
          <br />출처 — {v.출처}
        </p>
      </section>
    ))
  }

  <hr class="rule" />
  <p class="note">
    ⛔ 등수를 매기지 않습니다. 영상은 <strong>퍼짐</strong>을 먼저 보여 주고, 가운데값이 곧
    「맞는 값」이 아니라는 것을 같이 적습니다.
  </p>
</HundredYear>

<style>
  .영상 { margin: 40px 0; }
  .영상 video { max-width: 100%; height: auto; border-radius: 10px; background: #12151c; }
  .small { font-size: 0.9em; opacity: 0.8; }
</style>
