---
/**
 * /100y/report/area/[slug] — **시·군·구 한 벌** (상품 본보기 · 지역 묶음)
 *
 * 2번 지시(2026-08-08 03:4x) — *「위 14곳을 **한 장**에. 견주는 것이 주인공이 되게.
 *   ⛔ 줄 세우지 않습니다. 퍼짐 안에서 어디쯤인지만 보여 줍니다」*
 *
 * ## ⭐ 이 지면이 파는 것 — **「열네 번을 한 번으로」**
 *
 *   학교 한 곳은 학교알리미에도 있다. 없는 것은 **한 구를 통째로 놓고 보는 화면**이다.
 *   지금 부모는 학교를 하나씩 검색해 표를 읽고 종이에 옮겨 견준다.
 *
 * ## 🔴 ⛔ 줄을 세우지 않는다 — 이것이 이 지면의 전부다
 *
 *   ```
 *   ⛔ 진학률 높은 순으로 표를 세우지 않는다   그 순간 「1등 학교」가 생긴다
 *   ✅ 표는 **가나다순**                      순서에 뜻이 없게 한다
 *   ✅ 어디쯤인지는 **퍼짐 띠**로 보인다        점이 어디 놓였나만 보인다. 등수는 없다
 *   ```
 *
 * ## 🔴 「낮은 것이 나쁜 것이 아니다」를 **이 구가 스스로 보여 준다**
 *
 *   강동구에서 진학률이 가장 낮은 곳은 **배재고(자율고)** 다.
 *   자율고는 「그 밖」(재수 등)이 크고, 재수생은 진학률 계산에서 빠진다.
 *   ⚠ 이걸 **말로만 하지 않는다.** 전국 갈래별 「그 밖」 가운데값을 옆에 놓는다 —
 *     자율고 26.2% · 일반고 17.3%. **숫자가 스스로 말하게 한다.**
 *   ⛔ 다만 배재고 46.6% 는 자율고 가운데값보다도 크다. **왜인지는 우리 자료로 못 잰다.**
 *     못 잰 것을 「재수 때문」으로 메우지 않는다.
 *
 * ## ⚠ 진학률 없는 학교를 **빼지 않는다**
 *
 *   특성화고 두 곳은 이 공시에 진학 칸이 없다. 빼 버리면 「강동구에 열두 곳」이 된다.
 *   **자리에 두고 왜 없는지 적는다.**
 *
 * ⛔ `is:global` 을 쓰지 않는다 — `/_astro/*.css` 로 빠져 접두사 아래서 404 가 난다.
 *   이 지면에 필요한 모양은 `public/100y/style.css` 에 넣었다.
 */
import HundredYear from '../../../../layouts/HundredYear.astro';
import NextQuestionAfterPick from '../../../../components/NextQuestionAfterPick.astro';
import schools from '../../../../data/100yearmap/pages-school.json';
import 진로자료 from '../../../../data/100yearmap/school-career.json';
import { 지역가르기, 슬러그풀기, 한벌로팔만한가, 열쇠만들기 } from '../../../../lib/school-area';
/* 🔴 값과 다음 칸은 **한 곳**에서 온다 — 지면마다 9,900 을 적으면 값이 바뀔 때 일부만 고쳐진다 */
import { 값글자, 한벌에드는것, 다음칸, 알림메일주소, 파는지면알림, 무료지면알림 } from '../../../../lib/price';

/* 🔴 가르는 규칙은 **한 곳에만** 둔다 — src/lib/school-area.ts
   지면 안에 따로 적어 뒀더니 05:2x 에 큰 시가 통째로 한 덩어리가 됐다.
   2번이 값을 정하시면서 이 자가 **파는 단위를 정하는 자**가 됐다. 두 벌을 두지 않는다. */

export async function getStaticPaths() {
  /**
   * 🔴 2026-08-08 09:16 · 2번 지시 — **본보기 한 장에서 272장으로.**
   *
   *   *「값이 정해졌는데 팔 지면이 본보기 한 장뿐입니다. 113개가 서야
   *     그날부터 팔 물건이 생깁니다」*
   *
   *   ```
   *   10곳 이상  113개   한 벌로 판다
   *   9곳 이하   159개   무료로 연다 — 「학교가 적어 한 벌로 팔지 않습니다」를 적는다
   *   ```
   *
   * ⛔ 목록을 이 함수 **안**에서 읽는다. 밖에 두면 「is not defined」로 빌드가 죽는다 —
   *   Astro 가 이 함수를 모듈 밖으로 떼어 내 따로 돌린다(2026-08-08 실제로 겪었다).
   */
  const { 단위 } = await import('../../../../data/100yearmap/areas.json');
  return (단위 as any[]).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params as { slug: string };
/* ⚠ 「경기도-수원시-장안구」처럼 조각이 셋일 수 있다. split('-')[1] 로 자르면 「수원시」만 남는다 */
const 푼것 = 슬러그풀기(slug)!;
const 시도 = 푼것.시도;
const 구 = 푼것.이름;

const 진로표 = new Map(((진로자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 진로통계 = (진로자료 as any).통계;

/** ⛔ 가나다순. **진학률 순으로 세우지 않는다** */
const 곳들 = (schools as any[])
  /* ⚠ 열쇠는 lib 가 만든다. 여기서 이어 붙이면 세종이 0곳이 된다 */
  .filter((x) => 지역가르기(x.주소)?.열쇠 === 열쇠만들기(시도, 구))
  .map((x) => ({ ...x, 진로: 진로표.get(x.code) ?? null }))
  .sort((a, b) => a.title.localeCompare(b.title, 'ko'));

const 잰곳 = 곳들.filter((x) => x.진로?.진학률 != null);
const 못잰곳 = 곳들.filter((x) => x.진로?.진학률 == null);
const 값들 = 잰곳.map((x) => x.진로.진학률).sort((a, b) => a - b);
/**
 * 🔴 **안에서 정렬한다.** 부르는 쪽이 정렬해 주기를 기대하지 않는다.
 *
 * 2026-08-08 04:2x 에 이걸로 틀렸다 — 갈래별 「그 밖」 가운데값이
 * 「일반고 24.5% · 자율고 13.5%」로 나왔다. **지면이 하려던 말과 정반대**다.
 * 정렬 안 된 배열의 가운데 원소를 집었을 뿐이었다.
 * 맞는 값은 일반고 17.3% · 자율고 26.2% 다.
 *
 * ⚠ 총계는 그럴듯해서 안 걸렸다. **지면을 렌더해 읽어서 잡았다.**
 */
const 중간값 = (a: number[]) => {
  if (!a.length) return null;
  const b = [...a].sort((x, y) => x - y);
  const m = b.length >> 1;
  return Math.round((b.length % 2 ? b[m] : (b[m - 1] + b[m]) / 2) * 10) / 10;
};
const 가운데 = 중간값(값들);
const 낮은값 = 값들[0] ?? null;
const 높은값 = 값들[값들.length - 1] ?? null;
const 퍼짐 = 낮은값 != null && 높은값 != null ? Math.round((높은값 - 낮은값) * 10) / 10 : null;

/**
 * 퍼짐 띠에서 점이 놓일 자리(%). ⛔ 등수가 아니라 **값 자체의 자리**다.
 * 양 끝이 잘리지 않게 4%~96% 안으로 넣는다.
 */
const 자리 = (값: number) =>
  낮은값 == null || 높은값 == null || 높은값 === 낮은값
    ? 50
    : Math.round((4 + ((값 - 낮은값) / (높은값 - 낮은값)) * 92) * 10) / 10;

/**
 * 전국 갈래별 「그 밖」 가운데값 — **「낮은 것이 나쁜 것이 아니다」를 숫자로 받친다.**
 * ⚠ 이 지면 안에서 센다. 손으로 적으면 자료가 바뀔 때 말만 남는다.
 */
const 갈래표 = new Map<string, number[]>();
{
  const 학교표 = new Map((schools as any[]).map((x) => [x.code, x]));
  for (const r of (진로자료 as any).자료 as any[]) {
    const x = 학교표.get(r.code);
    if (!x || r.그밖율 == null) continue;
    const k = String(x.고교유형 ?? '').trim();
    if (!k) continue;
    if (!갈래표.has(k)) 갈래표.set(k, []);
    갈래표.get(k)!.push(r.그밖율);
  }
}
const 갈래그밖 = new Map([...갈래표.entries()].map(([k, v]) => [k, { 곳: v.length, 가운데: 중간값(v) }]));

/** 이 구에 실제로 있는 갈래만. ⛔ 없는 갈래를 보기로 들지 않는다 */
const 이구갈래 = [...new Set(곳들.map((x) => String(x.고교유형 ?? '').trim()).filter(Boolean))].sort();

/** 가장 낮은 곳 — ⛔ 「꼴찌」라고 쓰지 않는다. 갈래를 설명하려고 짚는 것뿐이다 */
const 제일낮은 = 잰곳.find((x) => x.진로.진학률 === 낮은값) ?? null;

/**
 * 🔴 **한 벌로 팔 크기인가.** 2번이 정한 값(10곳)이고 `school-area.ts` 한 곳에서 온다.
 *
 *   ```
 *   10곳 이상   한 벌로 판다     — 값이 정해질 때까지 검색에 안 연다
 *   9곳 이하    무료로 연다      — 「학교가 적어 한 벌로 팔지 않습니다」를 적는다
 *   ```
 *
 * ⚠ **미리보기를 어디까지 열지는 아직 안 정해졌다**(2번 03:2x — 「전부 닫으면 아무도
 *   모르고, 전부 열면 살 이유가 없습니다」). 정해지기 전까지 파는 쪽은 닫아 둔다.
 *   ⛔ 내가 혼자 열지 않는다. 한 줄만 주시면 바로 바뀐다.
 */
/* ⚠ 제목에 시·도를 붙인다 — 「중구」는 서울·부산·대구·인천·대전·울산에 다 있다.
   붙이지 않으면 지면 여섯 장의 제목이 같아진다(검사가 잡았다). */
const 온이름 = 열쇠만들기(시도, 구);

/**
 * 🔴 2번 지시(2026-08-08 12:1x) — **4,767장이 전부 같은 그림으로 공유됐다.**
 *
 *   *「누가 노원구 지면을 카톡으로 보내도 강릉여고를 보낸 사람과 똑같은 그림이 뜹니다」*
 *
 *   카드는 `scripts/make-og-100y-pages.mjs` 가 굽는다. 여기서는 **주소만** 가리킨다.
 * ⚠ 파일 이름 규칙이 굽는 쪽과 **한 글자도 달라선 안 된다** — 다르면 카드가 404 다.
 *   굽는 쪽: `area-${slug}.png`
 */
const 카드주소 = `https://100yearmap.com/og/area-${slug}.png`;

const 한벌인가 = 한벌로팔만한가(곳들.length);

const desc = 한벌인가
  ? `${시도} ${구}의 고등학교 ${곳들.length}곳을 한 장에 모았습니다. ` +
    `줄 세우지 않고 퍼짐 안에서 어디쯤인지만 보여드립니다.`
  : `${시도} ${구}의 고등학교 ${곳들.length}곳입니다. 학교가 적어 무료로 열어 둔 지면입니다.`;
---

<HundredYear
  title={`${온이름} 고등학교 ${곳들.length}곳`}
  description={desc}
  noindex={한벌인가}
  ogImage={카드주소}
>
  {
    한벌인가 ? (
      <p class="note">
        ⬜ <strong>{파는지면알림}</strong>
      </p>
    ) : (
      <p class="note">
        🎁 <strong>{무료지면알림}</strong> {구}에는 고등학교가 {곳들.length}곳뿐이라{' '}
        <strong>한 벌로 팔지 않습니다.</strong> 열 곳이 넘는 지역만 한 벌로 냅니다.
      </p>
    )
  }

  <h1>{구} 고등학교<br class="pcbr" /> {곳들.length}곳, 한 장에</h1>
  <p class="lead">
    학교 한 곳의 숫자는 <strong>학교알리미에도 있습니다.</strong> 없는 것은{' '}
    <strong>{곳들.length}곳을 한 번에 놓고 보는 화면</strong>입니다. 지금은 학교를 하나씩
    검색해 표를 읽고 종이에 옮겨야 합니다.
  </p>

  {/**
    * 🔴 2번 지시(2026-08-08 11:0x) — **값표도 계산대도 없었다.**
    *
    *   라이브 실측 — 파는 지면(노원구)에 9,900원 표기 0 · 사는 단추 0.
    *   *「손님이 값을 모르고, 알아도 살 데가 없다」*
    *
    * ⛔ **결제 얘기는 하지 않는다.** 붙일 곳이 아직 없다. 「곧 엽니다 + 알림 받기」로 둔다.
    *   결제 수단 없이 「결제하기」를 놓으면 누른 사람이 빈 화면을 본다.
    * ⛔ **무료 지면에는 값을 안 띄운다.** 9곳 이하는 무료다 — 거기 9,900 이 뜨면 거짓말이다.
    */}
  {
    한벌인가 && (
      <section class="pricebox">
        <h2>이 한 벌은 {값글자}입니다</h2>
        <p class="answer-num">{값글자}</p>
        <p class="note">
          {온이름} 고등학교 <strong>{곳들.length}곳</strong>을 한 장에. 학교알리미에서{' '}
          <strong>{곳들.length}번 검색해 옮겨 적던 것</strong>을 한 번으로 줄입니다.
        </p>

        <h3>무엇이 들어 있나요?</h3>
        <ul class="majors">
          {한벌에드는것.map((줄) => (
            <li>
              <span>{줄}</span>
            </li>
          ))}
        </ul>

        <p>
          <strong>{다음칸.머리}.</strong> {다음칸.말}
        </p>
        {/* 🔴 폰에서 **21px 짜리 글줄**이었다(2026-08-08 15:4x · 375px 실측).
            사고 싶다는 뜻을 남기는 자리인데 이 지면에서 가장 짚기 어려웠다.
            ⛔ 색을 화려하게 만들지 않는다. **짚을 수 있게만** 한다 — 여기서 파는 것이 아니다 */}
        <p>
          <a class="gotoarea" href={알림메일주소(온이름)}>
            {다음칸.단추} →
          </a>
        </p>
        <p class="note">
          ⚠ 누르시면 <strong>메일 쓰는 창</strong>이 열립니다. 저희가 받는 것은 메일 주소뿐이고,
          <strong>열리는 날 한 번만</strong> 보내 드립니다.
        </p>
      </section>
    )
  }


  {
    퍼짐 != null && (
      <>
        {/* ⚠ 「이 구는」이라고 쓰면 안 된다 — 동해시·가평군처럼 **구가 없는 단위**가 144개다 */}
        <h2>이 지역은 이렇게 퍼져 있습니다</h2>
        <div class="answer">
          <p class="answer-label">진학률이 가장 낮은 곳부터 가장 높은 곳까지</p>
          <p class="answer-num">{낮은값}% ~ {높은값}%</p>
          <p class="answer-sub">
            퍼진 폭 {퍼짐}%p · 가운데값 {가운데}% · 잰 곳 {잰곳.length}곳
          </p>
        </div>

        {/* ⛔ 등수가 아니다. 값이 놓인 자리만 보인다 */}
        <div class="spread">
          <div class="spread-line">
            {잰곳.map((x) => (
              <span class="spread-dot" style={`left:${자리(x.진로.진학률)}%`} title={`${x.title} ${x.진로.진학률}%`} />
            ))}
          </div>
          <div class="spread-ends">
            <span>{낮은값}%</span>
            <span>{높은값}%</span>
          </div>
        </div>
        <p class="note">
          ⛔ <strong>저희는 등수를 매기지 않습니다.</strong> 점 하나가 학교 한 곳입니다 —
          어디쯤인지는 읽는 분이 보십시오. 아래 표도 <strong>가나다순</strong>이지
          잘한 순서가 아닙니다.
        </p>
      </>
    )
  }

  <h2>{곳들.length}곳을 한 번에</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>학교</th>
          <th>갈래</th>
          <th>졸업생</th>
          <th>진학</th>
          <th>그 밖</th>
        </tr>
      </thead>
      <tbody>
        {
          곳들.map((x) => (
            <tr>
              {/**
                * 🔴 2번 실측(2026-08-08 14:2x) — **258장 전부 학교 링크가 0개였다.**
                *
                *   *「무료 144곳이 우리 검색 입구입니다. 거기서 학교로 못 가면
                *     검색으로 온 손님이 **한 장 보고 나갑니다.** 오히려 무료 쪽이 더 급합니다」*
                *
                *   표에 이름만 적어 뒀지 **누를 수 있게 해 두지 않았다.**
                *   손님은 표에서 한 곳이 눈에 들면 그 학교를 더 보고 싶어진다. 그 길이 없었다.
                *
                * ⚠ 학교 낱장은 **원래 무료로 열려 있다.** 여기서 잇는다고 파는 것이 새지 않는다 —
                *   파는 것은 「한 표에 모아 견주는 것」이지 학교 한 곳의 숫자가 아니다.
                */}
              <th><a href={`/school/${x.code}`}>{x.title}</a></th>
              <td>{x.고교유형}</td>
              <td>{x.진로?.졸업자 != null ? `${x.진로.졸업자.toLocaleString()}명` : '—'}</td>
              <td>{x.진로?.진학률 != null ? <strong>{x.진로.진학률}%</strong> : '—'}</td>
              <td>{x.진로?.그밖율 != null ? `${x.진로.그밖율}%` : '—'}</td>
            </tr>
          ))
