---
/**
 * /100y/university-rate-by-area — **4년제 대학 진학률 지역별** (시·군·구)
 *
 * ── 왜 만들었나 (2026-10-22 저녁 · 1번 · 5번 지시 「지역 × 입시로 네 장 더」) ──
 * 이슈  수능 D-28. KICE 발표로 N수생이 23년 만에 최대다(2026-09-08). 낮에 낸
 *       /repeat-rate-by-area 가 「바로 안 간 쪽」을 셌다면, 이 장은 「4년제에 바로 간 쪽」이다.
 * 축    손님은 네이버에서 /report/area/<시군구> 로 들어온다(5번 7일 실측).
 *       그 손님이 「우리 동네는 4년제를 얼마나 가나」를 다음에 묻는다.
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 「대학 진학률」이라 쓰지 않는다 — 공시는 전문대·대학교·국외를 나눈다. 이 장은 «대학교»만.
 * ⛔ 일반고·자율고만 센다. 학교 비율을 평균 내지 않고 졸업자를 더해 나눈다(lib/school-area-sum).
 * ⛔ 낮다고 나쁜 동네가 아니다 — 서울이 낮은 것은 재수를 고른 사람이 많아서일 수 있다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 진로자료 from '../../../data/100yearmap/school-career.json';
import { 시군구로더함, 중간값, 지역링크 } from '../../../lib/school-area-sum';

const 자료 = 진로자료 as any;
const 문턱 = 300;
const 셈 = 시군구로더함(
  (자료.자료 as any[]).filter((r) => typeof r.진학률 === 'number'),
  /일반고|자율고/,
  (r) => ({ 분모: Number(r.졸업자) || 0, 분자: Number(r.대학교) || 0 }),
);
const 올린곳 = 셈.올린곳(문턱);
const 못올린곳 = 셈.모든곳.length - 올린곳.length;
const 가운데 = 중간값(올린곳.map((x) => x.률));
const 높은쪽 = 올린곳.slice(0, 15);
const 낮은쪽 = 올린곳.slice(-15).reverse();
const 맨위 = 올린곳[0];
const 맨아래 = 올린곳[올린곳.length - 1];
const 서울 = 셈.시도들.find((x) => x.이름 === '서울특별시');
const 낮은쪽서울 = 낮은쪽.filter((x) => x.시도 === '서울특별시').length;

const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 률 = (n: number | null | undefined) => (n == null ? '—' : `${n.toFixed(1)}%`);

const TITLE = `4년제 대학 진학률 지역별 — 시군구 ${올린곳.length}곳, ${맨위.이름} ${률(맨위.률)}`;
const desc =
  `4년제 대학 진학률 지역별 통계. 일반고·자율고 졸업생 가운데 졸업한 해에 4년제 대학교에 등록한 비율을 ` +
  `시군구 ${올린곳.length}곳으로 갈랐습니다. ${맨위.시도} ${맨위.이름} ${률(맨위.률)}부터 ` +
  `${맨아래.시도} ${맨아래.이름} ${률(맨아래.률)}까지, 가운데값 ${률(가운데)}. 학교알리미 ${자료.출처.공시연도}년 공시.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '4년제 대학 진학률 지역별 — 시군구별 일반고·자율고 졸업생 대학교 등록 비율',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
    license: 'https://www.kogl.or.kr/info/licenseType1.do',
    spatialCoverage: '대한민국 시·군·구',
    variableMeasured: ['졸업자', '대학교(4년제) 진학자', '4년제 대학 진학률'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '4년제 대학 진학률이 높은 지역은 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `일반고·자율고 졸업생 기준으로 ${높은쪽.slice(0, 5).map((x) => `${x.시도} ${x.이름} ${률(x.률)}`).join(', ')} 순입니다. 졸업한 해에 4년제 대학교에 등록한 사람만 셌고 전문대·국외는 뺐습니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '서울의 4년제 대학 진학률은 왜 낮게 나오나요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `서울은 ${률(서울?.률)}로 시도 가운데 가장 낮습니다. 공시는 졸업한 해의 등록만 세므로, 재수로 한 해 뒤에 들어간 사람은 이 수에 들어가지 않습니다. 서울은 같은 공시에서 대학에 바로 가지 않은 비율이 가장 높은 곳이기도 합니다. 까닭을 이 자료로 단정하지는 않습니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>4년제 대학 진학률 지역별,<br class="pcbr" /> 시군구 {올린곳.length}곳</h1>
  <p class="sub">
    고3 졸업생 가운데 <strong>그해 바로 4년제 대학교에 등록한 사람</strong>은 동네마다 얼마나 다를까요?
    학교알리미 {자료.출처.공시연도}년 공시를 일반고·자율고만 골라 시군구로 더했습니다.
  </p>

  <div class="answer">
    <p class="answer-label">4년제 대학교에 바로 간 비율 — 시군구 {올린곳.length}곳</p>
    <p class="answer-num">{률(맨아래.률)} ~ {률(맨위.률)}</p>
    <p class="answer-sub">
      가운데값 {률(가운데)} · 전체 {수(셈.전체분모)}명 가운데 {수(셈.전체분자)}명({률(셈.전체률)})
    </p>
  </div>

  <p>
    ⚠ <strong>「대학 진학률」 전부가 아닙니다.</strong> 공시는 진학을 전문대학·대학교·국외로
    나눕니다. 이 지면은 <strong>대학교(4년제)</strong>만 셌습니다. 전문대는{' '}
    <a href="/junior-college-rate-by-area">전문대 진학률 지역별</a>, 바로 안 간 쪽은{' '}
    <a href="/repeat-rate-by-area">재수생 비율 지역별</a>에 있습니다.
  </p>

  <h2>4년제 대학 진학률이 높은 시군구 15곳</h2>
  <p>
    졸업자 {수(문턱)}명 이상인 {올린곳.length}곳 가운데입니다. 선에 못 미친 {못올린곳}곳은 표에서
    뺐고 전체 셈에는 넣었습니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>졸업자</th><th>4년제 진학</th></tr></thead>
      <tbody>
        {높은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.곳}곳</td>
            <td class="num">{수(x.분모)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>4년제 대학 진학률이 낮은 시군구 15곳</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>졸업자</th><th>4년제 진학</th></tr></thead>
      <tbody>
        {낮은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.곳}곳</td>
            <td class="num">{수(x.분모)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    낮은 15곳 가운데 <strong>{낮은쪽서울}곳이 서울</strong>입니다. 같은 공시로 센{' '}
    <a href="/repeat-rate-by-area">재수생 비율 지역별</a>의 높은 쪽과 거의 겹칩니다 —
    서울은 4년제에 «덜 간» 것이 아니라 «그해에 덜 간» 것일 수 있습니다. 공시는 한 해 뒤 등록을
    세지 않으므로 이 자료로는 둘을 가를 수 없습니다.
  </p>

  <h2>시도별 4년제 대학 진학률</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>졸업자</th><th>4년제 진학</th><th>비율</th></tr></thead>
      <tbody>
        {셈.시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.분모)}명</td>
            <td class="num">{수(x.분자)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>이 숫자를 어떻게 읽어야 하나</h2>
  <ul>
    <li><strong>높다고 좋은 동네, 낮다고 나쁜 동네가 아닙니다.</strong> 바로 가는 길과 한 해 더
      준비하는 길, 전문대로 가는 길은 사람마다 다른 선택입니다.</li>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 같은 동네 안에서도 학교마다, 사람마다 길이 다릅니다.</li>
    <li>학교가 있는 곳으로 셌습니다. 학생이 사는 곳과 다를 수 있습니다.</li>
    <li>어느 대학에 갔는지, 성적이 어땠는지는 공시에 없습니다. 없는 수로 까닭을 적지 않습니다.</li>
  </ul>

  <h2>같은 축의 다른 지면</h2>
  <ul>
    <li><a href="/repeat-rate-by-area">재수생 비율 지역별</a> — 대학에 바로 가지 않은 비율</li>
    <li><a href="/junior-college-rate-by-area">전문대 진학률 지역별</a></li>
    <li><a href="/study-abroad-by-area">해외 대학 진학 지역별·학교별</a></li>
    <li><a href="/dropout-by-area">고등학교 학업중단율 지역별</a></li>
    <li><a href="/n-su-ratio-by-province">N수생 비율 시도별</a> — 수능 지원자 쪽에서 본 수</li>
    <li>우리 동네 고등학교 한 장 — <a href="/region">지역 목록</a>에서 고르십시오</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    <strong>졸업생 진로</strong> — {자료.출처.이름} {자료.출처.공시연도}년 공시 ·{' '}
    {자료.출처.이용허락범위} · 저희가 받은 날 {자료.통계.받은때}
  </p>
  <p class="note"><strong>학교 목록·갈래·주소</strong> — NEIS 교육정보 개방 포털</p>
  <p class="note">
    ⚠ 사람 수는 공시된 값이고, <strong>시군구로 더한 것과 비율은 저희가 낸 것</strong>입니다.
    「진학자」는 공시 정의대로 «진학하여 해당 학교에 등록한 학생»입니다.
  </p>

  <NextQuestionBrief 모은것="학교알리미 졸업생 진로 공시를 시군구로 더한 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
