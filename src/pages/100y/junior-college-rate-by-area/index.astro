---
/**
 * /100y/junior-college-rate-by-area — **전문대 진학률 지역별** (시·군·구)
 *
 * ── 왜 만들었나 (2026-10-22 저녁 · 1번 · 5번 지시 「지역 × 입시로 네 장 더」) ──
 * 이슈  입시철 한가운데(수능 11/19). 4년제·재수 지면만 있고 «전문대로 바로 간 쪽»을
 *       동네로 가른 지면이 없었다. 진학자 다섯 중 하나 가까이가 전문대다(46,180 / 246,139).
 * 축    /report/area/<시군구> 로 들어온 손님의 다음 물음 — 「우리 동네는 전문대를 얼마나 가나」.
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 전문대 진학을 «덜 간 것»으로 읽히게 쓰지 않는다. 길이 다를 뿐이다.
 * ⛔ 일반고·자율고만 센다 — 특성화고는 이 공시 묶음에 거의 없다(5곳).
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 진로자료 from '../../../data/100yearmap/school-career.json';
import { 시군구로더함, 중간값, 지역링크 } from '../../../lib/school-area-sum';

const 자료 = 진로자료 as any;
const 문턱 = 300;
const 행들 = (자료.자료 as any[]).filter((r) => typeof r.진학률 === 'number');
const 셈 = 시군구로더함(행들, /일반고|자율고/, (r) => ({
  분모: Number(r.졸업자) || 0,
  분자: Number(r.전문대학) || 0,
}));
/* 진학자 가운데 전문대 몫 — 같은 학교들로 센다 */
const 진학셈 = 시군구로더함(행들, /일반고|자율고/, (r) => ({
  분모: Number(r.진학) || 0,
  분자: Number(r.전문대학) || 0,
}));
const 올린곳 = 셈.올린곳(문턱);
const 못올린곳 = 셈.모든곳.length - 올린곳.length;
const 가운데 = 중간값(올린곳.map((x) => x.률));
const 높은쪽 = 올린곳.slice(0, 15);
const 낮은쪽 = 올린곳.slice(-10).reverse();
const 맨위 = 올린곳[0];
const 맨아래 = 올린곳[올린곳.length - 1];
const 수도권 = /^(서울특별시|경기도|인천광역시)$/;
const 높은쪽수도권 = 높은쪽.filter((x) => 수도권.test(x.시도)).length;

const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 률 = (n: number | null | undefined) => (n == null ? '—' : `${n.toFixed(1)}%`);

const TITLE = `전문대 진학률 지역별 — 시군구 ${올린곳.length}곳, ${맨위.이름} ${률(맨위.률)}`;
const desc =
  `전문대 진학률 지역별 통계. 일반고·자율고 졸업생 가운데 졸업한 해에 전문대학에 등록한 비율을 ` +
  `시군구 ${올린곳.length}곳으로 갈랐습니다. ${맨위.시도} ${맨위.이름} ${률(맨위.률)}부터 ` +
  `${맨아래.시도} ${맨아래.이름} ${률(맨아래.률)}까지, 가운데값 ${률(가운데)}. 학교알리미 ${자료.출처.공시연도}년 공시.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '전문대 진학률 지역별 — 시군구별 일반고·자율고 졸업생 전문대학 등록 비율',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
    license: 'https://www.kogl.or.kr/info/licenseType1.do',
    spatialCoverage: '대한민국 시·군·구',
    variableMeasured: ['졸업자', '전문대학 진학자', '전문대 진학률'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '전문대 진학률이 높은 지역은 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `일반고·자율고 졸업생 기준으로 ${높은쪽.slice(0, 5).map((x) => `${x.시도} ${x.이름} ${률(x.률)}`).join(', ')} 순입니다. 상위 15곳 가운데 ${높은쪽수도권}곳이 서울·경기·인천입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '고등학교 졸업생 가운데 전문대에 가는 사람은 얼마나 되나요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `저희가 이은 일반고·자율고 졸업생 ${수(셈.전체분모)}명 가운데 ${수(셈.전체분자)}명(${률(셈.전체률)})이 졸업한 해에 전문대학에 등록했습니다. 진학한 사람만 놓고 보면 ${률(진학셈.전체률)}입니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>전문대 진학률 지역별,<br class="pcbr" /> 시군구 {올린곳.length}곳</h1>
  <p class="sub">
    고3 졸업생 가운데 <strong>그해 바로 전문대학에 등록한 사람</strong>은 동네마다 얼마나 다를까요?
    학교알리미 {자료.출처.공시연도}년 공시를 일반고·자율고만 골라 시군구로 더했습니다.
  </p>

  <div class="answer">
    <p class="answer-label">전문대에 바로 간 비율 — 시군구 {올린곳.length}곳</p>
    <p class="answer-num">{률(맨아래.률)} ~ {률(맨위.률)}</p>
    <p class="answer-sub">
      가운데값 {률(가운데)} · 졸업자 {수(셈.전체분모)}명 가운데 {수(셈.전체분자)}명({률(셈.전체률)}) ·
      진학자 가운데로는 {률(진학셈.전체률)}
    </p>
  </div>

  <h2>전문대 진학률이 높은 시군구 15곳</h2>
  <p>
    졸업자 {수(문턱)}명 이상인 {올린곳.length}곳 가운데입니다. 선에 못 미친 {못올린곳}곳은 표에서
    뺐고 전체 셈에는 넣었습니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>졸업자</th><th>전문대 진학</th></tr></thead>
      <tbody>
        {높은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.곳}곳</td>
            <td class="num">{수(x.분모)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    15곳 가운데 <strong>{높은쪽수도권}곳이 서울·경기·인천</strong>입니다. 4년제 진학률은
    거꾸로 수도권이 낮습니다(<a href="/university-rate-by-area">4년제 대학 진학률 지역별</a>).
    같은 졸업생이 어느 쪽으로 나뉘는지가 지역마다 다르다는 뜻이지, 어느 쪽이 낫다는 뜻이 아닙니다.
  </p>

  <h2>전문대 진학률이 낮은 시군구 10곳</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>졸업자</th><th>전문대 진학</th></tr></thead>
      <tbody>
        {낮은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.곳}곳</td>
            <td class="num">{수(x.분모)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>시도별 전문대 진학률</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>졸업자</th><th>전문대 진학</th><th>비율</th></tr></thead>
      <tbody>
        {셈.시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.분모)}명</td>
            <td class="num">{수(x.분자)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>이 숫자를 어떻게 읽어야 하나</h2>
  <ul>
    <li><strong>전문대는 «덜 간» 길이 아닙니다.</strong> 일찍 기술을 갖추는 쪽을 고른 사람이 많으면
      이 수가 올라갑니다. 어느 길이 맞는지는 이 숫자가 말해 주지 않습니다.</li>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong></li>
    <li>학교가 있는 곳으로 셌습니다. 근처에 전문대가 많은지, 학생이 어디 사는지는 재지 않았습니다 —
      재지 않은 것을 까닭으로 적지 않습니다.</li>
    <li>전문대를 나온 뒤가 궁금하면 <a href="/ranking-juniorcollege-brand">전문대학 순위</a>와{' '}
      <a href="/university">대학 지면</a>을 보십시오.</li>
  </ul>

  <h2>같은 주제의 다른 화면</h2>
  <ul>
    <li><a href="/university-rate-by-area">4년제 대학 진학률 지역별</a></li>
    <li><a href="/repeat-rate-by-area">재수생 비율 지역별</a></li>
    <li><a href="/study-abroad-by-area">해외 대학 진학 지역별·학교별</a></li>
    <li><a href="/dropout-by-area">고등학교 학업중단율 지역별</a></li>
    <li>우리 동네 고등학교 한 장 — <a href="/region">지역 목록</a>에서 고르십시오</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    <strong>졸업생 진로</strong> — {자료.출처.이름} {자료.출처.공시연도}년 공시 ·{' '}
    {자료.출처.이용허락범위} · 저희가 받은 날 {자료.통계.받은때}
  </p>
  <p class="note"><strong>학교 목록·갈래·주소</strong> — NEIS 교육정보 개방 포털</p>
  <p class="note">
    ⚠ 사람 수는 공시된 값이고, <strong>시군구로 더한 것과 비율은 저희가 낸 것</strong>입니다.
  </p>

  <NextQuestionBrief 모은것="학교알리미 졸업생 진로 공시를 시군구로 더한 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
