---
/**
 * /100y/salary-ranking — 순위는 공개한다, 그러나 전부는 아니다 (시리즈 7편)
 *
 * 🔴 docs/3번-순위콘텐트-지침.md 참고 — 순위는 CEO스코어(기업데이터연구소) 인용,
 *   100yearmap이 새로 매기지 않는다. "부자 되는 법"류 조언 문장 금지, "나쁘다" 판정 금지.
 *   "순위"라는 낱말을 의도적으로 쓴다 — docs/금지말-대장.json에 이 지면을 등록해 둔다.
 *
 * ⭐ 톤: 급여의 «규모»만 보여준다. 이 순위가 갈라 보여주는 상위권이, 100yearmap이 인용하는
 *   전 국민 임금분포표에서는 «500만원 이상»이라는 하나의 열린 칸으로 뭉뚱그려져 있다는
 *   사실 자체가 "이 순위가 보여주지 않는 것"이다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/salary-ranking-2026.json';

const 자료 = 원본 as any;
const 순위출처 = 자료.순위출처;
const 전체 = 자료.전체;
const 업종top5 = 자료.업종별_top5 as any[];
const 기업top10 = 자료.기업별_top10 as any[];
const 실측 = 자료.실측출처;

const 만콤마 = (n: number) => n.toLocaleString();
const 월환산 = (반기만원: number) => Math.round((반기만원 / 6) * 10) / 10;

const 전체월환산 = 월환산(전체.올해_반기_만원);
const 일위기업 = 기업top10[0];
const 일위기업월환산 = 월환산(일위기업.반기평균_만원);

const desc =
  `CEO스코어(기업데이터연구소, ${순위출처.발표일} 발표)가 ${순위출처.조사대상}로 낸 ` +
  `2026년 상반기 평균급여 순위 — 500대 기업 전체 평균은 반기 ${만콤마(전체.올해_반기_만원)}만원(월환산 약 ${만콤마(전체월환산)}만원)입니다. ` +
  `100yearmap이 KOSIS로 실측한 전 국민 임금분포표에서는 이 금액이 모두 «500만원 이상»이라는 ` +
  `하나의 열린 칸(대졸 이상 근로자의 ${자료.대졸이상_500만원이상_비율}%)에 함께 들어갑니다.`;

/** 업종별 top5 막대그림 — ⛔ 새 JS 라이브러리를 쓰지 않는다. 월환산 값을 가로막대로 놓고
 *  KOSIS 표의 «500만원 이상» 칸이 시작되는 지점에 기준선을 하나 긋는다 */
const 차트 = (() => {
  const 항목 = 업종top5.map((r) => ({ 이름: r.업종, 월환산: 월환산(r.반기평균_만원) }));
  const 최대 = Math.max(...항목.map((r) => r.월환산));
  const 폭 = 520, 막대영역 = 340, 왼쪽라벨 = 100, 줄높이 = 40, 위여백 = 10;
  const 높 = 위여백 * 2 + 줄높이 * 항목.length;
  const 기준선_x = 왼쪽라벨 + (500 / 최대) * 막대영역;
  return { 항목, 최대, 폭, 막대영역, 왼쪽라벨, 줄높이, 위여백, 높, 기준선_x };
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '이 급여 순위는 100yearmap이 매긴 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `아닙니다. ${순위출처.이름}를 그대로 인용했습니다. ${순위출처['⚠원자료']} 100yearmap은 개별 기업의 급여를 새로 추정하지 않습니다.`,
      },
    },
    {
      '@type': 'Question',
      name: '상반기 급여를 6으로 나누면 월급인가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '단순 나눗셈으로 만든 «월환산»일 뿐입니다. 상반기 총액에는 성과급·인센티브가 섞여 있어, 실제로 매달 받는 금액과는 다를 수 있습니다.',
      },
    },
    {
      '@type': 'Question',
      name: '이 순위에 오르면 더 잘 사는 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '이 지면은 급여의 «규모»만 보여줍니다. 누가 더 잘 사는지, 더 행복한지는 확인할 방법이 없고 100yearmap이 판정할 일도 아닙니다.',
      },
    },
  ],
};
---

<HundredYear
  title={`한국금융지주 상반기 평균급여 ${만콤마(일위기업.반기평균_만원)}만원 — 500대 기업 전체 평균은 ${만콤마(전체.올해_반기_만원)}만원입니다`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>
    한국금융지주 상반기 평균급여 {만콤마(일위기업.반기평균_만원)}만원<br class="pcbr" />
    500대 기업 전체 평균은 {만콤마(전체.올해_반기_만원)}만원입니다
  </h1>

  <div class="warn">
    <p><strong>⚠ 이 순위는 저희가 매긴 게 아닙니다.</strong></p>
    <p class="note">
      {순위출처.이름}({순위출처.발표일} 발표)를 그대로 인용했습니다. {순위출처['⚠원자료']}
    </p>
  </div>

  <p class="sub">
    CEO스코어가 {순위출처.조사대상}로 집계한 2026년 상반기 1인당 평균급여는
    {' '}<strong>{만콤마(전체.올해_반기_만원)}만원</strong>으로, 작년 동기({만콤마(전체.작년동기_반기_만원)}만원)보다
    {' '}{전체.증가율}%({만콤마(전체.증가액_만원)}만원) 늘었습니다({순위출처.발표일} 기준). 반기 금액을 6으로
    {' '}단순히 나눈 월환산은 약 <strong>{만콤마(전체월환산)}만원</strong>입니다.
  </p>
  <p class="note">
    ⚠ {(자료['⚠단위주의'] as string[])[0]}
  </p>

  <h2>업종별로 보면 — 금융지주·증권업이 상위를 차지했습니다</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>순위</th><th>업종</th><th>반기 평균급여</th><th>월환산(참고)</th></tr></thead>
      <tbody>
        {업종top5.map((r) => (
          <tr>
            <td>{r.순위}위</td>
            <td>{r.업종}</td>
            <td>{만콤마(r.반기평균_만원)}만원</td>
            <td>약 {만콤마(월환산(r.반기평균_만원))}만원</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">{자료.방법론}</p>

  <h2>500만원 이상, 이 칸 하나에 다 들어갑니다</h2>
  <p>
    100yearmap이 {실측.기준연도}년 KOSIS {실측.이름}로 실측한 전 국민 임금분포표에서, 대졸 이상
    {' '}근로자 중 월 급여(급여·수당·상여 포함 총액)가 <strong>500만원 이상</strong>인 사람의 비율은
    {' '}<strong>{자료.대졸이상_500만원이상_비율}%</strong>입니다(고졸 {자료.고졸_500만원이상_비율}%). 그런데 이 표는
    {' '}500만원 «이상»을 하나의 칸으로 묶어 놓아 상한이 없습니다 — 위 업종별 월환산
    {' '}약 {만콤마(차트.항목[0].월환산)}만원짜리도, 500대 기업 전체 평균 월환산
    {' '}약 {만콤마(전체월환산)}만원짜리도 같은 칸 안에 들어갑니다.
  </p>
  <div class="tablewrap">
    <svg viewBox={`0 0 ${차트.폭} ${차트.높}`} width="100%" style="max-width:520px" role="img"
         aria-label={`업종별 월환산 평균급여 막대그림 — 500만원 지점에 기준선을 그었다`}>
      <line x1={차트.기준선_x} y1="0" x2={차트.기준선_x} y2={차트.높} stroke="#b23b3b" stroke-width="1.5" stroke-dasharray="4 3" />
      <text x={차트.기준선_x + 4} y="12" font-size="11" fill="#b23b3b">KOSIS 최상위 칸 시작(500만원)</text>
      {차트.항목.map((r, i) => {
        const y = 차트.위여백 + i * 차트.줄높이;
        const 막대폭 = (r.월환산 / 차트.최대) * 차트.막대영역;
        return (
          <g>
            <text x={차트.왼쪽라벨 - 8} y={y + 17} font-size="12" text-anchor="end" fill="#333">{r.이름}</text>
            <rect x={차트.왼쪽라벨} y={y + 4} width={막대폭} height="18" rx="3" fill="#c9a84c" opacity="0.85" />
            <text x={차트.왼쪽라벨 + 막대폭 + 6} y={y + 17} font-size="11" fill="#333">{만콤마(r.월환산)}만원</text>
          </g>
        );
      })}
    </svg>
  </div>
  <p class="note">
    ⚠ {(자료['⚠단위주의'] as string[])[1]}
  </p>

  <h2>기업별로 보면</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>순위</th><th>기업</th><th>상반기 평균급여</th></tr></thead>
      <tbody>
        {기업top10.map((r) => (
          <tr>
            <td>{r.순위}위</td>
            <td>{r.기업}</td>
            <td>{만콤마(r.반기평균_만원)}만원</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    1위 {일위기업.기업}은 작년 동기보다 {일위기업.증가율}%({만콤마(일위기업.증가액_만원)}만원) 늘었습니다.
    {' '}이 순위는 «회사 전체 임직원 평균»입니다 — 특정 임원 개인이 얼마를 받는지는 이 자료로 알 수 없습니다.
  </p>

  <h2>이 지면이 말하지 않는 것</h2>
  <ul>
    {(자료['⚠이자료가못가르는것'] as string[]).map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="note">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong> 이 지면은 급여의 «규모»를 보여줄 뿐,
    {' '}누가 더 잘 산다거나 어느 직장이 더 낫다고 말하지 않습니다. 그 판단은 손님의 몫입니다.
  </p>

  <h2>자주 묻는 말</h2>
  {jsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    출처 — 순위: {순위출처.이름}({순위출처.url}) · 실측: {실측.이름}, {실측.기준연도}년 기준({실측.비고})
  </p>

  <p class="note">
    <a href="/wage-education">← 학력별 월급여는 최저와 최고 사이 몇 배 차이일까요?</a>
    <br />
    <a href="/wage-distribution">← 임금 구간별로 근로자가 어떻게 나뉘어 있을까요?</a>
    <br />
    <a href="/ranking-stock-wealth">← 한 사람의 주식재산이 청년 가구 몇 곳을 합친 것과 같을까요?</a>
  </p>

  <NextQuestionBrief 모은것="CEO스코어(기업데이터연구소) 언론 보도 + KOSIS 고용형태별근로실태조사" />

  {/* 🔴 2번의 자체 댓글 시스템(2026-08-31, 무쿠키·무IP) — docs/세션간-메모.md 참고 */}
  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/salary-ranking"></div>
</HundredYear>
