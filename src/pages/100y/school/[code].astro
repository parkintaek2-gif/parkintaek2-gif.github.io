---
/**
 * /100y/school/[code] — P2 학교 페이지
 *
 * 학과 페이지(P1)가 「이 길로 가면 어떻게 되나」라면,
 * 학교 페이지는 「그럼 어디로 가야 하나」다. 두 축이 서로를 가리킨다.
 *
 * ⛔ 학교끼리 등수를 매기지 않는다. 「명문」·「상위」 같은 말을 쓰지 않는다.
 *    같은 지역에 몇 곳이 있는지는 규모의 사실이라 쓴다.
 *
 * ⚠ 취업 수치는 **학교유형 전체**의 값이다. 이 학교 하나의 성적표가 아니다.
 *    학교 이름 옆에 붙는 숫자는 오해를 사기 제일 쉬운 자리라, 경고를 숫자 바로 밑에 둔다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { href, lastSegment } from '../../../lib/hundredyear';
import { 고교지역_대학지역, 짧은지역명 } from '../../../lib/region';
import { 권할만한 } from '../../../lib/university';
import schools from '../../../data/100yearmap/pages-school.json';
import 중단자료 from '../../../data/100yearmap/school-dropout.json';
import 학급자료 from '../../../data/100yearmap/school-class-size.json';
import 진로자료 from '../../../data/100yearmap/school-career.json';
import 계열자료 from '../../../data/100yearmap/voc-series-outcomes.json';
import NextQuestion from '../../../components/NextQuestion.astro';
import majors from '../../../data/100yearmap/pages-major.json';
import universities from '../../../data/100yearmap/pages-university.json';

/** 페이지가 있는 학과만 링크한다. 개설 학교가 1곳뿐인 학과는 페이지가 없다(얇아서 뺐다) */
const HAS_PAGE = new Set((majors as any[]).map((m) => m.url));

/** 지역 → 그 지역 대학. 한 번만 만들고 2,525장이 나눠 쓴다
 *  ⚠ 지면마다 filter 를 돌리면 2,525 × 377 번이 된다 */
/** ⚠ 2026-08-05 — **수치가 하나도 없는 48곳을 여기서 뺐다.**
 *  이 목록은 2,525장에 그대로 실린다. 학부모가 누르면 텅 빈 지면이 나왔다.
 *  강원 지역 대학교 13곳 중 5곳이 그랬다(캠퍼스 4 + 한중대학교).
 *  ⛔ 지면을 지운 것이 아니다 — 「대학 찾기」에는 그대로 있고 「수치 없음」이라 적혀 있다.
 *     검색해서 온 사람에게는 그 사실 자체가 답이다. 다만 **우리가 먼저 권하지는 않는다.** */
const 지역별대학 = new Map<string, any[]>();
for (const u of 권할만한(universities as any[])) {
  if (!지역별대학.has(u.지역)) 지역별대학.set(u.지역, []);
  지역별대학.get(u.지역)!.push(u);
}
for (const list of 지역별대학.values()) list.sort((a, b) => a.표시명.localeCompare(b.표시명, 'ko'));

/** 🔴 **이름이 겹치는 학교가 102가지 · 216장이다** (2026-08-05 실측).
 *  서울 강동고 · 대구 강동고 · 울산 강동고가 **전부 다른 학교**인데 제목이 같았다.
 *  검색 결과에 셋이 나란히 뜨면 어느 학교인지 고를 수가 없다.
 *  ⚠ 겹치는 것에만 지역을 붙인다 — 안 겹치는 2,309장까지 길어질 이유가 없다. */
const 이름수 = new Map<string, number>();
for (const s of schools as any[]) 이름수.set(s.title, (이름수.get(s.title) ?? 0) + 1);

export async function getStaticPaths() {
  return (schools as any[]).map((s) => ({
    params: { code: lastSegment(s.url) },
    props: { school: s },
  }));
}

const { school } = Astro.props as { school: any };
const 겹침 = (이름수.get(school.title) ?? 0) > 1;
const 제목 = 겹침 ? `${school.title}(${짧은지역명(school.지역)})` : school.title;
/**
 * ⭐ **이 학교 하나의 숫자다** (2026-08-06) — 이 지면에서 처음이다.
 *
 * 위의 취업 수치는 「특성화고 전체」·「마이스터고 전체」 값이라 학교마다 똑같다.
 * 학업중단은 **학교별로 공시된다.** 그래서 얇은 일반고 1,353장이 처음으로
 * **제 숫자**를 갖는다.
 *
 * ⛔ 이것을 「학교의 성적표」로 읽으면 안 된다 — 전학·유학·건강·검정고시가 다 섞여 있다.
 *   그 말을 숫자 바로 밑에 둔다.
 */
const 중단표 = new Map<string, any>(((중단자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 중단출처 = (중단자료 as any).출처;

/**
 * ⭐ **이 학교 하나의 숫자 둘째** (2026-08-07) — 학급당 학생 수 · 수업교원 1인당 학생 수.
 *
 * ⚠ 여기 「졸업생 진로는 못 받는다」고 적어 뒀었다. **틀렸다.** 항목 52 가 열려 있고
 *   지금은 이 지면 맨 위에 실린다(위 `진로표` 주석 참조). 이 블록은 그것과 **다른 축**이다 —
 *   「어디로 갔나」가 아니라 **「어떤 데서 배우나」**다. 둘 다 남긴다.
 *
 * ⚠ 【수업교원】은 정규 교과목을 **단독 전담해 수업하는** 교원이다. 휴직·파견까지 넣은
 *   「교원수」와 다르다. **그 말을 지면에 그대로 적는다** — 안 적으면 다른 표와 안 맞는다고 읽힌다.
 * ⛔ 등수를 쓰지 않는다. **전국 중간값과의 견줌**만 쓴다.
 */
const 학급표 = new Map<string, any>(((학급자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 학급출처 = (학급자료 as any).출처;
const 학급통계 = (학급자료 as any).통계;

/**
 * 🔴 **졸업생의 진로** — 이 지면에서 사람들이 제일 먼저 묻는 것이다(2026-08-07).
 *
 * ⛔ **제가 「이건 못 받는다」고 두 번 결론 내고 지면에 그렇게 적었다. 틀렸다.**
 *   학교알리미 항목 52 가 계정도 신청도 없이 열려 있다. 두 번 다 원인은 같다 —
 *   **항목 목록을 뽑는 내 자가 불완전했다.** 「없다」는 결론은 「있다」보다 검증이 더 필요하다.
 *
 * ⚠ 직업계고(특성화·마이스터)는 이 표에 거의 없다. 그쪽 진로는 **별도 조사**로 가고
 *   우리는 그것을 `/work` 지면에 쓴다. **두 숫자를 빼서 견주지 않는다.**
 * ⛔ 「기타」를 「논다」로 읽으면 안 된다 — **재수생이 여기 들어간다.**
 */
const 진로표 = new Map<string, any>(((진로자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 진로출처 = (진로자료 as any).출처;
const 진로통계 = (진로자료 as any).통계;

const 취업 = school.취업;
const 평균 = 취업?.전체평균;
const 수치 = 취업?.수치;
const pct = (v: number | null | undefined) => (v == null ? '—' : `${v.toFixed(1)}%`);

/** ⚠ 학과는 문자열이 아니라 객체다 — { name, url, 전국개설교수, 전국순위 }.
 *  `url` 이 null 이면 그 학과는 독립 페이지가 없다(개설 학교가 1곳뿐이라 뺐다).
 *  그래도 **이름은 보여준다** — 그 학교에 실제로 있는 학과를 숨기면 안 된다.
 *  ⛔ `전국순위` 는 읽지 않는다. 정렬용이고 화면에 나가지 않는다. */
const 학과 = (school.학과 ?? []) as { name: string; url: string | null }[];

/** 설립일 19980113 → 1998년 */
const 설립연도 = /^\d{8}$/.test(school.설립일 ?? '') ? school.설립일.slice(0, 4) : null;

/** ⭐ 두 축을 잇는 자리 — 「대학 다음까지 보는 진로 지도」인데 여태 고교와 대학이 서로 안 닿았다.
 *  ⚠ 학과끼리 잇는 자료(고교 학과 ↔ 대학 학과)는 **아직 없다.** 있는 것은 지역뿐이다.
 *    그래서 **지역으로만** 잇는다. 짐작으로 학과를 잇지 않는다.
 *  ⚠ 이 지면 2,525장 중 1,353장이 학과가 없는 일반고다. 그쪽에는 이게 유일한 다음 걸음이 된다. */
const 중단 = 중단표.get(school.code) ?? null;
const 학급 = 학급표.get(school.code) ?? null;
const 진로 = 진로표.get(school.code) ?? null;

/**
 * ⭐ **계열별 취업·진학** (2026-08-07) — 직업계고 480곳의 빈 자리를 메운다.
 *
 * 여태 이 지면의 취업 숫자는 **두 벌뿐**이었다(특성화고 전체 / 마이스터고 전체).
 * 516곳이 전부 같은 숫자를 보니 학교를 고르는 데 쓸 수가 없었다.
 *
 * 🔴 **학교별 숫자는 어디에도 없다.** 오늘 네 방향으로 확인했다 —
 *   ① 학교알리미 공개용 28항목에 특성화고 취업 칸이 없다
 *   ② 항목 52(졸업생의 진로)에 특성화고가 4곳뿐이다(항목 09 에는 487곳)
 *   ③ 유력 항목 8개를 2023~2026 네 해로 두드렸다 — 전부 미공시
 *   ④ KOSIS 직업계고 관련 58표의 축을 다 봤다 — 학교 단위 축이 없다
 *
 * 🟢 대신 **계열**을 붙인다. 그 학교의 학과가 속한 계열을 **모두** 보인다.
 *   ⚠ 계열이 하나로 정해지는 학교는 88곳뿐이고 **398곳은 여러 계열**이다(실측).
 *     하나를 골라 붙이면 나머지를 숨기는 것이라, 있는 대로 다 보인다.
 *   ⚠ 학과의 계열은 **학과 이름으로 저희가 추정한 것**이다. 그 말을 지면에 적는다.
 *   ⛔ 여전히 학교 하나의 값이 아니다. 「이 학교 취업률」로 읽히게 두지 않는다.
 */
const 계열표 = new Map<string, any>(((계열자료 as any).자료 as any[]).map((r) => [r.계열, r]));
const 계열통계 = (계열자료 as any).통계;
const 계열출처 = (계열자료 as any).출처;
const 학과계열 = new Map<string, string>(
  (majors as any[]).filter((m) => m.계열).map((m) => [m.title, m.계열]),
);
const 이학교계열 = [
  ...new Set(
    (school.학과 ?? [])
      .map((a: any) => 학과계열.get(a.name))
      .filter((c: string | undefined) => c && c !== '미분류'),
  ),
]
  .map((c) => 계열표.get(c as string))
  .filter(Boolean)
  .sort((a: any, b: any) => b.졸업자 - a.졸업자);

/** 전국 중간값과 견준다. ⛔ 「좋다/나쁘다」를 말하지 않는다 — 차이만 적는다.
 *  ⚠ 소수 한 자리끼리 뺀다. 반올림한 값과 안 반올림한 값을 견주면 **말이 뒤집힌다**
 *    (2026-08-06 대학 지면에서 실제로 났다 — `check:100y:launch` 가 그 규칙을 지킨다) */
const 견줌 = (값: number | null, 중간: number | null) => {
  if (값 == null || 중간 == null) return null;
  const 차 = Math.round((값 - 중간) * 10) / 10;
  if (차 === 0) return `전국 중간값(${중간}명)과 같습니다`;
  return `전국 중간값 ${중간}명보다 ${Math.abs(차)}명 ${차 > 0 ? '많습니다' : '적습니다'}`;
};

const 대학지역 = 고교지역_대학지역(school.지역);
const 지역대학 = 대학지역 ? (지역별대학.get(대학지역) ?? []) : [];
const 보여줄대학 = 지역대학.slice(0, 12);
const 지역짧게 = 짧은지역명(school.지역);

const desc = 학과.length
  ? `${school.title}(${school.지역} · ${school.고교유형})에 개설된 학과 ${학과.length}개와, 이 학교유형 졸업자가 취업 뒤에 얼마나 그 자리에 남는지를 공공데이터로 정리했습니다.`
  : `${school.title}(${school.지역} · ${school.고교유형})의 기본 정보를 교육부 공공데이터로 정리했습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HighSchool',
  name: school.title,
  ...(school.titleEn ? { alternateName: school.titleEn } : {}),
  address: { '@type': 'PostalAddress', addressRegion: school.지역, streetAddress: school.주소 },
  ...(school.홈페이지 ? { url: school.홈페이지 } : {}),
};
---

{/* ⚠ 제목에만 지역을 붙인다. h1 은 그대로 둔다 —
    지면에 들어온 사람은 바로 아래 `.sub` 에서 지역을 이미 본다 */}
{/*
  🔴 **얇은 지면은 검색에 안 올린다** (사장님 결정 2026-08-05 「알찬 것만 먼저 열어라」).
     이름·주소뿐인 지면은 **검색에서 들어온 사람에게 줄 게 없다.**
     얇은 지면이 많으면 사이트 전체 품질 평가가 깎인다.

  ⭐ **2026-08-06 — 조건이 하나 늘었다.** 학교별 학업중단 수치가 붙었다.
     그건 「특성화고 전체」 같은 **유형 평균이 아니라 이 학교 하나의 숫자**다.
     그래서 학과가 없어도 **제 숫자가 있으면 연다.**

     열림   학과가 있거나 · 학업중단 수치가 있는 지면   2,441장
     닫힘   둘 다 없는 지면                          84장

  ⚠ **사이트맵도 조건이 같아야 한다**(`sitemap.xml.ts`). 한쪽만 고치면 구글에 모순된
    신호를 준다. `check:100y:launch` 의 「연 지면이 사이트맵에 다 있나」가 지킨다.
*/}
<HundredYear title={제목} description={desc} jsonLd={jsonLd} noindex={학과.length === 0 && !중단 && !학급}>
  <h1>{school.title}</h1>
  <p class="sub">
    {school.지역} · {school.고교유형} · {school.설립}
    {school.공학 && <> · {school.공학}</>}
    {설립연도 && <> · {설립연도}년 설립</>}
  </p>

  {/* 개설 학과 — 이 학교의 얼굴이다. 취업 수치보다 먼저 놓는다 */}
  {
    학과.length > 0 ? (
      <>
        <h2>개설 학과 {학과.length}개</h2>
        <ul class="majors">
          {학과.map((m) => (
            <li>
              {m.url && HAS_PAGE.has(m.url) ? (
                <a href={href(m.url)}>{m.name}</a>
              ) : (
                <span>{m.name}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="note">학과를 누르면 그 길로 간 사람들이 졸업 뒤에 어떻게 됐는지 볼 수 있습니다.</p>
      </>
    ) : (
      <p class="note">
        이 학교는 NEIS 학과정보에 등록된 학과가 없습니다. 학과를 나누지 않는 일반계 과정이거나,
        아직 등록되지 않았을 수 있습니다.
      </p>
    )
  }

  {/* 취업 — ⚠ 경고를 숫자 바로 밑에 둔다 */}
  {
    수치 && (
      <>
        <h2>졸업하고 나서</h2>
        <div class="nums">
          <div class="num">
            <span class="n">{pct(수치['1차유지취업률'])}</span>
            <span class="k">1년 뒤에도 그 자리에</span>
          </div>
          <div class="num">
            <span class="n">{pct(수치['2차유지취업률'])}</span>
            <span class="k">2년 뒤</span>
          </div>
          <div class="num drop">
            <span class="n">−{취업['1차에서2차로_빠지는폭']}%p</span>
            <span class="k">그 사이에 빠진 폭</span>
          </div>
        </div>
        <p class="warn">
          ⚠ 이 수치는 전국 <strong>{취업.적용단위}</strong> 졸업자{' '}
          {수치.졸업자?.toLocaleString()}명의 수치입니다.{' '}
          <strong> {school.title} 한 학교의 수치가 아닙니다.</strong> 학교별로 나뉜 공식 통계는
          공개되지 않습니다.
        </p>
        <p>
          전국 평균은 1년 뒤 {pct(평균['1차유지취업률'])}, 2년 뒤 {pct(평균['2차유지취업률'])}
