---
/**
 * /100y/repeat-rate-by-area — **재수생 비율 지역별** (시·군·구)
 *
 * ── 왜 만들었나 (2026-10-22 · 1번) ─────────────────────────────────────
 * 이슈  2027학년도 수능이 11월 19일이다. KICE 가 N수생 19만6,473명으로 23년 만에
 *       최대라고 냈고(2026-09-08), 대구·제주는 졸업생 지원자가 12% 넘게 늘었다.
 *       오늘(10-22) 신문은 「수시 면접」 기사를 낸다 — 입시철 한가운데다.
 * 축    5번이 7일치 유입을 재니 백년지도 손님은 네이버에서 «시군구» 지면으로 들어온다
 *       (의정부시 10 · 중랑구 8 · 경산시 6). 그래서 이 이슈를 **시군구로 가른다.**
 *       「우리 동네 재수 많나」에 답하는 지면이 우리에게 없었다.
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 「재수율」이라 단정하지 않는다. 공시의 「그 밖」은 재수·취업·미상이 한 칸이다.
 *   그래서 **일반고·자율고만** 센다 — 특성화고·특목고는 「그 밖」의 뜻이 다르다.
 * ⛔ 학교를 평균 내지 않는다. 졸업자를 더해서 센다(큰 학교와 작은 학교를 같이 치면 틀린다).
 * ⛔ 졸업자 300명 미만인 곳은 표에 올리지 않고 «몇 곳인지» 따로 적는다 — 한두 명이 흔든다.
 * ⛔ 높다고 나쁜 동네가 아니다. 「이것은 통계이지 당신이 아닙니다」.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import schools from '../../../data/100yearmap/pages-school.json';
import 진로자료 from '../../../data/100yearmap/school-career.json';
import { 단위 as 전체지역 } from '../../../data/100yearmap/areas.json';
import { 지역가르기 } from '../../../lib/school-area';

const 자료 = 진로자료 as any;
const 진로표 = new Map((자료.자료 as any[]).map((r) => [r.code, r]));
const 슬러그표 = new Map((전체지역 as any[]).map((a) => [a.열쇠, a.slug]));

const 문턱 = 300;
const 셈 = new Map<string, { 시도: string; 이름: string; 졸: number; 밖: number; 곳: number }>();
for (const x of schools as any[]) {
  const r: any = 진로표.get(x.code);
  if (!r || typeof r.진학률 !== 'number') continue;
  if (!/일반고|자율고/.test(String(x.고교유형 ?? ''))) continue;
  const g = 지역가르기(x.주소);
  if (!g) continue;
  const v = 셈.get(g.열쇠) ?? { 시도: g.시도, 이름: g.이름, 졸: 0, 밖: 0, 곳: 0 };
  v.졸 += Number(r.졸업자) || 0;
  v.밖 += Number(r.그밖) || 0;
  v.곳 += 1;
  셈.set(g.열쇠, v);
}
const 모든곳 = [...셈.entries()].map(([열쇠, v]) => ({ 열쇠, ...v, 률: v.졸 ? (v.밖 / v.졸) * 100 : 0 }));
const 올린곳 = 모든곳.filter((x) => x.졸 >= 문턱).sort((a, b) => b.률 - a.률);
const 못올린곳 = 모든곳.length - 올린곳.length;

const 전체졸 = 모든곳.reduce((s, x) => s + x.졸, 0);
const 전체밖 = 모든곳.reduce((s, x) => s + x.밖, 0);
const 전체률 = 전체졸 ? (전체밖 / 전체졸) * 100 : null;

const 중간값 = (a: number[]) => {
  if (!a.length) return null;
  const b = [...a].sort((x, y) => x - y);
  const m = b.length >> 1;
  return b.length % 2 ? b[m] : (b[m - 1] + b[m]) / 2;
};
const 가운데 = 중간값(올린곳.map((x) => x.률));
const 높은쪽 = 올린곳.slice(0, 15);
const 낮은쪽 = 올린곳.slice(-10).reverse();
const 맨위 = 올린곳[0];
const 맨아래 = 올린곳[올린곳.length - 1];

/* 시·도로 다시 묶는다 — 위에서 문턱을 넘은 곳만이 아니라 모든 곳을 더한다 */
const 시도셈 = new Map<string, { 졸: number; 밖: number }>();
for (const x of 모든곳) {
  const v = 시도셈.get(x.시도) ?? { 졸: 0, 밖: 0 };
  v.졸 += x.졸; v.밖 += x.밖;
  시도셈.set(x.시도, v);
}
const 시도들 = [...시도셈.entries()]
  .map(([이름, v]) => ({ 이름, ...v, 률: v.졸 ? (v.밖 / v.졸) * 100 : 0 }))
  .sort((a, b) => b.률 - a.률);

const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 률 = (n: number | null | undefined) => (n == null ? '—' : `${n.toFixed(1)}%`);
const 지역링크 = (열쇠: string) => (슬러그표.get(열쇠) ? `/report/area/${슬러그표.get(열쇠)}` : null);

const TITLE = `재수생 비율 지역별 — 시군구 ${올린곳.length}곳, ${맨위.이름} ${률(맨위.률)}`;
const desc =
  `재수생 비율 지역별 통계. 일반고·자율고 졸업생 가운데 대학에 바로 가지 않은 비율(재수 등)을 ` +
  `시군구 ${올린곳.length}곳으로 갈랐습니다. ${맨위.시도} ${맨위.이름} ${률(맨위.률)}부터 ` +
  `${맨아래.시도} ${맨아래.이름} ${률(맨아래.률)}까지이고 가운데값은 ${률(가운데)}입니다. ` +
  `학교알리미 ${자료.출처.공시연도}년 공시.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '재수생 비율 지역별 — 시군구별 일반고·자율고 졸업생 대학 미진학 비율',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
    license: 'https://www.kogl.or.kr/info/licenseType1.do',
    spatialCoverage: '대한민국 시·군·구',
    variableMeasured: ['졸업자', '대학 미진학자(그 밖)', '대학 미진학 비율'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '재수생이 많은 지역은 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `일반고·자율고 졸업생 가운데 대학에 바로 가지 않은 비율로 보면 ${높은쪽.slice(0, 5).map((x) => `${x.시도} ${x.이름} ${률(x.률)}`).join(', ')} 순입니다. 이 칸에는 재수 말고도 취업·미상이 함께 들어 있어 재수생만의 비율은 아닙니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '재수생 비율이 시도별로 얼마나 다른가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${시도들.map((x) => `${x.이름} ${률(x.률)}`).join(', ')}입니다(일반고·자율고 졸업자 기준).`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>재수생 비율 지역별,<br class="pcbr" /> 시군구 {올린곳.length}곳</h1>
  <p class="sub">
    고3 졸업생 가운데 <strong>대학에 바로 가지 않은 사람</strong>이 동네마다 얼마나 다를까요?
    학교알리미 {자료.출처.공시연도}년 공시의 졸업생 진로를 일반고·자율고만 골라 시군구로
    더했습니다. 수능(11월 19일)을 앞두고 「우리 동네는 재수가 많나」에 숫자로 답하는 페이지입니다.
  </p>

  <div class="answer">
    <p class="answer-label">대학에 바로 가지 않은 비율 — 시군구 {올린곳.length}곳</p>
    <p class="answer-num">{률(맨아래.률)} ~ {률(맨위.률)}</p>
    <p class="answer-sub">
      가운데값 {률(가운데)} · 전체 {수(전체졸)}명 가운데 {수(전체밖)}명({률(전체률)})
    </p>
  </div>

  <p>
    ⚠ <strong>재수생만 센 수가 아닙니다.</strong> 공시는 졸업생을 「진학」과 「그 밖」으로만
    가르고, 「그 밖」에는 재수·취업·미상이 한 칸에 들어 있습니다. 그래서 취업이 목적인
    특성화고와 종류가 다른 특목고는 빼고, <strong>대학 진학을 주로 하는 일반고·자율고</strong>만
    셌습니다. 그래도 이 칸의 전부가 재수생이라고 단정하지 않습니다.
  </p>

  <h2>재수생 비율이 높은 시군구 15곳</h2>
  <p>
    졸업자 {수(문턱)}명 이상인 {올린곳.length}곳 가운데입니다. 졸업자가 적으면 한두 사람이 비율을
    크게 흔들어 선을 그었습니다 — 선에 못 미친 {못올린곳}곳은 표에서 뺐고 아래 전체 셈에는 넣었습니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>졸업자</th><th>바로 안 간 비율</th></tr></thead>
      <tbody>
        {높은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.곳}곳</td>
            <td class="num">{수(x.졸)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    15곳 가운데 <strong>{높은쪽.filter((x) => x.시도 === '서울특별시').length}곳이 서울</strong>입니다.
    {맨위.이름}는 졸업생 {수(맨위.졸)}명 가운데 {수(맨위.밖)}명, 거의 <strong>둘 중 한 명</strong>이
    졸업한 해에 대학에 등록하지 않았습니다.
  </p>

  <h2>재수생 비율이 낮은 시군구 10곳</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>졸업자</th><th>바로 안 간 비율</th></tr></thead>
      <tbody>
        {낮은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.곳}곳</td>
            <td class="num">{수(x.졸)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>시도별 재수생 비율</h2>
  <p>같은 셈을 시·도로 묶었습니다. 일반고·자율고 졸업자 전체를 더한 값입니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>졸업자</th><th>바로 안 간 사람</th><th>비율</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.졸)}명</td>
            <td class="num">{수(x.밖)}명</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    수능 지원자 쪽에서 본 N수생 비율은 <a href="/n-su-ratio-by-province">시도별 N수생 비율</a>에
    따로 있습니다 — 두 자료가 같은 방향을 가리키는지 맞대어 볼 수 있습니다.
  </p>

  <h2>이 숫자를 어떻게 읽어야 하나</h2>
  <ul>
    <li><strong>높다고 나쁜 동네가 아닙니다.</strong> 한 해 더 준비하는 쪽을 고른 사람이 많으면
      이 수는 올라갑니다. 그것이 «못 갔다»인지 «안 갔다»인지는 이 자료로 가를 수 없습니다.</li>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 같은 동네, 같은 학교 안에서도 사람마다
      길이 다릅니다.</li>
    <li>학교가 있는 곳으로 셌습니다. 학생이 사는 곳과 다를 수 있습니다.</li>
    <li>재수생 비율 지역별 차이가 왜 생기는지 — 사교육·소득·학교 구성 — 는 이 자료로 재지
      않았습니다. 재지 않은 것을 이유로 적지 않습니다.</li>
  </ul>

  <h2>우리 동네 고등학교를 한 장에</h2>
  <p>
    시군구마다 고등학교 진학률을 학교별로 모은 페이지가 있습니다 — 위 표의 지역 이름을 누르거나{' '}
    <a href="/region">지역 목록</a>에서 고르십시오. 학교 하나하나의 숫자는{' '}
    <a href="/school-progression-rank">고등학교 진학률 순위</a>에 있습니다.
  </p>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    <strong>졸업생 진로</strong> — {자료.출처.이름} {자료.출처.공시연도}년 공시 ·{' '}
    {자료.출처.이용허락범위} · 저희가 받은 날 {자료.통계.받은때}
  </p>
  <p class="note">
    <strong>학교 목록·종류·주소</strong> — NEIS 교육정보 개방 포털
  </p>
  <p class="note">
    ⚠ 사람 수는 공시된 값이고, <strong>시군구로 더한 것과 비율은 저희가 낸 것</strong>입니다.
    진학률 숫자가 든 학교만 셌습니다(공시 2,380곳 가운데 {수((자료.자료 as any[]).filter((r) => typeof r.진학률 === 'number').length)}곳).
  </p>

  <NextQuestionBrief 모은것="학교알리미 졸업생 진로 공시를 시군구로 더한 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
