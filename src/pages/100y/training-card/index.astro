---
/**
 * /100y/training-card — 국민내일배움카드로 지금 배울 수 있는 과정, 지역별로 몇 개
 *
 * 사장님 지시(2026-08-26) — 「내일배움카드로 거의 무료로 배울 수 있는 과정도 잘
 * 분류해서 평생교육과 함께 서비스」. scripts/collect-100y-training-card.mjs 로 실측.
 *
 * ⛔ 15만 건이 넘어 한 장에 못 나열한다 — 지역별 «개수»만 우리가 재고, 실제로 과정을
 *   찾아 신청하는 건 work24 자체 검색으로 내보낸다(아웃링크). 짐작한 딥링크를 안 만든다
 *   — 확인 안 된 URL 형식으로 링크를 걸었다가 깨지는 것보다, 검색 화면 하나로 보내는
 *   편이 안전하다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/training-card.json';

const 자료 = 원본 as any;
const 지역목록 = (Object.keys(자료.지역별) as string[])
  .map((이름) => ({ 이름, 수: 자료.지역별[이름] as number | null }))
  .sort((a, b) => a.이름.localeCompare(b.이름, 'ko'));

const desc =
  `국민내일배움카드(고용24) 훈련과정 중 오늘부터 6개월 안에 시작하는 과정이 전국 ` +
  `${자료.전국.toLocaleString()}개입니다. 지역별로 몇 개인지 정리했습니다 — 국비 지원 직업훈련입니다.`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '국민내일배움카드 훈련과정',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${자료.받은날.slice(0, 4)}년 ${자료.받은날.slice(4, 6)}월 기준, 국민내일배움카드로 참여할 수 있는 훈련과정이 오늘부터 6개월 안에 시작하는 것만 전국 ${자료.전국.toLocaleString()}개입니다(고용24). 대부분 국비 지원으로 거의 무료로 들을 수 있습니다.`,
      },
    },
  ],
};
---

<HundredYear title={`국민내일배움카드 훈련과정 — 전국 ${자료.전국.toLocaleString()}개(6개월 안 시작)`} description={desc} jsonLd={faqJsonLd}>
  <h1>내일배움카드로<br />지금 뭘 배울 수 있을까요?</h1>
  <p class="sub">
    <strong>오늘부터 6개월 안에 시작하는 훈련과정이 전국 {자료.전국.toLocaleString()}개</strong>입니다.
    {' '}대부분 국비 지원 — 학원비가 아니라 <strong>공교육</strong>입니다.
  </p>

  <p class="note">
    ⚠ 국민내일배움카드가 있으면 자비부담이 적거나 없는 경우가 많습니다. 다만 과정마다
    자비부담률·정원·자격조건이 달라 <strong>직접 확인하셔야 합니다.</strong> 여기서는
    지역별로 몇 개나 있는지까지만 보여드립니다.
  </p>

  <div class="answer">
    <p class="answer-label">전국, 오늘부터 6개월 안에 시작하는 훈련과정</p>
    <p class="answer-num">{자료.전국.toLocaleString()}개</p>
  </div>

  <h2>지역별로 몇 개</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>훈련과정 수</th></tr></thead>
      <tbody>
        {지역목록.map((r) => (
          <tr>
            <td>{r.이름}</td>
            <td>{r.수 == null ? '못 잼' : `${r.수.toLocaleString()}개`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    ⚠ 「광주·전남」은 하나로 묶여 있습니다 — 고용24 시스템 자체가 광주광역시·전라남도를
    가르지 않고 합쳐서 줍니다. 국민연금 수급현황(<a href="/pension">/pension</a>)에서도
    같은 모양을 겪었습니다.
  </p>

  <p>
    <a href="https://www.work24.go.kr/hr/a/a/1100/trnnCrsInf.do" target="_blank" rel="noopener nofollow">
      고용24에서 직접 검색하기 →
    </a>
  </p>

  <p class="note">
    출처 — {자료.출처}. 받은 날 {자료.받은날.slice(0, 4)}-{자료.받은날.slice(4, 6)}-{자료.받은날.slice(6, 8)}.
    조회기간 {자료.조회기간.시작}~{자료.조회기간.끝}({자료.조회기간.뜻}).
  </p>

  <h2>자주 묻는 말</h2>
  {faqJsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    <a href="/polytech">← 제2의 인생, 폴리텍대학에서 배울 수 있는 것</a>
    <br />
    <a href="/pension">← 국민연금, 내 나이·내 지역 사람들은 얼마 받을까요?</a>
    <br />
    <a href="/lifelong">← 나이대별로 몇 %가 계속 배우고 있을까요?</a>
    <br />
    <a href="/ages">← 나이로 보는 문 — 0세부터 100세까지 한 자리에</a>
  </p>

  <HundredAgeWalk 키="training-card" />
  <NextQuestionBrief 모은것="국민내일배움카드 훈련과정 자료" />
</HundredYear>
