---
/**
 * /100y/age — 나이로 보기
 *
 * 왜 만드나 — 사장님 8/7: 「**8/15 오픈 때 폭넓은 나이대도 일부 보여주자**」
 *   우리 지면은 열아홉에서 끝나 있었다. 로고 밑줄은 「대학 다음까지」인데 대학 다음이 없었다.
 *
 * ⛔ 나이를 줄세우지 않는다. 어느 나이가 나은 나이라는 말은 우리가 할 말이 아니다.
 * ⚠ 오픈에는 다섯 자리만 낸다. 되는지 보고 넓힌다 — 다섯 장이 틀리면 다섯 배로 되돌린다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredCardnews from '../../../components/HundredCardnews.astro';
import { href } from '../../../lib/hundredyear';
import 원본 from '../../../data/100yearmap/age-axis.json';
/* 🔴 나이띠별 자격 응시·합격 — build-100y-qual-age.mjs 가 만든다.
   사장님 「왜 자꾸 대입에 머물러있니」. 이 표가 **위쪽 나이를 연다** */
import 자격나이 from '../../../data/100yearmap/qual-age.json';
/* 🔴 8/20 예약분 — 카드가 이 지면을 대는데 지면에 그 수가 없었다(콘텐트 검사자가 잡았다) */
import 사업장 from '../../../data/100yearmap/business-lifespan.json';
import { 나이말, 임금값, 혼인누적, 임금꼭대기, type 나이자료 } from '../../../lib/age-page';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';

const 자료 = 원본 as unknown as 나이자료;
const 낼나이 = [25, 32, 40, 55, 68];
const 꼭대기 = 임금꼭대기(자료);

const 줄들 = 낼나이.map((나이) => {
  const 일 = 임금값(자료, 나이);
  const 누적 = 혼인누적(자료, 나이);
  const 한마디: Record<number, string> = {
    25: `초혼을 마친 사람이 남자 ${누적?.남편}%입니다 — 백에 셋입니다`,
    32: `처음 결혼하는 사람이 가장 많은 나이입니다`,
    40: `월급이 아직 오르는 중입니다. 꼭대기는 ${꼭대기?.띠말}입니다`,
    55: `근속 ${자료.임금['55 ~ 59'].근속년}년 — 가장 오래 다닌 자리입니다`,
    68: `월급여가 스물다섯 언저리와 같은 자리로 돌아옵니다`,
  };
  return { 나이, 월급: 일?.월급, 띠: 일?.띠말, 한마디: 한마디[나이] };
});

/**
 * 🔴 2026-08-16 — 숏영상 두 편(빚·월급꼭대기)이 쓰는 수가 **이 지면에 없었다.**
 *   나이대별 근속년(2.3·6.3·9.7·6.4년)과 빚 한가운데(7,000·10,732·11,000·7,500·5,000만원)다.
 *   우리 규칙은 「화면에 뜨는 수는 전부 그 수가 있는 지면을 댈 수 있어야 한다」인데
 *   영상이 먼저 나가고 지면이 뒤따르지 않았다. 개봉 카드에서 겪은 것과 같은 종류다.
 *   ⇒ 영상이 대는 표를 여기에 싣는다.
 *
 * ⛔ 자료(age-axis.json)가 못박아 둔 것 — *「중앙값을 지면에 실을 때는 _가진집비율 을
 *   반드시 같이 적는다. 29세 이하 부채는 50.2% 만 해당한다」*. 그래서 «빚 있는 집» 칸을 함께 낸다.
 * ⛔ 두 표는 **분모가 다르다** — 임금은 사람, 살림은 가구다. 한 줄에 섞지 않고 표를 나눈다.
 */
const 임금줄 = Object.entries(자료.임금)
  .filter(([띠]) => 띠 !== '전체')
  .map(([띠, v]: any) => ({ 띠, 월급만원: Math.round(v.월급여천원 / 10), 근속년: v.근속년 }));

/**
 * 🔴 나이띠별 자격 — «비율을 낼 수 있는» 띠만 낸다(응시 30건 미만은 자료가 비워 둔다).
 * ⛔ 「미상」 띠는 사람이 아니라 자료의 빈칸이라 표에서 뺀다. 뺐다는 것은 아래에 적는다.
 */
const 자격줄 = (자격나이 as any).나이.filter((r: any) => r.나이 !== '미상' && r.비율을_낼_수_있나);
const 자격뺀띠 = (자격나이 as any).나이.filter((r: any) => r.나이 === '미상' || !r.비율을_낼_수_있나);
const 예순위 = 자격줄.filter((r: any) => /^(6\d|65세)/.test(r.나이));
const 예순위응시 = 예순위.reduce((a: number, r: any) => a + r.응시, 0);
const 예순위합격 = 예순위.reduce((a: number, r: any) => a + r.합격, 0);
/* ⚠ 카드뉴스가 「쉰 넘어 본 것이 18.9%」를 쓰는데 지면에 그 수가 없었다.
   콘텐트 검사자가 만들자마자 잡아 줬다 — 그래서 지면에도 낸다 */
const 온응시 = 자격줄.reduce((a: number, r: any) => a + r.응시, 0);
const 쉰위몫 = Number(
  ((자격줄.filter((r: any) => /^(5\d|6\d|65세)/.test(r.나이)).reduce((a: number, r: any) => a + r.응시, 0) / 온응시) * 100).toFixed(1),
);

const 살림띠 = ['29세 이하', '30~39세', '40~49세', '50~59세', '60세 이상'];
const 살림줄 = 살림띠
  .filter((띠) => (자료 as any).살림?.[띠])
  .map((띠) => {
    const v = (자료 as any).살림[띠];
    return {
      띠,
      빚한가운데: Math.round(v.부채_보유가구중앙),
      빚있는집: Math.round(v.부채_가진집비율 * 10) / 10,
    };
  });

const desc =
  '스물다섯·서른둘·마흔·쉰다섯·예순여덟 — 그 나이의 사람들이 실제로 어떻게 살고 있는지 ' +
  '국가 통계로만 모았습니다. 월급여·근속·초혼·자산·부채를 나이로 놓았습니다. 조언하지 않습니다.';
---

<HundredYear title="나이로 보기 — 남들은 어떻게 하고 있나" description={desc}>
  <h1>나이로 보기</h1>
  <p class="sub">
    백년지도는 열아홉에서 끝나지 않습니다.{' '}
    <strong>대학 다음의 자리</strong>를 나이로 놓았습니다.
  </p>

  <p class="note">
    ⛔ 나이를 줄세우지 않았습니다. 어느 나이가 나은 나이라는 말은 우리가 할 말이 아닙니다.
    적는 것은 <strong>「같은 나이의 사람들이 실제로 어떻게 했나」</strong>뿐입니다.
  </p>

  <ul class="ages">
    {
      줄들.map((r) => (
        <li>
          <a href={href(`/age/${r.나이}`)}>{나이말(r.나이)}</a>
          <span class="note">
            {r.한마디} · 월급여 {r.월급} <em>({r.띠} 사람 기준)</em>
          </span>
        </li>
      ))
    }
  </ul>

  <div class="warn">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong>{' '}
    가장 많은 나이가 곧 맞는 나이는 아닙니다. 늦었다거나 이르다고 말하지 않겠습니다.
    우리가 정할 자격이 없습니다.
  </div>

  <hr class="rule" />

  <h2>나이띠로 한눈에</h2>
  <p>월급여와 <strong>지금 다니는 자리에서 일한 햇수</strong>입니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>나이</th><th>월급여</th><th>근속</th></tr></thead>
      <tbody>
        {임금줄.map((r) => (
          <tr><td>{r.띠}</td><td>{r.월급만원.toLocaleString()}만원</td><td>{r.근속년}년</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    ⚠ 근속은 「그 일을 몇 년 했나」가 아니라 <strong>「지금 회사에 몇 년 다녔나」</strong>입니다.
    옮기면 다시 0부터 셉니다. 출처 — {자료.출처.임금.기관} 「{자료.출처.임금.표}」 {자료.출처.임금.해}년 ·{' '}
    {자료.출처.임금.조건}.
  </p>

  {/* 🔴 2026-08-16 — 사장님 「왜 자꾸 대입에 머물러있니」. 8/15 에 자로 재 보니
      지면 4,970장 중 4,927장(99.1%)이 대입 쪽이었다. 이 표가 **위쪽 나이를 연다** —
      예순에도 자격을 따는 사람이 몇 명인지 세어 준다. */}
  <h2>몇 살에도 자격을 따나요?</h2>
  <p>
    {(자격나이 as any).출처.기준연도}년 한 해 동안 국가기술자격 시험을 본 나이띠입니다.{' '}
    <strong>예순 넘어 본 것만 {예순위응시.toLocaleString()}건, 그중 {예순위합격.toLocaleString()}건이 붙었습니다.</strong>{' '}
    쉰을 넘겨 본 것은 전체 응시의 <strong>{쉰위몫}%</strong>입니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>나이</th><th>응시</th><th>합격</th><th>가장 많이 본 등급</th></tr></thead>
      <tbody>
        {자격줄.map((r: any) => (
          <tr>
            <td>{r.나이}</td>
            <td>{r.응시.toLocaleString()}건</td>
            <td>{r.합격.toLocaleString()}건</td>
            <td>{r.가장많이본등급 ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="warn">
    <p><strong>⛔ 합격률을 나이끼리 견주지 마십시오.</strong></p>
    <p class="note">
      나이마다 <strong>보는 등급이 다릅니다</strong> — 그래서 합격률만 놓고 「이 나이가 잘한다」로 읽으면 틀립니다.
      그래서 이 표에는 비율 대신 <strong>건수와 등급</strong>을 냈습니다.
      그리고 이것은 <strong>사람이 아니라 응시 건수</strong>입니다 — 한 사람이 세 번 봤으면 세 건입니다.
      {자격뺀띠.length > 0 && (
        <> 응시가 서른 건이 안 되거나 나이를 모르는 {자격뺀띠.length}줄은 뺐습니다.</>
      )}
    </p>
    <p class="note">
      출처 — {(자격나이 as any).출처.이름} · {(자격나이 as any).출처.기준연도}년 기준 ·{' '}
      {(자격나이 as any).출처.이용허락범위}.
    </p>
  </div>


  {/* 🔴 2026-08-20 — 카드 「직원을 두고 몇 해를 갔나」가 이 지면을 대는데 그 수가 없었다.
      ⛔ 자료가 못박은 대로 «생존율·폐업률·장사가 몇 년»으로 쓰지 않는다.
      ⛔ 이 표에는 **닫힌 곳만** 있다 — 오래 갈 곳은 아직 안 닫혀서 여기 없다 */}
  <h2>직원을 두고 몇 해를 갔나요?</h2>
  <p>
    국민연금 사업장 자격이 없어진 곳이 <strong>직원을 두고 있던 기간</strong>입니다.
    한가운데가 <strong>{(사업장 as any).전체.수명중앙값}년</strong>이고,
    한 해 안이 <strong>{(사업장 as any).전체.일년내}%</strong>,
    세 해 안이 <strong>{(사업장 as any).전체.삼년내}%</strong>입니다.
  </p>
  <div class="warn">
    <p><strong>⛔ 폐업률이 아닙니다.</strong></p>
    <p class="note">
      가입자가 0이 되면 자격이 없어집니다 — <strong>직원을 내보내고 혼자 계속하는 곳</strong>도 여기 들어옵니다.
      그리고 이 표에는 <strong>닫힌 곳만</strong> 있습니다. 오래 갈 곳은 아직 안 닫혀서 들어 있지 않습니다.
      그러니 「사업체는 보통 이만큼 간다」로 읽으시면 안 됩니다.
      {(사업장 as any).전체.닫은곳.toLocaleString()}곳을 세었습니다.
    </p>
    <p class="note">출처 — {(사업장 as any).출처.이름} · {(사업장 as any).출처.기준월} · {(사업장 as any).출처.이용허락범위}.</p>
  </div>
  <h2>빚은 얼마나 지고 있나요?</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>가구주 나이</th><th>빚 한가운데</th><th>빚이 있는 집</th></tr></thead>
      <tbody>
        {살림줄.map((r) => (
          <tr><td>{r.띠}</td><td>{r.빚한가운데.toLocaleString()}만원</td><td>{r.빚있는집}%</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="warn">
    <p><strong>🔴 「빚 한가운데」는 빚이 있는 집만 놓고 잰 값입니다.</strong></p>
    <p class="note">
      빚이 없는 집은 이 수에 아예 들어 있지 않습니다. 그래서 <strong>오른쪽 칸을 꼭 같이 보셔야 합니다</strong> —{' '}
      {살림줄[0]?.띠}는 {살림줄[0]?.빚있는집}%만 해당합니다. 「그 나이면 다들 이만큼 빚이 있다」로 읽으시면 안 됩니다.
      그리고 이 표는 <strong>사람이 아니라 가구</strong>가 단위입니다 — 위의 월급여 표와 분모가 다르니 나란히 빼지 마십시오.
    </p>
    <p class="note">
      출처 — {자료.출처.살림.기관} 「{자료.출처.살림.표}」 {자료.출처.살림.해}년 · 단위 {자료.출처.살림.단위}.
    </p>
  </div>

  {/**
    * 🔴 **층 대문 두 장으로 가는 길** (2026-08-09 03:5x · 2번 지시).
    *
    *   사장님 — **「네 층이 넘어야지 100년 산다며」**
    *   2번 — *「오픈에 네 층뿐이면 그 말이 안 섭니다」*
    *
    *   ⚠ 위의 다섯 장은 **한 살짜리**(쉰다섯·예순여덟)다. 층이 아니다.
    *     아래 둘이 **층 대문**이다 — 열 해를 한 장에 놓는다.
    *   ⛔ 걸어 두지 않으면 지면이 있어도 아무도 못 닿는다. 어제 `/region` 18장이 그랬다.
    */}
  <hr class="rule" />
  <h2>층으로 보기</h2>
  <p class="note">
    나이 한 살이 아니라 <strong>열 해를 한 장에</strong> 놓았습니다.
  </p>
  <p class="note">
    <a class="gotoarea" href={href('/life/50대')}>50대 — 쉰이 넘으면 무엇이 달라지나 →</a>
  </p>
  <p class="note">
    <a class="gotoarea" href={href('/life/60대')}>60대 — 예순이 넘으면 무엇이 달라지나 →</a>
  </p>

  <p class="note src">
    출처 — {자료.출처.혼인.기관} 「{자료.출처.혼인.표}」({자료.출처.혼인.해}) ·
    {자료.출처.임금.기관} 「{자료.출처.임금.표}」({자료.출처.임금.해}) ·
    {자료.출처.살림.기관} 「{자료.출처.살림.표}」({자료.출처.살림.해}).
    <br />
    백년지도는 지도입니다. <strong>길을 정해 주지 않고 어디에 무엇이 있는지 보여 줍니다.</strong>{' '}
    나침반은 보시는 분이 만드십니다.
  </p>  <HundredCardnews 벌="직원을둔기간" 장수={6} 머리="직원을 두고 몇 해를, 카드 여섯 장" />
  <HundredCardnews 벌="월급꼭대기" 장수={6} 머리="월급과 근속, 카드 여섯 장" />
  <HundredCardnews 벌="예순에도딴다" 장수={6} 머리="나이와 자격, 카드 여섯 장" />

  <NextQuestionBrief 모은것="나이마다 사람들이 무엇을 했는지 모은 자료" />
  {/* 🔴 2번 11:2x — 밖에서 들어온 손님은 지면 하나로 떨어진다. 여기서 옆 문이 보여야 한다 */}
  <HundredAgeWalk 키="age" />

</HundredYear>

<style>
