---
/**
 * /100y/births-by-month-2026 — **월별 출생아 2019~2026** — 26개월째 1년 전보다 증가 (축 「2026 출생 시도별」, 이슈)
 *
 * ── 왜 만들었나 (2026-10-31 · 1번) ──────────────
 * 이슈   8월 출생아 23,703명, 8월로는 2019년 이후 가장 많다(10-28 발표). 「26개월 연속 증가」가 제목마다 나왔다.
 * 축     KOSIS 월별 표로 2019년 1월부터 92개월을 한 표에 놓고, 연속 증가 개월 수와 「2019년 이후 최다」를 저희가 직접 다시 셌다.
 *
 * ⛔ 연속 증가는 «1년 전 같은 달보다 많은가»로만 센다. 전달 대비가 아니다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원 from '../../../data/100yearmap/births-2026.json';

const d = 원 as any;
const 쉼 = (n: number) => n.toLocaleString();
const M = d.전국.월 as any[];
const 찾 = (m: string) => M.find((x) => x.월 === m);
let 연속 = 0;
for (let i = M.length - 1; i >= 12; i--) { if (M[i].출생 > M[i - 12].출생) 연속++; else break; }
const 시작 = M[M.length - 연속].월;
const 해들 = ['2019', '2020', '2021', '2022', '2023', '2024', '2025', '2026'];
const 달들 = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'];
const 끝 = M.at(-1);
const 같은달 = 해들.map((y) => 찾(`${y}${끝.월.slice(4)}`)).filter(Boolean);
const 위 = 같은달.filter((x) => x.월 !== 끝.월 && x.출생 > 끝.출생);
const 해합 = (y: string) => M.filter((x) => x.월.startsWith(y)).reduce((t, x) => t + x.출생, 0);
const 올합 = 해합('2026');
const 올달 = M.filter((x) => x.월.startsWith('2026'));

const TITLE = `월별 출생아 2019~2026 — ${연속}개월째 1년 전보다 많다`;
const desc =
  `국가데이터처 월별 인구동향으로 2019년 1월부터 2026년 ${Number(끝.월.slice(4))}월까지 출생아를 한 표에 놓았습니다. ` +
  `${시작.slice(0, 4)}년 ${Number(시작.slice(4))}월부터 ${연속}개월 연속 1년 전 같은 달보다 많고, 2026년 8월 ${쉼(끝.출생)}명은 8월로는 2019년(${쉼(같은달[0].출생)}명) 다음입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '월별 출생아 수 2019년 1월~2026년 8월(전국, 2026년은 잠정)',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    temporalCoverage: '2019-01/2026-08',
    isBasedOn: 'https://kosis.kr (101/DT_1B8000G)',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: '출생아는 몇 개월째 늘고 있나요?', acceptedAnswer: { '@type': 'Answer', text: `${시작.slice(0, 4)}년 ${Number(시작.slice(4))}월부터 2026년 8월까지 ${연속}개월 연속 1년 전 같은 달보다 많습니다.` } },
      { '@type': 'Question', name: '2026년 8월 출생아는 몇 명인가요?', acceptedAnswer: { '@type': 'Answer', text: `${쉼(끝.출생)}명(잠정)입니다. 2019년 이후 8월 가운데 2019년 8월(${쉼(같은달[0].출생)}명) 다음으로 많습니다.` } },
      { '@type': 'Question', name: '2026년 월 합계출산율은 얼마인가요?', acceptedAnswer: { '@type': 'Answer', text: 올달.map((x) => `${Number(x.월.slice(4))}월 ${x.합계출산율}명`).join(', ') + '입니다(월별 잠정치).' } },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>월별 출생아 2019~2026 —<br class="pcbr" /> {연속}개월째 증가</h1>
  <p class="sub">
    「26개월 연속 증가」가 무슨 뜻인지, 92개월을 한 표에 놓고 저희가 다시 셌습니다. 1년 전 같은 달보다 많은 달이 이어진 수입니다.
  </p>

  <div class="answer">
    <p class="answer-label">2026년 8월 출생아(잠정)</p>
    <p class="answer-num">{쉼(끝.출생)}명</p>
    <p class="answer-sub">{시작.slice(0, 4)}년 {Number(시작.slice(4))}월부터 {연속}개월 연속 1년 전 같은 달보다 많음 · 8월로는 2019년 다음</p>
  </div>

  <p>
    2019년부터 8월 출생아를 늘어놓으면 {같은달.map((x) => `${x.월.slice(0, 4)}년 ${쉼(x.출생)}명`).join(' → ')}입니다.
    2023년 8월이 바닥이었고, 2026년 8월보다 많았던 8월은 {위.map((x) => x.월.slice(0, 4) + '년').join('·')} 한 번입니다.
    2026년 1~8월을 더하면 {쉼(올합)}명입니다.
  </p>

  <h2>해마다 같은 달 — 출생아 수</h2>
  {[해들.slice(0, 4), 해들.slice(4)].map((묶음) => (
    <div class="tablewrap">
      <table>
        <thead><tr><th>달</th>{묶음.map((y) => <th>{y}</th>)}</tr></thead>
        <tbody>
          {달들.map((m) => (
            <tr>
              <th>{Number(m)}월</th>
              {묶음.map((y) => { const x = 찾(`${y}${m}`); const 앞 = 찾(`${Number(y) - 1}${m}`); return <td class={`num${x && 앞 && x.출생 > 앞.출생 ? ' up' : ''}`}>{x ? 쉼(x.출생) : '—'}</td>; })}
            </tr>
          ))}
          <tr class="total"><th>한 해</th>{묶음.map((y) => <td class="num">{y === '2026' ? `${쉼(올합)}*` : 쉼(해합(y))}</td>)}</tr>
        </tbody>
      </table>
    </div>
  ))}
  <p class="note">단위 명 · 색칠한 칸은 1년 전 같은 달보다 많은 달 · — 는 아직 발표 전 · * 2026년은 1~8월만 더한 값</p>

  <h2>2026년 달마다 — 합계출산율·조출생률</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>달</th><th>출생아</th><th>합계출산율</th><th>인구 1천 명당 출생아</th></tr></thead>
      <tbody>
        {올달.map((x) => <tr><th>{Number(x.월.slice(4))}월</th><td class="num">{쉼(x.출생)}</td><td class="num">{x.합계출산율}</td><td class="num">{x.조출생률}</td></tr>)}
      </tbody>
    </table>
  </div>
  <p class="note">월 합계출산율은 그 달의 출산이 1년 내내 이어진다고 보고 연 단위로 바꾼 값이라 달마다 출렁입니다. 한 해 값과 바로 견주지 않습니다.</p>

  <h2>같은 자료로 본 다른 표</h2>
  <ul>
    <li><a href="/births-by-province-2026">2026년 1~8월 출생아 17개 시도</a></li>
    <li><a href="/marriages-by-province-2026">2026년 1~8월 혼인 시도별</a></li>
    <li><a href="/natural-decrease-by-province-2026">출생아 − 사망자 시도별</a></li>
  </ul>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 나라 전체에서 태어난 아이 수의 변화이지, 한 사람이나 한 집이 언제 아이를 가질지와는 상관이 없습니다.</li>
    <li>「연속 증가」는 1년 전 같은 달과 견준 것입니다. 전달보다 적은 달도 들어 있습니다.</li>
    <li>2026년 수는 잠정치이고 9월분은 아직 발표 전입니다. 0이 아니라 미확인입니다.</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    국가데이터처 KOSIS 「월·분기·연간 인구동향」(101/DT_1B8000G) · 「2026년 8월 인구동향」 2026-10-28 발표 · KOSIS 마지막 수정 {d.출처.KOSIS마지막수정} · 저희가 받은 때 {d.받은때}
  </p>

  <NextQuestionBrief 모은것="국가데이터처 월별 인구동향으로 2019년 1월~2026년 8월 전국 출생아를 같은 달끼리 견준 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .up { background: color-mix(in srgb, #d4a843 18%, transparent); }
  .total th, .total td { border-top: 2px solid currentColor; }
</style>
