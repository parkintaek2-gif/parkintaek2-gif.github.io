---
/**
 * /100y/vocational-high-school-by-area — **특성화고 비율 지역별** (시·도, 시·군·구)
 *
 * ── 왜 만들었나 (2026-10-24 · 1번 · 지역 × 학교 환경 축 이어서) ──────────────
 * 롱테일  「우리 동네에 특성화고가 몇 곳」에 시군구로 답하는 지면이 없었다.
 *         NEIS 학교기본정보의 고교유형 칸(일반고·특성화고·자율고·특목고)을 시군구로 센다.
 *
 * ── ⛔ 지키는 것 ────────────────────────────────────────────────────────
 * ⛔ 학생이 아니라 «학교» 수다. 지면에 밝힌다.
 * ⛔ 특성화고를 「공부 못하는 학교」로 읽히게 쓰지 않는다 — 갈래의 구분일 뿐이다.
 *   취업률·진학률은 이 지면에서 재지 않았으니 쓰지 않는다.
 * ⛔ 학교 5곳 미만인 곳은 비율 표에 올리지 않는다(한 곳이 20%p 를 흔든다).
 * ⚠ 마이스터고는 NEIS 고교유형에서 대부분 특목고로 잡힌다(이름에 «마이스터»가 든 32곳 중 28곳, 2026-10-24) — 지면에 수로 밝힌다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import schools from '../../../data/100yearmap/pages-school.json';
import { 시군구로더함, 중간값, 지역링크 } from '../../../lib/school-area-sum';

const 학교들 = (schools as any[]).filter((x) => x.종류 === '고등학교' && /^(일반고|특성화고|자율고|특목고)$/.test(String(x.고교유형 ?? '')));
const 셈 = 시군구로더함(학교들, null, (x) => ({ 분모: 1, 분자: x.고교유형 === '특성화고' ? 1 : 0 }));
const 문턱 = 5;
const 올린곳 = 셈.올린곳(문턱);
const 못올린곳 = 셈.모든곳.length - 올린곳.length;
const 가운데 = 중간값(올린곳.map((x) => x.률));
const 높은쪽 = 올린곳.slice(0, 15);
const 없는곳 = 올린곳.filter((x) => x.분자 === 0);
const 특성화 = 학교들.filter((x) => x.고교유형 === '특성화고');
const 사립특성화 = 특성화.filter((x) => x.설립 === '사립').length;
const 마이스터 = 학교들.filter((x) => /마이스터/.test(String(x.title)));
const 마이스터특목 = 마이스터.filter((x) => x.고교유형 === '특목고').length;
const 갈래수 = ['일반고', '특성화고', '자율고', '특목고'].map((g) => ({ 이름: g, 수: 학교들.filter((x) => x.고교유형 === g).length }));

const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 률 = (n: number | null | undefined) => (n == null ? '—' : `${n.toFixed(1)}%`);
const 맨위 = 셈.시도들[0];
const 맨아래 = 셈.시도들[셈.시도들.length - 1];

const TITLE = `특성화고 비율 지역별 — 고등학교 ${수(학교들.length)}곳 중 ${수(셈.전체분자)}곳, ${맨위.이름} ${률(맨위.률)}`;
const desc =
  `특성화고 비율 지역별 통계. 고등학교 ${수(학교들.length)}곳 가운데 특성화고가 ${수(셈.전체분자)}곳(${률(셈.전체률)})입니다. ` +
  `시도별로 ${맨위.이름} ${률(맨위.률)}가 가장 높고 ${맨아래.이름} ${률(맨아래.률)}가 가장 낮습니다. NEIS 학교기본정보, 시군구별.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '특성화고 비율 지역별 — 시도·시군구별 특성화고 수',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 'NEIS 교육정보 개방 포털' },
    spatialCoverage: '대한민국 시·도, 시·군·구',
    variableMeasured: ['고등학교 수', '특성화고 수', '특성화고 비율'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '특성화고가 많은 지역은 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `시도별 특성화고 비율은 ${셈.시도들.slice(0, 3).map((x) => `${x.이름} ${률(x.률)}`).join(', ')} 순으로 높습니다. 학생 수가 아니라 학교 수로 셌습니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '우리나라 특성화고는 몇 곳인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `NEIS 고교유형으로 고등학교 ${수(학교들.length)}곳 가운데 특성화고는 ${수(셈.전체분자)}곳(${률(셈.전체률)})입니다. 그 가운데 사립이 ${사립특성화}곳입니다. 이름에 «마이스터»가 든 ${마이스터.length}곳 가운데 ${마이스터특목}곳은 특목고로 분류돼 이 수에 들지 않습니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>특성화고 비율<br class="pcbr" /> 지역별로 보면</h1>
  <p class="sub">
    우리 동네에 <strong>특성화고는 몇 곳</strong>일까요? NEIS 학교기본정보의 고교유형으로 고등학교
    {수(학교들.length)}곳을 시도·시군구마다 셌습니다.
  </p>

  <div class="answer">
    <p class="answer-label">고등학교 {수(학교들.length)}곳 가운데 특성화고</p>
    <p class="answer-num">{률(셈.전체률)}</p>
    <p class="answer-sub">
      특성화고 {수(셈.전체분자)}곳(사립 {사립특성화}곳) · {맨위.이름} {률(맨위.률)} · {맨아래.이름} {률(맨아래.률)} · 시군구 가운데값 {률(가운데)}
    </p>
  </div>

  <p>
    ⚠ <strong>학생이 아니라 학교를 셌습니다.</strong> 그리고 <strong>마이스터고는 대부분 NEIS 에서 특목고로 분류</strong>돼 이 수에 들지 않습니다(이름에
    «마이스터»가 든 {마이스터.length}곳 가운데 {마이스터특목}곳). 특성화고의 취업률·진학률은 이 지면에서 재지 않았습니다.
  </p>

  <h2>시도별 특성화고 비율</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>학교</th><th>특성화고</th><th>비율</th></tr></thead>
      <tbody>
        {셈.시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{x.분모}</td>
            <td class="num">{x.분자}</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>특성화고 비율이 높은 시군구 15곳</h2>
  <p>
    고등학교 {문턱}곳 이상인 {올린곳.length}곳 가운데입니다. {문턱}곳 미만인 {못올린곳}곳은 한 곳이 비율을
    크게 흔들어 표에서 뺐습니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>학교</th><th>특성화고</th><th>비율</th></tr></thead>
      <tbody>
        {높은쪽.map((x) => (
          <tr>
            <th>{지역링크(x.열쇠) ? <a href={지역링크(x.열쇠)!}>{x.시도} {x.이름}</a> : `${x.시도} ${x.이름}`}</th>
            <td class="num">{x.분모}</td>
            <td class="num">{x.분자}</td>
            <td class="num"><strong>{률(x.률)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    고등학교 {문턱}곳 이상이면서 특성화고가 한 곳도 없는 시군구는 <strong>{없는곳.length}곳</strong>입니다.
    그 동네 학생이 특성화고에 가려면 다른 시군구로 다녀야 할 수 있습니다.
  </p>

  <h2>고교유형별 학교 수</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>갈래</th><th>학교</th></tr></thead>
      <tbody>
        {갈래수.map((x) => (
          <tr><th>{x.이름}</th><td class="num">{수(x.수)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>이 숫자를 어떻게 읽어야 하나</h2>
  <ul>
    <li><strong>일반고가 낫다, 특성화고가 낫다를 말하지 않습니다.</strong> 동네마다 고를 수 있는 학교가 어떻게
      놓여 있는지를 보여 줄 뿐입니다.</li>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong></li>
    <li>특성화고는 시도 단위로 학생을 모으는 곳이 많아, 다른 시군구 학생도 다닙니다.</li>
    <li>학교가 지금 있는 주소로 셌습니다.</li>
  </ul>

  <h2>같은 축의 다른 지면</h2>
  <ul>
    <li><a href="/private-high-school-by-area">사립 고등학교 비율 지역별</a></li>
    <li><a href="/special-purpose-high-school-by-area">특목고·자율고 지역별</a></li>
    <li><a href="/coed-school-by-area">남녀공학 고등학교 비율 지역별</a></li>
    <li><a href="/university-rate-by-area">4년제 대학 진학률 지역별</a></li>
    <li><a href="/century-old-high-schools-by-area">설립 100년 넘은 고등학교 지역별</a></li>
    <li>우리 동네 고등학교 한 장 — <a href="/region">지역 목록</a>에서 고르십시오</li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    <strong>학교 목록·고교유형·주소</strong> — NEIS 교육정보 개방 포털 학교기본정보 ·
    저희가 받은 때 {(schools as any[])[0]?.기준시각?.slice(0, 10)}
  </p>
  <p class="note">⚠ 고교유형은 NEIS 값 그대로이고, <strong>시군구로 센 것과 비율은 저희가 낸 것</strong>입니다.</p>

  <NextQuestionBrief 모은것="NEIS 학교기본정보의 고교유형을 시군구로 센 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
