---
/**
 * 백년지도 (百年地圖) — P0 첫 화면. 스토리보드 §2 규격.
 *
 * 목적은 **하나**다 — 「이 학과 나오면 어떻게 됐나」를 3초 안에 검색하게 만든다.
 *   회사 소개가 아니다. **도구가 먼저 보여야 한다.**
 *   그래서 검색창이 첫 화면 안에 있고, 회사 이야기는 스크롤 아래로 내렸다.
 *
 * 지켜야 할 것 (스토리보드 §2)
 *   · 가입 유도 배너를 첫 화면에 두지 않는다. 도구를 쓰고 나서 권한다
 *   · 광고를 첫 화면에 넣지 않는다. 신뢰가 먼저다
 *   · 검색창은 JS 없이도 동작한다 — form submit 으로 학과 목록에 간다
 *
 * ⚠ 예전 푸터가 **쓰지도 않는 출처**를 적고 있었다 (커리어넷·대학알리미·KEDI).
 *   커리어넷은 승인 대기, 대학알리미는 미신청, KESS 는 수집을 접었다.
 *   지금 실제로 쓰는 것은 **NEIS 와 KOSIS 둘뿐**이다. 그대로 적는다.
 *   ⛔ 아직 안 쓰는 출처를 적어 두는 것은, 있지도 않은 근거를 대는 것이다.
 */
import HundredYear from '../../layouts/HundredYear.astro';
import { href } from '../../lib/hundredyear';
import majors from '../../data/100yearmap/pages-major.json';
import schools from '../../data/100yearmap/pages-school.json';
import universities from '../../data/100yearmap/pages-university.json';
import 연구 from '../../data/100yearmap/pages-research.json';

const 학과수 = (majors as any[]).length;
const 학교수 = (schools as any[]).length;
const 대학수 = (universities as any[]).length;
/** ⚠ 377 곳 전부가 아니다. **취업률을 실제로 셀 수 있는 곳**만 센다 —
 *  수치가 아예 없는 곳(48)과 취업대상자가 0명이라 비율이 안 만들어지는 곳(10)을 뺀다.
 *  `/after` 지면이 세는 수와 **같은 수여야 한다.** 다르면 둘 중 하나가 거짓말이 된다. */
const 셀수있는대학 = (universities as any[]).filter((u) => u.취업률 && u.취업대상자 !== 0).length;
const 연구수 = ((연구 as any).자료 as any[]).length;

/** 칩에 넣을 학과. ⛔ 「인기 순위」가 아니다 — **계열을 골고루** 섞어 고른 예시다.
 *  개설 학교가 많은 순으로 놓으면 그 줄 자체가 순위표가 된다. */
const CHIPS = ['조리과', '자동차과', '보건간호과', '반도체과', '디자인과', '회계정보과', '항공과', '애완동물과'];
const 칩 = CHIPS.map((name) => (majors as any[]).find((m) => m.title === name)).filter(Boolean);

/** 첫 화면에 쓸 실제 수치 — 이 서비스가 존재하는 이유가 이 한 줄에 있다 */
const 표본 = (majors as any[]).find((m) => m.취업)?.취업;
const 전체 = 표본?.전체평균;

const DESC =
  '고등학교 학과별로, 그 길로 간 사람들이 졸업 뒤에 실제로 어떻게 됐는지 공공데이터로 보여줍니다. ' +
  '무료이고 가입도 필요 없습니다. 학원을 팔지 않습니다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '백년지도',
  alternateName: '百年地圖',
  description: DESC,
  inLanguage: 'ko',
};
---

<HundredYear title="대학 다음까지 보는 진로 지도" description={DESC} jsonLd={jsonLd}>
  {/* ⭐ 브랜드 표 — 사장님 지시(2026-08-05): 「백년대계, 백년지도 · **가운데에 교육**」
      왼쪽에 물음(백년대계), 가운데에 그 대상(교육), 오른쪽에 우리가 하는 일(백년지도).
      ⚠ 로고 그림을 쓰지 않는다. 글자만으로 세운다 —
        이미지가 안 뜨는 자리(메일·요약·저사양)에서도 브랜드가 살아 있어야 한다. */}
  <div class="brand">
    <div class="brand-cell">
      <span class="ko">백년대계</span>
      <span class="hanja">百年大計</span>
    </div>
    <div class="brand-cell mid">
      <span class="ko">교육</span>
      <span class="hanja">敎育</span>
    </div>
    <div class="brand-cell">
      <span class="ko">백년지도</span>
      <span class="hanja">百年之圖</span>
    </div>
  </div>
  <p class="brand-line">
    교육은 <strong>백년대계</strong>입니다.<br class="pcbr" /> 그 백 년을 그리는 것이 <strong>백년지도</strong>입니다.
  </p>

  {/* ⚠ 줄바꿈을 넣지 않는다 (사장님 지시 2026-08-05) — 한 줄로 읽힌다.
      좁은 화면에서는 브라우저가 알아서 접는다. `word-break: keep-all` 이 낱말은 안 쪼갠다. */}
  <h1>대학은 100년 중 한 점일뿐 입니다.</h1>
  <p class="lead">그 길로 간 사람들이 졸업하고 나서 실제로 어떻게 됐는지 보여드립니다.</p>

  {/* ⭐ 도구가 먼저. JS 없이도 눌리면 학과 목록으로 간다 */}
  <form class="search" action="/major" method="get" role="search">
    <input
      type="search"
      name="q"
      placeholder="학과 이름을 넣으세요 (예: 조리과)"
      aria-label="학과 이름으로 찾기"
      autocomplete="off"
    />
    <button type="submit">찾기</button>
  </form>

  <ul class="chips">
    {칩.map((m: any) => <li><a href={href(m.url)}>{m.title}</a></li>)}
  </ul>

  <p class="free">
    <strong>무료입니다. 가입도 필요 없습니다.</strong><br />
    <span class="note">고등학교 {학교수.toLocaleString()}곳 · 학과 {학과수.toLocaleString()}개</span>
  </p>

  <hr class="rule" />

  {/* 여기부터는 스크롤 아래. 이미 검증된 카피라 그대로 살린다 */}
  <h2>어른들은 「이 과에 가라」고 말합니다.<br class="pcbr" /> 가서 어떻게 됐는지는 아무도 안 봅니다.</h2>
  {
    전체 && (
      <p>
        직업계고를 졸업하고 취업한 사람 가운데 <strong>1년 뒤에도 그 자리에 남아 있는 비율은{' '}
        {전체['1차유지취업률']}%</strong>, 2년 뒤에는 <strong>{전체['2차유지취업률']}%</strong>입니다.
        1년 사이에 {(전체['1차유지취업률'] - 전체['2차유지취업률']).toFixed(1)}%p 가 사라집니다.
        「취업률 ○○%」로 끝나는 발표는 이 뒤에 벌어지는 일을 보여주지 않습니다.
      </p>
    )
  }
  <p class="note">
    {표본?.기준연도}년 · 국가데이터처 KOSIS 「직업계고 졸업자 취업통계」 · 졸업자{' '}
    {전체?.졸업자?.toLocaleString()}명
  </p>

  <h2>우리는 학원을 팔지 않습니다.<br class="pcbr" /> 그래서 안 다녀도 된다고 말할 수 있습니다.</h2>
  <p class="note">
    한국의 진로 조언은 대부분 무언가를 파는 사람에게서 나옵니다. 조언과 판매가 같은 주머니에
    있으면 조언이 휘어집니다.
  </p>

  <div class="tablewrap">
    <table>
      <thead><tr><th></th><th>지금</th><th>백년지도</th></tr></thead>
      <tbody>
        <tr><td>보는 시간</td><td>대학까지</td><td><strong>대학 이후 수십 년</strong></td></tr>
        {/* ⚠ 2026-08-06 사장님 지시 — 「어제의 자기」→「어제의 나 자신」.
            「자기」는 3인칭으로 읽혀 남 이야기가 된다. 읽는 사람이 자기 이야기로 받아야 한다. */}
        <tr><td>비교 대상</td><td>등수(성적)</td><td><strong>어제의 나 자신</strong></td></tr>
        {/* ⚠ 2026-08-06 사장님 지시 — 꺾쇠를 빼고 「대학 가면」→「대학에 가면」으로.
            표 안에서는 꺾쇠가 인용이 아니라 장식으로 읽힌다. 조사도 빠져 있었다. */}
        <tr><td>정보</td><td>이 대학에 가면 된다</td><td><strong>가서 실제로 어떻게 됐나</strong></td></tr>
        <tr><td>정하는 사람</td><td>부모·학원</td><td><strong>아이가 정하고 어른은 경청·조언</strong></td></tr>
      </tbody>
    </table>
  </div>

  <hr class="rule" />

  <h2>지금 열려 있는 것</h2>
  <p class="note">
    학과·학교 조회를 <strong>먼저 무료로</strong> 엽니다. 회원가입 없이 쓰실 수 있습니다.
    적성 진단과 상담은 <strong>보호자와 함께</strong> 쓰는 것을 원칙으로 합니다 —
    아이가 혼자 AI 와 대화하는 경로는 만들지 않습니다.
  </p>
  <p class="note">
    <a href="/major">학과 {학과수.toLocaleString()}개 전부 보기 →</a>
  </p>

  {/* 🔴 사장님 지시(2026-08-06) — 「대학 다음이 제일 중요」. 첫 화면에서 바로 들어가게 한다 */}
  <h2>대학에 간 다음이<br class="pcbr" /> 궁금하실 겁니다.</h2>
  <p class="note">
    어디에 합격했는지까지는 어디서나 알려줍니다. <strong>그 다음은 아무도 안 봅니다.</strong>
    대학·전문대학 {셀수있는대학.toLocaleString()}곳이 졸업생을 어디로 보냈는지,
    들어간 다음 얼마나 떠났는지를 <strong>등수 없이 분포로</strong> 모았습니다.
  </p>
  <p class="note">
    <a href="/after">대학 이후 보기 →</a>
  </p>

  {/* ⭐ 숫자 다음에 오는 질문은 「왜 그렇게 되나」다. 그건 우리가 못 쓴다 — 가리키기만 한다 */}
  <h2>왜 그렇게 되는지는<br class="pcbr" /> 저희가 쓰지 않았습니다.</h2>
  <p class="note">
    그 답은 이미 쓰여 있습니다. 국책연구원이 세금으로 썼는데 찾기가 어려워 읽히지 않습니다.
    사교육 의존, 학군 배정, 세대 간 교육이동성 같은 것을 다룬
    <strong>한국개발연구원(KDI) 연구 {연구수}편</strong>을 골라 두었습니다.
  </p>
  <p class="note">
    <a href="/research">국책연구가 다룬 것 보기 →</a>
  </p>

  <h2>어디서 가져온 숫자인가?</h2>
  <p class="note">
    <strong>교육부 NEIS 교육정보 개방 포털</strong> — 전국 고등학교와 개설 학과<br />
    <strong>국가데이터처 KOSIS · 교육부 「직업계고 졸업자 취업통계」</strong> — 유지취업률<br />
    <strong>한국대학교육협의회 대학알리미</strong> — 대학 {대학수}곳의 취업률·중도탈락률<br />
    <strong>한국개발연구원(KDI)</strong> — 교육·노동 연구 목록<br />
    출처와 기준연도를 페이지마다 함께 적습니다. 계열 구분처럼 <strong>저희가 추정한 것</strong>은
    추정이라고 밝힙니다.
  </p>
  <p class="note">
    ⚠ 지금 보여드리는 고등학교 취업 수치는 <strong>학교유형·계열 단위</strong>입니다. 학과 하나하나의
    공식 수치는 아직 공개되지 않습니다.
  </p>
</HundredYear>

<style>
  /* ─────────────────────────────────────────────────────────
     브랜드 표 — 百年大計 · 敎育 · 百年之圖
     ⭐ 가운데(교육)만 **다른 서체·다른 색**이다 (사장님 지시 2026-08-05).
        양옆은 세리프 · 흐린 색으로 물러나고, 가운데는 산세리프 · 금색으로 나선다.
        같은 서체에서 색만 바꾸면 「강조」로 보이고, 서체가 갈리면 「다른 것」으로 보인다.
        교육은 우리가 다루는 대상이지 우리 주장이 아니라서, 그 자리를 따로 세운다.
     ⚠ 로고 이미지가 아니다. 글자만으로 만든다 — 이미지가 안 뜨는 자리에서도 살아 있어야 한다.
     ───────────────────────────────────────────────────────── */
  .brand {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.6rem, 4vw, 1.6rem);
    margin: 0.5rem 0 0.9rem;
    padding: clamp(0.9rem, 4vw, 1.4rem) 0.6rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .brand-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
  }
  /* ⭐ 2026-08-05 사장님 지시 — **한글이 위, 한자가 아래.** 크기도 맞바꿨다.
     읽는 사람은 학부모와 아이다. 한자를 크게 세우면 읽기 전에 물러선다.
     한자는 뜻을 받쳐 주는 자리로 내리고, 앞에 서는 것은 한글이다. */

  /* 양옆 — 세리프, 물러선 색 */
  .brand-cell .ko {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(15px, 4.6vw, 22px);
    letter-spacing: 0.02em;
    color: var(--muted);
    white-space: nowrap;
  }
  .brand-cell .hanja {
    font-family: var(--serif);
    font-size: clamp(10px, 2.6vw, 12px);
    letter-spacing: 0.22em;
    color: var(--faint);
    margin-top: 0.35rem;
    white-space: nowrap;
    text-indent: 0.22em; /* 자간 때문에 오른쪽으로 쏠리는 것을 되돌린다 */
  }
  /* ⭐ 가운데 「교육」 — 서체가 다르고 색이 다르다 */
  .brand-cell.mid {
    padding: 0 clamp(0.5rem, 3vw, 1.2rem);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .brand-cell.mid .ko {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(21px, 6.4vw, 32px);
    letter-spacing: 0.14em;
    color: var(--gold);
    text-indent: 0.14em;
  }
  .brand-cell.mid .hanja {
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(10px, 2.8vw, 12px);
    letter-spacing: 0.3em;
    color: var(--gold-text);
    text-indent: 0.3em;
  }
  .brand-line {
    font-size: var(--fs-note);
    color: var(--muted);
    text-align: center;
    margin: 0 0 2rem;
  }
  .brand-line strong { color: var(--gold-pale); }

  .lead {
    font-size: var(--fs-body);
    color: var(--muted);
    margin: 0 0 1.5rem;
  }

  /* ⭐ 검색창 — 첫 화면 안에 있어야 한다. 높이 52px (스토리보드 §2) */
  .search {
    display: flex;
    gap: 0.4rem;
    margin: 0 0 0.8rem;
  }
  .search input {
    flex: 1 1 auto;
    min-width: 0;
    height: 52px;
    padding: 0 0.9rem;
    font-size: var(--fs-body);
    font-family: inherit;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
  }
  .search input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .search button {
    flex: 0 0 auto;
    height: 52px;
    padding: 0 1.1rem;
    font-size: var(--fs-body);
    font-family: inherit;
    font-weight: 600;
    color: #1a1300;
    background: linear-gradient(135deg, var(--gold), var(--gold-deep));
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--fs-note);
    text-decoration: none;
  }

  .free {
    margin: 0 0 0.5rem;
  }
  td:first-child {
    color: var(--muted);
    width: 7rem;
  }
  strong {
    color: var(--accent);
  }
  h2 strong,
  .free strong {
    color: inherit;
  }
</style>
