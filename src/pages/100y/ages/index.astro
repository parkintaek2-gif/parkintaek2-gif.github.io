---
/**
 * /100y/ages — 나이로 보는 문
 *
 * 🔴 2번 지시(8/21 06:2x) — 「지금은 여덟 장이 **서로 모릅니다.** 밖에서 한 장에 들어온 손님이
 *   그 한 장만 보고 나갑니다. 들어오게 하는 것과 **머물게 하는 것**은 다른 일입니다」
 *   사장님이 매기신 자리가 「9월에 검색으로 하루 1,000명」이다.
 *
 * ⛔ 카드에 적는 것은 **꾸민 말이 아니라 그 지면이 실제로 쥔 수**다.
 *   그래서 각 자료 json 에서 직접 읽어 온다 — 손으로 박으면 자료가 바뀔 때 여기만 옛 수로 남는다.
 * ⛔ 「몇 해치가 있나」를 카드마다 적는다. 오늘 내가 두 번 미끄러진 자리다(세 해만 받고 흐름을 못 봤다).
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 어린이집 from '../../../data/100yearmap/nursery-none.json';
import 유치원 from '../../../data/100yearmap/kindergarten.json';
import 방과후 from '../../../data/100yearmap/afterschool.json';
import 소아과 from '../../../data/100yearmap/pediatrics.json';
import 초등 from '../../../data/100yearmap/elementary.json';
import 직장 from '../../../data/100yearmap/longest-job.json';
import 남은해 from '../../../data/100yearmap/years-left.json';
import 건강한해 from '../../../data/100yearmap/healthy-years.json';
import 계속일 from '../../../data/100yearmap/keep-working.json';
import 첫일 from '../../../data/100yearmap/first-job.json';
import 혼인 from '../../../data/100yearmap/marriage-age.json';
import 돌봄 from '../../../data/100yearmap/care.json';
import 아침 from '../../../data/100yearmap/breakfast.json';
import 집 from '../../../data/100yearmap/home.json';
import 지출 from '../../../data/100yearmap/spending.json';
import 반려동물 from '../../../data/100yearmap/pets.json';
import 여행 from '../../../data/100yearmap/travel.json';
import 승진 from '../../../data/100yearmap/promotion.json';
import 운동 from '../../../data/100yearmap/exercise.json';

const a = 어린이집 as any, b = 유치원 as any, c = 방과후 as any, d = 소아과 as any;
const e = 초등 as any, f = 직장 as any, g = 남은해 as any, h = 건강한해 as any;
const i = 계속일 as any;
const j = 첫일 as any;
const k = 혼인 as any;
const m = 돌봄 as any;
const n = 아침 as any;
const o = 집 as any;
const p = 반려동물 as any;
const q = 여행 as any;
const r = 승진 as any;
const s = 운동 as any;

/** ⛔ 수는 자료에서 읽는다. 몇 해치인지도 함께 적는다 */
const 문들 = [
  {
    나이: '0~5세', 주소: '/nursery', 이름: '어린이집이 한 곳도 없는 지역',
    수: `${a.해별[a.최신].전국}곳`,
    한줄: `${a.최신}년 기준. ${a.해별[a.해들[0]].전국}곳이던 ${a.해들[0]}년보다 늘었습니다.`,
    기간: `${a.해들[0]}~${a.최신} · ${a.해들.length}해`,
  },
  {
    나이: '3~5세', 주소: '/kindergarten', 이름: '우리 동네에 유치원이 몇 곳인가',
    수: `${b.전국.곳.toLocaleString()}곳`,
    한줄: `원아 ${b.전국.원아.toLocaleString()}명. 시·군·구 ${b.동네수}칸을 다 실었습니다.`,
    기간: `${b.해}년 · 1해`,
  },
  {
    나이: '아플 때', 주소: '/pediatrics', 이름: '밤에 아이가 열이 나면 어디로 가나',
    수: `${d.없는곳수}곳`,
    한줄: `소아청소년과 «의원»이 없는 시·군·구. 그중 ${d.병원급.아예없는곳}곳은 병원급도 없습니다.`,
    기간: `${d.흐름[0].해}~${d.흐름[d.흐름.length - 1].해} · ${d.흐름.length}해`,
  },
  {
    나이: '6~9세', 주소: '/afterschool', 이름: '학교가 한 시에 끝나면 아이는 어디로 가나',
    수: `${(c.학교급 as any[])[0].참여율}%`,
    한줄: `초등학교 늘봄·방과후 참여율. 읍면이 ${(c.지역 as any[])[4].참여율}%로 대도시보다 높습니다.`,
    기간: `${c.해들[0]}~${c.최신} · ${c.해들.length}해`,
  },
  {
    나이: '초등', 주소: '/elementary', 이름: '초등학교는 몇 살인가요',
    수: `${e.백년넘은곳수.toLocaleString()}곳`,
    한줄: `문 연 지 백 년이 넘은 학교. 전국 ${e.낸곳.toLocaleString()}곳을 세었습니다.`,
    기간: `${e.올해}년 기준`,
  },
  {
    나이: '10대', 주소: '/breakfast', 이름: '아침을 거르는 건 몇 살일까',
    수: `${n.열대.몫}%`,
    한줄: `10~18세가 조사 전날 아침을 걸렀습니다. ⛔ 맨 위 칸은 10대가 아니라 ${n.가장많이거르는칸.칸}(${n.가장많이거르는칸.몫}%)입니다.`,
    기간: `${n.흐름첫.해}~${n.최신} · 값이 있는 해 ${n.흐름해수}해`,
  },
  {
    나이: '10대', 주소: '/major', 이름: '학과 찾기 — 그 길로 간 사람들은 어떻게 됐나',
    수: '한 점',
    한줄: '대학은 백 년 가운데 한 점입니다. 이 자리도 저희 지면 대부분이 여기 있습니다.',
    기간: '해마다',
  },
  {
    나이: '20대 · 첫 일', 주소: '/first-job', 이름: '처음 일자리는 언제 오고, 얼마나 갈까',
    수: `${j.평균소요}개월`,
    한줄: `졸업·중퇴 뒤 첫 일자리까지. 첫 직장 근속은 ${j.근속.전체}개월, 이미 그만둔 사람이 ${j.근속.그만둔몫}%입니다.`,
    기간: `${j.흐름[0].해}~${j.흐름[j.흐름.length-1].해} · ${j.조사수}번 조사`,
  },
  {
    나이: '30대', 주소: '/marriage-age', 이름: '서른 살에 사람들은 결혼했을까, 아직일까',
    수: `${k.서른칸.전체.미혼몫}%`,
    한줄: `30~34세가 아직 미혼입니다. 같은 해 평균 초혼은 ${k.초혼.끝.남편}세 — 재는 것이 달라 두 수가 갈립니다.`,
    기간: `${k.해들[0]}~${k.최신} · ${k.해수}해 · 평균 초혼은 ${k.초혼.첫.해}년부터 ${k.초혼.해수}해`,
  },
  {
    나이: '40대', 주소: '/spending', 이름: '마흔에 한 달 돈은 어디로 가나',
    수: `${Math.round((지출 as any).마흔.소비지출 / 1000) / 10}만원`,
    한줄: `가구주 40대 가구의 한 달 소비지출. 그중 교육이 ${(지출 as any).마흔항목.find((r: any) => r.항목 === '교육').몫}%로 40대에서만 솟아 있습니다.`,
    기간: `${(지출 as any).해들[0]}~${(지출 as any).최신} · ${(지출 as any).해수}해`,
  },
  {
    나이: '40~50대', 주소: '/home', 이름: '집을 가진 가구는 몇 살일까',
    수: `${o.가장많은칸.몫}%`,
    한줄: `집을 가진 가구 가운데 가구주가 ${o.가장많은칸.칸}인 집. ⛔ 소유율이 아니라 구성비입니다.`,
    기간: `${o.흐름첫.해}~${o.최신} · ${o.흐름해수}해`,
  },
  {
    나이: '전 연령', 주소: '/pets', 이름: '몇 %가 반려동물을 기르나, 나이대로 다른가',
    수: `${p.전체.양육몫}%`,
    한줄: `기르는 가구 안에서는 나이가 들수록 개 비중이 오르고 고양이 비중이 내립니다(20대 개${(p.연령별 as any[])[0].개몫}%→60대 이상 개${(p.연령별 as any[])[4].개몫}%).`,
    기간: `${p.최신} · ${p.해수}해(표본 ${p.전체.사례수.toLocaleString()}가구)`,
  },
  {
    나이: '전 연령', 주소: '/travel', 이름: '1년에 국내여행을 며칠이나 갈까, 나이대로 다른가',
    수: `${q.최신칸.국내전체}일`,
    한줄: `${q.가장많은연령.칸}가 ${q.가장많은연령.국내전체}일로 가장 많습니다. ⚠ ${q.회복.회복 ? '' : '아직 '}코로나 전(2018~2019) 평균 ${q.회복.코로나전평균}일에 ${q.회복.회복 ? '넘었습니다' : '못 미칩니다'}.`,
    기간: `${q.해들[0]}~${q.최신} · ${q.해수}해`,
  },
  {
    나이: '직장인', 주소: '/promotion', 이름: '승진에 만족하는 사람은 몇 %일까',
    수: `${r.맨위차.맨위}점 차`,
    한줄: `임원급에서 성별 평균 차이(남−여)가 다른 직급(최대 ${r.맨위차.나머지최대}점)보다 뚜렷이 큽니다. ⚠ 여성관리자패널(100인 이상 사업체 위주)입니다.`,
    기간: `${r.해들[0]}~${r.최신} · ${r.해수}번 조사(격년)`,
  },
  {
    나이: '전 연령', 주소: '/exercise', 이름: '몇 %가 규칙적으로 운동하나, 동호회로 하는 사람은 얼마나 되나',
    수: `${s.동호회최고.최고칸} ${s.동호회최고.최고값}%`,
    한줄: `동호회 참여율은 ${s.동호회최고.최고칸}까지 오르다 70세 이상에서 다시 낮아집니다 — "나이 들수록 계속 는다"는 절반만 맞습니다.`,
    기간: `${s.최신} · 국민생활체육조사`,
  },
  {
    나이: '20~60대', 주소: '/age', 이름: '나이로 보기 — 월급 · 근속 · 살림',
    수: '나이띠',
    한줄: '같은 나이 사람들이 실제로 어떤 자리에 있나를 적습니다.',
    기간: '해마다',
  },
  {
    나이: '50대', 주소: '/longest-job', 이름: '가장 오래 다닌 직장, 몇 살에 그만두었나',
    수: `${(f.넓게.나이 as any).평균}세`,
    한줄: `그만둔 까닭 맨 위는 사업 부진·휴업·폐업 ${(f.넓게.까닭.까닭별 as any[])[0].몫}%입니다.`,
    기간: `${f.해} 조사`,
  },
  {
    나이: '55~79세', 주소: '/keep-working', 이름: '그만두고도 계속 일하고 싶은가',
    수: `${i.원함몫}%`,
    한줄: `까닭 맨 위는 ${i.까닭[0].까닭}(${i.까닭[0].몫}%). ⚠ 두 수의 분모가 다릅니다.`,
    기간: `${i.흐름[0].해}~${i.흐름[i.흐름.length-1].해} · ${i.조사수}번 조사`,
  },
  {
    나이: '65세~', 주소: '/care', 이름: '몇 살부터 돌봄이 필요해지나',
    수: `${(m.나이별 as any[]).find((r: any) => r.칸 === '85세이상').몫}%`,
    한줄: `85세 이상이 받은 장기요양 인정입니다. 65~69세는 ${(m.나이별 as any[]).find((r: any) => r.칸 === '65~69세').몫}% — ⛔ 등급외를 뺀 수입니다.`,
    기간: `${m.해들[0]}~${m.최신} · ${m.해수}해`,
  },
  {
    나이: '0~100세', 주소: '/years-left', 이름: '앞으로 몇 해가 남았나',
    수: `${(g.나이별 as any[]).find((r: any) => r.나이 === 0).전체}년`,
    한줄: `갓 태어난 아이 기준. 나이 ${(g.나이별 as any[]).length}칸을 한 살씩 실었습니다.`,
    기간: `${g.첫해}~${g.최신} · ${g.해수}해`,
  },
  {
    나이: '0~100세', 주소: '/healthy-years', 이름: '그 가운데 건강한 해는 몇 해인가',
    수: `${(h.나이별 as any[]).find((r: any) => r.나이 === 0).벌어짐}년`,
    한줄: '같은 해 같은 표인데 재는 법이 다르면 이만큼 벌어집니다.',
    기간: `${h.해들[0]}~${h.최신} · ${h.해들.length}번 조사`,
  },
];

const desc =
  `백년지도가 지금까지 연 문 ${문들.length}개를 나이 차례로 모았습니다. ` +
  `0~5세 어린이집부터 0~100세 생명표까지, 문마다 몇 살 자리인지와 자료가 몇 해치인지를 적었습니다.`;
---

<HundredYear title={`나이로 보는 문 ${문들.length}개 — 0세부터 100세까지`} description={desc}>
  <h1>나이로 보는 문</h1>
  <p class="sub">
    백년지도가 지금까지 연 문 <strong>{문들.length}개</strong>를 나이 차례로 모았습니다.
    {' '}<strong>대학은 이 가운데 한 점입니다.</strong>
  </p>

  <p class="note">
    ⛔ 카드에 적힌 수는 <strong>그 지면이 실제로 쥔 수</strong>입니다 — 저희가 여기 손으로 옮겨 적지 않았습니다.
    {' '}자료가 바뀌면 이 카드도 같이 바뀝니다.
    {' '}그리고 문마다 <strong>자료가 몇 해치인지</strong>를 적었습니다 — 한 해짜리와 열여덟 해짜리는 다른 말을 합니다.
  </p>

  {문들.map((r) => (
    <div class="answer">
      <p class="answer-label">{r.나이}</p>
      <p class="answer-num" style="font-size:clamp(1.4rem,4.4vw,2rem);letter-spacing:-1px">
        <a href={r.주소}>{r.이름}</a>
      </p>
      <p class="answer-sub">
        <strong>{r.수}</strong> — {r.한줄}
        <br />자료 {r.기간}
      </p>
    </div>
  ))}

  <h2>왜 나이로 놓았나</h2>
  <p>
    저희 지면은 오랫동안 <strong>대입 한 자리</strong>에 몰려 있었습니다.
    {' '}그래서 0세부터 100세까지 한 줄로 놓고, 그 줄 위에서 대학이 어디쯤인지 보이게 했습니다.
    {' '}<strong>지형을 그려 놓고 바늘은 보는 사람이 세웁니다.</strong>
  </p>
  <p class="note">
    ⚠ 아직 빈 자리가 많습니다. 10대와 20~60대 사이, 70대 뒤가 얇습니다.
    {' '}<strong>없는 자리를 있는 척하지 않습니다</strong> — 채워지는 대로 이 문에 붙입니다.
  </p>

  <NextQuestionBrief 모은것="나이별 지면" />
</HundredYear>
