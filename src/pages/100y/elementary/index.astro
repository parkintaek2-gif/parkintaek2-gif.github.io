---
/**
 * /100y/elementary — 초등학교는 몇 살인가요
 *
 * 🔴 왜 만드나 —
 *   사장님 「**왜 자꾸 대입에 머물러있니**」. 8/15 에 자로 재 보니 지면 4,970장 중
 *   4,927장(99.1%)이 대입 쪽이었다. 그리고 초등 자료 6,328곳이 만들어져 있는데
 *   **어느 지면도 쓰지 않았다** — 만든 자도 검산자도 있는데 잠들어 있었다(3번이 8/16 에 찾음).
 *   접어 둔 사유가 「초등은 진로 검색어가 되지 않는다」였는데, 그 사유 자체가 «진로=대입» 위에 있다.
 *
 * ⭐ 그런데 우리 이름이 **백년지도**다. 백 년 넘은 초등학교가 888곳 있다.
 *   대입에서 가장 먼 자리에서, 우리 이름이 가장 잘 맞는 수가 나온다.
 *
 * ⛔ 6,328장을 만들지 않는다. **한 장**이다. 되는지 보고 넓힌다(/age 를 그렇게 열었다).
 * ⛔ 자료가 스스로 못박아 둔 것을 그대로 지킨다 —
 *     「⛔ 안 쓰는 말: 명문 · 전통 · 순위 · 몇 위 · 좋은 학교 · 나쁜 학교」
 *     「⚠ 설립일은 NEIS 값이라 학교가 세는 개교기념일과 다를 수 있다 —
 *       «몇 년째»로 쓰지 않고 «1882년 설립»으로 쓴다」
 *     「⚠ 여기에 없는 것: 학업성취 · 진학 · 학급규모. 있는 것은 문 연 날과 자리뿐이다」
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredCardnews from '../../../components/HundredCardnews.astro';
import 원본 from '../../../data/100yearmap/elementary.json';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';

const 자료 = 원본 as any;
const 올해 = 자료.올해 as number;

/** 백 년이 넘은 곳이 많은 지역 — ⛔ 순위가 아니다. 「어디에 오래된 학교가 몰려 있나」다 */
const 백년많은지역 = [...자료.지역]
  .filter((r: any) => r.백년 > 0)
  .sort((a: any, b: any) => b.백년 - a.백년)
  .slice(0, 12);

/** 시도별로 묶어 본다 — 지역 261칸은 한 지면에 못 담는다 */
const 시도별 = (() => {
  const 통 = new Map<string, { 시도: string; 곳: number; 백년: number }>();
  for (const r of 자료.지역) {
    const t = 통.get(r.시도) || { 시도: r.시도, 곳: 0, 백년: 0 };
    t.곳 += r.곳; t.백년 += r.백년;
    통.set(r.시도, t);
  }
  return [...통.values()].sort((a, b) => b.곳 - a.곳);
})();

/** 시·군·구 261칸 전부 — 찾기로 여는다. ⛔ 잘라내지 않는다. 손님이 찾는 것은 자기 동네 한 칸이다 */
const 동네 = [...자료.지역].sort((a: any, b: any) => b.곳 - a.곳);

/**
 * 🔴 8/18 예약분 — 언제 학교가 많이 생겼나. 자료는 이미 손에 있는 설립연 칸이다(6,328곳 전부 있다).
 * ⛔ 「많이 생긴 때가 좋은 때」로 읽히게 쓰지 않는다. **몇 곳이 문을 열었나**만 적는다.
 * ⚠ 설립일은 NEIS 값이라 개교기념일과 다를 수 있다 — 이 지면이 위에서 이미 밝힌다.
 */
const 열해마다 = (() => {
  const 통 = new Map<number, number>();
  for (const r of 자료.자료) {
    if (!r.설립연) continue;
    const 십 = Math.floor(r.설립연 / 10) * 10;
    통.set(십, (통.get(십) ?? 0) + 1);
  }
  return [...통.entries()].sort((a, b) => a[0] - b[0]).map(([해, 곳]) => ({ 해, 곳 }));
})();
const 가장많은열해 = [...열해마다].sort((a, b) => b.곳 - a.곳)[0];
const 열해잰곳 = 열해마다.reduce((a, r) => a + r.곳, 0);

const 백년몫 = Number(((자료.백년넘은곳수 / 자료.낸곳) * 100).toFixed(1));
const 맨오래 = 자료.가장오래된[0];

const desc =
  `전국 초등학교 ${자료.낸곳.toLocaleString()}곳이 언제 문을 열었는지 모았습니다. ` +
  `백 년이 넘은 학교가 ${자료.백년넘은곳수.toLocaleString()}곳입니다. ` +
  `가장 먼저 문을 연 곳은 ${맨오래.title}로 ${맨오래.설립연}년입니다. 등수를 매기지 않습니다.`;
---

<HundredYear title="초등학교는 몇 살인가요? — 백 년 넘은 학교 888곳" description={desc}>
  <h1>초등학교는 몇 살인가요?</h1>
  <p class="sub">
    전국 초등학교 <strong>{자료.낸곳.toLocaleString()}곳</strong>이 언제 문을 열었는지 모았습니다.{' '}
    <strong>백 년이 넘은 학교가 {자료.백년넘은곳수.toLocaleString()}곳</strong>입니다 — {백년몫}%입니다.
  </p>

  {/* ⚠ 처음에 「열에 하나꼴(14%)」이라 썼다. 열에 하나면 10% 다 — 어림말과 잰 수가 어긋났다.
      ⛔ 그리고 「좋은 학교라는 뜻이 아닙니다」로 적었는데, 자료가 «안 쓰는 말»로 못박은 낱말이다.
         카드에서 배웠듯 부정해도 낱말은 화면에 남는다. 아예 다른 말로 쓴다 */}
  <p class="note">
    ⛔ 오래되었다고 더 낫다는 뜻이 아닙니다. 새로 지었다고 못하다는 뜻도 아닙니다.
    저희는 <strong>문 연 날과 자리</strong>만 적습니다. 등수를 매기지 않습니다.
  </p>

  <div class="answer">
    <p class="answer-label">가장 먼저 문을 연 초등학교</p>
    <p class="answer-num">{맨오래.설립연}년</p>
    <p class="answer-sub">
      {맨오래.title} · {맨오래.시도} {맨오래.구} — 올해로 {올해 - 맨오래.설립연}해째 자리에 있습니다
    </p>
  </div>

  <h2>먼저 문을 연 열 곳</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>설립</th><th>학교</th><th>어디</th></tr></thead>
      <tbody>
        {자료.가장오래된.map((r: any) => (
          <tr>
            <td>{r.설립연}년</td>
            <td>{r.title}</td>
            <td>{r.시도} {r.구}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    ⚠ 설립일은 <strong>NEIS 공시 값</strong>입니다. 학교가 스스로 세는 개교기념일과 다를 수 있어,
    「몇 년째」가 아니라 <strong>「몇 년에 문을 열었다」</strong>로 적습니다.
  </p>

  <h2>백 년 넘은 학교가 몰려 있는 곳</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>백 년 넘은 곳</th><th>초등학교</th></tr></thead>
      <tbody>
        {백년많은지역.map((r: any) => (
          <tr>
            <td>{r.시도} {r.구}</td>
            <td>{r.백년}곳</td>
            <td>{r.곳}곳</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="warn">
    <p><strong>⛔ 이것은 순위가 아닙니다.</strong></p>
    <p class="note">
      학교가 많은 지역이면 오래된 학교도 많습니다. 그러니 이 표는{' '}
      <strong>「어디가 낫다」가 아니라 「어디에 오래된 학교가 있나」</strong>입니다.
      오른쪽 칸(그 지역 초등학교 전체 수)을 함께 보셔야 합니다.
    </p>
  </div>

  <h2>시·도로 보면</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>초등학교</th><th>백 년 넘은 곳</th></tr></thead>
      <tbody>
        {시도별.map((r) => (
          <tr><td>{r.시도}</td><td>{r.곳.toLocaleString()}곳</td><td>{r.백년}곳</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  {/**
    * 🔴 **지면을 늘리지 않고 261칸을 연다.**
    *   시·군·구가 261칸인데 지면을 261장 만들면 대입 쪽으로 기운 비율이 또 흔들리고,
    *   무엇보다 손님이 원하는 것은 «우리 동네» 한 칸뿐이다.
    *   ⇒ /university 가 쓰는 찾기 방식을 그대로 가져온다. 새로 짓지 않는다.
    * ⛔ 순위로 늘어놓지 않는다. **곳 수가 많은 차례**로 놓고, 그것이 순위가 아님을 아래에 적는다.
    */}
  <h2>언제 많이 생겼나요?</h2>
  <p>
    문을 연 해를 열 해씩 묶었습니다.{' '}
    <strong>{가장많은열해.해}년대에 {가장많은열해.곳}곳</strong>이 가장 많습니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>열 해</th><th>문을 연 곳</th></tr></thead>
      <tbody>
        {열해마다.map((r: any) => (
          <tr><td>{r.해}년대</td><td>{r.곳}곳</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    ⛔ 많이 생긴 때가 <strong>좋은 때</strong>라는 뜻이 아닙니다. 몇 곳이 문을 열었나만 적습니다.
    학교 {열해잰곳.toLocaleString()}곳 전부에 문을 연 해가 있습니다 — 빠진 곳이 없습니다.
  </p>

  <h2>우리 동네로 찾기</h2>
  <input
    id="q"
    type="search"
    placeholder="시·군·구를 입력하세요 (예: 화성, 종로, 제주)"
    autocomplete="off"
    aria-label="시·군·구 검색"
  />
  <p class="note" id="cnt" aria-live="polite"></p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·군·구</th><th>초등학교</th><th>백 년 넘은 곳</th></tr></thead>
      <tbody id="지역몸">
        {동네.map((r: any) => (
          <tr data-name={`${r.시도} ${r.구}`}>
            <td>{r.시도} {r.구}</td>
            <td>{r.곳}곳</td>
            <td>{r.백년}곳</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    ⛔ 학교가 많은 차례로 놓았을 뿐, <strong>순위가 아닙니다.</strong> 시·군·구 {자료.지역수}칸을 다 실었습니다.
  </p>

  <div class="warn">
    <p><strong>⚠ 이 지면에 없는 것</strong></p>
    <p class="note">
      학업성취 · 진학 · 학급규모는 <strong>없습니다</strong>. 초등학교는 그 공시가 없습니다.
      있는 것은 <strong>문 연 날과 자리</strong>뿐입니다. 없는 것을 지어내 채우지 않았습니다.
    </p>
    <p class="note">
      🔴 전국 {자료.전체.toLocaleString()}곳 가운데 <strong>{자료.낸곳.toLocaleString()}곳</strong>을 실었습니다.
      뺀 {자료.전체 - 자료.낸곳}곳은 재외한국학교 {자료.뺀것.재외한국학교}곳 ·
      주소가 없는 곳 {자료.뺀것.주소없음}곳 ·{' '}
      <strong>아직 문을 안 연 곳 {자료.뺀것.아직안엶}곳</strong>입니다.
      마지막은 설립 예정일이 {올해}년 뒤라, 지면을 만들면 「(가칭)」이 붙은 학교가 생깁니다.
    </p>
  </div>

  <p class="note">
    출처 — NEIS 교육정보 개방 포털(한국교육학술정보원) · 공식 OpenAPI 로 받았습니다. 사이트를 긁지 않았습니다.
  </p>
  <HundredCardnews 벌="우리학교는몇살" 장수={6} 머리="초등학교 카드 여섯 장" />

  {/* 🔴 2번 지시(06:2x) — 한 장에 들어온 손님이 그 한 장만 보고 나간다. 돌아오는 길을 낸다 */}
  {/* 🔴 2번 11:2x — 밖에서 들어온 손님은 지면 하나로 떨어진다. 여기서 옆 문이 보여야 한다 */}
  <HundredAgeWalk 키="elementary" />

  <p class="note">
    <a href="/ages">← 나이로 보는 문 — 0세부터 100세까지 한 자리에</a>
    <br />
    {/* 🔴 2번 10:2x — 지면에서도 «방으로» 가게 한다. 한쪽만이면 손님이 옆 문을 못 본다 */}
    <a href="/community">← 커뮤니티 — 「나이로 나눈 방」 방</a>
  </p>

  <NextQuestionBrief 모은것="초등학교 자료" />
</HundredYear>

<style>
  #q {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    font-size: var(--fs-body);
    font-family: inherit;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    margin: 0 0 0.5rem;
  }
  #q:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  [hidden] { display: none !important; }
</style>

<script is:inline>
  /* ⚠ /university 의 찾기와 같은 방식이다. 새로 짓지 않았다.
     ⛔ 자바스크립트가 꺼져 있어도 표는 그대로 보인다 — 찾기만 안 될 뿐이다 */
  (function () {
    var q = document.getElementById('q');
    var cnt = document.getElementById('cnt');
    var 몸 = document.getElementById('지역몸');
    if (!q || !몸) return;
    var 줄들 = Array.prototype.slice.call(몸.querySelectorAll('tr'));

    function 적용() {
      var v = q.value.trim();
      if (!v) {
        줄들.forEach(function (tr) { tr.hidden = false; });
        cnt.textContent = '';
        return;
      }
      var n = 0;
      줄들.forEach(function (tr) {
        var 맞나 = tr.getAttribute('data-name').indexOf(v) >= 0;
        tr.hidden = !맞나;
        if (맞나) n++;
      });
      cnt.textContent = n ? '「' + v + '」 ' + n + '칸' : '「' + v + '」 로 찾은 곳이 없습니다';
    }
    q.addEventListener('input', 적용);
  })();
</script>
