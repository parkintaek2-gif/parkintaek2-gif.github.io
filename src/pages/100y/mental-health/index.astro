---
/**
 * /100y/mental-health — 시즌2-2 「몸/맘」 첫 지면
 *
 * 🔴 사장님 기획(경영/새서비스-기획_2026-08-10.md §3, docs/3번-시즌2-2-몸맘.md) —
 *   100yearmap 갈래가 「몸」에서 「몸/맘」으로 넓어진다(심리학·정신분석학·정신건강의학).
 *
 * ⛔⛔ 이 지면이 지키는 것 — **우리는 진단하지 않는다.**
 *   「이 나이대가 실제로 어떤 어려움을 겪나」를 통계로만 보여준다.
 *   ⛔ "우울증입니다" 같은 진단명을 쓰지 않는다 — 늘 «경험률·인지율»(설문에서 스스로
 *      그렇다고 답한 비율)로만 말한다. 2인칭 진단("당신도 그럴 수 있다")도 안 쓴다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/mental-health-by-age.json';

const 자료 = 원본 as any;
const 최근 = 자료.연도별[자료.최근연도];
const 나이대들 = ['19-29세', '30-39세', '40-49세', '50-59세', '60-69세', '70-79세', '80세이상'];
const 나이대표시 = (k: string) => (k === '80세이상' ? '80세 이상' : k);

const 대비 = 자료['2023_핵심대비'];

const desc =
  `한국보건사회연구원 조사(KOSIS)를 그대로 옮겼습니다. ${자료.최근연도}년 기준 스트레스를 ` +
  `가장 많이 느낀다고 답한 나이대는 ${대비.스트레스_최고.나이대}(${대비.스트레스_최고.값}%)이지만, ` +
  `우울감을 가장 많이 경험했다고 답한 나이대는 반대로 ${나이대표시(대비.우울감_최고.나이대)}` +
  `(${대비.우울감_최고.값}%)입니다. 스트레스와 우울감은 나이에 따라 같이 움직이지 않습니다.`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '경험률·인지율이란 무엇인가요',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '병원에서 진단받은 비율이 아니라, 설문조사에서 "지난 1년간 그런 감정을 느꼈다/그렇게 인지했다"고 스스로 답한 사람의 비율입니다. 어떤 질환의 진단율도 아닙니다.',
      },
    },
    {
      '@type': 'Question',
      name: '스트레스와 우울감이 왜 반대로 움직이나요',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `이 조사만으로는 이유를 알 수 없습니다. ${자료.최근연도}년 자료에서 스트레스 인지율이 가장 높은 나이대(30~40대)가 우울감 경험률은 가장 낮고, 우울감 경험률이 가장 높은 나이대(80세 이상)가 스트레스 인지율은 가장 낮다는 사실만을 보여드립니다.`,
      },
    },
  ],
};

/** 인라인 SVG 막대그래프 — 나이대별 스트레스·우울감을 나란히 놓는다 */
const 폭 = 640;
const 높 = 320;
const 왼쪽여백 = 40;
const 칸폭 = (폭 - 왼쪽여백 - 20) / 나이대들.length;
const 막대폭 = 칸폭 * 0.32;
const 최대값 = 40;
const y0 = 높 - 40;
const 스케일 = (v: number) => (v / 최대값) * (y0 - 20);
---

<HundredYear
  title={`스트레스는 ${대비.스트레스_최고.나이대}, 우울감은 80대가 가장 높습니다`}
  description={desc}
  jsonLd={faqJsonLd}
>
  <h1>스트레스는 30~40대가,<br />우울감은 80대가 가장 큽니다</h1>
  <p class="sub">
    {자료.최근연도}년 기준, 스트레스를 느낀다고 답한 사람은 <strong>{대비.스트레스_최고.나이대}에서
    {' '}{대비.스트레스_최고.값}%</strong>로 가장 많았습니다. 그런데 지난 1년간 우울감을 경험했다고
    {' '}답한 사람은 반대로 <strong>80세 이상에서 {대비.우울감_최고.값}%</strong>로 가장 많았습니다.
    {' '}스트레스가 가장 큰 나이대가 우울감도 가장 큰 것은 아닙니다.
  </p>

  <div class="warn">
    <p><strong>⚠ 이것은 진단이 아니라 설문 응답입니다.</strong></p>
    <p class="note">{자료['⛔단위설명']}</p>
  </div>

  <h2>{자료.최근연도}년, 나이대별로 나란히 놓으면</h2>
  <div class="tablewrap">
    <svg viewBox={`0 0 ${폭} ${높}`} width="100%" style="max-width:640px" role="img"
         aria-label={`나이대별 스트레스 인지율과 우울감 경험률 막대그래프. 스트레스는 ${대비.스트레스_최고.나이대}에서 ${대비.스트레스_최고.값}%로 가장 높고, 우울감은 80세 이상에서 ${대비.우울감_최고.값}%로 가장 높다.`}>
      <line x1={왼쪽여백} y1={y0} x2={폭 - 20} y2={y0} stroke="#3a3f4d" />
      {나이대들.map((나이, i) => {
        const 스트 = 최근.스트레스인지율[나이];
        const 우울 = 최근.우울감경험률[나이];
        const x = 왼쪽여백 + i * 칸폭 + 칸폭 * 0.1;
        return (
          <>
            <rect x={x} y={y0 - 스케일(스트)} width={막대폭} height={스케일(스트)} fill="#c9a84c" opacity="0.9" />
            <rect x={x + 막대폭 + 4} y={y0 - 스케일(우울)} width={막대폭} height={스케일(우울)} fill="#7a8ba6" opacity="0.9" />
            <text x={x + 막대폭} y={y0 + 16} fill="#9aa3b2" font-size="12" text-anchor="middle">
              {나이.replace('세이상', '+').replace('세', '')}
            </text>
          </>
        );
      })}
      <rect x={왼쪽여백} y="8" width="10" height="10" fill="#c9a84c" />
      <text x={왼쪽여백 + 16} y="17" fill="#c9c9c9" font-size="12">스트레스 인지율(%)</text>
      <rect x={왼쪽여백 + 140} y="8" width="10" height="10" fill="#7a8ba6" />
      <text x={왼쪽여백 + 156} y="17" fill="#c9c9c9" font-size="12">우울감 경험률(%)</text>
    </svg>
  </div>

  <div class="tablewrap">
    <table>
      <thead><tr><th>나이대</th><th>스트레스 인지율</th><th>우울감 경험률</th></tr></thead>
      <tbody>
        {나이대들.map((나이) => (
          <tr>
            <td>{나이대표시(나이)}</td>
            <td>{최근.스트레스인지율[나이]}%</td>
            <td>{최근.우울감경험률[나이]}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    ⚠ <strong>{자료.최근연도}년 한 해만 실은 것이 아닙니다.</strong> 2021~{자료.최근연도}년 3개년
    {' '}모두 같은 결이었습니다 — 스트레스는 늘 30~40대가 가장 높았고, 우울감은 늘 80세 이상이
    {' '}가장 높았습니다.
  </p>

  <p class="note">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong> 이 나이대에 속한다고 해서 스트레스나
    {' '}우울감을 겪는다는 뜻이 아니고, 겪지 않는다는 뜻도 아닙니다. 설문에 그렇게 답한
    {' '}사람의 비율일 뿐입니다.
  </p>

  <p class="note">
    힘든 감정이 계속된다면 정신건강위기상담전화(1577-0199, 24시간)나 가까운
    {' '}정신건강복지센터에서 도움을 받으실 수 있습니다.
  </p>

  <p class="note">
    출처 — {자료.출처.이름} ({자료.출처.표}, {자료.출처.기준}). {자료.출처.이용허락범위}. 받은 날 {자료.받은때}.
  </p>

  <h2>자주 묻는 말</h2>
  {faqJsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    <a href="/care">← 몇 살부터 돌봄이 필요해질까</a>
    <br />
    <a href="/keep-working">← 55~79세, 계속 일하고 싶은가?</a>
    <br />
    <a href="/ages">← 나이로 보는 문 — 0세부터 100세까지 한 자리에</a>
  </p>

  <HundredAgeWalk 키="mental-health" />
  <NextQuestionBrief 모은것="한국보건사회연구원 KOSIS 우울감·스트레스 통계" />

  {/* 2번의 자체 댓글 시스템(2026-08-31, 무쿠키·무IP) */}
  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/mental-health"></div>
</HundredYear>
