---
/**
 * /100y/y/[key] — **밖에 적는 짧은 주소**. 여기서 진짜 지면으로 보낸다.
 *
 * ⛔ 이 지면은 **읽으라고 만든 것이 아니다.** 손님은 여기서 0.1초 머문다.
 *   그래서 글자를 최소로 두고, **자바스크립트가 막혀도** 가게 두 가지 길을 놓는다 —
 *   ① `<meta http-equiv="refresh">` ② 손으로 누를 수 있는 링크
 *
 * ⚠ **301 이 아니다.** 정적 빌드라 상태코드를 못 바꾼다. 손님에게는 같은 값이고,
 *   크롤러에게는 `noindex` 로 「여기 담지 마라」고 말한다.
 * ⛔ 검색에 이 주소가 뜨면 진짜 지면과 겨룬다. 그래서 사이트맵에도 안 넣는다.
 *
 * 🔴 이 지면이 있는 진짜 까닭 — **경로는 우리 로그가 적는다.**
 *   `?from=` 은 서버가 물음표 뒤를 안 적어 못 세는데, `/y/jongno` 는 **오늘부터 세어진다.**
 */
import { 짧은주소들 } from '../../../lib/short-links';

export async function getStaticPaths() {
  return 짧은주소들.map((x) => ({ params: { key: x.키 }, props: { 것: x } }));
}

const { 것 } = Astro.props as { 것: (typeof 짧은주소들)[number] };
const 갈곳 = 것.가는곳;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* ⛔ 검색에 담지 않는다 — 진짜 지면과 겨루면 안 된다 */}
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${갈곳}`} />
    <link rel="canonical" href={`https://100yearmap.com${갈곳.split('?')[0]}`} />
    {/*
      ⚠ 제목을 「{것.말} — 백년지도」로 두었더니 **진짜 지면과 글자가 똑같았다**
        (/y/age32 와 /age/32 가 둘 다 「서른둘 — 남들은 어떻게 하고 있나 — 백년지도」).
        개봉 자(check-100yearmap-launch)가 「제목이 겹친다」로 잡았다. 맞는 지적이다 —
        noindex 라 검색에는 안 뜨지만, **탭 이름·기록·공유에 같은 글자가 두 벌** 생긴다.
        그래서 「넘어갑니다」를 앞에 두어 갈랐다. 손님은 0.1초 보고 지나간다.
    */}
    <title>넘어갑니다 — {것.말}</title>
    {/*
      ⭐ 이 주소는 **유튜브 설명에 들어간다**. 손님이 그것을 카카오톡에 붙이면 카드가 뜬다.
        그래서 noindex 라도 OG 는 붙인다. 없으면 카드가 허옇게 뜬다.
        (개봉 자가 「OG 카드가 4장 빠짐」으로 잡아 준 것이다)
    */}
    <meta name="description" content={`${것.말} 지면으로 넘어갑니다 — 백년지도`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="백년지도" />
    <meta property="og:title" content={`${것.말} — 백년지도`} />
    <meta property="og:description" content={`${것.말} 지면으로 넘어갑니다.`} />
    <meta property="og:image" content="https://100yearmap.com/og.png" />
    <meta property="og:url" content={`https://100yearmap.com${갈곳.split('?')[0]}`} />
    <style>
      body {
        margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: #12151c; color: #e9e9ee;
        font-family: 'Malgun Gothic', '맑은 고딕', system-ui, sans-serif; padding: 24px;
      }
      a { color: #c9a84c; font-size: 18px; line-height: 1.6; display: inline-flex; min-height: 44px; align-items: center; }
    </style>
  </head>
  <body>
    {/* 자바스크립트가 막혀도, 새로고침이 막혀도 이 링크는 남는다 */}
    <a href={갈곳}>{것.말} →</a>
    <script is:inline set:html={`location.replace(${JSON.stringify(갈곳)});`} />
  </body>
</html>
