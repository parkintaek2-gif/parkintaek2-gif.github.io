---
/**
 * /100y/region/[시·도] — 지역 한 곳
 *
 * 화면 순서 — 학과·대학 지면과 같은 뼈대
 *   ❶ 한 줄 답     — 「고등학교 520곳 · 대학 69곳이 있습니다」
 *   ❷ 숫자 셋      — 대학 취업률 · 대학 중도탈락률 · 고교 학업중단률 (전부 전국 평균과의 차이)
 *   ❸ 고교 유형     — 일반고가 몇 곳인가
 *   ❹ 문 닫은 학교  — 있으면 적는다. 없으면 「명단에는 없다」까지만
 *   ❺ 다음 걸음
 *
 * ⛔ 「몇 위」·「상위 몇 %」를 쓰지 않는다. 쓰는 것은 전국 평균과의 차이뿐이다.
 * ⚠ 평균은 **사람 수로 잰 것**이다. 학교들의 평균이 아니다 — `src/lib/region-page.ts` 참조.
 * ⚠ 잰 곳이 없으면 **「못 쟀다」로 적는다.** 0 으로 채우지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import { href } from '../../../lib/hundredyear';
import schools from '../../../data/100yearmap/pages-school.json';
import universities from '../../../data/100yearmap/pages-university.json';
import 중단원본 from '../../../data/100yearmap/school-dropout.json';
import 폐교원본 from '../../../data/100yearmap/closed-universities.json';
import { 지역요약만들기, 견줌말 } from '../../../lib/region-page';
/* 🔴 구·시 목록은 **한 곳**에서 온다 — 지면에서 다시 가르지 않는다 */
import 지역단위 from '../../../data/100yearmap/areas.json';

export async function getStaticPaths() {
  const { default: schools } = await import('../../../data/100yearmap/pages-school.json');
  const 지역들 = [...new Set((schools as any[]).map((s) => s.지역).filter(Boolean))];
  const { 짧은지역명 } = await import('../../../lib/region');
  return 지역들.map((고교지역) => ({
    params: { slug: 짧은지역명(고교지역) },
    props: { 고교지역 },
  }));
}

const { 고교지역 } = Astro.props as { 고교지역: string };

const r = 지역요약만들기({
  고교지역,
  학교들: schools as any[],
  대학들: universities as any[],
  중단자료: (중단원본 as any).자료,
  폐교자료: (폐교원본 as any).자료,
});

/** 유형은 많은 순으로 놓는다 — 이것은 등수가 아니라 그 지역이 어떻게 생겼는가다 */
const 유형목록 = Object.entries(r.유형).sort((a, b) => b[1] - a[1]);

/**
 * 🔴 이 시·도 안의 **구·시 목록** (2026-08-08 · 2번 지시로 넣었다).
 *
 * ⚠ 이 지면의 `고교지역` 은 **교육청 기준**이고, 지역 단위는 **주소 기준**이다.
 *   둘이 다를 수 있어서 **주소로 가른 시·도**(`areas.json` 의 `시도`)로 맞춘다.
 *   ⛔ 「서울특별시교육청」과 「서울특별시」를 글자로 견주면 안 맞는다.
 *
 * ⛔ 가나다순이다. **곳 수가 많은 순으로 세우지 않는다** — 그 순간 큰 구가 위로 온다.
 */
/**
 * ⚠ **주소의 시·도로 견주면 안 된다** (2026-08-08 13:3x · 실측으로 잡았다).
 *
 *   주소는 「전남광주통합특별시 북구」처럼 **광주와 전남을 합쳐** 적혀 있다.
 *   그래서 `/region/광주`·`/region/전남` **두 장이 통째로 비었다.**
 *
 *   ⛔ 내가 「북구는 광주」라고 적어 넣지 않았다. `areas.json` 이 **그 구에 실제로 있는
 *     학교의 교육청**을 세어 `교육청지역` 으로 적어 준다. 자료가 답하게 한다.
 */
const 이시도구들 = ((지역단위 as any).단위 as any[])
  .filter((a) => a.교육청지역 === 고교지역)
  .sort((a, b) => String(a.이름).localeCompare(String(b.이름), 'ko'));

/**
 * 이 지역에서 **구·시를 못 가른 학교**가 몇 곳인가.
 * ⛔ 조용히 빼지 않는다 — 목록 아래에 「못 가른 것」으로 적는다.
 */
const 이시도못가른곳 = ((지역단위 as any).못가른곳 as any[]).filter((x) =>
  String(x.주소 ?? '').startsWith(고교지역.replace(/교육청$/, '')),
).length;

const desc =
  `${r.짧은}의 고등학교 ${r.고교수.toLocaleString()}곳과 대학 ${r.대학수}곳입니다. ` +
  (r.취업
    ? `대학 취업률은 ${r.취업.값}%로 ${견줌말(r.취업)}. `
    : '') +
  `학교를 고르기 전에 그 지역이 어떤 모습인지 숫자로 봅니다.`;
import 요약 from '../../../data/100yearmap/summary.json';
/* 🔴 2026-08-14 — 출처에 「언제 받은 자료인가」가 빠져 있었다(8번이 잡음).
   ⛔ 날을 손으로 박지 않는다. 대장에서 가져와 날짜만 남긴다 */
const 받은날 = String((요약 as any).원천수집시각 ?? '').slice(0, 10);
---

<HundredYear title={`${r.짧은} — 지역으로 보기`} description={desc}>
  <h1>{r.짧은}</h1>

  <p class="sub">
    고등학교 <strong>{r.고교수.toLocaleString()}곳</strong> · 대학 <strong>{r.대학수}곳</strong>입니다.
    {r.학과있는고교 > 0 && (
      <> 고등학교 가운데 학과를 나누는 곳이 {r.학과있는고교.toLocaleString()}곳입니다.</>
    )}
  </p>

  <h2>숫자 셋</h2>

  <div class="nums">
    <div class="num">
      <p class="k">대학 취업률</p>
      {r.취업 ? (
        <>
          <p class="v">{r.취업.값}%</p>
          <p class="note">
            전국 평균 {r.취업.전국}% — {견줌말(r.취업)}<br />
            {r.취업.잰곳}곳 · 취업 대상 {r.취업.대상.toLocaleString()}명 가운데 {r.취업.사람.toLocaleString()}명
          </p>
        </>
      ) : (
        <>
          <p class="v">—</p>
          <p class="note">이 지역에서 취업률을 공시한 대학이 없어 <strong>못 쟀습니다.</strong></p>
        </>
      )}
    </div>

    <div class="num">
      <p class="k">대학 중도탈락률</p>
      {r.탈락 ? (
        <>
          <p class="v">{r.탈락.값}%</p>
          <p class="note">
            전국 평균 {r.탈락.전국}% — {견줌말(r.탈락)}<br />
            {r.탈락.잰곳}곳 · 재적 {r.탈락.대상.toLocaleString()}명 가운데 {r.탈락.사람.toLocaleString()}명
          </p>
        </>
      ) : (
        <>
          <p class="v">—</p>
          <p class="note">공시한 대학이 없어 <strong>못 쟀습니다.</strong></p>
        </>
      )}
    </div>

    <div class="num">
      <p class="k">고교 학업중단률</p>
      {r.중단 ? (
        <>
          <p class="v">{r.중단.값}%</p>
          <p class="note">
            전국 평균 {r.중단.전국}% — {견줌말(r.중단)}<br />
            {r.중단.잰곳.toLocaleString()}곳 · 재학 {r.중단.대상.toLocaleString()}명 가운데 {r.중단.사람.toLocaleString()}명
          </p>
        </>
      ) : (
        <>
          <p class="v">—</p>
          <p class="note">이 지역 학교가 학교알리미 명단과 이어지지 않아 <strong>못 쟀습니다.</strong></p>
        </>
      )}
    </div>
  </div>

  <p class="note">
    ⚠ 세 숫자는 <strong>학교들의 평균이 아니라 사람 수로 잰 것</strong>입니다.
    졸업자 40명인 학교와 4,000명인 학교를 같은 무게로 두면 지역의 모습이 실제와 달라집니다.
    그래서 분자와 분모를 각각 더해서 나눴습니다.
  </p>
  <p class="note">
    ⛔ 이 숫자는 <strong>등수가 아닙니다.</strong> 지역끼리 견주라고 만든 것이 아니라,
    학교 한 곳을 볼 때 <strong>기준선</strong>으로 삼으시라고 놓은 것입니다.
  </p>

  <h2>고등학교는 어떻게 나뉘어 있나?</h2>
  <ul class="types">
    {
      유형목록.map(([이름, 수]) => (
        <li>
          <span>{이름}</span>
          <span class="note">{수.toLocaleString()}곳</span>
        </li>
      ))
    }
  </ul>

  <h2>문을 닫은 대학</h2>
  {
    r.폐교.length > 0 ? (
      <>
        <p>
          이 지역에서 <strong>{r.폐교.length}곳</strong>이 문을 닫았습니다.
          대학은 <strong>다니는 동안에도 문을 닫을 수 있습니다.</strong>
        </p>
        <ul class="types">
          {r.폐교.map((p: any) => (
            <li>
              <span>{p.이름}</span>
              <span class="note">
                {p.폐교년도}년 · {p.구분}
                {p.지역 !== r.짧은 && <> · {p.지역}</>}
              </span>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p>
        한국사학진흥재단 <strong>폐교 명단에는 이 지역 학교가 없습니다.</strong>
        <span class="note">
          {' '}— 「문을 닫은 곳이 없다」는 뜻은 아닙니다. 통합·개명은 폐교 명단에 들어오지 않습니다.
        </span>
      </p>
    )
  }

  {/**
    * 🔴 2번 지시(2026-08-08 12:4x · 라이브 실측) — **17장이 통째로 막다른 길이었다.**
    *
    *   ```
    *   /region/서울   안쪽 링크 9개 — 전부 차림표(/after · /work · /age · /major …)
    *                 학교 링크 0개 · 지역 한 벌 링크 0개
    *   ```
    *
    *   *「서울」을 눌러 들어온 사람이 서울 학교로도, 서울 구의 한 벌로도 못 갑니다*
    *
    * ⚠ 무료인 구와 파는 구의 **밑줄이 달라야 한다** — 학교 지면에서 쓴 규칙 그대로다.
    *   무료인데 「한 벌로 보기」라고 하면 돈 내는 줄 안다.
    * ⛔ 값(9,900원)을 여기 적지 않는다. 여기서 파는 것이 아니다 — **길만 놓는다.**
    */}
  {
    이시도구들.length > 0 && (
      <>
        <h2>{r.짧은} 안에서 골라 보기</h2>
        <p class="note">
          구·시 <strong>{이시도구들.length}곳</strong>입니다. 하나를 누르시면 그 안의 고등학교를{' '}
          <strong>한 표에 놓고</strong> 보실 수 있습니다 — 지금은 학교를 하나씩 검색해
          종이에 옮겨 적어야 합니다.
        </p>
        <ul class="types">
          {이시도구들.map((a: any) => (
            <li>
              <a href={href(`/report/area/${a.slug}`)}>{a.이름} 고등학교 {a.곳}곳</a>
              <span class="note">
                {a.한벌로팔만한가 ? '한 표에 · 퍼짐과 함께' : '무료로 열어 둔 지면'}
              </span>
            </li>
          ))}
        </ul>
        {이시도못가른곳 > 0 && (
          <p class="note">
            ⚠ 이 지역 학교 <strong>{이시도못가른곳}곳</strong>은 주소가 도로명으로 끝나{' '}
            <strong>구·시를 못 갈랐습니다.</strong> 위 목록에 안 들어 있습니다 —{' '}
            <strong>저희가 뺀 것이 아니라 못 가른 것</strong>입니다.
          </p>
        )}
      </>
    )
  }

  <h2>다음 걸음</h2>
  <ul class="types">
    <li><a href={href('/school')}>이 지역 고등학교 찾기</a></li>
    <li><a href={href('/university')}>대학 찾기</a></li>
    <li><a href={href('/region')}>다른 지역 보기</a></li>
  </ul>

  {/* 🔴 시·도 17장도 나가는 문이 없었다(2026-08-09 06:2x · 전수로 셈) */}
  <NextQuestionBrief 모은것="이 지역의 학교와 대학을 모은 자료" />

  <hr class="rule" />
  <p class="note">
    출처 — 고등학교 교육부 NEIS 교육정보 개방 포털({받은날}에 받았습니다) · 대학 대학알리미 · 학업중단 학교알리미(공공누리 1유형) ·
    폐교 한국사학진흥재단(이용허락범위 제한 없음).
    지역은 <strong>학교를 관할하는 교육청</strong> 기준이라 주소와 다를 수 있습니다.
  </p>
</HundredYear>

<style>
  .nums {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  @media (min-width: 34rem) {
    .nums { grid-template-columns: repeat(3, 1fr); }
  }
  .num {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.85rem 0.9rem;
  }
  .num .k { font-weight: 600; margin: 0 0 0.35rem; }
  .num .v {
    font-family: var(--serif);
    font-weight: 900;
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 0 0 0.35rem;
  }
  .types {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .types li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }
</style>
