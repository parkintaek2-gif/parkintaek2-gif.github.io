---
/**
 * /100y/idle-youth — 일도 구직도 안 하고 쉬는 2030, 몇 명일까
 *
 * 사장님이 공유한 「청년 예산 언박싱 2027」관계부처합동 보도자료(2026-08-28) 각주 —
 * 「(2030세대 쉬었음 인구) '26.7월 기준 65.1만명('16.7월 대비 +24만명 증가)」를
 * KOSIS 원자료(경제활동인구조사, 101/DT_1DA7147S)로 직접 검증했다(정확히 일치).
 * 정부 예산안(약속)이 아니라 이미 조사된 실측값이라 —11시 착수 규칙과 무관하게 —
 * 검증되는 대로 바로 지면화했다.
 *
 * ⚠ 「쉬었음」은 실업자와 다르다 — 구직활동조차 안 하는 비경제활동인구다. 「일하기 싫어서」로
 *   단정하지 않는다. 왜 쉬는지는 이 표에 없다(청년의삶실태조사 등 다른 조사의 몫).
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/idle-youth.json';

const 자료 = 원본 as any;
const 최근달 = 자료.최근달 as string;
const 최근달표시 = `${최근달.slice(0, 4)}년 ${Number(최근달.slice(4))}월`;
const 십년전달 = String(Number(최근달) - 1000).padStart(6, '0');
const 최근 = 자료.월별[최근달];
const 십년전 = 자료.월별[십년전달];

const 만명 = (천명: number) => `${Math.round(천명) / 10}만명`;

const 최근합만명 = Math.round(최근['2030_천명']) / 10;
const 증가만명 = Math.round(최근['2030_천명'] - 십년전['2030_천명']) / 10;

const 월들 = Object.keys(자료.월별).sort();
/** 7월끼리만 견준다 — 계절성(방학·졸업 시즌)이 있어 같은 달끼리 봐야 공정하다 */
const 매년7월 = 월들.filter((m) => m.endsWith('07'));

const desc =
  `통계청 경제활동인구조사를 그대로 옮겼습니다. ${최근달표시} 기준 20~30대 「쉬었음」 인구는 ` +
  `${만명(최근['2030_천명'])}으로, ${십년전달.slice(0,4)}년 같은 달보다 ${증가만명}만명 늘었습니다. ` +
  `2015년부터 매년 7월 수치를 나란히 볼 수 있습니다.`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '「쉬었음」이란',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '통계청 경제활동인구조사에서 취업도 안 하고 구직활동도 하지 않는 비경제활동인구 가운데 「쉬었음」으로 응답한 사람입니다. 실업자(구직활동을 한 사람)와는 다른 분류입니다. 왜 쉬는지는 이 조사만으로는 알 수 없습니다.',
      },
    },
    {
      '@type': 'Question',
      name: `${최근달표시} 20~30대 쉬었음 인구`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${최근달표시} 기준 20~30대 쉬었음 인구는 ${만명(최근['2030_천명'])}입니다(20대 ${만명(최근['20대_천명'])}, 30대 ${만명(최근['30대_천명'])}). 10년 전 같은 달보다 ${증가만명}만명 늘었습니다.`,
      },
    },
  ],
};
---

<HundredYear
  title={`쉬었음 청년 — ${최근달표시} 20~30대 ${만명(최근['2030_천명'])}`}
  description={desc}
  jsonLd={faqJsonLd}
>
  <h1>일도 구직도 안 하고<br />쉬는 2030, 몇 명일까요?</h1>
  <p class="sub">
    <strong>{최근달표시} 기준 20~30대 「쉬었음」 인구는 {만명(최근['2030_천명'])}</strong>입니다.
    {' '}{십년전달.slice(0,4)}년 같은 달보다 <strong>{증가만명}만명 늘었습니다.</strong>
  </p>

  <div class="answer">
    <p class="answer-label">{최근달표시} · 20~30대 「쉬었음」 인구</p>
    <p class="answer-num">{만명(최근['2030_천명'])}</p>
    <p class="answer-sub">20대 {만명(최근['20대_천명'])} · 30대 {만명(최근['30대_천명'])} — 통계청 경제활동인구조사</p>
  </div>

  <p class="note">
    ⚠ 「쉬었음」은 <strong>실업자가 아닙니다.</strong> 구직활동조차 하지 않은 비경제활동인구입니다.
    {' '}이 조사는 <strong>몇 명인지만</strong> 잽니다 — <strong>왜 쉬는지는 이 표에 없습니다.</strong>
    {' '}아파서·준비 중이라서·다른 이유로 쉬는 사람이 모두 섞여 있습니다.
  </p>

  <h2>해마다 7월, {매년7월[0].slice(0,4)}년부터 {매년7월[매년7월.length-1].slice(0,4)}년까지</h2>
  <p class="note">
    같은 달끼리 견줍니다 — 방학·졸업 시즌 때문에 달마다 값이 오르내려, 다른 달과 견주면
    {' '}계절 탓인지 실제 변화인지 구분이 안 됩니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>연도</th><th>20대</th><th>30대</th><th>20~30대 합</th></tr></thead>
      <tbody>
        {매년7월.map((월) => (
          <tr>
            <td>{월.slice(0,4)}년</td>
            <td>{만명(자료.월별[월]['20대_천명'])}</td>
            <td>{만명(자료.월별[월]['30대_천명'])}</td>
            <td><strong>{만명(자료.월별[월]['2030_천명'])}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    ⚠ <strong>이것은 전국 총량입니다.</strong> 같은 시기 20~30대 인구 자체도 줄고 있어,
    {' '}인구 대비 비율로 보면 늘어난 폭이 이 절대 인원수만큼 커 보이지 않을 수 있습니다.
    {' '}<strong>이것은 통계이지 당신이 아닙니다.</strong>
  </p>

  <p class="note">
    출처 — {자료.출처.이름} ({자료.출처.표}, {자료.출처.기준}). {자료.출처.이용허락범위}. 받은 날 {자료.받은때}.
  </p>
  <p class="note">
    이 지면을 만든 계기 — {자료.보도자료대조.인용문} 저희가 KOSIS 원자료로 직접 재본 결과
    {' '}<strong>{자료.보도자료대조.검산 === '일치' ? '보도자료 수치와 정확히 일치했습니다' : '보도자료 수치와 어긋났습니다'}</strong>.
  </p>

  <h2>자주 묻는 말</h2>
  {faqJsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    <a href="/first-job">← 처음 일자리는 언제 오고, 얼마나 갈까</a>
    <br />
    <a href="/wealth-gap">← 고령층은 청년층보다 자산이 몇 배 많을까요?</a>
    <br />
    <a href="/ages">← 나이로 보는 문 — 0세부터 100세까지 한 자리에</a>
  </p>

  <HundredAgeWalk 키="idle-youth" />
  <NextQuestionBrief 모은것="경제활동인구조사 자료" />
</HundredYear>
