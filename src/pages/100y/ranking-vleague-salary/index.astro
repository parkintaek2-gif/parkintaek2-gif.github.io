---
/**
 * /100y/ranking-vleague-salary — 순위는 공개한다, 그러나 전부는 아니다 (시리즈 · V리그 연봉 편)
 *
 * 🔴 docs/3번-순위콘텐트-지침.md 참고 — 사장님 지시(2026-08-31) 「국내외 순위를
 *   공개해...사람들이 관심 많은 모든 것」 이행. 한국배구연맹(KOVO) 2026-2027시즌
 *   선수 등록 연봉 발표(2026-06-30)를 그대로 인용한다. 100yearmap이 새로 순위를
 *   매기지 않는다. "순위"라는 낱말을 의도적으로 쓴다 — docs/금지말-대장.json 등록.
 *
 * ⭐ 톤: 부자가 되자는 말이 아니다(사장님 지시 7). 근로자 실질임금(ranking-kbo-salary와
 *   같은 계산)과 나란히 놓아 «규모»만 보여준다. 남녀부 샐러리캡 격차는 사실만 적고
 *   원인은 판정하지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/ranking-vleague-salary-2026.json';

const 자료 = 원본 as any;
const 순위출처 = 자료.순위출처;
const 남자 = 자료.남자부_1위;
const 여자 = 자료.여자부_1위;
const 캡 = 자료.샐러리캡;
const 실측 = 자료.실질임금대조;

const 만콤마 = (n: number) => Math.round(n).toLocaleString();

const desc =
  `${순위출처.이름}(${순위출처.발표일})에서 남자부 1위 ${남자.이름}(${남자.팀}) 선수가 ${남자.연봉_표시}으로, ` +
  `여자부 1위 ${여자.이름}(${여자.팀}) 선수가 ${여자.연봉_표시}으로 연봉킹·연봉퀸에 올랐습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '이 V리그 연봉 순위는 100yearmap이 매긴 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `아닙니다. ${순위출처.매체}(${순위출처.발표일})를 그대로 인용했습니다. ${순위출처['⚠원자료']}`,
      },
    },
    {
      '@type': 'Question',
      name: '왜 남자부와 여자부 1위 연봉이 다른가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `남자부 샐러리캡(${캡.남자부_억원}억원)이 여자부(${캡.여자부_억원}억원)보다 크기 때문입니다. 그 격차의 원인(시장 규모·중계권료 등)은 이 지면에서 다루지 않습니다.`,
      },
    },
    {
      '@type': 'Question',
      name: '이 지면은 부자가 되는 법을 알려주나요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '아닙니다. 이 지면은 연봉의 «규모»만 사실대로 보여줄 뿐, 선수의 능력을 평가하거나 부자가 되는 방법을 조언하지 않습니다.',
      },
    },
  ],
};
---

<HundredYear
  title={`${남자.이름} 연봉킹 ${남자.연봉_표시} — V리그 2026-2027시즌`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>
    {남자.이름} 연봉킹 {남자.연봉_표시}<br class="pcbr" />
    V리그 2026-2027시즌입니다
  </h1>

  <div class="warn">
    <p><strong>⚠ 이 순위는 저희가 매긴 게 아닙니다.</strong></p>
    <p class="note">
      {순위출처.이름}({순위출처.발표일})를 {순위출처.매체} 보도로 그대로 인용했습니다.
      {' '}{순위출처['⚠원자료']}
    </p>
  </div>

  <p class="sub">
    한국배구연맹(KOVO) 2026-2027시즌 선수 등록 결과, 남자부 연봉킹은
    {' '}<strong>{남자.이름}</strong>({남자.팀}) 선수 — <strong>{남자.연봉_표시}</strong>
    {' '}({남자.구성})이고, 여자부 연봉퀸은 <strong>{여자.이름}</strong>({여자.팀}) 선수 —
    {' '}<strong>{여자.연봉_표시}</strong>({여자.구성}, {여자.비고})입니다.
  </p>

  <h2>순위표</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>구분</th><th>선수</th><th>소속</th><th>연봉</th></tr></thead>
      <tbody>
        <tr><td>남자부 연봉킹</td><td>{남자.이름}</td><td>{남자.팀}</td><td><strong>{남자.연봉_표시}</strong></td></tr>
        <tr><td>여자부 연봉퀸</td><td>{여자.이름}</td><td>{여자.팀}</td><td><strong>{여자.연봉_표시}</strong></td></tr>
      </tbody>
    </table>
  </div>

  <h2>남녀부 샐러리캡은 왜 다를까요?</h2>
  <p>
    남자부 샐러리캡은 <strong>{캡.남자부_억원}억원</strong>({캡.남자부_구성}), 여자부는
    {' '}<strong>{캡.여자부_억원}억원</strong>({캡.여자부_구성})입니다. {캡.정의}
  </p>

  <h2>이 연봉은 근로자 실질임금 몇 년치와 같을까요?</h2>
  <p>
    100yearmap이 {실측.기준월} 국가데이터처 KOSIS 사업체노동력조사로 실측한 전산업
    근로자 실질임금은 연 환산 <strong>{만콤마(실측.연_환산_실질임금_원)}원</strong>입니다.
    {남자.이름} 선수의 연봉은 이 실질임금 <strong>{실측.남자부_배수}년치</strong>,
    {' '}{여자.이름} 선수의 연봉은 <strong>{실측.여자부_배수}년치</strong>와 같습니다.
  </p>
  <p class="note">⚠ {실측.정의}</p>

  <h2>이 지면이 말하지 않는 것</h2>
  <ul>
    {(자료.이자료가못가르는것 as string[]).map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="note">
    ⚠ <strong>이것은 통계이지 당신이 아닙니다.</strong> 이 지면은 연봉의 «규모»만
    {' '}보여줄 뿐, 선수를 평가하거나 부자가 되는 법을 조언하지 않습니다.
  </p>

  <h2>자주 묻는 말</h2>
  {jsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    출처 — 순위: {순위출처.매체}({순위출처.url}) · 실측: 국가데이터처 KOSIS 사업체노동력조사
    {' '}(같은 자료 — /real-wage · /ranking-kbo-salary)
  </p>

  <p class="note">
    <a href="/ranking-kbo-salary">← KBO 최고 연봉은 근로자 실질임금 몇 년치와 같을까요?</a>
    <br />
    <a href="/real-wage">← 근로자 실질임금, 얼마나 늘거나 줄었을까요?</a>
  </p>

  <HundredAgeWalk 키="ranking-vleague-salary" />

  <NextQuestionBrief 모은것="한국배구연맹(KOVO) 2026-2027시즌 연봉 발표 + 사업체노동력조사(KOSIS)" />

  {/* 2번의 자체(무쿠키·무IP) 댓글 시스템 */}
  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/ranking-vleague-salary"></div>
</HundredYear>
