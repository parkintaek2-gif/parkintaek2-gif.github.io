---
/**
 * /100y/cycling — 나이대별 자전거 참여율
 *
 * ⭐ 자동완성 실측(2026-08-25) — 「자전거 인구」류 신호 확인 후 등산·골프·헬스와 같은 표
 *   (KOSIS org 113 · DT_113_STBL_1029668)에서 「자전거사이클산악 자전거」 항목을 찾았다.
 *   golf 함정을 다시 확인했다 — 이 항목명은 2021~2025 5년 내내 동일하다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/cycling.json';

const 자료 = 원본 as any;
const 최신 = 자료.최신 as string;
const 해들 = 자료.해들 as string[];
const 이번 = 자료.해별[최신];
const 처음 = 자료.해별[해들[0]];
const 나이별 = 이번.나이별 as { 칸: string; 참여율: number }[];

/** ⛔ 등수를 매기지 않는다. 어느 나이대가 가장 많이 타는지는 값에서 찾는다 */
const 최고 = 나이별.reduce((a, b) => (b.참여율 != null && (a.참여율 == null || b.참여율 > a.참여율) ? b : a));

/** ⛔ 라이브러리를 쓰지 않는다. 선 하나라 손으로 그린다(다른 지면과 같은 방식) */
const 흐름 = (() => {
  const 값들 = 해들.map((해) => ({ 해, 률: 자료.해별[해].전국 as number }));
  const 최대 = Math.max(...값들.map((v) => v.률));
  const 최소 = Math.min(...값들.map((v) => v.률));
  const 폭 = 640, 높 = 190, 왼 = 10, 오 = 10, 위 = 26, 아래 = 30;
  const x = (i: number) => 왼 + (i * (폭 - 왼 - 오)) / (값들.length - 1);
  const y = (v: number) => 위 + ((최대 - v) * (높 - 위 - 아래)) / (최대 - 최소 || 1);
  const 선 = 값들.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v.률).toFixed(1)}`).join(' ');
  return { 값들, 최대, 최소, 폭, 높, 선, x, y };
})();

const desc =
  `${최신}년 기준 나이대별 자전거 참여율은 ${최고.칸}가 ${최고.참여율}%로 가장 높습니다. ` +
  `전국은 ${해들[0]}년 ${처음.전국}%에서 ${최신}년 ${이번.전국}%로 바뀌었습니다. 최근 1년 참여 경험 기준입니다.`;

/** ⭐ FAQPage — 6번이 검증한 지렛대. 자동완성 실측(「자전거 인구」) 그대로 질문으로 쓴다 */
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '자전거 인구',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${최신}년 기준 최근 1년간 자전거를 타 본 적이 있는 사람은 전국 ${이번.전국}%입니다. 나이대로는 ${최고.칸}가 ${최고.참여율}%로 가장 높습니다.`,
      },
    },
  ],
};
---

<HundredYear title={`나이대별 자전거 참여율 — ${최신}년 ${최고.칸} ${최고.참여율}%가 가장 높다`} description={desc} jsonLd={faqJsonLd} ogImage="https://100yearmap.com/og/cycling.png">
  <h1>자전거는 몇 살이<br />가장 많이 탈까요?</h1>
  <p class="sub">
    <strong>{최신}년 기준 {최고.칸}가 {최고.참여율}%로 가장 높습니다.</strong>
    {' '}전국은 {해들[0]}년 {처음.전국}%에서 {최신}년 {이번.전국}%로 바뀌었습니다.
  </p>

  <p class="note">
    ⚠ 「최근 1년간 자전거(사이클·산악자전거 포함)를 타 본 적이 있다」고 답한 사람의
    {' '}비율입니다(복수응답 — 다른 운동도 같이 했을 수 있습니다). 매일 타는 사람만이 아니라 <strong>한 번이라도 탄 사람</strong>도 들어갑니다.
  </p>

  <div class="answer">
    <p class="answer-label">{최신}년, 자전거 참여율이 가장 높은 나이대</p>
    <p class="answer-num">{최고.칸} {최고.참여율}%</p>
    <p class="answer-sub">전국 평균은 {이번.전국}%입니다</p>
  </div>

  <h2>나이대로 봅니다</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>나이대</th><th>{최신}년 참여율</th></tr></thead>
      <tbody>
        {나이별.map((r) => (
          <tr>
            <td>{r.칸}</td>
            <td>{r.참여율 == null ? '못 잼' : `${r.참여율}%`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    <strong>10대에서 가장 높고, 나이가 들수록 낮아집니다.</strong>
    {' '}70세이상은 {나이별.find((r) => r.칸 === '70세이상')?.참여율}%로 가장 낮습니다.
  </p>

  <h2>{해들.length}해 동안 전국은 어떻게 움직였나</h2>
  <div class="tablewrap">
    <svg viewBox={`0 0 ${흐름.폭} ${흐름.높}`} width="100%" style="max-width:640px" role="img"
         aria-label={`자전거 참여율(전국) — ${흐름.값들.map((v) => `${v.해}년 ${v.률}%`).join(', ')}`}>
      <path d={흐름.선} fill="none" stroke="#c9a84c" stroke-width="2.5" />
      {흐름.값들.map((v, i) => (
        <g>
          <circle cx={흐름.x(i)} cy={흐름.y(v.률)} r={i === 0 || v.해 === 최신 ? 4.5 : 2.5}
                  fill={i === 0 || v.해 === 최신 ? '#c9a84c' : '#8b8b96'} />
          {(i === 0 || v.해 === 최신) && (
            <text x={흐름.x(i)} y={흐름.y(v.률) - 10} text-anchor="middle" font-size="15" fill="currentColor">{v.률}%</text>
          )}
          <text x={흐름.x(i)} y={흐름.높 - 8} text-anchor="middle" font-size="13" fill="currentColor">{v.해}</text>
        </g>
      ))}
    </svg>
  </div>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    {(자료['⚠ 이 자료가 못 가르는 것'] as string[]).map((s) => <li>{s}</li>)}
  </ul>
  <p class="note">
    출처 — {자료.출처.기관} 「{자료.출처.표}」, {자료.출처.창구}에서 받았습니다
    {' '}({자료.출처.orgId} · {자료.출처.tblId}). 받은 날 {자료.만든날}.
  </p>

  {/* ⭐ 5번의 벤치마킹(2026-08-25, 1위 지면 실측) — 화면에 보이는 FAQ도 있어야 한다.
       구조화데이터만으론 손님 눈에 안 보인다. FAQPage와 같은 문답을 그대로 보여준다 */}
  <h2>자주 묻는 말</h2>
  {faqJsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    <a href="/hiking">← 같은 표에서 하나 더 — 등산은 몇 살이 가장 많이 갈까요?</a>
    <br />
    <a href="/golf">← 골프는 몇 살이 가장 많이 할까요?</a>
    <br />
    <a href="/workout">← 헬스는 몇 살이 가장 많이 할까요?</a>
    <br />
    <a href="/swimming">← 수영은 몇 살이 가장 많이 할까요?</a>
    <br />
    <a href="/soccer">← 축구는 몇 살이 가장 많이 할까요?</a>
    <br />
    <a href="/exercise">← 규칙적으로 운동하는 사람, 동호회로 하는 사람은 몇 %일까요?</a>
    <br />
    <a href="/ages">← 나이로 보는 문 — 0세부터 100세까지 한 자리에</a>
    <br />
    <a href="/community">← 커뮤니티 — 나이·처지로 나눈 방</a>
  </p>

  <NextQuestionBrief 모은것="나이대별 자전거 참여율 자료" />
</HundredYear>
