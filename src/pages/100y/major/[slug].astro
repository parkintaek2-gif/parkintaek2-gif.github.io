---
/**
 * /100y/major/[slug] — P1 학과 페이지 (스토리보드 P1)
 *
 * 화면 순서 (스토리보드 §P1 그대로)
 *   ❶ 한 줄 답      — 「1년 뒤에도 그 자리에 남아 있는 비율 82.0%」
 *   ❷ 세 숫자        — 유지취업률 1차·2차, 빠지는 폭
 *   ❸ 해석 한 문단   — 규칙이 만든 문장. LLM 이 쓰지 않는다
 *   ❹ 이 숫자는 어디서 왔나 (접어서)
 *   ❺ 우리 아이는 어떤가요?
 *
 * ⛔ 「전국 몇 위」를 절대 화면에 쓰지 않는다 (사장님 지시 2026-08-04).
 *    데이터에 `전국순위` 가 있지만 그것은 **정렬용**이다. 우리는 아이들을 줄세우지 않는다.
 *    「개설 학교가 몇 곳인가」는 규모의 사실이라 쓴다. 등수는 쓰지 않는다.
 *
 * ⚠ 취업 수치는 **특성화고 전체** 단위다. 이 학과 하나의 수치가 아니다.
 *    ❷ 바로 옆에 그 말을 붙인다. 안 붙이면 우리가 숫자로 거짓말하는 것이 된다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { href, lastSegment } from '../../../lib/hundredyear';
import { 학과연구, 전체편수 } from '../../../lib/research';
import majors from '../../../data/100yearmap/pages-major.json';
import 계열자료 from '../../../data/100yearmap/voc-series-outcomes.json';
import NextQuestion from '../../../components/NextQuestion.astro';
import schools from '../../../data/100yearmap/pages-school.json';

/** ⚠ 지면마다 다시 고르면 925번 돈다. 모듈 최상위에서 한 번만 고른다 */
const 관련연구 = 학과연구();

/** 페이지가 있는 학교만 링크한다.
 *  ⚠ 이 안전장치가 없어서 404 링크 406개가 나갈 뻔했다 (2026-08-04).
 *     원인은 고쳤지만, 원자료가 바뀌면 또 어긋난다. 확인은 여기 남겨 둔다. */
const HAS_SCHOOL = new Set((schools as any[]).map((s) => s.url));

export async function getStaticPaths() {
  return (majors as any[]).map((m) => ({
    params: { slug: lastSegment(m.url) },
    props: { major: m },
  }));
}

const { major } = Astro.props as { major: any };
/**
 * ⭐ **계열별 취업·진학** (2026-08-07) — 두 벌이 여덟 벌이 됐다.
 *
 * 여태 이 지면의 취업 숫자는 「특성화고 전체」 한 벌이라 925장이 **전부 같은 숫자**를 봤다.
 * 계열별(공업·상업·농림업·수산·해양·가사·예술·일반·실업·종합)은 잡을 수 있어 붙인다.
 *
 * 🔴 **학교별·학과별은 어디에도 없다.** 오늘 네 방향으로 확인했다 —
 *   학교알리미 28항목 · 항목52의 특성화고 4곳 · 유력 항목 8개×4개 연도 · KOSIS 직업계고 58표.
 *   ⛔ 그러니 이것도 **이 학과 하나의 값이 아니다.** 그 말을 숫자 옆에 적는다.
 *
 * ⚠ 재는 자가 위 유지취업률과 **다르다.** 위는 1~2년 뒤 자격 유지, 이건 졸업 시점 취업이다.
 *   ⛔ 두 숫자를 빼서 견주지 않게 문구를 넣는다.
 * ⚠ 취업률의 분모는 졸업자가 아니라 **취업대상자**(졸업자 − 진학 − 입대 − 제외)다.
 *   안 적으면 「졸업생 절반이 취업」으로 읽힌다.
 */
const 계열표 = new Map<string, any>(((계열자료 as any).자료 as any[]).map((r) => [r.계열, r]));
const 계열통계 = (계열자료 as any).통계;
const 계열출처 = (계열자료 as any).출처;
const 계열값 =
  major.계열 && major.계열 !== '미분류' ? (계열표.get(major.계열) ?? null) : null;

const 취업 = major.취업;
const 평균 = 취업?.전체평균;
const 수치 = 취업?.수치;

/** 82 와 82.0 이 한 화면에 섞이면 눈금이 다른 자로 잰 것처럼 보인다. 소수 한 자리로 맞춘다 */
const pct = (v: number | null | undefined) => (v == null ? '—' : `${v.toFixed(1)}%`);

/** 전체 평균과의 차이 — 등수가 아니라 「기준선에서 얼마나 떨어져 있나」다 */
const diff1 =
  수치?.['1차유지취업률'] != null && 평균?.['1차유지취업률'] != null
    ? +(수치['1차유지취업률'] - 평균['1차유지취업률']).toFixed(1)
    : null;

/** 상위 지역 — 「어디 가면 이 학과가 있나」는 진로 선택에 바로 쓰이는 사실 */
const 지역 = (major.지역분포 ?? []).slice(0, 8);
const 학교수 = major.전국개설교수 ?? major.학교?.length ?? 0;

/** ❸ 해석 문단 — 규칙으로 만든다. 숫자가 바뀌면 문장도 같이 바뀐다 */
const 해석 = 수치
  ? `특성화고를 졸업하고 취업한 100명 가운데, 1년 뒤에도 그 자리에 남아 있는 사람은 ` +
    `${Math.round(수치['1차유지취업률'])}명입니다. 2년 뒤에는 ${Math.round(수치['2차유지취업률'])}명이 됩니다. ` +
    `1년 사이에 ${Math.round(수치['1차유지취업률'] - 수치['2차유지취업률'])}명이 그 자리를 떠났습니다. ` +
    `「취업했다」로 끝나는 통계는 이 부분을 보여주지 않습니다.`
  : null;

/**
 * 🔴 **간판에 찾는 낱말이 없었다** (2026-08-09 10:4x · 2번 실측).
 *   「정보처리과 — 백년지도」 ⛔ 학생이 치는 말은 **「정보처리과 취업률」**이다.
 *
 * ⛔ 여기에 「진학률」을 붙이지 않는다 — 이 지면이 가진 것은 **유지취업률**이다.
 *   없는 것을 간판에 달면 눌러 들어온 사람이 빈손으로 나간다.
 * ⚠ 수치가 없는 학과에는 대신 **「개설 고등학교」**를 단다 —
 *   그건 우리가 실제로 가진 것이고(전국 몇 곳), 그것도 찾는 말이다.
 */
const 학과제목 = 수치
  ? `${major.title} 취업률`
  : `${major.title} 개설 고등학교`;

const desc = 수치
  ? `${major.title}는 전국 ${학교수.toLocaleString()}개 고등학교에 있습니다. ` +
    `이 길로 간 사람들이 졸업 1년 뒤에도 그 자리에 남아 있는 비율은 ${pct(수치['1차유지취업률'])}, 2년 뒤에는 ${pct(수치['2차유지취업률'])}입니다.`
  : `${major.title}가 개설된 전국 ${학교수.toLocaleString()}개 고등학교와 지역 분포를 정리했습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${major.title} — 개설 학교와 졸업 뒤의 실제`,
  description: desc,
  inLanguage: 'ko',
  isAccessibleForFree: true,
};
---

<HundredYear title={학과제목} description={desc} jsonLd={jsonLd}>
  <h1>{major.title}</h1>
  <p class="sub">
    전국 <strong>{학교수.toLocaleString()}</strong>개 고등학교에 있습니다
    {major.최다지역 && <> · 가장 많은 곳은 {major.최다지역}</>}
    {major.계열 && major.계열 !== '미분류' && <> · {major.계열}계열</>}
  </p>

  {
    수치 && (
      <>
        {/* ❶ 한 줄 답 — 첫 화면에서 이 문장 하나만 읽어도 답이 되게 한다 */}
        <div class="answer">
          <p class="answer-label">졸업하고 1년 뒤에도 그 자리에 남아 있는 비율</p>
          <p class="answer-num">{pct(수치['1차유지취업률'])}</p>
          <p class="answer-sub">
            전국 평균 {pct(평균['1차유지취업률'])}
            {diff1 !== null && diff1 !== 0 && (
              <> · 평균보다 {Math.abs(diff1)}%p {diff1 > 0 ? '높습니다' : '낮습니다'}</>
            )}
          </p>
        </div>

        {/* ❷ 세 숫자 + ⚠ 이 수치가 무엇의 수치인지 바로 밝힌다 */}
        <h2>졸업 뒤에 남는 사람</h2>
        <div class="nums">
          <div class="num">
            <span class="n">{pct(수치['1차유지취업률'])}</span>
            <span class="k">1년 뒤</span>
          </div>
          <div class="num">
            <span class="n">{pct(수치['2차유지취업률'])}</span>
            <span class="k">2년 뒤</span>
          </div>
          <div class="num drop">
            <span class="n">−{취업['1차에서2차로_빠지는폭']}%p</span>
            <span class="k">그 사이에 빠진 폭</span>
          </div>
        </div>
        <p class="warn">
          ⚠ 이 수치는 <strong>{취업.적용단위}</strong>의 수치입니다. {major.title} 하나만의 수치가
          아닙니다. 학과별로 나뉜 공식 통계는 아직 공개되지 않았습니다.
        </p>

        {/* ❸ 해석 — 숫자를 읽어주는 한 문단 */}
        <p>{해석}</p>

        {/* ⭐ 계열별 — 「특성화고 전체」보다 한 칸 잘게 나뉜 값. 여덟 벌이 됐다.
            ⛔ 여전히 이 학과 하나의 값은 아니다. 그 말을 표 바로 밑에 둔다. */}
        {계열값 && (
          <>
            <h2>{major.계열}계열은 졸업하고 어디로 갔나요?</h2>
            <div class="tablewrap">
              <table>
                <tbody>
                  <tr>
                    <th>졸업자</th>
                    <td>{계열값.졸업자.toLocaleString()}명</td>
                  </tr>
                  <tr>
                    <th>진학률</th>
                    <td>
                      {계열값.진학률}% <span class="note">({계열값.진학자.toLocaleString()}명)</span>
                    </td>
                  </tr>
                  <tr>
                    <th>취업률</th>
                    <td>
                      {계열값.취업률 != null ? (
                        <>
                          {계열값.취업률}%{' '}
                          <span class="note">
                            (취업 {계열값.취업자.toLocaleString()}명 ÷ 취업 대상{' '}
                            {계열값.취업대상자.toLocaleString()}명)
                          </span>
                        </>
                      ) : (
                        <>
                          취업 {계열값.취업자?.toLocaleString() ?? '—'}명{' '}
                          <span class="note">— {계열값.취업률못냄}</span>
                        </>
                      )}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            {/* 🔴 분모를 안 적으면 「졸업생 절반이 취업」으로 읽힌다 */}
            <p class="warn">
              ⚠ <strong>취업률의 분모는 졸업자가 아닙니다.</strong> 진학·입대한 사람을 뺀{' '}
              <strong>취업 대상</strong>으로 나눈 값입니다. 그래서 진학률과 더해도 100%가 되지
              않습니다.
            </p>
            <p class="warn">
              ⚠ 이 수치는 <strong>{major.계열}계열 전체</strong>의 값입니다. {major.title} 하나의
              값이 아닙니다. <strong>학교별·학과별로 나뉜 통계는 어디에도 공개돼 있지 않습니다</strong>{' '}
              — 저희가 학교알리미 28개 항목과 KOSIS 직업계고 58개 표를 다 열어 확인했습니다.
            </p>
            <p class="warn">
              ⛔ <strong>위의 유지취업률과 빼서 견주지 마십시오.</strong> 위는 1~2년 뒤에도 자리가
              유지된 비율이고, 이것은 졸업 시점에 취업한 비율입니다. 재는 자가 다릅니다.
            </p>
            <details>
              <summary>이 숫자는 어디서 왔나?</summary>
              <div class="card">
                <p class="note">
                  <strong>출처</strong> {계열출처.이름}<br />
                  <strong>통계표</strong> {계열출처.표} 「{계열출처.표이름}」<br />
                  <strong>기준연도</strong> {계열통계.기준연도}년
                </p>
                <p class="note">
                  <strong>취업률</strong> {계열출처.취업률정의}<br />
                  <strong>진학률</strong> {계열출처.진학률정의}
                </p>
                <p class="note">
                  ⚠ 저희가 계산한 값이 아니라 <strong>공표된 비율</strong>입니다. 다만 사람 수로
                  나눠 다시 맞춰 봤고, {계열통계.계열수}가지 계열 전부 맞았습니다.
                </p>
              </div>
            </details>
          </>
        )}

        {/* ❹ 어디서 왔나 — 접어 둔다. 필요한 사람만 편다 */}
        <details>
          <summary>이 숫자는 어디서 왔나?</summary>
          <div class="card">
            <p class="note">
              <strong>출처</strong> {취업.출처}<br />
              <strong>통계표</strong> {취업.표}<br />
              <strong>기준연도</strong> {취업.기준연도}년<br />
              <strong>대상</strong> {취업.적용단위} 졸업자 {수치.졸업자?.toLocaleString()}명
            </p>
            <p class="note">{취업['⚠단위설명']}</p>
            <p class="note">
              학교·학과 목록은 교육부 NEIS 교육정보 개방 포털에서 받았습니다.
              {major.계열추정 && (
                <>
                  {' '}계열({major.계열})은 <strong>학과 이름을 보고 저희가 추정</strong>한 것으로,
                  원자료에 있던 값이 아닙니다.
                </>
              )}
            </p>
          </div>
        </details>
      </>
    )
  }

  {/* 지역 분포 — 「어디로 가야 하나」에 바로 쓰인다 */}
  {
    지역.length > 0 && (
      <>
        <h2>어느 지역에 있나?</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th>지역</th>
                <th>학교 수</th>
              </tr>
            </thead>
            <tbody>
              {지역.map((r: any) => (
                <tr>
                  <td>{r.지역}</td>
                  <td>{r.수}곳</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {major.지역분포.length > 지역.length && (
          <p class="note">그 밖에 {major.지역분포.length - 지역.length}개 지역에도 있습니다.</p>
        )}
      </>
    )
  }

  {/* 학교 목록 — 길면 접는다. 모바일에서 스크롤이 끝나지 않으면 아무도 안 읽는다 */}
  {
    major.학교?.length > 0 && (
      <>
        <h2>이 학과가 있는 학교</h2>
        <details open={major.학교.length <= 20}>
          <summary>{major.학교.length.toLocaleString()}곳 보기</summary>
          <ul class="schools">
            {major.학교.map((s: any) => (
              <li>
                {HAS_SCHOOL.has(s.url) ? (
                  <a href={href(s.url)}>{s.name}</a>
                ) : (
                  <span>{s.name}</span>
                )}
                <span class="note">
                  {' '}
                  {s.지역} · {s.고교유형} · {s.설립}
                </span>
              </li>
            ))}
          </ul>
        </details>
      </>
    )
  }

  {/* ⭐ 숫자 다음에 오는 질문은 「왜 그렇게 되나?」다. 그건 우리가 못 쓴다 — 가리키기만 한다.
      ⛔ **이 학과에 대한 연구가 아니다.** 주제가 같을 뿐이라고 반드시 적는다 */}
  {
    관련연구.length > 0 && (
      <>
        <hr class="rule" />
        <h2>왜 그렇게 되는지를 다룬 연구</h2>
        <p class="note">
          ⚠ <strong>이 학과에 대한 연구가 아닙니다.</strong> 직업교육과 그 뒤의 노동시장을
          다룬 것이라 주제가 닿을 뿐입니다. 저희가 쓴 글이 아니고, 누르면 원문으로 갑니다.
        </p>
        <ul class="papers">
          {관련연구.map((r) => (
            <li>
              <a href={r.url} rel="nofollow noopener" target="_blank">{r.제목}</a>
              <span class="note">
                {r.발행일?.slice(0, 7).replace('-', '년 ') ?? '발행일 미상'}월
                {r.저자.length > 0 && <> · {r.저자.join(', ')}</>}
                {r.종류 && <> · {r.종류}</>}
              </span>
            </li>
          ))}
        </ul>
        <p class="note">
          <a href="/research">국책연구 {전체편수}편 전부 보기 →</a>
        </p>
      </>
    )
  }

  {/* ❺ 다음 걸음 — 2026-08-07 에 공통 조각으로 바꿨다.
