---
/**
 * K Culture Wire — **우리 자가 «못 보는» 사람이 몇인가.** (`/cannot-see`)
 *
 * 🔴 이 지면은 우리 방법의 «구멍»을 우리가 재서 내놓는 것이다.
 *   우리 관심 축은 영문 위키백과 열람수로 서 있다. 그런데 위키데이터에 있는 한국 가수의
 *   73.7% 는 영문 문서가 «아예 없다» — 그 사람들은 우리 표에 한 줄도 안 생긴다.
 *   ⇒ 우리가 「가장 많이 읽힌 한국 스타」라고 말할 때, 그것은 «영문 문서가 있는 사람 중»이다.
 *
 * ⭐ 회사의 셋째 자리(리스크관리)가 지면에서 하는 일이 이것이다 —
 *   「그것이 틀렸을 때 무엇을 잃는가」. 강령 「못 잰 것은 못 쟀다고 적는다」의 실물이다.
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 「영문 문서가 없으면 안 유명하다」고 말하지 않는다. 우리가 «못 보는» 것뿐이다.
 * ⛔ 다섯 줄을 더하지 않는다 — 한 사람이 여러 직업을 가질 수 있어 겹친다(자료가 그렇게 경고한다).
 * ⛔ 위키데이터를 «전수»라고 말하지 않는다. 그것도 사람이 적은 것이라 빠진 사람이 또 있다.
 *   그래서 이 수는 «바닥값»이다 — 실제로 못 보는 사람은 이보다 많다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-kpop-invisible.json';

const 줄들 = (d.rows as any[]) ?? [];

/* 🔴 제목에 박은 수가 자료와 어긋나면 빌드를 세운다 */
const 가수 = 줄들.find((r) => r.key === 'singers' || r.label === 'Singers');
if (!가수) throw new Error('Singers 줄을 자료에서 못 찾았다 — 제목이 그 수를 말한다.');
if (Math.round(가수.missingPc) !== 74) {
  throw new Error(`제목이 「넷 중 셋」이라 말하는데 자료는 ${가수.missingPc}% 다.`);
}

const 쉼표 = (n: number) => Number(n).toLocaleString('en-US');
const 많은순 = [...줄들].sort((a, b) => b.missingPc - a.missingPc);
const 가장큰 = 많은순[0];
const 가장작은 = 많은순[많은순.length - 1];

const TITLE = 'Three in four Korean singers have no English Wikipedia article — so our numbers cannot see them';
const DESC =
  `Wikidata lists ${쉼표(가수.all)} Korean singers. Only ${쉼표(가수.withEn)} have an English `
  + `Wikipedia article, so ${쉼표(가수.missing)} of them (${가수.missingPc}%) produce no row in any `
  + 'reading measure we publish. This page counts the hole in our own method.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/'],
  variableMeasured: ['acts recorded in Wikidata', 'acts with an English Wikipedia article'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/cannot-see">
  <h1>{TITLE}</h1>

  <p class="lead">
    Every reading figure we publish starts from an English Wikipedia page view. An act with no
    English article produces no row — not a zero, no row at all. This page counts how many that is.
  </p>

  <p class="walk">
    <b>Next:</b>{' '}
    <a href="/most-read">The most-read Korean stars — of the ones we can see</a> &middot;{' '}
    <a href="/name-spelled">Which spelling readers land on</a> &middot;{' '}
    <a href="/data">Everything we publish</a>
  </p>

  <div class="scroll-x">
    <table>
      <caption>Recorded in Wikidata, against what has an English Wikipedia article</caption>
      <thead>
        <tr>
          <th>Kind</th>
          <th>In Wikidata</th>
          <th>Has an English article</th>
          <th>Has none</th>
          <th>Share we cannot see</th>
        </tr>
      </thead>
      <tbody>
        {많은순.map((r) => (
          <tr class={r.key === 'singers' ? 'hit' : undefined}>
            <th scope="row">{r.label}</th>
            <td>{쉼표(r.all)}</td>
            <td>{쉼표(r.withEn)}</td>
            <td>{쉼표(r.missing)}</td>
            <td>{r.missingPc}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="q">
    <b>Do not add these rows together.</b> One person can hold several of these occupations, so the
    rows overlap. The dataset says so itself, and we repeat it here rather than publishing a total
    that would be wrong.
  </p>

  <h2>What the gap does to our other pages</h2>

  <p>
    When we write &ldquo;the most-read Korean stars,&rdquo; the honest reading is <b>the most-read
    of those with an English Wikipedia article</b>. For {가장큰.label.toLowerCase()} that leaves
    {' '}{가장큰.missingPc}% outside the frame; for {가장작은.label.toLowerCase()} only
    {' '}{가장작은.missingPc}%.
  </p>

  <p>
    The gap is not evenly spread, which matters more than its size. A measure that misses
    {' '}{가장큰.missingPc}% of one kind and {가장작은.missingPc}% of another does not just shrink the
    picture — <b>it tilts it.</b> Anything we say about, for example, singers against rappers
    carries that tilt.
  </p>

  <h2>And this number is a floor</h2>

  <p>
    Wikidata is not a census either. It is written by people, and acts missing from it are missing
    from this count too. So the true number of Korean acts our reading measures cannot see is
    <b> higher than the figures above</b>, not lower.
  </p>

  <p class="q">
    We publish this because a measure that hides its own blind spot is worse than no measure. If a
    figure of ours ever surprises you, this page is the first thing to check it against.
  </p>

  <KcwMethodLimits
    method={{
      'What this is': 'A count of Korean music acts recorded in Wikidata against how many of them '
        + 'have an English Wikipedia article, which is the source every reading figure we publish rests on.',
      Source: 'Wikidata — Korean musical groups and people with Korean citizenship in four music occupations',
      'Why it matters': 'An act with no English article produces no row in our reading data. It is '
        + 'absent, not zero.',
    }}
    limitation={{
      'What this is not': 'Not a statement that anyone is unknown. It says only that we cannot see '
        + 'them. Wikidata is itself incomplete, so every share here is a floor.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    <li>Whether an act without an English article is widely known in Korea or anywhere else. We measure visibility to our own instrument, nothing more.</li>
    <li>How many acts are missing from Wikidata as well. That number is unknown and would raise every share on this page.</li>
    <li>Korean Wikipedia coverage. We hold no matched count for it, so we do not report one.</li>
  </ul>

  <KcwRelatedArticles page="/cannot-see" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  tr.hit td, tr.hit th { background: #fff8e6; font-weight: 600; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    tr.hit td, tr.hit th { background: #2b2617; }
  }
</style>
