---
/**
 * K Culture Wire — **캐스팅 기사가 영어권 독자를 움직이나.** (`/casting-news-reading`)
 *
 * 🔴 K드라마 영문 매체가 가장 자주 내는 갈래가 «캐스팅 기사»다. 그런데 그 기사가
 *   읽는 사람을 실제로 움직이는지는 아무도 안 잰다. 우리 축이 그것을 잴 수 있다.
 *
 * ⭐ 재 보니 창이 다 찬 여섯 건 가운데 **오른 것이 하나도 없었다.** 넷은 그대로, 둘은 내렸다.
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 「기사가 소용없다」고 말하지 않는다. 우리가 잰 것은 «영문 위키백과 열람» 하나다.
 * ⛔ 인과를 말하지 않는다 — 같은 날 다른 일이 얼마든지 있다.
 * ⛔ 여섯 건을 「업계가 이렇다」로 부풀리지 않는다. 표본 크기를 첫 화면에 적는다.
 * ⛔ 창이 덜 찬 건을 다 찬 건과 같이 세지 않는다 — 따로 적고 며칠 뒤 다시 잰다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-casting-news-reading.json';

type 줄 = {
  person: string; description: string; date: string; outlet: string;
  before: number | null; after: number | null; beforeDays: number; afterDays: number;
  onTheDay: number | null; windowComplete: boolean; moved: string | null; ratio: number | null;
};

const 모두 = (d.rows as any[]) as 줄[];
const 다찬것 = 모두.filter((r) => r.windowComplete && r.moved);
const 아직 = 모두.filter((r) => !r.windowComplete || !r.moved);
const 오름 = 다찬것.filter((r) => r.moved === 'up');
const 그대로 = 다찬것.filter((r) => r.moved === 'flat');
const 내림 = 다찬것.filter((r) => r.moved === 'down');

/* 🔴 제목이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (다찬것.length !== 6) throw new Error(`창이 다 찬 건이 여섯이 아니라 ${다찬것.length}건이다 — 제목이 「여섯」이라 말한다.`);
/**
 * 🔴 **수집기가 센 수와 지면이 센 수를 맞대 본다.** 같은 것을 두 곳에서 세면 반드시 갈라진다.
 * ⭐ 이 두 줄이 `check-data-keys-shown` 의 요구(지면이 그 열쇠를 실제로 쓰나)도 함께 만족시킨다 —
 *   자료의 칸을 «검사에 쓰는 것»도 그 칸을 쓰는 것이다. 안 쓰는 칸을 자료에 두지 않는다.
 */
if (d.measurable !== 다찬것.length) {
  throw new Error(`자료는 잰 것 ${d.measurable}건이라 하는데 지면은 ${다찬것.length}건으로 센다.`);
}
if (d.counts.up !== 오름.length || d.counts.flat !== 그대로.length || d.counts.down !== 내림.length) {
  throw new Error(`자료의 셈과 지면의 셈이 다르다 — 자료 ${JSON.stringify(d.counts)}`);
}
if (오름.length !== 0) throw new Error(`오른 건이 ${오름.length}건 생겼다 — 제목이 「하나도 없다」라 말한다. 다시 써야 한다.`);
if (오름.length + 그대로.length + 내림.length !== 다찬것.length) throw new Error('세 갈래를 더해도 여섯이 아니다.');

const 쉼표 = (n: number | null) => (n === null ? '—' : Number(n).toLocaleString('en-US'));
const 큰순 = [...다찬것].sort((a, b) => (b.ratio ?? 0) - (a.ratio ?? 0));

const TITLE = 'Six K-drama casting stories, and not one moved English reading up';
const DESC =
  'K-drama outlets publish casting news constantly. We counted daily English Wikipedia reads for '
  + `every named performer, ${다찬것.length} stories with a complete window: ${그대로.length} held level, `
  + `${내림.length} were read less afterwards, and none rose. Six is a small number and we say so.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/'],
  variableMeasured: ['daily English Wikipedia pageviews', 'median before a casting story', 'median after'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/casting-news-reading">
  <h1>{TITLE}</h1>

  <p class="lead">
    Casting announcements are the most-published kind of K-drama story in English. Whether anybody
    goes and reads about the actor afterwards is a separate question, and it is one we can count.
  </p>

  <p class="walk">
    <b>Next:</b>{' '}
    <a href="/most-read">The most-read Korean stars</a> &middot;{' '}
    <a href="/rookie-reading">Whether a debut brings English readers</a> &middot;{' '}
    <a href="/cannot-see">Who our numbers cannot see</a>
  </p>

  <p class="q">
    <b>Six stories is a small number.</b> It is every casting story our collector held with a full
    seven days of reading on the other side of it. We publish the count rather than waiting for a
    tidier one, and we will add to it as more stories come through.
  </p>

  <div class="scroll-x">
    <table>
      <caption>
        Daily English Wikipedia reads &mdash; median of the 14 days before the story against the
        7 days after. The day of the story is in neither window.
      </caption>
      <thead>
        <tr>
          <th>Performer</th>
          <th>Story</th>
          <th>Before</th>
          <th>After</th>
          <th>Change (&times;)</th>
        </tr>
      </thead>
      <tbody>
        {큰순.map((r) => (
          <tr class={r.moved === 'down' ? 'down' : undefined}>
            <th scope="row">{r.person}<span class="note">{r.description}</span></th>
            <td>{r.date}<span class="note">{r.outlet}</span></td>
            <td>{쉼표(r.before)}</td>
            <td>{쉼표(r.after)}</td>
            {/* 🔴 칸에는 «수만» 둔다 — 「0.44×」 처럼 붙이면 표 약속 자가 그 수를 못 찾는다.
                배수라는 것은 머리칸이 말한다. */}
            <td>{r.ratio}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Nothing went up. {그대로.length} held level, {내림.length} fell</h2>

  <p>
    The largest movement in the set is downward:
    {' '}<b>{큰순[큰순.length - 1].person}</b> was read {쉼표(큰순[큰순.length - 1].before)} times a day
    before the story naming them and {쉼표(큰순[큰순.length - 1].after)} a day after &mdash;
    {' '}{큰순[큰순.length - 1].ratio}&times;. <b>That is not evidence the story hurt anything</b>, and
    we are not going to say it is. We hold reader counts and dates. Why a person's reading was
    falling that week is not in our data, so we do not offer a reason for it.
  </p>

  <p>
    <b>That is the point.</b> A casting announcement lands inside whatever was already happening to
    a person's readership. In these six cases, whatever was already happening was the larger of the
    two: if the story moved anyone, it moved fewer people than the week's ordinary drift did.
  </p>

  <h2>What we are still waiting on</h2>

  <p>
    {d.notYetMeasurable} more names are in the set without a complete window. Wikimedia fills its counts in
    about a day late, and a story published in the last week does not yet have seven days after it.
  </p>

  <ul class="wait">
    {아직.map((r) => (
      <li>
        <b>{r.person}</b> &mdash; {r.date}, {r.outlet}.
        {r.afterDays === 0 ? ' No days after it yet.' : ` ${r.afterDays} of 7 days so far.`}
      </li>
    ))}
  </ul>

  <p class="q">
    We list them rather than dropping them. A measure that quietly reports only the cases that
    finished in time is a measure that chose its own answer.
  </p>

  <KcwMethodLimits
    method={{
      'What this is': 'For each performer named in a K-drama casting story, the median of their daily '
        + 'English Wikipedia reads in the 14 days before it, against the median of the 7 days after.',
      Source: d.source,
      'Which stories': d.newsSource,
      'Why a band': 'A change inside plus or minus 20% is recorded as level. Daily reading moves that '
        + 'much on its own, so anything smaller would be reading noise as a finding.',
    }}
    limitation={{
      'What this is not': 'Not a causal claim, and not a verdict on any outlet. Other things happen on '
        + 'the same days and we cannot separate them. Six complete cases is a small set, stated as six.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    {d.notMeasured.map((s: string) => <li>{s}</li>)}
  </ul>

  {/* 🔴 아예 «잴 수 없었던» 이름이 생기면 그것도 낸다 — 지금은 없다.
      ⛔ 자료에만 두고 지면에 안 내면, 이름이 조용히 빠져도 아무도 모른다.
      영문 문서가 없는 배우가 이 목록에 들어오는 날 이 칸이 채워진다(/cannot-see 와 같은 갈래). */}
  {d.unmeasured.length > 0 && (
    <>
      <h2>Names we could not measure at all</h2>
      <ul>{d.unmeasured.map((s: string) => <li>{s}</li>)}</ul>
    </>
  )}

  <p class="asof">Measured {d.measuredAt}. {d.measures}</p>

  <KcwRelatedArticles page="/casting-news-reading" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; vertical-align: top; }
  th { background: #fafbfc; }
  .note { display: block; font-weight: 400; font-size: .8rem; color: #666; }
  tr.down td, tr.down th { background: #fbf3f3; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .wait { font-size: .95rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    .note, .asof { color: #999; }
    tr.down td, tr.down th { background: #2a1c1c; }
  }
</style>
