---
/**
 * K Culture Wire — **팬 투표의 「연속 1위 주차」와 «읽힌 것»이 같이 가나.**
 * (`/streak-vs-read`)
 *
 * ── 씨앗 ────────────────────────────────────────────────────
 * 2026-09-05 신문 제목 수집에서 나왔다. 스타뉴스 10건 중 «넷»이 「연속 1위 주차」였다 —
 * 「진 마이원픽 131주 연속 1위」·「진 아이돌픽 67주 연속 1위」·「지민 누적 220회 1위」.
 * ⭐ 아무도 답하지 않는 물음: **그 주들에 «실제로 가장 많이 읽힌» 사람도 같은 사람이었나?**
 *
 * ── 🔴 이 지면이 가장 조심하는 것 ────────────────────────────
 * ⛔ **「누가 더 인기 있나」로 읽히면 이 지면은 실패다.** 우리는 인기 순위를 만들지 않는다.
 * ⛔ **팬 투표 앱의 순위를 검산하는 것이 아니다.** 그 앱의 주별 1위 명단이 우리에게 없다.
 *   그래서 「131주가 맞다/틀렸다」를 말하지 않는다. 그 말을 지면에 못박는다.
 * ⛔ **「1위였던 주 0주」를 「아무도 안 읽는다」로 읽히게 두지 않는다.** 0주인 넷도
 *   주마다 1.2만~1.4만회 읽힌다. 그래서 «주 중간값»을 같은 표에 나란히 싣는다.
 *   순위만 싣고 크기를 안 싣는 표는 사람을 잘못 읽게 만든다.
 * ⛔ 견주는 무리를 «우리가 골랐다». 바꾸면 답이 바뀐다 — 지면에 적는다.
 *
 * ── ⚠ 이 자료를 만들며 세 번 틀렸다. 지면에도 적는다 ──────────
 * 위키백과 제목을 손으로 적었더니 RM·Suga 를 6~12배 적게 셌고, Jungkook 은 «본 지면이
 * 아니라 넘겨주기»를 세고 있었다. 셋을 고치자 결론이 두 번 바뀌었다
 * (V 최장 연속 77주 → 27주 · Jungkook 34주 → 58주).
 * ⭐ 그래서 지면에 「제목 몇 개를 더했나」를 줄마다 싣는다 — 손님이 우리 셈을 볼 수 있게.
 *
 * 🔴 Astro 앞말은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다 — 붙여야 할 곳에 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/kcw-streak-check.json';

const 수 = (n: number) => Number(n).toLocaleString('en-US');
const 사람들 = d.사람들 ?? [];
const 견준주 = d.기간?.견준주 ?? 0;
const 주장 = d.신문이옮긴주장 ?? {};

/* 1위였던 주가 가장 많은 사람과, 주 중간값이 가장 높은 사람 — 둘이 다른 것이 이 지면의 알맹이다 */
const 주많은이 = [...사람들].sort((a: any, b: any) => b.일위주 - a.일위주)[0];
const 중간높은이 = [...사람들].sort((a: any, b: any) => (b.주중간 ?? 0) - (a.주중간 ?? 0))[0];
const 둘이다르다 = 주많은이?.이름 !== 중간높은이?.이름;
const 그사람 = 사람들.find((x: any) => x.이름 === 주장.누가);
const 일위없는이 = 사람들.filter((x: any) => x.일위주 === 0);
const 일위없는중간최저 = 일위없는이.length ? Math.min(...일위없는이.map((x: any) => x.주중간 ?? 0)) : null;
const 일위없는중간최고 = 일위없는이.length ? Math.max(...일위없는이.map((x: any) => x.주중간 ?? 0)) : null;
const 제목합 = 사람들.reduce((a: number, x: any) => a + (x.받은제목 ?? 0), 0);

/**
 * 🔴 [2026-09-05 02:4x] **렌더해서 읽고 넷을 잡았다. 넷 다 「우리 안쪽 것을 손님에게」였다.**
 *  1. 앱 이름이 「MyOnePick (마이원픽)」으로 찍혔다 — 영문 지면에 우리말이 나갔다
 *  2. `⛔` 가 본문에 찍혔다 — 그것은 우리 문서의 표기이지 손님에게 쓰는 글자가 아니다
 *  3. 창이 「20230601 to 20260901」로 찍혔다 — 그것은 파일 이름 꼴이지 날짜가 아니다
 *  4. 잰 때가 「2026. 9. 5. 오전 2:33:53」으로 찍혔다 — 우리말 시각 꼴이다
 * ⛔ 넷 다 자료에는 잘못이 없다. **그릇이 자료를 그대로 부어 놓은 것**이 잘못이다.
 *   사장님 지시 「만들면 렌더해서 눈으로 본다」가 없었으면 넷 다 나갔다.
 */
const 앱이름 = String(주장.어디서 ?? '').replace(/\s*\([^)]*[가-힣][^)]*\)\s*/g, ' ')
  .replace(/\s*—.*$/, '').trim() || 'a Korean fan-vote app';
const 읽는날 = (yyyymmdd: string | null | undefined) => {
  const m = String(yyyymmdd ?? '').match(/^(\d{4})(\d{2})(\d{2})$/);
  if (!m) return String(yyyymmdd ?? '');            // 꼴이 다르면 손대지 않는다
  return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]))
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
/* 잰 때는 우리말 글자로 적혀 있다. 손님에게는 «날짜»만 영문으로 낸다 */
const 잰때글 = (() => {
  const m = String(d.잰때 ?? '').match(/(\d{4})\.\s*(\d{1,2})\.\s*(\d{1,2})/);
  if (!m) return 'the date on this page';
  return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]))
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
})();

/**
 * ⛔ 제목에 박은 이름이 자료에 있는지 빌드가 검사한다.
 *   제목은 색인에 남으므로 자료에서 계산하지 않는다 — 그러나 «틀린 채로» 남게 두지도 않는다.
 */
const 제목에박은이름 = ['V', 'Jung Kook'];
const 자료의이름 = 사람들.map((x: any) => String(x.이름));
/* ⚠ 첫 판은 공백만 지우고 견줬다 — 그러면 「Jung Kook」과 「Jungkook」이 대소문자로 갈려
   빌드가 죽는다. 검사가 «옳은 것»을 막으면 그것도 결함이다. 대소문자·기호를 다 깎아 견준다 */
const 깎기 = (x: string) => String(x).toLowerCase().replace(/[^a-z0-9]/g, '');
const 못찾은 = 제목에박은이름.filter((n) => !자료의이름.some((m) => 깎기(m) === 깎기(n)));
if (못찾은.length) {
  throw new Error([
    '🔴 /streak-vs-read — 제목에 박은 이름이 자료에 없다: ' + 못찾은.join(', '),
    '   자료에 있는 이름: ' + 자료의이름.join(', '),
    '   ⛔ 제목을 고치거나 자료를 다시 재십시오.',
  ].join('\n'));
}

const TITLE = 'V led 108 weeks. Jung Kook was read more per week';
/* ⚠ 첫 판이 156자였다 — 155자 한도를 넘었다. 줄였다 */
const DESC = `Which BTS member the English Wikipedia read most, week by week, for ${견준주} weeks. `
  + `V led ${주많은이?.일위주}; Jung Kook had the higher median week. Not a popularity ranking.`;

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/', 'https://en.wikipedia.org/w/api.php'],
  temporalCoverage: `${d.기간?.시작}/${d.기간?.끝}`,
}];
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/streak-vs-read">
  <h1>{TITLE}</h1>

  <p class="lead">
    Korean entertainment outlets report fan-vote streaks in weeks: one member described this week
    as number one for <b>{주장.몇주}</b> straight weeks on one voting app. We hold something
    different &mdash; how many people opened each member&rsquo;s English Wikipedia page, week by
    week, for <b>{견준주}</b> weeks. Two yardsticks, and they do not agree.
  </p>

  <div class="warn">
    <p>
      <strong>We are not checking the app&rsquo;s number.</strong> We do not have that app&rsquo;s
      weekly winners, so nothing here says the {주장.몇주}-week streak is right or wrong. A vote is
      something people press. A page view is something people look up. They measure different acts.
    </p>
    <p>
      <strong>And this is not a popularity ranking.</strong> Reading is not liking. Every member
      here is read tens of thousands of times a week &mdash; the members who never led a single week
      still sit between {수(일위없는중간최저)} and {수(일위없는중간최고)} views in a median week. A table of
      ranks without sizes misleads, so both are in the same table below.
    </p>
  </div>

  <h2>Which member the English Wikipedia read most, week by week</h2>
  <p class="note">
    {견준주} weeks, {d.기간?.시작?.slice(0, 4)}&ndash;{d.기간?.끝?.slice(0, 4)}.
    Ordered by weeks led. <strong>Ties count for everyone tied.</strong>
  </p>
  {/* 🔴 [2026-09-05] 표 약속 검사가 기사 v-led-108… 을 「171 이 지면에 없다」로 잡았다.
      171 은 «머리 칸»의 글 안에만 있었고 값 칸에는 없었다 — 자는 값 칸을 본다.
      ⛔ 자를 느슨하게 고쳐 통과시키려다 되돌렸다. 9/4 에 92편을 재고 «일부러» 조인 규칙이었다.
      ✅ 옳은 고침은 지면 쪽이다 — 세는 창을 값으로 한 칸 낸다. 손님에게도 이 편이 낫다. */}
  <table class="span">
    <caption>The window this table counts</caption>
    <thead><tr><th>Measure</th><th>Count</th></tr></thead>
    <tbody>
      <tr><td>Complete weeks counted</td><td>{견준주}</td></tr>
      <tr><td>Members compared</td><td>{d.사람들?.length ?? 7}</td></tr>
    </tbody>
  </table>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Member</th>
          <th>Weeks read most</th>
          <th>Share of {견준주} weeks</th>
          <th>Longest run of weeks</th>
          <th>Median week</th>
          <th>Total views</th>
          <th>Page titles counted</th>
        </tr>
      </thead>
      <tbody>
        {사람들.map((x: any) => (
          <tr>
            <th scope="row">{x.이름}</th>
            <td>{수(x.일위주)}</td>
            <td>{Math.round((x.일위주 / 견준주) * 1000) / 10}%</td>
            <td>{수(x.가장긴연속)}</td>
            <td>{x.주중간 !== null ? 수(x.주중간) : '—'}</td>
            <td>{수(x.합계)}</td>
            <td>{x.받은제목 !== null ? 수(x.받은제목) : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {둘이다르다 && (
    <section>
      <h2>The two columns disagree</h2>
      <p class="q">
        <strong>{주많은이.이름}</strong> was read most in <strong>{수(주많은이.일위주)}</strong> of
        the {견준주} weeks &mdash; more than anyone. But <strong>{중간높은이.이름}</strong> has the
        higher median week ({수(중간높은이.주중간)} against {수(주많은이.주중간)}).
      </p>
      <p class="note">
        Both are true at once. Leading a week is decided by that week&rsquo;s peak; a median says
        what an ordinary week looks like. A member with occasional very large weeks can lead more
        weeks while sitting lower in a typical one &mdash; and that is what the table shows.{' '}
        <strong>Neither column is the &ldquo;real&rdquo; one.</strong>
      </p>
    </section>
  )}

  <h2>The member named in the fan-vote report</h2>
  <p class="q">
    The streak reported this week belongs to <strong>{주장.누가}</strong> &mdash;{' '}
    {주장.몇주} weeks at number one on {앱이름}. By our count,{' '}
    {주장.누가} led <strong>{수(그사람?.일위주 ?? 0)}</strong> of these {견준주} weeks on the
    English Wikipedia, with a median week of {수(그사람?.주중간 ?? 0)} views.
  </p>
  <p class="note">
    That is not a contradiction of the report. It is two counts of two different things, printed
    side by side. Voting apps are where fan bases organise; page views are where everyone else
    goes to find out who someone is. A member can be first in one and not the other for
    {' '}{견준주} weeks running, and both counts can be correct.
  </p>

  <h2>How we counted</h2>
  <div class="scroll-x">
    <table>
      <thead><tr><th>Step</th><th>What we did</th></tr></thead>
      <tbody>
        <tr>
          <th scope="row">Source</th>
          <td>Wikimedia pageviews API, English Wikipedia, all access, human traffic only</td>
        </tr>
        <tr>
          <th scope="row">Window</th>
          <td>{읽는날(d.기간?.시작)} to {읽는날(d.기간?.끝)} &mdash; {견준주} complete weeks (Monday start)</td>
        </tr>
        <tr>
          <th scope="row">Page titles</th>
          <td>
            {수(제목합)} titles in total across {사람들.length} members &mdash; each member&rsquo;s
            article plus every redirect pointing at it, listed by the Wikipedia API, not by us
          </td>
        </tr>
        <tr>
          <th scope="row">Weeks led</th>
          <td>The member with the most views that week. Ties count for everyone tied</td>
        </tr>
        <tr>
          <th scope="row">Comparison group</th>
          <td>The {사람들.length} members of one group &mdash; our choice, see below</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="note fine">
    {/* ⚠ 우리가 세 번 틀린 것을 손님에게도 적는다 — 셈을 볼 수 있게 하는 것이 신뢰다 */}
    The last row of the main table is there for a reason. Counting only a member&rsquo;s main
    article undercounts them, because most readers arrive through a redirect and the pageviews API
    counts each redirect separately. Two of these members are read six to twelve times more than
    their main article alone suggests, and one member&rsquo;s best-known title turned out to be a
    redirect rather than the article. We ask the Wikipedia API for the full redirect list instead of
    typing one, and we print how many titles each figure covers.
  </p>

  <h2>What this does not say</h2>
  <ul class="fine">
    <li>
      <b>It is not a popularity ranking.</b> A page view is a look-up, not a preference. People read
      about someone after a rumour, a role, an award or an enlistment as readily as out of affection.
    </li>
    <li>
      <b>It does not check the fan-vote figure.</b> We hold no weekly winners for that app, so the
      {' '}{주장.몇주}-week streak is neither confirmed nor denied here.
    </li>
    <li>
      <b>The comparison group is our choice.</b> We compared {사람들.length} members of one group
      against each other. Widen or narrow that group and the &ldquo;weeks led&rdquo; column changes
      completely &mdash; it is a within-group count, not a world ranking.
    </li>
    <li>
      <b>English Wikipedia only.</b> Other language editions are not in this count, and the members
      do not have the same reach in each one.
    </li>
    <li>
      <b>Solo work and group pages are not included.</b> Only the pages about the people.
    </li>
  </ul>
  <p class="fine">
    Measured {잰때글}. Source: Wikimedia pageviews API and the English Wikipedia API, both public.
    Fan-vote figure as reported by Star News on 2026-09-05; we did not verify it.
  </p>

  <KcwRelatedArticles page="/streak-vs-read" />
</WikiTip>
