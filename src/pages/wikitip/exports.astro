---
/**
 * K Culture Wire — 음악 수출 20년. (/exports)
 *
 * ── 왜 기사 말고 지면인가 (2번 지시 0806 23:3x) ────────────────
 * 「기사는 흐르고 **지면은 남습니다** — 검색은 지면에 쌓입니다」
 * 같은 데이터로 기사(`/article/kpop-export-left-japan-behind`)를 이미 냈다.
 * 기사는 2024년의 이야기이고, 이 지면은 **20년치가 계속 서 있는 자리**다.
 * KOSIS 가 2025년치를 내면 수집기만 다시 돌리면 이 지면이 저절로 길어진다.
 *
 * ── 숫자는 빌드시 읽는다 ──────────────────────────────────────
 * `src/data/wikitip-music-export.json` — archive/ 는 gitignore 라 빌드가 못 읽는다.
 * 하드코딩하면 갱신될 때 또 틀린다.
 *
 * ── ⚠ 반올림을 숨기지 않는다 ───────────────────────────────────
 * 2017·2021·2022 는 권역 합이 발표 총계와 **1천 달러** 어긋난다(원표의 반올림).
 * 0.0002% 라 무시해도 되지만 **지면에 적는다** — 못 잰 것은 못 쟀다고 쓰는 것이 우리 자본이다.
 *
 * ⛔ 광고 자리를 만들지 않았다. Riot Production(App 866800) 승인 전이다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/wikitip-music-export.json';

const TITLE = 'Where Korean music is sold, 2005–2024';
const DESC =
  'Twenty years of Korean music export value by region — Japan, Greater China, Southeast Asia, '
  + 'North America and Europe — from the Content Industry Survey. Measured, sourced, not estimated.';

const 보임 = ['Japan', 'Greater China', 'Southeast Asia', 'North America', 'Europe', 'Other'];
const rows = [...data.rows].reverse();          // 최신이 위
const 최신 = data.rows[data.rows.length - 1];
const 처음 = data.rows[0];

const 천달러 = (v: number | null) => (v === null ? '—' : v.toLocaleString('en-US'));
const 비중 = (v: number | null, t: number) => (v === null ? '—' : (v / t * 100).toFixed(1) + '%');
const 어긋난해 = data.rows
  .filter((r) => Object.values(r.parts).reduce((s: number, x) => s + (x ?? 0), 0) !== r.total)
  .map((r) => r.year);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${data.yearFrom}/${data.yearTo}`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://kosis.kr'],
  license: 'https://kosis.kr',
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/exports">
  <h1>Where Korean music is sold</h1>
  <p class="lead">
    Export value of Korea's music industry by region, every year from {data.yearFrom} to {data.yearTo}.
    Figures are thousands of US dollars, as published — nothing here is estimated or converted.
  </p>

  <section>
    <h2>The last year, and the first</h2>
    <p class="sub">
      {data.yearTo}: <b>${(최신.total / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })}m</b> in total ·
      {data.yearFrom}: <b>${(처음.total / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })}m</b> ·{' '}
      <b>{(최신.total / 처음.total).toFixed(0)}×</b> over {data.yearTo - data.yearFrom} years
    </p>
    <p class="note">
      Japan was <b>{비중(data.rows.find((r) => r.year === 2012)!.parts.Japan, data.rows.find((r) => r.year === 2012)!.total)}</b> of
      the total in 2012 and <b>{비중(최신.parts.Japan, 최신.total)}</b> in {data.yearTo} — while Japanese sales themselves
      kept rising. <a href="/article/kpop-export-left-japan-behind">Why the share fell without the market shrinking →</a>
    </p>
  </section>

  <section>
    <h2>Every year, by region</h2>
    <p class="sub">Thousands of US dollars. Share of that year's total in brackets.</p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Year</th><th>Total</th>{보임.map((r) => <th>{r}</th>)}</tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="yr">{r.year}</td>
              <td class="tot">{천달러(r.total)}</td>
              {보임.map((k) => (
                <td>
                  {천달러((r.parts as Record<string, number | null>)[k])}
                  <span class="pc">{비중((r.parts as Record<string, number | null>)[k], r.total)}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <KcwRelatedArticles page="/exports" />

  <section class="src">
    <h2>Where these numbers come from</h2>
    <ul>
      <li><b>{data.sourceKo}</b> — {data.source}. Unit: {data.unit}.</li>
      <li>
        <b>What we checked.</b> Regional figures sum to the published total in
        {' '}{data.rows.length - 어긋난해.length} of the {data.rows.length} years exactly.
        {어긋난해.length > 0 && (
          <> In {어긋난해.join(', ')} they differ by one thousand dollars — rounding in the source
          table, at most 0.0002% of the year.</>
        )}
      </li>
      <li>
        <b>What is missing.</b> 2005 reports no value for Greater China, Southeast Asia or North America,
        so that year is usable for the total only. The survey also publishes an "Unclassified" region
        that carries no value in any year, so it is not shown.
      </li>
      <li>
        <b>What this does not say.</b> The survey publishes regions, not countries, so nothing here
        describes a single market inside them. It does not split streaming from physical, or licensing
        from goods, and it names no company or artist.
      </li>
    </ul>
    <p class="note">
      출처: 국가데이터처 KOSIS, 한국콘텐츠진흥원 「콘텐츠산업조사」, 기준 {data.yearTo}년.
    </p>
  </section>

  <p class="back"><a href="/">&larr; Back to the front page</a></p>
</WikiTip>

<style>
  h1 { margin: 0 0 .5rem; font-size: 1.7rem; letter-spacing: -.02em; }
  .lead { margin: 0 0 2rem; font-size: 1rem; color: var(--muted); }
  section { margin: 0 0 2.5rem; }
  h2 { font-size: 1.1rem; margin: 0 0 .4rem; letter-spacing: -.01em; }
  .sub { font-size: .87rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.6; }
  .note { font-size: .82rem; color: var(--muted); margin: .9rem 0 0; line-height: 1.6; }

  table { width: 100%; border-collapse: collapse; font-size: .84rem; }
  th, td { padding: .45rem .55rem; border-bottom: 1px solid var(--line); text-align: right;
           white-space: nowrap; font-variant-numeric: tabular-nums; }
  th { font-size: .74rem; letter-spacing: .03em; text-transform: uppercase; color: var(--muted);
       text-align: right; font-weight: 700; }
  th:first-child, td.yr { text-align: left; }
  td.yr { font-weight: 700; }
  td.tot { font-weight: 700; }
  /* 비중은 값 아래 작게 — 한 칸에 둘을 넣되 눈이 값을 먼저 잡게 한다 */
  .pc { display: block; font-size: .72rem; color: var(--muted); font-weight: 400; }
  tbody tr:first-child { background: var(--card); }

  .src ul { margin: 0; padding-left: 1.1rem; font-size: .85rem; color: var(--muted); line-height: 1.7; }
  .src li { margin: .45rem 0; }
  .src b { color: var(--ink); }
  .back { margin-top: 2.5rem; font-size: .9rem; }
</style>
