---
/**
 * K Culture Wire — **일간·일지 열 칸·열두 칸에 한국 연예인 만 명이 어떻게 갈리나.** (`/day-pillar`)
 *
 * ── 왜 이 지면이 있나 (2026-08-22) ────────────────────────────
 * 영문권에서 「아이돌 사주」를 내는 곳을 여덟 곳 넘게 세어 봤다. 전부 같은 꼴이다 —
 * **한 사람의 여덟 글자를 풀어 준다.** 표본 1, 분모 없음.
 * ⛔ 우리가 아홉 번째로 그 자리에 서지 않는다. 우리 강령이
 *   「⛔ 이렇게 하세요 → ✅ N명 중 M명이 그렇다」다.
 * ⭐ 그래서 **분모를 만든다.** 한 사람을 풀지 않고 만 명을 센다. 저쪽이 이걸 안 하는 까닭은
 *   한 사람을 풀어 주는 장사에는 분모가 필요 없어서다.
 *
 * ⛔ 점을 치지 않는다. 이 지면이 하는 말은 **「고른가 안 고른가」** 하나다.
 * ⛔ 시주(時柱)를 세우지 않는다 — 공개 자료에 태어난 시각이 거의 없다. 그 말을 지면에 적는다.
 * ⛔ 화면에 우리말을 쓰지 않는다(`check-english-only.mjs`). 주석까지 밖으로 나가지 않게 한다.
 * ⚠ 수는 하나도 손으로 안 적는다 — `src/data/wikitip-star-daypillar.json` 에서 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-star-daypillar.json';

/** 로마자 — 읽는 사람이 소리 낼 수 있게. ⚠ 판정이 아니라 표기다 */
const 간읽기: Record<string, string> = {
  甲: 'Gap', 乙: 'Eul', 丙: 'Byeong', 丁: 'Jeong', 戊: 'Mu',
  己: 'Gi', 庚: 'Gyeong', 辛: 'Sin', 壬: 'Im', 癸: 'Gye',
};
const 지읽기: Record<string, string> = {
  子: 'Ja', 丑: 'Chuk', 寅: 'In', 卯: 'Myo', 辰: 'Jin', 巳: 'Sa',
  午: 'O', 未: 'Mi', 申: 'Sin', 酉: 'Yu', 戌: 'Sul', 亥: 'Hae',
};

const 간줄 = Object.entries(d.all.dayStem)
  .map(([k, n]) => ({
    k, n: n as number,
    top: (d.mostLinked.dayStem as Record<string, number>)[k] ?? 0,
    names: (d.examplesByDayStem as Record<string, string[]>)[k] ?? [],
  }))
  .sort((a, b) => b.n - a.n);
const 지줄 = Object.entries(d.all.dayBranch)
  .map(([k, n]) => ({ k, n: n as number, top: (d.mostLinked.dayBranch as Record<string, number>)[k] ?? 0 }))
  .sort((a, b) => b.n - a.n);

const 간셈 = d.all.chiSquareDayStem;
const 지셈 = d.all.chiSquareDayBranch;
const 간문턱 = (d.thresholds as Record<string, number>)['9'];
const 지문턱 = (d.thresholds as Record<string, number>)['11'];
const 넘었나 = (χ2: number, 문턱: number) => (χ2 > 문턱 ? 'above' : 'below');

const 그룹들 = Object.entries(d.groupSpotChecks?.groups ?? {});
const bts = (d.groupSpotChecks?.groups as any)?.BTS;

const TITLE = `The day pillars of ${d.measured.toLocaleString('en-US')} Korean entertainers`
  + `${bts ? ` — BTS land on ${bts.distinctStems} of the ten` : ''}`;
/** 문턱 안이냐 밖이냐 — 문장에 그대로 넣는다. ⛔ 결론을 손으로 적지 않는다 */
const 간판정 = 간셈.카이제곱 > 간문턱 ? 'outside' : 'inside';

const DESC = `We built the day pillar for ${d.measured.toLocaleString('en-US')} Korean actors, `
  + `singers and songwriters whose birth date is on public record to the day, and counted how they `
  + `fall across the ten day stems and twelve day branches. IU, Jungkook, RM, Jisoo and thousands `
  + `more are in the count. The spread sits ${간판정} the chance threshold, and we say so.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/'],
  variableMeasured: ['day stem', 'day branch', 'five elements'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/day-pillar">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>

  <section class="warn-box">
    <h2>Read this first — this is not a reading</h2>
    <p class="warn">
      A day pillar is one of four pillars, and the fourth cannot be built here: public records
      carry birth dates and almost never birth hours. Nothing on this page says what any pillar
      means for any person. The only question asked is whether the spread across the pillars is
      further from flat than chance would produce.
    </p>
    {d.whatThisCannotSay.map((s: string) => <p class="note">{s}</p>)}
  </section>

  <section>
    <h2>The ten day stems, with the names in each</h2>
    <p>
      {d.measured.toLocaleString('en-US')} people, each placed by the day they were born. A flat
      spread would put {간셈.기대.toLocaleString('en-US')} in every column. The third column is the
      most-linked tenth of the same people ({d.mostLinkedCut.toLocaleString('en-US')} of them,
      those with at least {d.mostLinkedThresholdSitelinks} Wikipedia editions) — the test for
      whether any pillar crowds the famous end.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr>
            <th>Day stem</th><th>All</th><th>Most-linked tenth</th><th>Best-known names in this stem</th>
          </tr>
        </thead>
        <tbody>
          {간줄.map((r) => (
            <tr>
              <td class="nm">{r.k} <span class="fine">{간읽기[r.k] ?? ''}</span></td>
              <td>{r.n.toLocaleString('en-US')}</td>
              <td>{r.top}</td>
              <td class="fine">{r.names.join(', ') || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Chi-square {간셈.카이제곱} against a threshold of {간문턱} at nine degrees of freedom —
      {' '}{넘었나(간셈.카이제곱, 간문턱)} the line. For the most-linked tenth,
      {' '}{d.mostLinked.chiSquareDayStem.카이제곱} against the same threshold.
    </p>
  </section>

  <section>
    <h2>The twelve day branches</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Day branch</th><th>All</th><th>Most-linked tenth</th></tr></thead>
        <tbody>
          {지줄.map((r) => (
            <tr>
              <td class="nm">{r.k} <span class="fine">{지읽기[r.k] ?? ''}</span></td>
              <td>{r.n.toLocaleString('en-US')}</td>
              <td>{r.top}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Chi-square {지셈.카이제곱} against {지문턱} at eleven degrees of freedom —
      {' '}{넘었나(지셈.카이제곱, 지문턱)} the line. Most-linked tenth,
      {' '}{d.mostLinked.chiSquareDayBranch.카이제곱}.
    </p>
  </section>

  {d.robustness && (
    <section class="warn-box">
      <h2>One of these four tests crossed the line. We are not calling it a finding</h2>
      <p class="warn">{d.robustness.whyThisSectionExists}</p>
      <div class="scroll-x">
        <table>
          <thead><tr><th>What we tried</th><th>People</th><th>Chi-square</th></tr></thead>
          <tbody>
            <tr>
              <td class="nm">Everyone</td>
              <td>{d.robustness.whole.n.toLocaleString('en-US')}</td>
              <td>{d.robustness.whole.카이제곱}</td>
            </tr>
            <tr>
              <td class="nm">
                Administrative-looking dates dropped
                {' '}<span class="fine">({d.robustness.administrativeDatesRemoved.datesRemoved.join(', ')})</span>
              </td>
              <td>{d.robustness.administrativeDatesRemoved.n.toLocaleString('en-US')}</td>
              <td>{d.robustness.administrativeDatesRemoved.카이제곱}</td>
            </tr>
            {d.robustness.byEra.map((e: any) => (
              <tr>
                <td class="nm">Born {e.from}–{e.to}</td>
                <td>{e.n.toLocaleString('en-US')}</td>
                <td>{e.카이제곱}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">{d.robustness.administrativeDatesRemoved.reading}</p>
      <p class="note">{d.robustness.multipleTests.whatThatMeans}</p>
      <p class="warn">
        So: dropping the suspicious dates does not move it, no single era crosses on its own, the
        most-linked tenth does not cross, and the day branch does not cross. A single marginal
        crossing out of four tests is what chance produces about one time in five. We publish the
        number, we publish everything we tried to kill it, and we do not tell you that a day stem
        does anything.
      </p>
    </section>
  )}

  {그룹들.length > 0 && (
    <section>
      <h2>Two groups everyone knows, looked up one member at a time</h2>
      <p class="note">{d.groupSpotChecks.weChose}</p>
      {그룹들.map(([이름, g]: [string, any]) => (
        <div>
          <h3>
            {이름} — {g.found} of {g.members.length} members have a birth date on record to the day,
            and they land on {g.distinctStems} different day stems
          </h3>
          <div class="scroll-x">
            <table>
              <thead><tr><th>Member</th><th>Born</th><th>Day pillar</th><th>Citizenship on record</th></tr></thead>
              <tbody>
                {g.members.map((m: any) => (
                  <tr>
                    <td class="nm">{m.member}</td>
                    <td class="fine">{m.born ?? '—'}</td>
                    <td>{m.dayPillar ?? <span class="fine">{m.note}</span>}</td>
                    <td class="fine">{m.citizenships.join(', ') || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {g.nonKorean > 0 && (
            <p class="note">
              {g.nonKorean} member{g.nonKorean > 1 ? 's' : ''} here {g.nonKorean > 1 ? 'are' : 'is'}
              {' '}not a South Korean citizen on the public record, so {g.nonKorean > 1 ? 'they are' : 'she is'}
              {' '}outside the {d.measured.toLocaleString('en-US')} counted above. Shown here anyway,
              because dropping a member without saying so would make a group of four look like a group
              of three.
            </p>
          )}
        </div>
      ))}
    </section>
  )}

  <section class="src">
    <h2>How this was counted</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Counted</b> — {d.measured.toLocaleString('en-US')} people</li>
      <li>
        <b>Left out and counted separately</b> — {d.monthOnlyExcluded} people whose birth date is
        recorded only to the month or the year. They are not folded in as zeroes.
      </li>
      <li>
        <b>Ranges we could not ask</b> — {d.unaskedRanges}. A range we could not ask is reported as
        unasked, never as empty.
      </li>
      <li>
        <b>Thresholds</b> — the 0.05 chi-square values, copied from a table: {간문턱} at nine
        degrees of freedom, {지문턱} at eleven. We did not compute those two numbers ourselves.
      </li>
    </ul>
    <p class="note">
      <a href="/star-signs">The same test on birth years, with names</a> ·{' '}
      <a href="/zodiac">The birth-year count that came out as chance</a> ·{' '}
      <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/day-pillar" />
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: 0.5rem 1rem; }
</style>
