---
/**
 * K Culture Wire — **작품이 늘면 이름이 읽히나.** (`/titles-to-name`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   76편에서 「데뷔 나이가 도달을 사나」를 재다 못 읽었다. 배우 절반이 차트 작품 한 편뿐이라
 *   그 사람의 값이 곧 그 작품의 값이었기 때문이다.
 *   ⭐ 자를 바꾸니 읽힌다 — 「도달」 대신 **그 사람 이름이 읽힌 횟수**를 쓰면 한 방향으로 간다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **인과로 안 쓴다.** 작품이 이름을 끌었는지 이름이 작품을 끌었는지 이 자로는 못 가른다.
 *    그 말을 표 바로 아래 같은 크기로 적는다.
 * ⛔ 열다섯 명이 안 되는 칸은 가운데값을 안 낸다.
 * ⚠ 76편을 지우지 않는다. **76편이 옳았고 여기서 자를 바꿨다**고 적는다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import d from '../../data/wikitip-titles-to-name.json';

const TITLE = 'An actor with five charting titles is looked up ten times as often as one with a single title';
const DESC =
  `Grouping ${d.actorsCounted.toLocaleString('en-US')} Korean actors by how many of their titles `
  + `reached a Netflix chart, the median reads of their own Wikipedia article run `
  + `${d.bands.map((b) => b.medianRead).filter(Boolean).join(', ')} across four Southeast Asian `
  + 'editions. It runs one way and does not turn back. Which way the arrow points is a different question.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://www.wikidata.org', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/titles-to-name">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">{d.finding}</p>
  <p class="q">
    Bottom band <b>{d.lowestBandMedian}</b> · top band <b>{d.highestBandMedian}</b> ·{' '}
    <b>{d.multiple}×</b> between them.
  </p>

  <section>
    <h2>Four bands, {d.actorsCounted.toLocaleString('en-US')} actors</h2>
    <p class="note"><b>{d.unit}</b></p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Charting titles</th><th>Actors</th><th>Median reads</th>
          <th>Most-read in band</th></tr></thead>
        <tbody>
          {d.bands.map((b) => (
            <tr>
              <td class="nm">{b.band}</td>
              <td>{b.actors}</td>
              <td class="tot">{b.medianRead ?? '—'}</td>
              <td class="fine">{b.topName} · {b.topRead}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Bands under {d.minimumBand} actors would not get a median at all. Note the last column: the
      most-read actor in the one-title band is read more than the median of the top band, so this
      is about where the middle sits, not about ceilings.
    </p>
  </section>

  <section class="warn-box">
    <h2>Which way does the arrow point</h2>
    <p class="warn">{d.cannotAnswer}</p>
  </section>

  <section class="warn-box">
    <h2>We could not read this the first time</h2>
    <p class="note">{d.whatChangedSince76}</p>
    <p class="note">
      The earlier piece stands — see{' '}
      <a href="/one-title">Half of the Korean actors on a Netflix chart are there for one title</a>.
      What changed is the instrument, not the panel.
    </p>
  </section>

  <section class="src">
    <h2>How this was counted</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Window</b> — {d.window}</li>
      <li><b>Monotonic</b> — {d.monotonic ? 'yes, the bands run one way' : 'no'}; the top band's
        median is <b>{d.multiple}×</b> the bottom band's.</li>
    </ul>
    <p class="warn">{d.panelCaveat}</p>
    <p class="note">
      <a href="/one-title">The distribution behind this</a> ·{' '}
      <a href="/fame-compare">How actors compare with everyone else</a> ·{' '}
      <a href="/about">How we count</a>
    </p>
  </section>

  <KcwCardnews set="instrument" count={5} />

  <KcwShorts set="instrument" says={`A man and a woman read the multiple out — ${d.multiple} times more reads between the ends.`} />
  <KcwRelatedArticles page="/titles-to-name" />
</WikiTip>

<style>
  .warn-box { border-left: 3px solid #b45309; padding-left: 1rem; }
</style>
