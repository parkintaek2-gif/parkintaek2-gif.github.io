---
/**
 * K Culture Wire — **한 판만 갖고 있는 스타는 누구인가.** (`/only-one-wikipedia`)
 *
 * ⭐⭐ 사장님 지시(8/16) — 제목·본문에 **스타 이름**을 넣는다. 손님이 치는 말이 이름이다.
 *    그래서 표의 첫 칸이 수가 아니라 **이름**이다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **「한 판만 있다」를 「인기 없다」로 안 읽는다.** 문서가 있고 없고는 편집자가 정한다.
 *    타이어판에 안 적힌 사람이 태국에서 안 알려진 것은 **아니다.** 이 지면은 둘을 못 가른다.
 * ⛔ **크기 반론을 표로 죽인다** — 베트남어판이 문서·편집자에서 앞서는데도
 *    이 이름들을 갖고 있는 것은 인도네시아어판이다. 거기까지만 말하고 「왜」는 안 말한다.
 * ⛔ **없는 문서를 0 으로 안 센다.**
 * ⛔ 광고 자리를 만들지 않는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다 — 붙여 쓸 곳에 {' '} 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-only-one-wikipedia.json';

const 음 = d.groups.find((g) => g.key === 'music');
const 배 = d.groups.find((g) => g.key === 'actors');
const 크 = 음.size;

const TITLE = 'Only the Indonesian Wikipedia has written about Ahn Sung-ki and Choi Jiwoo';
const DESC =
  `Of ${음.measured.toLocaleString('en-US')} Korean music acts and ${배.measured.toLocaleString('en-US')} `
  + `actors, ${음.onlyOne + 배.onlyOne} have an article on only one of the four Southeast Asian `
  + `Wikipedias. The Indonesian edition holds ${음.byEdition.id.count + 배.byEdition.id.count} of `
  + 'them, and it is not the biggest of the four.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/only-one-wikipedia">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    <b>{배.onlyOne}</b> of {배.measured.toLocaleString('en-US')} Korean actors and
    {' '}<b>{음.onlyOne}</b> of {음.measured.toLocaleString('en-US')} music acts have an article on
    exactly one of these four Wikipedias. For the actors, {배.byEdition.id.count} of those
    {' '}{배.onlyOne} — <b>{배.byEdition.id.sharePc}%</b> — are held by the Indonesian edition
    alone. Ahn Sung-ki, one of the most decorated actors in Korean film, is one of them.
  </p>

  {d.groups.map((g) => (
    <section>
      <h2>{g.label} held by one edition only</h2>
      <p class="note">
        {g.onlyOne} of {g.measured.toLocaleString('en-US')} ({g.onlyOnePc}%) appear on exactly one
        edition. Names are the most-read of them on that edition, in reads per million reads of
        that Wikipedia.
      </p>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th>Wikipedia</th><th>Held alone</th><th>Share</th><th>Who</th></tr>
          </thead>
          <tbody>
            {d.editions.map((e) => (
              <tr>
                <td class="nm">{d.editionNames[e]}</td>
                <td><b>{g.byEdition[e].count}</b></td>
                <td class="fine">{g.byEdition[e].sharePc}%</td>
                <td class="fine">
                  {g.byEdition[e].names.slice(0, 5).map((x) => `${x.name} ${x.perMillion}`).join(' · ')
                    || '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section>
    <h2>It is not that the Indonesian Wikipedia is the biggest</h2>
    <p>
      That is the first explanation anyone reaches for, and the table below rules it out. The
      {' '}{d.editionNames[크.largest]} Wikipedia is larger on articles and on active editors, and
      it is not the one holding these names.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Wikipedia</th><th>Articles</th><th>Active editors</th>
            <th>Korean names held alone</th></tr>
        </thead>
        <tbody>
          {d.editions.map((e) => (
            <tr>
              <td class="nm">{d.editionNames[e]}</td>
              <td class="fine">{크.sizes[e].articles.toLocaleString('en-US')}</td>
              <td class="fine">{크.sizes[e].activeEditors.toLocaleString('en-US')}</td>
              <td><b>{음.byEdition[e].count + 배.byEdition[e].count}</b></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">{크.weDoNotSayWhat}</p>
  </section>

  <section>
    <h2>We counted this twice, with two different fields</h2>
    <p class="note">{d.twoRulersAgree}</p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    <p class="warn">
      <strong>An article existing is an editing decision, not a measure of interest.</strong> A
      star written up only in Indonesian may be perfectly well known in Thailand and simply
      unwritten there. This page cannot tell those two situations apart, and it does not try.
    </p>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">{d.limitation}</p>
    <p class="note">
      Source — {d.source}. Window — {d.window}.
    </p>
  </section>

  <KcwRelatedArticles page="/only-one-wikipedia" />
</WikiTip>
