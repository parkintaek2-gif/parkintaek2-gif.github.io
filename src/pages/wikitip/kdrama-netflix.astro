---
/*
 * `/kdrama-netflix` — **Korean series on the Netflix weekly chart, counted two ways.**
 *
 * ── Why this page ──────────────────────────────────────────────
 * Measured 2026-10-05 (en/us autocomplete): `kdrama netflix 2026`, `best kdrama`
 * and `kdrama ratings` each fill all ten rows. We hold the weekly chart history
 * for 397 Korean series and had no page carrying those words.
 *
 * ⭐ What the data actually says — **"longest on the chart" and "in the most
 *   countries" are almost different lists.** Of the top 20 by each measure, only
 *   three titles appear on both. A page that picks one axis and calls it "best"
 *   would hide that.
 *
 * ⛔ We do not say which show is best. "Best" is a judgement; weeks and markets
 *   are counts. The page says so in its own words.
 * ⛔ We do not have viewer numbers or ratings. Netflix publishes a chart position,
 *   not an audience figure. The page states what the chart is and is not.
 * ⛔ Titles with no page of ours are still counted — we do not hide them to make
 *   the internal links look better.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/wikitip-title-pages.json';

const 모두 = ((data as any).titles ?? []) as any[];
/* ⛔ 영화는 뺀다 — 이 지면은 시리즈 이야기다 */
const 시리즈 = 모두.filter((x) => /TV/i.test(String(x?.type ?? '')));

const 수있나 = (x: any, 칸: string) => typeof x?.[칸] === 'number' && Number.isFinite(x[칸]);
const 주잰것 = 시리즈.filter((x) => 수있나(x, 'weeks'));
const 나라잰것 = 시리즈.filter((x) => 수있나(x, 'markets'));

const 오래 = [...주잰것].sort((a, b) => b.weeks - a.weeks).slice(0, 15);
const 널리 = [...나라잰것].sort((a, b) => b.markets - a.markets).slice(0, 15);

/* 🔴 두 줄이 얼마나 다른가 — 이 수가 이 지면의 까닭이다 */
const 널리이름 = new Set(널리.map((x) => x.title));
const 겹친것 = 오래.filter((x) => 널리이름.has(x.title));

const 한나라만 = 시리즈.filter((x) => x.markets === 1).length;
const 지면있는것 = 시리즈.filter((x) => x.hasPage).length;

/* 첫 진입 해별 — 몇 편이 들어왔나 */
const 해별 = new Map<string, number>();
for (const x of 시리즈) {
  const y = String(x?.firstWeek ?? '').slice(0, 4);
  if (/^\d{4}$/.test(y)) 해별.set(y, (해별.get(y) ?? 0) + 1);
}
const 해차례 = [...해별.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const TITLE = `Kdrama Netflix chart — ${시리즈.length} Korean series, weeks and markets`;
const DESC = `Every Korean series that reached a Netflix weekly top 10: ${시리즈.length} titles. `
  + `Ranked two ways — weeks on the chart and number of countries. Of the top 15 on each `
  + `measure only ${겹친것.length} appear on both, so "longest-running" and "most widespread" `
  + `are nearly different lists.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Korean series on the Netflix weekly chart',
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
};

const 링크 = (x: any) => (x?.hasPage && x?.slug ? `/title/${x.slug}` : null);
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}>
  <h1>Kdrama on Netflix — counted two ways</h1>

  <p class="lede">
    {시리즈.length} Korean series have reached a Netflix weekly top 10 somewhere in
    the world. We ranked them by <strong>weeks on the chart</strong> and by
    <strong>how many countries</strong> — and got two nearly different lists.
  </p>

  <section class="box">
    <h2>The finding</h2>
    <p>
      Take the top 15 by weeks and the top 15 by countries.
      <strong>Only {겹친것.length} titles appear on both.</strong>
    </p>
    <p>
      A show can sit on one country's chart for over a year, or sweep ninety
      countries for a fortnight. Those are different kinds of success, and a single
      "best K-drama" list would hide one of them.
      {겹친것.length > 0 && (
        <> The {겹친것.length} that did both: {겹친것.map((x) => x.title).join(', ')}.</>
      )}
    </p>
  </section>

  <section>
    <h2>Longest on the chart</h2>
    <p class="note">
      Weeks counted across every country's top 10. A week in two countries counts
      as one week here — this is <strong>how long it stayed visible</strong>, not
      how widely.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Series</th><th>Weeks</th><th>Countries</th><th>Best position</th><th>First week</th></tr>
        </thead>
        <tbody>
          {오래.map((x) => (
            <tr>
              <td class="nm">{링크(x) ? <a href={링크(x)}>{x.title}</a> : x.title}</td>
              <td><strong>{x.weeks}</strong></td>
              <td>{x.markets}</td>
              <td>{x.peak ?? '—'}</td>
              <td class="dim">{x.firstWeek ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>In the most countries</h2>
    <p class="note">
      How many countries' top 10 the series reached at any point. This is
      <strong>reach</strong>, not duration.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Series</th><th>Countries</th><th>Weeks</th><th>Best position</th><th>First week</th></tr>
        </thead>
        <tbody>
          {널리.map((x) => (
            <tr>
              <td class="nm">{링크(x) ? <a href={링크(x)}>{x.title}</a> : x.title}</td>
              <td><strong>{x.markets}</strong></td>
              <td>{x.weeks}</td>
              <td>{x.peak ?? '—'}</td>
              <td class="dim">{x.firstWeek ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Most of them travelled nowhere</h2>
    <p>
      <strong>{한나라만} of the {시리즈.length} series</strong> reached the top 10 in
      exactly one country. Reaching a Netflix chart at all is rarer than it sounds,
      and reaching several countries is rarer still.
    </p>
    <div class="scroll">
      <table>
        <thead><tr><th>First reached a chart in</th><th>Series</th></tr></thead>
        <tbody>
          {해차례.map(([y, n]) => (<tr><th>{y}</th><td>{n}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Counted by the year a series first appeared on any country's weekly top 10 —
      not by the year it was released.
    </p>
  </section>

  <section>
    <h2>What a chart position is, and is not</h2>
    <p>
      <strong>Netflix publishes a position, not an audience.</strong> A title at
      number 3 in Belgium and a title at number 3 in Brazil are not the same number
      of people. Nothing on this page should be read as viewers.
    </p>
    <p>
      <strong>We do not say which show is best.</strong> Weeks and countries are
      counts; "best" is a judgement, and it is not ours to make. The two tables are
      there so you can see that the question has more than one answer.
    </p>
    <p>
      <strong>{시리즈.length - 지면있는것} of the {시리즈.length} series have no page of
      ours yet.</strong> They are still counted here. Leaving them out would make our
      own coverage look better than it is.
    </p>
  </section>

  <section>
    <h2>Related</h2>
    <ul class="links">
      <li><a href="/titles">Every Korean title we track</a></li>
      <li><a href="/ages">Korean actors ages — 531 on record</a></li>
      <li><a href="/idols-on-netflix">K-pop idols who turn up in Netflix casts</a></li>
      <li><a href="/born-on">Who was born on your birthday</a></li>
    </ul>
  </section>

  <KcwRelatedArticles page="/kdrama-netflix" />
</WikiTip>

<style>
  h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 .6rem; }
  .lede { font-size: 1.05rem; color: #334; margin: 0 0 1.6rem; }
  section { margin: 2.2rem 0; }
  h2 { font-size: 1.2rem; margin: 0 0 .6rem; }
  .box { background: #fbfbfd; border: 1px solid #e6e8ee; border-left: 4px solid #2a4d8f;
         border-radius: 12px; padding: 1rem 1.1rem; }
  .box p { margin: .5rem 0; }
  .box p:first-of-type { margin-top: 0; }
  .note { font-size: .88rem; color: #667; margin: 0 0 .7rem; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: .45rem .6rem; border-bottom: 1px solid #e8eaef; text-align: right; }
  thead th { text-align: right; font-size: .82rem; color: #556; border-bottom: 2px solid #d8dbe2; }
  thead th:first-child, tbody td.nm, tbody th { text-align: left; }
  tbody th { font-weight: 500; color: #445; }
  td.nm a { color: #2a4d8f; text-decoration: none; }
  td.nm a:hover { text-decoration: underline; }
  .dim { color: #889; font-size: .85rem; }
  .links { margin: .6rem 0 0 1.1rem; font-size: .95rem; }
  .links li { margin: .35rem 0; }
  .links a { color: #2a4d8f; text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  @media (max-width: 640px) { h1 { font-size: 1.45rem; } }
</style>
