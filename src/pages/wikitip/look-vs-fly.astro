---
/**
 * K Culture Wire — **알아보는 달과 비행기가 뜨는 달.** (`/look-vs-fly`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   89편이 「읽는 곳 ↔ 가는 곳」을 못 이었다. 두 자가 너무 멀었다.
 *   ⭐ 그 사이에 **「알아보는 것」**이 있다 — 공항·지하철·제주 문서를 여는 사람은
 *     배우 이름을 찾는 사람보다 발걸음에 가깝다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **상관계수를 안 낸다.** 스물세 달이면 계절 하나로 커진다 — 실제보다 확실해 보인다.
 * ⛔ **「12월에 알아보고 1월에 간다」로 안 읽히게 한다.** 앞선 봉우리는 원인이 아니다.
 *    ⭐ 요점은 봉우리가 아니라 **바닥이 둘 다 6월**이라는 쪽이다. 그것을 앞에 세운다.
 * ⛔ **항공의 「아시아」는 동남아가 아니다.** 인도·중앙아시아가 같은 칸이다.
 * ⚠ 스물세 달을 열둘로 접으면 달마다 표본이 둘, 7월은 하나다. 표에 적는다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-look-vs-fly.json';

const 달이름 = ['January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'];
const 달말 = (mm: string) => 달이름[Number(mm) - 1] ?? mm;
const 달들 = Object.keys(d.lookFolded).sort();

const TITLE = 'Southeast Asia looks up a Korean trip in December and stops looking in June';
const DESC =
  `Reads of Korean travel articles in four Southeast Asian Wikipedias peak in `
  + `${달말(d.lookPeak.peak)}; flights on the Asia routes peak in ${달말(d.flyPeak.peak)}. `
  + `The steadier signal is not the peak — both fall to their lowest point in the same month, `
  + `${달말(d.lookPeak.trough)}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: d.window,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/', 'https://kosis.kr'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/look-vs-fly">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">{d.answer}</p>

  <section>
    <h2>The month they agree on is the quiet one</h2>
    <p>
      Looking peaks in {달말(d.lookPeak.peak)} and flying peaks in {달말(d.flyPeak.peak)} — one month
      apart. That gap is the easy thing to notice and the weakest thing here. The steadier signal is
      at the other end: both sides fall to their lowest point in {달말(d.lookPeak.trough)}. Reading
      swings by {d.lookPeak.ratio}× across the year, flying by {d.flyPeak.ratio}×.
    </p>
  </section>

  <section>
    <h2>Twelve months, both rulers</h2>
    <p class="note">
      Reading is reads per million reads of that Wikipedia, summed across
      {' '}{d.articlesUsed.length} articles and {d.editionsSea.length} editions. Flying is passengers
      on the Asia routes. Window — {d.window}.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Month</th><th>Looking (per million)</th><th>Flying (passengers)</th>
            <th>Years folded</th></tr>
        </thead>
        <tbody>
          {달들.map((m) => (
            <tr>
              <td class="nm">{달말(m)}</td>
              <td>{d.lookFolded[m]}</td>
              <td class="tot">{Math.round(d.flyFolded[m]).toLocaleString('en-US')}</td>
              <td class="fine">{d.yearsPerFoldedMonth[m]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      ⚠ {d.foldingCaveat} {d.monthsWithOneYearOnly.length > 0
        && `Only one year of ${d.monthsWithOneYearOnly.join(', ')} sits in this window.`}
    </p>
  </section>

  <section>
    <h2>Which articles, and which we left out</h2>
    <p>
      We used the {d.articlesUsed.length} travel articles that exist in all
      {' '}{d.editionsSea.length} editions: {d.articlesUsed.join(', ')}. The panel started at
      {' '}{d.articlesInPanel}. An article missing from one edition cannot stand for the region, so
      it is out of the sum rather than counted as a zero there.
    </p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">
      Looking — {d.readSource}. Flying — {d.flySource}.
    </p>
  </section>

  <KcwRelatedArticles page="/look-vs-fly" />
</WikiTip>
