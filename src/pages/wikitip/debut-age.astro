---
/**
 * K Culture Wire — **몇 살에 시작했나, 그리고 지금 얼마나 읽히나.** (`/debut-age`)
 *
 * ⭐⭐ 사장님 지시(8/16·8/20) — 스타 이름을 제목과 표에. 손님은 이름을 검색한다.
 *    ⛔ 제목의 이름을 손으로 안 박는다. 자료가 든 이름을 쓴다 — 자료가 바뀌면 제목이 따라 바뀐다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **「일찍 시작해서 많이 읽힌다」로 안 쓴다.** 방향을 못 가른다.
 * ⛔ **가장 뻔한 반론을 표보다 먼저 죽인다** — 「경력이 길어 쌓인 것 아닌가」.
 *    ⭐ 띠마다 경력 가운데값이 20~22년으로 거의 같다.
 * ⛔ **붙들고 재면 위 두 띠가 붙는다**는 것을 감추지 않는다.
 * ⛔ **무리의 수 옆에 한 사람 수준의 수**를 둔다.
 * ⛔ **지금 나이는 못 가른다**고 적는다.
 * ⛔ 광고 자리를 만들지 않는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 * 🔴 `public/wikitip/debut-age.html` 이 생기면 그쪽이 이긴다. 두 벌 만들지 않는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import d from '../../data/wikitip-debut-age.json';

const 위 = d.bands[0];
const 아래 = d.bands[d.bands.length - 1];
const 확률 = Math.round(1000 * d.personLevel.value) / 10;
/* ⛔ 이름을 손으로 안 적는다 — 자료가 든 것을 쓴다 */
const 어린이름 = 위.all.topNames.map((p) => p.name);
const 늦은이름 = 아래.all.topNames.map((p) => p.name);

const TITLE = `${어린이름[0]} and ${어린이름[1]} started before 18. `
  + `${늦은이름[0]} started at ${아래.all.topNames[0].debutAge} — and it is not just career length`;
const DESC =
  `Across ${d.measured} Korean stars, those who started before 18 are read `
  + `${위.all.median} per million against ${아래.all.median} for those who started at 26 or later. `
  + 'Career length is the obvious explanation and it does not hold: the median career is within '
  + 'two years of itself in every band.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/debut-age">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    Of {d.measured} Korean actors and singers whose career start year is on record,
    the {위.all.measured} who started before 18 — {어린이름.join(', ')} among them — are read
    {' '}<b>{위.all.median}</b> times per million. The {아래.all.measured} who started at 26 or
    later, including {늦은이름.join(', ')}, are read <b>{아래.all.median}</b>.
  </p>

  {/*
    🔴 이 상자가 표보다 먼저다. 뒤에 두면 손님이 「경력 때문이겠지」로 덮고 넘어간다.
  */}
  <section class="warn-box">
    <h2>The obvious objection, answered first</h2>
    <p class="warn">{d.theObviousObjection.says}</p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Started at</th><th>People</th><th>Median career, years</th></tr></thead>
        <tbody>
          {d.bands.map((b) => (
            <tr>
              <td class="nm">{b.label}</td>
              <td class="fine">{b.all.measured}</td>
              <td>{b.all.careerMedian}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="warn">{d.theObviousObjection.thenWhat}</p>
  </section>

  <section>
    <h2>The ladder, and the names in each step</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Started at</th><th>People</th><th>Reads per million</th>
            <th>Career held at {d.theObviousObjection.careerWindow.부터}–{d.theObviousObjection.careerWindow.까지} years</th>
            <th>Most-read in this band</th></tr>
        </thead>
        <tbody>
          {d.bands.map((b) => (
            <tr>
              <td class="nm">{b.label}</td>
              <td class="fine">{b.all.measured}</td>
              <td><b>{b.all.median}</b></td>
              <td>{b.careerHeld.tooThin ? `too thin (${b.careerHeld.measured})` : b.careerHeld.median}</td>
              <td class="fine">{b.all.topNames.map((p) => `${p.name} ${p.perMillion}`).join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Every step falls, both before and after holding career length — {d.ladder.all.fromTo}× end to
      end raw, {d.ladder.careerHeld.fromTo}× with career held. <strong>But look at the fourth
      column.</strong> Once career is held, the two youngest bands land at
      {' '}{d.bands[0].careerHeld.median} and {d.bands[1].careerHeld.median}, close enough that we
      would not separate them. The four-step ladder becomes three.
    </p>
    <p class="note">
      Every median here survives removing any single person from its band, which rules out one way
      it could be fragile and does not show that it is stable. The check is a jackknife, which is
      known to understate how much a median moves. The
      {' '}<a href="/one-out">method and its limits are here</a>.
    </p>
  </section>

  <section>
    <h2>What it says about one person</h2>
    <p>
      Take one star who started before 18 and one who started at 26 or later, at random. How often
      is the early starter the more-read one?
    </p>
    <p class="q"><b>{확률}%</b></p>
    <p class="note">{d.personLevel.whatItIs} {d.personLevel.whatFiftyMeans}</p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">{d.bandsAreOurs}</p>
  </section>

  <section class="src">
    <h2>How this was counted</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Window</b> — {d.window} · careers counted to {d.countedTo}</li>
      <li><b>Method</b> — {d.method}</li>
      <li><b>Limits</b> — {d.limitation}</li>
    </ul>
    <p class="note">
      <a href="/star-signs">The same people by zodiac sign</a> ·{' '}
      <a href="/works-and-readers">How many charting titles they have</a> ·{' '}
      <a href="/about">How we count</a>
    </p>
  </section>

  <KcwCardnews set="debut" count={5} />

  <KcwRelatedArticles page="/debut-age" />
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: 0.5rem 1rem; }
</style>
