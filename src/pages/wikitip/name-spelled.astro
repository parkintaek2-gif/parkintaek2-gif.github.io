---
/**
 * K Culture Wire — **한국 이름이 영문 위키백과에서 몇 가지로 쓰이나.** (`/name-spelled`)
 *
 * 🔴 [2026-09-05] **기사를 셋이나 내 놓고 그 자료를 담은 지면이 없었다.**
 *   표 약속 검사가 잡아 줬다 — wikipedia-renamed-jungkook…[4.09m] ·
 *   six-korean-stars-renamed…[100] · wikipedia-brackets-one-word…[100] 이
 *   전부 `/streak-vs-read` 를 가리키는데, 그 지면은 «일곱 명»만 담고 있다.
 *   ⛔ 기사가 든 수를 손님이 확인할 자리가 없으면, 그 수는 우리 말일 뿐이다.
 *   ✅ 그래서 이 지면을 만든다. 자료는 이미 있었다(`kcw-name-typed.json`, 100명·732제목).
 *
 * ── 이 지면이 안 하는 것 ─────────────────────────────────
 * ⛔ 어느 철자가 «옳은지» 말하지 않는다. 위키백과의 이름 규칙은 그쪽 것이다.
 * ⛔ 사람이 무엇을 «쳤는지» 말하지 않는다. 우리가 보는 것은 «닿은 제목»이다.
 *   검색엔진이 옛 철자를 새 문서로 바로 보내면 그것은 새 제목 조회로 세어진다 —
 *   그래서 여기 몫은 전부 «바닥값»이다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/kcw-name-typed.json';

const 사람들 = d.사람들 as any[];

/* 🔴 제목·본문에 박은 수가 자료와 어긋나면 빌드를 세운다 */
if (사람들.length !== 100) {
  throw new Error(`이 지면이 「100명」이라고 말하는데 자료는 ${사람들.length} 명이다.`);
}
const 정국 = 사람들.find((p) => p.본지면 === 'Jung Kook');
if (!정국) throw new Error('Jung Kook 을 자료에서 못 찾았다 — 본문이 그를 이름으로 든다.');
const 옛제목 = 정국.제목별.find((t: any) => t.제목 === 'Jungkook');
if (!옛제목) throw new Error('옛 제목 Jungkook 을 못 찾았다.');

const 제목수합 = 사람들.reduce((s, p) => s + p.제목수, 0);
const 조회합 = 사람들.reduce((s, p) => s + p.합계, 0);
const 넘겨받는쪽 = 사람들.filter((p) => !p.으뜸이본지면인가);
const 가운데 = (a: number[]) => {
  const b = [...a].sort((x, y) => x - y);
  const m = b.length >> 1;
  return b.length % 2 ? b[m] : (b[m - 1] + b[m]) / 2;
};
const 몫중간 = 가운데(사람들.map((p) => p.넘겨주기몫));
const 제목많은 = [...사람들].sort((a, b) => b.제목수 - a.제목수).slice(0, 10);
const 쉼표 = (n: number) => n.toLocaleString('en-US');

const TITLE = 'Jungkook, Im Yoon-ah, IU: the spelling readers land on, not the one Wikipedia chose';
const DESC =
  `For ${사람들.length} of the most-read Korean stars we hold ${쉼표(제목수합)} English Wikipedia `
  + `titles and ${쉼표(조회합)} reads across them. ${넘겨받는쪽.length} are reached mostly through `
  + `a title the encyclopedia no longer uses; for the rest the median redirect share is `
  + `${몫중간}%.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://en.wikipedia.org/w/api.php', 'https://wikimedia.org/api/rest_v1/'],
  variableMeasured: ['page title', 'reads per title', 'share arriving by redirect'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/name-spelled">
  <h1>{TITLE}</h1>

  <p class="lead">
    English Wikipedia moved the article about BTS's youngest member to <i>Jung Kook</i> in March
    2025. Most of the reading still arrives at the old title.
  </p>

  <p class="walk">
    <b>Next:</b>{' '}
    <a href="/streak-vs-read">Who the English world actually reads, week by week</a> &middot;{' '}
    <a href="/most-read">The most-read Korean stars</a> &middot;{' '}
    <a href="/bts-star-signs">BTS star signs</a>
  </p>

  <table>
    <caption>What this page counts</caption>
    <thead><tr><th>Measure</th><th>Count</th></tr></thead>
    <tbody>
      <tr><td>People measured</td><td>{사람들.length}</td></tr>
      <tr><td>Titles counted across them</td><td>{쉼표(제목수합)}</td></tr>
      <tr><td>Reads summed across those titles</td><td>{쉼표(조회합)}</td></tr>
      <tr><td>People read mostly through a title the article no longer uses</td><td>{넘겨받는쪽.length}</td></tr>
      <tr><td>Median share arriving by any redirect</td><td>{몫중간}%</td></tr>
      <tr><td><i>Jungkook</i> — the old title, now a redirect</td><td>{쉼표(옛제목.조회)}</td></tr>
      <tr><td><i>Jung Kook</i> — every title summed</td><td>{쉼표(정국.합계)}</td></tr>
      <tr><td>Share of his reading on the old title</td><td>{정국.넘겨주기몫}%</td></tr>
      {/* 🔴 [2026-09-05] 기사는 «4.09m» 꼴로 말하는데 표는 4,089,795 로만 냈다.
          표 약속 검사가 그 어긋남을 잡았다 — 같은 수여도 «손님이 찾는 꼴»이 없으면 없는 것이다. */}
      <tr><td><i>Jungkook</i> reads, in millions</td><td>{(옛제목.조회 / 1e6).toFixed(2)}m</td></tr>
    </tbody>
  </table>

  <h2>The people reached mostly through a dropped title</h2>

  <p>
    For {사람들.length - 넘겨받는쪽.length} of the {사람들.length}, readers land on the article's own
    title and the redirects sit unused. These {넘겨받는쪽.length} are the exception.
  </p>

  <table>
    <caption>Where the reading lands, against where the article now is</caption>
    <thead>
      <tr><th>Person</th><th>Where readers land</th><th>Where the article is</th><th>Share on the other title</th></tr>
    </thead>
    <tbody>
      {넘겨받는쪽
        .sort((a, b) => b.넘겨주기몫 - a.넘겨주기몫)
        .map((p) => (
          <tr>
            <td>{p.이름}</td>
            <td>{p.가장많이들어온이름}</td>
            <td>{p.본지면}</td>
            <td>{p.넘겨주기몫}%</td>
          </tr>
        ))}
    </tbody>
  </table>

  <h2>How many titles one person has</h2>

  <p>
    A title here is any page name that leads to the person's article — a different romanisation, a
    legal name, a bracketed disambiguator, sometimes the Korean spelling. The median person has a
    handful. These ten have the most.
  </p>

  <table>
    <caption>Most titles counted, of the {사람들.length}</caption>
    <thead><tr><th>Article</th><th>Titles</th><th>Reads, all titles</th><th>Share by redirect</th></tr></thead>
    <tbody>
      {제목많은.map((p) => (
        <tr>
          <td>{p.본지면}</td>
          <td>{p.제목수}</td>
          <td>{쉼표(p.합계)}</td>
          <td>{p.넘겨주기몫}%</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="q">
    <b>Every share on this page is a floor.</b> A search engine that sends an old spelling straight
    to the new article produces a new-title read, so the true share arriving at the old name can
    only be higher than what we counted.
  </p>

  {/* 🔴 [2026-09-05] 렌더해서 읽고 잡았다 — 자료의 «우리말 칸»을 그대로 부어
      영문 지면에 한국어가 나갔다. 사장님 「영어뉴스 + 해외 대상」에 정면으로 걸린다.
      ⛔ 자료가 잘못이 아니다. 그릇이 자료를 그대로 부은 것이 잘못이다.
      ✅ 손님에게 나가는 말은 여기서 영문으로 쓴다. */}
  <KcwMethodLimits
    method={{
      'What this is': 'Which page title readers arrive at for the most-read Korean stars we hold, and how much of a person’s reading lands on a title the article no longer uses.',
      Source: 'Wikimedia Pageviews API (monthly) and the en.wikipedia MediaWiki API (redirects)',
      Window: '1 June 2023 to 1 September 2026',
    }}
    limitation={{
      'What this is not': 'Not a record of what anyone typed. We see the title a reader arrived at, not their query, so every share here is a floor. It takes no position on which spelling is correct.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    <li>What anyone typed into a search box. We see the page title a reader arrived at, not the words they searched.</li>
    <li>Search engines that resolve an old spelling straight to the new article. Those arrivals count as new-title reads, so every share here is a floor.</li>
    <li>Whether any title is the right one. Wikipedia's naming rules are its own and this page takes no position on them.</li>
  </ul>
  <KcwRelatedArticles page="/name-spelled" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
  }
</style>
