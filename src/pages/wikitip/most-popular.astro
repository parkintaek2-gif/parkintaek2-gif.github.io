---
/**
 * K Culture Wire — **「가장 인기 있는 한국 드라마」에 세 답을 준다.** (`/most-popular`)
 *
 * ── 왜 (2026-08-23) ───────────────────────────────────────────
 * 잰 수요 — `most popular korean drama` 1번째·10줄 · `best korean drama on netflix` 1번째·10줄
 * ⛔ 그런데 우리는 「best」를 말할 자격이 없습니다. 취향을 판정하지 않습니다.
 * ⭐ 말할 수 있는 것 — **재는 자가 여러 개이고 그 자들이 서로 다른 답을 냅니다.**
 *   답을 주는 대신 **자를 줍니다.** 그게 우리가 나침반이라고 부르는 것입니다.
 *
 * 🔴 실측으로 자를 넷에서 셋으로 줄였습니다 — 「한 주 최대」의 상위 열이 「나라 수」와
 *   **10/10 겹쳤습니다.** 같은 자에 두 이름이 붙어 있었습니다. 그 사실도 지면에 적습니다.
 *   ⛔ 같은 것을 둘로 내놓으면 「우리가 넷을 본다」는 거짓 넉넉함이 됩니다.
 *
 * ⛔ 세 목록을 합쳐 「종합 순위」를 만들지 않습니다 — 그것이 이 지면이 반대하는 짓입니다.
 * ⛔ 차트 자리를 시청시간으로 부르지 않습니다. 넷플릭스는 나라별 시청시간을 안 냅니다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import data from '../../data/wikitip-most-popular.json';

const TITLE = 'Most popular Korean drama on Netflix? Three answers that disagree';
const DESC = 'Ask which Korean title did best on Netflix and the answer depends on what you count. '
  + 'Reach says one title, staying power says another, total chart places says a third — and only '
  + 'one title appears on all three lists.';

const 자 = (k: string) => data.measures.find((m) => m.key === k);
const 겹 = (a: string, b: string) => data.overlaps
  .find((o) => (o.a === a && o.b === b) || (o.a === b && o.b === a))?.sharedOfTen ?? null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${data.weekFrom}/${data.weekTo}`,
  spatialCoverage: `${data.marketCount} countries`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/most-popular">
  <h1>Most popular Korean drama on Netflix?</h1>

  <p class="lead">
    It depends entirely on what you count, and we are not going to hide that behind one list.{' '}
    <b>{자('reach')?.rows[0].title}</b> reached the most countries.{' '}
    <b>{자('duration')?.rows[0].title}</b> stayed on a chart the longest.{' '}
    <b>{자('places')?.rows[0].title}</b> took the most chart places.
    Three questions that sound like one question, three different winners.
  </p>

  <p class="warn">
    <b>None of this measures quality, and none of it counts viewers.</b> Netflix publishes no hours
    and no audience by country &mdash; only a weekly list of ten. So &ldquo;popular&rdquo; here means
    one thing precisely: it was on that list. We will not tell you which Korean drama is best,
    because that is not ours to say.
  </p>

  <section>
    <h2>How little the three lists agree</h2>
    <p class="sub">
      Taking the top ten by each measure and counting how many titles they share:
    </p>
    <table class="ov">
      <tbody>
        <tr><td>Reach and staying power</td><td class="num">{겹('reach', 'duration')} of 10</td></tr>
        <tr><td>Reach and chart places</td><td class="num">{겹('reach', 'places')} of 10</td></tr>
        <tr><td>Staying power and chart places</td><td class="num">{겹('duration', 'places')} of 10</td></tr>
      </tbody>
    </table>
    <p class="sub">
      {data.inEveryList.length === 0
        ? 'No title appears on all three.'
        : (data.inEveryList.length === 1
          ? `Exactly one title is on all three lists: ${data.inEveryList[0].title}.`
          : `${data.inEveryList.length} titles are on all three lists.`)}
      {' '}That is the whole point of this page. A single ranking would have buried it.
    </p>
    <p class="fine">
      <b>We threw one measure away.</b> &ldquo;{data.droppedMeasure.label}&rdquo; produced a top ten
      that shared <b>{data.droppedMeasure.sharedOfTenWithReach} of 10</b> titles with reach &mdash;
      the same measure wearing a second name. {data.droppedMeasure.why}
    </p>
    <p class="fine">
      We also cannot rank by best position reached: <b>{data.titlesAtPeakOne} titles have reached
      number one somewhere</b>, so that column separates almost nothing.
    </p>
  </section>

  {data.measures.map((m) => (
    <section>
      <h2>{m.label}</h2>
      <p class="sub">{m.what} Counted for {m.measuredTitles} of {data.titlesConsidered} titles; the top {data.shownPerMeasure} are shown.</p>
      <table>
        <thead>
          <tr>
            <th>Title</th><th>Kind</th><th class="num">{m.unit}</th>
            <th class="num">Countries</th><th class="num">Weeks</th><th class="num">Best place</th>
          </tr>
        </thead>
        <tbody>
          {m.rows.map((t) => (
            <tr>
              <td class="nm"><a href={`/title/${t.slug}`}>{t.title}</a></td>
              <td class="fine">{t.type === 'TV' ? 'Series' : 'Film'}</td>
              <td class="num"><b>{t.value.toLocaleString('en-US')}</b></td>
              <td class="num">{t.markets ?? '—'}</td>
              <td class="num">{t.weeks ?? '—'}</td>
              <td class="num">{t.peak ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <section>
    <h2>What this is, and what it is not</h2>
    <p class="fine">{data.whatThisIs}</p>
    <p class="fine"><b>Not this.</b> {data.whatThisIsNot}</p>
  </section>

  <section>
    <h2>Where to walk from here</h2>
    <p>
      <a href="/underrated">The ones that ran and ran, almost nowhere</a> &middot;{' '}
      <a href="/where-to-watch">Where each title could actually be watched</a> &middot;{' '}
      <a href="/by-country">Every country and how Korean its chart is</a> &middot;{' '}
      <a href="/firms">Who made them</a> &middot;{' '}
      <a href="/titles">Every Korean title we hold</a>
    </p>
  </section>

  <KcwMethodLimits
    method={`Netflix's own weekly top 10 files, ${data.weekCount} weeks across ${data.marketCount} countries, ${data.weekFrom} to ${data.weekTo}. Reach counts the distinct countries that ever listed a title. Staying power adds up the weeks it held a place anywhere. Chart places counts every country-week slot it occupied. Each list is drawn from the same files and shown separately; we do not combine them into a single score, because the point of the page is that they disagree.`}
    limitation={`A chart place is not a viewing figure — Netflix publishes no hours or viewers by country, so nothing here says how many people watched. None of these measures is a judgement of quality. Best position reached cannot be used to rank, because ${data.titlesAtPeakOne} titles have reached number one in some country. Netflix also states no country of production, so which titles count as Korean is our inference.`}
  />

  <style>
    .lead { font-size: 1.08rem; }
    .warn { border-left: 3px solid var(--accent); padding: .7rem 1rem; margin: 1.4rem 0 2rem;
      font-size: .95rem; }
    h2 { font-size: 1.12rem; margin: 2.4rem 0 .3rem; }
    .sub { color: var(--muted); font-size: .92rem; margin: 0 0 .8rem; }
    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    table.ov { max-width: 30rem; }
    th, td { text-align: left; padding: .4rem .5rem; border-bottom: 1px solid var(--line); }
    th.num, td.num { text-align: right; }
    .nm { font-weight: 600; }
    .fine { color: var(--muted); font-size: .86rem; }
  </style>
</WikiTip>
