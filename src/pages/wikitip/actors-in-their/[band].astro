---
/*
 * actors-in-their/[band].astro — **나이 묶음 지면.** (`/actors-in-their/40s`)
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 사장님 지시: 「**키워드 검색량을 재서 해.**」 2026-08-24 에 재니 —
 * ```
 *   korean actors age      자동완성 1번째 · 그 말로 시작 10줄
 *      korean actors age 40 · age 50 · age 20
 * ```
 * 자료는 이미 있었다 — 9,249명 전원의 생년. 손님이 묻는 낱알만 없었다.
 * 오늘 같은 잘못을 두 번 했다(날 366장인데 손님은 달로 묻고, 「title that charted」라고
 * 적었는데 손님은 「korean drama 2024」로 묻는다). 세 번째는 하지 않는다.
 *
 * ── 🔴 이 지면이 지키는 것 — «나이는 움직이는 수다» ─────────────
 * 우리 지면은 배포할 때만 다시 지어진다. 「마흔인 사람」을 그대로 적으면 해가 바뀌는 날부터
 * 지면이 거짓을 말한다. 「오늘 생일」 지면을 안 만든 것과 같은 함정이다.
 *
 * ⭐ 그래서 나이와 «태어난 해»를 반드시 같이 적는다 —
 *   나이는 기준 해가 있어야 뜻이 있고, 태어난 해는 영원히 안 변한다.
 *   그러면 이 지면이 낡아도 **읽는 사람이 스스로 고쳐 읽을 수 있다.**
 * ⛔ 기준 해를 손으로 적지 않는다 — 자료가 지어진 해를 그대로 쓴다.
 * ⛔ 열세 살 아래 지면은 안 낸다. 세기는 세지만(24명) 아이들을 나이로 모아 놓지 않는다.
 * ⛔ 점을 치지 않는다. 「같은 나이대」는 그 말뿐이다.
 * ⛔ 묶음이 큰 것을 «뜻»으로 읽지 않는다 — 위키데이터는 인구조사가 아니다.
 *   요즘 사람이 더 많이 실리는 것일 수도 있고 우리는 그 둘을 못 가른다. 그 말을 지면에 적는다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-age-bands.json';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다(오늘 그것으로 빌드가
     한 번 멈췄다). 그래서 자료를 여기서 다시 읽지 않고, 지면이 쓸 것은 props 로 건넨다.
     ⛔ `listedOnSite` 가 false 인 묶음은 주소를 «만들지 않는다» — 세는 것과 내는 것은 다르다 */
  const bands = (data.bands ?? []).filter((b) => b.listedOnSite);
  return bands.map((b) => ({
    params: { band: b.slug },
    props: { b, 이웃: bands.filter((x) => x.slug !== b.slug).map((x) => ({ slug: x.slug, name: x.name, people: x.people })) },
  }));
}

const { b, 이웃 } = Astro.props as { b: any; 이웃: any[] };

const 기준해 = data.refYear;
/* 위가 없는 묶음(60s and over)은 이른 해가 없다 — 「1902년부터」라고 적지 않는다.
   대신 자료에 실제로 있는 가장 이른 해를 따로 적는다. 그 둘은 다른 사실이다 */
const 위가없나 = b.ageTo === null;
const 해글 = 위가없나
  ? `born in ${b.coversBornTo} or earlier`
  : `born between ${b.coversBornFrom} and ${b.coversBornTo}`;

const 못실린 = b.people - b.listed;
const 전체 = (data.bands ?? []).reduce((s: number, x: any) => s + x.people, 0);
const 몫 = 전체 > 0 ? (100 * b.people) / 전체 : null;

const 나이글 = 위가없나 ? `${b.ageFrom} or older` : `${b.ageFrom} to ${b.ageTo}`;

const TITLE = `Korean actors in their ${b.name} — ${b.people.toLocaleString('en-US')} of them, and the years they were born`;
const DESC = `${b.people.toLocaleString('en-US')} Korean actors, singers and other entertainers are `
  + `in their ${b.name} as of ${기준해} — that is, ${해글}. `
  + `${b.listed.toLocaleString('en-US')} are named here. Counted from Wikidata birth dates.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/actors-in-their/${b.slug}`}>
  <h1>Korean actors in their {b.name}</h1>

  {/* ⭐ 답을 맨 앞에. 그리고 «기준 해»를 답과 같은 문단에 둔다 — 아래로 내려가면 아무도 안 본다 */}
  <p class="lead">
    <b>{b.people.toLocaleString('en-US')}</b> Korean actors, singers and other entertainers are in
    their {b.name} <b>as of {기준해}</b> — that is, {해글}.
    {' '}<b>{b.listed.toLocaleString('en-US')}</b> of them are named on this page.
    {몫 !== null && <> They are {몫.toFixed(1)}% of the {전체.toLocaleString('en-US')} people we hold.</>}
  </p>

  {/*
    🔴 이 칸을 뺄 수 없다. 나이는 움직이는 수이고 이 지면은 배포할 때만 다시 지어진다.
      태어난 해를 같이 적어 두면 지면이 낡아도 읽는 사람이 스스로 고쳐 읽는다.
  */}
  <p class="warn">
    <b>Ages move; birth years do not.</b> Everyone here was {해글}, and that will still be true
    whenever you read this. The words &ldquo;in their {b.name}&rdquo; are true as of
    {' '}<b>{기준해}</b>, the year this page was built — so if you are reading it later, count from
    the birth years rather than from us.
  </p>

  {(b.top ?? []).length > 0 && (
    <section>
      <h2>Some of the names</h2>
      <p class="note">
        Ordered by how many Wikipedia language editions carry an article about them.
        <b> That measures how widely someone is written about, not how good they are</b>, and it
        favours people who have been famous longer.
      </p>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Name</th><th>Born</th><th>Age in {기준해}</th><th>Wikipedia languages</th></tr></thead>
          <tbody>
            {b.top.map((p: any) => (
              <tr>
                <td class="nm">{p.name}</td>
                <td>{p.born}</td>
                <td class="tot">{기준해 - Number(String(p.born).slice(0, 4))}</td>
                <td>{p.languages ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note fine">
        A dash means we hold no figure, not a zero.
      </p>
    </section>
  )}

  <section>
    <h2>Find someone by the day they were born</h2>
    <p class="note">
      This page groups by age. If you know the date, the birthday pages are the faster way in —
      one page per month, and one per calendar day.
    </p>
    <ul class="walk">
      <li><a href="/born-on">All 366 days of the year</a></li>
      <li><a href="/born-in/january">Month by month, all twelve</a></li>
      <li><a href="/star-sign/cancer">By star sign, twelve of them</a></li>
      <li><a href="/school">By the school they studied at, 55 of them</a></li>
      <li><a href="/community">The twelve birth-year rooms</a></li>
    </ul>
  </section>

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Wikidata</b> — date of birth, best-ranked, day precision only; South Korean citizenship;
        an entertainment occupation. CC0. Ages are computed from the birth year alone, so someone
        whose birthday falls later in {기준해} is counted at the age they reach this year.
      </li>
    </ul>
    <p class="note">
      <b>{못실린.toLocaleString('en-US')} of the {b.people.toLocaleString('en-US')} people in this
      band are counted but not named.</b> Their only name on Wikidata is written in Korean, and this
      is an English-language site — a name our readers cannot read would help nobody. We would
      rather count someone and not name them than leave them out of the count.
    </p>
    <p class="note">
      <b>A bigger band does not mean more people of that age exist.</b> Who has a Wikidata entry is
      decided by editors, not by us. More recent performers may simply be written down more often.
      We hold no way to separate those two, so we do not claim to.
    </p>
    <p class="note fine">
      {data.outsideBands > 0 && (
        <>{data.outsideBands} people in our roster are younger than the youngest band here.
        Their birth years are known — we do not publish an age page about children.</>
      )}
      {data.unreadableBirthYear > 0 && (
        <> {data.unreadableBirthYear} more have a birth date we could not read to the day, and they
        are in none of these bands.</>
      )}
    </p>
  </section>

  <section class="onward">
    <h3>The other bands</h3>
    <ul>
      {이웃.map((x) => (
        <li><a href={`/actors-in-their/${x.slug}`}>Korean actors in their {x.name}</a>
          <span class="fine"> &mdash; {x.people.toLocaleString('en-US')}</span></li>
      ))}
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>
</WikiTip>
