---
/**
 * K Culture Wire — **롤드컵 2026, 두 가지로 센다.** (`/worlds-2026`) · 1번, 2026-10-26
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   10/26 이슈 4편의 축 지면이다. 결과는 어디서나 나온다. 우리는
 *   (1) Riot 공식 일정으로 2024·2025 스위스의 «8강 진출 순서»와 그 팀이 어디까지 갔는지
 *   (2) 16팀 문서가 «어느 언어 위키백과로» 읽히는지를 센다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ 예측하지 않는다. 지난 두 해는 분포다 — 「이것은 통계이지 올해 팀이 아니다」를 화면에 둔다.
 * ⛔ 문서가 없는 팀은 0 으로 채우지 않는다. 「not measured」로 낸다.
 * ⛔ 한국어 위키백과 열람을 «한국 팬의 관심»으로 읽지 않는다 — 한국 독자는 나무위키를 쓰고
 *   그것은 우리가 못 잰다. 화면에 그렇게 적는다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-worlds-2026.json';

const 수 = (n: number | null | undefined) => (n === null || n === undefined ? 'not measured' : Math.round(n).toLocaleString('en-US'));
const 날글 = (s: string | null) => (s ? `${Number(s.slice(6, 8))} ${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][Number(s.slice(4, 6)) - 1]} ${s.slice(0, 4)}` : '—');

const 끝 = (d as any).lastDay as string;
/* 스위스 기간에 받은 날들(UTC 날짜) — 첫 경기 10/23 17:00 UTC 부터 */
const 스위스날 = ['20261023', '20261024', '20261025', '20261026', '20261027'].filter((x) => x <= 끝);

const 팀줄 = Object.entries((d as any).teams).map(([code, t]: [string, any]) => {
  if (!t.editions) return { code, name: t.name, measured: false, why: t.excludedBecause };
  const 줄 = t.editions.map((e: any) => ({
    lang: e.lang,
    reads: 스위스날.reduce((a: number, k: string) => a + (e.daily[k] ?? 0), 0),
  }));
  const 합 = 줄.reduce((a: number, r: any) => a + r.reads, 0);
  줄.sort((a: any, b: any) => b.reads - a.reads);
  const ko = 줄.find((r: any) => r.lang === 'ko');
  return {
    code, name: t.name, measured: true, total: 합, editions: 줄.length,
    top: 줄[0], second: 줄[1],
    topShare: 합 ? Math.round((1000 * 줄[0].reads) / 합) / 10 : null,
    ko: ko ? ko.reads : null,
    record: (d as any).years['2026'].records[code] ?? '—',
  };
}).sort((a: any, b: any) => (b.total ?? -1) - (a.total ?? -1));

const 잰팀 = 팀줄.filter((x: any) => x.measured);
const 못잰팀 = 팀줄.filter((x: any) => !x.measured);

const 대회 = (d as any).tournamentArticle.editions.map((e: any) => ({
  lang: e.lang,
  reads: 스위스날.reduce((a: number, k: string) => a + (e.daily[k] ?? 0), 0),
})).sort((a: any, b: any) => b.reads - a.reads);

const 해들 = ['2024', '2025'].map((y) => ({ y, rows: (d as any).years[y].qualifiedInOrder as any[] }));
const 올해 = (d as any).years['2026'];

const TITLE = 'Worlds 2026, counted: the order teams qualify, and the languages that read them';
const DESC = `Riot's official schedule shows the order teams reached the Worlds quarter-finals in 2024 and 2025 and how far each went. `
  + `Wikipedia shows which language reads each 2026 team: ${잰팀.length} of 16 teams measured, ${못잰팀.length} not.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://lolesports.com/en-US/schedule', 'https://wikimedia.org/api/rest_v1/'],
  temporalCoverage: '2024-10/2026-10',
};
const 언어 = (l: string) => ({ en: 'English', zh: 'Chinese', fr: 'French', es: 'Spanish', ko: 'Korean', vi: 'Vietnamese', de: 'German', ja: 'Japanese', pt: 'Portuguese', ru: 'Russian' } as Record<string, string>)[l] ?? l;
---

{/* ⛔ noAds — Riot 자료를 쓰는 지면이다. Production 승인 전에 광고가 뜨면 API 가 영구 취소된다 */}
<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} page="/worlds-2026" noAds={true}>
  <h1>Worlds 2026, counted two ways</h1>
  <p class="lead">
    The results are everywhere. We count two things the scoreboard does not show: the
    <b>order</b> teams have reached the quarter-finals in past years and how far those teams went,
    and the <b>language</b> each 2026 team is read in on Wikipedia.
  </p>
  <p class="q"><b>This is a statistic, not a forecast.</b> Two past years describe two past fields, not this one.</p>

  <section>
    <h2>2026 Swiss Stage records so far</h2>
    <p class="note">From Riot's official schedule. Three wins reach the quarter-finals; three losses go home.
      {올해.qualifiedInOrder.length} team{올해.qualifiedInOrder.length === 1 ? ' has' : 's have'} qualified:
      {올해.qualifiedInOrder.map((q: any) => `${q.name} (${q.record})`).join(', ')}.</p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Team</th><th>Record</th></tr></thead>
        <tbody>
          {Object.entries(올해.records).sort((a: any, b: any) => (Number(b[1][0]) - Number(a[1][0])) || (Number(a[1][2]) - Number(b[1][2]))).map(([c, r]: any) => (
            <tr><td class="nm">{(d as any).teams[c]?.name ?? c}</td><td>{r}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Who qualified first in 2024 and 2025, and where they finished</h2>
    {해들.map(({ y, rows }) => (
      <div class="scroll-x">
        <table>
          <caption>{y}</caption>
          <thead><tr><th>Order</th><th>Team</th><th>Swiss record</th><th>Went out in / won</th></tr></thead>
          <tbody>
            {rows.map((r: any) => (
              <tr><td>{r.place}</td><td class="nm">{r.name}</td><td>{r.record}</td><td>{r.finish ?? 'not measured'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
    <p class="note">In both years the champion, T1, was not among the first to qualify: fifth in 2024 at 3-1,
      eighth and last in 2025 at 3-2. {(d as any).years['2023'].note}</p>
  </section>

  <section>
    <h2>Which language reads each team</h2>
    <p class="note">Wikipedia reads of each team's article, all language editions added, over the Swiss days
      Wikimedia had published when we built this page (UTC days {스위스날.map(날글).join(', ')}). User traffic only.</p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Team</th><th>Record</th><th>Reads</th><th>Most-read edition</th><th>Its share</th><th>Second</th><th>Korean edition</th></tr></thead>
        <tbody>
          {잰팀.map((t: any) => (
            <tr>
              <td class="nm">{t.name}</td><td>{t.record}</td><td class="tot">{수(t.total)}</td>
              <td>{언어(t.top.lang)}</td><td>{t.topShare}%</td>
              <td>{t.second ? `${언어(t.second.lang)} ${수(t.second.reads)}` : '—'}</td>
              <td>{t.ko === null ? 'no article' : 수(t.ko)}</td>
            </tr>
          ))}
          {못잰팀.map((t: any) => (
            <tr><td class="nm">{t.name}</td><td>{올해.records[t.code] ?? '—'}</td><td colspan="5" class="fine">not measured — {t.why}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="warn">Korean Wikipedia is not where Korean fans look teams up; most use Namuwiki, which publishes
      no reading counts. A small Korean figure here says nothing about interest in Korea.</p>
  </section>

  <section>
    <h2>The tournament article, by language</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Edition</th><th>Reads over the same days</th></tr></thead>
        <tbody>{대회.map((e: any) => (<tr><td>{언어(e.lang)}</td><td>{수(e.reads)}</td></tr>))}</tbody>
      </table>
    </div>
  </section>

  <section class="src">
    <h2>How this was counted</h2>
    <ul>
      <li><b>Records</b> — {(d as any).sources.riot}. A team's order is the match in which it reached three wins.</li>
      <li><b>Reading</b> — {(d as any).sources.wikimedia}. Usual day = median of {날글((d as any).usualDays[0])}–{날글((d as any).usualDays[1])}.</li>
      <li><b>Built</b> — {(d as any).generated}. Last day with reading data: {날글(끝)}.</li>
    </ul>
    <p class="warn">{(d as any).whatThisIsNot}</p>
    <p class="note">
      <a href="/esports-games">Esports by game</a> · <a href="/esports-nations">Esports by nation</a> ·{' '}
      <a href="/corrections">What we have corrected</a> · <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/worlds-2026" />
</WikiTip>
