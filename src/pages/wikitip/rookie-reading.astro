---
/**
 * K Culture Wire — **데뷔 뒤, 영어권 독자가 실제로 늘었나.** (`/rookie-reading`)
 *
 * 🔴 오늘(2026-09-05) 04시경 Cortis 의 「FaSHioN」이 유튜브 1억 뷰를 넘었다.
 *   그 수는 **유튜브 것이고 우리 것이 아니다.** 우리 축은 영문 위키백과 열람수 하나다.
 *   ⇒ 남의 수를 옮겨 적는 대신, **우리 축으로 다시 묻는다** —
 *     「같은 해에 데뷔한 다섯 팀 가운데, 영어권 독자가 실제로 «는» 팀은 몇인가.」
 *
 * ⭐ 답: 하나 올랐고(9.5배), 하나는 그대로고, 셋은 첫 90일보다 «지금 더 적게» 읽힌다.
 *   ⛔ 처음엔 「하나 올랐고 넷이 내렸다」로 썼다가 표와 어긋났다 — 1.1배인 팀을 내림으로 민 것이다.
 *     그래서 갈래를 «셋»으로 두었다. 둘로 가르면 가운데 있는 것을 반드시 한쪽으로 밀게 된다.
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 「덜 읽히니 실패했다」고 말하지 않는다. 우리는 «영어권 열람»만 잰다 — 한국 안은 못 잰다
 * ⛔ 1억 뷰와 열람수를 인과로 잇지 않는다. 오늘치 열람수는 아직 채워지지도 않았다
 * ⛔ 평균을 쓰지 않는다 — 이정표가 있는 하루가 평균을 통째로 민다. 중간값으로 센다
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-rookie-reading.json';

type 줄 = {
  label: string; debut: string; note: string; 갈래: string;
  medianFirst90: number | null; medianLast30: number | null;
  peak: { date: string; views: number; dayAfterDebut: number } | null;
  days: number;
};

const 모두 = (d.rows as any[]) as 줄[];
const 신인 = 모두.filter((r) => r.갈래 === '2025년 데뷔' && r.medianFirst90 && r.medianLast30);
const 눈금 = 모두.filter((r) => r.갈래 === '눈금');

const 배수 = (r: 줄) => (r.medianLast30 as number) / (r.medianFirst90 as number);
/**
 * 🔴 셋으로 가른다 — 「올랐다 / 그대로다 / 내렸다」.
 * ⛔ 「올랐다 vs 내렸다」 둘로만 가르면 1.1배인 팀을 어느 쪽에 넣어도 거짓말이 된다.
 *   실제로 첫 판에서 그렇게 썼다가 「나머지 넷이 내렸다」는 문장이 표와 어긋났다.
 *   ±20% 를 「그대로」로 둔다 — 하루하루가 그만큼은 그냥 흔들린다.
 */
const 오름 = 신인.filter((r) => 배수(r) > 1.2);
const 그대로 = 신인.filter((r) => 배수(r) >= 0.8 && 배수(r) <= 1.2);
const 내림 = 신인.filter((r) => 배수(r) < 0.8);
const 큰순 = [...신인].sort((a, b) => 배수(b) - 배수(a));
const 으뜸 = 큰순[0];
const 으뜸배 = Math.round(배수(으뜸) * 10) / 10;

/* 🔴 제목·본문이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (신인.length !== 5) throw new Error(`2025년 데뷔 팀이 다섯이 아니라 ${신인.length}팀이다 — 제목이 「다섯」이라 말한다.`);
if (오름.length + 그대로.length + 내림.length !== 신인.length) throw new Error('세 갈래를 더해도 다섯이 아니다.');
if (오름.length !== 1) throw new Error(`올라간 팀이 하나가 아니라 ${오름.length}팀이다 — 제목을 다시 써야 한다.`);
if (으뜸.label !== 'Cortis') throw new Error(`가장 많이 오른 팀이 Cortis 가 아니라 ${으뜸.label} 이다.`);
if (으뜸배 !== 9.5) throw new Error(`제목이 9.5배라 말하는데 자료는 ${배수(으뜸).toFixed(1)}배다.`);
if (내림.length !== 3) throw new Error(`내려간 팀이 셋이 아니라 ${내림.length}팀이다 — 설명글을 다시 써야 한다.`);

const 쉼표 = (n: number | null) => (n === null ? '—' : Number(n).toLocaleString('en-US'));
const 배 = (r: 줄) => `${배수(r).toFixed(1)}x`;
const 날 = (s: string) => `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}`;

/* 세 팀의 «가장 높은 날»이 같은 날인 것을 기계가 찾아낸다 — 손으로 적지 않는다 */
const 날별 = new Map<string, string[]>();
for (const r of 신인) if (r.peak) 날별.set(r.peak.date, [...(날별.get(r.peak.date) ?? []), r.label]);
const 겹친날 = [...날별.entries()].filter(([, v]) => v.length >= 2).sort((a, b) => b[1].length - a[1].length)[0] ?? null;

const TITLE = `Five K-pop groups debuted in 2025. One is read ${으뜸배}x more in English now`;
const DESC =
  'We count daily English Wikipedia readers for the five K-pop groups that debuted in 2025. '
  + `${으뜸.label} is read ${배(으뜸)} what it was in its first 90 days. ${그대로.length} held level and `
  + `${내림.length} are read less now than then. Medians, not averages — one milestone day moves an average.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/'],
  temporalCoverage: '2025-01-01/..',
  variableMeasured: ['daily English Wikipedia pageviews', 'days since debut'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/rookie-reading">
  <h1>{TITLE}</h1>

  <p class="lead">
    A debut puts a group in front of Korea. It does not, by itself, put them in front of readers who
    write in English. We can watch that second thing happen — or not happen — one day at a time.
  </p>

  <p class="walk">
    <b>Next:</b>{' '}
    <a href="/most-read">The most-read Korean stars</a> &middot;{' '}
    <a href="/cannot-see">Who our numbers cannot see at all</a> &middot;{' '}
    <a href="/data">Everything we publish</a>
  </p>

  <div class="scroll-x">
    <table>
      <caption>
        Daily English Wikipedia readers — the median of the first 90 days after debut, against the
        median of the last 30 days
      </caption>
      <thead>
        <tr>
          <th>Group</th>
          <th>Debuted</th>
          <th>First 90 days</th>
          <th>Last 30 days</th>
          <th>Change</th>
        </tr>
      </thead>
      {/* 색칠은 본문 갈래와 «같은 선»(1.2 / 0.8)을 쓴다 — 표와 글이 다른 선을 쓰면 읽는 사람이 헷갈린다.
          ⛔ 이 주석을 map 안 화살표 «뒤»로 옮기지 말 것. 화살표는 식 하나만 돌려주므로 빌드가 선다 */}
      <tbody>
        {큰순.map((r) => (
          <tr class={배수(r) > 1.2 ? 'up' : 배수(r) < 0.8 ? 'down' : undefined}>
            <th scope="row">{r.label}<span class="note">{r.note}</span></th>
            <td>{r.debut}</td>
            <td>{쉼표(r.medianFirst90)}</td>
            <td>{쉼표(r.medianLast30)}</td>
            <td>{배(r)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="q">
    <b>Medians, not averages.</b> A group can have one enormous day — an award show, a milestone, a
    piece of news — and an average would carry that day into every sentence we write afterwards. The
    median asks a different question: <i>on an ordinary day, how many people read about them?</i>
  </p>

  <h2>One up, {그대로.length} level, {내림.length} down</h2>

  <p>
    {으뜸.label} is read {배(으뜸)} as often on an ordinary day now as in its first 90 days
    &mdash; from {쉼표(으뜸.medianFirst90)} to {쉼표(으뜸.medianLast30)} readers a day.
    {' '}{그대로.map((r) => r.label).join(', ')} sits about where it started.
    {' '}{내림.map((r) => r.label).join(', ')} are each read less today than in their opening months
    &mdash; {내림.map((r) => `${r.label} ${배(r)}`).join(', ')}.
  </p>

  <p>
    That is the ordinary shape, and it is worth saying plainly: <b>for most groups the debut months
    are the high point of English attention, not the start of a climb.</b> The interesting case is
    the exception.
  </p>

  {겹친날 && (
    <>
      <h2>One day is the high-water mark for {겹친날[1].length} of the five</h2>
      <p>
        {겹친날[1].join(', ')} each had their single most-read day on <b>{날(겹친날[0])}</b>.{' '}
        We record that because it is in the data. <b>We do not know why</b> — our measure holds
        reader counts and dates, nothing that explains them. A shared date suggests a shared event;
        naming that event would be a guess, so we do not name one.
      </p>
    </>
  )}

  <h2>What an established group looks like on the same scale</h2>

  <div class="scroll-x">
    <table>
      <caption>Groups past their rookie years, on the same measure (last 30 days)</caption>
      <thead>
        <tr><th>Group</th><th>Debuted</th><th>Last 30 days</th><th>Most-read day on record</th></tr>
      </thead>
      <tbody>
        {눈금.map((r) => (
          <tr>
            <th scope="row">{r.label}<span class="note">{r.note}</span></th>
            <td>{r.debut}</td>
            <td>{쉼표(r.medianLast30)}</td>
            <td>{r.peak ? `${쉼표(r.peak.views)} on ${날(r.peak.date)}` : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    These are here as a ruler, not a target. They put the rookie numbers in proportion:
    {' '}<b>{눈금.map((r) => `${r.label} ${쉼표(r.medianLast30)}`).join(', ')}</b> readers a day, seven
    and eleven years past their own debuts.
  </p>

  <KcwMethodLimits
    method={{
      'What this is': 'Daily English Wikipedia pageviews for each group, counted from its debut date, '
        + 'reported as medians so a single large day cannot carry the figure.',
      Source: 'Wikimedia Pageviews API — en.wikipedia, all-access, user agents only (bots excluded)',
      'Why medians': 'One award show or one milestone can be twenty times an ordinary day. An average '
        + 'would fold that day into every comparison.',
    }}
    limitation={{
      'What this is not': 'Not a measure of popularity in Korea, and not a measure of streaming, sales '
        + 'or video views. It counts people who opened an English encyclopedia page. A group with a '
        + 'thin English article will read low here for that reason alone.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    <li>Today and yesterday. Wikimedia fills these counts in with about a day's delay, so the most recent days are absent rather than zero.</li>
    <li>Why any peak happened. We hold dates and counts. Attributing a spike to a specific event would be a guess dressed as a finding.</li>
    <li>Readers in Korean, or on any platform other than English Wikipedia. Those are different audiences and we do not hold matched counts for them.</li>
    <li>Groups with no English article at all — they produce no row here. <a href="/cannot-see">We counted how many that is</a>.</li>
  </ul>

  {/* 🔴 수집기가 스스로 적어 둔 「못 잰 것」을 그대로 낸다 — 자료 안에만 두고 지면에 안 내면
      그것은 못 쟀다고 «적은» 것이 아니다. `check-data-keys-shown` 이 그 자리를 지킨다.
      ⛔ `(d as any).x` 로 읽지 않는다 — 그 자는 `d.x` 라는 «글자»를 찾는다. */}
  <p class="q">
    <b>The collector's own note, printed as it wrote it:</b> {d.notMeasured.join(' · ')}
  </p>

  <p class="asof">
    Measured {d.measuredAt}. {d.measures}. Source: {d.source}.
    {d.daysNotFilled.length > 0 && (
      <> Days Wikimedia has not filled in yet: {d.daysNotFilled.join(', ')} &mdash; absent, not zero.</>
    )}
  </p>

  <KcwRelatedArticles page="/rookie-reading" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  .note { display: block; font-weight: 400; font-size: .8rem; color: #666; }
  tr.up td, tr.up th { background: #eaf6ee; }
  tr.down td, tr.down th { background: #fbf3f3; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    .note { color: #999; }
    .asof { color: #999; }
    tr.up td, tr.up th { background: #17251b; }
    tr.down td, tr.down th { background: #2a1c1c; }
  }
</style>
