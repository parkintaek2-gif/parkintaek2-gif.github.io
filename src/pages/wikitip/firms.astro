---
/**
 * K Culture Wire — **회사에서 작품으로 걸어가는 복도.** (`/firms`)
 *
 * ── 왜 (2026-08-22) ───────────────────────────────────────────
 * 자동완성에서 `studio dragon dramas` 가 1번째로 뜨고 제안이 10줄인데
 * (`studio dragon drama list` · `studio dragon kdrama` · `studio dragon on netflix` …)
 * 우리에게 **Studio Dragon 지면이 없었습니다.** 자료에는 27편이 있습니다.
 * `/firm/<slug>` 여덟 장은 **이름 차례**로 골라서(2번 지시) 사람이 찾는 이름이 다 빠졌습니다.
 * ⛔ 그 여덟 장 규칙을 안 건드리고 **복도**를 냅니다 — 나라 93장에 `/by-country` 를 낸 것과 같습니다.
 *
 * ⭐ 색인에도 듣습니다. 작품 지면 528장의 들어오는 링크 중간값이 1이었고
 *   「발견만 하고 안 넣음」이 16.7% 였습니다. 이 한 장이 작품 지면으로 **595개**를 냅니다.
 *
 * ── ⛔ 이 지면이 하지 않는 것 ─────────────────────────────────
 * ⛔ 회사끼리 줄세우지 않습니다 — **이름 차례**입니다. 편수 순이면 방송사가 위로 가서
 *   「좋은 회사 순서」로 읽힙니다.
 * ⛔ 「크레딧이 없다」를 「회사가 없다」로 쓰지 않습니다. 위키데이터에 없는 것입니다.
 * ⛔ 등급(A/B/C)을 화면에 내지 않습니다 — 그것은 회사의 등급이 아니라 **우리 확신의 등급**입니다.
 * ⚠ 한글 역할(제작·배급·첫방송)은 자료에만 있고 화면에는 영어로만 나갑니다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import data from '../../data/wikitip-firm-index.json';

const TITLE = 'Who made it? Every company behind a charting Korean title';
const DESC = 'Studio Dragon, tvN, SBS, SHOWBOX and every other company credited on a Korean series or '
  + 'film that has entered a Netflix weekly top 10 — with the titles we hold for each. Alphabetical, '
  + 'because this is not a ranking.';

const 역할말 = (r: string[]) => (r.length ? r.join(', ') : null);

/* 첫 글자로 갈라 놓는다 — 85곳을 한 덩어리로 두면 아무도 자기가 찾는 이름을 못 찾는다 */
const 묶음: { 글자: string; 것들: typeof data.companies }[] = [];
for (const c of data.companies) {
  const 글자 = c.firm[0].toUpperCase();
  const 끝 = 묶음[묶음.length - 1];
  if (끝 && 끝.글자 === 글자) 끝.것들.push(c);
  else 묶음.push({ 글자, 것들: [c] });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${data.weekFrom}/${data.weekTo}`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://www.wikidata.org'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/firms">
  <h1>Who made it?</h1>

  <p class="lead">
    Every company credited on a Korean title that has reached a Netflix weekly top 10 somewhere —
    {data.companyCount} of them, across {data.titlesConsidered} titles and
    {data.marketCount} countries. Companies are listed <b>alphabetically</b>. Ordering them by how
    many titles they have would put the broadcasters on top and read as a league table, and this is
    not one.
  </p>

  <p class="warn">
    <b>{data.titlesWithNoCredit} of those titles carry no company credit at all.</b> Every film and
    series has a maker; Wikidata does not always record one. That is a hole in the record, not a
    title without a company, and it is why the counts below add to less than the whole shelf.
  </p>

  <section>
    <h2>Companies with more than one title</h2>
    <p class="sub">
      {data.companiesWithTwoOrMore} companies. A credit here means the company is recorded as having
      {data.roleWords.slice(0, -1).join(', ')} or {data.roleWords[data.roleWords.length - 1]} the
      title. {data.detailPageCount} of these have a fuller page of their own, linked where it exists.
    </p>

    {묶음.map((g) => (
      <div class="grp">
        <h3>{g.글자}</h3>
        {g.것들.map((c) => (
          <div class="firm">
            <p class="nm">
              {c.hasDetailPage
                ? <a href={`/firm/${c.detailSlug}`}><b>{c.firm}</b></a>
                : <b>{c.firm}</b>}
              <span class="fine"> &middot; {c.titleCount} titles</span>
              {역할말(c.roles) && <span class="fine"> &middot; {역할말(c.roles)}</span>}
            </p>
            <p class="row">
              {c.titles.map((t, i) => (
                <span>
                  {i > 0 ? ' · ' : ''}
                  <a href={`/title/${t.slug}`}>{t.title}</a>
                  <span class="fine"> {t.weeks}w</span>
                </span>
              ))}
            </p>
          </div>
        ))}
      </div>
    ))}
  </section>

  <section>
    <h2>Companies with one title here</h2>
    <p class="sub">
      {data.companiesWithOne} companies are credited on exactly one charting title. They are named
      rather than dropped &mdash; one title is a real credit, and a company with one entry here may
      have a catalogue we simply cannot see.
    </p>
    <p class="row">
      {data.singleTitleCompanies.map((c, i) => (
        <span>
          {i > 0 ? ' · ' : ''}{c.firm} <span class="fine">(<a href={`/title/${c.titleSlug}`}>{c.title}</a>)</span>
        </span>
      ))}
    </p>
  </section>

  <section>
    <h2>What this list is, and what it is not</h2>
    <p class="fine">{data.whatThisIs}</p>
    <p class="fine"><b>Not this.</b> {data.whatThisIsNot}</p>
  </section>

  <section>
    <h2>Where to walk from here</h2>
    <p>
      <a href="/who-makes-it">How concentrated the making is</a> &middot;{' '}
      <a href="/by-country">Every country and how Korean its chart is</a> &middot;{' '}
      <a href="/underrated">The ones that ran and ran, almost nowhere</a> &middot;{' '}
      <a href="/titles">Every Korean title we hold</a> &middot;{' '}
      <a href="/community">All the rooms</a>
    </p>
  </section>

  <KcwMethodLimits
    method={`Netflix's own weekly top 10 files, ${data.weekCount} weeks across ${data.marketCount} countries, ${data.weekFrom} to ${data.weekTo}, joined to company credits from Wikidata — production company, original broadcaster and distributor. A title is counted once per company even when that company holds two roles on it. Companies are ordered by name, and the titles under each are ordered by how many weeks they lasted, which is a property of the title and not a judgement of the company.`}
    limitation={`Credits come from Wikidata and are incomplete: ${data.titlesWithNoCredit} of the ${data.titlesConsidered} titles with a page here carry no company credit at all, so every count on this page is a floor rather than a total. This is also not a filmography — only titles that entered a weekly top 10 somewhere appear, so a company's biggest domestic work can be missing. Netflix states no country of production, so which titles count as Korean is our inference.`}
  />

  <style>
    .lead { font-size: 1.06rem; }
    .warn { border-left: 3px solid var(--accent); padding: .7rem 1rem; margin: 1.4rem 0 2rem;
      font-size: .95rem; }
    h2 { font-size: 1.12rem; margin: 2.4rem 0 .3rem; }
    h3 { font-size: .95rem; margin: 1.6rem 0 .2rem; color: var(--accent); }
    .sub { color: var(--muted); font-size: .92rem; margin: 0 0 .8rem; }
    .firm { margin: 0 0 .9rem; }
    .nm { margin: 0 0 .15rem; }
    .row { margin: 0; line-height: 1.9; font-size: .93rem; }
    .fine { color: var(--muted); font-size: .82rem; }
  </style>
</WikiTip>
