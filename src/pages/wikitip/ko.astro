---
/**
 * K Culture Wire — **한국어 리뷰 초기화면.** (`/ko`)
 *
 * ── 🔴🔴 사장님 지시 (2026-10-26, 원문) ───────────────────────────────
 * 「스포츠경기, 드라마, 예능 등 TV,OTT 프로그램 **리뷰로 콘셉트를 바꾸자.**
 *   케이컬쳐와이어를 **한국어와 영어로** 서비스하자... 당장 오늘부터 기획, 디자인,
 *   개발을 해라... **모든 카테고리에 기사 한 건을 매일 쓸 필요는 없다.**」
 * 「리뷰라고 꼭 비평일 필요는 없다. **오히려 네티즌들의 댓글을 리뷰로 사용하도록 해라.**」
 *
 * ── ⛔ 본 지면이 준수하는 사항 ────────────────────────────────────────
 * ⛔ **순위를 매기지 않는다.** 조회수·평점 순위표를 작성하지 않는다(사장님 2026-08-04).
 *   발행 순서로 배열한다.
 * ⛔ **공란인 분류를 은폐하지 않는다.** 메뉴에는 9종이 모두 있다. 리뷰가 없는 분류를
 *   초기화면에서 허위로 채우지 않고 「아직 없다」를 그대로 기재한다.
 * ⛔ 광고 영역을 생성하지 않는다. Riot Production(App 866800) 승인 전이다.
 */
import { getCollection } from 'astro:content';
import WikiTip from '../../layouts/WikiTip.astro';
import { 분류 } from '../../lib/리뷰분류.mjs';

const 리뷰목록 = (await getCollection('kcwReviews'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const 분류명 = new Map(분류.map((c) => [c.코드, c.명칭]));
const 분류별건수 = new Map(
  분류.map((c) => [c.코드, 리뷰목록.filter((r) => r.data.category === c.코드).length]),
);

const 날짜표기 = (d: Date) => {
  const t = new Date(d);
  return `${t.getFullYear()}년 ${t.getMonth() + 1}월 ${t.getDate()}일`;
};

const TITLE = 'K Culture Wire 리뷰 — 경기·드라마·쇼와 이용자 반응';
const DESC = '롤드컵·야구·축구·농구·배구 경기와 드라마·예능 리뷰. 당일 결과와 다음 일정, '
  + '그리고 이용자들이 실제로 남긴 반응을 함께 싣는다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  inLanguage: 'ko',
  name: TITLE,
  description: DESC,
  url: 'https://www.kculturewire.com/ko',
};
---

<WikiTip
  title={TITLE}
  description={DESC}
  lang="ko"
  page="/ko"
  jsonLd={jsonLd}
  noindex={리뷰목록.length === 0}
>
  <h1>리뷰</h1>

  <p class="lede">
    경기 1건, 드라마 1개 회차를 <b>본 내용 그대로</b> 정리한다. 스포츠는 당일 결과와
    다음 일정까지, 방송·OTT는 최근 회차를 다룬다. 그리고 <b>이용자 반응</b>을 원문대로 전재한다.
    분류는 9종이고, 분류마다 매일 작성하지는 않는다.
  </p>

  {리뷰목록.length === 0 && (
    <p class="none">아직 등록된 리뷰가 없다.</p>
  )}

  {리뷰목록.length > 0 && (
    <ul class="list">
      {리뷰목록.map((r) => (
        <li>
          <span class="cat">{분류명.get(r.data.category) ?? r.data.category}</span>
          <a href={`/ko/review/${r.id}`}>{r.data.title}</a>
          <p class="dek">{r.data.dek}</p>
          <p class="when">
            {날짜표기(r.data.pubDate)} · 대상: {r.data.subject.명칭}
          </p>
        </li>
      ))}
    </ul>
  )}

  <h2>분류</h2>
  {/* ⚠ 리뷰가 0건인 분류도 **표시한다.** 숨기면 이용자가 「여기는 야구를 다루지 않나」를
      알 수 없다. 대신 건수를 그대로 기재한다 — 0을 은폐하지 않는다. */}
  <ul class="cats">
    {분류.map((c) => (
      <li>
        <a href={`/ko/${c.코드}`}>{c.명칭}</a>
        <span class="n">{분류별건수.get(c.코드)}건</span>
        <p class="dek">{c.설명}</p>
      </li>
    ))}
  </ul>

  <h2>사진의 출처</h2>
  {/* 🔴 사장님이 분류별로 지시하신 사항을 이용자에게도 공개한다 — 공개가 곧 준수 장치다 */}
  <ul class="rules">
    <li><b>스포츠</b> — 구단이나 해당 협회가 제공하는 <b>경기 사진</b>. 엠블럼·로고는 사용하지 않는다.</li>
    <li><b>TV 프로그램</b> — 각 방송사 홈페이지의 사진.</li>
    <li><b>OTT 프로그램</b> — 제공처가 해당 OTT 로 명시된 사진.</li>
  </ul>
  <p class="fine">
    입수 경로는 사진마다 기재한다. 오류가 있으면 <a href="/contact">알려 주시면</a>
    {' '}<a href="/corrections">정정</a>에 기록한다.
  </p>
</WikiTip>

<style>
  h1 { font-size: 1.6rem; letter-spacing: -.02em; margin: 0 0 .6rem; }
  h2 { font-size: 1.1rem; margin: 2.4rem 0 .8rem; }
  .lede { color: var(--muted); margin: 0 0 2rem; }
  .none { color: var(--muted); }
  .list, .cats, .rules { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 1rem 0; border-top: 1px solid var(--line); }
  .list a { font-weight: 700; font-size: 1.05rem; }
  .cat { display: inline-block; font-size: .74rem; color: var(--accent);
         font-weight: 700; margin-right: .5rem; }
  .dek { margin: .3rem 0 0; color: var(--muted); font-size: .9rem; }
  .when { margin: .3rem 0 0; color: var(--muted); font-size: .8rem; }
  .cats li { padding: .7rem 0; border-top: 1px solid var(--line); }
  .cats a { font-weight: 700; }
  .n { color: var(--muted); font-size: .8rem; margin-left: .5rem; }
  .rules li { padding: .45rem 0; }
  .fine { color: var(--muted); font-size: .84rem; }
</style>
