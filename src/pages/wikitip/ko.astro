---
/**
 * K Culture Wire — **K-Review 첫 화면.** (`/ko`)
 *
 * ── 🔴🔴 사장님 지시 (2026-10-26, 원문) ───────────────────────────────
 * 「**경기·드라마·쇼 리뷰와 이용자 반응 >>> 이게 뭐니 / K-Review 등처럼 영어로 이해되는
 *   단어로 바꿔, 주저리주저리 나열하지마**」
 * 「**K Culture Wire BI 만들 걸 활용해, 칼럼을 1칼럼에서 2칼럼으로 늘려서 본 콘텐트를
 *   가로 영역의 2/3크기로 싣고, 인기 콘텐트와 오늘 콘텐트 등 템플릿을 가로영역 1/3 크기로
 *   배치해...<분류>라는 말 삭제해**」
 * 「**기사 소재, 제목, 키워드 등 모든 걸 독자들의 시선에 맞춰서 반드시 클릭하고 싶게 만들어**」
 * 「순한글, 번역투, 너희 ai만 쓰는 표현 금지 = **네 사이트 공동으로 지켜야 할 핵심지침**」
 *
 * ── ⛔ 이 화면이 지키는 것 ────────────────────────────────────────────
 * ⛔ **「분류」라는 말을 쓰지 않는다.** 사장님이 이름을 대어 지우라 하셨다.
 * ⛔ **내부 사정을 적지 않는다.** 여기에 「사장님 지시로…」가 적힌 채 라이브로 나간 적이 있다.
 * ⛔ **순위를 매기지 않는다.** 「인기 콘텐트」는 조회 집계로만 세우고, 집계가 없으면
 *   없다고 밝히고 최근 글을 보여 준다 — 임의로 고르지 않는다.
 * ⛔ 광고 영역을 생성하지 않는다. Riot Production(App 866800) 승인 전이다.
 */
import { getCollection } from 'astro:content';
import WikiTip from '../../layouts/WikiTip.astro';
import { 분류 } from '../../lib/리뷰분류.mjs';
import ga4 from '../../data/kcw-ga4-pages.json';

const 리뷰목록 = (await getCollection('kcwReviews'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const 분류명 = new Map(분류.map((c) => [c.코드, c.명칭]));
const 건수 = new Map(분류.map((c) => [c.코드, 리뷰목록.filter((r) => r.data.category === c.코드).length]));

const 날짜표기 = (d) => {
  const t = new Date(d);
  return `${t.getFullYear()}년 ${t.getMonth() + 1}월 ${t.getDate()}일`;
};
const 날짜키 = (d) => new Date(d).toISOString().slice(0, 10);

/* 오늘 콘텐트 — **가장 최근에 글이 올라온 날**의 글. 글이 없는 날에도 비지 않는다 */
const 최근날 = 리뷰목록.length ? 날짜키(리뷰목록[0].data.pubDate) : null;
const 오늘것 = 리뷰목록.filter((r) => 날짜키(r.data.pubDate) === 최근날);

/**
 * 인기 콘텐트 — GA4 가 센 조회로 세운다.
 * ⛔ 조회가 없는데 아무거나 올려 「인기」라고 하지 않는다. 그때는 그렇다고 밝히고
 *   최근 글을 보여 준다. 사람이 믿는 것은 숫자가 아니라 숫자를 다루는 태도다.
 */
const 조회표 = new Map(
  (ga4.rows ?? [])
    .filter((r) => String(r.path ?? '').startsWith('/ko/review/'))
    .map((r) => [String(r.path).replace('/ko/review/', ''), r.users ?? 0]),
);
const 조회있나 = 조회표.size > 0;
const 인기것 = 조회있나
  ? [...리뷰목록].sort((a, b) => (조회표.get(b.id) ?? 0) - (조회표.get(a.id) ?? 0)).slice(0, 5)
  : 리뷰목록.slice(0, 5);

const TITLE = 'K-Review — 경기와 드라마, 그날의 반응';
const DESC = '야구·축구·골프·농구·e스포츠 경기와 드라마·예능 리뷰. 그날 결과와 다음 일정, '
  + '그리고 네티즌이 남긴 반응을 함께 싣습니다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  inLanguage: 'ko',
  name: TITLE,
  description: DESC,
  url: 'https://www.kculturewire.com/ko',
};
---

<WikiTip
  title={TITLE}
  description={DESC}
  lang="ko"
  wide={true}
  page="/ko"
  jsonLd={jsonLd}
  noindex={리뷰목록.length === 0}
>
  <div class="two-col">
    {/* ── 본 콘텐트 (가로 2/3) ───────────────────────────────── */}
    <main>
      {리뷰목록.length === 0 && (
        <p class="none">아직 올라온 리뷰가 없습니다.</p>
      )}

      {리뷰목록.length > 0 && (
        <ul class="list">
          {리뷰목록.map((r) => (
            <li class={r.data.image ? 'with-thumb' : ''}>
              <span class="cat">{분류명.get(r.data.category) ?? r.data.category}</span>
              {r.data.image && (
                <a class="thumb" href={`/ko/review/${r.id}`} tabindex="-1" aria-hidden="true">
                  <img src={r.data.image.src} alt="" loading="lazy" />
                </a>
              )}
              <a class="t" href={`/ko/review/${r.id}`}>{r.data.title}</a>
              <p class="dek">{r.data.dek}</p>
              <p class="when">{날짜표기(r.data.pubDate)} · {r.data.subject.명칭}</p>
            </li>
          ))}
        </ul>
      )}

    </main>

    {/* ── 옆 칸 (가로 1/3) ───────────────────────────────────── */}
    <aside>
      <section class="box">
        <h2>오늘 콘텐트</h2>
        {오늘것.length === 0 && <p class="fine">아직 올라온 글이 없습니다.</p>}
        {오늘것.length > 0 && (
          <>
            <p class="fine">{날짜표기(최근날)}</p>
            <ul>
              {오늘것.map((r) => (
                <li>
                  <span class="cat">{분류명.get(r.data.category)}</span>
                  <a href={`/ko/review/${r.id}`}>{r.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

      <section class="box">
        <h2>인기 콘텐트</h2>
        {/* ⛔ 조회가 없는데 「인기」라고 하지 않는다 — 없으면 없다고 적는다 */}
        {!조회있나 && (
          <p class="fine">조회 집계가 쌓이기 전까지는 최근 글을 보여 드립니다.</p>
        )}
        <ul>
          {인기것.map((r) => (
            <li>
              <span class="cat">{분류명.get(r.data.category)}</span>
              <a href={`/ko/review/${r.id}`}>{r.data.title}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="box">
        <h2>K Culture Wire</h2>
        <p class="fine">
          영어로는 한국 대중문화를 데이터로 다룹니다.
          {' '}<a href="/" hreflang="en" lang="en">English edition</a>
        </p>
      </section>
    </aside>
  </div>
</WikiTip>

<style>
  h1 { display: none; }
  .lede { color: var(--muted); margin: 0 0 1.8rem; font-size: 1.02rem; }
  .none { color: var(--muted); }

  /* 🔴 사장님 — 「본 콘텐트를 가로 영역의 2/3, 인기·오늘 콘텐트를 1/3」 */
  .two-col { display: grid; grid-template-columns: 2fr 1fr; gap: 2.4rem; align-items: start; }
  @media (max-width: 760px) { .two-col { grid-template-columns: 1fr; gap: 1.8rem; } }

  h2 { font-size: 1.05rem; margin: 2.4rem 0 .8rem; }
  main > h2:first-of-type { margin-top: 2.8rem; }
  .list, .cats, .rules { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 1.1rem 0; border-top: 1px solid var(--line); }
  /* ⚠ :has() 를 안 쓴다 — 안 도는 바우저가 있으면 짱이 통째로 무너진다.
     사진이 있는 줄에만 직접 이름표를 달아 갈라 낸다 */
  .list li.with-thumb { display: grid; grid-template-columns: 96px 1fr; gap: 0 .9rem; align-items: start; }
  .list li.with-thumb > .cat,
  .list li.with-thumb > .t,
  .list li.with-thumb > .dek,
  .list li.with-thumb > .when { grid-column: 2; }
  .thumb { grid-column: 1; grid-row: 1 / span 4; line-height: 0; }
  /* 🔴 [2026-10-28 · 사장님] 「썸네일에 사람 얼굴이 잘렸잖아. 사진을 위를 기준으로 하면
     얼굴이 잘리지 않을거야」
     ⛔ object-fit: cover 는 기준이 «가운데»라 세로로 긴 사진의 위아래를 똑같이 잘라 낸다.
       경기·인물 사진은 얼굴이 위쪽에 있어 그 절반이 날아갔다.
     ⇒ 자르는 기준을 위로 옮긴다. 발밑이 잘리는 것은 얼굴이 잘리는 것보다 낫다. */
  .thumb img { width: 96px; height: 64px; object-fit: cover; object-position: top; border-radius: 4px; }
  .t { font-weight: 700; font-size: 1.04rem; line-height: 1.4; }
  .cat { display: inline-block; font-size: .72rem; color: var(--accent); font-weight: 700; }
  .dek { margin: .25rem 0 0; color: var(--muted); font-size: .89rem; }
  .when { margin: .25rem 0 0; color: var(--muted); font-size: .78rem; }
  .cats li { padding: .7rem 0; border-top: 1px solid var(--line); }
  .cats a { font-weight: 700; }
  .n { color: var(--muted); font-size: .78rem; margin-left: .45rem; }
  .rules li { padding: .45rem 0; }
  .fine { color: var(--muted); font-size: .82rem; margin: .35rem 0 0; }

  aside .box { border: 1px solid var(--line); border-radius: 6px; padding: .9rem 1rem;
               margin: 0 0 1.1rem; background: var(--card); }
  aside h2 { margin: 0 0 .5rem; font-size: .92rem; }
  aside ul { list-style: none; padding: 0; margin: .4rem 0 0; }
  aside li { padding: .45rem 0; border-top: 1px solid var(--line); font-size: .88rem; line-height: 1.45; }
  aside li:first-child { border-top: 0; }
  aside .cat { display: block; font-size: .7rem; }
</style>
