---
/**
 * K Culture Wire — **무엇이 영어권 읽기를 실제로 움직이나.** (`/what-moves-english-reading`)
 *
 * 🔴 [2026-09-06] 오늘 스타뉴스 하루치에 방탄소년단 진이 «네 꼭지» 붙었다. 그중 하나가
 *   「구찌 캠페인 — 전 세계 구글 최다 검색 인물」이었다.
 * ⛔ 구글 검색량은 우리가 못 잰다. 그 주장을 옮겨 적는 것은 우리 일이 아니다.
 * ⭐ 우리가 잴 수 있는 것 하나 — 그 주에 «영어 위키백과 열람»이 움직였나. 그리고
 *   같은 그룹 동료를 나란히 놓으면 「그 사람 일인가, 그룹 전체가 같이 흐른 것인가」가 갈린다.
 *
 * ⭐⭐ 답 — 캠페인 1.01배(동료 대비 남는 것 없음) · 생일 1.35배. **생일이 캠페인을 이겼다.**
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 인과를 말하지 않는다. 같은 날 다른 일이 얼마든지 있다.
 * ⛔ 「캠페인이 소용없다」로 부풀리지 않는다 — 잰 것은 영문 위키백과 열람 하나다.
 * ⛔ 사건 두 건을 「업계가 이렇다」로 늘리지 않는다. 표본을 첫 화면에 적는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-what-moves-reading.json';

type 대조 = { person: string; ratio: number };
type 사건 = {
  key: string; person: string; kind: string; date: string; what: string; sourceNote: string;
  windowComplete: boolean; before: number | null; after: number | null; onTheDay: number | null;
  peakDay: string | null; peakViews: number | null;
  ratio: number | null; controlRatio: number | null; netRatio: number | null;
  moved: string | null; controls: 대조[]; controlsDropped: { person: string; why: string }[];
};

const 사건들 = (d.events as any[]) as 사건[];
const 캠페인 = 사건들.find((e) => e.kind === 'Brand campaign');
const 생일 = 사건들.find((e) => e.kind === 'Birthday and concert');

/* 🔴 제목·본문이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (!캠페인 || !생일) throw new Error('캠페인과 생일 두 건이 다 있어야 이 지면의 대조가 선다.');
if ((캠페인.netRatio ?? 0) >= (생일.netRatio ?? 0)) {
  throw new Error(`캠페인 ${캠페인.netRatio} 가 생일 ${생일.netRatio} 보다 크거나 같다 — 제목이 거꾸로다. 다시 쓴다.`);
}

const 쉼표 = (n: number | null) => (n === null ? '—' : Number(n).toLocaleString('en-US'));

/**
 * 「평판지수 순위 vs 실측 읽기 순위」 대조 — 사건(전/후) 표와는 다른 결이라 별도 표로 낸다.
 * 🔴 check-table-promises.mjs 가 기사 대표수(og-cards.json)가 이 지면 «표 칸»에 있는지 잰다 —
 *   본문 문장은 안 본다. 그래서 여기도 <table>로 낸다.
 */
const 평판대조 = [
  { 순위축: 'Group reputation, Sept 2026', 첫: 'Re:Scene', 첫수: '11/day', 둘: 'BTS', 둘수: '6,860/day', 셋: 'BLACKPINK', 셋수: '—',
    일치: 'No', 링크: '/article/rescene-topped-bts-and-blackpink-in-reputation-not-in-reading' },
  { 순위축: 'Boy-group member reputation, Sept 2026', 첫: 'Jimin', 첫수: '2,029/day', 둘: 'G-Dragon', 둘수: '1,592/day', 셋: 'San', 셋수: '1,371/day',
    일치: 'Yes', 링크: '/article/jimin-g-dragon-and-san-ranked-the-same-way-in-reputation-and-in-reading' },
];
const 움직임글 = (e: 사건) => {
  if (e.netRatio === null) return 'not measured';
  if (e.netRatio >= 1.05) return `up ${e.netRatio}×`;
  if (e.netRatio <= 0.95) return `down to ${e.netRatio}×`;
  return `no change (${e.netRatio}×)`;
};

const TITLE = 'A Gucci campaign moved nothing. A birthday moved 1.35x';
const DESC =
  'Korean coverage called Jin the most-searched person in the world the week Gucci unveiled its '
  + 'Primavera campaign. We cannot count Google searches, so we counted English Wikipedia reads against '
  + 'his own bandmates. The campaign left no trace; a birthday did.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  variableMeasured: ['English Wikipedia daily views before and after a dated event',
    'The same for other members of the group, as a control'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/what-moves-english-reading">
  <h1>{TITLE}</h1>

  <p class="lead">
    Korean entertainment pages report reach in superlatives. We can only report what we can count, so we
    count one thing: whether English Wikipedia reading actually moved &mdash; measured against the same
    person's own bandmates in the same week.
  </p>

  <p class="q">
    <b>Two events. That is the sample.</b> This page grows as we record more, and every figure here is a
    count of page views, not a claim about why anyone opened anything.
  </p>

  <h2>Why the bandmates are the whole method</h2>

  <p>
    Measure one person alone and any ordinary drift becomes an event. If the reading of every member of
    a group falls the same week, nothing happened to the one you were watching &mdash; the group drifted.
    So each event is measured twice: the person, and their group as a control. The number that matters is
    what is <b>left over</b>.
  </p>

  {사건들.map((e) => (
    <>
      <h2>{e.person} &mdash; {e.kind}, {e.date}</h2>
      <p>{e.what}</p>

      <div class="scroll-x">
        <table>
          <tbody>
            <tr><th scope="row">Seven days before</th><td class="num">{쉼표(e.before)} a day</td></tr>
            <tr><th scope="row">Seven days from the event</th><td class="num">{쉼표(e.after)} a day</td></tr>
            <tr><th scope="row">On the day itself</th><td class="num">{쉼표(e.onTheDay)}</td></tr>
            <tr><th scope="row">Their own change</th><td class="num">{e.ratio}×</td></tr>
            <tr><th scope="row">Bandmates, same weeks</th><td class="num">{e.controlRatio}×</td></tr>
            <tr class="net">
              <th scope="row">What is left over</th>
              <td class="num"><b>{움직임글(e)}</b></td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="note">
        Controls: {e.controls.map((c) => `${c.person} ${c.ratio}×`).join(' · ')}.
        {e.controlsDropped.length > 0 && (
          <> <b>Dropped:</b> {e.controlsDropped.map((c) => `${c.person}, because ${c.why}`).join('; ')}.
          {' '}A control with an event of their own inside the window is not a control.</>
        )}
      </p>

      <p class="src"><b>Where the date comes from:</b> {e.sourceNote}</p>
    </>
  ))}

  <h2>Put side by side</h2>

  <div class="scroll-x">
    <table>
      <caption>Same measure, same window length, same control method</caption>
      <thead><tr><th>Event</th><th>Kind</th><th>Left over</th><th>Peak day</th></tr></thead>
      <tbody>
        {사건들.map((e) => (
          <tr>
            <th scope="row">{e.person}, {e.date}</th>
            <td>{e.kind}</td>
            <td class="num"><b>{e.netRatio}×</b></td>
            <td class="num">{e.peakDay} &middot; {쉼표(e.peakViews)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Reputation index against reading, side by side</h2>
  <p class="note">
    A different test from the events above: does the <em>order</em> a reputation index ranks people
    or groups in match the order English Wikipedia reads them in?
  </p>

  <div class="scroll-x">
    <table>
      <thead><tr><th>Ranked by</th><th>1st</th><th>Reads</th><th>2nd</th><th>Reads</th><th>3rd</th><th>Reads</th><th>Order matched?</th></tr></thead>
      <tbody>
        {평판대조.map((r) => (
          <tr>
            <th scope="row">{r.순위축}</th>
            <td>{r.첫}</td>
            <td class="num">{r.첫수}</td>
            <td>{r.둘}</td>
            <td class="num">{r.둘수}</td>
            <td>{r.셋}</td>
            <td class="num">{r.셋수}</td>
            <td><a href={r.링크}>{r.일치}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    A luxury house's global campaign, reported in Korea as making him the most-searched person in the
    world, left <b>{캠페인.netRatio}&times;</b> once his bandmates are accounted for &mdash; which is to
    say, nothing. A birthday left <b>{생일.netRatio}&times;</b>, and on the day itself the reading was
    {' '}{쉼표(생일.peakViews)}, against {쉼표(생일.before)} in the week before.
  </p>

  <p class="note">
    We are not saying the campaign failed. Selling a $9,900 jacket and being read about on Wikipedia are
    different things, and only the second one is ours to count. What the comparison does show is that{' '}
    <b>a superlative in a headline and a measurable rise are not the same object</b>, and only one of
    them can be checked.
  </p>

  <h2>What we could not measure</h2>
  <ul>{d.notMeasured.map((s: string) => <li>{s}</li>)}</ul>

  <h2>Where else we test this</h2>
  <p class="walk">
    <a href="/casting-news-reading">Does K-drama casting news move English reading?</a> &middot;{' '}
    <a href="/which-language-reads-you">Which language reads a Korean star</a> &middot;{' '}
    <a href="/tour-city-languages">A tour's cities against its reading languages</a>
  </p>

  <KcwMethodLimits
    method={{
      'What this is': d.whatThisIs,
      'Why controls': d.whyControls,
      'The window': `Seven days from the event against the seven days before it, on English Wikipedia `
        + `daily human views. A change under 5% is recorded as no change rather than as a small move.`,
    }}
    limitation={{
      'What this is not': 'Not cause, not reach, and not Google. Two events is a small sample and is '
        + 'printed as two events rather than as a pattern.',
    }} />

  <p class="asof">Measured {d.measuredAt}. Window {d.windowDays} days either side.</p>

  <KcwShorts
    set="chung-ha-agency-split-reading-spike-smaller-than-unexplained-one-voiced"
    says="Seventeen seconds: a Reddit post said Chung Ha left her agency, and her Wikipedia reading rose 2.2x that day, but an unexplained day three weeks earlier was 3.8x, and we don't know why."
  />

  <KcwShorts
    set="le-sserafim-blizzcon-drove-a-real-wikipedia-spike-voiced"
    says="LE SSERAFIM closed BlizzCon on September thirteenth. The next day their English Wikipedia reading hit 2.89 times average. The same week, three other K-pop stories moved the number not at all."
  />

  <KcwShorts
    set="riizes-quietest-reading-day-in-a-month-was-their-milestone-day-voiced"
    says="SM Entertainment announced on September seventeenth that Riize's Love 119 passed 100 million Spotify streams. That same day, Riize's English Wikipedia reading was 0.73 times average — the lowest day in the 30 we measured."
  />

  <KcwShorts
    set="rescene-topped-bts-and-blackpink-in-reputation-not-in-reading-voiced"
    says="A Korean reputation index ranked Re:Scene first among K-pop groups this September, ahead of BTS and BLACKPINK. Re:Scene averaged 11 English Wikipedia views a day. BTS averaged 6,860 — 624 times as many."
  />

  <KcwShorts
    set="samedrama-voiced"
    says="A Korean drama premiered September twelfth. Seo Kang-joon's English Wikipedia reading rose 6.24 times his baseline. His co-star Ahn Eun-jin's rose 4.27 times hers. Same premiere, different rise."
  />

  <KcwCardnews set="samedrama" count={4} heading="Same premiere, different rise — card set, free to share" />

  <KcwRelatedArticles page="/what-moves-english-reading" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.net th, tr.net td { background: #f3f0fa; border-top: 2px solid #d7cfe9; }
  .note { font-size: .95rem; color: #555; }
  .src { font-size: .9rem; color: #666; border-left: 3px solid #ddd; padding-left: .8rem; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    tr.net th, tr.net td { background: #241f31; border-top-color: #453a63; }
    .note { color: #aaa; }
    .src { color: #999; border-left-color: #333; }
    .asof { color: #999; }
  }
</style>
