---
/**
 * K Culture Wire — **나라마다 «자기 스타»가 따로 있다.** (`/own-star`)
 *
 * ⭐⭐ 사장님 지시(8/16) — 제목과 본문에 스타 이름과 소속 그룹명.
 *    손님은 「JAY B」와 「GOT7」을 친다.
 * ⭐ 2번 지시(8/21 19시) — **지면과 기사를 같은 커밋으로.** 나눠 내면 그 사이에 구멍이 난다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **「그 나라가 더 좋아한다」로 안 쓴다.** 잰 것은 읽힘의 쏠림이다.
 * ⛔ **고른 값 25% 를 화면에 같이 둔다.** 그게 없으면 86% 가 얼마나 큰지 모른다.
 * ⛔ **네 판 다 있는 사람만.** 없는 문서를 0 으로 메우면 「관심 없다」가 된다.
 * ⛔ **말레이시아가 여덟 명뿐**인 것을 감추지 않는다 — 그 자체가 이 표의 결과다.
 * ⛔ 광고 자리를 만들지 않는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다 — 붙여 쓸 곳에 {' '} 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-own-star.json';

/** ⚠ 소속은 위키데이터 P463 에서 받아 적은 것이다. 기억으로 쓰지 않는다 */
const 소속: Record<string, string> = {
  'Gong Myung': '5urprise',
  'Kim Min-gyu': 'Seventeen',
  'Park Ji-yeon': 'T-ara',
  'JAY B': 'GOT7',
  Jinyoung: 'GOT7',
  Kai: 'EXO',
  'Ahn So-hee': 'Wonder Girls',
  'Cho Kyuhyun': 'Super Junior',
  'Kim Jong-kook': 'Turbo',
  'Goo Hara': 'Kara',
};
const 이름표 = (n: string) => (소속[n] ? `${n} of ${소속[n]}` : n);

const 태국 = d.topByCountry.th[0];
const 베트남 = d.topByCountry.vi[0];
const 말레이 = d.topByCountry.ms[0];
const 고른 = d.mostEven[0];

const TITLE = 'JAY B of GOT7 is a Thai star, Tempest is a Vietnamese one, '
  + 'and Kim Jong-kook belongs to nobody';
const DESC =
  `Of ${d.measured} Korean stars with an article on all four Southeast Asian Wikipedias, `
  + `${태국.topSharePc}% of the reading about ${태국.name} sits in Thailand alone. An evenly read `
  + `star would score ${d.evenValue}%. Kim Jong-kook of Turbo scores ${고른.topSharePc}%.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/own-star">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    They do not read the same ones. Of the {d.measured} Korean stars we can compare,
    {' '}<b>{태국.topSharePc}%</b> of all the reading about <b>{이름표(태국.name)}</b> happens on the
    Thai Wikipedia alone. <b>{베트남.name}</b> is at {베트남.topSharePc}% in Vietnam,
    {' '}<b>{이름표(말레이.name)}</b> at {말레이.topSharePc}% in Malaysia. A star read evenly by all
    four countries would score <b>{d.evenValue}%</b>.
  </p>

  <section>
    <h2>Each country's most concentrated names</h2>
    <p class="note">
      The share is of that star's four-country total, not of the country. Reading a row: almost all
      the people who looked up this person did it on one edition.
    </p>
    <div class="cols">
      {d.editions.map((e) => (
        <div class="col">
          <h3>{d.countryNames[e]} — {d.countsByCountry[e]} stars</h3>
          <table>
            <thead><tr><th>Star</th><th>Share in {d.countryNames[e]}</th></tr></thead>
            <tbody>
              {d.topByCountry[e].map((r) => (
                <tr>
                  <td class="nm">{이름표(r.name)}</td>
                  <td class="tot">{r.topSharePc}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
    <p class="warn">
      <strong>Malaysia has only {d.countsByCountry.ms} stars in this table, and Thailand has
      {' '}{d.countsByCountry.th}.</strong> That is not a gap in our data — every star here was
      measured on all four editions. It says that a star whose reading concentrates anywhere tends
      to concentrate in Thailand or Vietnam rather than in Malaysia.
    </p>
  </section>

  <section>
    <h2>The stars who belong to nobody</h2>
    <p>
      At the other end are the names read almost evenly across all four countries. {d.evenValue} per
      cent is the floor — you cannot be more even than that.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Star</th><th>Largest share</th><th>Where</th>
            {d.editions.map((e) => <th>{d.countryNames[e]}</th>)}</tr>
        </thead>
        <tbody>
          {d.mostEven.map((r) => (
            <tr>
              <td class="nm">{이름표(r.name)}</td>
              <td class="tot">{r.topSharePc}%</td>
              <td class="fine">{r.topCountry}</td>
              {d.editions.map((e) => <td class="fine">{r.perMillion[e]}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      {이름표(고른.name)} is {고른.topSharePc}% — within {(고른.topSharePc - d.evenValue).toFixed(1)}
      {' '}points of a perfectly even reader.
    </p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    <p class="warn">
      <strong>A high share is not a preference.</strong> We measured where the reading sits, not
      where the liking sits. The four editions serve different numbers of readers with different
      habits, and scaling by edition size only removes the first of those.
    </p>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">{d.whyAllFour}</p>
    <p class="note">{d.floorIsOurs}</p>
    <p class="note">{d.aliasNote}</p>
  </section>

  <section class="src">
    <h2>How this was counted</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Window</b> — {d.window}</li>
      <li><b>Method</b> — {d.method}</li>
      <li><b>Panel</b> — {d.measured} of {d.fromPanel} people in the panel clear both rules
        (an article on all four editions, and a four-edition total of at least {d.floor}).</li>
      <li><b>Limits</b> — {d.limitation}</li>
    </ul>
    <p class="note">
      Group memberships shown beside the names are read from Wikidata's member-of property, not
      written from memory.
    </p>
  </section>

  <KcwRelatedArticles page="/own-star" />
</WikiTip>
