---
/**
 * K Culture Wire — **KPop Demon Hunters 가 나라별로 몇 주 top 10 에 있었나.**
 * (`/demon-hunters-countries`)
 *
 * 🔴 [2026-09-05] 오늘 기사(what-dreamworks-is-chasing-93-countries)를 내면서
 *   그 자료를 담은 지면을 안 만들었다. 표 약속 검사가 잡았다 —
 *   기사가 「93개국」이라 하는데 걸어 둔 /watched·/by-country 어디에도 93 이 없다.
 *   ⛔ 손님이 확인할 자리가 없는 수는 «우리 말»일 뿐이다.
 *   ⚠ 오늘 같은 잘못을 두 번 했다(/name-spelled 도 같은 까닭으로 만들었다).
 *     ⇒ **자료로 기사를 쓰면 그 자료의 지면을 같이 낸다.** 다음부터 순서를 그렇게 둔다.
 *
 * ── 이 지면이 안 하는 것 ─────────────────────────────────
 * ⛔ 시청 시간·시청자 수를 말하지 않는다. top 10 «자리»를 셌을 뿐이다.
 * ⛔ Forgotten Island 를 재지 않는다 — 개봉 전이고 본 적이 없다.
 * ⛔ 자료는 2026-08-23 에서 끝난다. 그 뒤는 «못 쟀다».
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/kcw-demon-hunters-year.json';

const 나라표 = (d.나라표 as any[]) ?? [];
const 셈 = (d.셈 as any) ?? {};

/* 🔴 제목·표에 박은 수가 자료와 어긋나면 빌드를 세운다 */
if (나라표.length !== 93) {
  throw new Error(`이 지면이 「93개국」이라고 말하는데 자료는 ${나라표.length} 개다.`);
}
const 일위나라 = 나라표.filter((x) => x.최고순위 === 1).length;
const 오래순 = [...나라표].sort((a, b) => b.주수 - a.주수);
const 틈없는 = 나라표.filter((x) => x.틈 === 0).length;
const 가운데 = (a: number[]) => {
  const b = [...a].sort((x, y) => x - y);
  const m = b.length >> 1;
  return b.length % 2 ? b[m] : (b[m - 1] + b[m]) / 2;
};
const 주중간 = 가운데(나라표.map((x) => x.주수));
const 한국 = 나라표.find((x) => x.iso2 === 'KR');
const 미국 = 나라표.find((x) => x.iso2 === 'US');

const TITLE = 'KPop Demon Hunters: 93 countries, and Latvia held it 62 weeks';
const DESC =
  `KPop Demon Hunters appeared in ${나라표.length} countries' Netflix top 10 and reached number one `
  + `in ${일위나라} of them. Latvia held it longest at ${오래순[0]?.주수} weeks; Korea sat at `
  + `${한국?.주수}, exactly the median. In ${나라표.length - 틈없는} countries the run had a gap.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10'],
  variableMeasured: ['weeks in a country top 10', 'longest unbroken run', 'peak rank'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/demon-hunters-countries">
  <h1>{TITLE}</h1>

  <p class="lead">
    Counted from Netflix's weekly country tables, one row per country per week. Korea sat exactly
    at the median of the {나라표.length}.
  </p>

  <p class="walk">
    <b>Next:</b>{' '}
    <a href="/by-country">Which countries watch Korean titles</a> &middot;{' '}
    <a href="/watched">What was actually watched</a> &middot;{' '}
    <a href="/staying-power">Staying power against force</a>
  </p>

  <table>
    <caption>The run, in one table</caption>
    <thead><tr><th>Measure</th><th>Count</th></tr></thead>
    <tbody>
      <tr><td>Countries it charted in</td><td>{나라표.length}</td></tr>
      <tr><td>Countries where it reached number one</td><td>{일위나라}</td></tr>
      <tr><td>Distinct weeks on some chart</td><td>{셈.서로다른주}</td></tr>
      <tr><td>Longest in one country — {오래순[0]?.국가}</td><td>{오래순[0]?.주수}</td></tr>
      <tr><td>United States</td><td>{미국?.주수}</td></tr>
      <tr><td>Korea</td><td>{한국?.주수}</td></tr>
      <tr><td>Median country</td><td>{주중간}</td></tr>
      <tr><td>Countries whose run had a gap</td><td>{나라표.length - 틈없는}</td></tr>
      <tr><td>Countries that held it unbroken</td><td>{틈없는}</td></tr>
    </tbody>
  </table>

  <h2>It did not sit there. It kept coming back</h2>

  <p>
    Weeks on chart and longest unbroken run are counted separately, which is how the gaps became
    visible. <b>{나라표.length - 틈없는} of {나라표.length} countries have a gap</b> — the title fell
    out of the top 10 and returned. A single &ldquo;weeks on chart&rdquo; figure would have hidden
    that.
  </p>

  <h2>The twenty longest runs</h2>

  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Country</th><th>Weeks</th><th>Longest unbroken</th><th>Gaps</th><th>Peak rank</th></tr>
      </thead>
      <tbody>
        {오래순.slice(0, 20).map((x) => (
          <tr>
            <th scope="row">{x.국가}</th>
            <td>{x.주수}</td>
            <td>{x.가장긴이어진}</td>
            <td>{x.틈}</td>
            <td>{x.최고순위}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="q">
    <b>This is a presence count, not an audience count.</b> A small country's top 10 is easier to
    stay in than a large one's, so a longer run does not mean more people watched. Netflix publishes
    no per-country viewing hours at all.
  </p>

  {/* 🔴 [2026-09-05] 자료의 «우리말 칸»이 영문 지면에 새어 나갔다. 여기서 영문으로 쓴다. */}
  <KcwMethodLimits
    method={{
      'What this is': 'How many weeks KPop Demon Hunters sat in each country top 10, counted from the raw weekly country tables, and whether those weeks ran unbroken.',
      Source: 'Netflix weekly Top 10 country tables',
      Window: '4 July 2021 to 23 August 2026',
    }}
    limitation={{
      'What this is not': 'Not an audience count. A place in a top 10 is presence, not hours watched, and Netflix publishes no per-country viewing hours.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    <li>Anything after 23 August 2026, the last week in our tables. The run may have continued and we did not measure it.</li>
    <li>Hours watched, or how many people saw it. Netflix publishes no per-country viewing hours.</li>
    <li>Russia, which is excluded from the country tables at source. 93 is the number of countries Netflix published.</li>
  </ul>
  <KcwRelatedArticles page="/demon-hunters-countries" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
  }
</style>
