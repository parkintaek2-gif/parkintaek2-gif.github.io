---
/**
 * K Culture Wire — **파도가 지나간 자리.** (`/wave-and-floor`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   한국 작품이 뜨면 동남아 백과사전이 그 문서로 찬다. 그 파도가 지나간 뒤 바닥은 높은가.
 *   ⭐⭐ 그런데 **신작에는 그 물음을 못 던진다.** 문서가 작품과 함께 생기기 때문이다.
 *     오징어게임 문서는 2021-09 에 생겼고 봉우리가 2021-10 이다. 「전」이 없다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **평균을 앞세우지 않는다.** 여섯 편에서 하나가 튀면 평균이 끌린다. 중앙값을 먼저 놓는다.
 * ⛔ **못 잰 스물아홉 편을 감추지 않는다.** 까닭까지 표로 낸다.
 *    ⭐ 그중 열두 편은 「자료가 얇아서」가 아니라 **문서가 그때 없어서**다. 다른 말이다.
 * ⛔ **가장 큰 파도(Physical: 100, 15.2배)를 크게 쓰지 않는다.** 앞바닥이 1.3 이다 —
 *    거의 0 에서 거의 0 으로 간 것이다.
 * 🔴 **48 달로 한 번 틀렸다.** 창이 짧으면 창 안의 최고가 봉우리인 척한다. 그 표를 지면에 싣는다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 * 🔴 앞말에서 `export function` 을 쓰지 않는다 — Astro 가 딴 스코프로 옮긴다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import d from '../../data/wikitip-wave-floor.json';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';

const 답 = d.answer;
const 몫 = (v: number) => `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}%`;

/* 못 잰 까닭을 묶어 센다 — 스물아홉 줄을 늘어놓으면 안 읽힌다 */
const 까닭별 = [...new Set(d.titlesNotMeasured.map((t) => t.why))]
  .map((why) => ({ why, titles: d.titlesNotMeasured.filter((t) => t.why === why) }))
  .sort((a, b) => b.titles.length - a.titles.length);

/* ⭐ 「문서가 그때 없었다」로 빠진 것 — 이 지면의 핵심이다 */
const 태어난것 = d.titlesNotMeasured.filter((t) => /did not exist/.test(t.why));

const TITLE = 'You cannot ask what a Korean hit leaves behind. The article is born with the show';
const DESC =
  `Of 35 Korean titles across four Southeast Asian Wikipedias, ${답.measured} could be measured `
  + `before and after their peak: median peak ${답.peakOverFloorMedian}× the surrounding months, `
  + `median floor afterwards ${몫(답.floorChangeMedianPc)}. ${태어난것.length} were disqualified `
  + 'because their article did not exist before the title arrived.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: d.window,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/wave-and-floor">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    For most of what Korea has exported in the last five years, that question has no answer — and
    not because the data is thin. There is no <em>before</em>. The encyclopaedia article is created
    when the title arrives. {태어난것.length} of the 35 titles we fetched are disqualified for that
    reason alone.
  </p>

  {태어난것.length > 0 && (
    <section>
      <h2>The article is born with the show</h2>
      <p>
        A percentage change from nothing is not a small number; it is not a number. These titles
        have no floor from before the wave because they had no article before the wave.
      </p>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Title</th><th>Article first seen</th><th>Peak</th></tr></thead>
          <tbody>
            {태어난것.map((t) => (
              <tr>
                <td class="nm">{t.title}</td>
                <td>{t.articleFirstSeen ?? '—'}</td>
                <td class="fine">{t.peakMonth ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        This is a limit of the question, not of the window. Widening the window does not create a
        floor that never existed. Anything that arrives and creates its own article is unmeasurable
        here permanently.
      </p>
    </section>
  )}

  <section>
    <h2>The {답.measured} titles that already had a floor</h2>
    <p class="note">
      Reads are per million reads of that Wikipedia, summed across
      {' '}{d.editions.map((e) => d.editionNames[e]).join(', ')}. The floor is the
      {' '}{d.method.floorMonths} months before the peak and the {d.method.floorMonths} after,
      skipping {d.method.waveMonths} months either side because those are still the wave.
      Window — {d.window}.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Title</th><th>Peak</th><th>Peak ÷ floor</th><th>Floor before</th>
            <th>Floor after</th><th>Change</th></tr>
        </thead>
        <tbody>
          {d.titlesMeasured.map((t) => (
            <tr>
              <td class="nm">{t.title}</td>
              <td class="fine">{t.peakMonth}</td>
              <td>{t.peakOverFloor}×</td>
              <td>{t.beforeFloor}</td>
              <td>{t.afterFloor}</td>
              <td>{몫(t.floorChangePc)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Median peak {답.peakOverFloorMedian} times the surrounding months; median floor afterwards
      {' '}{몫(답.floorChangeMedianPc)}. {답.floorsThatRose} of {답.measured} ended higher. We
      report the median rather than the mean because with {답.measured} titles one of them moves
      the mean on its own — the mean reads {몫(답.floorChangeMeanPc)}.
    </p>
    <p>
      These are not hits arriving. They are back catalogue rising again, which is the only kind of
      title that can answer this question at all.
    </p>
    {답.stability && !답.stability.verdict.steady && (
      <p class="note">
        ⚠ <strong>Do not lean on that median.</strong> Remove any single title from the
        {' '}{답.measured} above and it moves to somewhere between
        {' '}{몫(답.stability.lowestWithoutOne)} and {몫(답.stability.highestWithoutOne)} — a swing
        of {답.stability.swingOverMedian} times its own size. {답.stability.verdict.note}. We ran
        this check on this page after correcting it twice in one day; the
        {' '}<a href="/one-out">method is here</a>.
      </p>
    )}
  </section>

  <section>
    <h2>Everything we could not use</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Why not</th><th>Titles</th><th>How many</th></tr></thead>
        <tbody>
          {까닭별.map((g) => (
            <tr>
              <td class="nm">{g.why}</td>
              <td class="fine">{g.titles.map((t) => t.title).join(', ')}</td>
              <td>{g.titles.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {답.biggestWave && !답.biggestWave.reportable && (
      <p>
        The largest peak-to-floor ratio in the whole dataset belongs to
        {' '}<strong>{답.biggestWave.title}</strong> at {답.biggestWave.peakOverFloor}× in
        {' '}{답.biggestWave.peakMonth}, and we cannot report it. Its floor before the wave was
        {' '}{d.titlesNotMeasured.find((t) => t.title === 답.biggestWave.title)?.why?.match(/only ([\d.]+) per million/)?.[1] ?? 'below our threshold'}
        {' '}per million — a rise between two quantities that are both, in practice, nobody.
      </p>
    )}
  </section>

  {d.peakClustering && (
    <section>
      <h2>Each title rose in its own month</h2>
      <p>{d.peakClustering.note}</p>
      <p class="note">
        The peaks — {d.peakClustering.clusterMonths.map((c) => c.join(' and ')).join(' · ')}. An
        earlier version of this page, built on a shorter window, had
        {' '}{답.measured} peaks landing in three clusters of neighbouring months, which meant we
        might have been measuring those months rather than those titles. That objection is
        answered.
      </p>
    </section>
  )}

  <section>
    <h2>What this page cannot tell you</h2>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    {d.droppedLastMonth && (
      <p class="note">
        ⚠ {d.droppedLastMonth.month} is excluded. It arrived at {d.droppedLastMonth.value} against
        a mean of {d.droppedLastMonth.previousTwelveMean} over the twelve months before it —
        Wikimedia's monthly totals were still filling when we fetched, and reading that month as a
        collapse in attention would have been wrong.
      </p>
    )}
    <p class="note">Reads — Wikimedia Pageviews API, human traffic only, monthly.</p>
  </section>

  <KcwCardnews set="wave" count={5} />

  <KcwShorts set="wave"
    says={`A man and a woman read out how many titles could be measured on both sides of their `
      + `peak, and why most of them could not be.`} />

  <KcwRelatedArticles page="/wave-and-floor" />
  <KcwMethodLimits method={d.method} limitation={d.limitation} />
</WikiTip>
