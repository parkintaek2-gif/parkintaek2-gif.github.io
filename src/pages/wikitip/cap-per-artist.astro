---
/**
 * K Culture Wire — **시가총액을 사람 수로 나누면 무엇이 보이나 … 그리고 무엇이 안 보이나.**
 * (`/cap-per-artist`)
 *
 * ── 이 지면이 왜 있나 ────────────────────────────────────────
 * 두 데스크가 각각 잰 것을 «티커로» 이었다 —
 *   금융 데스크(6번)  KRX 시세로 시가총액       market-cap-20260903.json
 *   이쪽(5번)        위키데이터로 소속 아티스트  kcw-label-reach.json
 * 사장님 정의 그대로다 — **「그들은 재무를, 우리는 사람을 한다」**
 *
 * ── 🔴 이 지면에서 가장 조심하는 것 ─────────────────────────
 * ⛔ **「고평가·저평가」로 읽히면 이 지면은 실패다.** 우리는 투자자문을 하지 않는다.
 *   「한 명당 얼마」는 나눗셈이지 판단이 아니다.
 * ⛔ **분모가 바닥값이다.** 위키데이터에 음반사가 적힌 사람만 셌다 — 우리가 쥔 9,249명 중
 *   1,044명(11.3%)뿐이다. 분모가 바닥이면 **몫은 천장**이다.
 *   ⭐ 그리고 회사마다 그 바닥이 «다르게 얕다». 그래서 회사끼리 견주는 데 못 쓴다.
 *     HYBE 807억원 대 FNC 6.9억원이 117배인데, 그 안에 「우리가 얼마나 아는가」의 차이가 섞여 있다.
 * ⛔ **한 명당 값 순으로 줄 세우지 않는다.** 시가총액 순으로 놓는다 — 놓는 순서가 곧 주장이다.
 * ⛔ 못 이은 회사를 지우지 않는다. 「티커를 못 찾았다」·「비상장」을 그대로 적는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다 — 붙여야 할 곳에 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/kcw-cap-per-artist.json';

const 수 = (n: number) => Number(n).toLocaleString('en-US');
const 회사들 = d.회사들 ?? [];
const 한명당들 = 회사들.map((x: any) => x.아는사람한명당억).filter((v: any) => Number.isFinite(v));
const 가장큰 = Math.max(...한명당들);
const 가장작은 = Math.min(...한명당들);
const 몇배 = Math.round((가장큰 / 가장작은) * 10) / 10;
const 사람바닥 = d.읽힘출처?.사람바닥 ?? null;
const 명단전체 = d.읽힘출처?.명단전체 ?? null;
const 바닥몫 = 사람바닥 && 명단전체 ? Math.round((사람바닥 / 명단전체) * 1000) / 10 : null;

/**
 * 🔴 [2026-09-04 22:2x] **렌더해서 읽고 셋을 잡았다.** 셋 다 「자료를 그대로 내보낸」 탓이다.
 *  1. 기준일이 손님 화면에 «20260903» 으로 찍혔다 — 이것은 우리 파일 이름 꼴이지 날짜가 아니다
 *  2. 출처가 «…, archive/raw/krx» 로 찍혔다 — **우리 저장소 안 경로**다. 손님이 알 바 아니고,
 *     내부 구조를 밖으로 내는 것이다
 *  3. 억원 칸이 75,868 과 17,239.7 로 뒤섞였다 — 자리수가 줄마다 달라 견줄 수가 없다
 * ⛔ 셋 다 자료에는 잘못이 없다. **그릇이 자료를 그대로 부어 놓은 것**이 잘못이다.
 */
const 읽는날 = (yyyymmdd: string | null | undefined) => {
  const s = String(yyyymmdd ?? '');
  const m = s.match(/^(\d{4})(\d{2})(\d{2})$/);
  if (!m) return s || null;                     // 꼴이 다르면 손대지 않는다 — 지어내지 않는다
  return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]))
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
const 기준일글 = 읽는날(d.시총출처?.기준일);
/* 「, archive/…」 뒤는 우리 안쪽 경로다 — 손님에게는 우물 이름까지만 낸다 */
const 시총출처글 = String(d.시총출처?.출처 ?? 'Korea Exchange').split(/,\s*archive\//)[0];
const 억 = (n: number) => Number(n).toLocaleString('en-US', {
  minimumFractionDigits: 1, maximumFractionDigits: 1,
});

/**
 * 🔴 [2026-09-04 23:1x] **제목을 고쳤다 — 어제 우리가 정한 자에 내 것을 안 대 봤다.**
 *   어제(9/3) 네 유닛이 이어 쓴 결론은 「제목에 «사람이 실제로 검색하는 실명» + «아무도
 *   답하지 않는 물음»」이다(docs/보고/검색노출-병목-2026-09-03.md 9-4절).
 *   그런데 오늘 낸 새 지면 여섯 장에 실명이 «하나도» 없었고, 그 중 넷이 내 것이었다.
 *   ⛔ 규칙을 몰라서가 아니다. 표를 만들면 제목이 자연히 총론이 되고, 그때 자를 안 댔다.
 *   ⚠ 그런데 여기에 함정이 하나 더 있다 — 회사 이름을 앞에 놓고 「per artist」를 붙이면
 *     **평가 기사처럼 읽힌다.** 그래서 「we can count」를 제목에 «남겼다» —
 *     세는 것이 우리가 아는 만큼이라는 말이 제목에서 빠지면 이 지면은 성격이 바뀐다.
 *   ⭐ 30분 전에 낸 지면이라 노출이 0 이다. 지금 고치는 것이 가장 값싸다.
 */
/**
 * ⛔ 제목·설명에 «박은 이름»은 자료에서 계산하지 않는다 — 제목은 색인에 남으므로
 *   자료가 흔들릴 때마다 바뀌면 안 된다. 오늘 수를 지면에 박아 두 번 물렸는데,
 *   그때의 답은 「자료에서 뽑아라」였지만 **제목은 반대다.**
 * ✅ 그래서 박되, **박은 이름이 자료에 실제로 있는지 빌드가 검사한다.**
 *   회사가 빠지거나 이름이 바뀌면 빌드가 죽는다 — 조용히 틀린 제목이 남는 것보다 낫다.
 */
const 제목에박은이름 = ['Hybe', 'SM', 'JYP', 'YG', 'Cube', 'FNC'];
const 자료의이름 = 회사들.map((x: any) => String(x.회사));
const 못찾은이름 = 제목에박은이름.filter((n) => !자료의이름.some((m) => m.includes(n)));
if (못찾은이름.length) {
  throw new Error(
    [
      '🔴 /cap-per-artist — 제목·설명에 박은 이름이 자료에 없다: ' + 못찾은이름.join(', '),
      '   자료에 있는 회사: ' + 자료의이름.join(', '),
      '   ⛔ 제목을 고치거나 자료를 고치십시오. 틀린 제목이 색인에 남는 것이 가장 나쁩니다.',
    ].join('\n'),
  );
}

const TITLE = 'HYBE, SM, JYP and YG: market value per artist we can count';
const DESC = `HYBE, SM, JYP, YG, Cube and FNC: market value divided by the artists we can `
  + `count. The divisor is a floor, so every figure is a ceiling. Not a valuation.`;

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org', 'https://data.krx.co.kr'],
}];
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/cap-per-artist">
  <h1>{TITLE}</h1>

  <p class="lead">
    Our markets desk measured the market value of every listed K-pop company from Korea Exchange
    prices on {기준일글 ?? 'the reference date'}. We measured how many of each
    company&rsquo;s artists we can actually count. Divide one by the other and you get a figure
    nobody publishes — <strong>market value per artist we can count</strong>.
  </p>

  <div class="warn">
    <p>
      <strong>This is not a valuation, and it is not advice.</strong> Dividing one number by
      another does not say a company is expensive or cheap. It says what the arithmetic gives.
    </p>
    <p>
      <strong>And the divisor is a floor.</strong> We count an artist only when Wikidata records a
      record label for them — {수(사람바닥)} of the {수(명단전체)} people we hold, or{' '}
      <strong>{바닥몫}%</strong>. A floor in the divisor makes every figure here a{' '}
      <strong>ceiling</strong>. The real per-artist value is lower for every company, by an amount
      we cannot measure.
    </p>
    <p>
      <strong>That is why the table is not sorted by it.</strong> The spread from{' '}
      {억(가장작은)} to {억(가장큰)} is <strong>{몇배}x</strong> — and part of that {몇배}x is
      simply that we know some companies&rsquo; rosters better than others. Read each row on its
      own, not against the row above it.
    </p>
  </div>

  <h2>Every company we could join</h2>
  <p class="note">
    Ordered by market value, largest first — <strong>not by the per-artist figure</strong>.
    All {회사들.length} were matched by ticker, not by name: company names vary
    (&ldquo;HYBE&rdquo; against &ldquo;Hybe&rdquo;) and a ticker does not.
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Company</th><th>Ticker</th><th>Market value (100M KRW)</th>
          <th>Artists we can count</th><th>Per artist (100M KRW)</th>
          <th>Of those, with a reader count</th>
        </tr>
      </thead>
      <tbody>
        {회사들.map((x: any) => (
          <tr>
            <th scope="row">{x.회사}</th>
            <td>{x.티커}</td>
            <td>{억(x.시가총액억)}</td>
            <td>{수(x.아는사람)}</td>
            <td>{억(x.아는사람한명당억)}</td>
            <td>{수(x.이어진사람)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {(d.못이은회사들 ?? []).length > 0 && (
    <section>
      <h2>Companies we could not join</h2>
      <p class="note">
        These appear in our artist data but not in the market data. We leave them in rather than
        drop them — a missing row is a fact about our reach, not about the company.
      </p>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Company</th><th>Ticker on Wikidata</th><th>Artists we can count</th></tr></thead>
          <tbody>
            {(d.못이은회사들 ?? []).map((x: any) => (
              <tr>
                <th scope="row">{x.회사}</th>
                <td>{x.티커 ?? '—'}</td>
                <td>{수(x.아는사람)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note fine">
        {/* ⛔ 6번이 독립 소스로 이중확인한 것을 그대로 옮긴다. 내 표가 틀렸던 자리다 */}
        One of them carries a ticker on Wikidata that no longer trades. Our markets desk checked the
        exchange&rsquo;s own daily price list and the corporate filing system, and found the code in
        neither. <strong>A ticker recorded on Wikidata is not proof that a company is listed</strong> —
        Wikidata keeps codes that used to trade, and we had passed that code along as if it were live
        before the second check caught it.
      </p>
    </section>
  )}

  <h2>What this does not say</h2>
  <ul class="fine">
    <li>
      <b>It is not advice and not a valuation.</b> No part of this page says what a share is worth
      or what anyone should do.
    </li>
    <li>
      <b>Every per-artist figure is a ceiling.</b> The divisor counts only artists with a label
      recorded on Wikidata, so the true figure is lower everywhere — by different amounts.
    </li>
    <li>
      <b>The companies are not comparable on this measure.</b> A company whose roster we know well
      will look cheaper per artist than one we know poorly, with no difference in the business.
    </li>
    <li>
      <b>A record label is not a management contract.</b> Wikidata records the label that released
      the music, which in Korea usually but not always matches the agency.
    </li>
    <li>
      <b>Market value moves daily.</b> These prices are one day&rsquo;s close
      ({기준일글 ?? '—'}), measured by us, not a running figure.
    </li>
  </ul>
  <p class="fine">
    Market data: {시총출처글} · artist data: Wikidata (CC0).
    {' '}<a href="/label-reach">How the artist counts were built &rarr;</a>
  </p>

  <KcwRelatedArticles page="/cap-per-artist" />
</WikiTip>
