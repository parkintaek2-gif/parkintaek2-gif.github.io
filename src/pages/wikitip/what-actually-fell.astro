---
/**
 * K Culture Wire — **무엇이 떨어진 것인가.** (`/what-actually-fell`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   90편을 내고 나서 같은 자료를 열두 달 대 열두 달로 다시 쟀더니
 *   한국 여행 문서 조회가 **30% 떨어져 있었다.**
 *   🔴 그 한 줄로 기사를 쓸 뻔했다 — 「한국에 대한 관심이 식었다」.
 *     ⛔ **그것이 거짓이었을 것이다.**
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **한국 대 일본·대만에 기대지 않는다.** 우리 검사가 문화 축에서
 *    「그 격차는 시작 높이 탓」이라고 냈다. 그러면 그 견줌은 못 쓴다.
 *    ⭐ 대신 **같은 나라 안에서 여행 축과 문화 축**을 견준다.
 * ⛔ **「백과사전이 줄어서」로 안 읽히게 한다.** 백만분율이라 그건 이미 나눠졌다.
 * ⛔ **항공의 「아시아」는 동남아가 아니다.** 인도·중앙아시아가 같은 칸이다.
 * ⛔ **상관을 내지 않는다.** 두 줄이 같이 움직였다고 하나가 다른 하나를 만든 것이 아니다.
 * ⭐ **자를 바꾸면 답이 바뀐다**는 표를 지면에 그대로 싣는다. 우리가 한 달로 쟀다면
 *    대양주는 -25% 였고 열두 달로는 +2% 다. 그 칸이 이 지면에서 제일 정직한 칸이다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 * 🔴 앞말에서 `export function` 을 쓰지 않는다 — Astro 가 딴 스코프로 옮겨 맡은일이 안 보인다.
 *    작품 지면 530장이 그걸로 죽었다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import d from '../../data/wikitip-what-fell.json';

const 여행 = d.axes.trip;
const 문화 = d.axes.culture;
const 안 = d.axisAgainstAxis;
const 몫 = (v: number) => `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}%`;

/* 종류별로 한 줄씩 — 판을 가로로 펴지 않는다. 칸이 여든셋이라 표가 안 읽힌다 */
const 종류별 = [...new Set(d.cells.map((c) => c.kind))].map((k) => {
  const 칸 = d.cells.filter((c) => c.kind === k);
  const 평 = (f: (c: typeof 칸[number]) => number) => 칸.reduce((a, c) => a + f(c), 0) / 칸.length;
  return { kind: k, axis: 칸[0].axis, korea: 평((c) => c.koreaChange), control: 평((c) => c.controlChange), n: 칸.length };
});

const TITLE = "Southeast Asia's Korean travel pages fell by a third. Its Korean culture pages did not.";
const DESC =
  `In four Southeast Asian Wikipedias, reads of Korean travel articles fell `
  + `${Math.abs(여행.korea).toFixed(0)}% in a year while Korean culture articles fell `
  + `${Math.abs(문화.korea).toFixed(0)}% — and air passengers on Asian routes moved `
  + `${Math.abs(d.flights.asia.change).toFixed(1)}%.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${d.window.before}/${d.window.after}`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/', 'https://kosis.kr'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/what-actually-fell">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  {d.answer.map((s) => <p class="q">{s}</p>)}

  <section>
    <h2>Four numbers, one window</h2>
    <p class="note">
      Reads are per million reads of that Wikipedia, so an encyclopaedia that is shrinking overall
      has already been divided out. {d.window.before} against {d.window.after} — twelve months
      each side, so no month is compared against a different season.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Articles about</th><th>Korea</th><th>Japan and Taiwan</th><th>Pairings</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="nm">Travelling there</td>
            <td>{몫(여행.korea)}</td><td>{몫(여행.control)}</td><td class="fine">{여행.cells}</td>
          </tr>
          <tr>
            <td class="nm">The place and its culture</td>
            <td>{몫(문화.korea)}</td><td>{몫(문화.control)}</td><td class="fine">{문화.cells}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Read down the columns and the story is the same on both sides: travel articles fell, culture
      articles did not. Read across the rows and it looks like a Korean story. It is not — the next
      section is our own check refusing to let us say so.
    </p>
  </section>

  <section>
    <h2>The comparison we had to throw away</h2>
    <p>
      Korea fell further than Japan and Taiwan in both rows. But Korea's articles also started
      higher, and an article that starts higher has further to fall. So we matched the pairs — only
      those where the two sides began within a factor of two of each other — and measured again.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Articles about</th><th>Gap, all pairings</th><th>Gap, matched for height</th>
            <th>Matched pairings</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="nm">Travelling there</td>
            <td>{몫(d.heightCheck.trip.rawGap)}</td>
            <td>{몫(d.heightCheck.trip.matchedGap)}</td>
            <td class="fine">{여행.matchedKoreaFellMore} of {여행.matchedCells} still fell further</td>
          </tr>
          <tr>
            <td class="nm">The place and its culture</td>
            <td>{몫(d.heightCheck.culture.rawGap)}</td>
            <td>{몫(d.heightCheck.culture.matchedGap)}</td>
            <td class="fine">{문화.matchedKoreaFellMore} of {문화.matchedCells} still fell further</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Both gaps shrink and the counts land near even. A gap that survives only until the two sides
      start from the same place was the starting place. So we do not report that Korea fell further
      than Japan, and nothing below rests on it.
    </p>
  </section>

  <section>
    <h2>What is left standing is inside Korea's own pages</h2>
    <p>
      Both rows here are Korean articles, in the same four editions, over the same months — no
      other country involved, so no starting-height problem between them. Except there is one, and
      it points the wrong way for the easy explanation.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Korean articles about</th><th>Where they started</th><th>Change</th>
            <th>Article–edition pairs</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="nm">Travelling there</td>
            <td>{안.trip.startLevel} per million</td>
            <td>{몫(안.trip.change)}</td><td class="fine">{안.trip.articleEditionPairs}</td>
          </tr>
          <tr>
            <td class="nm">The place and its culture</td>
            <td>{안.culture.startLevel} per million</td>
            <td>{몫(안.culture.change)}</td><td class="fine">{안.culture.articleEditionPairs}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      The culture pages sit about {안.verdict.startLevelRatio} times higher and fell about
      {' '}{Math.abs(안.verdict.gap).toFixed(0)} points less. Height makes a steeper fall easier, not
      harder. Whatever separates these two rows, it is not where they began.
    </p>
  </section>

  <section>
    <h2>Meanwhile the aeroplanes</h2>
    <p>
      Over exactly the same twenty-four months, {d.flights.asia.change > 0 ? 'up' : 'down'}
      {' '}{Math.abs(d.flights.asia.change).toFixed(1)}% on the Asia routes. People did not stop
      going. They stopped opening an encyclopaedia article about the visa rule first — and that is
      the kind of question, with one settled answer, that has been leaving encyclopaedias
      everywhere. The pages that held up are the ones you read because you want to, not because you
      need a fact.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Route region</th><th>Twelve months against twelve</th></tr></thead>
        <tbody>
          {d.flights.rows.map((r) => (
            <tr>
              <td class="nm">{r.region}</td>
              <td>{r.change === null ? <span class="fine">not enough months</span> : 몫(r.change)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>The same table, two rulers</h2>
    <p class="note">{d.rulerMatters.note} One month here is {d.rulerMatters.oneMonthCompared}.</p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Route region</th><th>One month</th><th>Twelve months</th></tr></thead>
        <tbody>
          {d.rulerMatters.rows.map((r) => (
            <tr>
              <td class="nm">{r.region}</td>
              <td>{몫(r.oneMonth)}</td><td>{몫(r.twelveMonths)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {d.rulerMatters.signFlips.map((r) => (
      <p>
        <strong>{r.region}</strong> is the reason this page compares twelve months against twelve.
        Read one month against the same month a year earlier, it is {몫(r.oneMonth)}. Read the year
        against the year before it, it is {몫(r.twelveMonths)}. Same table, same source, opposite
        direction — and the shorter ruler is the one that would have made the better headline.
      </p>
    ))}
  </section>

  <section>
    <h2>Every kind we measured</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Kind</th><th>Axis</th><th>Korea</th><th>Japan / Taiwan</th><th>Pairings</th></tr>
        </thead>
        <tbody>
          {종류별.map((r) => (
            <tr>
              <td class="nm">{r.kind}</td>
              <td class="fine">{r.axis === 'trip' ? 'travel' : 'culture'}</td>
              <td>{몫(r.korea)}</td><td>{몫(r.control)}</td><td class="fine">{r.n}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Editions — {d.editions.map((e) => d.editionNames[e]).join(', ')}. A kind is missing from this
      table's count where an article does not exist in an edition, or where a month could not be
      fetched; those pairings are dropped rather than counted as zero.
    </p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">Flights — {d.flights.source}. Reads — Wikimedia pageviews, human traffic only.</p>
  </section>

  <KcwCardnews set="control" count={5} />

  <KcwShorts set="control"
    says={`A man and a woman read out the four numbers, and the one that is not negative — `
      + `the Japanese and Taiwanese culture articles, which rose.`} />

  <KcwRelatedArticles page="/what-actually-fell" />
</WikiTip>
