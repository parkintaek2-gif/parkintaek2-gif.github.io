---
/*
 * K Culture Wire — **가장 많이 읽힌 K팝 대상이 실재하지 않는다.** (`/fictional-vs-real`)
 *
 * ── 왜 (2026-09-10) ────────────────────────────────────────────
 *   오늘 아침 수집 943건에서 같은 이야기가 다섯 번 걸렸다 — Eggo 와플 · McDonald's 세트 ·
 *   Mattel 인형 · 굿즈 프랜차이즈 · 시구. 전부 «실재하지 않는» K팝 그룹을 두고 맺은 계약이다.
 *   ⇒ 그러면 잴 것이 하나 있다: 그 가상 대상이 실재 그룹보다 읽히나.
 *
 * ── ✅ 사장님 지시대로 «순위와 아주 쉬운 설명»으로 낸다 (2026-09-10) ──
 *   「케이컬쳐 유저들이 이런 내용은 잘 이해못한다. 그냥 순위를 매기고, 뭔 지에 대해
 *    점성학처럼 아주 쉽게 설명하는 게 필요해 보인다」
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * 🔴 «창을 둘» 다 낸다 — 12개월과 마지막 달. 하나만 내면 유리한 창을 고른 것이 된다.
 *   실측: 12개월로는 영화가 실재 여섯 합보다 많고(1.2배), 마지막 달로는 BTS 하나에도 진다.
 *   ⛔ 오늘 아침 기술 갈래 배수를 부풀린 것과 같은 잘못을 여기서 되풀이하지 않는다.
 * ⛔ 「영화 문서를 읽은 것」을 「그 그룹을 좋아하는 것」으로 읽지 않는다 — 그 한계를 같은 크기로 적는다.
 * ⛔ 읽힘은 팔림이 아니다. 판매·스트리밍 자료가 우리에게 없다.
 * ⛔ 화면에 한국어를 내지 않는다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/kcw-fictional-vs-real.json';

type Row = {
  이름: string; 문서: string; 갈래: string; 무엇: string;
  합: number | null; 끝: number | null; 끝달: string | null;
  첫: number | null; 봉: number | null; 봉달: string | null;
  내려앉음: number | null;
};

const meta = (d as any)._meta as Record<string, any>;
const rows = ((d as any).rows ?? []) as Row[];
const cmp = (d as any).compare as {
  십이개월: { 가상: number; 실재: number; 배수: number | null; 이겼나: boolean };
  마지막달: { 가상: number; 실재: number; 배수: number | null; 이겼나: boolean };
  으뜸가상: string | null;
};

const 수 = (n: number | null) => (n === null ? '—' : n.toLocaleString('en-GB'));
const 달말 = (s: string | null) => {
  if (!s || s.length < 6) return '—';
  const 달 = ['January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'][Number(s.slice(4, 6)) - 1];
  return 달 ? `${달} ${s.slice(0, 4)}` : s;
};

const 가상 = rows.filter((r) => r.갈래 === '가상');
const 실재 = rows.filter((r) => r.갈래 === '실재');
const 열두달순 = [...rows].filter((r) => r.합 !== null).sort((a, b) => (b.합 ?? 0) - (a.합 ?? 0));
const 마지막달순 = [...rows].filter((r) => r.끝 !== null).sort((a, b) => (b.끝 ?? 0) - (a.끝 ?? 0));
const 영화 = rows.find((r) => r.문서 === 'KPop_Demon_Hunters') ?? null;
const 안그룹 = rows.find((r) => r.문서 === 'Huntr/x') ?? null;
const 안배수 = (영화?.합 && 안그룹?.합) ? +((영화.합 / 안그룹.합).toFixed(1)) : null;
const 끝달말 = 달말(영화?.끝달 ?? null);

const TITLE = 'The most-read K-pop act of the year does not exist';
const DESC =
  `Over twelve months an animated film's page was opened ${수(cmp.십이개월.가상)} times on English `
  + `Wikipedia — more than BTS, BLACKPINK, TWICE, Stray Kids, NewJeans and aespa put together. `
  + `In the last month of that same year it lost to BTS alone. Both windows, ranked, explained.`;

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Fictional versus real K-pop acts, English Wikipedia reads',
  description: DESC,
  keywords: ['KPop Demon Hunters', 'Huntr/x', 'Saja Boys', 'BTS', 'BLACKPINK', 'K-pop',
    'Wikipedia pageviews', 'most read K-pop', 'fictional K-pop group'],
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/'],
  temporalCoverage: meta.window,
  isAccessibleForFree: true,
};

const faq: Array<[string, string]> = [
  ['What is the most-read K-pop act on Wikipedia?',
    `Over the twelve months to ${끝달말.replace(/ \d{4}$/, '')} it was not a group at all — it was `
    + `an animated film. Its page was opened ${수(cmp.십이개월.가상)} times on English Wikipedia, `
    + `more than the six biggest real acts added together (${수(cmp.십이개월.실재)}).`],
  ['Is KPop Demon Hunters more popular than BTS?',
    `It depends entirely on which window you look at, so here are both. Across the whole year the `
    + `film was read ${cmp.십이개월.배수} times the six real acts combined. In the final month of `
    + `that year the film had ${수(cmp.마지막달.가상)} reads and BTS alone had `
    + `${수(실재.find((r) => r.이름 === 'BTS')?.끝 ?? null)}. Anyone quoting only one of those two `
    + `numbers is choosing a window.`],
  ['Are Huntr/x and the Saja Boys real groups?',
    `No. They are groups inside the film. Their own Wikipedia pages are far quieter than the film's `
    + `— the film was read ${안배수 ?? 'many'} times as often as Huntr/x. When a brand signs a deal `
    + `here, it is signing the film, not a group with a fanbase of its own.`],
  ['Does being read on Wikipedia mean being popular?',
    'It means people looked something up. A film page is opened by someone checking a plot, a cast '
    + 'list or a song title, which is a different kind of curiosity from looking up a group you '
    + 'follow. We cannot separate the two, and reads are not sales, streams or affection.'],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
const jsonLd = [datasetLd, faqLd];
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/fictional-vs-real">
  <article class="wrap">
    <h1>The most-read K-pop act of the year does not exist</h1>
    <p class="lead">
      Waffles, a burger set, a doll line and a first pitch — all signed this year around a K-pop
      group that is not real. So we counted how often people actually looked it up, next to the
      six biggest real acts. The answer changes depending on which month you stand in, and we
      publish both.
    </p>

    <section class="explain">
      <h2>Read this first — one thing to know</h2>
      <p>
        <b>These are Wikipedia reads, not sales.</b> Every number below is the count of people who
        opened a page on English Wikipedia. It tells you what people looked up. It does not tell
        you what they bought, streamed, or loved. We have no sales data and we are not pretending
        otherwise.
      </p>
      <p class="note">
        And one thing that matters more than it looks: a <b>film</b> page gets opened by someone
        checking a plot or a song title. A <b>group</b> page gets opened mostly by people who
        follow the group. Those are not the same curiosity, and no count can separate them.
      </p>
    </section>

    <section>
      <h2>Ranking 1 — the whole year ({meta.window})</h2>
      <table>
        <thead><tr><th>#</th><th>Who</th><th>What it is</th><th class="n">Reads</th></tr></thead>
        <tbody>
          {열두달순.map((r, i) => (
            <tr class={r.갈래 === '가상' ? 'fic' : undefined}>
              <td class="rk">{i + 1}</td>
              <td class="nm">{r.이름}{r.갈래 === '가상' && <span class="tag">not real</span>}</td>
              <td class="fine">{r.무엇}</td>
              <td class="n big">{수(r.합)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="say">
        <b>{cmp.으뜸가상} is 1st</b> — and it was read more than
        {' '}{실재.length} of the biggest real acts put together
        ({수(cmp.십이개월.가상)} against {수(cmp.십이개월.실재)}).
      </p>
    </section>

    <section>
      <h2>Ranking 2 — the last month of that same year ({끝달말})</h2>
      <p class="note">
        The same nine pages, the same source, one month instead of twelve. Watch what happens.
      </p>
      <table>
        <thead><tr><th>#</th><th>Who</th><th class="n">Reads that month</th><th class="n">Down from its first month</th></tr></thead>
        <tbody>
          {마지막달순.map((r, i) => (
            <tr class={r.갈래 === '가상' ? 'fic' : undefined}>
              <td class="rk">{i + 1}</td>
              <td class="nm">{r.이름}{r.갈래 === '가상' && <span class="tag">not real</span>}</td>
              <td class="n big">{수(r.끝)}</td>
              <td class="n fine">
                {r.내려앉음 === null ? '—' : (r.내려앉음 > 0 ? `${r.내려앉음}%` : `up ${Math.abs(r.내려앉음)}%`)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="say">
        <b>The ranking flips.</b> In that month the film lost to BTS on its own, and to the six
        real acts by a wide margin ({수(cmp.마지막달.가상)} against {수(cmp.마지막달.실재)}).
        The film fell {영화?.내려앉음}% from its first month; BTS <b>rose</b>.
      </p>
      <p>
        This is why we print two rankings instead of one. Both numbers are true. Quoting only the
        first would make a fictional group look permanently bigger than every real one; quoting
        only the second would hide that for most of a year it was. <b>Choosing the window is how
        you lie with a true number</b>, so we hand you both windows and let you keep them.
      </p>
    </section>

    {영화 && 안그룹 && (
      <section>
        <h2>What the brands are actually signing</h2>
        <p class="q">
          The film was read {안배수} times as often as the group inside it —
          {' '}{수(영화.합)} against {수(안그룹.합)}.
        </p>
        <p>
          There is a group in this film with a name, songs and a rival group. Almost nobody looks
          it up. In the final month its page was opened {수(안그룹.끝)} times, against
          {' '}{수(영화.끝)} for the film. So when waffles and a burger set arrive with this name
          on them, the thing carrying the deal is <b>the title</b> — not a group with a following
          of its own.
        </p>
      </section>
    )}

    <section>
      <h2>When it was read</h2>
      <p class="note">
        {영화 ? `The film's biggest month was ${달말(영화.봉달)} with ${수(영화.봉)} reads.` : ''}
        {' '}Twelve months later it was {수(영화?.끝 ?? null)}. Attention on a film arrives at
        release and drains; attention on a group is smaller each month and does not.
      </p>
    </section>

    <section class="faq">
      <h2>Questions people actually ask</h2>
      {faq.map(([q, a]) => (
        <div class="qa"><h3>{q}</h3><p>{a}</p></div>
      ))}
    </section>

    <section>
      <h2>Where these numbers come from, and what they cannot say</h2>
      <p class="note">{meta.source}</p>
      <p class="note">{meta.howToRead}</p>
      <ul class="lim">
        {(meta.limits ?? []).map((l: string) => <li>{l}</li>)}
      </ul>
      <p class="note">
        {(meta.notMeasured ?? []).length
          ? `Not measured: ${(meta.notMeasured ?? []).join('; ')}.`
          : 'Every page we set out to measure returned data; nothing is missing from the tables.'}
        {' '}Built {meta.builtAt}.
      </p>
    </section>

    <KcwRelatedArticles page="/fictional-vs-real" />
  </article>
</WikiTip>

<style>
  .wrap { max-width: 54rem; margin: 0 auto; padding: 1rem 1.1rem 4rem; }
  h1 { font-size: clamp(1.55rem, 4.4vw, 2.2rem); line-height: 1.14; margin: 0 0 .6rem; }
  .lead { font-size: 1.05rem; line-height: 1.62; color: #333; margin: 0 0 1.6rem; }
  section { margin: 2.3rem 0; }
  h2 { font-size: 1.14rem; margin: 0 0 .55rem; }
  h3 { font-size: .99rem; margin: 0 0 .3rem; }
  p { line-height: 1.68; margin: 0 0 .7rem; }
  .note { font-size: .88rem; color: #555; }
  .fine { font-size: .82rem; color: #666; }
  .q { font-size: 1.06rem; font-weight: 600; line-height: 1.5; margin: 0 0 .6rem; }
  .say { font-size: 1.02rem; line-height: 1.6; background: #f6f4fb; border-left: 3px solid #7c5cd0;
         padding: .7rem .9rem; margin: .8rem 0 .5rem; }
  .explain { background: #fafafa; border: 1px solid #ececec; border-radius: 8px; padding: 1rem 1.1rem; }
  table { border-collapse: collapse; width: 100%; font-size: .93rem; }
  th, td { border-bottom: 1px solid #ececec; padding: .42rem .5rem; text-align: left; }
  thead th { border-bottom: 2px solid #ddd; font-weight: 600; font-size: .85rem; }
  .n { text-align: right; font-variant-numeric: tabular-nums; }
  .big { font-weight: 700; }
  .rk { width: 2rem; color: #7c5cd0; font-weight: 700; }
  .nm { font-weight: 600; }
  .tag { font-size: .7rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
         background: #efe9ff; color: #5b3fb0; border-radius: 3px; padding: .1rem .3rem;
         margin-left: .35rem; vertical-align: .08em; }
  tr.fic .nm { color: #5b3fb0; }
  ul.lim { margin: .3rem 0 .7rem 1.1rem; padding: 0; }
  ul.lim li { font-size: .88rem; color: #555; line-height: 1.6; margin: 0 0 .25rem; }
  .qa { margin: 0 0 1.1rem; }
  a { color: #5b3fb0; }
  @media (prefers-color-scheme: dark) {
    .lead { color: #cfcfcf; }
    .note, ul.lim li { color: #a8a8a8; }
    .fine { color: #9a9a9a; }
    .say { background: #221d33; border-left-color: #9b83e0; }
    .explain { background: #1a1a1a; border-color: #2e2e2e; }
    th, td { border-bottom-color: #2c2c2c; }
    thead th { border-bottom-color: #3a3a3a; }
    .rk { color: #9b83e0; }
    .tag { background: #2c2444; color: #c4b2f5; }
    tr.fic .nm { color: #c4b2f5; }
    a { color: #b39ff0; }
  }
</style>
