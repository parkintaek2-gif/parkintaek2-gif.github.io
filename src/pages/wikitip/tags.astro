---
/*
 * tags.astro — **태그 지면 39장으로 가는 문.**
 *
 * ── 🔴 왜 이 지면이 생겼나 (2026-09-03) ────────────────────────
 * `check-two-clicks.mjs` 를 돌리니 태그 지면 39장이 통째로 «세 걸음» 밖이었다.
 * ```
 *   첫 화면 → 기사 → 그 기사의 태그        세 걸음
 *   태그끼리는 서로 여덟씩 걸고 있었지만    들어가는 «첫 문»이 없었다
 * ```
 * 결함 이름은 **«고아 허브»**다 — 같은 날 `/weeks`(269장) · `/hometowns`(37장) ·
 * `/born-year`(78장) 도 같은 꼴이었다. 목록을 만들고 그 목록으로 가는 문을 안 낸 것.
 * 다만 태그는 허브 자체가 «아예 없었다». 그래서 만든다.
 *
 * ⭐ 2번 지시(2026-08-09) — 「구글은 링크를 타고 온다. 두 번 안에 못 닿으면
 *   색인을 걸어도 잘 안 잡힌다」.
 *
 * ── ⛔ 이 지면이 지키는 것 ─────────────────────────────────────
 * ⛔ 태그 목록을 손으로 적지 않는다. `tag/[tag].astro` 의 `슬러그`·`최소편수` 를 **그대로
 *   가져와** 같은 규칙으로 접는다 — 두 곳에 규칙을 두면 하나를 고칠 때 다른 하나가 어긋나
 *   여기에 있는 링크가 404 가 된다.
 * ⛔ 「인기 태그」라고 부르지 않는다. 우리가 가진 것은 «편수»이지 인기가 아니다.
 * ⛔ 한 편짜리 태그는 여기서도 링크하지 않는다(그 지면이 없다). 몇 개인지는 적는다.
 */
import { getCollection } from 'astro:content';
import WikiTip from '../../layouts/WikiTip.astro';
import { 목록구조화 } from '../../lib/list-jsonld.ts';
import { 슬러그, 최소편수 } from './tag/[tag].astro';

const 기사 = (await getCollection('kcwArticles')).filter((e: any) => !e.data.draft);

const 통 = new Map<string, { 이름: Set<string>; 글: Set<string> }>();
for (const e of 기사) {
  for (const t of (e.data.tags ?? [])) {
    const s = 슬러그(t);
    if (!s) continue;
    if (!통.has(s)) 통.set(s, { 이름: new Set(), 글: new Set() });
    통.get(s)!.이름.add(String(t));
    통.get(s)!.글.add(e.id);
  }
}
/* ⚠ 편수로 내림차순, 같으면 이름으로 — 자리로 고르지 않고 값으로 고른다.
   자료 순서가 바뀌어도 화면이 같게 나오게 한다 */
const 낼것 = [...통.entries()]
  .filter(([, v]) => v.글.size >= 최소편수)
  .map(([s, v]) => ({ slug: s, name: [...v.이름].sort((a, b) => b.length - a.length)[0], n: v.글.size }))
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
const 안낸것 = 통.size - 낼것.length;

const TITLE = `Every subject we have published on — ${낼것.length} tags`;
const DESC = `The ${낼것.length} subjects K Culture Wire has published more than one piece on, `
  + `across ${기사.length} articles. Each one opens a page listing everything we hold on it.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/tags"
  jsonLd={목록구조화({
    주소: '/tags',
    이름: 'Subjects — K Culture Wire',
    설명: DESC,
    줄들: 낼것.map((t) => ({ name: `#${t.name}`, url: `/tag/${t.slug}` })),
  }, ['https://www.kculturewire.com/articles'])}>
  <h1>Every subject we have published on</h1>

  <p class="lead">
    <b>{낼것.length}</b> subjects, across <b>{기사.length}</b> articles. The number beside each is
    how many pieces carry that tag &mdash; not how much anyone read it.
  </p>

  <ul class="taggrid">
    {낼것.map((t) => (
      <li>
        <a href={`/tag/${t.slug}`}>#{t.name}</a>
        <span class="cnt">{t.n}</span>
      </li>
    ))}
  </ul>

  <section class="src">
    <h2>How this was built</h2>
    <ul>
      <li><b>Where the tags come from</b> &mdash; the front matter of each published article,
        nothing added here.</li>
      <li><b>What is left out</b> &mdash; {안낸것} tags sit on a single piece. We do not open a
        page for those; the tag still shows on the article, it just does not become an address of
        its own.</li>
      <li><b>Spellings folded together</b> &mdash; the same subject written two ways
        (k-pop and kpop, say) becomes one address, and the tag page says which spellings it gathered.</li>
    </ul>
    <p class="note">
      <a href="/articles">Everything, newest first</a> &middot;{' '}
      <a href="/section/stars">Stars</a> &middot;{' '}
      <a href="/section/titles">Titles</a> &middot;{' '}
      <a href="/section/industry">Industry</a> &middot;{' '}
      <a href="/section/tradition">Tradition</a>
    </p>
  </section>
</WikiTip>

<style>
  .taggrid { list-style: none; padding: 0; display: grid; gap: 0.4rem 1rem;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); }
  .taggrid .cnt { color: #6b7280; font-size: 0.85em; margin-left: 0.35rem; }
  .src { margin-top: 2rem; }
  .note { font-size: 0.9em; }
</style>
