---
/**
 * K Culture Wire — 동남아 넷플릭스 Top10 에 오른 한국 작품 카탈로그. (/titles)
 *
 * 데이터: src/data/wikitip-titles.json (scripts/build-wikitip-titles.mjs 가 만든다).
 * 첫 화면은 **현재 주** 8개만. 이 지면은 **5년 전체**(265주·448작품)를 카탈로그로 낸다.
 * 라이선스: 넷플릭스 Tudum 국가별 순위. 원본 표 재배포 없이 **집계**만(첫 화면·About 과 같은 방식).
 * 색인: **열려 있다.** noindex 없음 · canonical 있음 (2026-08-06 17:0x 라이브 실측 200).
 *   ⚠ 여기 「noindex: 도메인이 파킹이라」로 적혀 있던 것은 파킹 시절 주석이라 지웠다.
 *     kculturewire.com 은 살아 있다. 소스만 보면 반대로 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import { 지은날글 } from "../../../scripts/lib/kcw-date.mjs";
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/wikitip-titles.json';
import titlePages from '../../data/wikitip-title-pages.json';
import 해자료 from '../../data/wikitip-years.json';
import ambiguity from '../../data/wikitip-title-ambiguity.json';
import key from '../../data/wikitip-key-integrity.json';
import korea from '../../data/wikitip-korea-signal.json';

/**
 * 🔴 2026-08-22 — 4주 실측에서 이 지면이 **노출 67 · 순위 7.9 · 클릭 0** 이었다.
 *   자료 지면 무리에서 가장 큰 자리인데 한 번도 안 눌렸다.
 *
 * ⛔ 까닭을 찾았다: 제목이 **이 지면이 주는 것보다 좁게** 말한다. 표는 동남아 여섯 나라지만
 *   이 지면은 **93개국을 담은 작품 지면 528장으로 링크**한다(실측: 링크 528개).
 *   손님은 검색 결과에서 「Southeast Asia」만 읽고 자기 나라 이야기가 아니라고 판단한다.
 * ⭐ 좁게도 넓게도 말하지 않는다 — **가진 그대로** 적는다. 93개국 지면과 여섯 나라 표 둘 다.
 * ⚠ 「모든 나라」라고 쓰지 않는다. 넷플릭스가 수를 내는 나라가 93개이고 그것이 세상 전부는 아니다.
 */
/* 🔴 2026-08-25 — 앞머리를 「Korean drama list」로 바꿨다. 왜인지 적어 둔다.
   `check-demand-covered.mjs` 로 재니 「korean drama list」가 자동완성 1번째·10줄인데
   내 제목은 「Every Korean title that reached a Netflix top 10」이었다.
   ⛔ 「title」은 «우리 자료의 말»이고 손님이 치는 말은 「drama list」다.
     8/24 에 /year 에서 똑같은 잘못을 고쳤는데 이 지면은 그대로 두었다 —
     한 곳을 고치면 같은 결함을 인용한 곳까지 따라가야 한다는 것을 또 놓쳤다.
   ⛔ 낱말을 끼워 넣은 것이 아니다. 이것은 실제로 목록 지면이고 실려 있는 것은 한국 작품이다.
   ⚠ 「films」를 남긴다 — 드라마만 있는 목록이 아니라는 것을 제목에서 밝힌다. */
/* 🔴 2026-08-27 03:3x — **노출 85에 클릭 0이었다.** 제목 95자·설명 314자로 둘 다 잘렸다.
   ⭐ 위 주석의 판단(「Korean drama list」로 시작한다 · 「films」를 남긴다)은 그대로 지켰다.
     길이만 줄였다 — 제목은 60자, 설명은 155자 안이다.
   ⛔ 「Counted from Netflix's own weekly lists」를 뺀 것은 감춘 것이 아니다. 지면 본문의
     출처 칸에 그대로 있다. 잘려서 안 보이던 글자를 보이는 글자로 바꾼 것이다. */
const TITLE = `Korean drama list — ${titlePages.pageCount} that reached a Netflix top 10`;
const DESC =
  `${titlePages.titleCount} Korean shows and films have hit a country's Netflix top 10 `
  + `since ${titlePages.weekFrom}. ${titlePages.pageCount} have a page here with every market and week.`;

const rows = data.rows;
const reachedNo1 = rows.filter((r) => r.peak === 1).length;
const allSix = rows.filter((r) => r.countries === data.countries).length;
const tv = rows.filter((r) => r.type === 'TV').length;
const films = rows.filter((r) => r.type === 'Films').length;
const maxWeeks = Math.max(...rows.map((r) => r.weeks));

// 카탈로그를 다 싣지 않는다(448 은 모바일에서 벽이 된다). 오래 머문 순 상위를 싣고 총계를 밝힌다.
const top = [...rows]
  .sort((a, b) => b.weeks - a.weeks || b.countries - a.countries || a.peak - b.peak)
  .slice(0, 40);

/* ⛔ 2026-08-08. 이 지면은 「몇 편을 못 쟀나」는 적으면서 **어느 편인지는 한 번도 안 적었다.**
   판정(perTitle)은 이미 448편 전부에 있다. 이름으로 붙여서 겹치는 편을 이름째 낸다.
   ⛔ 숫자를 손으로 적지 않는다 — 여기서 세고 지면은 그 값을 읽는다.
   ⛔ 글로벌 요약(ambiguity.titles=236)과 이 448편은 **다른 모집단**이다. 섞어 적지 않는다. */
const 판정 = new Map(ambiguity.perTitle.map((p) => [p.title, p]));
const 붙은판정 = rows.map((r) => ({ ...r, v: 판정.get(r.title) })).filter((r) => r.v);
const sharedRows = 붙은판정
  .filter((r) => r.v.verdict === 'shared')
  .map((r) => ({ ...r, others: r.v.countries.filter((c) => c !== 'South Korea') }))
  .sort((a, b) => b.weeks - a.weeks || b.others.length - a.others.length);
const koreaOnlyCount = 붙은판정.filter((r) => r.v.verdict === 'koreaOnly').length;
const unknownCount = 붙은판정.filter((r) => r.v.verdict === 'unknown').length;
const totalWeeks = rows.reduce((s, r) => s + r.weeks, 0);
const sharedWeeks = sharedRows.reduce((s, r) => s + r.weeks, 0);
const sharedWeekPc = +((100 * sharedWeeks) / totalWeeks).toFixed(1);
const sharedTop = sharedRows.slice(0, 12);

/* 2026-08-08. 겹치는 이름에 **두 번째 자**를 댄다 — 넷플릭스 한국 차트다.
   ⛔ 「한국 차트에 없다」를 「한국 것이 아니다」로 쓰지 않는다. 손으로 볼 **차례**일 뿐이다.
   ⛔ 갈래별 몫도 손으로 안 적는다. 판정에서 센다. */
const 갈래몫 = ['TV', 'Films'].map((k) => {
  const g = korea.rows.filter((r) => r.type === k);
  return {
    이름: k === 'TV' ? 'Series' : 'Films',
    n: g.length,
    몫: +((100 * g.filter((r) => r.verdict === 'shared').length) / g.length).toFixed(1),
  };
});
const 급한차례 = korea.reviewQueue.filter((r) => r.queue === 'one-country-only').slice(0, 8);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Korean titles in the Netflix Top 10 across Southeast Asia, 2021–2026',
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  temporalCoverage: `${data.weekFrom}/${data.weekTo}`,
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://query.wikidata.org/'],
};

/* 연도 지면 여섯 장으로 가는 문. ⛔ 편수 순으로 안 세운다 — 최근 해가 앞이다 */
const 연도들 = 해자료.years;
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/titles">
  <h1>Korean titles in Southeast Asia’s Netflix Top 10</h1>
  <p class="lead">
    Since {data.weekFrom.slice(0, 4)}, <b>{data.titleCount}</b> Korean shows and films have reached the
    Netflix Top 10 in at least one of six Southeast Asian countries — {data.region.split('— ')[1]}.
    This is the whole list, counted from Netflix’s own weekly rankings across {data.weekCount} weeks.
  </p>

  <section class="stats">
    <div><b>{data.titleCount}</b><span>Korean titles charted</span></div>
    <div><b>{reachedNo1}</b><span>reached #1 somewhere</span></div>
    <div><b>{allSix}</b><span>charted in all six countries</span></div>
    <div><b>{tv} / {films}</b><span>series / films</span></div>
  </section>

  <section>
    <h2>The ones that stayed longest</h2>
    <p class="sub">
      Ranked by total weeks in the Top 10 across the six countries, then by how many countries and
      how high. A week counts once per country. Showing the top {top.length} of {data.titleCount}.
    </p>
    <ul class="rows">
      {top.map((r) => (
        <li>
          <span class="bar" style={`--w:${(r.weeks / maxWeeks) * 100}%`}></span>
          <span class="nm">{r.title}</span>
          <span class="meta">
            <b>{r.weeks}</b> weeks · {r.countries} of {data.countries} countries · peaked #{r.peak} · {r.type === 'TV' ? 'series' : 'film'}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Which of these we cannot tell apart by name</h2>
    <p class="sub">
      A title enters this list because its English name matches a Korean work. That rule can only go
      wrong one way: <b>another country made something with the same name</b>. So we asked Wikidata,
      for every title here, which countries produced a film or series carrying exactly that label.
    </p>
    <ul class="verdicts">
      <li><b>{koreaOnlyCount}</b><span>only Korean works carry the name — the text rule cannot be wrong</span></li>
      <li><b>{sharedRows.length}</b><span>a foreign work shares the name — we cannot tell from the text which one charted</span></li>
      <li><b>{unknownCount}</b><span>Wikidata gives no country for the name at all</span></li>
    </ul>
    <p class="sub">
      The shared group is <b>{sharedWeekPc}%</b> of all {totalWeeks.toLocaleString()} chart-weeks on
      this page. These are the {sharedTop.length} of them that stayed longest, with the countries
      whose works share the name:
    </p>
    <ul class="shared">
      {sharedTop.map((r) => (
        <li>
          <span class="nm">{r.title}</span>
          <span class="meta"><b>{r.weeks}</b> weeks · shares the name with {r.others.length === 1 ? 'a work from' : 'works from'} {r.others.slice(0, 4).join(', ')}{r.others.length > 4 ? ` and ${r.others.length - 4} more` : ''}</span>
        </li>
      ))}
    </ul>
    <p class="note">
      <b>Shared does not mean wrong.</b> <cite>The Glory</cite> and <cite>Business Proposal</cite> are in this
      group and both are plainly the Korean works — nothing else by those names has been near a
      Southeast Asian Top 10. It means we cannot prove it <em>from the title text alone</em>, and we
      would rather you saw the list than took our word for the ones we happened to check. Where the
      chart carries a language label we use it; {data.unlabelledTitles} of these titles never reached
      a global Top 10 and so carry no label to check against.
    </p>
  </section>

  <section>
    <h2>A second ruler: Netflix’s own Korean chart</h2>
    <p class="sub">
      Wikidata says a collision is possible. It cannot say which work charted. A Korean title normally
      also plays in Korea, so we checked every shared title against Netflix’s South Korea list over the
      same weeks. {korea.method}
    </p>
    <ul class="verdicts">
      <li><b>{korea.sharedWithoutKorea}</b><span>of the {korea.sharedTitles} shared titles have never appeared on Netflix’s Korean top ten</span></li>
      <li><b>{korea.queues.oneCountryOnly}</b><span>of those charted in exactly one country in the world — the queue we read first</span></li>
      <li><b>{korea.sameCountryWork}</b><span>of that queue charted in one country <em>and</em> Wikidata names a work from that same country — the sharpest signal we have, and still not a verdict</span></li>
      <li><b>{korea.queues.concentrated}</b><span>took more than half their weeks in a single country</span></li>
      <li><b>{korea.queues.noKorea}</b><span>spread widely but never touched Korea</span></li>
    </ul>
    <p class="sub">
      The ambiguity is not spread evenly. Films carry short, common names; series do not:
    </p>
    <ul class="verdicts">
      {갈래몫.map((r) => (
        <li><b>{r.몫}%</b><span>of the {r.n} {r.이름.toLowerCase()} in this list share their name with a foreign work</span></li>
      ))}
    </ul>
    <p class="sub">Charted in one country and never in Korea — first in the queue:</p>
    <ul class="shared">
      {급한차례.map((r) => (
        <li>
          <span class="nm">{r.title}</span>
          <span class="meta"><b>{r.seaWeeks}</b> weeks · only in {r.topCountry} · {r.type === 'TV' ? 'series' : 'film'}</span>
        </li>
      ))}
    </ul>
    <p class="note">
      <b>This queue is not a list of errors.</b> <cite>Vagabond</cite> is on it and is plainly a Korean
      drama; it simply never reached Korea’s own top ten. A Korean title can miss that chart because it
      was released before this data begins in July 2021, because Netflix never streamed it in Korea, or
      because it lost its week at home. Absence is a reason to look, not a verdict. Anything we do
      remove will appear on <a href="/corrections">the corrections page</a> with the evidence.
      <br />
      <span class="fine">
        Counted from {korea.panelTitles} panel titles across every country Netflix publishes. Weeks are
        counted once per country per week: the source repeats {korea.duplicateRows.toLocaleString()} of
        its {korea.scannedRowsForPanel.toLocaleString()} rows for these titles, and counting rows would
        overstate them. {지은날글(korea.generated)} {korea.source}.
      </span>
    </p>
  </section>

  {/* ── 작품 지면으로 가는 문. 2026-08-09 09:0x — 530장을 만들어 놓고 여기 안 걸면 없는 것과 같다 ── */}
  <section>
    <h2>Every Korean title that has charted, and where it charted</h2>
    <p class="sub">
      {titlePages.titleCount} Korean titles have reached at least one country's Netflix top 10 since
      {' '}{titlePages.weekFrom}. <b>{titlePages.pageCount}</b> of them have a page of their own,
      listing every market they charted in, the companies credited on them and the cast Wikidata
      records as Korean.
    </p>
    <p class="note">
      The other {titlePages.titleCount - titlePages.pageCount} do not, and we would rather say so
      than publish an empty page: a title needs at least {titlePages.minRowsForPage} rows of data
      before we make one. The published pages carry {titlePages.rowsMedianPublished} rows at the
      median and {titlePages.rowsTotalPublished.toLocaleString('en-US')} rows between them; across all
      {' '}{titlePages.titleCount} titles the median is {titlePages.rowsMedianAll}, which is why most
      of them have no page.
    </p>
    <p class="note">
      Of the {titlePages.titleCount} titles, {titlePages.withFirms} carry at least one company credit
      and {titlePages.withCast} carry at least one cast member Wikidata records as Korean. Neither
      gap means the title had no company or no Korean cast — it means Wikidata does not hold it.
      {titlePages.clashingSlugs.length > 0 && (
        <> ⚠ {titlePages.clashingSlugs.length} pairs of titles differ only in spacing or capitalisation
        {' '}({titlePages.clashingSlugs.map((c) => c.titles.join(' / ')).join('; ')}). We publish the
        one Wikidata identifies and leave the other out rather than merge two entries we cannot prove
        are the same work.</>
      )}
    </p>
    <div class="titlegrid">
      {titlePages.titles.filter((x) => x.hasPage).map((x) => (
        <a href={`/title/${x.slug}`}>{x.title} <span class="fine">{x.markets}</span></a>
      ))}
    </div>
    <p class="note">
      <b>Alphabetical, not ranked.</b> The small number beside each is how many markets it charted in.
    </p>
  </section>

  {/*
    🔴 2026-08-08 20:3x — `wikitip-key-integrity.json` 을 **어느 지면도 안 읽고 있었다.**
       이 표는 우리 판이 어떻게 묶여 있는지를 사는 사람에게 밝히는 자리다. 없으면
       손님은 「한 주에 한 나라 Top10 = 열 편」으로 읽는다. 우리가 처음에 그렇게 읽었다.
    ⛔ 「중복」이라 부르지 않는다. 같은 제목이 한 목록에 여러 자리를 잡는 것은 **시즌이 다른 것**이고,
       그건 자료의 흠이 아니라 우리가 열쇠를 잘못 잡은 것이었다.
  */}
  <section>
    <h2>What counts as one row here</h2>
    <p class="note">{key.question}</p>
    <div class="scroll-x">
      <table>
        <tbody>
          <tr>
            <td class="nm">Rows we read</td>
            <td class="tot">{key.rows.toLocaleString('en-US')}</td>
            <td class="sub">every country, every week</td>
          </tr>
          <tr>
            <td class="nm">Rows a title-only key would have merged away</td>
            <td class="tot">{key.extraRowsByTitleCountryWeek.toLocaleString('en-US')}</td>
            <td class="sub">{key.extraRowsPc}% of the file</td>
          </tr>
          <tr>
            <td class="nm">Explained once the season is part of the key</td>
            <td class="tot">{key.explainedBySeasonPc}%</td>
            <td class="sub">{key.titlesAffected} titles across {key.countriesAffected} countries</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      A weekly top ten is not ten titles. One show can hold several places at once with different
      seasons — the record is <b>{key.biggest[0].places} of the ten</b> in
      {' '}{key.biggest[0].country}, week {key.biggest[0].week}. How often that happens:
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Places held by one title at once</th><th>Times</th></tr>
        </thead>
        <tbody>
          {key.placesDistribution.map((d) => (
            <tr><td class="nm">{d.places}</td><td class="tot">{d.times.toLocaleString('en-US')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <b>This is not a fault in Netflix's data.</b> It is what happens when you key on a title alone,
      which is what we did at first. Everything on this page is keyed on week, country, list and
      season together — with that key the file has <b>{key.duplicateSlots}</b> duplicate slots and
      {' '}<b>{key.duplicateWholeRows}</b> duplicate rows in {key.distinctSlots.toLocaleString('en-US')}.
      {' '}<a href="/article/a-weekly-top-ten-is-not-ten-titles">The full story &rarr;</a>
    </p>
    <p class="note">
      <b>Where the extra rows come from.</b> Adding the list (Films or TV) to the key explains
      {' '}{key.extraRowsWithList.toLocaleString('en-US')} of them and the season a further
      {' '}{key.extraRowsWithSeason}. It happens in {key.listsWithARepeatedTitle.toLocaleString('en-US')}
      {' '}separate country-weeks, and {key.biggestCount} of those are ties for the largest case above.
    </p>
    <p class="note">
      <b>And {key.nameCollisions.pairs} pairs are two different works sharing a name in the same
      week</b> — mostly <i>{key.nameCollisions.byTitle[0].title}</i>
      {' '}({key.nameCollisions.byTitle[0].pairs} of them). Weeks-on-chart separates
      {' '}{key.nameCollisions.separatedByWeeksOnChart} of the {key.nameCollisions.pairs};
      {' '}<b>{key.nameCollisions.unresolvable} cannot be separated at all</b> and we say so rather
      than pick one.
    </p>
    <p class="note">
      <b>What this costs our own panel.</b> These {data.titleCount} titles come from
      {' '}{key.ourPanel.rowsRead.toLocaleString('en-US')} rows, which are
      {' '}{key.ourPanel.distinctTitleCountryWeeks.toLocaleString('en-US')} distinct title-country-weeks.
      Counting rows instead would have added {key.ourPanel.extraRowsIfCountingRows.toLocaleString('en-US')}
      {' '}({key.ourPanel.extraRowsPc}%) — mostly <i>{key.ourPanel.worst[0].title}</i> holding three
      places at once.
    </p>
  </section>

  <KcwRelatedArticles page="/titles" />

  <section class="src">
    <h2>Where these numbers come from</h2>
    <ul>
      <li>
        <b>Netflix Top 10 (Tudum)</b> — the official weekly country lists for Singapore, Malaysia,
        the Philippines, Thailand, Indonesia and Vietnam, every week from {data.weekFrom} to {data.weekTo}.
        Netflix publishes them as <code>all-weeks-countries.tsv</code>; what is and is not inside
        that file is set out on <a href="/netflix-top10-data">Inside Netflix&rsquo;s Top&nbsp;10 files</a>,
        and every week in it has its own page under <a href="/weeks">all Top&nbsp;10 weeks</a>.
        {/* 🔴 2026-08-24 — 자동완성 실측: 손님은 「netflix top 10 korean drama」라고 친다
            (1번째 · 그 말로 시작 9줄). 이 지면은 영화까지 담으니 시리즈만 찾는 쪽에 갈 곳을 준다.
            ⛔ 낱말을 채운 것이 아니다 — 그쪽 지면은 실제로 TV 398편만 담는다. */}
        {' '}Looking for series only? <a href="/netflix-top-10-korean-drama">Netflix top 10 Korean drama, all 398 &rarr;</a>
      </li>
      <li>
        <b>Wikidata</b> — a title counts as Korean when its country-of-origin field (P495) lists
        South Korea. That is what decides inclusion, not our judgement.
      </li>
    </ul>
    <p class="note">
      <b>What the numbers are, and are not.</b> “Weeks” counts each week a title appeared in a
      country’s Top 10, summed across the six — a title in three countries for one week counts as
      three. It measures reach and staying power on this one service, not quality, and not total
      audience. Netflix is not streaming: a title absent here may simply be strong elsewhere.
    </p>
    {/*
      ⛔ 2026-08-07 에 이 자리가 비어 있었다. 빌드가 `unlabelledTitles` 를 세어 두는데
         **어느 지면도 그 값을 안 썼다.** 405편 중 204편이 언어로 확인이 안 되는데
         지면은 그 말을 한 적이 없다. 「무엇을 못 쟀는지 밝힌다」가 여기서 빠져 있었다.
      ⛔ 이 수를 손으로 적지 않는다. 자료에서 읽는다.
    */}
    <p class="note">
      <b>How many of these we could verify.</b> Netflix splits its <em>global</em> chart by a
      title’s primary language, so a title that has reached the global Top 10 can be checked
      against that label. Country charts carry no language field. <b>{data.unlabelledTitles} of
      these {data.titleCount} titles have never appeared in a global Top 10</b>, so the language
      check cannot be applied to them at all — they are here on a title-text match alone. They are
      also the small ones: the median title in that group charted in one country. We keep them and
      say so rather than drop them quietly.
    </p>
    <p class="note">
      <b>What the check did remove.</b> Where the label exists, it works:{' '}
      <b>{data.excludedEnglishChart}</b> titles matched a Korean work by name but Netflix filed
      them on its English charts, so they are not the Korean work and are out.
      A further <b>{data.excludedByHandRead.length}</b> came out by hand after we read them one at a
      time — {data.excludedByHandRead.slice(0, 3).join(', ')} among them.
      {' '}<b>{data.excludedByAttribution.length} more came out on 8 August 2026 without being read</b>:
      the same Wikidata question that produces the verdicts below returned no Korean work at all for
      those names — {data.excludedByAttribution.slice(0, 3).join(', ')} among them. A title our own
      instrument says nothing Korean carries cannot sit in a Korean panel. Every count here is
      produced by the build, not typed.
    </p>
    <p class="note">
      The front page shows this week’s new entries. Counts derived from Netflix’s published lists;
      we do not republish the lists themselves. {지은날글(data.generated)}
    </p>
  </section>

  <section>
    <h2>By the year it charted</h2>
    <p class="note">
      Every title above also sits in the year it held its places. This is the one axis every
      title has &mdash; some carry no cast or company data at all, but all of them have a year.
    </p>
    <p class="years">
      {연도들.map((y, i) => (
        <span>
          {i > 0 ? ' · ' : ''}
          <a href={`/year/${y.year}`}>{y.year}</a>
          <span class="fine"> {y.titles} titles{y.partialYear ? ' (part year)' : ''}</span>
        </span>
      ))}
    </p>
    <p class="note">
      <b>Two of those years are half years.</b> Our data begins in July 2021 and ends in July
      2026, so those two hold about half the weeks the others do. Comparing their totals with a
      full year would show a rise and a fall that belong to the window, not to the industry.
    </p>
  </section>

