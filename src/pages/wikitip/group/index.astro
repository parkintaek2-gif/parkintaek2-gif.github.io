---
/*
 * group/index.astro — **그룹 263개의 문간.**
 *
 * 문을 안 달면 263장이 사이트맵에만 있고 아무 데서도 안 걸린다 — 어제 그 자리에서
 * 「만들고 안 걸린 것」을 회사 전체가 열었다. 같은 잘못을 안 한다.
 * ⛔ 멤버 수로 줄 세우되 «순위»라고 부르지 않는다. 위키데이터에 실리는 것은 편집자가 정한다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-groups.json';

const 그룹들 = data.groups ?? [];
const 기준해 = data.refYear;
const 수 = (n: number) => Number(n).toLocaleString('en-US');
const 멤버합 = 그룹들.reduce((s: number, g: any) => s + g.membersNamed, 0);

const TITLE = `Kpop idols age and birthday — ${그룹들.length} Korean groups, member by member`;
const DESC = `${그룹들.length} Korean music groups with the members Wikidata records for each: `
  + `birth date, age as of ${기준해}, star sign and place of birth. `
  + `${수(멤버합)} members named in all.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/group">
  <h1>Kpop idols by group — age and birthday, member by member</h1>

  <p class="lead">
    <b>{그룹들.length}</b> Korean groups, with the members Wikidata records for each —
    birth date, age <b>as of {기준해}</b>, star sign and place of birth.
    {' '}<b>{수(멤버합)}</b> members are named in all.
  </p>

  <p class="warn">
    <b>These are the members Wikidata records, not current line-ups.</b> The field we read holds
    everyone recorded as part of a group, so people who have since left are included, and we
    cannot tell the two apart. <b>Ages move; birth dates do not</b> — the ages are true as of
    {' '}{기준해}, the year this page was built.
  </p>

  <section>
    <h2>The groups</h2>
    <p class="note">
      Most members first. <b>That is not a ranking.</b> A longer list reflects how many people
      have been in the group and who happens to have a Wikidata entry.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Group</th><th>Members named</th><th>With a birth date</th><th>Born between</th></tr></thead>
        <tbody>
          {그룹들.map((g: any) => (
            <tr>
              <td class="nm"><a href={`/group/${g.slug}`}>{g.name}</a></td>
              <td class="tot">{g.membersNamed}</td>
              <td>{g.membersWithBirthday}</td>
              <td>{g.oldestBornYear && g.youngestBornYear
                ? (g.oldestBornYear === g.youngestBornYear
                  ? g.oldestBornYear
                  : `${g.oldestBornYear}–${g.youngestBornYear}`)
                : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note fine">
      We hold {data.groupsSeen} Korean groups in all. {data.groupsNotListed} of them have fewer
      than {data.minMembersToList} members we could name, and we do not publish a page for those —
      they are counted, not hidden. A dash means we hold no birth date for anyone in that group.
    </p>
  </section>

  <section class="notes">
    <h2>What we do not publish</h2>
    <p class="note">
      <b>We do not publish heights.</b> Wikidata records a height for about 3% of the Korean
      performers we hold. A &ldquo;tallest member&rdquo; built on 3% would be wrong far more often
      than right, so we do not build one — even though it is one of the most searched questions
      about these groups.
    </p>
    <p class="note">
      <b>We do not say what a star sign means.</b> Across 1,047 Korean actors who reached a
      Netflix chart, the spread across birth-year animals was indistinguishable from chance.
      {' '}<a href="/star-signs">That test is here</a>.
    </p>
  </section>

  <section class="onward">
    <h3>Other ways into the same people</h3>
    <ul class="walk">
      <li><a href="/born-on">Korean actors&rsquo; birthdays &mdash; all 366 days</a></li>
      <li><a href="/actors-in-their/20s">Korean actors by age</a></li>
      <li><a href="/hometowns">Where Korea&rsquo;s most-read stars were born</a></li>
      <li><a href="/school">Where Korean actors and singers studied</a></li>
      <li><a href="/star-sign/cancer">By star sign, twelve of them</a></li>
    </ul>
  </section>
</WikiTip>
