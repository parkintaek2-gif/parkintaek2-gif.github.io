---
/*
 * group/[group].astro — **그룹별 지면 263장.** (`/group/bts`)
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 우리 검색 실측에서 **노출이 가장 큰 지면이 BTS 기사**였다(68노출). 그 갈래를 재니 —
 * ```
 *   bts members age        자동완성 1번째 · 그 말로 시작 10줄
 *   bts members birthday   1번째 · 10줄
 *   blackpink members age  1번째 · 10줄
 * ```
 * 손님이 묻는 낱알은 **「그룹 하나의 멤버들」**인데, 우리는 생년월일 9,249건을 갖고도
 * 그룹-멤버를 잇는 자료가 없어 그 축으로 한 장도 못 내고 있었다.
 *
 * ── 🔴 이 지면이 반드시 지키는 것 ─────────────────────────────
 * ⛔ **「현재 멤버」라고 안 쓴다.** 위키데이터 P527 은 «있었던» 사람을 담아 탈퇴자도
 *   들어 있고 우리는 그 둘을 못 가른다. 지면에 그대로 적는다.
 * ⛔ **나이를 혼자 안 적는다.** 나이는 움직이는 수이고 이 지면은 배포할 때만 다시 지어진다.
 *   기준 해와 «태어난 날»을 같이 적어야 지면이 낡아도 읽는 사람이 스스로 고쳐 읽는다.
 * ⛔ **적힌 멤버 수와 이름 쓸 수 있는 수를 갈라 적는다.** 위키데이터는 BLACKPINK 를
 *   4명으로 적는데 한 사람에게 영문 이름이 없다. 「3명」만 적으면 그것은 틀린 수다.
 * ⛔ **점을 안 친다.** 별자리 칸은 생일에서 나온 산수일 뿐이고, 그것이 무엇을 뜻하는지
 *   우리는 말하지 않는다 — `/star-signs` 에서 1,047명으로 재 보고 「우연과 구별되지
 *   않는다」고 낸 그 결과를 여기서도 그대로 붙인다.
 * ⛔ 키를 안 적는다 — 위키데이터에 키가 적힌 한국 연예인이 3.5%뿐이다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-groups.json';
import people from '../../../data/wikitip-people.json';
import { 이름표만들기, 이지면의문, 문 } from '../../../lib/person-link';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다(8/24 에 그것으로
     빌드가 멈췄다). 자료는 여기서 읽고 지면이 쓸 것은 props 로 건넨다 */
  const 그룹들 = data.groups ?? [];
  /* 🔴 [2026-08-26] **멤버 이름이 사람 지면으로 안 갔다.** 263장 × 멤버 여럿이
     전부 글자였다. 사람 지면 636장은 지금 구글에서 「발견만」인데, 그리로 가는
     가장 자연스러운 문이 여기다.
     ⛔ 이름이 겹치면 «안 건다» — 틀린 사람에게 보내느니 글자로 둔다(person-link 참고).
     ⚠ 표 전체를 지면마다 실어 보내지 않는다 — 이 지면에 실릴 이름 것만 골라 넘긴다. */
  const { 표: 사람표 } = 이름표만들기(people.people ?? []);
  return 그룹들.map((g, i) => ({
    params: { group: g.slug },
    props: {
      g,
      사람문: 이지면의문((g.members ?? []).map((m: any) => m.name), 사람표),
      이웃: [그룹들[(i + 1) % 그룹들.length], 그룹들[(i + 2) % 그룹들.length]]
        .filter((x) => x && x.slug !== g.slug),
      큰곳: 그룹들.slice(0, 6).filter((x) => x.slug !== g.slug).slice(0, 4),
    },
  }));
}

const { g, 이웃, 큰곳, 사람문 } = Astro.props as { g: any; 이웃: any[]; 큰곳: any[]; 사람문: Record<string, string> };
const 기준해 = data.refYear;
const 이름못쓴 = g.membersRecorded - g.membersNamed;
const 생일모름 = g.membersNamed - g.membersWithBirthday;
const 수 = (n: number) => Number(n).toLocaleString('en-US');

/* 맏이·막내 — «생일이 있는 사람 중에서만» 말할 수 있다. 없으면 그 칸을 아예 안 그린다 */
const 생일있는 = (g.members ?? []).filter((m: any) => m.born && m.age !== null);
const 맏이 = 생일있는[0] ?? null;
const 막내 = 생일있는.length ? 생일있는[생일있는.length - 1] : null;

const 나이글 = g.oldestBornYear && g.youngestBornYear
  ? (g.oldestBornYear === g.youngestBornYear
    ? `all born in ${g.oldestBornYear}`
    : `born between ${g.oldestBornYear} and ${g.youngestBornYear}`)
  : null;

/*
 * 🔴 2026-08-25 저녁 — 벤치마킹으로 고쳤다. 사장님 지시로 1위 지면을 «열어서» 쟀다.
 * `bts members age` 1위(kpopbeen.com)와 나란히 놓아 보니 —
 * ```
 *   1위 제목   BTS Ages «2026»: How Old Are Members? (Oldest to Youngest)
 *   내 제목    BTS members age and birthday — 7 of them, and the years they were born
 * ```
 * ⭐ **제목에 «해»가 들어간다.** 사람은 「지금」을 묻고 나이는 해마다 바뀐다.
 *   나는 본문에만 「as of 2026」을 적고 제목에는 안 넣었다.
 * ⛔ 낱말을 쌓은 것이 아니다 — 이 지면의 나이는 실제로 그 해 기준이고,
 *   해를 적는 것이 «더 정직»하다. 제목만 보고도 언제 기준인지 알 수 있다.
 */
/* 🔴 2026-08-27 10:3x — 263장 가운데 제목 173장·설명 173장이 잘리고 있었다.
   ⭐ 263개 그룹 이름을 다 넣어 재고 골랐다. 위 주석의 판단(해를 제목에 적는다)은 그대로 지켰다 —
     「members age ${기준해}」가 여전히 앞쪽에 있다. 「how old are they」 한 마디만 덜었다.
   ⚠ 그룹 이름 길이가 제각각이라 «이름이 길 때만» 꼬리를 뗀다. 한 개(가장 긴 이름)만 짧은
     제목이 되고 나머지 262장은 온전하다. ⛔ 이름을 자르지는 않는다 — 이름이 곧 검색어다.
   ⛔ 「the birth dates are not」 는 본문에 0회여서 그냥 뺄 수 없었다. **본문으로 옮기고**
     설명에는 「Ages are as of ${기준해}」만 남겼다. 뜻이 뒤집히는 고지라 지울 수 없다.
   ⚠ 처음 잴 때 dist 에서 정규식으로 「born between X and Y」를 뽑고 **안 맞는 것은 기본값으로
     채웠다.** 그래서 최대 153자로 나왔는데 실제로는 179자였다 — 못 잰 것을 채운 탓이다.
     ⭐ 두 번째는 dist 를 그대로 읽어 «가장 긴 것»을 찾아 다시 쟀다. 짐작으로 채우지 않는다. */
const 제목긴것 = `${g.name} members age ${기준해}, oldest to youngest`;
const TITLE = 제목긴것.length <= 60 ? 제목긴것 : `${g.name} members age ${기준해}`;
const DESC = `${g.name} has ${g.membersWithBirthday} members with a birth date on record, `
  + `${나이글 ?? 'with birth years listed'}. Ages are as of ${기준해}. `
  + `All listed, oldest to youngest.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/group/${g.slug}`}>
  <h1>{g.name} members — age and birthday</h1>

  {/* ⭐ 답을 맨 앞에. 그리고 «기준 해»를 답과 같은 문단에 둔다 */}
  <p class="lead">
    Wikidata records <b>{g.membersRecorded}</b> {g.membersRecorded === 1 ? 'member' : 'members'} of
    {' '}<b>{g.name}</b>. <b>{g.membersWithBirthday}</b> of them have a birth date on record
    {나이글 && <>, {나이글}</>}. The ages below are <b>as of {기준해}</b>
    {/* 🔴 2026-08-27 10:4x — 이 반 문장이 여태 «설명(meta)에만» 있었다. 설명을 줄이려고
        재 보니 본문에는 「as of {기준해}」까지만 있고 「the birth dates are not」이 없었다.
        ⛔ 설명에서 뺄 말은 반드시 본문에 있어야 한다 — 그래서 여기로 옮겼다.
        ⚠ 이게 없으면 손님이 「생년월일도 2026년 기준인가」로 읽을 수 있다. 뜻이 뒤집힌다. */}
    {' '}&mdash; <b>the birth dates are not</b>.
  </p>

  {/*
    🔴 이 두 칸을 뺄 수 없다. 하나는 나이가 움직이는 수라서, 하나는 멤버 수가
      「현재 멤버」로 읽히면 틀린 수가 되기 때문이다.
  */}
  <p class="warn">
    <b>Ages move; birth dates do not.</b> This page is rebuilt only when we publish, so the ages
    are true as of {기준해}. If you are reading it later, count from the birth dates rather than
    from us.
  </p>
  <p class="warn">
    <b>These are the members Wikidata records, not the current line-up.</b> The field we read
    holds everyone recorded as part of the group, so people who have since left are included, and
    we cannot tell the two apart.
    {이름못쓴 > 0 && <> <b>{이름못쓴} of the {g.membersRecorded} {이름못쓴 === 1 ? 'is' : 'are'} counted
      but not named below</b> — their only name on Wikidata is written in Korean, and this is an
      English-language site.</>}
  </p>

  {/*
    🔴 벤치마킹으로 붙인 칸. 1위 지면은 소제목마다 «손님이 치는 다른 물음»을 받는다 —
      「누가 제일 나이가 많나」·「막내는 누구인가」·「나이순으로」.
      나는 소제목을 「우리 사정」(어디서 온 수인가)으로만 썼다.
    ⭐ 사장님 지시 「제목, 본문 중 위·가운데·마지막에 나와야」가 바로 이것이다.
    ⛔ 낱말을 쌓는 것이 아니라 **그 물음에 실제로 답을 적는다.** 답을 못 하면 안 쓴다 —
      맏이·막내는 생일이 있는 사람 중에서만 말할 수 있고, 그 한계를 같이 적는다.
  */}
  {맏이 && 막내 && 맏이.name !== 막내.name && (
    <section>
      <h2>Who is the oldest {g.name} member?</h2>
      <p>
        {/* ⚠ 여기서 「&mdash; 가 글자로 샌다」고 잠깐 판단했다가 «내가 틀렸다».
             태그를 regex 로 걷어낸 뒤 남은 것은 엔티티이고, 브라우저는 그것을 줄표로 그린다.
             지면이 아니라 «내 검사»가 틀렸다 — 오늘 아침 &#39; 때와 똑같은 자리다.
             ⭐ 뜻밖의 값이 나오면 자를 먼저 의심한다. 그래서 이 줄만 진짜 글자로 두고
               나머지 &mdash; 는 그대로 뒀다 — 멀쩡한 것을 고치지 않는다 */}
        <b>{문(맏이.name, 사람문) ? <a href={문(맏이.name, 사람문)}>{맏이.name}</a> : 맏이.name}</b>, born {맏이.bornText} {맏이.born.slice(0, 4)} —
        {' '}<b>{맏이.age}</b> in {기준해}.
        {' '}The youngest is <b>{문(막내.name, 사람문) ? <a href={문(막내.name, 사람문)}>{막내.name}</a> : 막내.name}</b>, born {막내.bornText} {막내.born.slice(0, 4)},
        {' '}<b>{막내.age}</b> in {기준해}. That is a gap of <b>{맏이.age - 막내.age}</b>
        {' '}{맏이.age - 막내.age === 1 ? 'year' : 'years'}.
      </p>
      {g.membersWithBirthday < g.membersNamed && (
        <p class="note fine">
          Oldest and youngest are read from the {g.membersWithBirthday} members whose birth date
          Wikidata records. {g.membersNamed - g.membersWithBirthday} more are named here without
          one, so they are in neither answer.
        </p>
      )}
    </section>
  )}

  <section>
    <h2>The members, oldest first</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Name</th><th>Born</th><th>Age in {기준해}</th><th>Star sign</th>
            <th>Born in</th><th>Wikipedia languages</th></tr>
        </thead>
        <tbody>
          {g.members.map((m: any) => (
            <tr>
              <td class="nm">{문(m.name, 사람문)
                ? <a href={문(m.name, 사람문)}>{m.name}</a> : m.name}</td>
              <td>{m.born ? `${m.bornText}, ${m.born.slice(0, 4)}` : '—'}</td>
              <td class="tot">{m.age ?? '—'}</td>
              <td>{m.sign ? <a href={`/star-sign/${m.sign.slug}`}>{m.sign.name}</a> : '—'}</td>
              <td>{m.birthplace ?? '—'}</td>
              <td>{m.languages ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note fine">
      A dash means we hold no figure, not a zero.
      {생일모름 > 0 && <> {생일모름} of the {g.membersNamed} named here have no birth date on
        Wikidata, so their age and star sign are blank rather than guessed.</>}
    </p>
  </section>

  <section class="warn-box">
    <h2>We are not telling you what a star sign means</h2>
    <p class="warn">
      <b>The sign column is arithmetic on a birth date and nothing else.</b> We do not say what
      any of it means, because we have not measured anything that would let us say it.
    </p>
    <p class="note">
      We did test the nearest thing to a claim. Across 1,047 Korean actors who reached a Netflix
      chart, the spread across birth-year animals was <b>indistinguishable from chance</b>.
      {' '}<a href="/star-signs">That test is here</a>, with the working shown.
      {' '}<b>Sign boundaries also move</b> by a few hours from year to year, so someone born on a
      boundary day may fall the other way in their own birth year.
    </p>
  </section>

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Wikidata</b> — group membership (P527), date of birth (P569), place of birth (P19),
        and the number of Wikipedia language editions that carry an article about each person. CC0.
      </li>
    </ul>
    <p class="note">
      <b>Wikipedia language count is not a measure of how good someone is.</b> It measures how
      widely they are written about, and it favours people who have been famous longer.
    </p>
    <p class="note">
      <b>We do not publish heights.</b> Wikidata records a height for about 3% of the Korean
      performers we hold, and a figure built on 3% would be wrong far more often than right.
    </p>
    <p class="note fine">
      We hold {data.groupsSeen} Korean groups in all. {data.groupsNotListed} of them have fewer
      than {data.minMembersToList} members we could name, and we do not publish a page for those —
      they are counted, not hidden.
    </p>
  </section>

  {/*
    🔴 벤치마킹으로 붙인 FAQ. 1위 지면에 있고 우리에겐 없었다.
    ⛔ 답을 «지어내지» 않는다. 아래 넷은 다 이 지면의 자료로 실제로 답할 수 있는 것이고,
      답할 수 없는 것(키·현재 멤버)은 «답할 수 없다고» 적는 것이 답이다.
  */}
  <section class="notes">
    <h2>Questions people ask about {g.name} members</h2>
    <h3>How many members does {g.name} have?</h3>
    <p>
      Wikidata records <b>{g.membersRecorded}</b>.
      {이름못쓴 > 0 && <> {g.membersNamed} of them are named here; the other {이름못쓴} have no
        English name on Wikidata, so we count them without naming them.</>}
      {' '}<b>This is not the current line-up</b> — the field holds everyone recorded as part of
      the group, including people who have left.
    </p>
    {맏이 && <>
      <h3>What year were {g.name} members born?</h3>
      <p>
        {나이글 ? <>They were {나이글}.</> : <>Birth years vary.</>}
        {' '}The full list of dates is in the table above. <b>Birth dates do not move; ages do</b> —
        the ages here are as of {기준해}.
      </p>
    </>}
    <h3>How tall are {g.name} members?</h3>
    <p>
      <b>We cannot tell you.</b> Wikidata records a height for about 3% of the Korean performers
      we hold. We would rather say we do not know than publish a figure that would be wrong far
      more often than right.
    </p>
    <h3>Where does this come from?</h3>
    <p>
      Wikidata, read by item number: group membership (P527), date of birth (P569), place of
      birth (P19). CC0. Nothing here is copied from a fan wiki or a news write-up.
    </p>
  </section>

  <section class="onward">
    <h3>Other groups</h3>
    <ul>
      {[...이웃, ...큰곳].slice(0, 5).map((x) => (
        <li><a href={`/group/${x.slug}`}>{x.name} members</a>
          <span class="fine"> &mdash; {수(x.membersNamed)}</span></li>
      ))}
    </ul>
    <h3>Other ways into the same people</h3>
    <ul class="walk">
      <li><a href="/born-on">Korean actors&rsquo; birthdays &mdash; all 366 days</a></li>
      <li><a href="/actors-in-their/20s">Korean actors by age</a></li>
      <li><a href="/hometowns">Where Korea&rsquo;s most-read stars were born</a></li>
      <li><a href="/school">Where Korean actors and singers studied</a></li>
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: .5rem 1rem; margin: 0 0 1.6rem; }
</style>
