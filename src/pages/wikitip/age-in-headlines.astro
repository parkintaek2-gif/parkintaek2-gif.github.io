---
/**
 * K Culture Wire — **한국 지면이 제목에 나이를 박는 관행을 센다.** (`/age-in-headlines`)
 *
 * ── 왜 이 지면이 있나 (2026-09-11 · 5번) ────────────────────────
 * 오늘 우리가 받은 제목에 이런 것들이 있었다 —
 *   「'82세' 김도향」 · 「'32세' 한소희」 · 「'39세' 한지은 맞아?」
 * 영어권 지면은 이렇게 안 쓴다. 그런데 **아무도 이것을 센 적이 없다.**
 * ⭐ 우리는 한국 네 매체의 첫 화면 제목을 매일 받아 쌓는다 — 그것이 우리 축이다.
 *
 * ⛔ 「관행이 이상하다」고 말하는 지면이 아니다. 세면 답이 나오는 물음에만 답한다 —
 *   얼마나 자주 · 어느 매체가 · 어느 나이대에.
 * ⛔ 성별을 재지 않는다. 이름으로 짐작하면 그것은 변수를 지어내 결론으로 박는 것이다.
 * ⛔ 나이가 맞는지도 재지 않았다 — 생년을 안 받았다. 지면에 그대로 적는다.
 * ⚠ 열흘치는 열흘치다. 「한국 언론은 늘 이렇다」로 넓히지 않는다.
 * ⛔ 화면에 우리말을 쓰지 않는다(check-english-only.mjs). 매체 이름도 영문 제호로 낸다 —
 *   처음에 카드에 한국어를 그대로 냈고, 카드를 «눈으로 보고» 잡았다.
 * ⚠ 수는 하나도 손으로 안 적는다 — src/data/kcw-age-in-headline.json 에서 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import d from '../../data/kcw-age-in-headline.json';
/* [2026-09-11 05:2x] 같은 1,365편을 «돈»으로 다시 센 것을 이 축 지면에 붙인다.
   ⭐ 사장님 지시대로 이슈는 «축 지면 하나»에 묶는다 — 새 지면을 늘리지 않는다.
   ⛔ 이 자료의 수도 손으로 안 적는다. */
import 돈자료 from '../../data/kcw-money-vs-age-in-headline.json';
/* [2026-09-11 06:0x] 셋째 축 — 제목에 섞인 로마자. 영어권 손님이 «읽을 수 있는» 조각이다. */
import 로마자료 from '../../data/kcw-latin-in-headline.json';

const TITLE = 'What a Korean front page puts in a headline: age, money and Latin letters, counted';
const DESC =
  'Korean desks open stories with the subject’s age in quote marks, print won amounts, and mix Latin '
  + 'letters into Korean type — and each habit belongs to a different desk. We read ten days of front '
  + 'pages from four Korean outlets and counted all three, desk by desk, with what we could not measure '
  + 'written down beside each figure.';

/** 매체 영문 제호 — ⛔ 지어내지 않는다. 넷 다 그 매체가 스스로 쓰는 영문 이름이다 */
const 영문제호: Record<string, string> = {
  '텐아시아': 'TenAsia', '스타뉴스': 'Star News',
  '매일경제': 'Maeil Business', '동아일보': 'Dong-A Ilbo',
};
/** 갈래도 영문으로. 모르는 것은 그대로 둔다 — 로마자로 지어내지 않는다 */
const 영문갈래: Record<string, string> = {
  'K컬처': 'K-culture', '경제·사회·증권': 'business', '나머지': 'general',
};
const 영문 = (표: Record<string, string>, 이름: unknown) => 표[String(이름 ?? '')] || String(이름 ?? '');

type 매체 = { 매체: string; 갈래: string | null; 제목수: number; 따옴표붙은제목: number; 맨앞: number; 비율: number | null };
const 매체별 = ((d as any).매체별 || []) as 매체[];
const 나이대 = Object.entries(((d as any).나이대 || {}) as Record<string, number>)
  .map(([대, 수]) => ({ 대: Number(대), 수: Number(수) }))
  .sort((a, b) => a.대 - b.대);
const 나이합 = 나이대.reduce((a, x) => a + x.수, 0);
const 제목수 = Number((d as any).제목수) || 0;
const 날수 = Number((d as any).날수) || 0;
const 날들 = ((d as any).날들 || []) as string[];
const 날꼴 = (s: string) => (s && s.length === 8 ? `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}` : s);

const 으뜸 = 매체별.length ? 매체별[0] : null;
const 영인곳 = 매체별.filter((x) => x.따옴표붙은제목 === 0);
const 영제목수 = 영인곳.reduce((a, x) => a + x.제목수, 0);
const 가장많은대 = 나이대.length ? 나이대.reduce((a, b) => (b.수 > a.수 ? b : a)) : null;
/** 빈 나이대 — 「없다」를 화면에 적기 위해 «있는 것»에서 뒤집어 낸다 */
const 빈대 = [10, 20, 30, 40, 50, 60, 70, 80, 90]
  .filter((대) => !나이대.some((x) => x.대 === 대 && x.수 > 0));

/* ── 돈 축 ─────────────────────────────────────────────────────────
   ⚠ 「돈」은 «아래쪽» 값이다 — 「10억 배상」처럼 원을 뺀 제목이 따로 있어 폭으로 낸다.
   그 안에는 「10억 뷰」도 섞이므로 올려 세지 않는다. */
type 돈매체 = {
  매체: string; 갈래: string | null; 제목수: number; 돈: number; 단위만: number;
  나이: number; 둘다: number; 돈몫: number; 돈위쪽몫: number; 나이몫: number;
};
const 돈매체들 = (((돈자료 as any).매체들 || []) as 돈매체[])
  .slice().sort((a, b) => b.제목수 - a.제목수);
const 몫꼴 = (v: unknown) => (Number.isFinite(Number(v)) ? `${(Number(v) * 100).toFixed(1)}%` : '—');
const 둘다합 = Number((돈자료 as any).둘다합);
const 돈제목합 = Number((돈자료 as any).제목합) || 0;
const 돈으뜸 = 돈매체들.length ? 돈매체들.slice().sort((a, b) => b.돈몫 - a.돈몫)[0] : null;

/* ── 로마자 축 ─────────────────────────────────────────────────────
   ⚠ 두 글자부터가 낱말이다 — 「A형」·「S급」은 등급 표시라 안 센다.
   ⚠ 매체가 «자기 약칭»을 박는다(MK 31개). 빼고 센 값을 함께 낸다. */
type 로마매체 = {
  매체: string; 갈래: string | null; 제목수: number; 로마자든제목: number; 몫: number | null;
  제몸뺀제목: number; 제몸뺀몫: number | null; 제몸조각: number; 조각수: number;
  꼴: { 다대문자: number; 첫대문자: number; 다소문자: number; 섞임: number };
  으뜸낱말: { 낱말: string; 수: number }[];
};
const 로마매체들 = (((로마자료 as any).매체들 || []) as 로마매체[])
  .slice().sort((a, b) => (b.몫 ?? -1) - (a.몫 ?? -1));
const 으뜸낱말전체 = (((로마자료 as any).으뜸낱말전체 || []) as { 낱말: string; 수: number }[]).slice(0, 8);
const 로마제목합 = Number((로마자료 as any).제목합) || 0;
const 로마낱개합 = Number((로마자료 as any).낱개제목합) || 0;
const 로마든합 = Number((로마자료 as any).로마자든제목합) || 0;

const datasetLd = {
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: 'Ages quoted in Korean entertainment headlines',
  description: DESC,
  url: 'https://www.kculturewire.com/age-in-headlines',
  keywords: ['Korean media', 'headlines', 'age', 'entertainment press', 'TenAsia', 'Star News',
    'house style', 'content analysis'],
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isAccessibleForFree: true,
  measurementTechnique:
    'Daily capture of front-page headlines from four Korean outlets. A headline counts when an age '
    + 'appears inside quotation marks or brackets, the form the desks use. Bare ages in running text are '
    + 'counted separately and excluded. Sex is not inferred and printed ages are not verified.',
  spatialCoverage: { '@type': 'Place', name: 'Republic of Korea' },
  temporalCoverage: 날들.length ? `${날꼴(날들[0])}/${날꼴(날들[날들.length - 1])}` : undefined,
  variableMeasured: ['headlines per outlet', 'headlines with a quoted age', 'rate', 'age bracket'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={[datasetLd]} page="/age-in-headlines">
  <article class="wrap">
    <p class="kicker">K Culture Wire · industry</p>
    {/* 🔴 [2026-09-11 06:0x] 머리글을 넓혔다 — 이 지면이 하루 만에 «세 축»을 담게 됐다
        (나이 · 돈 · 로마자). 「Your age, in quotation marks」로 두면 지면과 머리글이
        어긋나고, 그것은 검색에도 손님에게도 손해다. ⛔ 주소는 그대로 둔다(캐노니컬·사이트맵). */}
    <h1>What a Korean front page puts in a headline</h1>
    <p class="asof">
      {날수} days of front pages · {제목수.toLocaleString('en-US')} headline-days · four Korean outlets
      {날들.length > 0 && <> · {날꼴(날들[0])} to {날꼴(날들[날들.length - 1])}</>}
    </p>

    <p class="lead">
      Korean entertainment desks tell you how old someone is before they tell you anything else, and
      they put the number in quote marks. English-language desks do not write this way. So we counted
      how common it actually is — and the answer is narrower than <i>Korean media</i>.
      {으뜸 && 으뜸.비율 != null && (
        <> One desk did it in <b>{으뜸.비율.toFixed(1)}%</b> of its headlines. The general and business
        papers did it <b>zero times in {영제목수.toLocaleString('en-US')}</b>.</>
      )}
    </p>

    {매체별.length > 0 && (
      <>
        <h2>It is one desk, not a country</h2>
        <div class="scroll-x">
        <table class="tbl">
          <thead>
            <tr>
              <th>Outlet</th><th>Beat</th>
              <th class="n">Headlines</th><th class="n">With a quoted age</th>
              <th class="n">Rate</th><th class="n">Age in first position</th>
            </tr>
          </thead>
          <tbody>
            {매체별.map((x) => (
              <tr>
                <td class="k">{영문(영문제호, x.매체)}</td>
                <td class="u">{영문(영문갈래, x.갈래)}</td>
                <td class="n">{x.제목수.toLocaleString('en-US')}</td>
                <td class="n">{x.따옴표붙은제목}</td>
                <td class="n"><b>{x.비율 == null ? '—' : x.비율.toFixed(1) + '%'}</b></td>
                <td class="n">{x.맨앞}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <p class="note">
          Two of these desks cover the same beat on the same days. Every rate is printed beside the
          count it came from, because the headline totals differ by a factor of nine.
        </p>
      </>
    )}

    {나이대.length > 0 && (
      <>
        <h2>Which ages get announced</h2>
        <div class="scroll-x">
        <table class="tbl narrow">
          <thead><tr><th>Age bracket</th><th class="n">Times</th><th>Share</th></tr></thead>
          <tbody>
            {나이대.map((x) => (
              <tr>
                <td class="k">{x.대}s</td>
                <td class="n">{x.수}</td>
                <td class="bar"><span style={`width:${Math.round(x.수 / Math.max(1, 나이합) * 100)}%`}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <p class="note">
          {나이합} quoted ages across {날수} days.
          {가장많은대 && <> The heaviest bracket is the <b>{가장많은대.대}s</b>.</>}
          {빈대.length > 0 && (
            <> Nobody in their {빈대.map((대, i) => (
              <>{i > 0 ? (i === 빈대.length - 1 ? ' or ' : ', ') : ''}{대}s</>
            ))} had an age quoted in these days — with {나이합} cases that is a gap to watch,{' '}
            <b> not yet a pattern</b>.</>
          )}
        </p>
      </>
    )}

    <h2>What this count does not do</h2>
    <ul class="honest">
      <li>
        It does not measure <b>sex</b>. Guessing it from a name would be inventing a variable and
        printing it as a finding. The practice may well fall unevenly by sex — this count cannot say.
      </li>
      <li>
        It does not check whether the printed ages are <b>right</b>. That needs recorded birth years,
        and reading those is a separate job from reading headlines.
      </li>
      <li>
        It counts only an age the desk put <b>inside quote marks or brackets</b>. A bare age in running
        text is a different thing and is counted separately.
      </li>
      <li>
        {날수} days is {날수} days. {나이합} quoted ages is a <b>small sample</b>, and the brackets above
        are a first look rather than a distribution.
      </li>
    </ul>

    <h2>The other number in the headline: money</h2>
    <p class="lead">
      Reading the same file again, a second habit was hard to miss — the money. So we counted headlines
      carrying a number followed by the character for won, on exactly the same{' '}
      {돈제목합.toLocaleString('en-US')} headlines. The two habits turn out to be complementary rather
      than two versions of the same thing: the desk that leads with ages almost never leads with money,
      the desks that lead with money never lead with ages, and{' '}
      <b>{둘다합} headlines carried both</b>.
    </p>

    <div class="scroll-x">
      <table class="tbl">
        <thead>
          {/* ⚠ 390px 에서 찍어 보고 칸 순서를 바꿨다 — 「Headlines」를 앞에 두었더니
              폰에서 손님이 보는 첫 화면에 «답이 아닌 칸»만 보였다. 답을 앞으로 낸다.
              ⛔ 그래도 셈을 빼지 않는다 — 비율만 있는 줄을 만들지 않는다 */}
          <tr>
            <th>Outlet</th>
            <th class="n">Money</th>
            <th class="n">Age</th>
            <th class="n">Both</th>
            <th class="n">Headlines</th>
          </tr>
        </thead>
        <tbody>
          {돈매체들.map((x) => (
            <tr>
              <td class="k">
                {영문(영문제호, x.매체)}
                <span class="u"> · {영문(영문갈래, x.갈래)}</span>
              </td>
              <td class="n">{몫꼴(x.돈몫)}</td>
              <td class="n">{몫꼴(x.나이몫)}</td>
              <td class="n">{x.둘다}</td>
              <td class="n">{x.제목수.toLocaleString('en-US')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      A business paper quoting money is not a finding on its own.{' '}
      {돈으뜸 ? `${영문(영문제호, 돈으뜸.매체)} leads at ${몫꼴(돈으뜸.돈몫)} and prints no ages at all.` : ''}{' '}
      What the pairing shows is that these are two different tools, held by different desks, and the{' '}
      <b>Both</b> column is zero on every row.
    </p>

    <h2>The money figure is a floor, and here is the band</h2>
    <div class="scroll-x">
      <table class="tbl">
        <thead>
          <tr>
            <th>Outlet</th>
            <th class="n">Band</th>
            <th class="n">Won stated</th>
            <th class="n">Unit only</th>
          </tr>
        </thead>
        <tbody>
          {돈매체들.map((x) => (
            <tr>
              <td class="k">{영문(영문제호, x.매체)}</td>
              <td class="n">{몫꼴(x.돈몫)}–{몫꼴(x.돈위쪽몫)}</td>
              <td class="n">{x.돈} ({몫꼴(x.돈몫)})</td>
              <td class="n">{x.단위만}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Korean headlines drop the word for won constantly. A headline reading <i>10-eok damages</i> is one
      billion won to any Korean reader — <i>eok</i> being the unit for a hundred million — and our
      pattern does not count it, because the same pattern also catches <i>10-eok views</i>.{' '}
      <b>Unit only</b> counts headlines carrying a large-number unit with no won after it, so the low
      end of the band counts only what is unambiguously money and the high end assumes every bare unit
      is money — which it is not. The true figure sits between, and the ordering of the four desks is
      the same at both ends, which is the part the argument above rests on.
    </p>

    <h2>The third habit: the letters an English reader can actually read</h2>
    <p class="lead">
      A reader who cannot read Korean can still read the Latin script in a Korean headline — the
      brand, the acronym, the unit. Counted on the same file, {로마든합} of{' '}
      {로마제목합.toLocaleString('en-US')} headline-days carry at least one Latin word of two or more
      letters, and the habit is again unevenly held.
    </p>

    <div class="scroll-x">
      <table class="tbl">
        <thead>
          <tr>
            <th>Outlet</th>
            <th class="n">With Latin</th>
            <th class="n">Minus its own initials</th>
            <th class="n">ALL CAPS</th>
            <th class="n">Headline-days</th>
          </tr>
        </thead>
        <tbody>
          {로마매체들.map((x) => (
            <tr>
              <td class="k">
                {영문(영문제호, x.매체)}
                <span class="u"> · {영문(영문갈래, x.갈래)}</span>
              </td>
              <td class="n">{몫꼴(x.몫)}</td>
              <td class="n">{몫꼴(x.제몸뺀몫)}</td>
              <td class="n">{x.꼴.다대문자}</td>
              <td class="n">{x.제목수.toLocaleString('en-US')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      The second column exists because a paper prints <b>its own name</b> in its own headlines — MK is
      Maeil Business's abbreviation and is that desk's most frequent Latin word. Taking each outlet's
      initials out of its own count lowers every rate and changes no part of the order. The ALL CAPS
      column is a count of words, not headlines: the business desk's Latin is almost entirely
      capitals (the vocabulary of a market report), while the entertainment desks are the ones with
      lower-case and mixed-case words — and their frequent words are brands.
    </p>

    <div class="scroll-x">
      <table class="tbl narrow">
        <thead>
          <tr><th>Latin word</th><th class="n">Times</th></tr>
        </thead>
        <tbody>
          {으뜸낱말전체.map((x) => (
            <tr>
              <td class="k">{x.낱말}</td>
              <td class="n">{x.수}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Read the unit before the ranking: this whole page counts <b>headline-days</b>, so a headline
      still on the page tomorrow is counted again. The {로마제목합.toLocaleString('en-US')}{' '}
      headline-days contain {로마낱개합.toLocaleString('en-US')} distinct headlines. We print both
      rather than pick one, and the word counts are the more repeat-sensitive of the two — one Star
      News headline carrying 'FACE OF GUCCI' held its place five days running and is 15 of that
      desk's 97 Latin words. The full write-up is at{' '}
      <a href="/article/the-only-part-of-a-korean-headline-an-english-reader-can-read">
        the letters an English reader can read
      </a>.
    </p>

    <KcwShorts
      set="each-korean-desk-has-one-number-and-they-never-mix-voiced"
