---
/**
 * K Culture Wire — **한국 지면이 제목에 나이를 박는 관행을 센다.** (`/age-in-headlines`)
 *
 * ── 왜 이 지면이 있나 (2026-09-11 · 5번) ────────────────────────
 * 오늘 우리가 받은 제목에 이런 것들이 있었다 —
 *   「'82세' 김도향」 · 「'32세' 한소희」 · 「'39세' 한지은 맞아?」
 * 영어권 지면은 이렇게 안 쓴다. 그런데 **아무도 이것을 센 적이 없다.**
 * ⭐ 우리는 한국 네 매체의 첫 화면 제목을 매일 받아 쌓는다 — 그것이 우리 축이다.
 *
 * ⛔ 「관행이 이상하다」고 말하는 지면이 아니다. 세면 답이 나오는 물음에만 답한다 —
 *   얼마나 자주 · 어느 매체가 · 어느 나이대에.
 * ⛔ 성별을 재지 않는다. 이름으로 짐작하면 그것은 변수를 지어내 결론으로 박는 것이다.
 * ⛔ 나이가 맞는지도 재지 않았다 — 생년을 안 받았다. 지면에 그대로 적는다.
 * ⚠ 열흘치는 열흘치다. 「한국 언론은 늘 이렇다」로 넓히지 않는다.
 * ⛔ 화면에 우리말을 쓰지 않는다(check-english-only.mjs). 매체 이름도 영문 제호로 낸다 —
 *   처음에 카드에 한국어를 그대로 냈고, 카드를 «눈으로 보고» 잡았다.
 * ⚠ 수는 하나도 손으로 안 적는다 — src/data/kcw-age-in-headline.json 에서 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import d from '../../data/kcw-age-in-headline.json';

const TITLE = 'Korean entertainment headlines put your age in quotation marks — we counted';
const DESC =
  'Korean entertainment desks open stories with the subject’s age in quote marks, before the name. '
  + 'We read ten days of front pages from four Korean outlets, 1,365 headlines, and counted. One desk '
  + 'does it in 27 percent of its headlines. The general and business papers do it in none.';

/** 매체 영문 제호 — ⛔ 지어내지 않는다. 넷 다 그 매체가 스스로 쓰는 영문 이름이다 */
const 영문제호: Record<string, string> = {
  '텐아시아': 'TenAsia', '스타뉴스': 'Star News',
  '매일경제': 'Maeil Business', '동아일보': 'Dong-A Ilbo',
};
/** 갈래도 영문으로. 모르는 것은 그대로 둔다 — 로마자로 지어내지 않는다 */
const 영문갈래: Record<string, string> = {
  'K컬처': 'K-culture', '경제·사회·증권': 'business', '나머지': 'general',
};
const 영문 = (표: Record<string, string>, 이름: unknown) => 표[String(이름 ?? '')] || String(이름 ?? '');

type 매체 = { 매체: string; 갈래: string | null; 제목수: number; 따옴표붙은제목: number; 맨앞: number; 비율: number | null };
const 매체별 = ((d as any).매체별 || []) as 매체[];
const 나이대 = Object.entries(((d as any).나이대 || {}) as Record<string, number>)
  .map(([대, 수]) => ({ 대: Number(대), 수: Number(수) }))
  .sort((a, b) => a.대 - b.대);
const 나이합 = 나이대.reduce((a, x) => a + x.수, 0);
const 제목수 = Number((d as any).제목수) || 0;
const 날수 = Number((d as any).날수) || 0;
const 날들 = ((d as any).날들 || []) as string[];
const 날꼴 = (s: string) => (s && s.length === 8 ? `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}` : s);

const 으뜸 = 매체별.length ? 매체별[0] : null;
const 영인곳 = 매체별.filter((x) => x.따옴표붙은제목 === 0);
const 영제목수 = 영인곳.reduce((a, x) => a + x.제목수, 0);
const 가장많은대 = 나이대.length ? 나이대.reduce((a, b) => (b.수 > a.수 ? b : a)) : null;
/** 빈 나이대 — 「없다」를 화면에 적기 위해 «있는 것»에서 뒤집어 낸다 */
const 빈대 = [10, 20, 30, 40, 50, 60, 70, 80, 90]
  .filter((대) => !나이대.some((x) => x.대 === 대 && x.수 > 0));

const datasetLd = {
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: 'Ages quoted in Korean entertainment headlines',
  description: DESC,
  url: 'https://www.kculturewire.com/age-in-headlines',
  keywords: ['Korean media', 'headlines', 'age', 'entertainment press', 'TenAsia', 'Star News',
    'house style', 'content analysis'],
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isAccessibleForFree: true,
  measurementTechnique:
    'Daily capture of front-page headlines from four Korean outlets. A headline counts when an age '
    + 'appears inside quotation marks or brackets, the form the desks use. Bare ages in running text are '
    + 'counted separately and excluded. Sex is not inferred and printed ages are not verified.',
  spatialCoverage: { '@type': 'Place', name: 'Republic of Korea' },
  temporalCoverage: 날들.length ? `${날꼴(날들[0])}/${날꼴(날들[날들.length - 1])}` : undefined,
  variableMeasured: ['headlines per outlet', 'headlines with a quoted age', 'rate', 'age bracket'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={[datasetLd]} page="/age-in-headlines">
  <article class="wrap">
    <p class="kicker">K Culture Wire · industry</p>
    <h1>Your age, in quotation marks, before your name</h1>
    <p class="asof">
      {날수} days of front pages · {제목수.toLocaleString('en-US')} headlines · four Korean outlets
      {날들.length > 0 && <> · {날꼴(날들[0])} to {날꼴(날들[날들.length - 1])}</>}
    </p>

    <p class="lead">
      Korean entertainment desks tell you how old someone is before they tell you anything else, and
      they put the number in quote marks. English-language desks do not write this way. So we counted
      how common it actually is — and the answer is narrower than <i>Korean media</i>.
      {으뜸 && 으뜸.비율 != null && (
        <> One desk did it in <b>{으뜸.비율.toFixed(1)}%</b> of its headlines. The general and business
        papers did it <b>zero times in {영제목수.toLocaleString('en-US')}</b>.</>
      )}
    </p>

    {매체별.length > 0 && (
      <>
        <h2>It is one desk, not a country</h2>
        <div class="scroll-x">
        <table class="tbl">
          <thead>
            <tr>
              <th>Outlet</th><th>Beat</th>
              <th class="n">Headlines</th><th class="n">With a quoted age</th>
              <th class="n">Rate</th><th class="n">Age in first position</th>
            </tr>
          </thead>
          <tbody>
            {매체별.map((x) => (
              <tr>
                <td class="k">{영문(영문제호, x.매체)}</td>
                <td class="u">{영문(영문갈래, x.갈래)}</td>
                <td class="n">{x.제목수.toLocaleString('en-US')}</td>
                <td class="n">{x.따옴표붙은제목}</td>
                <td class="n"><b>{x.비율 == null ? '—' : x.비율.toFixed(1) + '%'}</b></td>
                <td class="n">{x.맨앞}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <p class="note">
          Two of these desks cover the same beat on the same days. Every rate is printed beside the
          count it came from, because the headline totals differ by a factor of nine.
        </p>
      </>
    )}

    {나이대.length > 0 && (
      <>
        <h2>Which ages get announced</h2>
        <div class="scroll-x">
        <table class="tbl">
          <thead><tr><th>Age bracket</th><th class="n">Times</th><th>Share</th></tr></thead>
          <tbody>
            {나이대.map((x) => (
              <tr>
                <td class="k">{x.대}s</td>
                <td class="n">{x.수}</td>
                <td class="bar"><span style={`width:${Math.round(x.수 / Math.max(1, 나이합) * 100)}%`}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <p class="note">
          {나이합} quoted ages across {날수} days.
          {가장많은대 && <> The heaviest bracket is the <b>{가장많은대.대}s</b>.</>}
          {빈대.length > 0 && (
            <> Nobody in their {빈대.map((대, i) => (
              <>{i > 0 ? (i === 빈대.length - 1 ? ' or ' : ', ') : ''}{대}s</>
            ))} had an age quoted in these days — with {나이합} cases that is a gap to watch,{' '}
            <b> not yet a pattern</b>.</>
          )}
        </p>
      </>
    )}

    <h2>What this count does not do</h2>
    <ul class="honest">
      <li>
        It does not measure <b>sex</b>. Guessing it from a name would be inventing a variable and
        printing it as a finding. The practice may well fall unevenly by sex — this count cannot say.
      </li>
      <li>
        It does not check whether the printed ages are <b>right</b>. That needs recorded birth years,
        and reading those is a separate job from reading headlines.
      </li>
      <li>
        It counts only an age the desk put <b>inside quote marks or brackets</b>. A bare age in running
        text is a different thing and is counted separately.
      </li>
      <li>
        {날수} days is {날수} days. {나이합} quoted ages is a <b>small sample</b>, and the brackets above
        are a first look rather than a distribution.
      </li>
    </ul>

    <KcwShorts
      set="the-age-in-the-headline-is-one-desk-not-a-country-voiced"
      says="Seventeen seconds: one entertainment desk opened 27.4% of its headlines with an age in quote marks; the other desk on the same beat did it in 2.8%, and the business and general papers did it zero times in 1,080."
    />
    <KcwCardnews set="agehead" count={4} />
    <KcwRelatedArticles page="/age-in-headlines" />
  </article>
</WikiTip>

<style>
  .wrap { max-width: 820px; margin: 0 auto; padding: 26px 18px 70px; }
  .kicker { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; opacity: .62; margin: 0 0 6px; }
  h1 { font-size: 30px; line-height: 1.24; margin: 0 0 8px; }
  h2 { font-size: 20px; margin: 34px 0 10px; }
  .asof { font-size: 13px; opacity: .66; margin: 0 0 18px; }
  .lead { font-size: 16.5px; line-height: 1.7; margin: 0 0 20px; }
  /* ⚠ 390px 로 띄워 보고 넣었다 — 여섯 칸 표가 몸통을 옆으로 굴렸다(448 > 390).
     넓은 것은 «자기 그릇 안에서» 구른다. 몸통은 절대 옆으로 구르지 않는다. */
  .scroll-x { overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; }
  .scroll-x .tbl { min-width: 560px; }
  .tbl { border-collapse: collapse; width: 100%; font-size: 15px; margin: 10px 0 12px; }
  .tbl th, .tbl td { border-bottom: 1px solid currentColor; border-color: color-mix(in srgb, currentColor 14%, transparent); padding: 9px 10px; text-align: left; }
  .tbl th { font-size: 12.5px; letter-spacing: .04em; text-transform: uppercase; opacity: .62; }
  .tbl .n { text-align: right; font-variant-numeric: tabular-nums; }
  .tbl .k { font-weight: 600; }
  .tbl .u { opacity: .72; font-size: 14px; }
  .tbl .bar { width: 34%; }
  .tbl .bar span { display: block; height: 9px; border-radius: 5px; background: currentColor; opacity: .5; }
  .note { font-size: 13.5px; line-height: 1.66; opacity: .78; margin: 6px 0 0; }
  .honest { font-size: 14.5px; line-height: 1.7; margin: 8px 0 0 18px; }
  .honest li { margin: 8px 0; }
  @media (max-width: 560px) {
    h1 { font-size: 24px; }
    .tbl { font-size: 13.5px; }
    .tbl th, .tbl td { padding: 7px 6px; }
    .tbl .bar { width: 24%; }
  }
</style>
