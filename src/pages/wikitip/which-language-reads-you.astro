---
/**
 * K Culture Wire — **어느 «말»로 읽히는가.** (`/which-language-reads-you`)
 *
 * 🔴 오늘 밤 포털 연예면 머리 — 「임영웅 10주년, 고양종합운동장 사흘 약 9만 5천 명」.
 *   우리 손님은 영어권이다. 그래서 묻는다 —
 *   **「국내 스타디움을 사흘 채우는 사람이 영어권에서는 몇 명에게 읽히는가.」**
 *
 * ⭐ 답: 하루 91명이다. BTS 지민은 2,091명이다. 그리고 지민을 «한국어로» 읽는 사람은 61명뿐이다.
 *   ⇒ 두 갈래가 서로 **반대 방향**으로 서 있다. 그것이 이 지면이다.
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 「누가 더 유명한가」를 말하지 않는다. 재는 것은 «어느 말로 읽히나» 하나다.
 * ⛔ 두 수를 더하지 않는다 — 한 사람이 두 문서를 다 열 수 있어 전체를 이루지 않는다.
 * ⛔ 관객 수를 우리 수처럼 쓰지 않는다. 온 «까닭»이지 증거가 아니다.
 * ⛔ 여섯 사람을 「업계가 이렇다」로 부풀리지 않는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-korea-vs-english.json';

type 줄 = {
  label: string; kind: string; enTitle: string; koTitle: string;
  enReads: number; koReads: number; times: number | null; timesEnglish: number | null;
};

const 모두 = (d.rows as any[]) as 줄[];
const 트로트 = 모두.filter((r) => r.kind === 'Trot');
const 그밖 = 모두.filter((r) => r.kind !== 'Trot');
const 임영웅 = 모두.find((r) => r.label === 'Lim Young-woong');
const 영어많은순 = [...그밖].sort((a, b) => b.enReads - a.enReads);
const 으뜸 = 영어많은순[0];

/* 🔴 제목·본문이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (!임영웅) throw new Error('임영웅 줄을 자료에서 못 찾았다 — 이 지면은 그 사람에서 시작한다.');
if (트로트.length !== 3 || 그밖.length !== 3) {
  throw new Error(`트로트 셋·그 밖 셋이어야 하는데 ${트로트.length}·${그밖.length} 다.`);
}
if (!트로트.every((r) => (r.times ?? 0) > 1)) throw new Error('트로트 셋이 다 한국어 우세여야 이 지면의 말이 선다.');
if (!그밖.every((r) => (r.times ?? 1) < 1)) throw new Error('그 밖 셋이 다 영어 우세여야 이 지면의 말이 선다.');

const 쉼표 = (n: number) => Number(n).toLocaleString('en-US');
/**
 * 🔴 [2026-09-05 · 사장님] 「**이른바 아이돌 그룹, 배우들만 관심있겠지, 영어권에서는.
 *   트롯에 관심있겠나?**」
 *
 * 처음 제목은 임영웅으로 시작했다. 발견은 같아도 **영어권 독자가 안 찾는 이름을 앞에 세우면
 * 그 지면은 안 읽힌다.** 우리 손님은 영어권이고, 그들이 치는 말은 아이돌·배우 이름이다.
 * ⭐ 그래서 앞에 세우는 이름을 바꿨다. 트로트는 «대조»로 뒤에 둔다 — 발견은 그대로다.
 * ⛔ 수를 바꾼 것이 아니다. 같은 표를 «독자가 찾는 쪽»에서 읽은 것이다.
 */
const TITLE = `${으뜸.label} is read ${으뜸.timesEnglish}x more in English than in Korean. Korea's stadium acts are the reverse`;
const DESC =
  `We counted daily Wikipedia reads in Korean and in English for the same six Korean singers. `
  + `${으뜸.label} draws ${쉼표(으뜸.enReads)} English readers a day against ${쉼표(으뜸.koReads)} Korean ones. `
  + `Lim Young-woong, who filled a stadium for three nights this weekend, draws ${쉼표(임영웅.enReads)} in `
  + 'English and more than that in Korean. Which language you count in decides who looks big.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/'],
  variableMeasured: ['daily Korean Wikipedia pageviews', 'daily English Wikipedia pageviews'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/which-language-reads-you">
  <h1>{TITLE}</h1>

  <p class="lead">
    The Korean singers English readers look up are not the ones who fill stadiums in Korea. We can put
    a number on that gap, because Wikipedia counts each language separately.
  </p>

  <p class="walk">
    <b>Next:</b>{' '}
    <a href="/most-read">The most-read Korean stars</a> &middot;{' '}
    <a href="/cannot-see">Who our numbers cannot see</a> &middot;{' '}
    <a href="/member-vs-group">Soloists against their groups</a>
  </p>

  <div class="scroll-x">
    <table>
      <caption>Median daily Wikipedia reads over the last 30 days, same person, two languages</caption>
      <thead>
        <tr>
          <th>Singer</th>
          <th>Kind</th>
          <th>Korean</th>
          <th>English</th>
          <th>Which language wins</th>
        </tr>
      </thead>
      <tbody>
        {모두.map((r) => (
          <tr class={r.kind === 'Trot' ? 'ko' : 'en'}>
            <th scope="row">{r.label}</th>
            <td>{r.kind}</td>
            <td>{쉼표(r.koReads)}</td>
            <td>{쉼표(r.enReads)}</td>
            <td>
              {(r.times ?? 0) > 1
                ? `Korean, by ${r.times}x`
                : `English, by ${r.timesEnglish}x`}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="q">
    <b>Do not add the two columns.</b> One reader can open both pages, so there is no single audience
    here to take a share of. The two counts sit side by side and that is all.
  </p>

  <h2>The two kinds point in opposite directions</h2>

  <p class="q">
    <b>Median of each group:</b> the trot singers are read {d.trotMedianTimes}&times; more in Korean
    than in English; the other three are read {Math.round((1 / (d.otherMedianTimes || 1)) * 10) / 10}&times;
    more in English than in Korean. <b>The two groups do not overlap at all</b> &mdash; every trot
    singer is above 1 and every other act is below it.
  </p>

  <p>
    All three trot singers are read more in Korean than in English &mdash; {트로트.map((r) => `${r.label} ${r.times}x`).join(', ')}.
    All three of the others are read more in English, and not narrowly:
    {' '}{그밖.map((r) => `${r.label} ${r.timesEnglish}x`).join(', ')}.
  </p>

  <p>
    <b>{으뜸.label} is opened {쉼표(으뜸.enReads)} times a day in English and {쉼표(으뜸.koReads)} times
    in Korean.</b> The same encyclopedia, the same person, a {으뜸.timesEnglish}-fold difference
    depending on which edition you look at.
  </p>

  <h2>The other direction: a stadium act almost nobody reads in English</h2>

  <p>
    Lim Young-woong sold out a stadium for three nights this weekend. In our data he draws
    {' '}{쉼표(임영웅.enReads)} English readers on an ordinary day &mdash; fewer than a fifteenth
    of {으뜸.label}.
  </p>

  <p>
    That is not a statement that he is small. It is a statement about <b>what an English-language
    measure can see</b>. Every reading figure on this site, including all of ours, is counted in
    English. A performer whose audience is Korean-speaking is close to invisible to it, no matter how
    many seats they sell.
  </p>

  <p class="q">
    We publish this because we use the English measure everywhere else. A reader is entitled to know
    which parts of Korean music it systematically under-counts, and this is one of them.
  </p>

  <KcwMethodLimits
    method={{
      'What this is': 'Median daily Wikipedia pageviews over the last 30 days for the same person, '
        + 'counted separately on the Korean and English editions.',
      Source: d.source,
      'Why medians': 'A comeback or a concert week can be many times an ordinary day. An average would '
        + 'carry that week into every comparison.',
      'How the six were chosen': 'Three trot singers and three acts covered heavily in English, put '
        + 'side by side to show the contrast. Not a sample of an industry.',
    }}
    limitation={{
      'What this is not': 'Not a measure of popularity, sales, streams or attendance. It counts which '
        + 'language an encyclopedia page is opened in. Korean Wikipedia is also a smaller encyclopedia '
        + 'than English Wikipedia overall, which is part of why these numbers look as they do.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    {d.notMeasured.map((s: string) => <li>{s}</li>)}
  </ul>
  {d.unmeasured.length > 0 && (
    <ul>{d.unmeasured.map((s: string) => <li>{s}</li>)}</ul>
  )}

  <p class="asof">Measured {d.measuredAt}. {d.measures}.</p>

  <KcwRelatedArticles page="/which-language-reads-you" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  tr.ko td, tr.ko th { background: #eef4fb; }
  tr.en td, tr.en th { background: #fdf4ee; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    .asof { color: #999; }
    tr.ko td, tr.ko th { background: #16202b; }
    tr.en td, tr.en th { background: #2b2016; }
  }
</style>
