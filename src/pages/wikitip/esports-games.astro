---
/**
 * K Culture Wire — **우리가 「이스포츠」라 부른 것은 한 게임이었다.** (`/esports-games`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   78편에서 「이스포츠 선수가 한 달에 몰린다」고 썼는데 **종목을 안 갈랐다.**
 *   ⭐ 갈라 보니 잰 사람의 85.7% 가 리그오브레전드 선수였다.
 *   🔴 그러니 78편의 말은 너무 넓었다. **이 지면이 그것을 좁힌다.**
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ 게임을 줄세우지 않는다. 「한국에 몇 명 / 문서가 몇 / 읽히는 게 몇」을 나란히 놓는다.
 * ⛔ 셋이 안 되는 게임은 봉우리를 말하지 않는다. 「다르더라」가 아니라 **「못 쟀다」**다.
 * 🔴 앞 지면을 좁혔다는 사실을 **감추지 않는다.** `narrowsAnEarlierClaim` 을 반드시 낸다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-esports-games.json';

const 달글자 = ['January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'];
const 달이름 = (m: string | null) => (m ? 달글자[Number(m) - 1] : '—');

const 스타 = d.games.find((g) => g.game === 'StarCraft II');

const TITLE = 'What we called an esports pattern was one game';
const DESC =
  `Split by game, ${d.concentration.sharePc}% of the Korean esports players we could measure in the `
  + `Southeast Asian Wikipedias play ${d.concentration.game}. Korea has more StarCraft II players on `
  + `Wikidata, and ${스타?.withSeaArticle} of them have an article in these editions.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/esports-games">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    <b>{d.concentration.people}</b> of the <b>{d.concentration.ofTotal}</b> players we could measure
    play {d.concentration.game} — {d.concentration.sharePc}%.
  </p>

  <section class="warn-box">
    <h2>This narrows something we published earlier</h2>
    <p class="warn">{d.narrowsAnEarlierClaim}</p>
  </section>

  <section>
    <h2>Four questions, one row each</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Game</th><th>Korean players on Wikidata</th>
          <th>With an article in these four editions</th><th>Share</th>
          <th>Read enough to measure</th><th>Sharing a peak month</th></tr></thead>
        <tbody>
          {d.games.map((g) => (
            <tr>
              <td class="nm">{g.game}</td>
              <td>{g.playersInKorea ?? '—'}</td>
              <td>{g.withSeaArticle}</td>
              <td>{g.articleSharePc === null ? '—' : `${g.articleSharePc}%`}</td>
              <td class="tot">{g.measured}</td>
              <td class="fine">
                {g.tooFewToSay
                  ? `fewer than ${d.minPeopleForAGroup} — we do not say`
                  : `${g.sharingPeak} of ${g.measured} in ${달이름(g.peakMonth)}`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Read the second column against the third. Korea has {스타?.playersInKorea} StarCraft II
      players on Wikidata and {d.games[0].playersInKorea} {d.games[0].game} players — more of the
      former. In these four editions, {스타?.withSeaArticle} StarCraft II players have an article
      and {d.games[0].withSeaArticle} {d.games[0].game} players do.
    </p>
  </section>

  <section class="warn-box">
    <h2>The other games were not tested and found different</h2>
    <p class="warn">{d.whyOtherGamesCannotBeTested}</p>
    <p class="note">
      Games with a group large enough to place a peak month: <b>{d.verdict.games}</b>.
      {d.verdict.canTell
        ? (d.verdict.allSameMonth
          ? ` They land on the same month (${달이름(d.verdict.months[0])}), which would make the pattern cross titles.`
          : ` They land on different months (${d.verdict.months.map(달이름).join(', ')}), which would make it a tournament calendar rather than a property of esports.`)
        : ' One group cannot be compared with anything, so the question of whether this crosses games stays open.'}
    </p>
    <p class="note">
      &ldquo;Read enough to measure&rdquo; means at least {d.minReadsPerYear} reads across the four
      editions in 2025. A group needs {d.minPeopleForAGroup} such players before we report a peak
      month for it, because below that one person decides the answer.
    </p>
  </section>

  <section class="src">
    <h2>How this was counted, and one wrong turn</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Unit</b> — {d.unit}</li>
    </ul>
    <p class="note">{d.howWeFoundTheGame}</p>
    <p class="warn">{d.cannotAnswer}</p>
    <p class="note">
      <a href="/one-month">A year of readers in one month</a> ·{' '}
      <a href="/esports-nations">The comparison we could not make</a> ·{' '}
      <a href="/corrections">What we have corrected</a> · <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/esports-games" />
</WikiTip>

<style>
  .warn-box { border-left: 3px solid #b45309; padding-left: 1rem; }
</style>
