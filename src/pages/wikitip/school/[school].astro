---
/*
 * school/[school].astro — **학교별 지면 쉰다섯 장.** (5번, 2026-08-25 새벽)
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 사장님 지시 「키워드 검색량을 재서 해」로 잰 결과다 —
 * ```
 *   school of performing arts seoul   자동완성 1번째 · 그 말로 시작 10줄
 *   hanlim multi art school           자동완성 1번째 · 그 말로 시작 10줄
 * ```
 * ⭐ 손님이 치는 것은 **학교 이름 그 자체**다. 그래서 주소도 제목도 학교 이름으로 간다 —
 *   「educated at」이나 「alma mater」 같은 자료의 말을 쓰지 않는다.
 *
 * ── ⛔ 이 지면이 지키는 것 — «분모가 명부가 아니다» ─────────────
 * ```
 *   명부 전체            9,249명
 *   학교가 «적힌» 사람    4,535명 (49%)
 *   학교가 «안 적힌» 사람  4,714명  ⛔ 학교를 «안 다닌» 것이 아니라 «모르는» 것이다
 * ```
 * 그러니 「352명」은 **「우리가 세어 352명」**이다. 이 문장이 지면에서 빠지면 그 수는
 * 틀린 수가 된다. 그래서 아래 warn 칸을 뺄 수 없다.
 *
 * ⛔ 학교끼리 줄 세우지 않는다. 「최고의 연예인 학교」를 안 쓴다 — 수가 큰 것은 학교 규모·
 *   설립 연도·위키데이터 편집자의 손이 함께 만든 것이고 우리는 그 셋을 못 가른다.
 * ⛔ 이름 순서를 「인기 순」이라고 부르지 않는다.
 * ⛔ 수를 이 지면에서 세지 않는다 — `wikitip-schools.json` 에서 읽는다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-schools.json';
import people from '../../../data/wikitip-people.json';
import { 이름표만들기, 이지면의문, 문 } from '../../../lib/person-link';
/* 🔴 [2026-08-28 · 5번] 학교 지면이 「몇 명 나왔나」만 말하고 있었다.
   같은 날 학교와 «넷플릭스에서 얼마나 멀리 갔나»를 처음 이어 재 놓고도
   그 수를 지면에 안 실으면 «재고 안 쓴 것»이 된다. 여기서 싣는다.
   ⛔ 사람이 5명 아래인 학교는 자료 쪽에서 이미 빠져 있다 — 지면에도 이 칸이 안 나온다. */
import 도달자료 from '../../../data/kcw-school-reach.json';
/**
 * 🔴 [2026-08-29] 학교 지면 55장에 구조화 데이터가 없었다.
 *   ⛔ 다만 «순위»로 읽히면 안 된다 — 이 자료가 스스로 적어 둔 한계다.
 *     별점·평가류를 안 넣는 것을 school-jsonld.test.mjs 가 지킨다.
 */
import { 학교구조화 } from '../../../lib/school-jsonld.ts';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다(어제 그것으로 빌드가
     한 번 멈췄다). 자료는 여기서 읽고, 지면이 쓸 것은 props 로 건넨다 */
  const 학교들 = data.schools ?? [];
  /* 🔴 [2026-08-26] 동문 이름이 글자였다 — 사람 지면으로 가는 문을 단다.
     ⛔ 이름이 겹치면 안 건다(person-link 참고). 틀린 문은 없는 문보다 나쁘다. */
  const { 표: 사람표 } = 이름표만들기(people.people ?? []);
  /* ⚠ 잇는 열쇠는 slug 다. 학교 자료와 도달 자료가 같은 builder 에서 나온 같은 slug 를 쓴다 */
  const 도달표 = new Map((도달자료.잴수있는것 ?? []).map((r: any) => [r.slug, r]));
  /* 🔴 [2026-08-29] 사람이 적어 «가운데값을 못 내는» 학교도 1~4명은 재어 놓았다.
     그 수를 버리면 32장이 «모두 똑같은» 설명문을 달게 된다 — AI 도 검색도 인용할 이유가 없다.
     ⚠ 가운데값은 안 쓰고 «세는 것»만 쓴다: 몇 명을 재었나, 가장 넓게 간 사람은 누구인가. */
  const 적게표 = new Map((도달자료.적게잰것 ?? []).map((r: any) => [r.slug, r]));
  return 학교들.map((s, i) => ({
    params: { school: s.slug },
    props: {
      s,
      도달: 도달표.get(s.slug) ?? null,
      적게: 적게표.get(s.slug) ?? null,
      사람문: 이지면의문((s.top ?? []).map((p: any) => p.name), 사람표),
      이웃: [학교들[(i + 1) % 학교들.length], 학교들[(i + 2) % 학교들.length]]
        .filter((x) => x && x.slug !== s.slug),
      큰곳: 학교들.slice(0, 6).filter((x) => x.slug !== s.slug).slice(0, 5),
    },
  }));
}

const { s, 이웃, 큰곳, 사람문, 도달, 적게 } = Astro.props as { s: any; 이웃: any[]; 큰곳: any[]; 사람문: Record<string, string>; 도달: any; 적게: any };

const 적힌사람 = data.peopleWithSchool;
const 안적힌사람 = data.peopleWithoutSchool;
const 명부 = data.rosterPeople;
const 적힌몫 = 명부 > 0 ? (100 * 적힌사람) / 명부 : null;

const 수 = (n: number) => Number(n).toLocaleString('en-US');

/* 🔴 [2026-08-27 17:2x · 5번] **55장이 전부 잘리고 있었다** — 제목 73자·설명 200자쯤.
   구글은 제목을 60자, 설명을 155자쯤에서 자른다.
   ⭐ 수를 «앞으로» 당기고 「from 학교이름」 꼴로 바꿨다 — 손님이 치는 말이
     「celebrities from hanyang university」 꼴이라 그 순서에 맞춘다.
   ⛔ 「floor, not a total」(이 수가 밑값이라는 고지)을 설명에서 뺐다. **빼기 전에 본문을 쟀다** —
     아래 note 칸이 그 말을 그대로 하고 있다. 잘려서 안 보이던 자리에서 보이는 자리로 옮긴 것이다.
   ⚠ 55개 학교를 다 재서 제목 최대 57자(Hankuk University of Foreign Studies)다. */
const TITLE = `${수(s.people)} Korean stars from ${s.name}`;
/**
 * 🔴🔴 [2026-08-29] **설명문이 「우리만 가진 수」를 안 말하고 있었다.**
 *
 * AI 가 어느 지면을 인용하는지 재 봤다(`measure-ai-citations.mjs`). 28일에 21세션인데
 * 그중 «10» 이 3번(백년지도)의 학교·대학 낱장이었고, 내 학교 낱장은 «0» 이었다.
 * 두 지면의 설명문을 견주니 차이가 뚜렷했다 —
 *
 * ```
 *   3번  「학급당 14.1명 · 학업중단 5.7% · 1년 뒤 83.1%」   ← 「이 학교가 어떤 곳인가」에 답한다
 *   5번  「48명이 이 학교에서 나왔다」                      ← 목록의 «크기»만 말한다
 * ```
 * ⛔ 그리고 「이 학교 출신 스타가 누구냐」는 위키피디아가 이미 답한다 — 우리가 이길 자리가 아니다.
 * ⭐ 우리가 «혼자» 가진 수는 넷플릭스 도달이다. 그것을 설명문 앞으로 당긴다.
 *    ⚠ 도달을 «잰» 학교에만 넣는다. 못 잰 학교는 예전 문장 그대로다 — 지어내지 않는다.
 */
/**
 * ⭐ [2026-08-29] 세 갈래다. **적게 잰 학교도 «버리지 않는다».**
 *   ① 5명 이상 재었다      → 가운데값을 말한다
 *   ② 1~4명 재었다        → 가운데값은 «안» 말하고, 몇 명을 재었는지와
 *                           가장 넓게 간 사람 이름을 말한다. 세는 것은 표본이 작아도 참말이다
 *   ③ 한 명도 못 재었다    → 예전 문장 그대로. 지어내지 않는다
 * ⭐ ②에는 «스타 이름»이 들어간다 — 사장님: 「인기검색어는 스타 이름·작품명이다」
 */
const DESC = 도달 && Number.isFinite(도달.가운데나라수)
  ? `${수(s.people)} Korean stars studied at ${s.name}. Their work reached a median of `
    + `${도달.가운데나라수} countries on Netflix, measured over ${수(도달.사람수)} of them.`
  : (적게?.가장넓은사람?.이름 && Number.isFinite(적게?.가장넓은사람?.가장넓은나라수)
    ? `${수(s.people)} Korean stars studied at ${s.name}. Of the ${적게.사람수} we could measure, `
      + `${적게.가장넓은사람.이름} travelled furthest — ${적게.가장넓은사람.가장넓은나라수} countries on Netflix.`
    : `${수(s.people)} Korean actors and singers studied at `
      + `${s.name}. Wikidata records a school for ${수(적힌사람)} of ${수(명부)} people.`);
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/school/${s.slug}`}
  jsonLd={학교구조화(s, new Map(Object.entries(사람문 ?? {})))}>
  <h1>{s.name}</h1>

  {/* ⭐ 답을 맨 앞에. 그리고 «무엇을 센 수인지»를 같은 문단에 둔다 */}
  <p class="lead">
    We counted <b>{수(s.people)}</b> Korean actors, singers and other entertainers who studied at
    {' '}<b>{s.name}</b>. {s.top.length > 0 && <>The {s.top.length} most widely written about are
    named below.</>}
  </p>

  {/*
    🔴 이 칸을 뺄 수 없다. 분모가 명부가 아니라 «학교가 적힌 사람»이다.
      이 문장 없이 수만 내면 손님은 그것을 확정된 총수로 읽는다.
  */}
  <p class="warn">
    <b>This is a floor, not a total.</b> Wikidata records a school for {수(적힌사람)} of the
    {' '}{수(명부)} people we hold{적힌몫 !== null && <> — {적힌몫.toFixed(0)}%</>}. For the other
    {' '}<b>{수(안적힌사람)}</b> we do not know where they studied, and <b>not knowing is not the
    same as not having gone</b>. So the real number for {s.name} is at least {수(s.people)},
    and we cannot tell you how much higher.
  </p>

  {s.top.length > 0 && (
    <section>
      <h2>Some of the names</h2>
      <p class="note">
        Ordered by how many Wikipedia language editions carry an article about them.{' '}
        <b> That measures how widely someone is written about, not how good they are</b>, and it
        favours people who have been famous longer.
      </p>
      {/*
        * 🔴 2026-08-25 — 이 표에 **한글 이름이 그대로 나가고 있었다**(학교 32곳).
        *   영어 손님은 그 줄에서 읽기를 멈춘다. 이제 자료 쪽에서 걸러 낸다.
        * ⛔ 걸러 냈다고 «없던 사람»으로 만들지 않는다 — 몇 명을 못 적었는지 여기 적는다.
        */}
      {s.namesNotInEnglish > 0 && (
        <p class="note">
          <b>{수(s.namesNotInEnglish)}</b> more people we counted at {s.name} are not in this table,
          because Wikidata records their name only in Korean and this is an English page. They are
          still inside the {수(s.people)} above. We would rather leave a name out than print one you
          cannot read.
        </p>
      )}
      <div class="scroll-x">
        <table>
          <thead><tr><th>Name</th><th>Born</th><th>Wikipedia languages</th></tr></thead>
          <tbody>
            {s.top.map((p: any) => (
              <tr>
                <td class="nm">{문(p.name, 사람문)
                  ? <a href={문(p.name, 사람문)}>{p.name}</a> : p.name}</td>
                <td>{p.year ?? '—'}</td>
                <td class="tot">{p.languages ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note fine">A dash means we hold no figure, not a zero.</p>
    </section>
  )}

  {/*
    🔴 [2026-08-28 · 5번] 여기가 이 지면에서 «이 학교만 가진» 수다.
      위의 「몇 명」은 큰 학교면 다 크다. 이것은 크기와 «따로» 움직인다 —
      사람을 가장 많이 낸 서울예대가 가운데 16나라이고, 그 절반인 동국대가 41.5나라다.
    ⛔ 평균을 안 쓴다. 오징어게임 한 편이 3,228자리라 평균이 통째로 끌려간다.
    ⭐ 「한 사람 빼고」를 «같은 표»에 둔다 — 「그거 한 명이 만든 수 아니냐」는 반론을
      각주로 막지 않고 읽는 사람이 그 자리에서 검산하게 한다.
  */}
  {도달 && (
    <section>
      <h2>How far their work travelled</h2>
      <p class="lead">
        Of the {수(s.people)} people we counted here, <b>{도달.사람수}</b> have a title that
        reached a Netflix country Top 10. The median one reached
        {' '}<b>{도달.가운데나라수} of the 94 countries</b> Netflix publishes lists for.
      </p>
      <div class="scroll-x">
        <table>
          <thead><tr><th></th><th>Countries reached</th></tr></thead>
          <tbody>
            <tr><td class="nm">Median of all {도달.사람수}</td><td class="tot">{도달.가운데나라수}</td></tr>
            {도달.한사람빼고 !== null && (
              <tr>
                <td class="nm">Median with the single widest person removed</td>
                <td class="tot">{도달.한사람빼고}</td>
              </tr>
            )}
            {도달.가장넓은사람 && (
              <tr>
                {/* ⚠ JSX 안의 «글자 자리»에서는 &mdash; 가 안 풀린다 — 그대로 찍힌다.
                     빌드해서 눈으로 보고 잡았다. 글자를 직접 쓴다. */}
                <td class="nm">Widest single person — {문(도달.가장넓은사람.이름, 사람문)
                  ? <a href={문(도달.가장넓은사람.이름, 사람문)}>{도달.가장넓은사람.이름}</a>
                  : 도달.가장넓은사람.이름}</td>
                <td class="tot">{도달.가장넓은사람.가장넓은나라수}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
      <p class="note">
        <b>The second row is the check on the first.</b> If removing one person moves the median a
        long way, the school’s figure was that person rather than that school. Here it moves
        from {도달.가운데나라수} to {도달.한사람빼고 ?? '—'}.
      </p>
      <p class="note fine">
        Counted as the widest single title a person has, not the sum of their titles: the source
        file gives a country count per title but not <i>which</i> countries, so adding them would
        count the same country twice. Schools with fewer than five such people are not given this
        figure at all.
        {' '}<a href="/article/the-school-that-sends-the-most-travels-the-least">All 23 schools side by side →</a>
      </p>
    </section>
  )}

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Wikidata</b> — &ldquo;educated at&rdquo; (P69), South Korean citizenship, an
        entertainment occupation. CC0. Someone who attended more than one school is counted at
        each of them, so adding every school here gives a number larger than the number of people.
      </li>
    </ul>
    <p class="note">
      <b>A bigger count does not mean a better school.</b> It reflects how large the school is,
      how long it has existed, and who happens to have a Wikidata entry — three things we hold no
      way to separate. We do not rank schools and we do not suggest you pick one.
    </p>
    <p class="note">
      <b>We count schools, not degrees.</b> Wikidata's field records that someone studied there.
      It does not tell us whether they graduated, what they studied, or for how long, so neither
      do we.
    </p>
    <p class="note fine">
      We hold {data.schoolsSeen} schools in all. {data.schoolsNotListed} of them have fewer than
      {' '}{data.minPeopleToList} people we could count, and we do not publish a page for those —
      they are counted, not hidden.
    </p>
  </section>

  <section class="onward">
    <h3>Other schools we counted</h3>
    <ul>
      {[...이웃, ...큰곳].slice(0, 6).map((x) => (
        <li><a href={`/school/${x.slug}`}>{x.name}</a>
          <span class="fine"> &mdash; {수(x.people)}</span></li>
      ))}
    </ul>
    <h3>Other ways into the same people</h3>
    <ul class="walk">
      <li><a href="/born-on">All 366 days of the year</a></li>
      <li><a href="/actors-in-their/20s">By age band</a></li>
      <li><a href="/star-sign/cancer">By star sign</a></li>
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>
</WikiTip>
