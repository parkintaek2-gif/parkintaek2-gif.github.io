---
/*
 * school/index.astro — **학교 쉰다섯 곳의 문간.** (5번, 2026-08-25 새벽)
 *
 * 여기가 있어야 학교 지면 55장이 «두 번 안에» 닿는다. 어제 잰 것에서 배운 것이 하나 있다 —
 * 수요가 큰 지면이 들어오는 링크 한두 개로 굶고 있었다. 지면을 내고 문을 안 달면
 * 만든 것이 안 보이는 것과 같다.
 * ⛔ 학교를 줄 세우는 표가 아니다. 수가 큰 순서로 놓되 «순위»라고 부르지 않는다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import KcwDataBasis from '../../../components/KcwDataBasis.astro';
import KcwRelatedArticles from '../../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../../components/KcwCardnews.astro';
import data from '../../../data/wikitip-schools.json';
/**
 * 🔴 [2026-09-04] **이 지면은 「학교 이름과 사람 수」만 싣고 있었다.**
 *
 *   `check-visitor-walk.mjs` 가 「본문에 나가는 길이 없는 기사 9편」을 잡아 줘서, 그 아홉이
 *   어느 지면으로 가야 하나를 재다가 알았다 — 기사
 *   `arts-high-school-beats-sky-universities` 가 내세우는
 *   **58.4% · 125 · 16.0% · 75 · 4,535** 가운데 이 지면에 있던 것은 125 와 75 뿐이었다.
 *   ⇒ 카드마다 박는 「every figure has a table behind it」이 그 기사에서 거짓이었다.
 *   ⭐ 그리고 자료는 8월부터 있었다. 못 잰 것이 아니라 «싣지 않은 것»이었다.
 *
 *   ⛔ 그런데 몫만 실으면 이 지면이 «학교 순위표»가 된다. 이 지면 스스로 위에서
 *     「큰 수가 순위가 아니다」라고 적어 놓고 그것을 어기는 꼴이다.
 *   ✅ 그래서 몫과 **95% 구간**을 같이 싣고, 인원이 스물 미만인 곳은 몫을 «말하지 않는다».
 *     (다섯 명 가운데 셋이면 60% 인데, 그 60% 는 「낫다」가 아니라 「셋이 그랬다」다)
 */
import 언어판 from '../../../data/kcw-school-language-reach.json';
/* 🔴 사장님 상시 지시 — 「밖에 내는 콘텐트는 «우리 사이트에도» 싣고, 관련 콘텐트를
   빠짐없이 붙여 다음 것을 계속 보게 하라」. 유튜브가 막혀 있어도 이 자리는 열려 있다. */
import KcwShorts from '../../../components/KcwShorts.astro';

const 학교들 = data.schools ?? [];
const 수 = (n: number) => Number(n).toLocaleString('en-US');
const 적힌사람 = data.peopleWithSchool;
const 안적힌사람 = data.peopleWithoutSchool;
const 명부 = data.rosterPeople;

const TITLE = `Where Korean actors and singers studied — ${학교들.length} schools, counted`;
const DESC = `${학교들.length} schools, each with the Korean actors, singers and other `
  + `entertainers we counted from it. Built from Wikidata, which records a school for `
  + `${수(적힌사람)} of the ${수(명부)} people we hold.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/school">
  <h1>Where Korean actors and singers studied</h1>

  <p class="lead">
    <b>{학교들.length}</b> schools, each with the people we counted from it. Open one to see the
    names.
  </p>

  <p class="warn">
    <b>Every number here is a floor.</b> Wikidata records a school for {수(적힌사람)} of the
    {' '}{수(명부)} people we hold. For the other <b>{수(안적힌사람)}</b> we do not know where they
    studied — and not knowing is not the same as not having gone.
  </p>

  <section>
    <h2>The schools</h2>
    <p class="note">
      Largest count first. <b>That is not a ranking.</b> A bigger count reflects how large the
      school is, how long it has existed, and who happens to have a Wikidata entry.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>School</th><th>People we counted</th></tr></thead>
        <tbody>
          {학교들.map((s: any) => (
            <tr>
              <td class="nm"><a href={`/school/${s.slug}`}>{s.name}</a></td>
              <td class="tot">{수(s.people)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note fine">
      We hold {data.schoolsSeen} schools in all. {data.schoolsNotListed} of them have fewer than
      {' '}{data.minPeopleToList} people we could count, and we do not publish a page for those —
      they are counted, not hidden.
    </p>
  </section>

  <section>
    <h2>How far each school&rsquo;s alumni travel</h2>
    <p class="note">
      A Wikipedia article that exists in ten or more languages has been written up outside Korea.
      Across every school we can count, <b>{언어판.셈.전체열개이상.toLocaleString('en-US')}</b> of
      {' '}<b>{언어판.셈.전체잰사람.toLocaleString('en-US')}</b> counted alumni clear that line —
      {' '}<b>{언어판.셈.전체몫}%</b> ({언어판.셈.전체구간아래}&ndash;{언어판.셈.전체구간위}).
      The schools below are the {언어판.셈.몫을말할수있는학교} with at least
      {' '}{언어판.몫낼최소인원} counted alumni, largest first.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>What we counted</th><th>Number</th></tr></thead>
        <tbody>
          <tr><th scope="row">Entertainers with a school recorded on Wikidata</th><td>{수(언어판.셈.학교적힌사람)}</td></tr>
          <tr><th scope="row">School&ndash;person links counted (people at two schools count twice)</th><td>{수(언어판.셈.전체잰사람)}</td></tr>
          <tr><th scope="row">Schools seen at all</th><td>{수(언어판.셈.학교전체)}</td></tr>
          <tr><th scope="row">Schools with at least {언어판.몫낼최소인원} counted alumni</th><td>{수(언어판.셈.몫을말할수있는학교)}</td></tr>
          <tr><th scope="row">Alumni in ten or more language editions</th><td>{수(언어판.셈.전체열개이상)}</td></tr>
          <tr><th scope="row">That share, across every school</th><td>{언어판.셈.전체몫.toFixed(1)}%</td></tr>
        </tbody>
      </table>
    </div>

    <p class="warn">
      <b>Read the interval, not the percentage.</b> A school with 23 alumni and one with 352 both
      get a percentage, but only the second one is a stable figure. Where two schools&rsquo;
      intervals overlap, <b>this table cannot tell them apart</b> — and most of them overlap.
      Sorting by percentage would turn that into a league table it is not.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          {/* ⛔ 몫과 구간을 «한 칸에» 넣지 않는다. 넣어 봤더니 check-table-promises 가
              「58.4 가 표에 없다」고 잡았다 — 칸 안에서 「58.4% (49.6–66.7)」로 붙어
              한 칸이 한 값이 아니게 됐다. 자가 맞았다. 칸을 나누는 것이 표로도 낫다. */}
          <tr>
            <th>School</th><th>Counted alumni</th><th>Median language editions</th>
            <th>In 10+ editions</th><th>Share</th><th>95% interval</th>
          </tr>
        </thead>
        <tbody>
          {언어판.학교들.map((s: any) => (
            <tr>
              <td class="nm">{s.학교}</td>
              <td class="tot">{수(s.잰사람)}</td>
              <td class="tot">{s.중간언어판}</td>
              <td class="tot">{수(s.열개이상)}</td>
              <td class="tot">{s.몫.toFixed(1)}%</td>
              <td class="tot fine">{s.구간아래.toFixed(1)}&ndash;{s.구간위.toFixed(1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note fine">
      Two schools at the ends of this table can be told apart:
      {' '}<b>{언어판.가장넓은.학교}</b> at {언어판.가장넓은.몫}%
      {' '}({언어판.가장넓은.구간아래}&ndash;{언어판.가장넓은.구간위}) on {수(언어판.가장넓은.잰사람)} alumni,
      and <b>{언어판.가장좁은.학교}</b> at {언어판.가장좁은.몫}%
      {' '}({언어판.가장좁은.구간아래}&ndash;{언어판.가장좁은.구간위}) on {수(언어판.가장좁은.잰사람)}.
      {' '}Their intervals do not overlap. That is the only kind of comparison this table supports.
    </p>
    <p class="note fine">
      A person who studied at two schools is counted at both, so the alumni column adds up to more
      than the number of people we hold. And a wide language footprint is not the same as being
      widely read — it means an article exists in those languages, nothing more.
      {' '}<a href="/article/arts-high-school-beats-sky-universities">How we counted this &rarr;</a>
    </p>
  </section>

  {/* ⭐ 14초로 「학교가 아니라 한 사람이 갔다」를 보여 준다 — 이 지면이 말하는 것 그대로다 */}
  <KcwShorts set="school-one-name"
    says={`Fourteen seconds: one name, Lee You-mi, moves a whole school's figure `
      + `from 43 countries to 25. The school did not travel — a person did.`} />

  <section class="onward">
    <h3>Other ways into the same people</h3>
    <ul class="walk">
      <li><a href="/born-on">All 366 days of the year</a></li>
      <li><a href="/born-in/january">Month by month, all twelve</a></li>
      <li><a href="/actors-in-their/20s">By age band</a></li>
      <li><a href="/star-sign/cancer">By star sign, twelve of them</a></li>
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>

  {/* 🔴 [2026-08-30] 기사 두 편이 이 지면을 가리키는데 «받는 자리»가 없었다. */}
  {/* 🔴 [2026-09-03] 고아였던 벌 — 구웠는데 어느 지면도 부르지 않았다. */}
  <KcwCardnews set="school" count={5} />

  <KcwRelatedArticles page="/school" />
  {/* 🔴 [2026-09-02] 왜 어떤 학교는 지면이 없는지, 왜 키 지면을 안 만들었는지 — 손님이 봐야 한다. */}
  <KcwDataBasis
    heading="What this list is, and what we left out"
    notes={[data.whyNotListed, data.whyNoHeightPages]}
    counts={[
      { label: 'Schools that would share a web address', value: data.slugCollisions },
      { label: 'Dropped for not being in the roster', value: data.droppedNotInRoster },
    ]}
  />
</WikiTip>
