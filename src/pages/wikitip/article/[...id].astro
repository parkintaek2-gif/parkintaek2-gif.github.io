---
/**
 * K Culture Wire — 기사 지면. (`/article/<slug>`)
 *
 * ── 왜 SeoulMarkets 기사 라우트를 안 쓰나 ──────────────────────
 * `src/pages/article/[...id].astro` 는 `Base.astro`(금융 머리말)에 `SITE_URL`
 * (seoulmarkets.com)로 붙는다. 그대로 쓰면 K컬처 도메인에 금융 매체 얼굴이 나간다 —
 * 8/3 에 `/esports` 제목이 「… | SeoulMarkets」로 나갔던 그 사고다.
 *
 * ── 왜 이 지면이 생겼나 (사장님 지시 2026-08-05 11:30) ─────────
 * 「네가 할 일은 **영어뉴스+데이터가공**이다」. 8/6 까지 K Culture Wire 는
 * 데이터 지면 7장뿐이고 **기사가 0편**이었다. 그릇이 없어서 못 쓴 것이라 먼저 만들었다.
 *
 * ── 출처·검증을 본문 아래에 그대로 편다 ────────────────────────
 * 사장님 지시 「아직은 언론사가 아니다. 그 자격에 기대지 않는다」 —
 * 우리가 파는 것은 숫자의 신뢰다. **무엇을 뺐는지까지** 지면에 적는다.
 * ⛔ 광고 자리를 만들지 않았다. Riot Production(App 866800) 승인 전에 광고가 뜨면
 *    API 가 영구 취소된다. `WikiTip.astro` 와 같은 이유다.
 */
import { getCollection, render } from 'astro:content';
import cardnewsData from '../../../data/wikitip-cardnews.json';
import WikiTip from '../../../layouts/WikiTip.astro';
import { 이웃표 } from '../../../lib/kcw-neighbours.mjs';

export async function getStaticPaths() {
  const all = await getCollection('kcwArticles');
  const live = all.filter((e) => !e.data.draft);
  return live.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;

/* 태그 → 주소. `tag/[tag].astro` 와 «같은 규칙»이어야 한다 — 어긋나면 링크가 404 가 된다 */
const 태그슬러그 = (t: string) => String(t ?? '').toLowerCase()
  .replace(/[’'`]/g, '').replace(/&/g, ' and ')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

/* ⛔ 한 편짜리 태그는 지면이 없다. 링크로 걸면 404 가 되므로 «지면이 있는 것만» 링크한다.
   그래서 여기서 태그별 편수를 다시 센다 — tag 지면과 같은 문턱(2편)을 쓴다 */
const 태그수 = new Map<string, number>();
for (const e of (await getCollection('kcwArticles')).filter((x: any) => !x.data.draft)) {
  for (const t of (e.data.tags ?? [])) {
    const s = 태그슬러그(t);
    if (s) 태그수.set(s, (태그수.get(s) ?? 0) + 1);
  }
}
const 태그지면 = new Set([...태그수].filter(([, n]) => n >= 2).map(([s]) => s));

/* 이 기사의 카드뉴스. ⛔ 없으면 null 이고 아무것도 안 그린다 — 빈 상자는 없는 것만 못하다.
   ⛔ 장수를 손으로 적지 않는다. build-kcw-cardnews-index.mjs 가 파일을 세어 적어 둔다 */
const 카드뉴스 = (cardnewsData.sets ?? []).find((c) => c.set === entry.id) ?? null;
const { Content } = await render(entry);

/**
 * 같은 자료 지면을 쓴 다른 기사. **규칙으로 뽑는다** — 손으로 고르면 다음에 빠진다.
 * ⛔ 순위로 세우지 않는다. 낸 순서다.
 */
const 모든기사 = (await getCollection('kcwArticles')).filter((e) => !e.data.draft);
const 전체기사수 = 모든기사.length;

/**
 * 🔴 2026-08-21 — 실측: 107편 중 **33편이 나가는 기사 링크가 0개**, 51편이 3개 미만이었다.
 *   `pages` 를 공유하는 기사만 이웃으로 삼았는데, 지면 하나에 기사 하나인 편이 많아서다.
 *   2번: 「손님 188명이 **한 편만 읽고 나간다**」 — 그 막다른 길이 여기였다.
 *
 * ⭐ 그래서 **세 겹으로** 채운다. 어느 겹이든 «규칙»이지 손으로 고르는 것이 아니다.
 *   ① 같은 자료 지면을 쓴 기사      가장 가깝다
 *   ② 태그가 겹치는 기사            많이 겹치는 순 → 최신순
 *   ③ 같은 갈래(category)의 최신 기사  ①②로 셋이 안 차면
 * ⛔ 순위·인기로 세우지 않는다. ⛔ 자기 자신은 안 넣는다. ⛔ 같은 기사를 두 번 안 넣는다.
 * ⚠ 셋으로 맞춘다 — 넷을 주면 고르기가 어려워지고, 둘은 막다른 길에 가깝다.
 *
 * 🔴 2026-08-22 — **셋을 채우는 것만으로는 부족했다.** 같은 규칙으로 «누가 가리켜지나»를 세니
 *   108편이 가리키는 서로 다른 기사가 83편이고 **25편은 아무도 안 가리켰다**(한 편에 최다 19번).
 *   둘째 겹이 「겹침 수 → 최신순」이라 최근에 낸 편들끼리 태그를 나눠 가지고 **서로를 물었다.**
 *   ⛔ 「관련기사 3개가 다 있다」와 「108편이 다 문이 된다」는 다른 말이다 — 8/21 에 앞의 것만 재고 닫았다.
 *
 *   그래서 세 자리 중 **셋째를 「덜 가리켜진 편」에게 준다.** 규칙은 한 자리
 *   (`src/lib/kcw-neighbours.mjs`)에 두고 지면은 읽기만 한다 — 자는 `check-kcw-article-doors.mjs`.
 *   잰 것: 안 가리켜지는 편 **0편** · 가리켜지는 서로 다른 편 **108편(전부)** · 최다 15번.
 *   ⚠ 셋째 자리도 **이 기사의 후보 안에서만** 고른다. 문을 고르게 내는 것과 엉뚱한 문을
 *     내는 것은 다르다.
 */
const 이웃id = 이웃표(
  모든기사.map((e) => ({
    id: e.id,
    pages: e.data.pages ?? [],
    tags: e.data.tags ?? [],
    category: e.data.category,
    pubDate: e.data.pubDate,
  })),
).get(entry.id) ?? [];
const 기사찾기 = new Map(모든기사.map((e) => [e.id, e]));
const 이웃 = 이웃id.map((id) => 기사찾기.get(id)).filter(Boolean);

const url = `https://www.kculturewire.com/article/${entry.id}`;
/**
 * 이 기사만의 공유 카드. `scripts/make-og-articles.mjs` 가 미리 만들어 둔다.
 * ⛔ 8/8 아침까지 36편이 **같은 /og.svg** 를 달고 있었다. SVG 는 카카오톡·X·페이스북이 안 그린다 —
 *    공유되는 순간이 유입의 첫 칸인데 그 칸이 비어 있었다.
 * ⚠ 카드가 없는 기사는 여기가 404 가 된다. `check-visitor-walk.mjs` 가 그걸 잡는다.
 */
const 카드 = `https://www.kculturewire.com/og/${entry.id}.png`;
const iso = (v: Date) => new Date(v).toISOString();
/**
 * 🔴 2026-08-08 17:5x — **날짜가 라이브에서 하루 일찍 나가고 있었다.**
 *
 * frontmatter 의 dataAsOf 는 `2026-07-26T00:00:00+09:00`(KST 자정)이다.
 * `toLocaleDateString` 에 timeZone 을 안 주면 **그리는 기계의 시간대**로 그린다.
 * 내보내는 기계는 UTC 라 그 순간이 7월 25일 15시 → 화면에 **25 July** 로 나갔다.
 * 45편 전부가 그랬고, 내 화면(KST)에서는 26 July 라 **영원히 안 보였다.**
 *
 * ⛔ 우리 날짜는 KST 로 적는다. 그리는 것도 KST 로 못박는다.
 *    같은 병을 값 쪽에서 지키는 자는 `scripts/check-price-dates.mjs` 다.
 */
const 날짜 = (v: Date) =>
  new Date(v).toLocaleDateString('en-GB', { timeZone: 'Asia/Seoul', day: 'numeric', month: 'long', year: 'numeric' });

const CATEGORY: Record<string, string> = {
  screen: 'Screen', music: 'Music', esports: 'Esports',
  people: 'People', industry: 'Industry',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline: d.title,
  description: d.dek,
  image: [카드],
  datePublished: iso(d.pubDate),
  dateModified: iso(d.updatedDate ?? d.pubDate),
  articleSection: CATEGORY[d.category] ?? d.category,
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'K Culture Wire' },
  publisher: { '@type': 'Organization', name: 'K Culture Wire' },
};
---

<WikiTip title={d.title} description={d.dek} canonical={url} jsonLd={jsonLd}
  ogImage={카드}>
  <article>
    {/* 🔴 2026-08-10 — 갈래가 **글자로만** 있어서 눌러 볼 수가 없었다. 2번이 짚어 주셨다.
        ⛔ `/stars` 가 아니라 `/section/stars` 다 — `/titles`·`/industry` 는 자료 지면이 이미 쓴다. */}
    <p class="kicker">
      <a href={`/section/${d.category}`}>{CATEGORY[d.category] ?? d.category}</a>
      {d.genre && <span class="fine"> · {d.genre}</span>}
    </p>
    <h1>{d.title}</h1>
    <p class="dek">{d.dek}</p>
    <p class="byline">
      {d.author} · {날짜(d.pubDate)}
      <span class="asof">Data as of {날짜(d.dataAsOf)}</span>
    </p>

    {d.corrections.length > 0 && (
      <aside class="corr">
        {/*
          ⚠ 정정은 **본문 위**에 뜬다. 아래에 숨기면 이미 읽은 사람은 못 본다.
            숫자가 바뀌면 조용히 고치지 않는다 — 고친 자국이 남은 표가 더 믿을 만하다.
        */}
        <b>Corrected</b>
        <ul>
          {d.corrections.map((c) => <li>{날짜(c.date)} — {c.note}</li>)}
        </ul>
      </aside>
    )}

    {/*
      🔴 2026-08-25 새벽 — **나갈 길 하나를 본문 «위»로 올린다.** 왜인지 재서 적는다.
      GA4 로 재니 이렇다 —
      ```
        세션 137 · 걸음 1.26장/세션 · 두 번째 걸음을 «잃은» 세션 102 (74%)
        기사 지면은 거의 다 1.00 — 두 번째 클릭이 아예 없다
      ```
      ⛔ 처음엔 「갈 데가 없어서」라고 생각했다. 그래서 나가는 길을 세어 봤더니 —
        **막다른 골목이 0장**이고 지면마다 나갈 데가 가운데 18~42개였다. 길은 많았다.
      ⭐ 그래서 «어디에» 있는지를 쟀다. 기사 8,623자 중 링크 29개인데
        **윗절반에는 6개뿐**이고 나머지는 다 아래에 몰려 있었다.
        끝까지 안 읽는 사람은 나갈 길을 «본 적이 없다».
      그래서 자료 지면 하나를 머리에 올린다. ⛔ 링크 뭉치를 올리지 않는다 — 한 줄이다.
      ⚠ 이것으로 걸음이 늘지는 «아직 모른다». 올리는 것과 눌리는 것은 다른 말이다 —
        9/1 에 같은 자(`measure-kcw-dwell.mjs`)로 다시 재서 1.26 이 움직였는지 본다.
    */}
    {d.pages.length > 0 && (
      <p class="jump">
        The table this is written from: <a href={d.pages[0]}>{d.pages[0]}</a>
      </p>
    )}

    {/*
      🔴 2026-08-25 오후, 사장님 지시 —
        「각 콘텐트에 관련 콘텐트, 해시태그 등을 빠짐없이 넣었지? 안 하고 있으면 해」
      재 보니 기사 117편 «전부» 앞말에 태그가 있는데(96종) **화면에 나오는 지면이 0장**이었다.
      앞말에만 있고 손님에게는 없었다 — 「넣었다」와 「보인다」는 다른 말이다.
      ⭐ 본문 «위»에 둔다. 아래에 두면 끝까지 안 읽는 사람은 못 본다(그것을 오늘 새벽에
        걸음 1.26장·두 번째 클릭 74% 없음으로 쟀다).
      ⛔ 한 편짜리 태그는 지면이 없으므로 «글자»로만 보인다 — 링크가 아닌 것이 정직하다.
    */}
    {(d.tags ?? []).length > 0 && (
      <p class="tags">
        {d.tags.map((t: string) => (
          태그지면.has(태그슬러그(t))
            ? <a href={`/tag/${태그슬러그(t)}`}>#{t}</a>
            : <span class="notag">#{t}</span>
        ))}
      </p>
    )}

    <div class="body"><Content /></div>

    <section class="notes">
      <h2>Where these numbers come from</h2>

      <h3>Sources</h3>
      <ul>
        {d.sources.map((s) => (
          <li>
            <b>{s.org}</b> — {s.api}
            {s.url && <> · <a href={s.url} rel="nofollow noopener">{s.url}</a></>}
          </li>
        ))}
      </ul>

      {d.crossChecks.length > 0 && (
        <>
          <h3>What we checked</h3>
          <ul>{d.crossChecks.map((c) => <li>{c}</li>)}</ul>
        </>
      )}

      {d.excluded.length > 0 && (
        <>
          <h3>What we left out, and why</h3>
          <ul>{d.excluded.map((c) => <li>{c}</li>)}</ul>
        </>
      )}
    </section>

    {/*
      ── 나가는 길 (2026-08-07 18:0x, 손님으로 걸어 보고) ──────────
      기사에서 나가는 링크가 **셋뿐**이었다 — / · /about · /corrections.
      **자기가 쓴 자료 지면으로도, 다른 기사로도 안 갔다.** 지면→기사는 걸리는데
      기사→지면이 안 걸리는 한쪽 길이었다. 다 읽으면 막다른 곳이었다.

      ⛔ 「관련 기사」를 손으로 고르지 않는다. `pages` 를 공유하는 기사를 규칙으로 뽑는다.
         손으로 고르면 다음 기사를 낼 때 빠진다 — 8/7 에 12편 중 7편이 그랬다.
    */}
    {d.pages.length > 0 && (
      <section class="onward">
        <h3>The data behind this</h3>
        <ul>{d.pages.map((p) => <li><a href={p}>{p}</a></li>)}</ul>
      </section>
    )}

    {이웃.length > 0 && (
      <section class="onward">
        <h3>Written from the same data</h3>
        <ul>{이웃.map((e) => <li><a href={`/article/${e.id}`}>{e.data.title}</a></li>)}</ul>
      </section>
    )}

    {/*
      🔴🔴 2026-08-24 밤 — **카드뉴스 96벌 474장이 어느 지면에도 안 걸려 있었다.**
      사장님 「방문자 늘리는 데 올인하라」로 세다가 오늘 밤 세 번째 같은 흠을 잡았다 —
        ① 숏영상 21편   → VideoObject 스키마 0장
        ② 숏영상 21편   → 비디오 사이트맵 9편
        ③ 카드뉴스 96벌 → 지면에 0벌 · 사이트맵에 0벌   ← 여기다
      사장님 지시(2026-08-13): 「이건 **외부유입용** 콘텐트 역할도 하고, 우리를 알리는 거니까」.
      ⛔ 서버에 있는 것과 «걸린 것»은 다르다. 만든 값을 다 치르고 노출이 0이었다.
      ⭐ 구글 이미지는 웹 검색과 다른 자리다. 474장이 그 자리에 하나도 없었다.

      ⛔ 벌이 없는 기사는 아무것도 안 그린다(21편이 그렇다). 빈 상자는 없는 것만 못하다.
      ⛔ 장수를 손으로 적지 않는다 — `build-kcw-cardnews-index.mjs` 가 파일을 세어 적는다.
      ⚠ `loading="lazy"` 다. 다섯 장이 기사 맨 아래에 있으니 먼저 내려받을 까닭이 없다.
    */}
    {카드뉴스 && (
      <section class="cardnews">
        <h3>Take this away — {카드뉴스.sq.length + 카드뉴스.v.length} cards</h3>
        <p class="note">
          The figures in this article, as images. Free to repost with the address on them.
        </p>
        <div class="cards">
          {카드뉴스.sq.map((n: number) => (
            <img src={`/cardnews/${카드뉴스.set}-sq-${n}.png`} width="1080" height="1080"
              loading="lazy" decoding="async"
              alt={`${entry.data.title} — card ${n} of ${카드뉴스.sq.length}`} />
          ))}
          {카드뉴스.v.map((n: number) => (
            <img src={`/cardnews/${카드뉴스.set}-v-${n}.png`} width="1080" height="1920"
              loading="lazy" decoding="async"
              alt={`${entry.data.title} — tall card ${n} of ${카드뉴스.v.length}`} />
          ))}
        </div>
      </section>
    )}

    {/*
      ⛔ 광고 자리가 아니다. Riot Production(App 866800) 승인 전이라 광고는 아직 하나도 없다.
      ⛔ 60편에 같은 꼬리를 손으로 붙여 넣지 않는다 — 틀에 한 번 둔다.
      ⚠ 그래도 문구가 예순 편에 똑같이 뜨므로, **이 기사가 쓴 지면 이름**을 넣어 다르게 만든다.
    */}
    <section class="onward b2b">
      <h3>If you work in this business</h3>
      <p>
        Everything on this page is measured from the same weekly Netflix lists, per market and per
        title. We publish the pages free; what we sell is the same measurement cut to one company's
        catalogue{d.pages && d.pages.length > 0 ? ' — including the figures behind ' : ''}
        {d.pages && d.pages.length > 0 && d.pages.map((p, i) => (
          <>{i > 0 ? ' and ' : ''}<a href={p}>{p}</a></>
        ))}.
      </p>
      <p><a href="/for-industry">What a company sheet contains, and what it cannot tell you &rarr;</a></p>
    </section>

    <p class="back">
