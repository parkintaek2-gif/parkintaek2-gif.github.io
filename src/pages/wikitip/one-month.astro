---
/**
 * K Culture Wire — **이스포츠 선수의 한 해는 한 달이다.** (`/one-month`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   77편째에서 「베트남만 이스포츠 60.6%」를 냈다. 다음 물음은 **언제 읽히나**였다.
 *   ⭐ 이스포츠 열한 명이 **전원 같은 한 달**에 몰렸다. 축구 아홉은 흩어졌다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * 🔴 **「대회 때문」이라고 안 쓴다.** 잰 것은 「그 달에 몰렸다」이고 대회 날짜는 달력이다.
 *    둘을 **나란히** 놓고 독자가 읽게 둔다. `correlationNotCause` 를 반드시 화면에 낸다.
 * ⛔ 사람을 줄세우지 않는다. 몰림으로 놓고 왜 다른지를 적는다.
 * ⚠ 은퇴 선수를 대조군으로 남긴다 — 이벤트가 없는 사람의 모양이 없으면
 *   「몰렸다」가 무엇에 견준 말인지 알 수 없다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-one-month.json';

const 종목이름: Record<string, string> = {
  football: 'Football', esports: 'Esports', baseball: 'Baseball', golf: 'Golf', mma: 'MMA',
};
/**
 * 🔴 `new Date('2025-11-01')` 은 **UTC 로 읽힌다.** KST 에서 하루 어긋나 10월이 될 수 있다.
 *   달 이름만 필요하니 날짜를 만들지 않고 **글자에서 바로 뽑는다.**
 */
const 달글자 = ['January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'];
const 달이름 = (m: string) =>
  (m && m.length === 6 ? `${달글자[Number(m.slice(4, 6)) - 1]} ${m.slice(0, 4)}` : '—');

const 이스포츠 = d.bySport.find((x) => x.sport === 'esports');
const 축구 = d.bySport.find((x) => x.sport === 'football');

/* ⛔ 이름을 손으로 안 박는다 — 자료에서 뽑는다. 자료가 바뀌면 제목이 따라 바뀐다 */
const e스포츠 = (d.people ?? []).filter((p) => /esport/i.test(p.sport ?? "")).sort((a, b) => b.totalReads - a.totalReads);
const 축구사람 = (d.people ?? []).filter((p) => /foot/i.test(p.sport ?? "")).sort((a, b) => b.totalReads - a.totalReads);

const TITLE = `${e스포츠[0].name} and ${e스포츠[1].name} get a year of readers in one month. `
  + `${축구사람[0].name} never does`;
const DESC =
  `We split twelve months of Southeast Asian Wikipedia reads by month. All ${이스포츠?.people} `
  + `esports players in the panel peak in the same month; only ${축구?.peopleSharingThatMonth} of `
  + `${축구?.people} footballers share theirs. An even year would put ${d.evenMonthSharePc}% in each month.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/', 'https://www.wikidata.org'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/one-month">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    If a year's reads were spread evenly, the busiest month would hold <b>{d.evenMonthSharePc}%</b>.
    {' '}All <b>{이스포츠?.people}</b> esports players here peak in {달이름(이스포츠?.commonestPeakMonth ?? '')},
    and their busiest month holds between {이스포츠?.minPeakSharePc}% and {이스포츠?.maxPeakSharePc}%.
  </p>

  <section>
    <h2>Two sports, two shapes</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Sport</th><th>People</th><th>Median busiest-month share</th>
          <th>Range</th><th>Commonest peak</th><th>Sharing it</th></tr></thead>
        <tbody>
          {d.bySport.map((s) => (
            <tr>
              <td class="nm">{종목이름[s.sport] ?? s.sport}</td>
              <td class="tot">{s.people}</td>
              <td class="tot">{s.medianPeakSharePc}%</td>
              <td>{s.minPeakSharePc}–{s.maxPeakSharePc}%</td>
              <td>{달이름(s.commonestPeakMonth)}</td>
              <td class="fine">{s.peopleSharingThatMonth} of {s.people}
                {s.allSameMonth ? ' — all of them' : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      The range matters as much as the median. The least concentrated esports player still has
      {' '}{이스포츠?.minPeakSharePc}% of a year in one month. The least concentrated footballer has
      {' '}{축구?.minPeakSharePc}%, which is close to what an even year would give.
    </p>
  </section>

  <section>
    <h2>Every person, and what else was on that month</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Name</th><th>Sport</th><th>Busiest month</th>
          <th>Its share</th><th>Reads in the year</th><th>What else was on that month</th></tr></thead>
        <tbody>
          {d.people.map((x) => (
            <tr>
              <td class="nm">{x.name}</td>
              <td class="fine">{종목이름[x.sport] ?? x.sport}</td>
              <td>{달이름(x.peakMonth)}</td>
              <td class="tot">{x.peakSharePc}%</td>
              <td>{x.totalReads.toLocaleString('en-US')}</td>
              <td class="fine">{x.whatElseWasThatMonth ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {d.acrossYears && (
    <section>
      <h2>Does the same month come back every year?</h2>
      <p class="note">
        One year is one point. To see whether this is a property of the sport rather than of 2025,
        we ran the same measure back to {d.acrossYearsWindow?.split(' ')[0]}. A person is counted
        for a year only if their article was already being read before that year began, and only if
        it drew at least {d.acrossYearsMinReads} reads that year.
      </p>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Year</th><th>Esports: sharing a peak month</th>
            <th>Football: sharing a peak month</th></tr></thead>
          <tbody>
            {d.acrossYears.map((r) => (
              <tr>
                <td class="nm">{r.year}</td>
                <td class={r.esports?.allSame ? 'tot' : ''}>
                  {r.esports
                    ? `${r.esports.sharing} of ${r.esports.people} in ${달이름(`${r.year}${r.esports.month}`)}`
                    : '—'}
                  {r.esports?.allSame ? ' — all of them' : ''}
                </td>
                <td>
                  {r.football
                    ? `${r.football.sharing} of ${r.football.people} in ${달이름(`${r.year}${r.football.month}`)}`
                    : '—'}
                  {r.football?.allSame ? ' — all of them' : ''}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    <p class="note">
      {d.footballNeverUnanimous ? (
        <span>
          The footballers reach agreement in <b>0</b> of the {d.acrossYears.length} years measured;
          their best is{' '}
          {Math.max(...d.acrossYears.map((r) => r.football?.sharing ?? 0))} of{' '}
          {Math.max(...d.acrossYears.map((r) => r.football?.people ?? 0))}. The esports players
          reach it in <b>{d.acrossYears.filter((r) => r.esports?.allSame).length}</b> of{' '}
          {d.acrossYears.filter((r) => r.esports).length}.
        </span>
      ) : (
        <span>Both groups reach agreement in at least one year.</span>
      )}
    </p>
      <p class="warn">{d.whyPartialYearsAreExcluded}</p>
    </section>
  )}

  <section class="warn-box">
    <h2>The last column is a calendar, not a cause</h2>
    <p class="warn">{d.correlationNotCause}</p>
    <ul>
      {d.calendar.map((c) => (
        <li><b>{c.event}</b> — {c.note}</li>
      ))}
    </ul>
  </section>

  <section class="src">
    <h2>How this was counted, and what it cannot say</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Window</b> — {d.window}</li>
      <li><b>Unit</b> — {d.unit}</li>
    </ul>
    <p class="warn">{d.cannotAnswer}</p>
    <p class="note">
      <a href="/sea-athletes">Four Southeast Asian Wikipedias, four different athletes</a> ·{' '}
      <a href="/esports">How esports titles travel</a> · <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/one-month" />
</WikiTip>

<style>
  .warn-box { border-left: 3px solid #b45309; padding-left: 1rem; }
</style>
