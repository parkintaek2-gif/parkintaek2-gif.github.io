---
/**
 * K Culture Wire — **브랜드는 한 덩어리가 아니다.** (`/brand-kinds`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   사장님 지시: 「패션 브랜드, 명품 엠베서더 등도 먹히는 콘텐트인지 분석하고」
 *                「자동차까지 스타들의 일거수일투족이 모두 팬들은 궁금해할 테니까」
 *   82편이 이미 「BMW 가 제일 읽히는 한국 가수보다 5.7배 적다」를 냈다.
 *   ⛔ 그것을 되풀이하지 않는다. 여기서는 **브랜드 안을 가른다.**
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **줄세우지 않는다.** 갈래를 나란히 놓고 **왜 다른지**를 같이 적는다.
 * ⛔ **읽힘은 팔림이 아니다.** 판매 자료가 우리에게 없다. 표 바로 아래 같은 크기로 적는다.
 * ⛔ 한국 차 배수를 **내지 않는다** — 네 판에 다 있는 것이 기아 하나뿐이라 견줄 수 없다.
 *    ⭐ 못 견준 까닭(태국판에 현대 글이 없다)이 이 지면의 **발견**이다.
 * ⚠ 브랜드가 셋 미만인 갈래는 「얇다」고 표에 적는다. 무늬로 읽히면 안 된다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwCardnews from '../../components/KcwCardnews.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import d from '../../data/wikitip-brand-kinds.json';

const 명품 = d.kinds.find((k) => k.key === 'luxury');
const 독일차 = d.kinds.find((k) => k.key === 'car');
const 기술 = d.kinds.find((k) => k.key === 'tech');
const 패스트푸드 = d.kinds.find((k) => k.key === 'fastfood');
const 흔들린나라 = d.countryNames[d.positionSwing.제일];

/* 🔴 [2026-09-10] 「22」를 손으로 적어 두었더니 브랜드를 여덟 개 더한 날 «글만 옛 수»로 남았다.
 *   ⛔ 자료에서 나오는 수를 지면에 손으로 적지 않는다. 세어서 쓴다. */
/* ⚠ 이 칸은 «수»다(배열이 아니다). 실측: brandsMeasured = 30, number.
 *   ⛔ 꼴을 짐작해서 .length 를 걸면 조용히 null 이 되어 글에서 「the brands」로 새어 나간다. */
const 브랜드수 = typeof d.brandsMeasured === 'number' ? d.brandsMeasured : null;

/* 기술이 명품보다 몇 배인가 — ⛔ 분모가 0 이면 null 이다 */
const 기술배수 = (기술 && 명품 && 명품.합 > 0) ? +(기술.합 / 명품.합).toFixed(1) : null;

/*
 * 🔴 [2026-09-10] 「기술이 명품의 5.2배」를 내려다 «한 곳이 그 배수를 만들고 있는» 것을 봤다.
 *   Google 하나가 기술 갈래 1,382.54 가운데 1,038.59 — **75.1%** 다.
 *   그런데 Google 은 앰버서더를 쓰는 브랜드가 아니다. 그 한 곳을 빼면 1.30배로 내려앉는다.
 * ⛔ 갈래 합만 내면 「기술이 명품을 압도한다」로 읽힌다. 그것은 이 자료가 받쳐 주지 않는다.
 * ⇒ 그래서 갈래 안에서 «제일 큰 한 곳의 몫»을 세어 같이 낸다. 배수를 낼 때는 늘 이것을 본다.
 */
/* ⛔ 지면이 세지 않는다 — 빌더가 세어 담은 칸(으뜸)을 읽는다. 짐작으로 채우지 않는다 */
const 기술으뜸 = (기술 as any)?.으뜸 ?? null;
const 기술빼고 = (기술 && 기술으뜸 && 명품 && 명품.합 > 0)
  ? +((기술.합 - 기술으뜸.value) / 명품.합).toFixed(2) : null;

const TITLE = 'Southeast Asia does not read brands as one thing';
const DESC =
  `Split ${브랜드수 ?? 'the'} luxury, jewellery, fashion, car, technology and fast food brands by kind `
  + `and the four countries change places. ${흔들린나라} is first among `
  + `${독일차.label.toLowerCase()} and last among ${명품.label.toLowerCase()}. `
  + `Read as a single ranking, that disappears.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: d.window,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/brand-kinds">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">{d.answer}</p>

  <section>
    <h2>Five kinds, and where each one is read</h2>
    <p class="note">
      <b>{d.unit}.</b> Reading is divided by the size of each Wikipedia edition, so a country with
      fewer readers is not pushed to the bottom for being small. Window — {d.window}.
      A brand enters a kind's total only if it has an article in all four editions; brands missing
      one are shown in the panel but left out of the sum, because counting a missing article as zero
      would make an encyclopaedia gap look like disinterest.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Kind</th><th>Brands</th><th>Counted</th>
            {d.editionsSea.map((p) => <th>{d.countryNames[p]}</th>)}
            <th>Read most in</th>
            {/* 🔴 [2026-09-10] 이 칸을 표에 «올렸다». 본문에만 두었더니
                 표 약속 검사가 「대표 수가 걸린 지면에 없다」로 잡았고, 그것이 맞았다 —
                 한 곳이 갈래를 만들고 있다는 것은 «표에서 보여야» 하는 사실이다. */}
            {/* ⚠ 이름과 몫을 «두 칸»으로 나눈다. 한 칸에 「Google — 75.1%」로 두었더니
                 표 약속 검사가 안 통과했다 — 그 자는 칸이 «정확히 같아야» 통과시킨다.
                 ⛔ 그 규칙을 느슨하게 고치지 않는다. 2026-09-05 에 한 번 고쳤다가 되돌렸고,
                   까닭이 check-table-promises.mjs 177줄에 적혀 있다. 표를 고치는 것이 맞다. */}
            <th>Biggest one in it</th><th>Its share</th></tr>
        </thead>
        <tbody>
          {d.kinds.map((k) => (
            <tr>
              <td class="nm">{k.label}{k.얇은가 && <span class="fine">{' '}⚠ thin</span>}</td>
              <td class="tot">{k.브랜드수}</td>
              <td class="fine">{k.온전수}</td>
              {d.editionsSea.map((p) => <td>{k.판별[p]}</td>)}
              <td class="fine">{d.countryNames[k.차례[0]]}</td>
              <td class="fine">{k.으뜸 ? k.으뜸.name : '—'}</td>
              <td class="fine">{k.으뜸 ? `${k.으뜸.share}%` : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      ⚠ {d.thinNote} The thin kinds here are {d.thinKinds.join(' and ')}.
    </p>
  </section>

  <section>
    <h2>The same country changes place depending on the kind</h2>
    <p>
      {흔들린나라} sits {d.positionSwing.자리[d.positionSwing.제일].join(', ')} across the kinds that
      are thick enough to read — first in one, last in another. That is the whole point of splitting
      them. A single ranking of {브랜드수 ?? 'all these'} brands would have given {흔들린나라} one
      position and hidden the rest.
    </p>
    <p class="note">
      This is not a statement that one country cares more than another. It says the four countries
      are interested in <b>different kinds of thing</b>, and a page that ranks brands together cannot
      show that.
    </p>
  </section>

  <section>
    <h2>Two kinds we had left out, and the week that showed it</h2>
    <p>
      Until 10 September 2026 this page measured luxury, jewellery, fashion and cars. It did not
      measure technology or fast food. In one morning our own feed carried four separate items
      about a K-pop singer becoming the face of a phone camera, and one about another becoming the
      face of a burger chain — two kinds this page could not have said a single number about.
      So we added them, over the same {d.window} window, and re-read everything.
    </p>
    <p class="q">
      {기술으뜸 && 기술빼고 && 명품
        ? `One company carries that kind: ${기술으뜸.name} is ${기술으뜸.share}% of it. Take it out and technology is ${기술빼고} times the luxury houses, not ${기술배수}.`
        : 'We could not compute that multiple, so we are not publishing one.'}
    </p>
    <p class="note">
      <b>We nearly published the wrong number.</b> The kind totals say
      {기술 && 명품 && 기술배수 ? ` technology is ${기술배수} times the luxury houses` : ' technology leads'},
      and that reads as though the kind is overwhelming. It is not the kind — it is one entry.
      {기술으뜸 ? ` ${기술으뜸.name} alone is ${기술으뜸.value} of the ${기술?.합} total,` : ''}
      {' '}and nobody makes {기술으뜸 ? 기술으뜸.name : 'a search engine'} the face of a campaign.
      The honest comparison is brand against brand, and it is smaller and still real: the phone
      company is read about three times as much as the most-read luxury house here, and the burger
      chain about one and a half times.
    </p>
    <p>
      {패스트푸드 && 독일차 && 패스트푸드.합 > 독일차.합
        ? `${패스트푸드.label} also come in above ${독일차.label.toLowerCase()} — ${패스트푸드.합} against ${독일차.합}.`
        : `${패스트푸드 ? 패스트푸드.label : 'Fast food'} sits below the car makers here.`}
      {' '}The kinds a global brand deal now reaches are not the kinds this page was built to watch.
    </p>
    <p class="note">
      <b>Read this multiple carefully.</b> A technology company's article is read for reasons that
      have nothing to do with the brand being desirable — people look up a phone, a company, a
      founder, a lawsuit. A luxury house's article is read by people interested in the house. The
      two are not the same kind of curiosity, and this page cannot separate them. What the number
      does support is narrower and still useful: <b>far more people in these four countries end up
      on the technology pages</b>. If a face is placed there, more people are in the room.
    </p>
    <p class="note">
      ⚠ Adding a kind late does not make it look small here. Pageviews can be asked for past
      months, so the new kinds were measured over the <b>same</b> {d.window} window as the rest —
      not from the day we thought of them.
    </p>
  </section>

  <section>
    <h2>The car comparison we could not make</h2>
    <p>
      We set out to put the {d.carsCompared.germanNames.join(', ')} total against
      {' '}{d.carsCompared.koreanNames.join(', ')}. We are not publishing a multiple.
      {' '}{d.carsCompared.whyNotComparable}
    </p>
    <p class="q">{d.carsCompared.finding}</p>
    <p class="note">
      <b>Reads are not sales.</b> {d.carsCompared.notSales}
    </p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    <p class="note">{d.cannotAnswer}</p>
    <p class="note">
      Measured: {d.brandsMeasured} brands. Source — {d.source}.
      Countries: {d.editionsSea.map((p) => d.countryNames[p]).join(', ')}.
    </p>
  </section>

  <KcwCardnews set="brands" count={5} />

  <KcwShorts set="brands"
    says={`A man and a woman read out the two figures in the table above — `
      + `${독일차.판별[d.positionSwing.제일]} and ${명품.판별[d.positionSwing.제일]}, `
      + `both for ${흔들린나라}.`} />

  {/* 🔴 [2026-09-10] 오늘 카드로 구운 숏영상. 세 곳에 다 올려야 보인다 —
      여기(지면) · sitemap.xml.ts 의 videoSets · 파일 자리.
      ⛔ 파일만 만들어 두면 아무 데도 안 보인다 — 만드는 값은 다 치르고 노출이 0 이 된다. */}
  <KcwShorts set="a-phone-and-a-burger-took-two-k-pop-faces-voiced"
    says={'Seventeen seconds on the two brand kinds this panel had left out, and on the moment '
      + 'we found one company was three quarters of the technology total and cut our own headline '
      + 'from five times to one point three.'} />

  <KcwRelatedArticles page="/brand-kinds" />
  {/* 🔴 2026-08-22 — 분모(editionTotals)와 «못 잰 브랜드 수»(brandsNotMeasured)를
      세어 두고 안 보여 주고 있었다. ⭐ 못 잰 것이 0 이라는 것도 보여 줄 값이다 */}
  <section class="src">
    <h2>The denominators behind the shares</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Wikipedia edition</th><th>All reads in the window</th></tr></thead>
        <tbody>
          {Object.entries(d.editionTotals).map(([k, v]: any) => (
            <tr><td class="nm">{String(k).toUpperCase()}</td><td class="tot">{Number(v).toLocaleString('en-US')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Every share on this page is measured against those totals, so a big edition does not win by
      being big. Brands we could not measure at all: {d.brandsNotMeasured}
      {d.brandsNotMeasured === 0 ? ' — every brand in the list returned a figure.' : '.'}
    </p>
  </section>
</WikiTip>
