---
/**
 * K Culture Wire — **순회공연이 가는 도시의 말로는 누가 읽나.** (`/tour-city-languages`)
 *
 * 🔴 [2026-09-05] 포털 연예면에서 왔다. 유노윤호가 아시아 일곱 도시를 도는 중이고
 *   오늘이 타이베이, 9/12 자카르타, 9/26 홍콩이다.
 *
 * ⭐ 남들이 내는 것 — 도시·날짜·표. 우리는 그것을 못 이긴다.
 * ⭐ **우리 축** — 「그 도시의 말로 그를 읽는 사람이 하루 몇 명인가.」
 *   재 보니 가장 많이 읽는 말(영어 120.7)이 일곱 도시 가운데 «한 곳»에서만 공용어다.
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 열람수를 인기·표·관객으로 읽지 않는다. 문서를 하루 몇 번 열었나일 뿐이다.
 * ⛔ **문서가 없는 것을 0 으로 세지 않는다.** 말레이어·타밀어·광둥어는 «문서가 없다».
 * ⛔ 「이 도시에 가지 말았어야 했다」로 읽히게 쓰지 않는다 — 우리는 그 판단의 자료가 없다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-tour-city-languages.json';

type 말 = { wiki: string; title: string | null; exists: boolean; perDay: number | null; days: number | null };
type 도시 = {
  city: string; country: string; note: string; wikis: string[];
  withArticle: number; ofLanguages: number;
  perDay: { wiki: string; perDay: number | null; exists: boolean }[];
};

const 말이름: Record<string, string> = {
  en: 'English', zh: 'Chinese', ko: 'Korean', th: 'Thai', id: 'Indonesian',
  pt: 'Portuguese', ms: 'Malay', ta: 'Tamil', yue: 'Cantonese',
};

const 말들 = (d.languages as any[]) as 말[];
const 도시들 = (d.cities as any[]) as 도시[];
const 있는말 = 말들.filter((r) => r.exists && r.perDay !== null).sort((a, b) => (b.perDay ?? 0) - (a.perDay ?? 0));
const 없는말 = 말들.filter((r) => !r.exists);
const 으뜸 = 있는말[0];
const 한국어 = 말들.find((r) => r.wiki === 'ko');
const 인니어 = 말들.find((r) => r.wiki === 'id');

/* 🔴 제목·본문이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (!으뜸 || !한국어 || !인니어) throw new Error('영어·한국어·인도네시아어 줄이 다 있어야 이 지면의 말이 선다.');
if (으뜸.wiki !== 'en') throw new Error(`가장 많이 읽는 말이 ${으뜸.wiki} 다 — 제목이 영어를 앞세우고 있다. 다시 쓴다.`);
if (없는말.length === 0) throw new Error('문서가 없는 말이 하나도 없다 — 이 지면의 둘째 마디가 사라졌다.');
if (도시들.length !== 7) throw new Error(`도시가 ${도시들.length}곳이다 — 일곱 도시라고 적고 있다.`);

/* 영어가 공용어인 도시는 몇 곳인가 — 손으로 안 박고 자료에서 센다 */
const 영어도시 = 도시들.filter((c) => c.wikis.includes('en'));

const 쉼표 = (n: number | null) => (n === null ? '—' : Number(n).toLocaleString('en-US'));
const 배 = 으뜸.perDay && 인니어.perDay ? Math.round((으뜸.perDay / 인니어.perDay) * 10) / 10 : null;

/**
 * 🔴 제목은 «잘려도 논점이 남게» 짠다. 구글은 대략 60자에서 자른다.
 *   처음에 「… The language that reads him most is official in one of them」으로 썼더니
 *   잘린 앞부분에 일정만 남아 남들 기사와 구별이 안 됐다. 자(check-kcw-title-length)가 잡았다.
 * ⛔ 설명도 155자 안에 든다 — 넘으면 뒤가 잘리고, 하필 «클릭할 까닭»이 뒤에 있다.
 */
const TITLE = `${d.person.label}'s 7 tour cities and the languages that read him`;
const DESC =
  `Daily Wikipedia views for ${d.person.label} in every language his seven 2026 tour cities speak. `
  + `English leads at ${으뜸.perDay}; Indonesian, where he plays, runs ${인니어.perDay}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  temporalCoverage: d.window,
  variableMeasured: 있는말.map((r) => `${말이름[r.wiki] ?? r.wiki} Wikipedia views per day`),
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/tour-city-languages">
  <h1>{TITLE}</h1>

  <p class="lead">
    A tour picks cities. Reading picks languages. They are not the same map, and nobody had put the two
    side by side, so we did.
  </p>

  <h2>Every language spoken in a tour city, ranked by how much it reads him</h2>

  <div class="scroll-x">
    <table>
      <caption>Daily average Wikipedia article views, {d.window}. A view is a page open, not a person.</caption>
      <thead><tr><th>Language</th><th>Views a day</th><th>Article title</th><th>Tour cities that speak it</th></tr></thead>
      <tbody>
        {있는말.map((r) => (
          <tr>
            <th scope="row">{말이름[r.wiki] ?? r.wiki}</th>
            <td class="num">{쉼표(r.perDay)}</td>
            <td><code>{r.title}</code></td>
            <td>{도시들.filter((c) => c.wikis.includes(r.wiki)).map((c) => c.city).join(', ')}</td>
          </tr>
        ))}
        {없는말.map((r) => (
          <tr class="gap">
            <th scope="row">{말이름[r.wiki] ?? r.wiki}</th>
            <td class="num">no article</td>
            <td>&mdash;</td>
            <td>{도시들.filter((c) => c.wikis.includes(r.wiki)).map((c) => c.city).join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    <b>&ldquo;No article&rdquo; is not zero.</b> {없는말.map((r) => 말이름[r.wiki] ?? r.wiki).join(', ')} have no
    Wikipedia article about him in that language at all. That is a different fact from an article nobody opens,
    and we do not fold the two together.
  </p>

  <h2>City by city</h2>

  <div class="scroll-x">
    <table>
      <caption>The seven announced cities, and how many of each city's languages carry an article</caption>
      <thead><tr><th>City</th><th>Languages there</th><th>With an article</th><th>Views a day</th></tr></thead>
      <tbody>
        {도시들.map((c) => (
          <tr>
            <th scope="row">{c.city}<span class="sub">{c.country}</span></th>
            <td>{c.wikis.map((w) => 말이름[w] ?? w).join(', ')}</td>
            <td class="num">{c.withArticle} of {c.ofLanguages}</td>
            <td class="num">
              {c.perDay.map((p) => (p.exists ? `${말이름[p.wiki] ?? p.wiki} ${p.perDay}` : `${말이름[p.wiki] ?? p.wiki} —`)).join(' · ')}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    Taipei, Macau and Hong Kong draw on the same Chinese edition, so their figure is one well shared three
    ways rather than three separate readerships. We say that here rather than let the table imply otherwise.
  </p>

  <h2>What the two tables together say</h2>

  <p>
    English is the language that opens his article most often, at <b>{으뜸.perDay} a day</b>. Of the seven
    cities, English is an official language in {영어도시.length === 1 ? 'exactly one' : `${영어도시.length}`}
    {' '}&mdash; {영어도시.map((c) => c.city).join(', ')}. Indonesian, where he plays on 12 September, runs
    {' '}<b>{인니어.perDay} a day</b>{배 ? `, about ${배} times lower` : ""}. Korean, his own language, runs
    {' '}<b>{한국어.perDay}</b> &mdash; below Chinese.
  </p>

  <p>
    We are not saying the tour picked the wrong cities. A tour is booked on venues, promoters, visas and
    who will buy a ticket, and we can measure none of those. What we can say is narrower and still worth
    knowing: <b>the audience that reads about him is largest in a language that only one stop on the tour
    speaks.</b>
  </p>

  <h2>Where else we use this</h2>
  <p class="walk">
    <a href="/which-language-reads-you">Which language reads a Korean star</a> &middot;{' '}
    <a href="/how-many-languages">How many languages carry a Korean entertainer at all</a> &middot;{' '}
    <a href="/who-reads-least">Who reads least</a>
  </p>

  <KcwMethodLimits
    method={{
      'What this is': d.whatThisIs,
      'How we counted': `Wikidata gave us which language editions carry an article about him. For each one `
        + `we asked the Wikimedia pageviews API for daily human views over ${d.window} and took the mean. `
        + `Languages were attached to cities by hand, and the reason for each is printed in the city table.`,
      'Why these cities': d.tourNote,
    }}
    limitation={{
      'What this is not': 'Not ticket sales, not attendance, not popularity. A Wikipedia view is one page '
        + 'open. It is the one thing here we can count exactly, so it is the only thing we claim.',
    }} />

  <h2>What we could not measure</h2>
  <ul>{d.notMeasured.map((s: string) => <li>{s}</li>)}</ul>

  <p class="asof">Measured {d.measuredAt}. Window {d.window}.</p>

  <KcwRelatedArticles page="/tour-city-languages" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; vertical-align: top; }
  th { background: #fafbfc; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.gap td, tr.gap th { background: #fdf6ec; }
  .sub { display: block; font-size: .8rem; font-weight: 400; color: #666; }
  .note { font-size: .95rem; color: #555; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  code { font-size: .92em; }
  @media (prefers-color-scheme: dark) {
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    tr.gap td, tr.gap th { background: #2a2317; }
    .note, .sub { color: #aaa; }
    .asof { color: #999; }
  }
</style>
