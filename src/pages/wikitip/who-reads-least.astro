---
/**
 * K Culture Wire — **1등은 바뀌는데 꼴찌는 안 바뀐다.** (`/who-reads-least`)
 *
 * ⭐⭐ 사장님 지시(8/16) — 표 첫 칸이 **이름**이다. 손님은 「BTS」와 「IU」를 친다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔⛔ **「말레이시아가 한국에 관심 없다」로 안 읽는다.** 말레이어와 인도네시아어는 서로 통해서
 *    말레이시아 손님이 **인도네시아어판을 읽을 수** 있다. 이 자료로는 못 가른다 —
 *    그 문장을 첫 화면 가까이에 둔다. 뒤에 숨기지 않는다.
 * ⛔ **「판이 작아서」는 답이 아니다.** 백만분율이라 판 크기는 이미 나눠져 있다.
 *    다만 작은 판은 수가 출렁인다 — 그 말도 적는다.
 * ⛔ 네 판 다 문서가 있는 사람만 견준다. 없는 문서를 0 으로 안 센다.
 * ⛔ 광고 자리를 만들지 않는다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다 — 붙여 쓸 곳에 {' '} 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-last-place.json';

const 꼴 = d.mostOftenLast;
const 위 = d.topOfList;

const TITLE = 'BTS, Babymonster and Byeon Woo-seok are read most in three different countries — '
  + 'and least in the same one';
const DESC =
  `Across ${d.peopleInAllFour} Korean stars with an article on all four Southeast Asian `
  + `Wikipedias, the Thai, Vietnamese and Indonesian editions all take first place for someone. `
  + `The ${d.editionNames[꼴]} edition comes last for ${d.last[꼴]} of them — and for all `
  + `${위.looked} of the most-read.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/who-reads-least">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    <b>BTS</b> is read most in Vietnam, <b>Byeon Woo-seok</b> in Thailand, and someone else in
    Indonesia. First place moves around. Last place does not: of {d.peopleInAllFour} Korean stars
    with an article on all four editions, the {d.editionNames[꼴]} one comes last for
    {' '}<b>{d.last[꼴]}</b> — <b>{d.lastSharePc}%</b> — and for
    {' '}<b>all {위.looked}</b> of the most-read.
  </p>

  <section class="warn-box">
    <h2>Read this before the tables</h2>
    <p class="warn">{d.theOtherExplanation}</p>
    <p class="note">
      Reads here are per million reads of that whole Wikipedia, so the size of each edition is
      already divided out. This is not a claim that one encyclopaedia is small.
    </p>
  </section>

  <section>
    <h2>How often each edition is first, and last</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Wikipedia</th><th>First for</th><th>Last for</th></tr>
        </thead>
        <tbody>
          {d.editions.map((e) => (
            <tr>
              <td class="nm">{d.editionNames[e]}</td>
              <td>{d.first[e]}</td>
              <td><b>{d.last[e]}</b></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Three editions share first place between them. One takes last place four times out of five.
    </p>
  </section>

  <section>
    <h2>The most common orders</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Order, most read to least</th><th>Stars</th><th>Share</th></tr>
        </thead>
        <tbody>
          {d.commonestOrders.map((o) => (
            <tr>
              <td class="nm">{o.order.split('>').map((e) => d.editionNames[e]).join(' → ')}</td>
              <td>{o.count}</td>
              <td class="fine">{o.sharePc}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Every one of the six most common orders ends the same way. The disagreement is entirely at
      the top.
    </p>
  </section>

  <section>
    <h2>The {위.looked} most-read Korean stars, country by country</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Star</th>{d.editions.map((e) => <th>{d.countryNames[e]}</th>)}
            <th>Read most in</th><th>Highest ÷ lowest</th></tr>
        </thead>
        <tbody>
          {위.people.map((p) => (
            <tr>
              <td class="nm">{p.name}</td>
              {d.editions.map((e) => (
                <td class={p.byEdition[e] === Math.min(...d.editions.map((x) => p.byEdition[x]))
                  ? 'fine low' : 'fine'}>{p.byEdition[e]}</td>
              ))}
              <td>{d.countryNames[p.most]}</td>
              <td>{p.mostOverLeast}×</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Reads per million reads of that edition, twelve months. The lowest figure in each row is
      marked. {d.dedupeNote}
    </p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">{d.limitation}</p>
    <p class="note">
      Source — {d.source}. Window — {d.window}. Related:
      {' '}<a href="/malaysia">Malaysia reads Korean brands more readily than Korean people</a>.
    </p>
  </section>

  <KcwRelatedArticles page="/who-reads-least" />
</WikiTip>

<style>
  .low { color: #b45309; font-weight: 700; }
</style>
