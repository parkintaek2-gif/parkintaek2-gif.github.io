---
/**
 * pickup.astro — **어느 나라가 한국 작품을 먼저 집어 드나.**
 *
 * ── 🔴 왜 이 지면이 생겼나 (2026-09-03) ────────────────────────
 * 「먼저」를 다룬 지면이 둘 있었는데 둘 다 이 물음이 아니었다 —
 * `/who-is-first` 는 위키백과 판이 먼저 «쓰는» 것, `/home-first` 는 한국이냐 밖이냐 두 갈래다.
 * **93개 시장을 줄 세워 「몇 주 늦게 집어 드나」를 잰 적은 없었다.**
 *
 * ── ⛔ 이 지면이 지키는 것 ──────────────────────────────────────
 * ⛔ **중앙값을 머리로 쓰지 않는다.** 재 보니 거의 모든 시장이 0 또는 1 주다 — 작품이 여러
 *   나라에 같은 주에 오르기 때문이다. 그래서 «데뷔 주에 같이 실은 몫»이 실제로 가르는 수다.
 *   중앙값만 내면 시장 사이 차이가 안 보인다.
 * ⛔ 「먼저 본다」로 바꿔 쓰지 않는다. 넷플릭스의 나라별 공개일이 이 수 안에 섞여 있고
 *   우리는 그것을 못 가른다.
 * ⛔ 창 첫 주(2021-07-04)에 데뷔한 작품은 뺐다 — 앞이 잘려 늦음이 작게 나온다. 뺀 편수를 낸다.
 * ⛔ 수를 손으로 적지 않는다. `kcw-pickup-lag.json` 에서 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwDataBasis from '../../components/KcwDataBasis.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import { 목록구조화 } from '../../lib/list-jsonld.ts';
import d from '../../data/kcw-pickup-lag.json';

const 빠른 = d.fastest ?? [];
const 느린 = d.slowest ?? [];
const 수 = (n: number) => Number(n).toLocaleString('en-US');
/* ⛔ 한국은 「집어 드는 시장」이 아니라 대개 데뷔를 «정하는» 쪽이다. 나란히 두되 표시한다 */
const 밖의빠른 = 빠른.filter((m: any) => m.iso2 !== 'KR');
const 집 = 빠른.find((m: any) => m.iso2 === 'KR');

const TITLE = `Which markets pick up a Korean title first`;
const DESC = `${밖의빠른[0] ? `${밖의빠른[0].name} carries a Korean title in the same week it first charts anywhere ${밖의빠른[0].sameWeekAsDebutPc}% of the time` : 'Markets ranked by how soon they carry a Korean title'}; `
  + `${느린[0] ? `${느린[0].name} does it ${느린[0].sameWeekAsDebutPc}%` : ''}. `
  + `${수(d.titlesCounted)} Korean titles across ${d.marketsMeasured} markets.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/pickup"
  jsonLd={목록구조화({
    주소: '/pickup',
    이름: 'Markets by how soon they carry a Korean title',
    설명: DESC,
    줄들: 밖의빠른.map((m: any) => ({ name: m.name })),
  }, ['https://www.kculturewire.com/by-country'])}>
  <h1>Which markets pick up a Korean title first</h1>

  <p class="lead">
    A Korean title first appears on some country&rsquo;s top 10. That week is its debut. We then
    asked, for every other market, how many weeks later it first carried the same title &mdash;
    across <b>{수(d.titlesCounted)}</b> titles and <b>{d.marketsMeasured}</b> markets.
  </p>

  <section>
    <h2>The median is almost useless here. This is why</h2>
    <p>
      Nearly every market&rsquo;s median lag is <b>zero or one week</b>, because a Korean title
      usually enters many charts in the same week. A median cannot separate markets that all sit at
      zero. What separates them is <b>how often</b> they are in that first week at all, so that is
      the column to read.
    </p>
  </section>

  <section>
    <h2>Fastest, excluding Korea</h2>
    <table>
      <thead>
        <tr>
          <th>Market</th><th class="num">In the debut week</th>
          <th class="num">Within four weeks</th><th class="num">Median lag</th><th class="num">Titles</th>
        </tr>
      </thead>
      <tbody>
        {밖의빠른.map((m: any) => (
          <tr>
            <td>{m.name}</td>
            <td class="num"><b>{m.sameWeekAsDebutPc}%</b></td>
            <td class="num">{m.withinFourWeeksPc}%</td>
            <td class="num">{m.medianLagWeeks}</td>
            <td class="num">{m.titles}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {집 && (
      <p class="note">
        Korea itself is at <b>{집.sameWeekAsDebutPc}%</b> on {집.titles} titles, and it is left out of
        the table above on purpose: for most of these titles Korea <b>is</b> the debut week, so
        including it would be scoring a market against a line it drew itself.
      </p>
    )}
  </section>

  <section>
    <h2>Slowest</h2>
    <table>
      <thead>
        <tr>
          <th>Market</th><th class="num">In the debut week</th>
          <th class="num">Median lag</th><th class="num">Titles</th>
        </tr>
      </thead>
      <tbody>
        {느린.map((m: any) => (
          <tr>
            <td>{m.name}</td>
            <td class="num">{m.sameWeekAsDebutPc}%</td>
            <td class="num">{m.medianLagWeeks}</td>
            <td class="num">{m.titles}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      A market low on this table is not slow at watching. It is a market where fewer Korean titles
      chart at all, so the ones that do tend to be the few that build up over weeks rather than
      arrive at once. <b>{느린[0]?.name}</b> has only {느린[0]?.titles} Korean titles in the whole
      five years.
    </p>
  </section>

  <KcwDataBasis
    whatThisIs={d.unit}
    whatThisIsNot={d.whatThisIsNot}
    notes={[d.source, d.whyDebutWeekDropped]}
    counts={[
      { label: 'Chart rows read', value: d.rowsRead },
      { label: 'Korean titles seen', value: d.koreanTitlesSeen },
      { label: 'Titles counted', value: d.titlesCounted },
      { label: 'Titles dropped — debut is our first week', value: d.titlesDroppedAtWindowStart },
      { label: 'Markets measured', value: d.marketsMeasured },
      { label: `Markets dropped — under ${d.minTitlesPerMarket} titles`, value: d.marketsDropped },
    ]} />

  <p class="note">
    Each market&rsquo;s Korean share is on <a href="/by-country">the country page</a>; whether Korea
    charts a title before anyone else is on <a href="/home-first">the home-first page</a>.
  </p>

  <KcwRelatedArticles page="/pickup" />
</WikiTip>

<style>
  table { border-collapse: collapse; width: 100%; margin: 0.8rem 0; }
  th, td { padding: 0.35rem 0.5rem; border-bottom: 1px solid #e5e7eb; text-align: left; }
  th.num, td.num { text-align: right; }
  .num { font-variant-numeric: tabular-nums; }
  .note { font-size: 0.92em; color: #4b5563; }
</style>
