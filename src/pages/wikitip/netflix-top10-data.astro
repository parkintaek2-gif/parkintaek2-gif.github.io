---
/**
 * K Culture Wire — **넷플릭스 Top 10 파일 두 개의 설명서.** (`/netflix-top10-data`)
 *
 * ── 왜 이 지면이 생겼나 (2026-08-22) ──────────────────────────
 * Search Console 실측. 우리에게 오는 검색어 76개 중 **노출 185개가 파일 주소 그 자체**였다 —
 *   "…/tudum/top10?week=2024-11-03"                36노출 · 순위 7.7 · 클릭 0
 *   "…/tudum/top10/data/all-weeks-countries.tsv"   31+22노출 · 순위 9.5~9.8 · 클릭 0
 *   "…/tudum/top10/data/all-weeks-global.tsv"      11+13노출 · 순위 11.2~11.5 · 클릭 0
 * 반대로 스타 이름으로 온 노출은 **1개**였다.
 *
 * ⛔ 순위 7~11 에 있는데 클릭이 0이었다. 자리는 이미 있었고, **그 사람이 물은 것에
 *   우리 지면이 답을 안 하고 있었다.** 그 사람은 기사를 찾는 게 아니다 —
 *   **파일 안에 무엇이 들어 있느냐**를 찾는다. 그 답이 우리 집에 없었다.
 *
 * ── 무엇을 내놓나 ────────────────────────────────────────────
 * ✅ 두 파일을 그날 받아서 직접 센 값(`scripts/measure-netflix-top10-files.mjs`)
 * ✅ **파일이 안 알려 주는 것** — views 가 102주 비어 있는 것, 두 파일이 안 붙는 것
 * ⛔ 파일을 다시 배포하지 않는다. 넷플릭스 주소로 보낸다
 * ⛔ 「이 자료로 이렇게 하세요」라고 안 쓴다. 무엇이 있고 무엇이 없는지만 적는다
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-netflix-files.json';
import titlePages from '../../data/wikitip-title-pages.json';

const 나라파일: any = (d.files ?? []).find((f: any) => f.name.includes('countries'));
const 세계파일: any = (d.files ?? []).find((f: any) => f.name.includes('global'));
const j: any = d.join;

const 빈주 = 세계파일.weeksWithoutAnyViews;
const 빈몫 = ((빈주 / 세계파일.weeks) * 100).toFixed(0);
const 안붙는몫 = ((j.notInGlobal / j.countryTitles) * 100).toFixed(1);
const 으뜸 = j.examples?.[0];

/* ⭐ 파일을 찾아온 사람에게 보여 줄 것 — 우리가 그 파일로 만든 지면. 가장 넓게 퍼진 한국 작품 셋 */
const 우리것 = (titlePages.titles ?? [])
  .filter((t: any) => t.hasPage)
  .sort((a: any, b: any) => b.markets - a.markets)
  .slice(0, 3);

/* 🔴 2026-08-27 06:3x — 79자여서 잘렸다. ⭐ 파일 «이름» 둘이 곧 검색어라 반드시 남긴다 —
   GSC 실측에서 `all-weeks-countries.tsv` 가 노출 36, `all-weeks-global.tsv` 가 14 다.
   앞머리(「Inside Netflix's Top 10 files:」)를 덜어 이름 둘을 다 지키면서 58자로 맞췄다. */
/* 🔴🔴 [2026-09-02 01:4x · 5번] **이 지면이 우리 지면 중 가장 큰데 제목이 값을 안 말했다.**
   ───────────────────────────────────────────────────────────────────────────
   [잰 것 — sc-domain:kculturewire.com · 28일]
     이 지면      노출 117 · 클릭 1 · 순위 **5.3**      ← 우리 지면 중 가장 큰 것
     사이트 전체  노출 889 · 클릭 3 · 검색어 363개
     그 중 51%(225노출)는 **넷플릭스 주소를 통째로 친** 길찾기 질의였다(이길 수 없다).
   ⇒ 순위는 이미 5위다. **막힌 곳은 순위가 아니라 「눌릴 이유」다.**
      5위의 기대 CTR 은 5~6%인데 이 지면은 0.85% 다.
   ⛔ 옛 제목은 파일 «이름 둘»뿐이었다 — 검색어와는 맞지만 **무엇을 얻는지 말하지 않는다.**
      파일 이름을 찾아온 사람은 「그 파일이 뭔지·쓸 만한지」를 알고 싶은 것이다.
   ⭐ 그래서 제일 센 실측 사실을 제목에 올린다 — country 파일 작품의 71.1%(9,530/13,395)가
      **어디에도 조회수가 없다.** 파일을 받아 쓰려는 사람에게 이보다 값나가는 한 줄이 없다.
   ⭐ 수를 글자로 박지 않고 «자료에서» 만든다 — 다음 달 자료가 바뀌면 제목이 저절로 따라간다.
      (`/most-read` 지면에서 같은 방식을 이미 쓰고 있다.)
   ⚠ `all-weeks-global.tsv` 는 제목에서 빠진다(그 이름의 노출은 28일에 29회다).
      대신 설명·H1·본문 소제목에 그대로 남아 있어 그 이름으로도 계속 걸린다.
      ⛔ 두 이름을 다 넣으려고 「눌릴 이유」를 빼면 순위만 좋고 클릭은 없는 지금이 그대로다. */
const TITLE = `all-weeks-countries.tsv: ${안붙는몫}% of its titles have no view count`;
/* ⭐ [2026-09-02] 설명도 «값나가는 한 줄»을 앞으로 옮긴다 — 구글이 스니펫으로 보여 주는
   것은 앞부분이다. 옛 설명은 「무엇이 들었나」로 시작해 정작 아플 자리(71.1%)가 끝에 있었다.
   ⛔ 수를 줄이지 않았다. 순서만 바꿨다 — 손님이 먼저 알아야 할 것을 먼저 놓는다. */
const DESC =
  `${안붙는몫}% of the titles in all-weeks-countries.tsv (${j.notInGlobal.toLocaleString('en-US')} of `
  + `${j.countryTitles.toLocaleString('en-US')}) have no row in all-weeks-global.tsv, so they carry no view `
  + `count anywhere — and weekly_views is empty for ${빈주} of the ${세계파일.weeks} weeks that do. `
  + `Counted on ${d.measuredAt}: ${나라파일.rows.toLocaleString('en-US')} country rows across `
  + `${나라파일.countries} countries and ${세계파일.rows.toLocaleString('en-US')} global rows, both covering `
  + `${나라파일.firstWeek} to ${나라파일.lastWeek}. Not a copy of the files — a count of what is in them.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: (d.files ?? []).map((f: any) => f.url),
  temporalCoverage: `${나라파일.firstWeek}/${나라파일.lastWeek}`,
  variableMeasured: [...나라파일.columns, ...세계파일.columns].filter((c: string, i: number, a: string[]) => a.indexOf(c) === i),
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/netflix-top10-data">
  <h1>Inside Netflix's two Top 10 files</h1>
  <p class="lead">
    Netflix publishes its weekly Top 10 as two tab-separated files. If you came here after pasting one
    of their addresses into a search box, this page is the thing that address does not come with:
    what is in each file, what each column means, and where each file stops carrying a number.
    Everything below was counted by downloading both files on {d.measuredAt}.
  </p>

  {/* 🔴 [2026-08-29] 첫 안쪽 링크가 지면의 71% 지점이었다. 이 지면은 우리 최대 검색
      노출 자리인데(Tudum 주소 문의 약 200회), 손님이 다음 걸음을 못 보고 나갔다. */}
  <p class="walk">
    <b>Or skip the file and read what we made from it:</b>{' '}
    <a href="/netflix-korea-this-week">the Korean titles on this week&rsquo;s charts</a> &middot;{' '}
    <a href="/by-country">every country, and how Korean its chart is</a> &middot;{' '}
    <a href="/titles">every Korean title we hold</a>
  </p>

  <section class="scroll-x">
    <table>
      <thead>
        <tr><th>File</th><th>Rows</th><th>Weeks</th><th>Covers</th><th>Countries</th><th>Categories</th></tr>
      </thead>
      <tbody>
        {(d.files ?? []).map((f: any) => (
          <tr>
            <td class="nm"><a href={f.url} rel="nofollow noopener">{f.name}</a></td>
            <td>{f.rows.toLocaleString('en-US')}</td>
            <td>{f.weeks}</td>
            <td class="fine">{f.firstWeek} → {f.lastWeek}</td>
            <td>{f.countries === null ? <span class="fine">none — global only</span> : f.countries}</td>
            <td class="fine">{f.categories.join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="warn-box">
    <h2>The two files do not join</h2>
    <p class="warn">
      This is the first thing to know and it is not written anywhere on the files themselves.
      The country file carries no viewing figure — no hours, no views, only a rank. The global file
      carries the viewing figures but no country. And they do not even label their categories the
      same way: the country file says <code>Films</code> and <code>TV</code>, the global file splits
      the same world into {세계파일.categories.map((c: string, i: number) => (
        <span>{i > 0 ? ', ' : ''}<code>{c}</code></span>
      ))}. A title that was
      number one in forty countries cannot be converted into a number of views by joining these
      two tables, because the row you would need does not exist.
    </p>
  </section>

  <section>
    <h2>{j.notInGlobal.toLocaleString('en-US')} of the titles have no view count anywhere</h2>
    <p>
      We took every title in the country file — {j.countryTitles.toLocaleString('en-US')} of them,
      counting a season as its own title — and looked for it in the global file.
      {' '}{j.inGlobal.toLocaleString('en-US')} were there. {j.notInGlobal.toLocaleString('en-US')} were
      not, which is {안붙는몫}% of them. Those titles reached a national top ten and Netflix has
      published no viewing figure for them, in this file or any other.
    </p>
    <p>
      It is tempting to assume the missing ones are the small ones. {j.notInGlobalWide} of them charted
      in {j.wideCut} countries or more.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Charted in a national top 10, no global row</th><th>Countries</th></tr></thead>
        <tbody>
          {(j.examples ?? []).map((x: any) => (
            <tr><td class="nm">{x.title}</td><td>{x.countries} of {나라파일.countries}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    {으뜸 && (
      <p class="note">
        <b>{으뜸.title}</b> is the widest of them: {으뜸.countries} of the {나라파일.countries} countries
        Netflix reports, and not one row in the global file. Anyone ranking titles by views is ranking
        the {((j.inGlobal / j.countryTitles) * 100).toFixed(0)}% that happen to have one.
      </p>
    )}
  </section>

  <section>
    <h2>The view count starts in the middle of the file</h2>
    <p>
      <code>weekly_views</code> is empty for {빈주} of the {세계파일.weeks} weeks in the global file —
      {' '}{빈몫}% of it. The last week with no views at all is {세계파일.lastWeekWithoutViews};
      the first week where every row has one is {세계파일.firstWeekWithViews}.
      {' '}<code>runtime</code> is empty on exactly the same {세계파일.emptyRuntime.toLocaleString('en-US')} rows.
      {' '}<code>weekly_hours_viewed</code> runs the whole way through.
    </p>
    <p class="warn">
      So a chart of <code>weekly_views</code> over the full history silently begins in mid-2023 and
      drops {세계파일.emptyViews.toLocaleString('en-US')} rows on the way. Nothing in the file marks
      this; the cells are simply empty. We say it here because an empty cell read as a zero is how a
      real drop gets invented.
    </p>
  </section>

  <section>
    <h2>Every column, both files</h2>
    {(d.files ?? []).map((f: any) => (
      <div>
        <h3>{f.name}</h3>
        <p class="fine">{f.columns.map((c: string) => <span><code>{c}</code>{' '}</span>)}</p>
      </div>
    ))}
    <p class="note">
      <code>week</code> is the Sunday that ends the week, written as a date.
      {' '}<code>cumulative_weeks_in_top_10</code> counts that title's weeks in that chart, not its
      weeks on Netflix. <code>season_title</code> is empty for films, which is why a title key has to
      be the pair of them: two seasons of one show are two different rows.
    </p>
  </section>

  <section>
    <h2>Where the files are</h2>
    <ul>
      {(d.files ?? []).map((f: any) => (
        <li><a href={f.url} rel="nofollow noopener">{f.url}</a></li>
      ))}
      <li><a href="https://www.netflix.com/tudum/top10" rel="nofollow noopener">https://www.netflix.com/tudum/top10</a> — the weekly page the files sit behind</li>
    </ul>
    <p class="note">
      We do not re-host them. They are Netflix's files, they change every week, and a copy of ours
      would be a stale copy within days. The links above go to the originals.
    </p>
  </section>

  <section class="src">
    <h2>What we built out of them</h2>
    <p>
      We read these files every week for Korean titles, one country at a time — the part the global
      file cannot tell you. {titlePages.titles.filter((t: any) => t.hasPage).length} titles have a page
      of their own showing every market they charted in, week by week.
    </p>
    <ul>
      {우리것.map((t: any) => (
        <li>
          <a href={`/title/${t.slug}`}>{t.title}</a> — {t.markets} of {titlePages.marketCount} markets,
          {' '}{t.places.toLocaleString('en-US')} chart places
        </li>
      ))}
    </ul>
    {/*
      🔴 2026-08-23 — 검색 실측: 「netflix.com/tudum/top10?week=2024-11-03」 꼴이
        노출 120건에 6.8~7.7위, 클릭 0. 손님이 찾는 것은 **그 한 주**인데 이 지면은
        파일 전체를 설명한다. 그 주로 가는 문을 여기서 낸다 — 여기가 그 검색이 닿는 자리다.
    */}
    <p class="note">
      <a href="/weeks"><b>Pick a single week</b></a> &mdash; every week Netflix has published,
      and which Korean titles charted in it ·{' '}
      <a href="/watched">What the whole Korean catalogue did, week by week</a> ·{' '}
      <a href="/exports">Where it travelled</a> ·{' '}
      <a href="/data">Every dataset we keep and how it was built</a>
    </p>
    <p class="note">
      <b>What this is</b> — {d.whatThisIs}<br />
      <b>What this is not</b> — {d.whatThisIsNot}
    </p>
  </section>

  <KcwRelatedArticles page="/netflix-top10-data" />
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: 0.5rem 1rem; }
  code { font-size: 0.92em; }
</style>
