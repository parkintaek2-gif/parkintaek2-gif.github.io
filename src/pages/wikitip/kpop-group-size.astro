---
/*
 * `/kpop-group-size` — **How many members a K-pop group has, and what that costs in age gap.**
 *
 * ── Why this page ──────────────────────────────────────────────
 * Measured 2026-10-05 (en/us autocomplete): `kpop groups`, `kpop girl groups`,
 * `kpop boy groups` and `kpop members` each fill all ten rows.
 * `check-이미-있는-지면인가` found no page of ours with any of those in its title
 * across 580 source files.
 *
 * ⭐ What the data says — **the bigger the group, the wider the age gap, with no
 *   exception across the size bands.** Median gap between oldest and youngest member:
 *     3 members → 3 years · 5 → 4 · 7 → 5 · 10–13 → 7 · 14+ → 13
 *   That is monotonic. A thirteen-member line-up is not five members plus eight;
 *   it reaches across a different span of birth years.
 *
 * ⛔ We do not say which size is better. Size is a count; "better" is a judgement.
 * ⛔ Members whose birth year we do not hold are left out of the gap figures, and
 *   we print how many. We do not treat a missing year as zero.
 * ⛔ Line-ups change. This is who the record lists, not who was there on debut day.
 *   The page says so rather than implying a snapshot is a history.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import groups from '../../data/wikitip-groups.json';

const 모두 = ((groups as any).groups ?? (Array.isArray(groups) ? groups : [])) as any[];

const 수인가 = (x: any) => typeof x === 'number' && Number.isFinite(x);
const 가운데 = (v: number[]) => {
  const s = [...v].sort((a, b) => a - b);
  return s.length ? s[Math.floor(s.length / 2)] : null;
};

const 인원잰것 = 모두.filter((g) => 수인가(g?.membersRecorded) && g.membersRecorded > 0);
const 인원합 = 인원잰것.reduce((a, g) => a + g.membersRecorded, 0);
const 생일합 = 모두.reduce((a, g) => a + (수인가(g?.membersWithBirthday) ? g.membersWithBirthday : 0), 0);
const 출생지합 = 모두.reduce((a, g) => a + (수인가(g?.birthplacesKnown) ? g.birthplacesKnown : 0), 0);

/* 크기 분포 */
const 크기셈 = new Map<number, number>();
for (const g of 인원잰것) 크기셈.set(g.membersRecorded, (크기셈.get(g.membersRecorded) ?? 0) + 1);
const 크기차례 = [...크기셈.entries()].sort((a, b) => a[0] - b[0]);
const 최빈 = [...크기셈.entries()].sort((a, b) => b[1] - a[1])[0] ?? null;
const 크기가운데 = 가운데(인원잰것.map((g) => g.membersRecorded));
const 셋에서일곱 = 인원잰것.filter((g) => g.membersRecorded >= 3 && g.membersRecorded <= 7).length;

/**
 * 크기 구간마다 나이 폭.
 * ⛔ 생년을 모르는 그룹은 «빼고» 그 수를 따로 적는다 — 0 으로 메우지 않는다.
 */
const 구간정의 = [
  { 이름: '3', 밑: 3, 위: 3 },
  { 이름: '4', 밑: 4, 위: 4 },
  { 이름: '5', 밑: 5, 위: 5 },
  { 이름: '6', 밑: 6, 위: 6 },
  { 이름: '7', 밑: 7, 위: 7 },
  { 이름: '8–9', 밑: 8, 위: 9 },
  { 이름: '10–13', 밑: 10, 위: 13 },
  { 이름: '14+', 밑: 14, 위: 999 },
];

const 구간 = 구간정의.map((b) => {
  const 안 = 인원잰것.filter((g) => g.membersRecorded >= b.밑 && g.membersRecorded <= b.위);
  const 잴수있는것 = 안.filter((g) => 수인가(g?.oldestBornYear) && 수인가(g?.youngestBornYear));
  const 폭들 = 잴수있는것.map((g) => g.youngestBornYear - g.oldestBornYear);
  return {
    이름: b.이름,
    팀: 안.length,
    잰팀: 잴수있는것.length,
    가운데폭: 가운데(폭들),
    가장넓은: 폭들.length ? Math.max(...폭들) : null,
  };
}).filter((b) => b.팀 > 0);

/* 🔴 이 지면의 한 문장 — 구간을 따라 «줄지 않고» 커지나 */
const 폭차례 = 구간.map((b) => b.가운데폭).filter(수인가) as number[];
const 줄지않는다 = 폭차례.every((v, i) => i === 0 || v >= 폭차례[i - 1]);
const 첫폭 = 폭차례[0] ?? null;
const 끝폭 = 폭차례[폭차례.length - 1] ?? null;

/* 가장 넓은 그룹들 */
const 넓은것 = 인원잰것
  .filter((g) => 수인가(g?.oldestBornYear) && 수인가(g?.youngestBornYear) && g.membersRecorded > 1)
  .map((g) => ({
    이름: String(g.name ?? ''),
    slug: String(g.slug ?? ''),
    수: g.membersRecorded,
    폭: g.youngestBornYear - g.oldestBornYear,
    위: g.oldestBornYear,
    아래: g.youngestBornYear,
  }))
  .sort((a, b) => b.폭 - a.폭)
  .slice(0, 10);

const 큰것 = [...인원잰것].sort((a, b) => b.membersRecorded - a.membersRecorded).slice(0, 8);

const 세자리 = (n: any) => (수인가(n) ? Number(n).toLocaleString('en-GB') : '—');
const 몫 = (a: number, b: number) => (b > 0 ? `${Math.round((a / b) * 100)}%` : '—');

const TITLE = `Kpop groups by size — ${세자리(인원잰것.length)} line-ups, and the age gap that comes with them`;
const DESC = `Across ${세자리(인원잰것.length)} K-pop groups holding ${세자리(인원합)} members, `
  + `${최빈 ? `${최빈[0]} members is the most common size` : 'sizes cluster in the middle'} and `
  + `${몫(셋에서일곱, 인원잰것.length)} have between three and seven. The bigger the group, the wider the `
  + `gap between its oldest and youngest member — ${첫폭} years at the smallest size, ${끝폭} at the largest.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'K-pop group sizes and member age spread',
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
};
---

{/* 🔴 [2026-10-05 23:2x · 5번] **canonical 이 아예 없었다.**
    사장님이 넘겨 주신 구글 메일(데이터세트 구조화 자료)을 쫓다 찾았다 —
    Dataset 에 url 이 안 들어가길래 보니 레이아웃에 page 도 canonical 도 안 주고 있었다.
    ⛔ canonical 이 없으면 구글이 그 지면을 색인에서 뺄 수 있다. Dataset 보다 큰 흠이다.
    ⚠ page="/kpop-group-size" 는 KcwRelatedArticles 에만 주고 있었다 — 레이아웃은 못 받았다.
    ⭐ 넘기는 쪽만 있고 받는 쪽이 없으면 조용히 무시된다(WikiTip.astro 가 이미 적어 둔 말이다). */}
<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} page="/kpop-group-size">
  <h1>How big is a K-pop group?</h1>

  <p class="lede">
    We hold member records for {세자리(인원잰것.length)} groups — {세자리(인원합)} people in all.
    Counting them gives a plain answer about size, and a less obvious one about age.
  </p>

  <section class="box">
    <h2>The finding</h2>
    {최빈 && (
      <p>
        <strong>{최빈[0]} members is the most common size</strong> ({최빈[1]} groups), the median is
        {' '}{크기가운데}, and <strong>{몫(셋에서일곱, 인원잰것.length)} of all groups have between three and seven.</strong>
      </p>
    )}
    {줄지않는다 && 수인가(첫폭) && 수인가(끝폭) && (
      <p>
        The less obvious part: <strong>the bigger the group, the wider the age gap</strong> between
        its oldest and youngest member — and it does not reverse once across the size bands.
        Median gap goes from <strong>{첫폭} years</strong> at the smallest size to
        {' '}<strong>{끝폭} years</strong> at the largest.
      </p>
    )}
    <p>
      A thirteen-member line-up is not five members plus eight. It reaches across a
      different span of birth years, and that is a different thing to assemble.
    </p>
  </section>

  <section>
    <h2>Group size and age gap, band by band</h2>
    <p class="note">
      Age gap is the distance between the oldest and the youngest member's birth year.
      Groups whose birth years we do not hold are counted in the first column but left out
      of the gap figures — the "measured" column says how many were usable.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th>Members</th><th>Groups</th><th>Measured</th>
            <th>Median age gap</th><th>Widest in band</th>
          </tr>
        </thead>
        <tbody>
          {구간.map((b) => (
            <tr>
              <th>{b.이름}</th>
              <td>{세자리(b.팀)}</td>
              <td>{세자리(b.잰팀)}</td>
              <td><strong>{수인가(b.가운데폭) ? `${b.가운데폭} yrs` : '—'}</strong></td>
              <td>{수인가(b.가장넓은) ? `${b.가장넓은} yrs` : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Every size we see</h2>
    <div class="scroll">
      <table>
        <thead><tr><th>Members</th><th>Groups</th><th>Share</th></tr></thead>
        <tbody>
          {크기차례.map(([n, c]) => (
            <tr><th>{n}</th><td>{세자리(c)}</td><td>{몫(c, 인원잰것.length)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>The widest age gaps</h2>
    <p class="note">Oldest and youngest birth year on record, with the gap between them.</p>
    <div class="scroll">
      <table>
        <thead><tr><th>Group</th><th>Members</th><th>Oldest born</th><th>Youngest born</th><th>Gap</th></tr></thead>
        <tbody>
          {넓은것.map((g) => (
            <tr>
              <td class="nm">{g.slug ? <a href={`/group/${g.slug}`}>{g.이름}</a> : g.이름}</td>
              <td>{g.수}</td><td>{g.위}</td><td>{g.아래}</td>
              <td><strong>{g.폭} yrs</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>The largest line-ups</h2>
    <div class="scroll">
      <table>
        <thead><tr><th>Group</th><th>Members on record</th></tr></thead>
        <tbody>
          {큰것.map((g) => (
            <tr>
              <td class="nm">{g.slug ? <a href={`/group/${g.slug}`}>{g.name}</a> : g.name}</td>
              <td><strong>{g.membersRecorded}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>What we hold and what we do not</h2>
    <p>
      Of {세자리(인원합)} members, we have a birth date for <strong>{세자리(생일합)}</strong>
      ({몫(생일합, 인원합)}) and a birthplace for <strong>{세자리(출생지합)}</strong>
      ({몫(출생지합, 인원합)}). The rest are counted as members but left out of any figure
      that needs those fields. <strong>They are not treated as zero.</strong>
    </p>
    <p>
      <strong>Line-ups change.</strong> This is who the record lists, not who stood on
      stage at debut. A group that added or lost members shows the full roster, which is
      one reason the largest counts are as large as they are.
    </p>
    <p>
      <strong>We do not say which size is better.</strong> Size is a count; better is a
      judgement, and not ours to make. The tables are here so the question can be asked
      with numbers instead of impressions.
    </p>
  </section>

  <section>
    <h2>Related</h2>
    <ul class="links">
      <li><a href="/group">Every K-pop group we track</a></li>
      <li><a href="/ages">Korean actors ages — 531 on record</a></li>
      <li><a href="/kdrama-netflix">Kdrama on Netflix, counted two ways</a></li>
      <li><a href="/born-on">Who was born on your birthday</a></li>
    </ul>
  </section>

  <KcwRelatedArticles page="/kpop-group-size" />
</WikiTip>

<style>
  h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 .6rem; }
  .lede { font-size: 1.05rem; color: #334; margin: 0 0 1.6rem; }
  section { margin: 2.2rem 0; }
  h2 { font-size: 1.2rem; margin: 0 0 .6rem; }
  .box { background: #fbfbfd; border: 1px solid #e6e8ee; border-left: 4px solid #2a4d8f;
         border-radius: 12px; padding: 1rem 1.1rem; }
  .box p { margin: .5rem 0; }
  .box p:first-of-type { margin-top: 0; }
  .note { font-size: .88rem; color: #667; margin: 0 0 .7rem; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: .45rem .6rem; border-bottom: 1px solid #e8eaef; text-align: right; }
  thead th { text-align: right; font-size: .82rem; color: #556; border-bottom: 2px solid #d8dbe2; }
  thead th:first-child, tbody th, tbody td.nm { text-align: left; }
  tbody th { font-weight: 600; color: #334; }
  td.nm a { color: #2a4d8f; text-decoration: none; }
  td.nm a:hover { text-decoration: underline; }
  .links { margin: .6rem 0 0 1.1rem; font-size: .95rem; }
  .links li { margin: .35rem 0; }
  .links a { color: #2a4d8f; text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  @media (max-width: 640px) { h1 { font-size: 1.45rem; } }
</style>
