---
/**
 * K Culture Wire — **어느 작품의 줄인가.** (`/provenance`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   차트 한 줄은 제목과 순위만 준다. **작품을 주지 않는다.**
 *   이름이 같은 두 작품이 있으면 글자로 고른 명단은 둘 다 담는다. 우리 것이 그랬다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **못 가른 둘을 감추지 않는다.** 뺀 표 바로 아래 같은 크기로 놓는다 —
 *    그 둘이 이 방법의 한계이고, 한계를 각주로 밀면 방법이 실제보다 세 보인다.
 * ⛔ 「한국 차트에 없으면 남의 것」을 **틀린 규칙으로 화면에 적는다.** 902편 중 342편이 그렇다.
 *    우리가 그 규칙을 안 쓴 까닭을 독자가 알아야 같은 수를 다시 만들 수 있다.
 * ⛔ 93곳을 줄세우지 않는다. 뺀 것만 낸다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 * ⚠ 수를 손으로 적지 않는다. 전부 `wikitip-provenance.json` 에서 읽는다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다 —
 *   8/10 04:2x 에 `hard-markets.astro` 에서 그렇게 죽었고 libuv 소리로 원인이 가려졌다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-provenance.json';

const 으뜸 = d.removed[0];

const TITLE = 'Which work is this chart row — reading a title against the markets it charted in';
const DESC =
  `A chart row gives a title, not a work. ${d.removedTitles} titles in our Korean panel were foreign `
  + `works carrying the same English name, worth ${d.removedPlaces} of ${(d.koreanPlaces + d.removedPlaces).toLocaleString('en-US')} chart places `
  + `(${d.removedPlacesPc}%). The test is where they charted, not what they are called.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://www.wikidata.org'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/provenance">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">
    <b>{으뜸.title}</b> took <b>{으뜸.places}</b> chart places across {으뜸.markets} countries in our
    Korean panel.{' '}
    {으뜸.topMarketSharePc}% of them were in {으뜸.topMarket}, and none were in South Korea.
  </p>

  <section>
    <h2>The {d.removedTitles} titles removed, and what they charted as</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Title</th><th>Places</th><th>Markets</th>
          <th>Largest market</th><th>Its share</th><th>Attributed to</th></tr></thead>
        <tbody>
          {d.removed.map((x) => (
            <tr>
              <td class="nm">{x.title}</td>
              <td class="tot">{x.places}</td>
              <td>{x.markets}</td>
              <td>{x.topMarket}</td>
              <td>{x.topMarketSharePc}%</td>
              <td class="fine">{x.attributedTo}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note"><b>{d.unit}</b></p>
    <p class="note">
      Together they held <b>{d.removedPlaces}</b> of{' '}
      {(d.koreanPlaces + d.removedPlaces).toLocaleString('en-US')} chart places —{' '}
      <b>{d.removedPlacesPc}%</b> of the panel.
    </p>
  </section>

  <section class="warn-box">
    <h2>The obvious test does not work</h2>
    <p class="warn">{d.whyNotHomeChartAlone}</p>
    <p class="note">
      So a title is removed only when <b>all three</b> hold: it never charted in Korea, Wikidata
      attributes no Korean work at all to that name, and the market it charted in most is one
      Wikidata names as the origin of a same-titled foreign work. The middle condition is what makes
      it safe — a name a Korean work also carries is never removed.
    </p>
  </section>

  <section>
    <h2>Two we could not settle</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Title</th><th>Places</th><th>Market</th><th>Why it stayed</th></tr></thead>
        <tbody>
          {d.couldNotSeparate.map((x) => (
            <tr>
              <td class="nm">{x.title}</td>
              <td class="tot">{x.places}</td>
              <td>{x.topMarket}</td>
              <td class="fine">A Korean work carries this name</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="warn">{d.whatThisCannotDo}</p>
  </section>

  <section class="src">
    <h2>How this was counted, and what it cannot say</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Panel</b> — {d.panelTitles} Korean titles after the removals,{' '}
        {d.koreanPlaces.toLocaleString('en-US')} chart places.</li>
      <li><b>Never at home</b> — {d.neverChartedAtHome} of the panel ({d.neverChartedAtHomePc}%)
        have no place on Korea's own chart, which is why that alone is not a test.</li>
    </ul>
    <p class="warn">{d.cannotAnswer}</p>
    <p class="note">
      <a href="/hard-markets">Which markets only take the wide titles</a> ·{' '}
      <a href="/article/how-much-of-our-own-number-is-checked">How much of our own number is checked</a> ·{' '}
      <a href="/corrections">What we have corrected</a> · <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/provenance" />
</WikiTip>

<style>
  .warn-box { border-left: 3px solid #b45309; padding-left: 1rem; }
</style>
