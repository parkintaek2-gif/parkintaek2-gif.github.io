---
/*
 * tag/[tag].astro — **태그 지면.** 기사 117편에 태그가 96종 붙어 있었는데
 * **한 장도 화면에 안 나오고 있었다.**
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 2026-08-25 오후, 사장님 지시 —
 * ```
 *   「각 콘텐트에 관련 콘텐트, 해시태그 등을 빠짐없이 넣었지? 안 하고 있으면 해」
 *   「우리가 만든 콘텐트를 보러 온 사람이, 우리가 만든 다른 콘텐트를 계속 볼 수 있도록 해야지」
 * ```
 * 재 보니 —
 * ```
 *   기사 117편 · 전부 앞말에 태그가 있다 · 태그 종류 96
 *   그 태그가 «화면에 나오는» 지면   0장
 * ```
 * 앞말에만 있고 손님에게는 없었다. 「넣었다」와 「보인다」는 다른 말이다.
 *
 * ── ⛔ 이 지면이 지키는 것 ─────────────────────────────────────
 * ⛔ **한 편짜리 태그는 지면을 안 낸다.** 열고 나서 한 줄만 있는 지면은 안 여는 것만 못하다.
 *   ⚠ 그렇다고 그 태그를 «지우지» 않는다 — 기사에는 그대로 보이고, 다만 그 낱말이
 *     주소가 되지는 않는다. 몇 개를 안 냈는지 지면에 적는다.
 * ⛔ 태그를 «분류»라고 부르지 않는다. 우리가 손으로 붙인 이름표일 뿐이고,
 *   그것이 무엇을 뜻하는지는 기사가 말한다.
 */
import { getCollection } from 'astro:content';
import WikiTip from '../../../layouts/WikiTip.astro';

/** 태그를 주소로 — 손님이 보는 글자는 태그 그대로 두고 주소만 다듬는다 */
export function 슬러그(t: string) {
  return String(t ?? '').toLowerCase()
    .replace(/[’'`]/g, '')
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

/** 지면을 낼 최소 편수. 한 편짜리는 안 낸다 */
export const 최소편수 = 2;

export async function getStaticPaths() {
  const 기사 = (await getCollection('kcwArticles'))
    .filter((e: any) => !e.data.draft)
    .sort((a: any, b: any) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

  /* 태그별로 접는다. ⚠ 같은 뜻의 다른 표기(k-pop/kpop, southeast asia/southeast-asia)가
     섞여 있다 — 주소로 만들면 저절로 합쳐진다. 합친 것을 지면에 밝힌다 */
  const 통 = new Map<string, { 이름: Set<string>; 글: any[] }>();
  for (const e of 기사) {
    for (const t of (e.data.tags ?? [])) {
      const s = 슬러그(t);
      if (!s) continue;
      if (!통.has(s)) 통.set(s, { 이름: new Set(), 글: [] });
      통.get(s)!.이름.add(String(t));
      if (!통.get(s)!.글.some((x: any) => x.id === e.id)) 통.get(s)!.글.push(e);
    }
  }
  const 낼것 = [...통.entries()].filter(([, v]) => v.글.length >= 최소편수);
  const 안낸것 = 통.size - 낼것.length;

  return 낼것.map(([s, v]) => ({
    params: { tag: s },
    props: {
      슬러그: s,
      이름들: [...v.이름].sort((a, b) => b.length - a.length),
      글: v.글.map((e: any) => ({
        id: e.id, title: e.data.title, dek: e.data.dek,
        pubDate: String(e.data.pubDate).slice(0, 10),
      })),
      태그전체: 통.size,
      안낸태그: 안낸것,
      이웃: 낼것
        .filter(([o]) => o !== s)
        .sort((a, b) => b[1].글.length - a[1].글.length)
        .slice(0, 8)
        .map(([o, ov]) => ({ slug: o, name: [...ov.이름][0], n: ov.글.length })),
    },
  }));
}

const { 슬러그: s, 이름들, 글, 태그전체, 안낸태그, 이웃 } = Astro.props as any;
const 보일이름 = 이름들[0];
const TITLE = `${보일이름} — ${글.length} pieces we have published on it`;
const DESC = `Everything K Culture Wire has published tagged ${보일이름}: ${글.length} `
  + `${글.length === 1 ? 'article' : 'articles'}, newest first, each counted from a named source.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/tag/${s}`}>
  <h1>#{보일이름}</h1>

  <p class="lead">
    <b>{글.length}</b> {글.length === 1 ? 'piece' : 'pieces'} we have published on this,
    newest first.
    {이름들.length > 1 && <> We have written this tag {이름들.length} ways
      ({이름들.join(', ')}); they are gathered here as one.</>}
  </p>

  <section>
    <ul class="walk">
      {글.map((a: any) => (
        <li>
          <a href={`/article/${a.id}`}>{a.title}</a>
          <div class="fine">{a.pubDate} &mdash; {a.dek}</div>
        </li>
      ))}
    </ul>
  </section>

  <section class="onward">
    <h3>Other tags</h3>
    <ul class="walk">
      {이웃.map((t: any) => (
        <li><a href={`/tag/${t.slug}`}>#{t.name}</a>
          <span class="fine"> &mdash; {t.n}</span></li>
      ))}
    </ul>
    <p class="note fine">
      We hold {태그전체} tags in all. {안낸태그} of them are on a single piece, and we do not
      publish a page for those &mdash; the tag still shows on the article, it just does not become
      an address of its own.
    </p>
  </section>

  <section class="onward">
    <h3>Other ways in</h3>
    <ul class="walk">
      <li><a href="/articles">Everything we have published</a></li>
      <li><a href="/titles">Korean drama list &mdash; every title that reached a Netflix top 10</a></li>
      <li><a href="/group">Kpop idols by group &mdash; age and birthday</a></li>
      <li><a href="/born-on">Korean actors&rsquo; birthdays</a></li>
    </ul>
  </section>
</WikiTip>
