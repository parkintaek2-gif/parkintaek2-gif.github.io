---
/**
 * K Culture Wire — **무엇이 나라를 안 가리나.** (`/spread`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   81편에서 감독의 쏠림을 쟀다. 그 자를 **모든 무리에** 대 보니 다른 물음이 나왔다 —
 *   ⭐ 「무엇이 나라를 **안 가리나**」. 쏠림이 낮을수록 지역 전체가 같이 읽는다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ 크기와 고름을 섞지 않는다. 많이 읽히는 것과 고루 읽히는 것은 다른 물음이다.
 * ⛔ 이스포츠 100% 를 **관심의 쏠림으로 읽지 않는다.** 문서가 한 판에만 있어서다.
 *    그 말을 표 바로 아래 같은 크기로 적는다.
 * ⚠ 넷이 고르면 25% 다. 그것이 바닥이지 0 이 아니다. 화면에 적는다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-spread.json';

const TITLE = 'What gets read across Southeast Asia, and what gets read in one country';
const DESC =
  `Concentration is the share of a name's four-country reading that sits in its largest country. `
  + `Four equal countries give ${d.evenFloorPc}%. ${d.mostEven.label} come closest at `
  + `${d.mostEven.medianTopSharePc}%; ${d.mostConcentrated.label} sit at `
  + `${d.mostConcentrated.medianTopSharePc}%, and that last figure is about encyclopaedias, not attention.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/spread">
  <h1>{TITLE}</h1>
  <p class="lead">{d.question}</p>
  <p class="q">{d.finding}</p>

  <section>
    <h2>Seven groups, sorted by how evenly they are read</h2>
    <p class="note">
      <b>{d.unit}</b> Names below {d.threshold} reads per million are in the panel but left out of
      the median — {d.whyThreshold}
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Group</th><th>Counted</th><th>In panel</th>
          <th>Median concentration</th><th>Under 40%</th></tr></thead>
        <tbody>
          {d.groups.map((g) => (
            <tr>
              <td class="nm">{g.label}</td>
              <td class="tot">{g.counted}</td>
              <td class="fine">{g.ofAll}</td>
              <td>{g.medianTopSharePc}%</td>
              <td class="fine">{g.underForty}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      An even reader would put every group at <b>{d.evenFloorPc}%</b>. Nothing reaches that. The
      question is which groups come near it.
    </p>
  </section>

  <section class="warn-box">
    <h2>The bottom row is not what it looks like</h2>
    <p class="warn">{d.esportsCaveat}</p>
  </section>

  <section>
    <h2>Read almost equally in all four</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Name</th><th>Group</th><th>Concentration</th><th>Total</th></tr></thead>
        <tbody>
          {d.mostEvenNames.map((x) => (
            <tr>
              <td class="nm">{x.name}</td>
              <td class="fine">{x.label}</td>
              <td class="tot">{x.topSharePc}%</td>
              <td>{x.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Read in one country only</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Name</th><th>Group</th><th>Concentration</th><th>Where</th><th>Total</th></tr></thead>
        <tbody>
          {d.mostConcentratedNames.map((x) => (
            <tr>
              <td class="nm">{x.name}</td>
              <td class="fine">{x.label}</td>
              <td class="tot">{x.topSharePc}%</td>
              <td>{d.editions.find((e) => e.code === x.topEdition)?.country ?? x.topEdition}</td>
              <td>{x.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="src">
    <h2>How this was counted, and what it cannot say</h2>
    <ul>
      <li><b>Source</b> — {d.source}</li>
      <li><b>Window</b> — {d.window}</li>
      <li><b>Editions</b> — {d.editions.map((e) => e.country).join(', ')}</li>
    </ul>
    <p class="warn">{d.cannotAnswer}</p>
    <p class="warn">{d.whyNotPhilippines}</p>
    <p class="note">
      <a href="/fame-compare">How large each group is</a> ·{' '}
      <a href="/sea-athletes">The athletes in full</a> · <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/spread" />
</WikiTip>

<style>
  .warn-box { border-left: 3px solid #b45309; padding-left: 1rem; }
</style>
