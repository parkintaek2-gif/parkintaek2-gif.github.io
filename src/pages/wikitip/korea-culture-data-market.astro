---
/**
 * K Culture Wire — **한국이 내놓은 문화 데이터 1,344건을 센다.** (`/korea-culture-data-market`)
 *
 * 🔴 [2026-09-06] 우리 아카이브에 `bigdata-culture` 1,344건이 받아져 있는데
 *   **어느 지면도 이것을 안 쓰고 있었다**(grep 0곳). 사장님 「쥔 자료의 안 쓰던 축부터 찾아 낸다」.
 *
 * ⭐ 이 지면의 심장 — **공짜와 «살아 있음»은 다른 것이다.**
 *   무료 80%(1,075건)는 좋은 소식처럼 읽힌다. 그런데 열두 달 안에 갱신된 것은 322건뿐이고
 *   590건은 아예 「갱신불가」로 적혀 있다. **두 수를 갈라 놓지 않으면 나침반이 아니라 광고다.**
 *
 * ── ⛔ 이 지면이 안 하는 것 ─────────────────────────────
 * ⛔ 자료를 다시 배포하지 않는다. 우리가 내는 것은 «세어서 얻은 수»다.
 * ⛔ 「한국이 데이터를 안 낸다」로 읽히게 쓰지 않는다 — 1,344건은 적은 수가 아니다.
 * ⛔ 갱신이 멈춘 것을 「쓸모없다」고 하지 않는다. 지난 일을 재는 자료는 멈추는 것이 맞다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-culture-data-market.json';

type 셈 = { key: string; count: number };
type 오래 = { title: string; updated: string; monthsAgo: number; price: string };

const 값 = d.price as Record<string, number>;
const 신선 = d.freshness as any;
const 꼴 = (d.formats as any[]) as 셈[];
const 갈래 = (d.topics as any[]) as 셈[];
const 주기 = (d.updateCycles as any[]) as 셈[];
const 오래된것 = (d.oldestExamples as any[]) as 오래[];

/* 🔴 제목·본문이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (d.total !== d.statedTotal) {
  throw new Error(`센 것 ${d.total} 이 플랫폼이 말하는 총건수 ${d.statedTotal} 와 다르다 — 받다 만 것이다.`);
}
if (값.unknown > 0) throw new Error(`값 갈래를 못 읽은 것이 ${값.unknown}건 있다 — 「무료 80%」를 낼 수 없다.`);
if (신선.stale <= 신선.live) {
  throw new Error(`멈춘 것 ${신선.stale} 이 살아 있는 것 ${신선.live} 보다 많지 않다 — 이 지면의 논점이 뒤집혔다. 다시 쓴다.`);
}

/**
 * 🔴 [2026-09-06] 빌드해서 눈으로 보니 **꼬리표가 한국어 그대로 나왔다** — 관광·여가·문화산업.
 * ⛔ 사장님 「우리 손님은 영어권이다. 화면에 한국어를 안 낸다」. 작품·자료 «이름»만 예외다.
 * ✅ 그래서 꼬리표는 영어로 옮기고, 옮긴 것임을 표 설명에 적는다.
 *   ⚠ 목록에 없는 꼬리표가 나오면 «한국어 그대로» 둔다 — 지어내지 않는다. 그러면 다음 사람이
 *     화면에서 바로 알아보고 여기에 더할 수 있다. 조용히 감추는 것보다 낫다.
 */
const 꼬리표영어: Record<string, string> = {
  관광: 'Tourism', 여가: 'Leisure', 문화산업: 'Culture industry', 여행: 'Travel',
  체육: 'Sport', 문화예술: 'Arts', 로컬: 'Local', 문화소비: 'Culture consumption',
  공연: 'Performance', 축제: 'Festivals', 도서: 'Books', 영화: 'Film',
  음악: 'Music', 게임: 'Games', 방송: 'Broadcasting', 콘텐츠: 'Content',
  전시: 'Exhibitions', 스포츠: 'Sports', 관광지: 'Destinations', 숙박: 'Accommodation',
  소비: 'Spending', 인구: 'Population', 교육: 'Education', 지역: 'Regions',
  미디어: 'Media', 한류: 'Hallyu', 도서관: 'Libraries', 여건조성: 'Enabling conditions',
  MZ: 'MZ generation', 저작권: 'Copyright', 관람: 'Attendance', 통계: 'Statistics',
};
/**
 * ⚠ 자료 «이름»은 한국어를 그대로 둔다 — 그것이 그 자료의 진짜 이름이고, 그 이름으로만 찾을 수 있다
 *   (사장님 규칙의 「작품 제목」 예외). 대신 «무슨 자료인지»를 영어로 덧붙인다.
 * ⛔ 목록에 없는 이름은 덧말 없이 낸다. 지어내서 붙이지 않는다.
 */
const 이름덧말: Record<string, string> = {
  '지역별 청소년활동 관심지도': 'a map of youth-activity interest by region',
  '베트남의 한류(K-POP) 주제 한류 커뮤니티 키워드 데이터': 'keywords from Vietnamese K-pop fan communities',
  '케이스타라이브의 국가별 월별 순 방문자 데이터': 'monthly unique visitors to K-Star Live, by country',
};

const 주기영어: Record<string, string> = {
  갱신불가: 'Cannot be updated', 비주기: 'No fixed cycle', '(none given)': 'None given',
};

const 쉼표 = (n: number) => Number(n).toLocaleString('en-US');
const 몫 = (n: number) => `${Math.round((1000 * n) / d.total) / 10}%`;
const 갱신불가 = 주기.find((x) => x.key === '갱신불가')?.count ?? 0;
const 한류자료 = 오래된것.find((x) => /한류|K-POP|케이/.test(x.title)) ?? 오래된것[0];

const TITLE = `Korea lists ${쉼표(d.total)} culture datasets. ${몫(값.free)} are free, ${몫(신선.stale)} are not maintained`;
const DESC =
  `We counted every dataset on Korea's culture big-data platform: ${쉼표(값.free)} free, `
  + `${쉼표(값.paid)} paid, and only ${쉼표(신선.live)} updated in the last twelve months. `
  + `${쉼표(갱신불가)} are marked as never updating at all.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  variableMeasured: ['Price band per dataset', 'Months since last update', 'File formats', 'Topic tags'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/korea-culture-data-market">
  <h1>{TITLE}</h1>

  <p class="lead">
    Korea runs a public platform for culture data &mdash; tourism, leisure, the culture industry, K-pop
    audiences. It holds {쉼표(d.total)} datasets and most of them cost nothing. We counted what is in it,
    and then counted the part nobody prints: how many are still being updated.
  </p>

  <p class="q">
    <b>We do not host or republish any of it.</b> Everything here is a count we made from the listing.
  </p>

  <h2>What it costs</h2>

  <div class="scroll-x">
    <table>
      <tbody>
        <tr><th scope="row">Free</th><td class="num">{쉼표(값.free)}</td><td class="num">{몫(값.free)}</td></tr>
        <tr><th scope="row">Paid</th><td class="num">{쉼표(값.paid)}</td><td class="num">{몫(값.paid)}</td></tr>
        <tr><th scope="row">Price on request</th><td class="num">{쉼표(값.negotiable)}</td><td class="num">{몫(값.negotiable)}</td></tr>
      </tbody>
    </table>
  </div>

  <h2>And the number that goes with it</h2>

  <div class="scroll-x">
    <table>
      <caption>Months since the listing's own last-updated date, measured {d.measuredAt}</caption>
      <tbody>
        <tr><th scope="row">Updated within twelve months</th><td class="num">{쉼표(신선.live)}</td><td class="num">{몫(신선.live)}</td></tr>
        <tr class="gap"><th scope="row">Not updated in twelve months</th><td class="num">{쉼표(신선.stale)}</td><td class="num">{몫(신선.stale)}</td></tr>
        <tr><th scope="row">Update date unreadable</th><td class="num">{쉼표(신선.dateUnreadable)}</td><td class="num">{몫(신선.dateUnreadable)}</td></tr>
      </tbody>
    </table>
  </div>

  <p class="note">
    <b>Free and live are not the same thing.</b> {몫(값.free)} of this shelf costs nothing, and
    {' '}{몫(신선.stale)} of it has not moved in a year. Printing the first figure without the second is
    how a catalogue gets described as a resource. {신선.dateUnreadable === 0
      ? 'Every listing carried a readable date, so nothing here is guesswork about age.'
      : `${쉼표(신선.dateUnreadable)} listings carried no readable date; they are counted separately, never as stale.`}
  </p>

  <h2>How often each one says it updates</h2>

  <div class="scroll-x">
    <table>
      <thead><tr><th>Stated cycle</th><th>Datasets</th><th>Share</th></tr></thead>
      <tbody>
        {주기.map((r) => (
          <tr class={r.key === '갱신불가' ? 'gap' : undefined}>
            <th scope="row">{주기영어[r.key] ?? r.key}</th>
            <td class="num">{쉼표(r.count)}</td>
            <td class="num">{몫(r.count)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    {쉼표(갱신불가)} of them &mdash; {몫(갱신불가)} &mdash; carry the label 갱신불가, meaning they cannot be updated at all.
    That is often the honest label for a one-off survey rather than a failing, and we read it that way.
    It does mean a reader should not expect this shelf to answer a question about this month.
  </p>

  <h2>What they are about</h2>

  <div class="scroll-x">
    <table>
      <caption>Topic tags, most common first. One dataset can carry several. Tags are the platform's own Korean labels, translated here.</caption>
      <thead><tr><th>Tag</th><th>Datasets</th></tr></thead>
      <tbody>
        {갈래.slice(0, 14).map((r) => (
          <tr><th scope="row">{꼬리표영어[r.key] ?? r.key}</th><td class="num">{쉼표(r.count)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>What they come as</h2>
  <p class="walk">
    {꼴.slice(0, 8).map((r) => `${r.key} ${쉼표(r.count)}`).join(' · ')}
  </p>

  <h2>The oldest ones still listed</h2>

  <div class="scroll-x">
    <table>
      <caption>Longest since an update. Titles are quoted as examples; we do not republish the data.</caption>
      <thead><tr><th>Dataset</th><th>Last updated</th><th>Months ago</th></tr></thead>
      <tbody>
        {오래된것.map((r) => (
          <tr>
            <th scope="row">{r.title}{이름덧말[r.title] && <span class="gloss">{이름덧말[r.title]}</span>}</th>
            <td class="num">{r.updated}</td><td class="num">{r.monthsAgo}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    One of these is worth naming for our own readers: <b>{한류자료.title}</b>, last updated
    {' '}{한류자료.updated} &mdash; {한류자료.monthsAgo} months ago. Anyone reaching for Korean data on
    overseas Hallyu audiences will find a shelf that stopped before the last several years of it.
  </p>

  <h2>What we could not measure</h2>
  <ul>{d.notMeasured.map((s: string) => <li>{s}</li>)}</ul>

  <KcwMethodLimits
    method={{
      'What this is': d.whatThisIs,
      'How we counted': `Every listing on the platform, archived on ${d.archivedOn}, read one row at a `
        + `time. Price band, stated update cycle, formats and topic tags come from the listing itself; `
        + `age is the gap between the listing's own last-updated date and ${d.measuredAt}.`,
      Licence: d.licence,
    }}
    limitation={{
      'What this is not': 'Not a judgement on any dataset. We count what the listing says about it, not '
        + 'what is inside it, and an old dataset about an old year is doing its job.',
    }} />

  <p class="asof">Measured {d.measuredAt}, from a listing archived {d.archivedOn}.</p>

  <KcwRelatedArticles page="/korea-culture-data-market" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.gap td, tr.gap th { background: #fdf6ec; }
  .note { font-size: .95rem; color: #555; }
  .gloss { display: block; font-size: .85rem; font-weight: 400; color: #666; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    tr.gap td, tr.gap th { background: #2a2317; }
    .note, .gloss { color: #aaa; }
    .asof { color: #999; }
  }
</style>
