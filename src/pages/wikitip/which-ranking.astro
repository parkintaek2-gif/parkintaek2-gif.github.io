---
/**
 * K Culture Wire — **「어느 순위가 진짜인가」.** (`/which-ranking`)
 *
 * ── 🔴 왜 (2026-08-31 · 사장님 지시) ─────────────────────────
 * > 「**논쟁꺼리를 우리가 만든다.** 거기에 댓글을 붙일 수 있는 기능을 2번이 만들기 시작했다」
 * > 「사람들이 관심이 많은 모든 것에 대해 순위를 매겨...**그 순위가 의미가 있는 지 생각해보게 해**」
 * > 「콘텐트 제목도 사람들의 이목을 끌어 클릭할 수 있게 만들어, **그래프도 만들고**, …데이터로」
 *
 * ── ⛔ 이 지면이 «절대» 하지 않는 것 ─────────────────────────
 * ⛔ **「이게 진짜 1위다」로 바꿔치기하지 않는다.** 그러면 남의 순위를 우리 순위로 갈아 끼운 것뿐이다.
 *   셋을 나란히 놓고 **보는 사람이 정한다** — 우리는 바늘을 안 세운다(강령).
 * ⛔ 우리가 작품을 «평가»해 순위를 만들지 않았다. 셋 다 «센» 것이다.
 * ⚠ 잰 자리가 다르다 — 시청시간은 넷플릭스가 내는 «세계 합계», 나라 수·주 수는 «나라별 톱10».
 *   ⇒ 순서가 다른 것이 «이상한 일이 아니다». 그것을 화면에 먼저 적는다.
 * ⛔ 그래프는 인라인 SVG 다. 새 JS 라이브러리를 안 쓴다(사이트 관행).
 * ⛔ 화면에 한국어를 안 쓴다 — 영문 지면이다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/kcw-which-ranking.json';
/**
 * 🔴 [2026-09-03] 이 지면이 `/title/i-am-solo` 를 걸고 있었다 — **그런 지면이 없다.**
 *   이 사이트는 자료 여섯 줄 미만인 작품에는 지면을 안 낸다(i-am-solo 는 한 줄이다).
 *   `check-visitor-walk` 가 잡았다. 손님이 누르면 404 를 만난다.
 * ⛔ 그 줄을 표에서 «지우지» 않는다 — 순위 대조가 이 지면의 요점이고, 지면이 없는 것은
 *   그 작품의 잘못이 아니다. **링크만 걷는다.**
 * ⛔ 어느 것이 지면이 있는지 손으로 적지 않는다 — `hasPage` 를 읽는다. 문턱이 바뀌면 저절로 따라온다.
 */
import 작품지면 from '../../data/wikitip-title-pages.json';
const 지면있는것 = new Set((작품지면.titles ?? []).filter((t: any) => t.hasPage).map((t: any) => t.slug));
const 지면있나 = (slug: string) => 지면있는것.has(slug);

const 행 = data.행;
const 최대 = 행[0];
const 어긋난것 = 행.filter((r: any) => Number.isFinite(r.어긋남) && r.어긋남 >= 3);
const 크게 = data.가장어긋난것;

/* ⭐ 제목에 «작품 이름»이 들어간다 — 사장님: 「스타 이름이 이렇게 제목에 나와야해」 */
const TITLE = `Squid Game is number one by hours. By countries it is ${최대.나라자리 === 1 ? 'first too' : `number ${최대.나라자리}`}, `
  + `and ${data.나라수1위.제목} is first`;
const DESC = `Netflix publishes one ranking of Korean titles: hours viewed worldwide. We counted two more — `
  + `how many countries a title charted in, and how many weeks it stayed. Of the top ${data.본편수} by hours, `
  + `${data.크게어긋난편수} move at least three places. ${크게.제목} is number ${크게.시간자리} by hours and `
  + `number ${크게.나라자리} by countries.`;

/* 막대 하나 — ⛔ 눈금 없는 막대를 그리지 않는다. 수를 옆에 적는다 */
const 막대 = (값: number, 최대값: number, 너비 = 120) =>
  Math.max(2, Math.round((값 / 최대값) * 너비));
const 최대나라 = Math.max(...행.map((r: any) => r.나라수 ?? 0));
const 최대주 = Math.max(...행.map((r: any) => r.주수 ?? 0));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10'],
  temporalCoverage: data.원자료.주,
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/which-ranking">
  <h1>Which ranking is the real one?</h1>

  <p class="lead">
    Netflix publishes <b>one</b> ranking of Korean titles: hours viewed, worldwide. By that ruler
    <b>{최대.제목}</b> is first, with {최대.시간말}. It is the number everybody quotes.
  </p>

  <p class="lead">
    We counted two more rulers from Netflix&rsquo;s own country files &mdash; <b>how many countries
    a title charted in</b>, and <b>how many weeks it stayed on a chart</b>. Change the ruler and the
    order comes apart. Of the top {data.본편수} by hours, <b>{data.크게어긋난편수} move at least three
    places</b>. {크게.제목} is number {크게.시간자리} by hours and number {크게.나라자리} by countries
    &mdash; {크게.어긋남} places apart.
  </p>

  <p class="warn">
    <b>Before the table: these three rulers do not measure the same thing, and we are not saying one
    of them is wrong.</b> Hours viewed is a worldwide total Netflix publishes itself. Countries and
    weeks come from the separate per-country top 10 files. A title can pile up enormous hours in a
    few large markets, or spread thinly across ninety. <b>Neither of those is more real than the
    other.</b> What we are showing is that the word &ldquo;biggest&rdquo; hides a choice, and the
    choice is usually made for you.
  </p>

  <section>
    <h2>The same {data.본편수} titles, three rulers</h2>
    <p class="fine">
      Ordered by hours &mdash; Netflix&rsquo;s own ranking. The two columns beside it are where the
      same title lands when you count countries, or weeks.
    </p>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th class="num">By hours</th>
          <th class="num">By countries</th>
          <th class="num">By weeks</th>
          <th>Countries reached</th>
        </tr>
      </thead>
      <tbody>
        {행.map((r: any) => (
          <tr>
            <td class="nm">{지면있나(r.slug) ? <a href={`/title/${r.slug}`}>{r.제목}</a> : r.제목}</td>
            <td class="num">{r.시간자리}</td>
            <td class={`num ${Number.isFinite(r.어긋남) && r.어긋남 >= 3 ? 'far' : ''}`}>{r.나라자리 ?? '—'}</td>
            <td class="num">{r.주자리 ?? '—'}</td>
            <td>
              {/* ⛔ 눈금 없는 막대를 안 그린다 — 수를 반드시 옆에 적는다 */}
              <svg width="130" height="12" role="img" aria-label={`${r.나라수} countries`}>
                <rect x="0" y="3" width={막대(r.나라수, 최대나라)} height="7" rx="1.5" fill="#f0b6c8" />
              </svg>
              <span class="num sm">{r.나라수}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="fine">
      Pink figures in the &ldquo;by countries&rdquo; column are titles that move three or more places
      from their position by hours.
    </p>
  </section>

  <section>
    <h2>The two titles the hours ranking never shows you</h2>
    <p>
      <b>{지면있나(data.나라수1위.slug) ? <a href={`/title/${data.나라수1위.slug}`}>{data.나라수1위.제목}</a> : data.나라수1위.제목}</b> reached
      {' '}<b>{data.나라수1위.나라수} countries</b> &mdash; more than any other Korean title we hold.
      {' '}<b>{지면있나(data.주수1위.slug) ? <a href={`/title/${data.주수1위.slug}`}>{data.주수1위.제목}</a> : data.주수1위.제목}</b> spent
      {' '}<b>{data.주수1위.주수} weeks</b> on country top 10s, the longest run of any of them, and it
      is nowhere near the top of the hours list. If you had only ever seen the hours ranking, you
      would not know either fact.
    </p>
    <svg viewBox="0 0 640 120" width="100%" height="120" role="img"
      aria-label="Weeks on country top 10 for the longest-running titles">
      {행.slice(0, 8).map((r: any, i: number) => (
        <>
          <rect x="150" y={4 + i * 14} width={막대(r.주수 ?? 0, 최대주, 380)} height="9" rx="1.5" fill="#b07a92" />
          <text x="146" y={12 + i * 14} text-anchor="end" font-size="9.5" fill="#a89aa4">{r.제목.slice(0, 26)}</text>
          <text x={156 + 막대(r.주수 ?? 0, 최대주, 380)} y={12 + i * 14} font-size="9.5" fill="#e9e6dd">{r.주수}w</text>
        </>
      ))}
    </svg>
  </section>

  {/*
    ⭐ 논쟁 물음. ⛔ 우리가 답을 정해 두지 않는다 — 어느 쪽도 「맞다」고 안 쓴다.
    ⚠ 댓글은 2번이 만드는 중이다. 완성되면 이 자리 밑에 붙인다(3자 추적 위젯은 안 쓴다).
  */}
  <section class="ask">
    <h2>So which one counts?</h2>
    <p>
      A show watched enormously in a handful of countries, or a show that charted in ninety and
      never topped any of them &mdash; <b>which one travelled further?</b> There is a real answer
      for whatever you are trying to decide, and it is not the same answer for a distributor, a
      subtitler and a fan. We are not going to pick one for you.
    </p>
    {/*
      🔴 [2026-08-31 20:1x] **2번의 댓글이 나왔다 — 붙였다.**
        사장님: 「논쟁꺼리를 우리가 만든다. 거기에 댓글을 붙일 수 있는 기능을 2번이 만들기 시작했다」
        3번이 `/ranking-university` 에 붙인 것과 «같은 방식»이다(세션간-메모 160848).
      ⭐ 2번이 만든 것이라 쿠키도 IP 도 안 남는다 — 3자 추적 위젯을 안 쓴다는 약속을 지킨다.
      ⚠ `data-comments-page` 는 이 지면의 주소와 «같아야» 한다. 다르면 남의 방에 글이 쌓인다.
    */}
    <h2 class="cm">What do you think?</h2>
    <script src="/comments-widget.js" defer></script>
    <div data-comments-page="/which-ranking"></div>
    <p class="fine">
      No cookie, no IP, no third-party tracker &mdash; we built this ourselves.
    </p>
  </section>

  <KcwRelatedArticles page="/which-ranking" />

  <KcwMethodLimits
    method={{
      'Hours viewed': `Netflix's own published global top 10, ${data.원자료.주}, ${data.원자료.세계톱10작품수} Korean titles, ${(data.원자료.총시간 / 1e9).toFixed(1)} billion hours in total`,
      'Countries and weeks': 'Netflix per-country weekly top 10 files, counted by us',
      'Titles shown': `The top ${data.본편수} by hours that we also hold a page for`,
      Measured: data.잰날,
    }}
    limitation={{
      'Different rulers': 'Hours is a worldwide total; countries and weeks come from per-country charts. They are not the same measurement and we do not treat one as the correction of the other.',
      'Not viewers': 'Hours viewed is hours, not people. Netflix publishes no viewer counts and no per-country hours at all.',
      'Not availability': 'A title absent from a country chart may still have been available there. Charting is not availability.',
      'Our own panel': `Which titles count as Korean is our inference — Netflix states no country of production. ${(data['⬜ 우리 표에 없어 못 잰 작품'] ?? []).length} of the hours top ${data.본편수} are not in our table, and we left them out rather than scoring them zero.`,
    }}
    note="The same three counts power the ranking columns on every title page."
  />

  <style>
    table { width: 100%; border-collapse: collapse; margin: .8rem 0; }
    th, td { padding: .5rem .45rem; border-bottom: 1px solid var(--line); font-size: .93rem; }
    th { text-align: left; color: var(--muted); font-weight: 700; font-size: .82rem; letter-spacing: .04em; }
    .num { text-align: right; font-variant-numeric: tabular-nums; }
    .num.far { color: #f0b6c8; font-weight: 800; }
    .sm { font-size: .84rem; color: var(--muted); padding-left: .35rem; }
    .nm { min-width: 10rem; }
    .ask { border-top: 2px solid var(--line); padding-top: 1.1rem; margin-top: 2rem; }
    .ask h2 { margin-top: 0; }
    .ask h2.cm { margin-top: 1.6rem; }
    svg { display: block; max-width: 100%; }
    td svg { display: inline-block; vertical-align: middle; }
    @media (max-width: 640px) { table { font-size: .86rem; } .nm { min-width: 7rem; } }
  </style>
</WikiTip>
