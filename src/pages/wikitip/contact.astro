---
/**
 * K Culture Wire — **연락할 자리**. (`/contact`)
 *
 * ── 왜 만드나 (2026-08-07 18:0x, 손님으로 걸어 보고) ────────────
 * 33곳을 걸어 보니 `/contact` 이 **404** 였다.
 * 상품 한 벌 README 에는 메일 주소를 적어 뒀는데 **사이트에는 없었다.**
 * 잘못된 숫자를 본 사람이 알려 줄 방법이 없었다는 뜻이다 —
 * 「우리가 틀린 것을 숨기지 않는다」고 지면마다 적어 놓고, 알려 줄 문이 없었다.
 *
 * ── ⛔ 부풀리지 않는다 ─────────────────────────────────────────
 * 「24시간 응대」 「전담 매니저」 같은 말을 쓰지 않는다. 사실이 아니다.
 * **언제 답하는지를 재서 적는다** — 지금은 「하루 안」이 정직한 말이다.
 * ⛔ 「언론사」 「newsroom」 을 쓰지 않는다. 인터넷신문 등록 전이다(사장님 지시 2026-08-04).
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import { PUBLISHER } from '../../consts';

const MAIL = 'parkintaek2@gmail.com';
const 제목 = (s: string) => `mailto:${MAIL}?subject=${encodeURIComponent(s)}`;

const TITLE = 'Contact';
const DESC = 'How to reach K Culture Wire — to report a number that looks wrong, to ask what our '
  + 'data can and cannot answer, or to be added to the list.';
---

<WikiTip title={TITLE} description={DESC} canonical="https://www.kculturewire.com/contact">
  <h1>{TITLE}</h1>

  <p class="lede">
    One address, read by the people who make the numbers:
    <a href={`mailto:${MAIL}`}><b>{MAIL}</b></a>
  </p>

  <h2>If a number looks wrong</h2>
  <p>
    Tell us which page and which figure. You do not need to be sure — <b>&quot;this looks off&quot;
    is enough</b>, and we would rather check ten times for nothing than leave one wrong figure
    standing. On 7 August 2026 a single flaw in how we matched titles had put wrong numbers on
    seven pages and four pieces at once, and we found it ourselves only because we went looking.
  </p>
  <p>
    Whatever we change, the old value stays visible on{' '}
    <a href="/corrections">the corrections page</a> beside the new one.
  </p>
  <p class="act">
    <a class="btn" href={제목('K Culture Wire — a number looks wrong')}>Report a figure</a>
  </p>

  <h2>If you want to use the data</h2>
  <p>
    Tell us what you are trying to measure. We will tell you whether our panels can answer it —{' '}
    <b>including when they cannot</b>, which is often. Netflix publishes no country of production
    and no hours outside its global chart; Wikipedia measures looking-up, not listening. Those
    limits are on every page and they will be in the first reply.
  </p>
  <p class="act">
    <a class="btn" href={제목('K Culture Wire — data enquiry')}>Ask about the data</a>
  </p>

  <h2>If you just want to follow along</h2>
  <p>
    <a href="/subscribe">Ask to be on the list</a> and each new piece goes out as it is published.
  </p>

  <h2>How fast we answer</h2>
  <p>
    Within a day. We are a small operation and we would rather say that plainly than promise an
    hour. If something is urgent, put <b>urgent</b> in the subject line and it moves to the top.
  </p>

  <p class="who">
    {/* ⛔ 2026-08-08. 여기에 {PUBLISHER} 를 그대로 썼다 — 객체라 화면에 [object Object] 가 나갔다.
        회사 이름이 그렇게 나가는 자리가 두 장 있었다. 등기부 영문 상호를 쓴다. */}
    {PUBLISHER.legalName} &middot; <a href="/about">How we make these numbers</a> &middot;{' '}
    <a href="/articles">Everything we have published</a>
  </p>

  <style>
    .lede { font-size: 1.08rem; margin-bottom: 2rem; }
    h2 { font-size: 1.12rem; margin: 2.2rem 0 .6rem; }
    .act { margin: 1rem 0 0; }
    .btn {
      display: inline-block; padding: .6rem 1.1rem; border-radius: 8px;
      background: var(--accent); color: #fff; font-weight: 600; text-decoration: none;
      font-size: .95rem;
    }
    .who { color: var(--muted); font-size: .9rem; margin-top: 2.6rem; }
  </style>
</WikiTip>
