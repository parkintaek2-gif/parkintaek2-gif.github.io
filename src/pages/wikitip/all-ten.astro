---
/**
 * all-ten.astro — **한 나라의 열 자리를 한국 작품이 다 차지한 주.**
 *
 * ── 🔴 왜 이 지면이 생겼나 (2026-09-03) ────────────────────────
 * `wikitip-clumping.json` 의 `byMarket` 에 **안 쓰던 축 둘**이 있었다 —
 * ```
 *   clumping        그 나라에서 한국 작품이 «몰려» 오나
 *   mostInOneWeek   한 주에 최대 몇 자리를 차지했나
 * ```
 * 몰림이 가장 심한 넷이 말레이시아·싱가포르·인도네시아·필리핀 — **우리 1차 독자**다.
 * 그리고 말레이시아·인도네시아는 `mostInOneWeek = 10` 이었다. 열 자리 전부다.
 * 세어 보니 그런 칸이 여덟이고, 그중 넷이 한국 밖이었다.
 *
 * ⭐ 우리 기사 `/article/the-four-weeks-the-whole-shelf-was-korean` 은 같은 것을
 *   **나라를 한 통에 넣고** 셌다. 이 지면은 **나라별·차트별로** 갈라 낸다.
 *
 * ── ⛔ 이 지면이 지키는 것 ──────────────────────────────────────
 * ⛔ 「석권」·「인기」라 안 쓴다. 우리가 가진 것은 차트 «자리»다.
 * ⛔ 여덟 칸으로 「어느 나라가 그런 나라인가」를 말하지 않는다 — 여덟은 너무 적다.
 *   그래서 **아홉 자리(아슬아슬하게 놓친 칸) 43개**를 나란히 낸다. 그쪽이 나라를 말해 준다.
 * ⛔ 수를 손으로 적지 않는다. `kcw-all-ten-weeks.json` 에서 읽는다.
 * ⚠ 「열 자리」가 「열 편」이 아니다 — 넷플릭스는 시즌을 따로 싣는다. 그 수도 같이 낸다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwDataBasis from '../../components/KcwDataBasis.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import { 목록구조화 } from '../../lib/list-jsonld.ts';
import d from '../../data/kcw-all-ten-weeks.json';

const 칸들 = d.cells ?? [];
const 밖의칸 = 칸들.filter((c: any) => c.iso2 !== 'KR');
const 집의칸 = 칸들.filter((c: any) => c.iso2 === 'KR');
const 밖의시장 = (d.byMarket ?? []).filter((m: any) => m.iso2 !== 'KR');
const 아홉밖 = (d.nineByMarket ?? []).filter((m: any) => m.iso2 !== 'KR');
const 수 = (n: number) => Number(n).toLocaleString('en-US');

/* ⛔ 날짜를 「보기 좋게」 다시 쓰지 않는다 — 넷플릭스가 싣는 주 시작일 그대로 둔다.
   손님이 tudum 에서 그 주를 찾아 확인할 수 있어야 한다. */
const 주글 = (w: string) => new Date(`${w}T00:00:00+09:00`)
  .toLocaleDateString('en-GB', { timeZone: 'Asia/Seoul', day: 'numeric', month: 'long', year: 'numeric' });

const TITLE = `Every Netflix top 10 that was all Korean, country by country`;
const DESC = `${d.allTenCells} times a Netflix country chart has been Korean in all ten places — `
  + `${밖의칸.length} of them outside Korea, in ${밖의시장.length} countries. `
  + `Counted from ${수(d.cellsRead)} country-week charts.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/all-ten"
  jsonLd={목록구조화({
    주소: '/all-ten',
    이름: 'Netflix charts that were Korean in all ten places',
    설명: DESC,
    /* ⚠ 지면의 표와 «같은 순서»(이른 주부터)로 낸다 */
    줄들: 칸들.map((c: any) => ({ name: `${c.name}, week of ${c.week}` })),
  }, ['https://www.kculturewire.com/clumping'])}>
  <h1>Every Netflix top 10 that was all Korean</h1>

  <p class="lead">
    A Netflix country chart has ten places. <b>{d.allTenCells} times</b> in
    {' '}{수(d.cellsRead)} country-week charts, Korean titles held every one of them.
    {' '}<b>{밖의칸.length}</b> of those were outside Korea.
  </p>

  <section>
    <h2>Outside Korea</h2>
    <table>
      <thead>
        <tr>
          <th>Country</th><th>Week beginning</th><th>Chart</th>
          <th class="num">Places</th><th class="num">Different shows</th>
        </tr>
      </thead>
      <tbody>
        {밖의칸.map((c: any) => (
          <tr>
            <td><b>{c.name}</b></td>
            <td>{주글(c.week)}</td>
            <td>{c.chart === 'TV' ? 'Series' : c.chart}</td>
            <td class="num">10</td>
            <td class="num">{c.distinctTitles}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      {/* ⚠ 이 한 줄이 이 표에서 가장 자주 오해받는 자리다 */}
      Ten places is not always ten shows. Netflix lists a series&rsquo; seasons separately, so a
      chart can be full of Korean titles and still be one show twice &mdash; the last column says
      how many different shows each of these was.
    </p>
  </section>

  <section>
    <h2>At home</h2>
    <p>
      Korea&rsquo;s own chart did it <b>{집의칸.length}</b> times, which is the unremarkable half of
      this count: a country&rsquo;s chart being full of its own films and shows is what most
      countries&rsquo; charts look like most weeks.
    </p>
    <ul class="walk">
      {집의칸.map((c: any) => (
        <li>{주글(c.week)} &mdash; {c.distinctTitles} different shows in ten places</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>The near misses say more than the full house</h2>
    <p>
      Eight cells is too few to say which countries are the ones where this happens. So we counted
      the cells that came within one place &mdash; <b>{수(d.nineOfTenCells)}</b> of them, nine of ten
      places Korean. Outside Korea they fall in <b>{아홉밖.length}</b> countries, and they are the
      same countries.
    </p>
    <table>
      <thead>
        <tr><th>Country</th><th class="num">All ten</th><th class="num">Nine of ten</th></tr>
      </thead>
      <tbody>
        {아홉밖.map((m: any) => (
          <tr>
            <td><b>{m.name}</b></td>
            <td class="num">{(밖의시장.find((x: any) => x.iso2 === m.iso2)?.weeks) ?? 0}</td>
            <td class="num">{m.weeks}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      Every country in that table is in Southeast Asia. No European, North American, Latin American
      or African chart has ever come within one place of it, in
      {' '}{수(d.cellsRead)} country-week charts.
    </p>
    <p class="note">
      {/* ⚠ /clumping 이 「나라 이름을 일부러 안 낸다」고 못박아 두었다. 두 지면이 서로
          모순돼 보이지 않게, 여기서 왜 이름을 내는지 적는다 */}
      <b>This is not a league table.</b> Our
      {' '}<a href="/clumping">clumping page</a> deliberately names no market, because ranking 93
      countries by how lopsided their Korean weeks are invites the reader to treat position as
      merit. Here the countries are named because what is counted is an event with a date, not a
      position &mdash; and what produces it is release timing and chart volatility, not quality.
    </p>
  </section>

  <KcwDataBasis
    whatThisIs={d.unit}
    whatThisIsNot={d.whatThisIsNot}
    notes={[d.source, d.koreanRule]}
    counts={[
      { label: 'Chart rows read', value: d.rowsRead },
      { label: 'Country-week charts', value: d.cellsRead },
      { label: 'All ten places Korean', value: d.allTenCells },
      { label: 'Nine of ten places Korean', value: d.nineOfTenCells },
    ]} />

  <p class="note">
    The other side of this measurement &mdash; how often Korean titles arrive together rather than
    one at a time, in every market &mdash; is on <a href="/clumping">the clumping page</a>.
    {' '}<a href="/by-country">Country by country</a> has each market&rsquo;s Korean share.
  </p>

  <KcwRelatedArticles page="/all-ten" />
</WikiTip>

<style>
  table { border-collapse: collapse; width: 100%; margin: 0.8rem 0; }
  th, td { padding: 0.35rem 0.5rem; border-bottom: 1px solid #e5e7eb; text-align: left; }
  th.num, td.num { text-align: right; }
  .num { font-variant-numeric: tabular-nums; }
  .walk { list-style: none; padding: 0; }
  .walk li { padding: 0.2rem 0; }
  .note { font-size: 0.92em; color: #4b5563; }
</style>
