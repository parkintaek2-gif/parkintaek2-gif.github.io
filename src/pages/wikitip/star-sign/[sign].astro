---
/*
 * star-sign/[sign].astro — **서양 별자리 열두 장.** (5번, 2026-08-24 밤)
 *
 * ── 🔴 왜 이 지면이 생겼나 — 오늘 밤 «세 번째» 같은 오류 ──────
 * 사장님 「방문자 늘리는 데 올인하라」로 잰 낱말을 다시 훑다가 찾았다 —
 * ```
 *   kpop zodiac signs      자동완성 1번째 · 4줄
 *      kpop zodiac signs cancer
 *      kpop zodiac signs taurus       ← 손님이 묻는 것은 «서양 별자리»다
 *
 *   내 지면 /zodiac · /star-signs     둘 다 «띠»(해 단위)다
 *   그 지면에 cancer·taurus 라는 말    0번
 * ```
 * 자료는 있는데(생년월일 9,249건) 낱알이 또 틀렸다.
 * 오늘 밤 같은 잘못을 세 번 했다 — 날/달 · title-that-charted/korean-drama · 띠/별자리.
 * ⭐ 공통점은 하나다: **내가 가진 이름표를 손님 이름표로 착각했다.**
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **점을 치지 않는다.** 「사자자리는 이렇다」를 한 줄도 안 쓴다. 우리는 날짜를 셀 뿐이다.
 *   ⭐ 그리고 우리에겐 **직접 잰 반증**이 있다 — `/star-signs` 에서 1,047명으로
 *     띠가 차트 진입을 예측하는지 재 보고 「우연과 구별되지 않는다」고 냈다.
 *     그 결과를 열두 장에 그대로 붙인다. 이것이 우리가 다른 별자리 지면과 다른 점이다.
 * ⛔ 경계일을 «확정»으로 말하지 않는다. 별자리 경계는 해마다 몇 시간씩 흔들린다 —
 *   그 자리에 몇 명이 있는지를 지면에 적고, 자기 해에는 다를 수 있다고 밝힌다.
 * ⛔ 자리마다 사람 수가 다른 것을 «뜻»으로 읽지 않는다. 자리 길이도 다르고(29~32일)
 *   위키데이터가 인구조사도 아니다.
 * ⛔ 수를 이 지면에서 세지 않는다 — `wikitip-western-signs.json` 에서 읽는다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-western-signs.json';
import people from '../../../data/wikitip-people.json';
import { 이름표만들기, 이지면의문, 문 } from '../../../lib/person-link';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다(오늘 그것으로 빌드가 멈췄다).
     자료는 여기서 직접 읽고, 지면이 쓸 것은 props 로 건넨다 */
  const 자리들 = data.signs ?? [];
  /* 🔴 [2026-08-26] 이 표의 이름도 «글자»였다. 사람 지면으로 가는 문을 단다.
     ⛔ 이름이 겹치면 안 건다 — 틀린 문은 없는 문보다 나쁘다(person-link 참고). */
  const { 표: 사람표 } = 이름표만들기(people.people ?? []);
  return 자리들.map((s, i) => ({
    params: { sign: s.slug },
    props: {
      s,
      사람문: 이지면의문((s.top ?? []).map((p: any) => p.name), 사람표),
      앞: 자리들[(i + 자리들.length - 1) % 자리들.length],
      뒤: 자리들[(i + 1) % 자리들.length],
      전체: 자리들.reduce((a, x) => a + x.people, 0),
    },
  }));
}

const { s, 앞, 뒤, 전체, 사람문 } = Astro.props as { s: any; 앞: any; 뒤: any; 전체: number ; 사람문: Record<string, string> };

const 못실린 = s.people - s.listed;
const 몫 = 전체 > 0 ? (100 * s.people) / 전체 : null;
const 날글 = (v: string) => {
  const [m, d] = String(v).split('-').map(Number);
  const 달 = ['January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'][m - 1];
  return `${d} ${달}`;
};

const TITLE = `Korean actors who are ${s.name} — ${s.people.toLocaleString('en-US')} of them, `
  + `born ${날글(s.from)} to ${날글(s.to)}`;
const DESC = `${s.people.toLocaleString('en-US')} Korean actors, singers and other entertainers were `
  + `born between ${날글(s.from)} and ${날글(s.to)}. ${s.listed.toLocaleString('en-US')} are named here. `
  + `Counted from birth dates — this is arithmetic on a date, not astrology.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/star-sign/${s.slug}`}>
  <h1>Korean actors who are {s.name}</h1>

  {/* ⭐ 답을 맨 앞에. 손님이 물은 것은 「몇 명이냐」와 「누구냐」다 */}
  <p class="lead">
    <b>{s.people.toLocaleString('en-US')}</b> Korean actors, singers and other entertainers were
    born between <b>{날글(s.from)}</b> and <b>{날글(s.to)}</b>.
    {' '}<b>{s.listed.toLocaleString('en-US')}</b> of them are named on this page.
    {몫 !== null && <> They are {몫.toFixed(1)}% of the {전체.toLocaleString('en-US')} people we hold.</>}
  </p>

  {/*
    🔴 이 칸을 뺄 수 없다. 별자리 지면은 대개 점을 치는 자리이고, 우리는 그 자리에 들어가면서
      **아무것도 안 말한다**고 먼저 밝혀야 한다. 그리고 우리에겐 직접 잰 반증이 있다.
  */}
  <section class="warn-box">
    <h2>We are not telling you what this means</h2>
    <p class="warn">
      <b>A star sign here is arithmetic on a birth date and nothing else.</b> We do not say what
      {' '}{s.name} is like, because we have not measured anything that would let us say it.
    </p>
    <p class="note">
      We did test the nearest thing to a claim. Across 1,047 Korean actors who reached a Netflix
      chart, the spread across birth-year animals was <b>indistinguishable from chance</b>.
      {' '}<a href="/star-signs">That test is here</a>, with the working shown.
    </p>
  </section>

  {(s.top ?? []).length > 0 && (
    <section>
      <h2>Some of the names</h2>
      <p class="note">
        Ordered by how many Wikipedia language editions carry an article about them.
        <b> That measures how widely someone is written about, not how good they are</b>, and it
        favours people who have been famous longer.
      </p>
      <div class="scroll-x">
        <table>
          <thead><tr><th>Name</th><th>Born</th><th>Wikipedia languages</th></tr></thead>
          <tbody>
            {s.top.map((p: any) => (
              <tr>
                <td class="nm">{문(p.name, 사람문)
                  ? <a href={문(p.name, 사람문)}>{p.name}</a> : p.name}</td>
                <td>{p.born}</td>
                <td class="tot">{p.languages ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note fine">A dash means we hold no figure, not a zero.</p>
    </section>
  )}

  <section>
    <h2>Find someone by the exact day</h2>
    <p class="note">
      This page groups a month of dates together. If you know the day, the birthday pages are the
      faster way in — one page per calendar day, and one per month.
    </p>
    <ul class="walk">
      <li><a href="/born-on">All 366 days of the year</a></li>
      <li><a href="/born-in/january">Month by month, all twelve</a></li>
      <li><a href="/actors-in-their/30s">By age band</a></li>
      <li><a href="/school">By the school they studied at, 55 of them</a></li>
      <li><a href="/community">The twelve birth-year rooms</a></li>
    </ul>
  </section>

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Wikidata</b> — date of birth, best-ranked, day precision only; South Korean citizenship;
        an entertainment occupation. CC0. The sign is computed from the month and day alone.
      </li>
    </ul>
    <p class="note">
      <b>Sign boundaries move.</b> They shift by a few hours from year to year, so the published
      dates are an approximation. <b>{s.onCusp}</b> of the people here were born on a boundary day
      and may fall the other way in their own birth year. We do not silently pick one — we count
      them here and tell you the number.
    </p>
    <p class="note">
      <b>{못실린.toLocaleString('en-US')} of the {s.people.toLocaleString('en-US')} people in this
      sign are counted but not named.</b> Their only name on Wikidata is written in Korean, and this
      is an English-language site. We would rather count someone and not name them than leave them
      out of the count.
    </p>
    <p class="note">
      <b>A bigger sign does not mean more people are born under it.</b> The signs are not the same
      length (29 to 32 days), and who has a Wikidata entry is decided by editors, not by us.
    </p>
  </section>

  <section class="onward">
    <h3>The other signs</h3>
    <ul>
      <li><a href={`/star-sign/${앞.slug}`}>Korean actors who are {앞.name}</a>
        <span class="fine"> &mdash; {앞.people.toLocaleString('en-US')}</span></li>
      <li><a href={`/star-sign/${뒤.slug}`}>Korean actors who are {뒤.name}</a>
        <span class="fine"> &mdash; {뒤.people.toLocaleString('en-US')}</span></li>
      <li><a href="/star-signs">The birth-year animals, and the test that failed</a></li>
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: .5rem 1rem; margin: 0 0 1.6rem; }
</style>
