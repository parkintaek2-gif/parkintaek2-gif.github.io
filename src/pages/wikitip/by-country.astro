---
/**
 * K Culture Wire — **93개국으로 들어가는 문 한 장.** (`/by-country`)
 *
 * ── 🔴 왜 이 지면이 없었나가 문제였다 (2026-08-22) ────────────
 * `/market/<나라>` 93장이 라이브인데 **그 93장을 한자리에 모아 놓은 지면이 없었다.**
 * 손님은 어느 나라 지면이 있는지 알 길이 없고, 검색엔진도 93장을 한 줄에서 못 본다.
 * 방은 있고 복도가 없었다.
 *
 * ⭐ 그리고 이 문 이름은 **잰 말**이다. 사장님 지시(「검색량」)로 자동완성을 쟀더니 —
 * ```
 *  netflix top 10 by country        1번째로 뜬다
 *    netflix top 10 movies by country / series by country / every country / all countries
 * ```
 * 그 말이 그대로 이 지면의 제목이 된다. 우리 말(「market」)이 아니라 손님 말(「country」)이다.
 * ⚠ 주소도 `/markets` 가 아니라 `/by-country` 로 둔다 — 같은 까닭이다.
 *
 * ── ⛔ 이 지면이 하지 않는 것 ─────────────────────────────────
 * ⛔ 나라를 줄 세워 등수를 매기지 않는다. **알파벳 순**으로 놓고 비중을 옆에 적는다.
 *   (비중 순으로 세우면 「한국물이 적은 나라는 뒤떨어진다」로 읽힌다 — 우리는 그 말을 안 한다)
 * ⛔ 「차트에 들었다」를 「볼 수 있다」로 바꿔 쓰지 않는다.
 * ⛔ 지면이 없는 나라를 지면 있는 척 걸지 않는다 — `hasPage` 로 가른다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import data from '../../data/wikitip-markets.json';

const TITLE = 'Netflix top 10 by country: how Korean is each chart?';
const DESC = 'Every country in Netflix’s weekly top 10 files, with the share of its chart slots that '
  + 'went to Korean titles. South Korea’s own chart is half Korean; the middle country is under five '
  + 'per cent. Charting is not the same as being available.';

/** ⛔ 등수를 매기지 않는다 — 이름 순으로 놓는다 */
const 나라들 = [...data.markets].sort((a, b) => a.name.localeCompare(b.name, 'en'));
const 지면있는것 = 나라들.filter((m) => m.hasPage);
const 지면없는것 = 나라들.filter((m) => !m.hasPage);

/* 첫 글자로 갈라 놓는다 — 93줄을 한 덩어리로 두면 아무도 자기 나라를 못 찾는다 */
const 묶음: { 글자: string; 것들: typeof 나라들 }[] = [];
for (const m of 지면있는것) {
  const 글자 = m.name[0].toUpperCase();
  const 끝 = 묶음[묶음.length - 1];
  if (끝 && 끝.글자 === 글자) 끝.것들.push(m);
  else 묶음.push({ 글자, 것들: [m] });
}

const 가장높은 = [...data.markets].sort((a, b) => b.koreanPc - a.koreanPc)[0];
const 가장낮은 = [...data.markets].sort((a, b) => a.koreanPc - b.koreanPc)[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${data.weekFrom}/${data.weekTo}`,
  spatialCoverage: `${data.countryCount} countries`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/by-country">
  <h1>Netflix top 10 by country: how Korean is each chart?</h1>

  <p class="lead">
    Netflix publishes a weekly top 10 for every country it operates in, and it publishes the same
    list for {data.countryCount} of them in one file. We counted how many of those slots went to
    Korean titles, week by week, from {data.weekFrom} to {data.weekTo}. The answer is not one
    number &mdash; it runs from {가장높은.koreanPc}% in {가장높은.name} down to
    {' '}{가장낮은.koreanPc}% in {가장낮은.name}, with the middle country at {data.medians.koreanPc}%.
  </p>

  <p class="warn">
    <b>A chart slot is not a viewing figure and it is not availability.</b> Netflix does not publish
    how many people watched in a country, and it does not publish where a title can be watched at
    all. What is counted here is places on a published weekly list, nothing more.
  </p>

  <section>
    <h2>Pick a country</h2>
    <p class="sub">
      {지면있는것.length} of the {data.countryCount} countries have a page here. A country gets one
      once we hold at least {data.minTitlesForPage} Korean titles for it &mdash; below that the page
      would be a handful of rows pretending to be a picture.
    </p>

    {묶음.map((g) => (
      <div class="grp">
        <h3>{g.글자}</h3>
        <p class="row">
          {g.것들.map((m, i) => (
            <span>
              {i > 0 ? ' · ' : ''}
              <a href={`/market/${m.slug}`}>{m.name}</a>
              <span class="pc"> {m.koreanPc}%</span>
            </span>
          ))}
        </p>
      </div>
    ))}
  </section>

  {지면없는것.length > 0 && (
    <section>
      <h2>Counted but without a page</h2>
      <p class="sub">
        We hold these {지면없는것.length} countries in the same file and they are counted in every
        figure above. They have no page of their own because we hold too few Korean titles for them
        to say anything with. <b>Too few to publish is not the same as zero</b>, and the share is
        printed here rather than dropped.
      </p>
      <p class="row">
        {지면없는것.map((m, i) => (
          <span>{i > 0 ? ' · ' : ''}{m.name}<span class="pc"> {m.koreanPc}%</span></span>
        ))}
      </p>
    </section>
  )}

  <section>
    <h2>Where to walk from here</h2>
    <p>
      <a href="/underrated">The titles that ran for weeks in one country</a> &middot;{' '}
      <a href="/world-share">Which titles reached the most countries</a> &middot;{' '}
      <a href="/titles">Every Korean title we hold</a> &middot;{' '}
      <a href="/community">All the rooms</a>
    </p>
  </section>

  <KcwMethodLimits
    method={`Netflix's own weekly top 10 files, ${data.weekCount} weeks across ${data.countryCount} countries, ${data.weekFrom} to ${data.weekTo}. For each country we counted every slot on its published weekly top 10 and the share of those slots held by a Korean title. Countries are listed alphabetically, not by share, because ordering them by share would read as a ranking of countries and this is not one.`}
    limitation="A slot on a chart is not a viewing figure, and it is not availability — Netflix publishes neither by country. Netflix also states no country of production, so which titles count as Korean is our inference. A country with a small catalogue can show a high share on very few titles, which is why the count of distinct titles is on each country page beside the share."
  />

  <style>
    .lead { font-size: 1.06rem; }
    .warn { border-left: 3px solid var(--accent); padding: .7rem 1rem; margin: 1.4rem 0 2rem;
      font-size: .95rem; }
    h2 { font-size: 1.12rem; margin: 2.4rem 0 .3rem; }
    h3 { font-size: .95rem; margin: 1.2rem 0 .2rem; color: var(--accent); }
    .sub { color: var(--muted); font-size: .92rem; margin: 0 0 .8rem; }
    .grp { margin-bottom: .4rem; }
    .row { margin: .2rem 0; line-height: 2; }
    .pc { color: var(--muted); font-size: .82rem; }
  </style>
</WikiTip>
