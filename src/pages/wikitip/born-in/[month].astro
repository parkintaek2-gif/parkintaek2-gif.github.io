---
/*
 * born-in/[month].astro — **달 단위 생일 지면 12장.** (5번, 2026-08-24)
 *
 * ── 🔴 왜 이 지면이 생겼나 — 내가 한 시간 전에 접은 것이 틀렸다 ──
 * 오늘 저녁 나는 「`/born-on` 366장이 색인은 됐는데 노출 0이니 이 축은 죽었다」고 적었다.
 * 그 뒤 자동완성을 재 보니 **접은 것이 틀렸다** —
 * ```
 *   korean actors birthday      자동완성 1번째 · 그 말로 시작 10줄  ← 내가 잰 것 중 가장 강하다
 *      → korean actors birthday today
 *      → korean actors birthday in july
 *      → korean actors birthday in june
 *      → korean actors birthday in may
 * ```
 * 🔴 **손님은 «달»로 묻는데 내 지면은 «날» 366장이었다.** 축이 죽은 것이 아니라
 *   낱알이 틀렸다. 죽었다고 접기 전에 낱알을 의심해야 했다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **「today」 지면은 만들지 않는다.** 우리 지면은 배포할 때만 다시 지어진다 —
 *   「오늘 생일」 지면은 배포 다음 날부터 거짓이 된다. 자동완성에 있어도 안 만든다.
 *   거짓말하는 지면보다 없는 지면이 낫다.
 * ⛔ **점을 치지 않는다.** 「같은 달에 태어났다」는 그 말뿐이다. 성격도 운도 말하지 않는다.
 * ⛔ 달마다 사람 수가 다른 것을 «의미»로 읽지 않는다 — 날 수도 다르고(28~31),
 *   위키데이터에 실린 사람이 실제 분포와 같다는 보장도 없다. 그 둘을 지면에 적는다.
 * ⛔ 수를 이 지면에서 세지 않는다 — `wikitip-birthday-pages.json` 에서 읽는다.
 * ⭐ 이 지면은 **날 지면 366장으로 가는 복도**다. 그 366장은 지금 들어오는 문이 거의 없다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-birthday-pages.json';

/* 🔴 Astro 는 `getStaticPaths` 를 «따로 떼어» 다른 덩이로 돌린다 — 이 앞뒤에 선언한 값이
   그 안에서 안 보인다. 2026-08-24 에 `달이름 is not defined` 로 빌드가 멈춰서 알았다.
   그래서 달 이름표는 그 함수 «안»에 두고, 지면이 쓸 것은 전부 props 로 건네준다.
   ⛔ 바깥에 같은 이름표를 또 만들지 않는다 — 두 벌이 되면 한쪽만 고치는 날이 온다 */
export function getStaticPaths() {
  const 달이름 = ['January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'];
  return 달이름.map((이름, i) => ({
    params: { month: 이름.toLowerCase() },
    props: {
      달번호: String(i + 1).padStart(2, '0'),
      달이름: 이름,
      앞달: 달이름[(i + 11) % 12],
      뒷달: 달이름[(i + 1) % 12],
    },
  }));
}

const { 달번호, 달이름: 이달, 앞달, 뒷달 } = Astro.props as
  { 달번호: string; 달이름: string; 앞달: string; 뒷달: string };

const 날들 = (data.days ?? []).filter((d: any) => String(d.day).slice(0, 2) === 달번호);
const 사람 = 날들.reduce((s: number, d: any) => s + (d.people ?? 0), 0);
const 실린 = 날들.reduce((s: number, d: any) => s + (d.listed ?? 0), 0);

/** 가장 많은 날·가장 적은 날. ⛔ 「좋은 날」이라고 부르지 않는다 — 그냥 많고 적음이다 */
const 순 = [...날들].sort((a: any, b: any) => b.people - a.people);
const 가장많은날 = 순[0] ?? null;
const 가장적은날 = 순[순.length - 1] ?? null;

/** 이 달 전체에서 이름이 실린 사람 몇 명을 보기로 든다. ⛔ 고르지 않는다 — 날 순서 그대로 */
const 보기이름 = 날들.flatMap((d: any) => (d.top ?? []).map((n: string) => ({ 이름: n, 날: d.day })))
  .slice(0, 12);

const 날글 = (day: string) => {
  const d = Number(String(day).slice(3, 5));
  return `${d} ${이달}`;
};

const TITLE = `Korean actors born in ${이달} — ${사람.toLocaleString('en-US')} of them, day by day`;
const DESC = `${사람.toLocaleString('en-US')} Korean actors, singers and other entertainers have a `
  + `birthday in ${이달}, spread over ${날들.length} days. ${실린.toLocaleString('en-US')} are named here. `
  + `Counted from Wikidata birth dates, not from a horoscope.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/born-in/${이달.toLowerCase()}`}>
  <h1>Korean actors born in {이달}</h1>

  {/* ⭐ 답을 맨 앞에. 손님이 물은 것은 「몇 명이냐」와 「누구냐」다 */}
  <p class="lead">
    <b>{사람.toLocaleString('en-US')}</b> Korean actors, singers and other entertainers have a
    birthday in {이달}, spread over <b>{날들.length}</b> days.
    {' '}<b>{실린.toLocaleString('en-US')}</b> of them are named on the day pages below.
    Across the whole year we hold {data.peopleTotal?.toLocaleString('en-US')} people.
  </p>

  <p class="note">
    <b>This is a count of birth dates, not a horoscope.</b> Sharing a birth month means exactly
    that and nothing else — we do not tell you what it says about anyone, because it does not say
    anything about anyone.
  </p>

  <section>
    <h2>Every day in {이달}</h2>
    <p class="note">
      Each day has its own page with the names. {가장많은날 && 가장적은날 && (
        <>The busiest day this month is <b>{날글(가장많은날.day)}</b> with {가장많은날.people},
        the quietest <b>{날글(가장적은날.day)}</b> with {가장적은날.people}.</>
      )} <b>That difference is not a finding</b> — with this many people a spread of a dozen either
      way is what chance looks like, and we have not tested it.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Day</th><th>People</th><th>Named</th><th>Some of them</th></tr></thead>
        <tbody>
          {날들.map((d: any) => (
            <tr>
              <td class="nm"><a href={d.url}>{날글(d.day)}</a></td>
              <td class="tot">{d.people}</td>
              <td>{d.listed}</td>
              <td class="fine">{(d.top ?? []).slice(0, 3).join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {보기이름.length > 0 && (
    <section>
      <h2>Some of the names</h2>
      <p class="note">
        Taken in date order, not chosen by us and not ranked. The full list for a day is on that
        day's page.
      </p>
      <ul class="walk">
        {보기이름.map((x) => (
          <li><a href={`/born-on/${x.날}`}>{x.이름}</a>
            <span class="fine">&mdash; {날글(x.날)}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Wikidata</b> — date of birth, best-ranked, day precision only; South Korean citizenship;
        an entertainment occupation. CC0.
      </li>
    </ul>
    <p class="note">
      <b>{(data.peopleTotal - data.peopleListed).toLocaleString('en-US')} of the
      {' '}{data.peopleTotal?.toLocaleString('en-US')} people we count are not named on any page.</b>
      A day page lists the ones with an English label we can show; the rest are counted and not named.
      We would rather count someone and not name them than leave them out of the count.
    </p>
    <p class="note">
      <b>Months are not the same length</b> — {날들.length} days here against 28 to 31 elsewhere — so
      comparing month totals compares day counts as much as anything else. And Wikidata is not a
      census: who has an entry is decided by editors, not by us.
    </p>
  </section>

  <section class="onward">
    <h3>Where to walk from here</h3>
    <ul>
      <li><a href={`/born-in/${앞달.toLowerCase()}`}>Korean actors born in {앞달}</a></li>
      <li><a href={`/born-in/${뒷달.toLowerCase()}`}>Korean actors born in {뒷달}</a></li>
      <li><a href="/born-on">All {data.pages} days of the year</a></li>
      <li><a href="/actors-in-their/30s">Korean actors by age band, not by date</a></li>
      <li><a href="/community">The twelve birth-year rooms</a></li>
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>
</WikiTip>
