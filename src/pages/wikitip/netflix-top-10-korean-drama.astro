---
/*
 * netflix-top-10-korean-drama.astro — **손님이 치는 말로 문을 낸다.** (5번, 2026-08-24)
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 사장님 지시(2026-08-22): 「**키워드 검색량을 재서 해.**」
 * 오늘 `measure-keyword-demand.mjs` 로 넷플릭스 축 낱말 20개를 자동완성에 물었다.
 * 여섯 개가 실제로 떠 있었고, **가장 강한 것이 이것이다** —
 * ```
 *   netflix top 10 korea        자동완성 1번째 · 그 말로 시작 9줄
 *      → netflix top 10 korean drama
 *      → netflix top 10 korean series
 *      → netflix top 10 korean drama 2026
 * ```
 * 그리고 내 쪽을 세 보니 —
 * ```
 *   지면 1,550장 중 제목에 「drama」가 든 것   5장
 *   자료에 든 한국 «TV» 작품                398편
 *   그 398편을 모아 놓은 지면                🔴 없다
 * ```
 * ⇒ **손님은 「korean drama」라고 치는데 나는 「titles·series」라고 쓰고 있었다.**
 *   자료는 있고 말이 없었다. 그래서 이 지면을 낸다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **낱말을 채워 넣지 않는다.** 「drama」는 한국 TV 시리즈를 가리키는 실제 영어 말이고,
 *   이 지면은 실제로 TV 만 담는다. 맞는 말이라서 쓴다 — 검색에 걸리려고 쓰는 것이 아니다.
 * ⛔ `/titles`(976편 전부)와 겹치지 않는다. 여기는 **TV 만** 이다. 영화 578편은 뺀다.
 *   뺀다는 것을 지면에서 밝힌다 — 안 밝히면 손님이 「왜 이 영화가 없나」로 읽는다.
 * ⛔ 순위표를 만들지 않는다. 「가장 넓게 간 것」은 나라 수이고 좋은 드라마 순서가 아니다.
 * ⛔ 「차트에 들었다」 ≠ 「그 나라에서 볼 수 있었다」. 이 문장을 뺄 수 없다.
 * ⛔ 수를 이 지면에서 계산하지 않는다 — `wikitip-title-pages.json` 에서 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import data from '../../data/wikitip-title-pages.json';

const 셈 = (n: number, 말: string) => `${말}${n === 1 ? '' : 's'}`;

/** ⛔ 갈래 이름을 짐작하지 않는다 — 자료가 쓰는 글자 그대로 고른다 */
const 드라마 = (data.titles ?? []).filter((t: any) => t.type === 'TV');
const 영화수 = (data.titles ?? []).filter((t: any) => t.type === 'Films').length;

const 나라합 = 드라마.reduce((s: number, t: any) => s + (t.markets ?? 0), 0);
const 자리합 = 드라마.reduce((s: number, t: any) => s + (t.places ?? 0), 0);
const 지면있음 = 드라마.filter((t: any) => t.hasPage).length;

const 나라줄 = [...드라마].map((t: any) => t.markets ?? 0).sort((a: number, b: number) => a - b);
const 나라중간 = 나라줄.length ? 나라줄[Math.floor(나라줄.length / 2)] : null;
const 한나라만 = 드라마.filter((t: any) => t.markets === 1).length;
const 전부 = 드라마.filter((t: any) => t.markets === data.marketCount).length;

const 넓은것 = [...드라마].sort((a: any, b: any) => b.markets - a.markets || b.places - a.places).slice(0, 12);
const 오랜것 = [...드라마].sort((a: any, b: any) => b.weeks - a.weeks).slice(0, 10);

/** 해마다 몇 편이 처음 차트에 들었나. ⛔ 개봉 연도가 아니다 — 자료에 개봉일이 없다 */
const 해별 = new Map<string, number>();
for (const t of 드라마) {
  const y = String(t.firstWeek ?? '').slice(0, 4);
  if (y) 해별.set(y, (해별.get(y) ?? 0) + 1);
}
const 해줄 = [...해별.entries()].sort();

const TITLE = `Netflix top 10 Korean drama — all ${드라마.length}, and how far each travelled`;
const DESC = `${드라마.length} Korean TV series have reached a Netflix weekly top 10 somewhere since `
  + `${data.weekFrom}, taking ${자리합.toLocaleString('en-US')} chart places across ${data.marketCount} markets. `
  + `The median one charted in ${나라중간} ${셈(나라중간 ?? 0, 'country')}. Films are counted separately.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/netflix-top-10-korean-drama">
  <h1>Netflix top 10 Korean drama</h1>

  {/*
    ⭐ 답을 맨 앞에 둔다. 오늘 작품 지면에서 배운 것이다 — 앞토막이 판박이면
      손님이 답을 못 보고 나간다(재 보니 앞토막 판박이 61%였다).
  */}
  <p class="lead">
    <b>{드라마.length}</b> Korean TV series have reached a Netflix weekly top 10 somewhere between
    {' '}{data.weekFrom} and {data.weekTo}. Between them they took
    {' '}<b>{자리합.toLocaleString('en-US')}</b> chart places across {data.marketCount} markets.
    The median series charted in <b>{나라중간}</b> {셈(나라중간 ?? 0, 'country')};
    {' '}<b>{한나라만}</b> charted in exactly one, and <b>{전부}</b> charted in all {data.marketCount}.
  </p>

  <p class="note">
    <b>This page counts series only.</b> {영화수} Korean films have also charted and they are not
    here — a film and a series are not comparable on weeks, and mixing them makes both numbers
    misleading. {' '}<a href="/titles">All {(data.titles ?? []).length} Korean titles, films included →</a>
  </p>

  <section>
    <h2>The widest travellers — all {data.marketCount} markets counted</h2>
    <p class="note">
      Ordered by how many countries the series charted in. <b>This is not a quality ranking.</b>
      A series can reach many countries for one week, or one country for two years; both are here.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Series</th><th>Countries</th><th>Weeks</th><th>Chart places</th><th>Best position</th></tr>
        </thead>
        <tbody>
          {넓은것.map((t: any) => (
            <tr>
              <td class="nm">{t.hasPage ? <a href={`/title/${t.slug}`}>{t.title}</a> : t.title}</td>
              <td class="tot">{t.markets}</td>
              <td>{t.weeks}</td>
              <td>{t.places.toLocaleString('en-US')}</td>
              <td>{t.peak}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>The longest runs — weeks on any chart</h2>
    <p class="note">
      A different question from reach, and it gives a different list. Staying on one country's chart
      for two years is not the same achievement as appearing in ninety countries for one week, and we
      do not add the two together.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Series</th><th>Weeks</th><th>Countries</th><th>Chart places</th></tr>
        </thead>
        <tbody>
          {오랜것.map((t: any) => (
            <tr>
              <td class="nm">{t.hasPage ? <a href={`/title/${t.slug}`}>{t.title}</a> : t.title}</td>
              <td class="tot">{t.weeks}</td>
              <td>{t.markets}</td>
              <td>{t.places.toLocaleString('en-US')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>How many first charted each year</h2>
    <p class="note">
      The year a series <b>first appeared on any chart</b>, not its release year — Netflix publishes
      no release date in these files, so we do not have one to give.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>First charted</th><th>Series</th></tr></thead>
        <tbody>
          {/* 🔴 2026-08-24 — 해를 «문»으로 바꿨다. 연도 지면 6장은 색인은 됐는데 28일 노출이
              0이었고, 들어오는 문은 작품 지면 93장에서 이미 있었다 — 없던 것은 문이 아니라
              손님 말이었다(제목을 「Korean drama <해>」로 고쳤다). 이 표에서도 걸어가게 한다 */}
          {해줄.map(([y, n]) => (
            <tr><td class="nm"><a href={`/year/${y}`}>{y}</a></td><td class="tot">{n}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note fine">
      {해줄.length > 0 && `${해줄[해줄.length - 1][0]} is a part-year — the data ends ${data.weekTo}.`}
    </p>
  </section>

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Netflix Top 10 (Tudum)</b> — the weekly country lists Netflix publishes for
        {' '}{data.marketCount} markets, {data.weekCount} weeks from {data.weekFrom} to {data.weekTo}.
        {' '}<a href="/netflix-top10-data">What is inside those files, and what is missing from them →</a>
      </li>
      <li>
        <b>Wikidata</b> decides what counts as Korean (country of origin) and what counts as a series
        rather than a film. We do not classify by hand, so a title filed oddly upstream is filed oddly here.
      </li>
    </ul>
    <p class="note">
      <b>Charting is not the same as being available.</b> A chart place proves the series was on
      Netflix in that country that week. The reverse does not follow: a country missing from a row
      may still have carried the series without it reaching a top ten. We hold chart lists, not
      catalogues, and we do not guess the difference.
    </p>
    <p class="note">
      <b>There are no viewing figures here.</b> The per-country files carry ranks, not hours or
      viewers. Nothing on this page measures how many people watched.
    </p>
    <p class="note fine">
      {지면있음} of the {드라마.length} series have a page of their own. The rest appear in fewer than
      six weekly rows, and a page built on two rows would say more than the data can support.
    </p>
  </section>

  <section class="onward">
    <h3>Where to walk from here</h3>
    <ul>
      <li><a href="/titles">Every Korean title that charted, films included</a></li>
      <li><a href="/weeks">One particular week, {data.weekCount} of them</a></li>
      <li><a href="/by-country">All {data.marketCount} countries side by side</a></li>
      <li><a href="/most-popular">Most popular Korean drama? Three rulers that disagree</a></li>
      <li><a href="/where-to-watch">Where to watch: what Netflix actually tells us</a></li>
    </ul>
  </section>
</WikiTip>
