---
/**
 * K Culture Wire — **Tudum 파일 자료 사전.** (`/netflix-tudum-data-dictionary`)
 *
 * 🔴 서치콘솔 28일치 실측 —
 * ```
 *   Tudum 파일을 찾는 물음 21개 · 노출 262 · 클릭 0
 *   → 우리 전체 노출 977 의 27%. 가장 큰 덩어리인데 한 사람도 안 들어온다
 * ```
 * 그들이 치는 말은 파일 «주소» 그대로다. 그런데 우리 지면 제목은
 * 「그 파일의 71.1%는 조회수가 없다」 — **파일을 찾아온 사람에게 흠부터 내민다.**
 *
 * ⭐ 그래서 그들이 온 까닭에 답하는 지면을 따로 둔다 — **무엇이 들어 있나.**
 *   칸 이름 · 줄 수 · 기간 · 나라 수 · 어느 칸이 얼마나 비었나. 전부 우리가 재서 낸 수다.
 *
 * ── ⛔ 라이선스 ──────────────────────────────────────────
 * ⛔ **파일을 다시 배포하지 않는다.** 우리가 내는 것은 «재서 얻은 수»다.
 * ⛔ 표본 줄을 「예시」로 싣지 않는다 — 그것이 재배포로 읽힐 수 있다.
 * ⛔ 받으러 가는 곳은 넷플릭스 주소로 보낸다.
 *
 * 🔴 Astro 앞말은 TypeScript 다. 🔴 JSX 는 끝 공백을 버린다 — {' '} 를 쓴다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/wikitip-tudum-dictionary.json';

type 파일 = {
  key: string; url: string; archivedAs: string; downloadedOn: string | null;
  columns: string[]; rows: number; countries: number | null; weeks: number | null;
  firstWeek: string | null; lastWeek: string | null; distinctTitles: number | null;
  emptyByColumn: { column: string; empty: number; pc: number | null }[];
};

const 파일들 = (d.files as any[]) as 파일[];
const 나라파일 = 파일들.find((f) => f.key.includes('countries'));
const 세계파일 = 파일들.find((f) => f.key.includes('global'));

/* 🔴 제목·본문이 말하는 수가 자료와 어긋나면 빌드를 세운다 */
if (!나라파일 || !세계파일) throw new Error('두 파일을 다 못 쟀다 — 이 지면은 둘을 나란히 놓는다.');
if (나라파일.rows < 100000) throw new Error(`나라별 파일 줄 수가 ${나라파일.rows} 다 — 너무 적다. 다시 받았는지 본다.`);

const 쉼표 = (n: number | null) => (n === null ? '—' : Number(n).toLocaleString('en-US'));
const 빈칸있는것 = (f: 파일) => f.emptyByColumn.filter((c) => (c.pc ?? 0) > 0);

const TITLE = 'all-weeks-countries.tsv and all-weeks-global.tsv: what is actually inside';
const DESC =
  `Netflix publishes two Top 10 data files. We counted what is in them: ${쉼표(나라파일.rows)} rows `
  + `across ${나라파일.countries} countries and ${나라파일.weeks} weeks in the country file, `
  + `${쉼표(세계파일.rows)} in the global one, both running ${나라파일.firstWeek} to ${나라파일.lastWeek}. `
  + 'Every column listed, with how often each one is empty.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: 파일들.map((f) => f.url),
  temporalCoverage: `${나라파일.firstWeek}/${나라파일.lastWeek}`,
  variableMeasured: 나라파일.columns,
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/netflix-tudum-data-dictionary">
  <h1>{TITLE}</h1>

  <p class="lead">
    If you came here looking for Netflix's Top 10 data files, this page tells you what is in them
    before you download 30MB to find out. We counted it.
  </p>

  <p class="q">
    <b>We do not host the files.</b> They are Netflix's, and you get them from
    {' '}<a href="https://www.netflix.com/tudum/top10" rel="nofollow noopener">netflix.com/tudum/top10</a>.
    Everything on this page is a count we made from them.
  </p>

  {파일들.map((f) => (
    <>
      <h2>{f.key}</h2>

      <div class="scroll-x">
        <table>
          <caption>What the file holds, as of the copy we downloaded on {f.downloadedOn}</caption>
          <tbody>
            <tr><th scope="row">Rows</th><td>{쉼표(f.rows)}</td></tr>
            <tr><th scope="row">Columns</th><td>{f.columns.length}</td></tr>
            <tr><th scope="row">Weeks covered</th><td>{f.weeks} ({f.firstWeek} to {f.lastWeek})</td></tr>
            {f.countries && <tr><th scope="row">Countries</th><td>{f.countries}</td></tr>}
            <tr><th scope="row">Distinct titles named</th><td>{쉼표(f.distinctTitles)}</td></tr>
          </tbody>
        </table>
      </div>

      <div class="scroll-x">
        <table>
          <caption>Every column, and how often it is empty</caption>
          <thead><tr><th>Column</th><th>Empty rows</th><th>Share empty</th></tr></thead>
          <tbody>
            {f.emptyByColumn.map((c) => (
              <tr class={(c.pc ?? 0) > 0 ? 'gap' : undefined}>
                <th scope="row"><code>{c.column}</code></th>
                <td>{쉼표(c.empty)}</td>
                <td>{c.pc}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="note">
        {빈칸있는것(f).length === 0
          ? 'No column in this file is ever empty.'
          : `${빈칸있는것(f).length} of ${f.columns.length} columns have empty rows: `
            + 빈칸있는것(f).map((c) => `${c.column} (${c.pc}%)`).join(', ') + '.'}
      </p>
    </>
  ))}

  <h2>The two things people get wrong about these files</h2>

  <p>
    <b>An empty cell is not a zero.</b> In the global file, <code>weekly_views</code> is empty on
    {' '}{세계파일.emptyByColumn.find((c) => c.column === 'weekly_views')?.pc}% of rows. Those titles
    were in the Top 10; the file simply carries no view figure for them. Filling those with 0 and
    summing is the single commonest way to get a wrong total out of this data.
  </p>

  <p>
    <b>A title missing from a country is not a title nobody watched.</b> The file lists top tens. A
    show that placed eleventh produces no row at all. Any count of &ldquo;countries where X was
    watched&rdquo; built from this file is a floor, never a total &mdash; which is why we describe
    ours that way <a href="/netflix-which-country">on the pages that use it</a>.
  </p>

  <h2>What we use it for</h2>
  <p class="walk">
    <a href="/netflix-which-country">Which countries carried a Korean title</a> &middot;{' '}
    <a href="/by-country">Korean titles country by country</a> &middot;{' '}
    <a href="/netflix-top10-data">What the files do not tell you</a>
  </p>

  <KcwMethodLimits
    method={{
      'What this is': d.whatThisIs,
      'How we counted': 'We read our archived copy of each file line by line and counted rows, distinct '
        + 'values and empty cells per column. An empty cell is a blank, N/A or NA — a literal 0 is not empty.',
      Licence: d.licence,
    }}
    limitation={{
      'What this is not': 'Not a copy of the files and not a judgement on whether Netflix\'s numbers are '
        + 'right. We count what the file says. Our copy is dated, and Netflix updates the files weekly.',
    }} />

  <h2>What we could not measure</h2>
  <ul>
    {d.notMeasured.map((s: string) => <li>{s}</li>)}
  </ul>
  {d.unmeasured.length > 0 && (
    <ul>{d.unmeasured.map((s: string) => <li>{s}</li>)}</ul>
  )}

  <p class="asof">Measured {d.measuredAt}, from copies downloaded {파일들.map((f) => f.downloadedOn).join(' and ')}.</p>

  <KcwRelatedArticles page="/netflix-tudum-data-dictionary" />
</WikiTip>

<style>
  .lead { font-size: 1.15rem; font-weight: 600; }
  .q { background: #f6f7f9; border-left: 3px solid #999; padding: .7rem .9rem; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .95rem; }
  caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  th, td { border-bottom: 1px solid #e3e5e8; padding: .4rem .6rem; text-align: left; }
  th { background: #fafbfc; }
  code { font-size: .92em; }
  tr.gap td, tr.gap th { background: #fdf6ec; }
  .note { font-size: .95rem; color: #555; }
  .walk { font-size: .95rem; margin: .6rem 0 1.2rem; }
  .asof { font-size: .85rem; color: #666; margin-top: 1.2rem; }
  .scroll-x { overflow-x: auto; }
  @media (prefers-color-scheme: dark) {
    .q { background: #1c1f24; border-left-color: #666; }
    th { background: #1a1d21; }
    th, td { border-bottom-color: #2a2e34; }
    .note { color: #aaa; }
    .asof { color: #999; }
    tr.gap td, tr.gap th { background: #2a2317; }
  }
</style>
