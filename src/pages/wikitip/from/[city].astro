---
/**
 * `/from/<city>` — **한 도시에서 난 한국 스타.** 37장.
 *
 * ## 🔴 왜 냈나 — GSC 로 «수요를 재서» 냈다 (2026-08-26)
 *
 * 28일치 검색어를 갈라 보니 한 갈래가 또렷했다. 전부 클릭 «0» 이다 —
 *
 * ```
 *  4노출 순위 7.3  who is from busan in bts
 *  3노출 순위 9.0  bts members from busan
 *  2노출 순위 7.5  is bts from busan
 *  2노출 순위 7.0  daegu bts member
 *  2노출 순위 6.0  where are bts members from in korea
 *  2노출 순위 8.0  which bts member is from busan
 *  2노출 순위 4.5  which bts member is from daegu
 *  2노출 순위 3.0  which bts members are from daegu
 *  2노출 순위 7.0  who in bts is from busan
 *  2노출 순위11.0  bts member from busan          … 합 23노출 · 클릭 0
 * ```
 *
 * ⭐ **순위는 3~11위다.** 첫 화면에 있는데 아무도 안 눌렀다. 우리 쪽에서 그 검색에 뜨는
 *   것은 기사 한 편(`/article/bts-is-not-a-seoul-band`, 122노출 · 순위 9.0 · 클릭 0)뿐이고,
 *   제목이 「BTS is not a Seoul band」라 **묻는 말과 답하는 말이 어긋난다.**
 *
 * ⭐ 사람이 묻는 것은 「**부산 출신이 누구냐**」이고, 그건 도시 하나에 대한 물음이다.
 *   그래서 축을 «도시»로 세웠다. 손님이 검색하는 말이 곧 지면 하나가 된다.
 *
 * ## ⚠ 이 지면이 말하지 «않는» 것
 *
 * 재 본 3,204명 중 도시까지 놓을 수 있었던 사람은 **123명뿐**이다. 나머지는 위키데이터에
 * 출생지가 없거나 나라만 있다. **0 으로 채우지 않고 못 놓았다고 적는다** — 지면마다.
 *
 * ⛔ 「부산 출신 스타는 9명이다」라고 쓰지 않는다. **「우리가 놓을 수 있었던 사람 중 9명」**이다.
 *   앞의 문장은 사실이 아니고, 뒤의 문장은 사실이다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import 고향 from '../../../data/wikitip-hometowns.json';
import 사람들자료 from '../../../data/wikitip-people.json';
import { 이름표만들기 } from '../../../lib/person-link';

/* 🔴 getStaticPaths 는 «다른 청크»에서 돈다 — 여기서 만든 것은 props 로만 건넨다.
   바깥 변수를 아래에서 다시 읽으면 undefined 가 되어 조용히 빈 지면이 된다. */
export async function getStaticPaths() {
  const 도시들: any[] = (고향 as any).cities ?? [];
  /* ⚠ 이 파일은 배열이 아니라 «객체»다 — 사람은 `.people` 안에 있다.
     2026-08-26 에 그냥 넘겼다가 「사람들 is not iterable」로 빌드가 섰다. */
  const { 표: 이름표 } = 이름표만들기((사람들자료 as any).people ?? []);

  const 슬러그 = (s: string) => String(s).toLowerCase()
    .replace(/[’']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  /* 큰 도시부터. 「몇 번째로 많은 도시인가」를 지면마다 적기 위해 미리 순위를 매긴다. */
  const 정렬 = [...도시들].sort((a, b) => b.people.length - a.people.length);

  return 정렬.map((c, i) => {
    const 이웃 = [정렬[i - 1],정렬[i + 1]].filter(Boolean)
      .map((n: any) => ({ 이름: n.place, 길: `/from/${슬러그(n.place)}`, 수: n.people.length }));
    return {
      params: { city: 슬러그(c.place) },
      props: {
        도시: c.place,
        사람: c.people.map((p: any) => ({
          이름: p.name,
          읽힘: p.perMillionTotal,
          길: 이름표.get(String(p.name).toLowerCase().trim()) ?? null,
        })),
        차례: i + 1,
        도시수: 정렬.length,
        놓은사람: (고향 as any).inBox,
        전체사람: (고향 as any).peopleTotal,
        나라만: (고향 as any).countryOnly,
        기록없음: (고향 as any).notRecorded,
        이웃,
        큰곳: 정렬.slice(0, 5).map((n: any) => ({ 이름: n.place, 길: `/from/${슬러그(n.place)}`, 수: n.people.length })),
      },
    };
  });
}

const { 도시, 사람, 차례, 도시수, 놓은사람, 전체사람, 나라만, 기록없음, 이웃, 큰곳 } = Astro.props as any;

const 수 = (n: number) => n.toLocaleString('en-US');
const 첫셋 = 사람.slice(0, 3).map((p: any) => p.이름).join(', ');
/* 🔴 [2026-08-26 21:1x · 5번] 제목을 손님 말로 고쳤다. 낸 지 몇 시간 만이다.
   구글 자동완성을 재 보니 «있는» 말이 이랬다 —
   ```
   korean actors from busan     있다(1번째)
   korean idols from daegu      있다(1번째)
   which bts member is from busan  있다(1번째)
   korean actors born abroad    있다(1번째)
   ```
   ⛔ 그런데 내 제목은 「Korean **stars** born in Busan」이었다.
     손님은 **actors · idols · from** 이라 치는데 나는 **stars · born in** 이라 적었다.
   ⭐ 「손님이 검색하는 말로 만든다」 — 자료의 말이 아니라 «치는 말»이 제목이 된다.
   ⚠ 낚는 것이 아니다. 이 지면은 실제로 그 물음에 답한다.
     ⛔ 다만 우리가 가진 것은 **출생지**이지 「자란 곳」이 아니다. 그래서 제목 뒤에
       「by place of birth」를 붙이고, 본문에서 다시 못박는다. 제목만 손님 말로 하고
       본문에서 얼버무리면 그것이 낚시다. */
const 제목 = `Korean actors and idols from ${도시} — ${사람.length === 1 ? 'one name' : `${사람.length} names`}, by place of birth`;
const 설명 = `${사람.length === 1 ? 'One of' : `${사람.length} of`} the ${놓은사람} most-read Korean actors and idols we could place by city `
  + `were born in ${도시}: ${첫셋}${사람.length > 3 ? ', and more' : ''}. `
  + `Birthplaces come from Wikidata. Of ${수(전체사람)} people we looked at, only ${놓은사람} had a city recorded — `
  + `we say so rather than filling the gap.`;
---

<WikiTip title={제목} description={설명}>
  <h1>Korean actors and idols from {도시}</h1>

  <p>
    {사람.length === 1 ? 'One name' : `${사람.length} names`} in our panel {사람.length === 1 ? 'was' : 'were'} born
    in <b>{도시}</b>. That makes it the <b>{차례}{차례 === 1 ? 'st' : 차례 === 2 ? 'nd' : 차례 === 3 ? 'rd' : 'th'}</b>{' '}
    most common birthplace of the {도시수} cities we could place anyone in.
  </p>

  <p class="fine">
    ⚠ Read that as <b>“{사람.length} of the {놓은사람} we could place”</b>, not “{사람.length} Korean stars
    are from {도시}”. Those are different sentences and only the first one is true.
  </p>

  <div class="scroll">
    <table>
      <thead>
        <tr><th>Name</th><th class="n">Readers per million, 30 days</th></tr>
      </thead>
      <tbody>
        {사람.map((p: any) => (
          <tr>
            <td>{p.길 ? <a href={`/person/${p.길}`}>{p.이름}</a> : p.이름}</td>
            <td class="n">{p.읽힘 ? p.읽힘.toFixed(2) : <span class="fine">not measured</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section>
    <h2>What this page cannot tell you</h2>
    <p>
      We looked at <b>{수(전체사람)}</b> people. Only <b>{놓은사람}</b> had a birthplace we could put on a city.
      <b>{나라만}</b> had a country recorded and no city, and <b>{기록없음}</b> had nothing recorded at all.
    </p>
    <p class="fine">
      We test whether a birthplace is in Korea using its coordinates, not its country field, because the
      country field records involvement as well as location. Where Wikidata marks a place as a country
      rather than a city, we count it separately instead of quietly calling it Seoul.
      <b>A guess in a table looks exactly like a measurement</b>, so we leave the cell out instead.
    </p>
  </section>

  <section class="onward">
    <h3>Where to go next</h3>
    <ul class="walk">
      {이웃.map((n: any) => (
        <li><a href={n.길}>{n.이름}</a> <span class="fine">&mdash; {n.수} {n.수 === 1 ? 'name' : 'names'}</span></li>
      ))}
      {큰곳.filter((n: any) => n.이름 !== 도시).slice(0, 3).map((n: any) => (
        <li><a href={n.길}>{n.이름}</a> <span class="fine">&mdash; {n.수} {n.수 === 1 ? 'name' : 'names'}</span></li>
      ))}
      <li><a href="/hometowns">All {도시수} cities on one map</a></li>
      <li><a href="/article/bts-is-not-a-seoul-band">Where the BTS members are from</a>
        <span class="fine">&mdash; seven members, five cities, none of them Seoul</span></li>
      <li><a href="/person">Everyone we have a page for</a></li>
    </ul>
  </section>

  <p class="fine tail">
    Birthplaces: Wikidata (P19), coordinates checked (P625). Reader counts: Wikimedia Pageviews,
    human traffic only, per million. <b>This is a statistic, not a person.</b>
  </p>
</WikiTip>

<style>
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .93rem; }
  th, td { padding: .35rem .55rem; border-bottom: 1px solid #3332; text-align: left; }
  th.n, td.n { text-align: right; font-variant-numeric: tabular-nums; }
  .tail { margin-top: 2rem; }
</style>
