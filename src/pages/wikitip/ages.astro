---
/*
 * `/ages` — **Korean actors and K-pop idols by age.**
 *
 * ── Why this page ──────────────────────────────────────────────
 * Measured 2026-10-05 (en/us autocomplete, 24 seeds): `korean actors age` and
 * `korean actress age` each fill all ten rows. We hold 531 birth dates on record
 * and had no page whose title carries that phrase.
 *
 * ⛔ We do not invent an age. Only people whose birth date is on record appear.
 *   103 of the 634 people we track have no birth date — that number is printed,
 *   not hidden, and they are left out of the table rather than filled with a guess.
 * ⛔ We do not rank anyone. The table is ordered by birth year, oldest first —
 *   that is a sort, not a judgement.
 * ⚠ Ages move. Every age here is "as of {기준해}" and the page says so.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/wikitip-people.json';

const 모두 = (data as any).people ?? [];
/* ⛔ 생년이 없는 사람은 «빼고» 그 수를 적는다 — 0 으로 채우지 않는다 */
const 잰것 = 모두.filter((p: any) => p?.born && typeof p.age === 'number' && p.name);
const 못잰수 = 모두.length - 잰것.length;

const 기준 = String((data as any).asOf ?? '').slice(0, 4) || '2026';

/* 태어난 해로 세운다. ⛔ 등수를 매기는 것이 아니라 차례로 늘어놓는 것이다 */
const 줄 = [...잰것].sort((a: any, b: any) => String(a.born).localeCompare(String(b.born)));

const 나이들 = 잰것.map((p: any) => p.age);
const 가운데값 = (() => {
  const s = [...나이들].sort((a, b) => a - b);
  return s.length ? s[Math.floor(s.length / 2)] : null;
})();
const 가장어린 = 줄.length ? 줄[줄.length - 1] : null;
const 가장나이든 = 줄.length ? 줄[0] : null;

/* 십년 단위로 묶는다 — 손님이 자기 또래를 찾기 쉽다 */
const 열해묶음 = new Map<number, any[]>();
for (const p of 줄) {
  const y = Number(String(p.born).slice(0, 4));
  if (!Number.isFinite(y)) continue;
  const 묶음 = Math.floor(y / 10) * 10;
  if (!열해묶음.has(묶음)) 열해묶음.set(묶음, []);
  열해묶음.get(묶음)!.push(p);
}
const 묶음차례 = [...열해묶음.keys()].sort((a, b) => a - b);

const TITLE = `Korean actors ages — ${잰것.length} stars by birth year (${기준})`;
const DESC = `Korean actors and K-pop idols by age: ${잰것.length} birth dates on record, `
  + `oldest to youngest, ages as of ${기준}. The youngest is ${가장어린?.age ?? '—'} and the `
  + `oldest ${가장나이든?.age ?? '—'}; the middle of the list is ${가운데값 ?? '—'}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Korean actors and idols by age',
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}>
  <h1>Korean actors ages — who is how old</h1>

  <p class="lede">
    {잰것.length} Korean actors and K-pop idols with a birth date on record,
    listed oldest to youngest. Ages are as of {기준}.
  </p>

  <section class="box">
    <h2>The shape of the list</h2>
    <div class="scroll">
      <table>
        <tbody>
          <tr>
            <th>Birth dates on record</th>
            <td>{잰것.length}</td>
            <td class="dim">of {모두.length} people we track</td>
          </tr>
          <tr>
            <th>No birth date found</th>
            <td>{못잰수}</td>
            <td class="dim">left out of the table — we do not guess an age</td>
          </tr>
          <tr>
            <th>Youngest on record</th>
            <td>{가장어린?.age ?? '—'}</td>
            <td class="dim">{가장어린?.name ?? '—'}, born {가장어린?.born ?? '—'}</td>
          </tr>
          <tr>
            <th>Oldest on record</th>
            <td>{가장나이든?.age ?? '—'}</td>
            <td class="dim">{가장나이든?.name ?? '—'}, born {가장나이든?.born ?? '—'}</td>
          </tr>
          <tr>
            <th>Middle of the list</th>
            <td>{가운데값 ?? '—'}</td>
            <td class="dim">the median, not the average</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="warn">
      We show the median rather than the average. A handful of veteran actors in their
      eighties would pull an average far enough that the ordinary age on this list
      would stop being visible.
    </p>
  </section>

  <section>
    <h2>By decade of birth</h2>
    <p class="note">
      How many of the {잰것.length} were born in each decade. This is a count of
      <strong>who we have on record</strong>, not of who exists.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Born</th><th>People</th><th>Age in {기준}</th></tr>
        </thead>
        <tbody>
          {묶음차례.map((d) => {
            const 들 = 열해묶음.get(d)!;
            const as = 들.map((p: any) => p.age).sort((a: number, b: number) => a - b);
            return (
              <tr>
                <th>{d}s</th>
                <td>{들.length}</td>
                <td class="dim">{as[as.length - 1]} – {as[0]}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Every name, oldest to youngest</h2>
    <p class="note">
      Ordered by birth date. <strong>This is a sort, not a ranking</strong> — we do not
      say anyone's age is better or worse placed than anyone else's.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Name</th><th>Born</th><th>Age in {기준}</th><th>Star sign</th></tr>
        </thead>
        <tbody>
          {줄.map((p: any) => (
            <tr>
              <td class="nm">
                {p.slug
                  ? <a href={`/person/${p.slug}`}>{p.name}</a>
                  : p.name}
              </td>
              <td>{p.born}</td>
              <td>{p.age}</td>
              <td class="dim">{p.sign ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>What this page does and does not say</h2>
    <p>
      <strong>An age here is a date of birth plus arithmetic.</strong> Nothing more is
      claimed. We do not say what an age means for a career, a role or a comeback.
    </p>
    <p>
      <strong>{못잰수} of the {모두.length} people we track have no birth date we could
      source.</strong> They are not in the table. Writing a guessed age would make the
      other {잰것.length} harder to trust.
    </p>
    <p>
      Korean age counting differs from international age. Since June 2023 Korea uses
      international age in law and administration, and that is what this page uses —
      the difference from the old counting is one or two years.
    </p>
  </section>

  <section>
    <h2>Related</h2>
    <ul class="links">
      <li><a href="/born-on">Who was born on your birthday</a> — 366 pages, one per date</li>
      <li><a href="/actors">The Korean actors English readers look up most</a></li>
      <li><a href="/group/blackpink">Group member ages and birthdays</a></li>
      <li><a href="/star-signs">Star signs across the people we track</a></li>
    </ul>
  </section>

  <KcwRelatedArticles page="/ages" />
</WikiTip>

<style>
  h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 .6rem; }
  .lede { font-size: 1.05rem; color: #334; margin: 0 0 1.6rem; }
  section { margin: 2.2rem 0; }
  h2 { font-size: 1.2rem; margin: 0 0 .6rem; }
  .box { background: #fbfbfd; border: 1px solid #e6e8ee; border-radius: 12px; padding: 1rem 1.1rem; }
  .note { font-size: .88rem; color: #667; margin: 0 0 .7rem; }
  .warn { font-size: .85rem; color: #665; background: #fbfaf4; border-left: 3px solid #ddd6b8;
          padding: .55rem .8rem; margin: .8rem 0 0; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: .45rem .6rem; border-bottom: 1px solid #e8eaef; text-align: right; }
  thead th { text-align: right; font-size: .82rem; color: #556; border-bottom: 2px solid #d8dbe2; }
  thead th:first-child, tbody td.nm, tbody th { text-align: left; }
  tbody th { font-weight: 500; color: #445; }
  td.nm a { color: #2a4d8f; text-decoration: none; }
  td.nm a:hover { text-decoration: underline; }
  .dim { color: #889; font-size: .85rem; }
  .links { margin: .6rem 0 0 1.1rem; font-size: .95rem; }
  .links li { margin: .35rem 0; }
  .links a { color: #2a4d8f; text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  @media (max-width: 640px) { h1 { font-size: 1.45rem; } }
</style>
