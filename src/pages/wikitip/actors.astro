---
/**
 * K Culture Wire — 한국 배우 관심도(영문 위키백과 조회수) 카탈로그. (/actors)
 *
 * 데이터: src/data/wikitip-actors.json (scripts/build-wikitip-actors.mjs).
 * 첫 화면은 관심 상위 10 + 급상승 10. 이 지면은 30일 **지속 관심** 상위 50.
 * ⚠ 급상승(스캔들·부고로 튄다)은 뺐다. 「관심은 인기가 아니다」를 박는다. 사진 없다.
 * 색인: **열려 있다.** noindex 없음 · canonical 있음 (2026-08-06 17:0x 라이브 실측 200).
 *   ⚠ 여기 「noindex: 도메인 파킹 중」이라 적혀 있던 것은 파킹 시절 주석이라 지웠다.
 *     실제로는 noindex 가 걸린 적이 없다. 소스만 보면 반대로 읽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import data from '../../data/wikitip-actors.json';

const monthName = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (yyyymmdd) => {
  const s = String(yyyymmdd);
  return `${Number(s.slice(6, 8))} ${monthName[Number(s.slice(4, 6)) - 1]}`;
};
const [from, to] = data.period.split('~');
const span = `${fmt(from)} – ${fmt(to)} ${String(to).slice(0, 4)}`;

const TITLE = 'Which Korean actors English readers looked up most';
const DESC =
  `Over 30 days, English Wikipedia readers looked up ${data.measured.toLocaleString()} Korean actors `
  + `${data.totalViews.toLocaleString()} times. This is who they read about most — measured, sourced, `
  + `and careful about what a view does and does not mean.`;

const rows = data.rows;
const maxTotal = rows[0].total;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Korean actors by English Wikipedia page views',
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  temporalCoverage: `${from}/${to}`,
  isBasedOn: ['https://wikimedia.org/api/rest_v1/', 'https://query.wikidata.org/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/actors">
  <h1>Which Korean actors English readers looked up most</h1>
  <p class="lead">
    Between {span}, English Wikipedia readers opened the pages of <b>{data.measured.toLocaleString()}</b>{' '}
    Korean actors <b>{data.totalViews.toLocaleString()}</b> times. Here are the {rows.length} they
    read about most — not who is most popular, but who was most looked up.
  </p>

  <section class="stats">
    <div><b>{data.measured.toLocaleString()}</b><span>actors measured</span></div>
    <div><b>{data.days}</b><span>days</span></div>
    <div><b>{(data.totalViews / 1e6).toFixed(1)}m</b><span>page views</span></div>
    <div><b>{(data.roster - data.measured).toLocaleString()}</b><span>had no English page</span></div>
  </section>

  <section>
    <h2>Most looked up, {span}</h2>
    <p class="sub">
      Total English Wikipedia page views over the {data.days}-day window, human traffic only.
      Showing the top {rows.length} of {data.measured.toLocaleString()} measured.
    </p>
    <ul class="rows">
      {rows.map((r) => (
        <li>
          <span class="bar" style={`--w:${(r.total / maxTotal) * 100}%`}></span>
          <span class="nm">{r.name}</span>
          <span class="meta">
            <b>{r.total.toLocaleString()}</b> views · {r.daily.toLocaleString()}/day · {r.titles} {r.titles === 1 ? 'title' : 'titles'} in our roster
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="src">
    <h2>Where these numbers come from</h2>
    <ul>
      <li>
        <b>Wikimedia Pageviews API</b> — daily English Wikipedia article views for each actor,
        summed over {span}. Automated and spider traffic is excluded by the API itself; these are
        human reads.
      </li>
      <li>
        <b>Wikidata</b> — the roster is built from cast lists (P161) filtered to Korean citizenship
        (P27), so who counts as a Korean actor is decided by the data, not by us.
      </li>
    </ul>
    <p class="note">
      <b>Attention is not popularity.</b> A page is opened for good news and bad — a premiere, a
      casting, an award, a scandal, a death. We publish the count and the window it covers. We do
      not publish a reason, because the count does not contain one, and we do not rank anyone by
      how fast their views spiked.
    </p>
    <p class="note">
      <b>A missing actor is not an unread one.</b> {(data.roster - data.measured).toLocaleString()} of the
      {data.roster.toLocaleString()} performers in our roster have no English Wikipedia article and
      cannot be measured this way at all. We use no photographs; the only images on this site are
      charts we built from numbers we counted.
    </p>
    <p class="note">Counts from the Wikimedia Pageviews API. Updated {data.generated} KST.</p>
  </section>

  <p class="back"><a href="/">&larr; Back to the front page</a></p>
</WikiTip>

<style>
  h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.25; margin: 1.2rem 0 .8rem; letter-spacing: -.02em; }
  .lead { font-size: 1.05rem; color: var(--muted); margin: 0 0 2rem; }
  section { margin: 0 0 3rem; }
  h2 { font-size: 1.12rem; margin: 0 0 .3rem; letter-spacing: -.01em; }
  .sub { font-size: .87rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.6; }
  .note { font-size: .82rem; color: var(--muted); margin: .9rem 0 0; line-height: 1.6; }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; margin: 0 0 2.5rem; }
  .stats div { background: var(--card); border-radius: 8px; padding: 1rem; }
  .stats b { display: block; font-size: 1.5rem; letter-spacing: -.02em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .stats span { font-size: .82rem; color: var(--muted); }
  @media (min-width: 34rem) { .stats { grid-template-columns: repeat(4, 1fr); } }

  .rows { list-style: none; padding: 0; margin: 0; }
  .rows li { position: relative; overflow: hidden; padding: .6rem .8rem; border-bottom: 1px solid var(--line); }
  .bar { position: absolute; left: 0; top: 0; bottom: 0; width: var(--w); background: var(--card); border-radius: 0 4px 4px 0; }
  .nm, .meta { position: relative; }
  .nm { display: block; font-weight: 600; line-height: 1.35; }
  .meta { display: block; font-size: .82rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .meta b { color: var(--accent); }

  .src ul { padding-left: 1.1rem; margin: 0; font-size: .9rem; }
  .src li { margin: 0 0 .4rem; line-height: 1.6; }
  .back { margin-top: 3rem; font-size: .9rem; }
  .back a { color: var(--muted); }
</style>
