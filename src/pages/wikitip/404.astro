---
/**
 * K Culture Wire — 404.
 * 없으면 server.mjs 가 남의 얼굴을 내보낸다 — 실측(2026-08-06): "Page not found | SeoulMarkets".
 * src/pages/<접두사>/404.astro 를 두면 server.mjs 가 저절로 이 지면을 쓴다(server.mjs 주석 422줄).
 * 표기는 K Culture Wire (영어만). 링크 경로는 index.astro 와 같은 규칙(/ · /esports · /about).
 */
import WikiTip from '../../layouts/WikiTip.astro';

const TITLE = 'Page not found';
const DESC =
  'This page does not exist. K Culture Wire measures Korean pop culture — Netflix rankings, '
  + 'viewership, Wikipedia attention and the esports ladder — in English, with every source named.';
---

<WikiTip title={TITLE} description={DESC} noindex>
  <h1>Page not found</h1>
  <p class="lead">The page you were looking for isn’t here. Try one of these:</p>
  <ul class="links">
    <li><a href="/">Korean pop culture, in numbers — the front page</a></li>
    <li><a href="/esports">The ladder census — six regions, counted daily</a></li>
    <li><a href="/about">About &amp; methodology</a></li>
  </ul>
</WikiTip>

<style>
  h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.25; margin: 1.2rem 0 .8rem; letter-spacing: -.02em; }
  .lead { font-size: 1.05rem; color: var(--muted); margin: 0 0 1.5rem; }
  .links { list-style: none; padding: 0; margin: 0; }
  .links li { padding: .6rem 0; border-bottom: 1px solid var(--line); }
  .links a { color: var(--accent); text-decoration: none; font-weight: 600; }
</style>
