---
/**
 * K Culture Wire — **갈래별 기사 목록.** (`/section/stars` 따위)
 *
 * ── 왜 이 주소인가 ────────────────────────────────────────────
 *   🔴 2번이 「`/stars` 가 404 다」라고 알려 주셨다. 재 보니 **우리 지면은 그 주소를 안 걸고 있었다**
 *     (기사 카드의 `/${category}` 링크는 서울마켓 것이고, 내 기사는 갈래를 글자로만 쓴다).
 *   ⭐ 그래도 요점은 맞다 — **갈래를 눌러 볼 수가 없었다.**
 *   ⛔ 그런데 `/titles` 는 **작품 카탈로그**, `/industry` 는 **상장 콘텐츠 산업 248곳**이 이미 쓴다.
 *      갈래를 그 주소에 두면 손님이 누르고 엉뚱한 지면에 닿는다. 그래서 `/section/` 아래에 둔다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **기사가 없는 갈래는 지면을 안 만든다.** 빈 지면은 색인에 나쁘다.
 *    `tradition` 은 첫 글이 들어오면 **저절로** 생긴다 — 손으로 켤 일이 없다.
 * ⛔ 줄세우지 않는다. 새것부터 늘어놓을 뿐이다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 */
import { getCollection } from 'astro:content';
import WikiTip from '../../../layouts/WikiTip.astro';

/** 1층 갈래 — 스키마(`src/content.config.ts`)와 같은 말을 쓴다 */
const 이름 = {
  stars: 'Stars', titles: 'Titles', industry: 'Industry', tradition: 'Tradition',
};
const 설명 = {
  stars: 'The people — actors, idols and the audiences that look them up.',
  titles: 'The works — what charted, where, for how long, and what left.',
  industry: 'The business — companies, exports, pay and the shape of the market.',
  tradition: 'The older layer of Korean culture, measured the same way as the rest.',
};
/** 2층이 붙은 기사만 아래에 갈래를 하나 더 보여 준다 */
const 둘째이름 = {
  music: 'Music', drama: 'Drama', film: 'Film', esports: 'Esports',
};

export async function getStaticPaths() {
  const 기사 = await getCollection('kcwArticles');
  const 갈래 = [...new Set(기사.map((a) => a.data.category))];
  /* ⛔ 기사가 없는 갈래는 여기서 아예 안 나온다 — 빈 지면이 생길 수 없다 */
  return 갈래.map((c) => ({
    params: { category: c },
    props: {
      편: 기사.filter((a) => a.data.category === c)
        .sort((x, y) => y.data.pubDate.valueOf() - x.data.pubDate.valueOf()),
    },
  }));
}

const { category } = Astro.params;
const { 편 } = Astro.props;
const 라벨 = 이름[category] ?? category;

const TITLE = `${라벨} — K Culture Wire`;
const DESC = `${설명[category] ?? ''} ${편.length} articles, every figure measured from a named source.`;

/* 🔴 `check-search-readiness` 가 「구조화 데이터가 없다」로 섰다. 목록 지면에는 목록을 적는다 —
   ⛔ Dataset 이라고 하면 거짓이다. 여기 있는 것은 자료가 아니라 **기사 목록**이다. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: TITLE,
  description: DESC,
  isPartOf: { '@type': 'WebSite', name: 'K Culture Wire' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: 편.length,
    itemListElement: 편.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://www.kculturewire.com/article/${a.id}`,
      name: a.data.title,
    })),
  },
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical={`https://www.kculturewire.com/section/${category}`}>
  <h1>{라벨}</h1>
  <p class="lead">{설명[category]}</p>
  <p class="note">{편.length} articles.</p>

  <section>
    <ul class="list">
      {편.map((a) => (
        <li>
          <a href={`/article/${a.id}`}>{a.data.title}</a>
          {a.data.genre && <span class="tag">{둘째이름[a.data.genre] ?? a.data.genre}</span>}
          <p class="fine">{a.data.dek}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="src">
    <p class="note">
      <a href="/articles">All articles</a> · <a href="/about">How we count</a> ·{' '}
      <a href="/corrections">What we have corrected</a>
    </p>
  </section>
</WikiTip>

<style>
  .list { list-style: none; padding: 0; }
  .list li { margin: 0 0 1.1rem; }
  .tag { font-size: 0.78rem; margin-left: 0.4rem; opacity: 0.7; }
</style>
