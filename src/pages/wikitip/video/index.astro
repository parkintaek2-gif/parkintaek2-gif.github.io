---
/*
 * video/index.astro — **영상 갤러리.** 우리가 만든 영상을 «우리 사이트에도» 모아 둔다.
 *
 * 🔴 2026-08-25 오후, 사장님 지시 —
 *   「영상 등 우리가 만든 콘텐트를 우리 사이트에도 게재하고 있지? 안 하고 있으면 해」
 *   「우리가 만든 콘텐트를 보러 온 사람이, 우리가 만든 다른 콘텐트를 계속 볼 수 있도록 해야지」
 *
 * 재 보니 영상 21편이 지면 20장에 «흩어져» 실려 있고 **한자리에 모은 곳이 없었다.**
 * ⛔ 영상만 늘어놓지 않는다. 각 영상 옆에 **그 영상이 나온 지면**을 같이 건다 —
 *   보고 나서 갈 데가 있어야 한다는 것이 지시의 핵심이다.
 *
 * ── 🔴 2026-08-25 저녁 — 이 지면이 «깨진 채로» 라이브에 있었다 ──
 * 처음 만들 때 나는 카드뉴스 자료에 `title` 과 `page` 가 있을 것이라 **짐작하고** 썼다.
 * 열어 보니 그 자료는 `{set, sq[], v[]}` 뿐이었다. 그래서 —
 * ```
 *   화면에 뜨던 글자      actors · brands · control …   ← 파일 이름이다
 *   「그 표로」 링크        21편 중 «0편»
 * ```
 * 빌드는 안 멈췄다. `?? v.set` 이 조용히 받아 냈기 때문이다.
 * ⛔ **조용히 떨어지는 기본값은 깨진 것을 괜찮은 것처럼 보이게 한다.**
 *   그날 낮에 이 지면을 첫 화면에 걸기까지 했다 — 문을 냈는데 그 안이 비어 있었다.
 * ⭐ 이제 짝은 `build-kcw-video-index.mjs` 가 **지면 원본에서 긁어** 낸다.
 *   지면이 영상을 떼면 짝도 저절로 사라지므로 어긋날 수가 없다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-video-index.json';

const 영상 = (data.videos ?? []).filter((v: any) => v.src);
const 짝있는 = 영상.filter((v: any) => v.page).length;

const TITLE = `K Culture Wire videos — ${영상.length} short films on Korean chart and reader data`;
const DESC = `${영상.length} short videos, each built from a table on this site. `
  + `Every one links to the page it was counted from.`;
---

<WikiTip title={TITLE} description={DESC}
  canonical="https://www.kculturewire.com/video">
  <h1>Videos</h1>

  <p class="lead">
    <b>{영상.length}</b> short films. Each one was built from a table on this site, and
    {짝있는 === 영상.length ? ' every one links back to it' : ` ${짝있는} of them link back to it`}
    &mdash; the film is the headline, the page is the working.
  </p>

  <p class="fine">
    The sentence under each film is the one printed beside it on its own page. We do not write a
    second description for the video, because then there would be two versions of the same claim.
  </p>

  <section>
    <div class="vgrid">
      {영상.map((v: any) => (
        <figure class="vcard">
          <video controls preload="none" playsinline
            poster={v.thumb ?? undefined} width="270" height="480">
            <source src={v.src} type="video/mp4" />
            Your browser cannot play this file. It is a short MP4.
          </video>
          <figcaption>
            {v.says
              ? <p class="says">{v.says}</p>
              : <p class="says fine">We have no caption on file for this one.</p>}
            {v.page
              ? <div class="fine"><a href={v.page}>The table this came from</a></div>
              /* ⛔ 짝을 못 찾은 것도 세워 둔다. 지우면 «없는 것»이 되어 아무도 못 고친다 */
              : <div class="fine">We could not match this film to a page. That is our gap, not yours.</div>}
            {v.alsoOn && v.alsoOn.length > 0 && (
              <div class="fine">Also on {v.alsoOn.map((p: string, i: number) => (
                <>{i > 0 && ', '}<a href={p}>{p}</a></>
              ))}</div>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="onward">
    <h3>Where to go next</h3>
    <ul class="walk">
      <li><a href="/articles">Everything we have published</a></li>
      <li><a href="/person">Korean actors on Netflix &mdash; every title they charted with</a></li>
      <li><a href="/titles">Korean drama list &mdash; every title that reached a Netflix top 10</a></li>
      <li><a href="/group">Kpop idols by group &mdash; age and birthday</a></li>
      <li><a href="/born-on">Korean actors&rsquo; birthdays</a></li>
      <li><a href="/school">Where Korean actors and singers studied</a></li>
    </ul>
  </section>
</WikiTip>

<style>
  .vgrid { display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .vcard { margin: 0; }
  .vcard video { width: 100%; height: auto; border-radius: 8px; background: #0e0c14; }
  .vcard figcaption { margin-top: .45rem; font-size: .9rem; }
  .says { margin: 0 0 .35rem; }
</style>
