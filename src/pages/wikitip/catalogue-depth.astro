---
/**
 * K Culture Wire — **나라마다 한국 작품을 몇 편이나 겪었나.** (`/catalogue-depth`)
 *
 * ── 왜 이 지면인가 (2번 지시 18:4x) ────────────────────────────
 * 46편째 기사에 「every figure has a table behind it」이라고 적어 놓고 표를 안 냈다.
 * **그 한 줄이 라이브에서 거짓말이었다.** 새 기사보다 이것이 급하다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **93개국을 1위부터 늘어놓지 않는다.** 두 무리와 양 끝만 내고 왜 다른지를 적는다.
 * ⛔ 대조군을 **표로** 낸다. 「자리가 적으면 당연히 쏠려 보인다」를 지면이 스스로 시험한다.
 *    날것 차이만 크게 적고 맞춘 뒤 차이를 작게 적으면 그건 고른 것이다. 나란히 놓는다.
 * ⛔ 시청량이 아니다. 취향도 아니다. Top10 에 들었나만 보인다.
 * ⛔ 광고 자리를 만들지 않았다. Riot Production(App 866800) 승인 전이다.
 *
 * ── ⚠ 수를 여기 손으로 적지 않는다 ────────────────────────────
 * 🔴 8/8 에 `toLocaleDateString` 에 timeZone 을 안 줘서 라이브 날짜가 하루 일렀다.
 *    「내 화면에서 맞다」는 맞다는 뜻이 아니다. 수는 전부 자료에서 읽는다.
 *    지키는 자 — `scripts/check-catalogue-depth-article.mjs`
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/wikitip-catalogue-depth.json';
import ambiguity from '../../data/wikitip-title-ambiguity.json';

const TITLE = 'How many different Korean titles has your country actually seen?';

const 안 = data.groups[0];
const 밖 = data.groups[1];
const 맞안 = data.matched.asian;
const 맞밖 = data.matched.other;

/* 이름겹침 판정 — 938편 전부. ⛔ 수를 손으로 적지 않는다. 판정 칸에서 센다 */
const 센다 = (v: string) => ambiguity.perTitle.filter((p) => p.verdict === v).length;
const 확실 = [
  { key: 'koreaOnly', label: 'A Korean work carries this name, and no foreign one does', n: 센다('koreaOnly'),
    means: 'The name cannot be matched to anything else. Safe.' },
  { key: 'shared', label: 'A Korean work and a foreign one share the name', n: 센다('shared'),
    means: 'We cannot tell from the name alone which one charted.' },
  { key: 'unknown', label: 'Wikidata records no country for the name', n: 센다('unknown'),
    means: 'No basis to judge — not evidence either way.' },
  { key: 'koreaUnconfirmed', label: 'Foreign works carry it and we could not tie it to a Korean one',
    n: 센다('koreaUnconfirmed'), means: 'Still open. Listed below by name.' },
];
const 열린자리 = ambiguity.koreaUnconfirmedQueue.reduce((s, x) => s + x.places, 0);
const 열쇠로찾음 = ambiguity.keyedNotLabelled;
const 열쇠자리 = 열쇠로찾음.reduce((s, x) => s + x.places, 0);
const 슬롯합 = data.countries.reduce((s, c) => s + c.koreanSlots, 0);

const DESC =
  `Across ${data.countryCount} markets, the typical Asian one has charted `
  + `${안.medianDistinctTitles} different Korean titles and the typical market elsewhere `
  + `${밖.medianDistinctTitles}. It takes ${안.medianHalfTakes} titles to fill half of one and `
  + `${밖.medianHalfTakes} to fill half of the other.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${data.weekFrom}/${data.weekTo}`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://query.wikidata.org'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/catalogue-depth">
  <h1>How many different Korean titles has your country actually seen?</h1>
  <p class="lead">
    <a href="/world-share">Our world-share page</a> counts what fraction of Netflix's published
    top-10 places hold a Korean title. This one counts something that number hides: the same share
    can be twenty titles taking turns or one title sitting there all year.
  </p>
  <p class="q">{data.question}</p>

  <section>
    <h2>Two groups, {data.countryCount} markets</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr>
            <th>Group</th><th>Markets</th><th>Korean places</th>
            <th>Different titles</th><th>Fill half</th><th>Largest title</th>
          </tr>
        </thead>
        <tbody>
          {data.groups.map((g) => (
            <tr class={g.countries === 10 ? 'edge' : ''}>
              <td class="nm">{g.group}</td>
              <td>{g.countries}</td>
              <td>{g.medianKoreanSlots.toLocaleString('en-US')}</td>
              <td class="tot">{g.medianDistinctTitles}</td>
              <td class="tot">{g.medianHalfTakes}</td>
              <td>{g.medianTopTitlePc}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <b>Every figure is a median of the markets in that group</b>, not a total. In the median Asian
      market it takes {안.medianHalfTakes} different Korean titles to account for half of all Korean
      chart appearances; everywhere else, {밖.medianHalfTakes}. The single biggest Korean title holds
      {' '}{안.medianTopTitlePc}% of the Korean places in the median Asian market against
      {' '}<b>{밖.medianTopTitlePc}%</b> elsewhere.
    </p>
  </section>

  <section>
    <h2>The two ends</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Market</th><th>Different titles</th><th>Fill half</th><th>Largest title</th><th>Its share</th></tr>
        </thead>
        <tbody>
          {data.widest.map((c) => (
            <tr class="wide">
              <td class="nm">{c.name}</td><td>{c.distinctTitles}</td><td class="tot">{c.halfTakes}</td>
              <td class="nm"><i>{c.topTitle}</i></td><td>{c.topTitlePc.toFixed(1)}%</td>
            </tr>
          ))}
          {data.narrowest.map((c) => (
            <tr>
              <td class="nm">{c.name}</td><td>{c.distinctTitles}</td><td class="tot">{c.halfTakes}</td>
              <td class="nm"><i>{c.topTitle}</i></td><td>{c.topTitlePc.toFixed(1)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <b>The difference is not which title leads.</b> The same title leads
      {' '}{data.widest.filter((c) => c.topTitle === data.narrowest[0].topTitle).length} of the five
      widest markets as well as all five of the narrowest — it leads
      {' '}{data.widest.find((c) => c.name === 'Indonesia')?.name ?? 'one'} with
      {' '}{data.widest.find((c) => c.name === 'Indonesia')?.topTitlePc}% and
      {' '}{data.narrowest.find((c) => c.name === 'Latvia')?.name ?? 'another'} with
      {' '}<b>{data.narrowest.find((c) => c.name === 'Latvia')?.topTitlePc}%</b>. Those two numbers
      describe completely different viewing experiences of the same show.
    </p>
  </section>

  <section>
    <h2>The objection, tested</h2>
    <p class="warn">
      A market with fewer Korean places will look more concentrated for arithmetic reasons alone.
      A country with only {data.narrowest.find((c) => c.name === 'United States')?.koreanSlots} Korean
      chart appearances <b>cannot</b> spread them over {안.medianDistinctTitles} titles. On that
      reading this page says nothing except "some markets chart less Korean content", which we
      already published. So we tested it, by comparing only markets that hold a similar number of
      Korean places.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr>
            <th>Matched on Korean places ({data.matched.from}–{data.matched.to.toLocaleString('en-US')})</th>
            <th>Markets</th><th>Korean places</th><th>Different titles</th><th>Fill half</th><th>Largest title</th>
          </tr>
        </thead>
        <tbody>
          <tr class="edge">
            <td class="nm">Asian</td>
            <td>{맞안.countries}</td><td>{맞안.medianKoreanSlots.toLocaleString('en-US')}</td>
            <td>{맞안.medianDistinctTitles}</td><td class="tot">{맞안.medianHalfTakes}</td>
            <td>{맞안.medianTopTitlePc}%</td>
          </tr>
          <tr>
            <td class="nm">Other</td>
            <td>{맞밖.countries}</td><td>{맞밖.medianKoreanSlots.toLocaleString('en-US')}</td>
            <td>{맞밖.medianDistinctTitles}</td><td class="tot">{맞밖.medianHalfTakes}</td>
            <td>{맞밖.medianTopTitlePc}%</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      The Asian markets in that band are {맞안.names.join(', ')}. The others are
      {' '}{맞밖.names.join(', ')}. The raw gap in titles-to-fill-half was <b>{data.gapRaw}</b>
      {' '}({안.medianHalfTakes} against {밖.medianHalfTakes}); inside the matched band it is
      {' '}<b>{data.gapMatched}</b> ({맞안.medianHalfTakes} against {맞밖.medianHalfTakes}).
      {' '}<b>{data.explainedByVolumePc}% of the gap was volume, and the rest is not.</b> That is the
      honest size of it: smaller than the first table suggests, and not zero.
    </p>
  </section>

  <section>
    <h2>The width inside the Asian group</h2>
    <p class="note lead-in">
      A group of ten is not ten identical markets. The number of titles needed to fill half runs from
      {' '}<b>{data.asianHalfRange.min} to {data.asianHalfRange.max}</b> inside it.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Shallowest of the ten</th><th>Different titles</th><th>Fill half</th><th>Largest title</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="nm">{data.asianShallowest.name}</td>
            <td>{data.asianShallowest.distinctTitles}</td>
            <td class="tot">{data.asianShallowest.halfTakes}</td>
            <td>{data.asianShallowest.topTitlePc}%</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      As many different Korean titles have charted there as in its neighbours, but far fewer of them
      carry half the places. <b>We are not going to explain that here</b> — a large domestic
      catalogue and a separate history with Korean television are both plausible and this data
      distinguishes none of it. We name it because a group with one member behaving differently is
      worth saying out loud rather than leaving inside a median.
      {' '}<a href="/article/six-titles-or-forty-nine">The full story &rarr;</a>
    </p>
  </section>

  {/*
    ⛔ 여기가 이 지면에서 가장 조심한 자리다. 93개국을 다 내되 **순위로 내지 않는다.**
       가나다순으로 낸다 — 손님이 오는 까닭은 「우리 나라는 어떤가」이지
       「누가 1등인가」가 아니다. 큰 수로 정렬하는 순간 그건 나라 자랑표가 된다.
    ⚠ 세어 놓고 안 보여 주면 안 센 것과 같다. 위 표들은 중앙값과 양 끝뿐이라,
       가운데 있는 나라의 손님은 자기 나라를 못 본다.
  */}
  <section>
    <h2>Every market, in alphabetical order</h2>
    <p class="note lead-in">
      Sorted by name, not by size. Look up your own; the order carries no meaning.
    </p>
    <div class="scroll-x tall">
      <table>
        <thead>
          <tr>
            <th>Market</th><th>Korean share</th><th>Korean places</th>
            <th>Different titles</th><th>Fill half</th><th>Largest title</th><th>Its share</th>
          </tr>
        </thead>
        <tbody>
          {[...data.countries].sort((a, b) => a.name.localeCompare(b.name)).map((c) => (
            <tr class={c.inAsianTen ? 'edge' : ''}>
              <td class="nm">{c.name}</td>
              <td>{c.koreanPc}%</td>
              <td>{c.koreanSlots.toLocaleString('en-US')}</td>
              <td class="tot">{c.distinctTitles}</td>
              <td class="tot">{c.halfTakes}</td>
              <td class="nm"><i>{c.topTitle}</i></td>
              <td>{c.topTitlePc}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Shaded rows are the {안.countries} Asian markets grouped above. Every figure is measured over
      the same {data.weekCount} weeks with the same identification, so a market low on this table
      charted fewer Korean titles — it does not mean fewer were available or fewer were watched.
    </p>
  </section>

  {/*
    🔴 2026-08-09 새로 붙였다. 이 지면은 93개 시장을 다 싣는데, 그 명단이 얼마나 확실한지는
       한 번도 안 적었다. 이름겹침 감사가 동남아까지만 덮고 있었기 때문이다 — 이제 938편 전부에 있다.
    ⛔ 시간으로 잰 79.9% 를 여기 그대로 옮겨 적지 않는다. **분모가 다르다.**
       시간 비중은 큰 작품이 끌어올리고, 편수는 꼬리가 끌어내린다. 둘 다 적어야 손님이 안 속는다.
    ⛔ 숫자를 손으로 적지 않는다 — perTitle 에서 센다.
  */}
  <section>
    <h2>How sure are we that these titles are Korean?</h2>
    <p class="note lead-in">
      Every title above is matched against works Wikidata records as made in South Korea — by
      Wikidata item number where we hold one, and by English name otherwise. We asked, for all
      {' '}{ambiguity.perTitle.length} titles in this table, which countries made a film or series of
      that name. Four answers came back.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Answer</th><th>Titles</th><th>Share</th><th>What it means for a figure on this page</th></tr>
        </thead>
        <tbody>
          {확실.map((r) => (
            <tr class={r.key === 'koreaUnconfirmed' ? 'edge' : ''}>
              <td class="nm">{r.label}</td>
              <td class="tot">{r.n}</td>
              <td>{((100 * r.n) / ambiguity.perTitle.length).toFixed(1)}%</td>
              <td class="nm">{r.means}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="warn">
      <b>By viewing, this catalogue is far more certain than it is by title count.</b>{' '}
      {ambiguity.koreaOnly.sharePc}% of Korean viewing hours sit on titles only Korean works carry —
      but only {((100 * 확실[0].n) / ambiguity.perTitle.length).toFixed(1)}% of the titles do. The two
      are not in conflict: the largest titles are the unmistakable ones, and the uncertainty lives in
      the tail, where a single common English word can name a Korean series and a foreign one at once.
      A figure weighted by places or hours inherits the first number; a count of distinct titles —
      the “Different titles” column above — inherits the second.
    </p>
    <p class="warn">
      <b>A name is not an identifier, and this check learned that the hard way.</b> Asked by name
      alone, Wikidata reported no Korean work behind <i>Land</i>, <i>Deliver Us from Evil</i> or{' '}
      <i>Detour</i> — because it files them as <i>LAND</i>, <i>Deliver Us From Evil</i> and{' '}
      <i>DETOUR</i>, and a label match is case-sensitive. Only the foreign works came back, which
      reads exactly like “this is not Korean.” We now ask by identifier instead, using the Wikidata
      item numbers already stored alongside these titles.{' '}
      <b>{열쇠로찾음.length} titles</b> carrying {열쇠자리.toLocaleString('en-US')} of the
      {' '}{슬롯합.toLocaleString('en-US')} places on this page are found only that way.
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Found by identifier, not by name</th><th>Wikidata item</th><th>Places</th></tr></thead>
        <tbody>
          {열쇠로찾음.slice(0, 12).map((x) => (
            <tr><td class="nm"><i>{x.title}</i></td><td class="nm">{x.q}</td><td class="tot">{x.places}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note lead-in">
      The last row of the first table is what is left over: foreign works carry the name and no
      Korean item is tied to it. That is <b>not</b> a finding that the title is foreign — it is the
      part we have not settled. It covers {열린자리} of the {슬롯합.toLocaleString('en-US')} Korean
      places here, or {((100 * 열린자리) / 슬롯합).toFixed(2)}%. We name them rather than quietly
      drop or keep them:
    </p>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Title</th><th>Places</th><th>Countries Wikidata records for that name</th></tr></thead>
        <tbody>
          {ambiguity.koreaUnconfirmedQueue.map((x) => (
            <tr>
              <td class="nm"><i>{x.title}</i></td>
              <td class="tot">{x.places}</td>
              <td class="nm">{x.countries.slice(0, 5).join(', ')}{x.countries.length > 5 ? ` and ${x.countries.length - 5} more` : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      What this check still cannot do: a shared name stays shared. We can say how large that group
      is, which is what the first table is for, but not which of the two works charted in Manila on a
      given week. And a title Wikidata has never heard of comes back with no country, which is not
      evidence in either direction.
    </p>
  </section>

  <KcwRelatedArticles page="/catalogue-depth" />

  <section class="src">
    <h2>Where these numbers come from, and what they cannot answer</h2>
    <ul>
      <li><b>Netflix</b> — {data.source}</li>
      <li>
        <b>Every market enters on the same terms.</b> All {data.countryCount} publish exactly
        {' '}{data.slotsPerCountry.toLocaleString('en-US')} rows over the same {data.weekCount} weeks,
        {' '}{data.weekFrom} to {data.weekTo}. The collector refuses to run if any two differ.
      </li>
      <li>
        <b>One market is excluded and we name it.</b> {data.excludedCountry.name} —
        {' '}{data.excludedCountry.why}
      </li>
      <li>
        <b>Not taste.</b> This measures which titles entered a top 10, not what anyone preferred. A
        market whose top 10 rarely holds a Korean title may be watching a great deal that never
        breaks into ten places against everything else Netflix carries.
      </li>
      <li>
        <b>Not viewing.</b> Country lists carry a rank and no hours figure.
      </li>
      <li>
        <b>Not a ranking.</b> The two ends are printed to show the width of the range. The middle
        {' '}{data.countryCount - data.widest.length - data.narrowest.length} markets are not ordered
        against each other anywhere on this page.
      </li>
      <li>
        <b>The surviving gap is not explained.</b> We controlled for one thing — how many Korean
        places a market has at all — because it was the objection we could test. Release windows,
        subtitle and dub availability, and the size of each market's own production are all
        plausible and none of them is separated here.
      </li>
    </ul>
  </section>

  <p class="back"><a href="/">&larr; Back to the front page</a></p>
</WikiTip>

<style>
  h1 { margin: 0 0 .5rem; font-size: 1.7rem; letter-spacing: -.02em; }
  .lead { margin: 0 0 .6rem; font-size: 1rem; color: var(--muted); }
  .q { margin: 0 0 2rem; font-size: .9rem; color: var(--accent); }
  section { margin: 0 0 2.5rem; }
  h2 { font-size: 1.1rem; margin: 0 0 .7rem; letter-spacing: -.01em; }
  .note { font-size: .82rem; color: var(--muted); margin: .9rem 0 0; line-height: 1.6; }
  .note.lead-in { margin: 0 0 .9rem; }
  .note b { color: var(--ink); }

  /* 반박을 눈에 띄게 둔다 — 아래로 밀면 안 읽고, 안 읽으면 우리가 감춘 것이 된다 */
  .warn {
    font-size: .86rem; line-height: 1.65; margin: 0 0 1rem;
    padding: .8rem .9rem; border-left: 3px solid var(--accent);
    background: var(--card); border-radius: 0 6px 6px 0;
  }
  .warn b { color: var(--ink); }

  table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  th, td { padding: .45rem .55rem; border-bottom: 1px solid var(--line); text-align: right;
           white-space: nowrap; font-variant-numeric: tabular-nums; }
  th { font-size: .72rem; letter-spacing: .03em; text-transform: uppercase; color: var(--muted);
       font-weight: 700; }
  th:first-child, td.nm { text-align: left; white-space: normal; }
  td.tot { font-weight: 700; }
  tr.edge td { background: var(--card); }
  /* 93줄은 지면을 삼킨다. 자기 나라를 찾는 사람이 스크롤로 헤매지 않게 틀 안에서 굴린다 */
  .tall { max-height: 26rem; overflow-y: auto; }
  .tall thead th { position: sticky; top: 0; background: var(--bg); z-index: 1; }
  /* 양 끝 표에서 위 다섯과 아래 다섯 사이에 금을 긋는다 — 이어진 순위표로 안 읽히게 */
  tr.wide:last-of-type td { border-bottom: 2px solid var(--accent); }
  @media (max-width: 480px) {
    table { font-size: .78rem; }
    th, td { padding: .38rem .28rem; }
  }

  .src ul { margin: 0; padding-left: 1.1rem; font-size: .85rem; color: var(--muted); line-height: 1.7; }
  .src li { margin: .45rem 0; }
  .src b { color: var(--ink); }
  .back { margin-top: 2.5rem; font-size: .9rem; }
</style>
