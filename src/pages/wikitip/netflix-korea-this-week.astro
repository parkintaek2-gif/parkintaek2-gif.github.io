---
/**
 * K Culture Wire — **「이번 주 넷플릭스에 한국 작품 뭐가 올라 있나」.** (`/netflix-korea-this-week`)
 *
 * ── 왜 (2026-08-29) ───────────────────────────────────────────
 * 사장님 지시 — 「**텍스트가 6번**이야」·「오늘 이순간 이슈되는 걸 찾아서」
 *
 * 우리는 주 지면을 **269장** 갖고 있는데, «늘 최신을 가리키는 입구»가 없었다.
 * 손님은 「이번 주」를 묻는데 우리 문은 「2026-08-23」이라는 날짜를 알아야 열렸다.
 * ⭐ 날짜를 아는 사람은 이미 우리 손님이다. **모르는 사람을 받는 문**이 없었다.
 *
 * ⭐ 그리고 이 지면은 «다시 오게» 만든다 — 주마다 내용이 바뀌는 유일한 자리다.
 *   「방문자·체류시간에 올인」이라 하셨고, 재방문은 그 둘을 한꺼번에 올린다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **「이번 주」라 적으면서 몇 주 묵은 것을 내지 않는다.** 주 이름과 «며칠 된 자료인지»를
 *   첫 문단에 적는다. 넷플릭스가 늦게 내면 우리도 늦다 — 그것을 숨기지 않는다.
 * ⛔ 「인기가 올랐다」로 쓰지 않는다. **나라 수가 늘었다**고만 쓴다. 우리는 시청자를 못 센다.
 * ⛔ 지면이 없는 작품은 이름만 싣고 링크를 안 건다 — 죽은 링크를 안 만든다.
 * ⭐ 남이 안 세는 것을 낸다 — **지난주와의 차이**(들어온 것·나간 것·버틴 것).
 *   「이번 주 목록」은 넷플릭스도 낸다. 차이는 우리가 센다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import data from '../../data/kcw-this-week.json';

const 주말 = (w: string) => new Date(`${w}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});

/*
 * ⚠ 제목에 손님이 치는 말(「this week」)을 넣되, «어느 주인지»를 같이 넣는다.
 *   그 말만 넣고 날짜를 빼면 몇 주 묵은 것을 이번 주라고 내놓게 된다.
 */
const TITLE = `Korean titles on Netflix this week — ${data.titles.length} of them, week of ${주말(data.week)}`;
const DESC = `${data.titles.length} Korean titles held a Netflix weekly top 10 place somewhere in the `
  + `week of ${주말(data.week)}. ${data.entered.length} entered, ${data.left.length} left, `
  + `${data.held.length} held on from the week before. Every title and its country count, listed.`;

const 넓은것 = data.titles[0];
const 오른것 = data.held.filter((t: any) => t.나라변화 > 0).length;
const 내린것 = data.held.filter((t: any) => t.나라변화 < 0).length;
const 그대로 = data.held.filter((t: any) => t.나라변화 === 0).length;
const 최대주 = Math.max(...data.trend.map((t: any) => t.titles));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: data.week,
  spatialCoverage: `${data.marketCount} countries`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10'],
};

---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/netflix-korea-this-week">
  <h1>Korean titles on Netflix this week</h1>

  <p class="lead">
    <b>{data.titles.length} Korean titles</b> held a place on some country&rsquo;s Netflix weekly
    top 10 in the week Netflix labels <b>{data.week}</b> &mdash; the week of {주말(data.week)}.
    {' '}<b>{넓은것.title}</b> reached the most countries of them, <b>{넓은것.countries}</b>,
    and got as high as number {넓은것.peak} in one of them.
  </p>

  <p class="warn">
    <b>This is the newest week we hold, and it is {data.daysOld} days old.</b> Netflix publishes
    its weekly files on a delay, so &ldquo;this week&rdquo; here means the newest week
    <i>they</i> have published, not the days you are living through. We would rather say that
    than let the word do work the data cannot.
  </p>

  <section>
    <h2>What changed since the week before</h2>
    <p class="sub">
      Netflix publishes the list. It does not publish the difference between two lists. This is
      that difference, against the week of {data.previousWeek ? 주말(data.previousWeek) : '—'}.
    </p>
    <table class="cmp">
      <tbody>
        <tr><td>Entered &mdash; not on last week&rsquo;s list</td><td class="num"><b>{data.entered.length}</b></td></tr>
        <tr><td>Left &mdash; on last week&rsquo;s list, not this one</td><td class="num"><b>{data.left.length}</b></td></tr>
        <tr><td>Held on, in more countries than last week</td><td class="num">{오른것}</td></tr>
        <tr><td>Held on, in fewer countries</td><td class="num">{내린것}</td></tr>
        <tr><td>Held on, in the same number</td><td class="num">{그대로}</td></tr>
      </tbody>
    </table>
    <p class="fine">
      <b>&ldquo;Left the chart&rdquo; is not &ldquo;stopped being watched&rdquo;.</b> A title drops
      off a country&rsquo;s top 10 when ten other titles did better there that week. It may still
      be on Netflix, and people may still be watching it. We can only see the ten.
    </p>
  </section>

  {data.entered.length > 0 && (
    <section>
      <h2>Entered this week</h2>
      <table>
        <thead><tr><th>Title</th><th>Kind</th><th class="num">Countries</th><th class="num">Best place</th></tr></thead>
        <tbody>
          {data.entered.map((t: any) => (
            <tr>
              <td class="nm">{t.slug ? <a href={`/title/${t.slug}`}>{t.title}</a> : <span>{t.title}</span>}</td>
              <td class="fine">{t.type === 'TV' ? 'Series' : (t.type === 'Films' ? 'Film' : '—')}</td>
              <td class="num"><b>{t.countries}</b></td>
              <td class="num">{t.peak}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section>
    <h2>Every Korean title on a chart this week</h2>
    <p class="sub">
      Ordered by how many countries listed it. A chart place is one country&rsquo;s weekly top 10
      listing the title once &mdash; it is not a count of viewers.
    </p>
    <table>
      <thead>
        <tr><th>Title</th><th>Kind</th><th class="num">Countries</th><th class="num">Best place</th><th class="num">vs last week</th></tr>
      </thead>
      <tbody>
        {data.titles.map((t: any) => {
          const h = data.held.find((x: any) => x.title === t.title);
          return (
            <tr>
              <td class="nm">{t.slug ? <a href={`/title/${t.slug}`}>{t.title}</a> : <span>{t.title}</span>}</td>
              <td class="fine">{t.type === 'TV' ? 'Series' : (t.type === 'Films' ? 'Film' : '—')}</td>
              <td class="num">{t.countries}</td>
              <td class="num">{t.peak}</td>
              <td class="num">{h
                ? (h.나라변화 > 0 ? `+${h.나라변화}` : (h.나라변화 < 0 ? `${h.나라변화}` : '0'))
                : <span class="fine">new</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  {data.left.length > 0 && (
    <section>
      <h2>On last week&rsquo;s chart, not this one</h2>
      <p class="sub">Where they stood the week before they dropped off.</p>
      <table>
        <thead><tr><th>Title</th><th>Kind</th><th class="num">Countries last week</th><th class="num">Best place</th></tr></thead>
        <tbody>
          {data.left.map((t: any) => (
            <tr>
              <td class="nm">{t.slug ? <a href={`/title/${t.slug}`}>{t.title}</a> : <span>{t.title}</span>}</td>
              <td class="fine">{t.type === 'TV' ? 'Series' : (t.type === 'Films' ? 'Film' : '—')}</td>
              <td class="num">{t.countries}</td>
              <td class="num">{t.peak}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section>
    <h2>The last {data.trend.length} weeks</h2>
    <p class="sub">So you can see whether this week is a busy one or a quiet one, rather than take our word.</p>
    <table class="yr">
      <thead><tr><th>Week</th><th class="num">Korean titles</th><th class="num">Countries reached</th></tr></thead>
      <tbody>
        {[...data.trend].reverse().map((w: any) => (
          <tr class={w.week === data.week ? 'now' : ''}>
            <td>{w.week === data.week ? <b>{w.week}</b> : <a href={`/week/${w.week}`}>{w.week}</a>}</td>
            <td class="num">{w.titles}
              <span class="bar" style={`--w:${Math.round((w.titles / 최대주) * 100)}%`}></span>
            </td>
            <td class="num">{w.countries}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section>
    <h2>What this is, and what it is not</h2>
    <p class="fine">{data.cannotAnswer}</p>
    <p class="fine">
      <b>Two charts, not one.</b> Netflix publishes a films list and a series list separately, and
      a name can sit on both as two different works. We do not add those together. Where we could
      not establish which work is the Korean one, neither set of numbers is published under it.
    </p>
  </section>

  <section>
    <h2>Where to walk from here</h2>
    <p>
      <a href={`/week/${data.week}`}>This week, country by country</a> &middot;{' '}
      <a href="/weeks">Every week we hold</a> &middot;{' '}
      <a href="/korean-movies-on-netflix">Korean movies on Netflix, films only</a> &middot;{' '}
      <a href="/netflix-top-10-korean-drama">Korean series on Netflix</a> &middot;{' '}
      <a href="/by-country">Every country and how Korean its chart is</a> &middot;{' '}
      <a href="/most-popular">Three measures of &ldquo;most popular&rdquo; that disagree</a>
    </p>
  </section>

  <KcwMethodLimits
    method={`Netflix's own weekly top 10 files by country. This page reads the newest week in those files and the week before it, keeps only the titles our Korean-title rule holds, and compares the two lists. Russia is excluded because Netflix left. A title that appears on both the films and the series chart is two different works sharing a name; we follow the chart our title records identify as the Korean one and never merge the two.`}
    limitation={`A chart place is not a viewing figure — Netflix publishes no hours or viewers by country, so nothing here says how many people watched, and a small market counts the same as a large one. Leaving a chart is not the same as being watched less: it means ten other titles did better in that country that week. Netflix also states no country of production, so which titles count as Korean is our inference. The week shown is the newest Netflix has published, which is ${data.daysOld} days old today.`}
  />

  <style>
    .lead { font-size: 1.08rem; }
    .warn { border-left: 3px solid var(--accent); padding: .7rem 1rem; margin: 1.4rem 0 2rem;
      font-size: .95rem; }
    h2 { font-size: 1.12rem; margin: 2.4rem 0 .3rem; }
    .sub { color: var(--muted); font-size: .92rem; margin: 0 0 .8rem; }
    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    table.cmp, table.yr { max-width: 34rem; }
    th, td { text-align: left; padding: .4rem .5rem; border-bottom: 1px solid var(--line); }
    th.num, td.num { text-align: right; }
    .nm { font-weight: 600; }
    .fine { color: var(--muted); font-size: .86rem; }
    tr.now td { background: color-mix(in srgb, var(--accent) 8%, transparent); }
    .bar { display: inline-block; height: .5rem; width: var(--w); max-width: 7rem;
      background: var(--accent); opacity: .35; margin-left: .5rem; vertical-align: middle; }
  </style>
</WikiTip>
