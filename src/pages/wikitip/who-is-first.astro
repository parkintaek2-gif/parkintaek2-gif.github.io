---
/**
 * K Culture Wire — **네 나라가 각각 누구를 제일 많이 찾아보나.** (`/who-is-first`)
 *
 * 🔴 사장님 지시(8/16) — 「스타의 이름과 소속 그룹명을 제목과 본문에 반드시 넣는다.
 *   사람들은 스타의 이름을 검색한다」 → 제목에 BTS·Babymonster 가 들어 있고,
 *   표의 첫 칸이 이름이다. 수는 이름 뒤에 선다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **네 나라를 합치지 않는다.** 합치면 1등이 하나가 되고 이 지면의 요점이 죽는다.
 * ⛔ **Q번호를 이름인 척 싣지 않는다.** 뺀 개수를 지면에 적는다.
 * ⛔ **읽힘을 인기로 팔지 않는다.** 문서를 연 사람 수다.
 * ⛔ **나라끼리 크기를 견주지 않는다.** 말레이시아 수가 작은 것은 판이 작아서다.
 * ⛔ 광고 자리를 만들지 않는다. Riot Production(App 866800) 승인 전이다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/wikitip-who-is-first.json';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import KcwPanel from '../../components/KcwPanel.astro';

const 인니 = d.firstByEdition.id;
const 베트 = d.firstByEdition.vi;
const 태국 = d.firstByEdition.th;
const 말레 = d.firstByEdition.ms;
/* BTS 가 몇 나라에서 1등인가 — 손으로 세지 않는다 */
const BTS나라 = d.editions.filter((p) => d.firstByEdition[p]?.name === 베트.name);

const TITLE = `BTS is first in three Southeast Asian countries. In Indonesia it is ${인니.name}`;
const DESC =
  `Across the Indonesian, Vietnamese, Thai and Malay Wikipedias, ${베트.name} tops three of the `
  + `four reading lists and ${인니.name} tops Indonesia's. ${태국.name}, ${말레.name}, `
  + `${d.topByEdition.th[1].name} and ${d.topByEdition.ms[1].name} are in here too, with the `
  + 'ten most-read Korean acts in each country.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/', 'https://wikimedia.org/api/rest_v1/'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/who-is-first">
  <h1>{TITLE}</h1>
  <KcwPanel editionNames={d.editionNames} countryNames={d.countryNames} />
  <p class="lead">{d.question}</p>
  <p class="q">
    <b>{베트.name}</b> is the most-read Korean act on {BTS나라.length} of the four Southeast Asian
    Wikipedias — {BTS나라.map((p) => d.countryNames[p]).join(', ')} — at
    {' '}{베트.perMillion}, {태국.perMillion} and {말레.perMillion} reads per million.
    Indonesia's list opens with someone else: <b>{인니.name}</b>, at {인니.perMillion}.
  </p>

  {d.editions.map((p) => (
    <section>
      <h2>{d.countryNames[p]} — the {d.rowsPerEdition} most-read Korean acts</h2>
      <div class="scroll-x">
        <table>
          <thead><tr><th>#</th><th>Name</th><th>Reads per million</th></tr></thead>
          <tbody>
            {d.topByEdition[p].map((x) => (
              <tr>
                <td class="fine">{x.rank}</td>
                <td class="nm">{x.name}</td>
                <td>{x.perMillion}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {d.onlyInOne.find((o) => o.edition === p)?.only.length > 0 && (
        <p class="note">
          Read here and nowhere else in this table:
          {' '}<b>{d.onlyInOne.find((o) => o.edition === p).only.join(', ')}</b>.
        </p>
      )}
    </section>
  ))}

  <section>
    <h2>Only {d.inAllFour.join(', ')} is on all four lists</h2>
    <p>
      Of the {d.rowsPerEdition * 4} places across the four tables, exactly
      {' '}<b>{d.inAllFour.length}</b> name appears in every one of them:
      {' '}<b>{d.inAllFour.join(', ')}</b>. Everything else is a country's own.
      {' '}{d.countryNames.th} reads {d.topByEdition.th[1].name} second and
      {' '}{d.countryNames.ms} reads {d.topByEdition.ms[1].name} second, and neither name is in
      the other's top {d.rowsPerEdition}.
    </p>
  </section>

  <section>
    <h2>Names we could not print</h2>
    <p class="note">{d.unresolvedNames.note}</p>
    <p class="note">
      Dropped for this reason: <b>{d.unresolvedNames.count}</b> of the
      {' '}{d.actsMeasured.toLocaleString('en-US')} acts in the panel
      ({d.unresolvedNames.examples.join(', ')}).
    </p>
  </section>

  <section>
    <h2>What this page cannot tell you</h2>
    {d.cannotSay.map((s) => <p class="note">{s}</p>)}
    <p class="note">
      Reads — Wikimedia Pageviews API, human traffic only, {d.window}, expressed per million reads
      of that edition so a small Wikipedia is not penalised for being small. Article links —
      Wikidata.
    </p>
    <p class="note">
      <a href="/fame-compare">The same acts against athletes</a> ·{' '}
      <a href="/spread">What gets read in all four</a> · <a href="/about">How we count</a>
    </p>
  </section>

  <KcwRelatedArticles page="/who-is-first" />
  <KcwMethodLimits method={d.method} limitation={d.limitation} />
  {/* 🔴 2026-08-22 — 명단이 무엇인지(panel)를 세어 두고 안 보여 주고 있었다.
      누구를 넣고 누구를 뺐는지 모르면 이 표는 검증이 불가능하다 */}
  <section class="src">
    <h2>Who is in this panel</h2>
    <p class="note">{d.panel}. That is the whole rule — nobody was added by hand for being famous, and
      nobody was dropped for being unfamiliar.</p>
  </section>
</WikiTip>
