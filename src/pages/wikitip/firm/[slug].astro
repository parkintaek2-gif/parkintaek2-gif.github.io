---
/**
 * K Culture Wire — **회사 한 곳이 어디까지 갔나.** (`/firm/<slug>`)
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **파는 것을 다 내주지 않는다.** 여기까지는 「어디까지 갔나」다.
 *    주별 자취·시장별 자리 표·안 오른 작품은 **여정표 한 장**에만 있다.
 *    ⚠ 감추는 것이 아니라 **무엇이 더 있는지 화면에 적는다.**
 * ⛔ **회사끼리 줄세우지 않는다.** 이 지면은 그 회사 것만 담는다. 여덟 곳은 이름 차례다.
 * ⛔ **취향을 평가하지 않는다.** 「좋은 작품」이라 안 쓴다. 다닌 자취만 적는다.
 * ⛔ 광고 자리를 만들지 않았다. Riot Production(App 866800) 승인 전이다.
 * ⚠ 수를 손으로 적지 않는다. 전부 `wikitip-firm-pages.json` 에서 읽는다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-firm-pages.json';
import 작품표 from '../../../data/wikitip-title-pages.json';

export function getStaticPaths() {
  return data.firms.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;

/**
 * 🔴🔴 [2026-08-27 21:4x · 5번] **작품 이름이 글자로만 있었다.**
 *
 *   오늘 22:00 실측에서 걸음이 1.24 였다(체류시간은 곧 걸음이다). 그래서
 *   「다음 걸음이 얼마나 아래에 있나」를 재는 자를 세웠더니 —
 *   **이 갈래 열아홉 장 전부, 첫 안쪽 링크가 지면의 81.9% 지점**이었다.
 *   평균 체류 35초짜리 손님은 거기까지 못 내려간다. 있어도 없는 것과 같다.
 *
 *   그런데 이 지면 한가운데 표에 작품 이름이 **다섯 개나 있었고**, 그 작품 지면이
 *   556장 이미 나 있는데 **글자로만** 놓여 있었다. 잇기만 하면 문이 표 자리로 올라온다.
 *
 * ⛔ 지면이 «있는» 작품만 링크한다 — 얇은 작품은 일부러 지면을 안 낸다(417편).
 *   없는 곳에 걸면 죽은 링크가 되고, 죽은 링크는 안 거느니만 못하다.
 * ⚠ 이름으로 맞춘다. 철자가 다른 같은 작품은 못 맞추고 그건 글자로 남는다(지어내지 않는다).
 */
const 작품길 = new Map(
  (작품표.titles ?? []).filter((t: any) => t.hasPage).map((t: any) => [t.title, t.slug]),
);

/*
 * 🔴 [2026-08-29 · 5번] **제목이 「its titles on Netflix」였다. 아무도 그렇게 안 친다.**
 *   잰 수요 — `studio dragon dramas` 자동완성 1번째 · 제안 10줄.
 *   열아홉 장 전부 그 말이 제목에 «없어서» 답할 자리가 없는 것으로 세어졌다.
 *   ⭐ 자료는 이미 있었다. 제목이 손님 말이 아니었을 뿐이다.
 *
 * ⛔ 낱말을 손으로 안 고른다. 「dramas」·「movies」는 그 회사 작품의 «갈래를 세어» 정한다 —
 *   Showbox 에 「dramas」라 달면 틀린 말이고, 틀린 제목은 안 단 것보다 나쁘다.
 * ⚠ 갈래를 하나도 못 맞추면 예전 말(its titles)로 돌아간다. 지어내지 않는다.
 */
/**
 * 그 회사가 «크레딧에 붙은 작품 전부»의 갈래를 센다.
 * ⛔ 지면 표에 보이는 다섯 편으로 세면 안 된다 — 다섯은 자리가 넓은 순 상위라
 *   회사의 성격이 아니라 그 회사의 «히트작 성격»을 말하게 된다.
 * ⚠ 이름으로 맞춘다. 못 맞춘 작품은 세지 않는다 — 0 으로 채우지 않는다.
 */
const 회사갈래 = (() => {
  let tv = 0; let film = 0; let 방송 = false;
  for (const t of (작품표.titles ?? []) as any[]) {
    const 붙음 = (t.firms ?? []).find((x: any) => x.firm === f.firm);
    if (!붙음) continue;
    if ((붙음.roles ?? []).includes('첫방송')) 방송 = true;
    if (t.type === 'TV') tv += 1;
    else if (t.type === 'Films') film += 1;
  }
  return { tv, film, 방송 };
})();
/**
 * ⭐ 방송사가 «첫방송» 자격으로 붙어 있으면 그곳은 방송을 내보내는 곳이다 — dramas.
 *   이건 세어 본 비율보다 센 증거다(KBS·MBC·SBS·tvN·JTBC 가 여기서 갈린다).
 * ⛔ 「거의 다」의 선은 4/5. 그 아래면 둘 다 적는다 — 한쪽만 적으면 나머지를 숨기는 것이다.
 */
const 낱말 = (() => {
  const 다 = 회사갈래.tv + 회사갈래.film;
  if (!다) return null;                                   /* 못 쟀다 — 예전 말로 */
  if (회사갈래.방송 && 회사갈래.tv >= 회사갈래.film) return 'dramas';
  if (회사갈래.tv / 다 >= 0.8) return 'dramas';
  if (회사갈래.film / 다 >= 0.8) return 'movies';
  return 'dramas and movies';
})();
const TITLE = 낱말 ? `${f.firm} ${낱말} on Netflix` : `${f.firm} — its titles on Netflix`;
/* 🔴 [2026-08-27 · 5번] 열아홉 장 다 설명이 175자쯤이라 잘리고 있었다.
   ⛔ 뺀 말(가장 넓게 퍼진 주에 몇 나라였나)은 본문에 그대로 있다 — 재고 뺐다. */
const DESC =
  `${f.titlesThatCharted} of its titles reached a Netflix country top 10 in `
  + `${f.markets} markets over ${f.weeks} weeks, taking `
  + `${f.places.toLocaleString('en-US')} chart places. Every title and market listed.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://www.wikidata.org'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical={`https://www.kculturewire.com/firm/${f.slug}`}>
  <h1>{TITLE}</h1>
  {/* 🔴 [2026-08-27] 첫 안쪽 링크가 지면의 81.9% 지점에 있었다 — 35초 손님은 못 본다.
      표의 작품 이름을 이으니 45.2% 로 올라왔고, 여기 한 줄을 더해 첫 화면으로 끌어올린다.
      ⛔ 링크를 «채워 넣는» 것이 아니다. 손님이 이 지면에서 다음으로 궁금해할 것이
        「그래서 어느 나라냐」와 「다른 회사는」이라, 그 둘로만 낸다. */}
  <p class="lead">
    Netflix gives a supplier global hours. It does not give countries. This page is the country
    column for {f.firm}, counted from the weekly lists Netflix publishes for each market —
    {' '}<a href="/by-country">the same count for every country</a> is here, and
    {' '}<a href="/for-industry">every company we hold</a> is here.
  </p>

  <section>
    <h2>How far these titles went</h2>
    <div class="scroll-x">
      <table>
        <tbody>
          <tr><td class="nm">Titles Wikidata attaches to this company</td><td class="tot">{f.titlesInCatalogue}</td></tr>
          <tr class="edge"><td class="nm">Of those, titles that reached a country top 10</td>
            <td class="tot">{f.titlesThatCharted}</td></tr>
          <tr><td class="nm">Markets reached</td><td class="tot">{f.markets}</td></tr>
          <tr><td class="nm">Weeks with at least one title on a chart</td><td class="tot">{f.weeks}</td></tr>
          <tr><td class="nm">Chart places taken</td><td class="tot">{f.places.toLocaleString('en-US')}</td></tr>
          <tr class="edge"><td class="nm">Most countries holding one of them in the same week</td>
            <td class="tot">{f.widestWeekCountries} — week of {f.widestWeek}</td></tr>
          <tr><td class="nm">Market with the most places</td>
            <td class="tot">{f.topMarket} ({f.topMarketPlaces})</td></tr>
          <tr><td class="nm">Weeks of Netflix country charts read</td><td class="tot">{data.weeksSpanned}</td></tr>
          <tr><td class="nm">Chart rows read to build this</td><td class="tot">{data.rowsRead.toLocaleString('en-US')}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      <b>A place is one title, in one country, in one week.</b> A title in three countries for four
      weeks takes twelve places. The last-but-one row is the one worth reading twice: reaching
      {' '}{f.markets} markets over five years and holding {f.widestWeekCountries} of them{' '}
      <em>at once</em> are different achievements, and only the second one is a launch.
    </p>
  </section>

  <section>
    <h2>The five that took the most places</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>Title</th><th>Markets</th><th>At once</th><th>Places</th><th>Best position</th></tr></thead>
        <tbody>
          {f.shown.map((t) => (
            <tr>
              <td class="nm">{작품길.has(t.title)
                ? <a href={`/title/${작품길.get(t.title)}`}>{t.title}</a>
                : t.title}</td>
              <td>{t.countries}</td>
              <td>{t.atOnce}</td>
              <td class="tot">{t.places}</td>
              <td>{t.peak}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <b>Ordered by places taken, not by quality.</b> Nothing on this page is a judgement about the
      titles — it is a record of where they were listed.
      {f.titlesNotShown > 0 && (
        <> <b>{f.titlesNotShown} more of this company's titles charted</b> and are not shown here.</>
      )}
    </p>
  </section>

  <section class="src">
    <h2>What is on this page, and what is not</h2>
    <ul>
      <li><b>Here</b> — {data.whatIsHere}</li>
      <li><b>Not here</b> — {data.whatIsNotHere}</li>
      <li>
        <b>Which companies have a sheet</b> — {data.whichCompanies} {data.whatIsMissing}
        {' '}<a href="/for-industry">All {data.pages} are listed here</a>.
      </li>
      <li>
        <b>Netflix and Wikidata</b> — {data.source} A company "covers" a title if Wikidata lists it as
        producer, first broadcaster or distributor, so a title can belong to more than one company.
      </li>
      <li>
        <b>Russia is excluded</b> throughout this site, because Netflix withdrew from it and the
        remaining weeks are not comparable with the others.
      </li>
    </ul>
    <p class="note">
      <a href="/for-industry">What a company sheet contains, and what it cannot tell you</a> ·{' '}
      <a href="/who-makes-it">How many companies fill half the shelf</a> ·{' '}
      <a href="/about">How we count</a>
    </p>
  </section>
</WikiTip>
