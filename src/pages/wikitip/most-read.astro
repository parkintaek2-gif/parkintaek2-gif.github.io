---
/**
 * K Culture Wire — **이번 달 세계가 실제로 읽고 있는 한국 스타.** (`/most-read`)
 *
 * ── 왜 이 지면이 생겼나 (2026-08-22) ──────────────────────────
 * 사장님: 「**스타 이름, 아이돌 그룹이름이 제일 많이 검색하지 않나?** 그중에서 **누가 검색이
 * 많은 지를 찾아서** 하면 사람들이 더 찾겠지… 온 사람들한테는 **잊지 못할 콘텐트와 커뮤니티**를
 * 주면 계속 재방문하겠지?」 그리고 그 앞에 — 「**키워드 검색량을 재서 해.**」
 *
 * ⛔ 그 전날 나는 «일간(日干)» 같은 자료의 말로 지면 열 장을 냈다. 재 보니
 *   「byeong day stem」은 자동완성에 **0줄**이었다 — 아무도 안 치는 말이었다.
 *   그래서 순서를 바꾼다. **먼저 재고, 많이 찾아지는 이름부터 낸다.**
 *
 * ── 이 지면이 무엇인가 · 무엇이 아닌가 ───────────────────────
 * ✅ 지난 30일 동안 영문 위키백과에서 **사람이 실제로 연 수**다(봇 제외).
 * ⛔ **검색량이 아니다.** 우리는 유료 검색량 자료가 없다. 그렇게 부르지 않는다.
 * ⛔ 인기·실력·수입의 순위가 아니다. 「읽힌 수」다.
 * ⭐ 달마다 다시 잰다 — **이 줄은 움직인다.** 그것이 다시 올 까닭이다.
 *
 * ⚠ 이름은 위키데이터 Q번호로 문서를 찾아 잰다. 「IU」로 짐작해 물었을 때는 1,264 가 나왔고
 *   실제 문서(IU (entertainer))로는 59,582 였다. 짐작한 제목으로 순위를 매기면 순위가 거짓이 된다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import KcwShorts from '../../components/KcwShorts.astro';
import RankBars from '../../components/RankBars.astro';
import d from '../../data/wikitip-star-demand.json';
import signs from '../../data/wikitip-star-signs.json';
import people from '../../data/wikitip-people.json';
import { 이름표만들기, 문 } from '../../lib/person-link';

/* 🔴 [2026-08-26] **가장 많이 읽힌 사람 목록인데 사람 지면으로 가는 문이 0개였다.**
   손님이 이름을 보고 더 알고 싶은 자리가 바로 여기다. ⛔ 겹친 이름은 안 건다. */
const { 표: 사람표 } = 이름표만들기(people.people ?? []);
/* ⚠ 줄마다 Map 을 객체로 바꾸면 수백 번 만든다 — 한 번만 만든다 */
const 사람문 = Object.fromEntries(사람표);

/**
 * 🔴 [2026-08-29 · 사장님 「띠 방 내려」] 띠 방 12장을 내렸으므로 이 칸도 뺐다.
 *   ⛔ 지면을 내리면서 그 지면을 «가리키는 칸»을 남기면 손님이 404 를 만난다.
 *   ⚠ 이름에서 이름으로 걷는 길은 남아 있다 — 왼쪽 이름이 사람 지면으로, 「same day」가
 *     생일 지면으로 간다. 방이 하던 일을 이 둘이 이미 하고 있었다.
 */

/**
 * 🔴 2026-08-22 15:2x — 라이브에 **한글 이름이 하나 나갔다**(「카리나」 73위).
 *   위키데이터에 영문 이름표가 없는 사람이라 한국어 이름표로 떨어진 것이다. 5번 손님은 영어권이다.
 * ⛔ 그렇다고 순위에서 빼지 않는다 — 그 사람은 실제로 73번째로 많이 읽혔다.
 * ✅ **영문 위키백과 문서 제목**이 이미 자료에 있다(Karina (South Korean singer)).
 *   괄호 설명만 떼고 그것을 쓴다. 지어낸 이름이 아니라 위키백과가 쓰는 이름이다.
 */
const 라틴 = (t: string) => /^[A-Za-z0-9À-ɏḀ-ỿ' .,\-()&+/]+$/.test(t);
const 보일이름 = (p: any) => (라틴(p.name) ? p.name
  : (p.enTitle ? String(p.enTitle).replace(/\s*\([^)]*\)\s*$/, '') : p.name));

const 줄 = (d.people ?? []).slice(0, 100);
const 창 = `${d.window.시작.slice(0, 4)}-${d.window.시작.slice(4, 6)}-${d.window.시작.slice(6)} → ${d.window.끝.slice(0, 4)}-${d.window.끝.slice(4, 6)}-${d.window.끝.slice(6)}`;
const 합 = 줄.reduce((a, p: any) => a + p.reads, 0);
const 으뜸 = 줄[0] as any;
const 셋 = 줄.slice(0, 3).map((p: any) => 보일이름(p)).join(', ');

/**
 * 🔴 [2026-09-01 · 사장님 지시] 「**공격적으로** 콘텐트를 기획, 생산, 배포하라」
 *   「사람들의 관심을 갖는 순위를 다 찾아 공개해」 「그 순위가 의미가 있는 지 생각해보게 해」
 *   「콘텐트 제목도 사람들의 이목을 끌어 클릭할 수 있게 만들어, **그래프**도 만들고,
 *    그 안에서 우리가 하고 싶은 얘기를 해, **데이터로**… **댓글**을 달 수 있게 해」
 *   「**공격적으로 대학명을 제목에 기재해**」 ⇒ 우리 쪽에서는 **사람 이름**이다.
 *
 * ⚠ 전 제목은 `The 100 most-read Korean stars right now — A, B, C lead` 였다. 이름은
 *   들어 있었지만 «모순»이 없어서 누를 까닭이 없었다. 3번이 승인받은 문체가 본보기다 —
 *   「서울대학교가 종합 1위인데, 취업률은 성균관대학교보다 낮습니다」. 실명 + 수치 + 모순.
 *
 * ⭐ 우리 자료에 있는 모순 — **언어 폭과 영문 열람이 서로 어긋난다.**
 *   가장 많이 읽힌 사람이 위키백과 언어 수는 «적고», 언어 수가 가장 많은 사람은 아래에 있다.
 * ⛔ 이 모순을 «내가 정한 결론»으로 쓰지 않는다. 두 수를 나란히 놓고 「이 순위가 뜻이 있나」를
 *   되묻는다(강령② 평균이 아니라 분포 · 우리가 바늘을 세우지 않는다).
 *
 * ⚠ 자료는 달마다 다시 잰다. 그러니 제목을 **글자로 박지 않고 자료에서 만든다** —
 *   모순이 사라진 달에는 저절로 옛 제목으로 돌아간다. ⛔ 거짓이 된 제목이 남지 않게.
 * ⛔ 사람의 성별을 우리 자료가 담고 있지 않다 — 제목·본문에 he/she 를 쓰지 않는다.
 */
const 위30 = 줄.slice(0, 30) as any[];
const 언어넓은이 = 위30.reduce((a, p) => (p.sitelinks > a.sitelinks ? p : a), 위30[0]);
/* 모순이 성립하는 조건 — 으뜸이 더 많이 읽혔는데 언어 수는 더 «적다» */
const 모순있나 = !!언어넓은이 && 언어넓은이.q !== 으뜸.q
  && 으뜸.reads > 언어넓은이.reads && 으뜸.sitelinks < 언어넓은이.sitelinks;
const 배수 = 모순있나 ? 으뜸.reads / 언어넓은이.reads : 0;
const 배수말 = 배수 >= 10 ? Math.round(배수).toString() : 배수.toFixed(1);

const TITLE = 모순있나
  ? `${보일이름(으뜸)} outreads ${보일이름(언어넓은이)} ${배수말} to 1 in English — ${으뜸.sitelinks} Wikipedias against ${언어넓은이.sitelinks}`
  : `The 100 most-read Korean stars right now — ${셋} lead`;
const DESC = 모순있나
  ? `${d.measured.toLocaleString('en-US')} Korean actors and singers, ranked by who the English-reading world actually opened an article about. ${보일이름(으뜸)} leads with ${으뜸.reads.toLocaleString('en-US')} readers in thirty days while carrying an article in only ${으뜸.sitelinks} languages; ${보일이름(언어넓은이)} carries ${언어넓은이.sitelinks} and sits at ${위30.indexOf(언어넓은이) + 1}. Reads, not searches — and we ask on the page whether this ranking means anything at all.`
  : `Who the world actually opened an article about in the last 30 days: ${d.measured.toLocaleString('en-US')} Korean actors and singers measured, ${보일이름(으뜸)} first with ${으뜸.reads.toLocaleString('en-US')} readers. Reads, not searches, and we say which is which.`;

/* 그래프에 쓸 스무 줄 — ⛔ 두 그림 다 «읽힌 수 순서»를 지킨다.
   언어 수 그림을 언어 수로 다시 줄 세우면 어긋남이 안 보인다. 그것이 이 지면의 알맹이다. */
const 스무줄 = 줄.slice(0, 20) as any[];
const 읽힌막대 = 스무줄.map((p) => ({ name: 보일이름(p), value: p.reads, href: 문(보일이름(p), 사람문) }));
const 언어막대 = 스무줄.map((p) => ({ name: 보일이름(p), value: p.sitelinks }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/', 'https://www.wikidata.org/'],
  temporalCoverage: 창,
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/most-read">
  <h1>{TITLE}</h1>
  <p class="lead">
    {d.measured.toLocaleString('en-US')} Korean actors, singers and songwriters, each one measured by
    how many people opened their English Wikipedia article between {창}. The top hundred are here.
  </p>

  <section class="warn-box">
    <h2>Read this first — these are readers, not searches</h2>
    <p class="warn">
      This counts people who opened an article. It is not a search-volume figure, and we do not have
      one: paid keyword data is not something we buy. It is also not a ranking of talent, income or
      chart position. It is the size of attention, measured the same way for everyone.
    </p>
    <p class="note">
      Titles are resolved from Wikidata rather than guessed. Guessing cost us once: asking for “IU”
      returned 1,264 readers, while her actual article returned {(줄.find((p: any) => p.name === 'IU') as any)?.reads?.toLocaleString('en-US') ?? '59,582'}.
      A ranking built on guessed titles is a false ranking.
    </p>
  </section>

  {/*
    ⭐ [2026-09-01 · 사장님 「그래프도 만들고」] 이 순위 지면에는 표 백 줄만 있고 그림이
      하나도 없었다. 표는 훑어야 모양이 보이고, 막대는 한눈에 보인다.
    ⛔ 두 자를 «한 그림에 두 축»으로 겹치지 않는다 — 눈금이 다른 것을 한 축에 얹으면
      없는 관계가 보인다. 그림을 둘로 나누고, 줄 순서를 «같게» 두어 어긋남이 드러나게 한다.
  */}
  <section>
    <h2>The top twenty, drawn</h2>
    <RankBars rows={읽힌막대} valueLabel="readers in 30 days" tone="a"
      caption={`Readers who opened the English Wikipedia article, ${창}. Sorted by this bar.`} />

    <h3>Now the same twenty people, measured with a different ruler</h3>
    <RankBars rows={언어막대} valueLabel="Wikipedia language editions" tone="b" numbered={true}
      caption="How many language editions of Wikipedia carry an article about them. ⚠ Still in the order above — sorted by readers, not by this bar. The raggedness is the point: the two rulers disagree." />

    {모순있나 && (
      <p class="note">
        Read the two together. {보일이름(으뜸)} is opened {으뜸.reads.toLocaleString('en-US')} times
        in thirty days while carrying an article in {으뜸.sitelinks} languages.
        {' '}{보일이름(언어넓은이)} carries {언어넓은이.sitelinks} — the widest in this top thirty —
        and is opened {언어넓은이.reads.toLocaleString('en-US')} times, which is
        {' '}{배수말} times fewer. Breadth across languages and readership in English are
        not the same quantity, and nothing here says which one is fame.
      </p>
    )}
  </section>

  <section>
    <h2>The hundred</h2>
    <p class="note">
      Between them, {합.toLocaleString('en-US')} readers in thirty days. We re-measure every month,
      so this order moves — that is the point of keeping it.
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>#</th><th>Name</th><th>Readers, 30 days</th><th>Born</th><th>Who shares this birthday</th></tr>
        </thead>
        <tbody>
          {줄.map((p: any, i: number) => (
            <tr>
              <td class="fine">{i + 1}</td>
              <td class="nm">{문(보일이름(p), 사람문)
                ? <a href={문(보일이름(p), 사람문)}>{보일이름(p)}</a> : 보일이름(p)}</td>
              <td>{p.reads.toLocaleString('en-US')}</td>
              <td class="fine">{p.born}</td>
              <td class="fine"><a href={`/born-on/${String(p.born).slice(5)}`}>same day</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>What this cannot tell you</h2>
    <p class="note">
      An English Wikipedia article is not the whole world. Someone read mostly in Indonesian or
      Vietnamese is under-counted here — we publish that other axis separately, and the two disagree
      more often than you would think.
    </p>
    <p class="note">
      Where Wikidata carries no English label for a person, we show the title of their English
      Wikipedia article instead (Karina, Winter, Kai). That is the name Wikipedia uses, not one we
      invented, and nobody is dropped from the ranking for it.
    </p>
    <p class="note">
      A name with no English article cannot appear at all. {(d.measured - 줄.length).toLocaleString('en-US')} more
      people were measured and are not shown on this page; nobody was recorded as zero for want of a
      measurement.
    </p>
    {/*
      🔴 2026-08-22 — 자(`check-data-keys-shown`)를 끝까지 돌려 보니 이 지면이 **못 잰 사람 수를
         세어 두고 손님에게 안 보여** 주고 있었다. 오늘 내가 낸 지면이다.
         ⭐ 지금 그 수는 0 이다. **0 이라는 것도 보여 줄 값이다** — 안 보여 주면 손님은
           우리가 몇 명을 조용히 버렸는지 알 길이 없다. 0 이 아니게 되는 날에는 더 그렇다.
    */}
    <p class="note">
      <b>How many we could not measure: {d.unmeasured.toLocaleString('en-US')}</b> of
      {' '}{d.measured.toLocaleString('en-US')}.
      {d.unmeasured === 0
        ? ' Every person in the roster returned a reader count, so nothing here is standing in for a missing number.'
        : ` Those are people whose article could not be resolved${(d.unmeasuredExamples ?? []).length ? ` — for example ${(d.unmeasuredExamples ?? []).slice(0, 3).join(', ')}` : ''}. They are absent, not zero.`}
    </p>
  </section>

  <section class="src">
    <h2>How this was counted</h2>
    <ul>
      <li><b>Source</b> — {d.whatThisIs}</li>
      <li><b>Not this</b> — {d.whatThisIsNot}</li>
      <li><b>Window</b> — {창} (human traffic only, bots excluded by the API)</li>
      <li><b>Roster</b> — Korean citizens with an entertainment occupation on Wikidata and at least {d.minSitelinks} Wikipedia editions</li>
    </ul>
    <p class="note">
      <a href="/community">The twelve birth-year rooms</a> ·{' '}
      <a href="/day-pillar">The birth-day count</a> ·{' '}
      <a href="/star-signs">Whether a birth year predicts any of this (it does not)</a>
    </p>
  </section>

  {/*
    ⭐ [2026-09-01 · 사장님] 「사람들이 관심이 많은 모든 것에 대해 순위를 매겨…
      **그 순위가 의미가 있는 지 생각해보게 해**」 「거기에 **댓글**을 달 수 있게 해」
    ⛔ 우리가 답을 정해 두지 않는다. 어느 쪽도 「맞다」고 안 쓴다 — 우리는 지형을 그리고
      바늘은 보는 사람이 세운다(모토와 철학 ①).
    ⚠ `data-comments-page` 는 이 지면 주소와 «같아야» 한다. 다르면 남의 방에 글이 쌓인다.
  */}
  <section class="ask">
    <h2>Does this ranking mean anything?</h2>
    <p>
      Here is the case against it. This counts English Wikipedia. A name read mostly in
      Indonesian, Vietnamese or Spanish is undercounted, and a name carried in
      {' '}{언어넓은이 ? 언어넓은이.sitelinks : 80} language editions can still sit below one carried in
      {' '}{으뜸.sitelinks}. A single drama airing this month moves a name hundreds of places.
      By this ruler, the biggest Korean star is whoever the English-reading room happened to
      look up in the last thirty days.
    </p>
    <p>
      Here is the case for it. It is the same measurement applied to every name, it is not
      bought, not modelled and not voted on, and it is re-taken every month so you can watch it
      move. Nobody is scored on talent and nobody is left out for being unpopular.
    </p>
    <p>
      <b>So: is a ranking like this worth publishing, or does it just tell people who to
      look at next?</b> We are not going to settle that for you — but we would rather argue
      about it in the open than quietly print a number.
    </p>
    <h2 class="cm">What do you think?</h2>
    <script src="/comments-widget.js" defer></script>
    <div data-comments-page="/most-read"></div>
    <p class="fine">
      No cookie, no IP, no third-party tracker &mdash; we built this ourselves.
    </p>
  </section>

  <KcwShorts set="transfer-voiced" says={`Fourteen seconds, read aloud: Crash Landing on You had one hundred thirty one thousand reads on its biggest day and Hyun Bin took thirty four point two percent of that. Parasite had two point seven million and Song Kang-ho took three point nine. Across twelve Korean breakouts the bigger the title, the smaller the share reaching any one actor — but these twelve are titles we picked because we knew they broke out, so this is a pattern inside a list of winners, not a law.`} />

  <KcwRelatedArticles page="/most-read" />
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: 0.5rem 1rem; }
</style>
