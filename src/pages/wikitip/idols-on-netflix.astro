---
/**
 * K Culture Wire — **아이돌 281명 중 넷플릭스 상위권에 나온 사람은 36명뿐이다.** (`/idols-on-netflix`)
 *
 * 🔴🔴 [2026-10-04 · 5번] 사장님 — 「**방문자를 빨리 만들고 늘려**」
 *   KLifeMap 에 사주·별자리 지면이 있는 사람이 281명인데, 그중 **245명**은 KCW 에
 *   사람 지면이 없어 «바깥에서 들어오는 길»이 하나도 없다. 그것이 KLifeMap 이
 *   구글 색인을 못 받는 자리다.
 *
 * ⭐ 그런데 그 「36명뿐」이라는 수 자체가 셀 만한 것이다. 아이돌이 연기로 건너오는 일이
 *   흔해 보이지만 재 보면 여덟에 하나다. 그 수를 싣고, 그 김에 245명에게 길을 낸다.
 *   ⛔ 링크만 모은 지면은 만들지 않는다. 구글도 사람도 안 읽는다.
 *
 * ⛔ 「아이돌은 연기를 못 한다」고 말하지 않는다. 우리가 잰 것은 **넷플릭스 주간 상위권에
 *   오른 작품의 출연진 명단에 그 이름이 있었나**뿐이다. 연기 활동 전체가 아니다.
 * ⛔ 281명은 우리가 생일을 찾을 수 있었던 사람이지 아이돌 전체가 아니다.
 * ⛔ 읽힘을 인기로 팔지 않는다 · Q번호를 이름인 척 싣지 않는다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 **TypeScript 다.** JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwMethodLimits from '../../components/KcwMethodLimits.astro';
import d from '../../data/kcw-idol-vs-netflix.json';

const 수 = d.수;
const 몫 = ((수.넷플릭스에도 / 수.아이돌) * 100).toFixed(1);

/* 큰 그룹부터 — 사람이 둘 이상인 그룹만 표에 싣는다(한 명짜리는 49개라 표가 길어진다) */
const 큰그룹 = d.그룹.filter((g) => g.수 >= 5).slice(0, 12);

/* 넷플릭스에도 나온 36명 — 이름 차례로 */
const 건너온사람 = d.사람들.filter((p) => p.넷플릭스지면)
  .sort((a, b) => String(a.이름).localeCompare(String(b.이름), 'ko'));

/* 사주 지면이 있는 사람만 링크를 건다. ⛔ 없는 사람은 이름만 — 404 로 보내지 않는다 */
const 사주있는사람 = d.사람들.filter((p) => p.사주)
  .sort((a, b) => String(a.이름).localeCompare(String(b.이름), 'ko'));

const TITLE = `${수.아이돌} K-pop idols have a birth chart on file. `
  + `${수.넷플릭스에도} of them turn up in a Netflix top-10 cast`;
const DESC =
  `We matched ${수.아이돌} K-pop idols whose birth dates are public against the cast lists of `
  + `every Korean title that reached a weekly Netflix top 10. ${수.넷플릭스에도} names appear on `
  + `both lists — ${몫} percent. Of the ${수.그룹} groups those idols belong to, `
  + `${수.한명도없는그룹} have nobody in a top-10 cast at all.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.wikidata.org/', 'https://www.netflix.com/tudum/top10'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/idols-on-netflix">
  <h1>{TITLE}</h1>

  <p class="lead">
    Idols moving into acting looks common. We counted it.
  </p>

  <p class="q">
    We hold birth dates for <b>{수.아이돌}</b> K-pop idols. Separately we hold the cast lists of
    every Korean title that reached a weekly Netflix top 10 anywhere. Matching the two by
    Wikidata id, <b>{수.넷플릭스에도}</b> names sit on both — <b>{몫}%</b>.
    {/* 🔴 [2026-10-04] 처음에 `수.안겹침` 으로 적었다 — 자료의 열쇠는 `넷플릭스에없음` 이다.
        화면에 「The other appear in neither…」로 **숫자가 통째로 빠져** 나갔다.
        ⛔ Astro 는 없는 열쇠를 말없이 빈 글자로 그린다. 그려서 눈으로 봤기에 잡혔다.
        ⚠ 그리고 JSX 는 주석 앞뒤의 끝 공백을 버린다 — 「12.8%.The other」로 붙어 나왔다.
          붙어야 할 자리가 아니면 {' '} 를 넣는다. */}
    {' '}The other <b>{수.넷플릭스에없음}</b> appear in neither cast list we hold.
  </p>

  <h2>Groups</h2>
  <p>
    Those {수.아이돌} idols belong to <b>{수.그룹}</b> groups. Of those,
    {' '}<b>{수.한명도없는그룹}</b> have nobody at all in a top-10 cast.
    Here are the larger groups, with how many of their members we matched:
  </p>

  <table>
    <thead>
      <tr><th>Group</th><th>Idols on file</th><th>In a Netflix top-10 cast</th></tr>
    </thead>
    <tbody>
      {큰그룹.map((g) => (
        <tr>
          <td>{g.그룹}</td>
          <td>{g.수}</td>
          <td>{g.넷플릭스}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>The {수.넷플릭스에도} on both lists</h2>
  <ul>
    {건너온사람.map((p) => (
      <li>
        {p.이름}
        {p.그룹.length > 0 && <span class="fine">{' '}&mdash; {p.그룹.join(', ')}</span>}
      </li>
    ))}
  </ul>

  <KcwMethodLimits
    items={[
      'This counts cast lists, not acting careers. A drama that never reached a weekly Netflix top 10 is not in our data, and neither is film, stage or a cameo that the cast list omits.',
      `The ${수.아이돌} idols are the ones whose birth dates we could find on Wikidata. That is not every idol.`,
      'Matching is by Wikidata id, never by name. Two people with the same stage name are two rows.',
      'A group with nobody in a top-10 cast may still have members acting. It means we found no match in the lists we hold.',
    ]}
  />

  <h2>Birth charts for all {사주있는사람.length}</h2>
  <p>
    The birth dates behind this count come from the same place we use to draw charts.
    Each name below opens its four-pillars reading on
    {' '}<a href="https://klifemap.ai/saju.html?lang=en" rel="noopener">KLifeMap.AI</a>, a separate
    site we also run. Free, no sign-up.
  </p>
  <ul class="charts">
    {사주있는사람.map((p) => (
      <li>
        <a href={p.사주} rel="noopener">{p.이름}</a>
        {p.별자리 && <span class="fine">{' '}(<a href={p.별자리} rel="noopener">signs</a>)</span>}
      </li>
    ))}
  </ul>

  <p class="fine tail">
    Counted {d._meta.잰때}. Idol list and birth dates from Wikidata; cast lists from the weekly
    Netflix top 10. We report what we counted and attach no reason to it.
  </p>
</WikiTip>

<style>
  .fine { opacity: .75; font-size: .9em; }
  .charts { columns: 2; }
  @media (max-width: 640px) { .charts { columns: 1; } }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid rgba(128,128,128,.25); }
</style>
