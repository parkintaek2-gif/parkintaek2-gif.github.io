---
/*
 * person/[person].astro — **사람 한 명** (`/person/lee-you-mi`). 636장이 여기서 나온다.
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 2026-08-25, 사장님 지시 —
 *   「인기 검색어도 찾아야지. **특히 케이컬쳐는 스타의 이름**, 작품명, 노래제목 등이겠지..
 *    그게 **제목, 본문 중 위, 가운데, 마지막**에 나와야 하겠지」
 *
 * 그날 `check-name-placement.mjs` 로 재니 작품 이름은 네 자리에 다 있었는데(4/4)
 * 사람 이름은 1/4~3/4 였고, 더 큰 것은 **사람이 주인공인 지면이 0장**이라는 것이었다.
 * 작품은 `/title/{작품}` 556장이 있는데 사람은 표 안의 «한 줄»로만 있었다.
 *
 * ── 지면 이름을 «재서» 정했다 ─────────────────────────────────
 * 배우 14명 × 다섯 꼴을 자동완성으로 재서 가지 수를 셌다 —
 *   age 51 · movies and tv shows 45 · netflix 44 · tv shows 24 · drama list 22
 * ⚠ `age` 가 가장 컸지만 그 답은 구글이 지식패널로 **즉시** 준다. 우리가 이길 자리가 아니다.
 * ⭐ 우리만 가진 것은 **「그 작품이 어느 나라까지 갔나」**다. 그래서 제목의 축을
 *   `movies and tv shows` + `netflix` 로 두었다.
 *
 * ── ⛔ 이 지면이 반드시 지키는 것 ─────────────────────────────
 * ⛔ **「필모그래피」라고 안 쓴다.** 여기 있는 것은 «넷플릭스 주간 톱10에 오른 한국 작품
 *   중 우리가 지면을 낸 것»뿐이다. 그 사람의 출연작은 이보다 훨씬 많다. 밑바닥이지 총합이 아니다.
 * ⛔ **나이를 혼자 안 적는다.** 태어난 날과 기준일을 같이 적어야 지면이 낡아도 고쳐 읽는다.
 * ⛔ 생일을 모르면 **모른다고 적는다.** 빈칸이나 0 으로 채우지 않는다.
 * ⛔ **줄세우지 않는다** — 「누가 더 인기 있나」를 말하지 않는다. 자리 수를 적을 뿐이다.
 * ⛔ 같은 이름의 다른 사람이 있으면 **화면에 적는다.** 안 적으면 손님이 섞어 읽는다.
 * ⛔ 위키백과 조회수를 「우리 손님 수」로 읽지 않는다 — 그 «이름에 대한 관심»이다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-people.json';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다. 자료는 여기서 읽고
     지면이 쓸 것은 전부 props 로 건넨다 */
  const 사람들 = data.people ?? [];
  const 자리 = new Map(사람들.map((p: any) => [p.slug, p]));
  return 사람들.map((p: any, i: number) => ({
    params: { person: p.slug },
    props: {
      p,
      이웃: [사람들[(i + 1) % 사람들.length], 사람들[(i + 2) % 사람들.length]]
        .filter((x: any) => x && x.slug !== p.slug),
      멀리간사람: 사람들.slice(0, 6).filter((x: any) => x.slug !== p.slug).slice(0, 4),
      /* 같은 이름의 다른 사람 — 있으면 그 사람 지면으로 보낸다. ⛔ 합치지 않는다 */
      동명이인: p.sameNameAs ? (자리.get(p.sameNameAs) ?? null) : null,
    },
  }));
}

const { p, 이웃, 멀리간사람, 동명이인 } = Astro.props as {
  p: any; 이웃: any[]; 멀리간사람: any[]; 동명이인: any;
};
const 수 = (n: number) => Number(n ?? 0).toLocaleString('en-US');
const 기준일 = data.asOf;

/* 🔴 사장님이 말씀하신 «네 자리». 이름은 제목·위·가운데·끝에 다 있어야 한다.
   ⛔ 억지로 끼워 넣지 않는다 — 지면이 실제로 그 사람을 다루므로 자연스럽게 넣는다 */
const TITLE = `${p.name} movies and TV shows: every Netflix chart run, country by country`;
const DESC = `${p.name} appears in ${p.titleCount} Korean titles that reached a Netflix weekly top 10. `
  + `Together they took ${수(p.places)} chart places across ${p.countries} countries. `
  + `A floor, not a filmography.`;

const 가장멀리 = p.titles[0] ?? null;
const 가장오래 = [...p.titles].sort((a: any, b: any) => (b.weeks ?? 0) - (a.weeks ?? 0))[0] ?? null;
const 처음 = [...p.titles].sort((a: any, b: any) => String(a.firstWeek).localeCompare(String(b.firstWeek)))[0] ?? null;
const 최고 = [...p.titles].sort((a: any, b: any) => (a.peak ?? 99) - (b.peak ?? 99))[0] ?? null;
const 드라마 = p.titles.filter((t: any) => t.type === 'TV').length;
const 영화 = p.titles.length - 드라마;

const 생일글 = p.born
  ? `${p.name} was born on ${p.born}, which makes ${p.name} ${p.age} on ${기준일}.`
  : (p.bornUnknownWhy === 'ambiguous'
    ? `We cannot give a birthday for ${p.name}. Wikidata holds more than one person under this romanised name and we will not guess which one this is.`
    : `Wikidata does not record a birth date for ${p.name}, so we do not print one. An empty cell is an answer too.`);
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/person/${p.slug}`}>
  <h1>{p.name}: movies and TV shows on the Netflix charts</h1>

  <p class="lead">
    <b>{p.name}</b> appears in <b>{p.titleCount}</b> Korean {p.titleCount === 1 ? 'title' : 'titles'}
    {드라마 > 0 && 영화 > 0 ? ` (${드라마} TV, ${영화} film)` : ''} that reached a Netflix weekly
    top 10 somewhere in the world. Together those titles took <b>{수(p.places)}</b> chart places
    in <b>{p.countries}</b> countries.
  </p>

  <p class="warn">
    <b>This is a floor, not a filmography.</b> It counts only Netflix top-10 charting titles that we
    have enough weekly data to publish a page for. {p.name} has other credits that are not here, and
    we cannot tell you how many.
  </p>

  {동명이인 && (
    <p class="warn">
      <b>There is more than one {p.name}.</b> This page is
      <b>{p.wikiPage}</b>. The other one is on
      <a href={`/person/${동명이인.slug}`}>a separate page</a> &mdash; we do not merge them, because
      they are different people who share a romanised name.
    </p>
  )}

  <section>
    <h2>Every {p.name} title that charted</h2>
    <p class="fine">
      Ordered by chart places. &ldquo;Places&rdquo; is how many country-week top-10 slots the title
      took. &ldquo;Peak&rdquo; is the best rank it reached anywhere. Each title links to its own page,
      where you can see the countries one by one.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th>Title</th><th>Kind</th><th class="n">Places</th><th class="n">Countries</th>
            <th class="n">Weeks</th><th class="n">Peak</th><th>First charted</th>
          </tr>
        </thead>
        <tbody>
          {p.titles.map((t: any) => (
            <tr>
              <td><a href={`/title/${t.slug}`}>{t.title}</a></td>
              <td>{t.type === 'TV' ? 'TV' : 'Film'}</td>
              <td class="n">{수(t.places)}</td>
              <td class="n">{수(t.markets)}</td>
              <td class="n">{수(t.weeks)}</td>
              <td class="n">{t.peak ?? '—'}</td>
              <td>{t.firstWeek ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>How far did {p.name} travel?</h2>
    <ul class="facts">
      {가장멀리 && (
        <li>
          Widest run: <a href={`/title/${가장멀리.slug}`}>{가장멀리.title}</a> &mdash;
          {' '}{수(가장멀리.places)} places in {수(가장멀리.markets)} countries.
        </li>
      )}
      {가장오래 && 가장오래.slug !== 가장멀리?.slug && (
        <li>
          Longest run: <a href={`/title/${가장오래.slug}`}>{가장오래.title}</a> &mdash;
          {' '}{수(가장오래.weeks)} weeks on a chart somewhere.
        </li>
      )}
      {최고 && (
        <li>
          Best rank: <b>#{최고.peak}</b>, reached by
          {' '}<a href={`/title/${최고.slug}`}>{최고.title}</a>.
        </li>
      )}
      {처음 && (
        <li>
          First time a {p.name} title charted: <b>{처음.firstWeek}</b>, with
          {' '}<a href={`/title/${처음.slug}`}>{처음.title}</a>.
        </li>
      )}
      <li>
        Countries reached across all {p.titleCount} titles: <b>{p.countries}</b>. Counted once each
        &mdash; two titles charting in Japan is still one country.
      </li>
    </ul>
  </section>

  <section>
    <h2>How old is {p.name}?</h2>
    <p>{생일글}</p>
    {p.born && (
      <p class="fine">
        We print the date as well as the number so this page still reads correctly after it goes
        stale. The age above is worked out for {기준일} and nothing else.
      </p>
    )}
    <p class="fine">
      Source: Wikidata birth date (P569). We do not hold a height, a blood type, or a relationship
      status for {p.name}, and we would rather say so than fill the cell.
    </p>
  </section>

  <section class="onward">
    <h3>Where to go next</h3>
    <ul class="walk">
      {p.titles.slice(0, 3).map((t: any) => (
        <li><a href={`/title/${t.slug}`}>{t.title} &mdash; country by country</a></li>
      ))}
      {이웃.map((n: any) => (
        <li><a href={`/person/${n.slug}`}>{n.name} &mdash; {n.titleCount} charting titles</a></li>
      ))}
      {멀리간사람.slice(0, 2).map((n: any) => (
        <li><a href={`/person/${n.slug}`}>{n.name} &mdash; {수(n.places)} chart places</a></li>
      ))}
      <li><a href="/person">Everyone we have a page for</a></li>
      <li><a href="/titles">Korean drama list &mdash; every title that reached a Netflix top 10</a></li>
      <li><a href="/born-on">Korean actors&rsquo; birthdays, day by day</a></li>
    </ul>
  </section>

  <p class="fine tail">
    Everything on this {p.name} page is counted from Netflix&rsquo;s published weekly country top 10s
    joined to Wikidata cast lists. It is a record of where {p.name}&rsquo;s work travelled, not a
    ranking of {p.name}. <b>This is a statistic, not a person.</b>
  </p>
</WikiTip>

<style>
  .warn { border-left: 3px solid #b45; padding-left: .8rem; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .93rem; }
  th, td { padding: .35rem .55rem; border-bottom: 1px solid #3332; text-align: left; }
  th.n, td.n { text-align: right; font-variant-numeric: tabular-nums; }
  .facts li { margin-bottom: .3rem; }
  .tail { margin-top: 2rem; }
</style>
