---
/**
 * K Culture Wire — **한국 연예 데스크가 이름을 쓴 사람들이 밖에서 찾아지나.** (`/newsdesk-abroad`)
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 *   우리가 매일 받는 신문제목 아카이브(소급 불가)를 처음으로 «열람수»와 붙였다.
 *   남이 못 내는 축이다 — 그날의 데스크 명단은 그날 안 받으면 영영 없다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ 제목 «본문»을 옮기지 않는다. 라이선스가 없다. 쓰는 것은 「이름이 거기 있었다」 하나다.
 * ⛔ 사람을 줄세워 「누가 더 유명한가」로 팔지 않는다. 갈래별 «1인당»을 나란히 놓는다.
 * ⛔ 합계만 내지 않는다 — 배우가 두 배로 많아서 합계가 두 배인 것을 합계로 감추면 거짓이 된다.
 * ⛔ 못 잰 둘을 한 칸에 넣지 않는다. 「문서가 없다」와 「그 사람인지 확인 못 했다」는 다른 것이다.
 * ⛔ 광고 자리를 만들지 않는다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/kcw-newsdesk-names-abroad.json';

/* ⛔ 지면에서 손으로 적지 않고 여기서 «센다» — 오늘 손으로 적은 합이 틀린 일이 있었다 */
const 잰것 = d.줄들.filter((r) => typeof r.합 === 'number').sort((a, b) => b.합 - a.합);
const 못잰것 = d.줄들.filter((r) => typeof r.합 !== 'number');
const 문서없음 = 못잰것.filter((r) => !r.문서);
const 확인못함 = 못잰것.filter((r) => r.문서);
const 제목합 = d.제목수.줄.reduce((a, b) => a + (b.받은수 ?? 0), 0);
const 쓸만한합 = d.제목수.줄.reduce((a, b) => a + (b.쓸만한수 ?? 0), 0);
const 갈래 = d.갈래별.filter((g) => g.문서있음 > 0).map((g) => ({
  ...g, 일인당: Math.round(g.열람합 / g.문서있음),
}));
const 배우 = 갈래.find((g) => g.갈래 === 'actor');
const 아이돌 = 갈래.find((g) => g.갈래 === 'k-pop');
const 합계배수 = 배우 && 아이돌 ? (배우.열람합 / 아이돌.열람합).toFixed(2) : null;
const 일인당배수 = 배우 && 아이돌 ? (배우.일인당 / 아이돌.일인당).toFixed(2) : null;
const 넘김있던것 = d.줄들.filter((r) => r.넘김);
const 갈래이름: Record<string, string> = {
  'actor': 'Actors', 'k-pop': 'K-pop', 'sport': 'Sport',
  'musician': 'Other musicians', 'tv': 'TV personality', '기타': 'Other',
};
const 수 = (n: number) => n.toLocaleString('en-US');

const TITLE = 'One day of a Korean entertainment desk, measured from outside Korea';
const DESC =
  `On ${d.아카이브날짜.slice(0, 4)}-${d.아카이브날짜.slice(4, 6)}-${d.아카이브날짜.slice(6, 8)} two Korean `
  + `entertainment desks published ${제목합} headlines naming ${d.요약.이름수 + d.못가른이름.length} people. `
  + `${잰것.length} have a verified English Wikipedia article; ${못잰것.length} do not. Actors outnumber idols `
  + `two to one in the copy, but per person the gap in lookups is only ${일인당배수} times.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: d.창,
  dateModified: d.아카이브날짜.replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3'),
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://wikimedia.org/api/rest_v1/'],
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/newsdesk-abroad">
  <h1>{TITLE}</h1>

  <p class="lead">
    We keep a daily copy of Korean press headlines, because a day's list of who the papers
    wrote about cannot be recovered later. This page takes one such day — the two
    entertainment desks in that capture — and asks a single question about every person
    they named: <strong>does the English-speaking world look them up at all?</strong>
  </p>

  <p class="note">
    No headline text is republished here. We hold no licence for Korean entertainment
    copy. The only fact taken from a headline is <em>which person was named</em>; everything
    counted below comes from our own archive and from public-domain Wikimedia data.
  </p>

  <h2>The day</h2>
  <table>
    <thead><tr><th>Outlet</th><th>Headlines captured</th><th>With something countable</th></tr></thead>
    <tbody>
      {d.제목수.줄.map((r) => (
        <tr>
          <td>{r.매체 === '스타뉴스' ? 'Star News' : r.매체 === '텐아시아' ? 'Ten Asia' : r.매체}</td>
          <td class="n">{r.받은수 == null ? 'not captured' : 수(r.받은수)}</td>
          <td class="n">{r.쓸만한수 == null ? 'not captured' : 수(r.쓸만한수)}</td>
        </tr>
      ))}
      <tr class="sum">
        <td>Both</td><td class="n">{수(제목합)}</td><td class="n">{수(쓸만한합)}</td>
      </tr>
    </tbody>
  </table>
  <p class="note">
    Those {쓸만한합} headlines name {d.요약.이름수 + d.못가른이름.length} people.
    {d.못가른이름.length === 1 ? 'One of them' : `${d.못가른이름.length} of them`} could not be
    tested at all and is listed at the bottom of this page.
  </p>

  <h2>Every name, and what it draws in English</h2>
  <p>Twelve-month window: {d.창}. All-access, user agents only.</p>
  <table>
    <thead><tr><th>#</th><th>Person named</th><th>English article</th><th class="n">Lookups</th></tr></thead>
    <tbody>
      {잰것.map((r, i) => (
        <tr>
          <td class="n">{i + 1}</td>
          <td>{r.후보}</td>
          <td><a href={`https://en.wikipedia.org/wiki/${r.문서}`} rel="nofollow noopener">{r.문서}</a></td>
          <td class="n"><strong>{수(r.합)}</strong></td>
        </tr>
      ))}
      {못잰것.map((r) => (
        <tr class="unmeasured">
          <td class="n">—</td>
          <td>{r.후보}</td>
          <td>{r.문서 ? r.문서 : 'no article found'}</td>
          <td class="n">{r.문서 ? 'not confirmed' : 'not measured'}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p>
    <strong>{수(d.요약.열람합)}</strong> lookups across {잰것.length} people.
    Median <strong>{수(d.요약.중간값)}</strong>. Largest to smallest of the measured list is{' '}
    <strong>{(d.요약.제일큼.합 / d.요약.제일작음.합).toFixed(1)} times</strong>.
  </p>

  <h2>The two we did not count are not the same kind of gap</h2>
  <ul class="gaps">
    {문서없음.map((r) => (
      <li>
        <strong>{r.후보}</strong> — no English Wikipedia article was found under any spelling we
        tried, and we searched twice rather than trusting one empty answer. As far as we can
        measure, this person does not exist in English.
      </li>
    ))}
    {확인못함.map((r) => (
      <li>
        <strong>{r.후보}</strong> — an article does exist, at <code>{r.문서}</code>, but it carries
        no Korea, K-pop or KBO category, so we could not confirm it describes the person the
        Korean desk wrote about. We publish it as unconfirmed rather than count a number we
        cannot vouch for.
      </li>
    ))}
  </ul>

  <h2>The copy tilts to actors two to one. Attention abroad barely tilts</h2>
  <table>
    <thead><tr><th>Kind</th><th class="n">Named</th><th class="n">Verified</th><th class="n">Lookups</th><th class="n">Per person</th></tr></thead>
    <tbody>
      {갈래.map((g) => (
        <tr>
          <td>{갈래이름[g.갈래] ?? g.갈래}</td>
          <td class="n">{g.사람}</td>
          <td class="n">{g.문서있음}</td>
          <td class="n">{수(g.열람합)}</td>
          <td class="n"><strong>{수(g.일인당)}</strong></td>
        </tr>
      ))}
    </tbody>
  </table>

  {배우 && 아이돌 && (
    <p>
      Actors are {(배우.사람 / 아이돌.사람).toFixed(0)} times as many names as idols in that day's
      copy, and their lookup total is <strong>{합계배수} times</strong> the idol total. Divide by
      the number of people and the gap is <strong>{일인당배수} times</strong> —
      {' '}{수(배우.일인당)} against {수(아이돌.일인당)}.
      <br />
      So the aggregate column is mostly headcount, not attention. Reading it alone would
      say Korean actors draw twice the foreign interest of Korean idols. On this day, by this
      count, they do not.
    </p>
  )}

  <h2>How each number was checked</h2>
  <ul class="method">
    <li>
      <strong>Redirects resolved before counting.</strong> A redirect returns only the people who
      typed that exact name, which can be a small fraction of the article's real traffic.
      {넘김있던것.length > 0 && (
        <span> Resolved here: {넘김있던것.map((r) => `${r.넘김}`).join(' · ')}.</span>
      )}
    </li>
    <li>
      <strong>Every resolved article had to prove it belongs to this subject</strong> before its
      number counted — a Korea, K-pop or KBO category. A redirect can land on a different
      human with the same romanisation, and a number appearing is not evidence it is the right
      number.
    </li>
    <li>
      🔴 <strong>That check first excluded a correct person.</strong> Written as "is this person
      South Korean", it threw out a Thai member of a Korean group. The axis here is the Korean
      entertainment desk, not nationality, so the test was widened and the whole run repeated.
    </li>
    <li>
      🔴 <strong>An empty cell had to earn its emptiness.</strong> Two names first returned nothing
      because our guessed article titles were wrong, not because the people were unfindable.
      Both were searched for and both then returned numbers.
    </li>
    <li>
      <strong>Nothing was filled with zero.</strong> Where the service refused us, we retried
      with backoff; what still did not arrive is printed as not measured.
    </li>
  </ul>

  {d.못가른이름.length > 0 && (
    <>
      <h2>⬜ Left out on purpose</h2>
      <ul class="gaps">
        {/* ⛔ 화면에 한글을 내지 않는다 — 로마자가 있으면 그것을 낸다.
            로마자를 모르면 이름을 «아예 안 내고» 까닭만 낸다. 지어내지 않는다.
            ⚠ 이 주석은 map «밖»에 둔다 — 화살표 함수가 바로 JSX 를 돌려줄 때
              그 안에 주석과 요소를 나란히 두면 컴파일러가 막는다(방금 겪었다). */}
        {d.못가른이름.map((r) => (
          <li>
            {r.로마자
              ? <><strong>{r.로마자}</strong> — </>
              : <><strong>One name</strong> — </>}
            {r.왜} Rather than pick one, we leave the name out and say so here.
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>What this does not tell you</h2>
  <p>
    Lookups count people who opened an encyclopedia page. They cannot separate a fan of ten
    years from someone who read a name in a headline five seconds earlier, and they are not
    records sold, tickets moved or fees paid.
  </p>
  <p>
    Our category check confirms an article is about a Korean-entertainment figure. It cannot
    confirm the article is about <em>the</em> person in the headline — several of these
    romanisations are shared by more than one Korean public figure.
  </p>
  <p>
    And this is one day of two outlets. A different day, or a desk covering film instead of
    television, would name a different set of people. <strong>The method is the durable part;
    the cast list is not.</strong>
  </p>

  <p class="src">
    Sources: our own Korean-press headline archive ({d.아카이브날짜}) and the
    {' '}<a href="https://wikimedia.org/api/rest_v1/" rel="nofollow noopener">Wikimedia Pageviews API</a>
    {' '}(public domain, CC0). Measured {d.잰때}. These are statistics, not you.
  </p>

  <KcwRelatedArticles page="/newsdesk-abroad" />
</WikiTip>

<style>
  h1 { font-size: clamp(1.6rem, 4.6vw, 2.3rem); line-height: 1.25; margin: 1.2rem 0 .8rem; letter-spacing: -.02em; }
  h2 { font-size: clamp(1.15rem, 3vw, 1.45rem); margin: 2.2rem 0 .7rem; line-height: 1.3; }
  .lead { font-size: 1.06rem; line-height: 1.65; }
  .note { color: var(--muted); font-size: .93rem; line-height: 1.6; border-left: 3px solid var(--line); padding-left: .8rem; }
  table { width: 100%; border-collapse: collapse; margin: .9rem 0 1.2rem; font-size: .95rem; display: block; overflow-x: auto; }
  th, td { padding: .48rem .6rem; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  th { font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; }
  td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
  tr.sum td { font-weight: 700; border-top: 2px solid var(--line); }
  tr.unmeasured td { color: var(--muted); font-style: italic; }
  ul.gaps, ul.method { padding-left: 1.1rem; }
  ul.gaps li, ul.method li { margin: .6rem 0; line-height: 1.6; }
  code { background: var(--line); padding: .05rem .3rem; border-radius: 3px; font-size: .9em; }
  .src { color: var(--muted); font-size: .87rem; line-height: 1.6; margin-top: 2rem; border-top: 1px solid var(--line); padding-top: .9rem; }
  a { color: var(--accent); }
</style>
