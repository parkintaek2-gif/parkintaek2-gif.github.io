---
/*
 * K Culture Wire — **어느 소속사가 제일 잘 벌었나.** (`/label-accounts`)
 *
 * ── 🔴 사장님이 이 지면을 보고 바로잡으셨다 (2026-09-10) ──────────────
 *
 * 사장님: 「kculturewire.com/label-accounts ...**케이컬쳐 유저들이 이런 내용은 잘 이해못한다.
 *        그냥 순위를 매기고, 뭔 지에 대해 점성학처럼 아주 쉽게 설명하는 게 필요해 보인다**」
 *
 * ⛔ 첫 판은 서울마켓츠 말투로 썼다 — operating profit · below the operating line ·
 *   trailing annual multiple · basis: Consolidated. 게다가 주석에 「등수를 매기지 않는다」고
 *   못박아 두기까지 했다. 그 규율은 «투자자 손님» 것이고, 여기 손님은 K팝을 보러 온 사람이다.
 * ⚠ 「정확하게 쓴다」와 「어렵게 쓴다」는 다른 일이다. 어려운 지면은 손님에게 아무 것도
 *   전하지 않으므로 «정확하지도 않다».
 *
 * ── ✅ 그래서 이 판이 하는 것 ─────────────────────────────────────────
 * ✅ 순위를 «매긴다» — 1위·2위·3위. 사장님이 「그냥 순위를 매기고」라고 하셨다
 * ✅ 용어가 나오면 «그 자리에서» 한 문장으로 푼다 (점성학 지면이 하는 방식)
 * ✅ 손님이 아는 것으로 견준다 — 소속 아티스트 수, 돈은 「한 명당」으로
 * ⛔ PER·연결/개별·후행 배수 같은 말을 «쓰지 않는다». 필요하면 서울마켓츠로 문을 낸다
 * ⛔ 그래도 «지어내지는» 않는다 — 쉬운 말로 쓰되 수는 신고서 그대로다
 * ⛔ 「투자하라·사라」로 읽히게 쓰지 않는다. 순위는 크기 순이고 그 말을 한 줄로 덧붙인다
 *
 * 🔴 Astro 앞말(`---` 사이)은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * 🔴 JSX 는 끝 공백을 버린다. 붙여 써야 할 곳은 `{' '}` 를 넣는다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import d from '../../data/kcw-label-accounts.json';
import cap from '../../data/kcw-cap-per-artist.json';

type Row = {
  nameEn: string | null; ticker: string | null;
  marketCap: number | null;
  revenue: number | null; revenuePrior: number | null; revenueChangePct: number | null;
  operatingProfit: number | null; netProfit: number | null;
  operatingSwing: string | null; netProfitSwing: string | null;
  notMeasured: string | null;
};

const meta = (d as any)._meta as Record<string, any>;
const rows = ((d as any).rows ?? []) as Row[];
const capRows = ((cap as any).회사들 ?? []) as Array<{ 회사: string; 아는사람: number }>;

/* 손님이 아는 이름으로 — 「SM ENTERTAINMENT CO., Ltd.」 는 손님이 쓰는 이름이 아니다 */
const 쉬운이름: Record<string, string> = {
  'HYBE Co., Ltd.': 'HYBE',
  'SM ENTERTAINMENT CO., Ltd.': 'SM Entertainment',
  'JYP Entertainment Corporation': 'JYP Entertainment',
  'YG Entertainment Inc.': 'YG Entertainment',
  'CUBE ENTERTAINMENT, INC.': 'Cube Entertainment',
  'FNC ENTERTAINMENT Co., Ltd.': 'FNC Entertainment',
  'CJ E&M Corporation': 'CJ E&M',
};
const 이름 = (r: Row) => (r.nameEn ? (쉬운이름[r.nameEn] ?? r.nameEn) : (r.ticker ?? '—'));

/*
 * 아티스트 수 — /cap-per-artist 가 이미 센 것을 그대로 쓴다. ⛔ 다시 세지 않는다.
 *
 * 🔴 [2026-09-10] 통글자로 맞췄더니 HYBE 만 «—» 로 나왔다. 저쪽 자료는 「Hybe」이고
 *   내 표는 「HYBE」였다. ⛔ 이름으로 이을 때는 대소문자를 맞춰서 잇는다 —
 *   오늘 같은 무늬를 세 번째로 겪는다(시세 칸 이름 · 시장 E · 이것).
 */
const 아티스트 = new Map(capRows.map((x) => [String(x.회사 ?? '').toLowerCase(), x.아는사람]));
const 아티스트수 = (r: Row) => 아티스트.get(이름(r).toLowerCase()) ?? null;

/* ⭐ 억 단위로 낸다 — 「조」는 손님이 크기를 못 느낀다. 억은 뉴스에서 늘 쓰는 단위다 */
const 억 = (n: number | null) => (n === null ? null : Math.round(n / 1e8));
const 억글 = (n: number | null) => {
  const v = 억(n);
  return v === null ? '—' : v.toLocaleString('en-GB');
};

const 잰것 = rows.filter((r) => !r.notMeasured && r.revenue !== null);
const 못잰것 = rows.filter((r) => r.notMeasured);

/* 🔴 순위 — 사장님 지시. 매출이 큰 순서다 */
const 매출순 = [...잰것].sort((a, b) => (b.revenue ?? 0) - (a.revenue ?? 0));
/* 두 번째 순위 — 「늘어난 몫」. 큰 회사가 늘 위인 순위는 하나로 충분하다 */
const 성장순 = [...잰것].filter((r) => r.revenueChangePct !== null)
  .sort((a, b) => (b.revenueChangePct ?? 0) - (a.revenueChangePct ?? 0));
/* 세 번째 — 「남은 돈」. 판 것 가운데 얼마가 회사에 남았나 */
const 남은순 = [...잰것].filter((r) => r.netProfit !== null)
  .sort((a, b) => (b.netProfit ?? 0) - (a.netProfit ?? 0));

const 으뜸 = 매출순[0] ?? null;
const 흑자 = 잰것.filter((r) => (r.netProfit ?? 0) > 0).length;
const 적자 = 잰것.filter((r) => (r.netProfit ?? 0) < 0).length;
const 늘어난곳 = 잰것.filter((r) => (r.revenueChangePct ?? 0) > 0).length;

const 차례말 = (n: number) => {
  const 꼬리 = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
  return `${n}${꼬리}`;
};

const TITLE = 'Which K-pop company earned the most in 2025 — the full ranking';
const DESC =
  `HYBE, SM, JYP, YG, Cube and FNC ranked by what they actually earned in 2025, from the accounts `
  + `they filed. ${늘어난곳} of ${잰것.length} sold more than the year before, ${흑자} kept money at `
  + `the end and ${적자} did not. Every number explained in plain words.`;

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'K-pop company earnings ranking, 2025',
  description: DESC,
  keywords: ['K-pop', 'HYBE', 'SM Entertainment', 'JYP Entertainment', 'YG Entertainment',
    'Cube Entertainment', 'FNC Entertainment', 'K-pop company earnings',
    'which K-pop company is biggest', 'K-pop industry money'],
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://opendart.fss.or.kr', 'https://www.data.go.kr'],
  temporalCoverage: '2025',
  isAccessibleForFree: true,
};

/* FAQ — ⛔ 화면에 «실제로 보이는» 문장과 같아야 한다(구글 규칙) */
const faq: Array<[string, string]> = [
  ['Which K-pop company makes the most money?',
    으뜸
      ? `${이름(으뜸)} sold the most in 2025 — ₩${억글(으뜸.revenue)} hundred million, which is `
        + `more than the next two put together. But selling the most is not the same as keeping the `
        + `most: ${이름(으뜸)} finished the year with less money than it started, while three `
        + `smaller companies finished with more.`
      : 'We could not read the filings, so we are not publishing a ranking.'],
  ['Is HYBE bigger than SM and JYP?',
    (() => {
      const h = 잰것.find((r) => 이름(r) === 'HYBE');
      const s = 잰것.find((r) => 이름(r) === 'SM Entertainment');
      const j = 잰것.find((r) => 이름(r) === 'JYP Entertainment');
      if (!h || !s || !j) return 'We could not compare them from the filings we hold.';
      const 배 = ((h.revenue ?? 0) / ((s.revenue ?? 0) + (j.revenue ?? 0))).toFixed(1);
      return `Yes, by sales. HYBE sold ₩${억글(h.revenue)} hundred million in 2025 — about `
        + `${배} times SM and JYP added together. HYBE also has the most artists on our count.`;
    })()],
  ['Did K-pop companies do well in 2025?',
    `${늘어난문장()} That is the short answer. ${흑자} of ${잰것.length} kept money at the end of the `
    + `year and ${적자} did not, so "the industry did well" is true of the sales line and not true `
    + `of every company.`],
  ['What does operating profit mean?',
    'It is what a company earned from doing its actual job — selling albums, tickets, '
    + 'merchandise and rights — after paying the costs of doing that job. It leaves out things '
    + 'that happen on the side, like the value of a stake in another company going up or down.'],
  ['Why did the biggest company lose money if its sales went up?',
    'Because the loss did not come from the job. Its sales rose and it still earned money from '
    + 'the job itself, but something outside the job took more than that away. The filing gives '
    + 'the number and not the reason, so we are not going to guess the reason for you.'],
];
/* ⚠ 이 문장은 FAQ 와 화면에서 «같은 말»이어야 한다(구글 규칙) — 그래서 함수로 한 번만 쓴다 */
function 늘어난문장() {
  return `${늘어난곳} of the ${잰것.length} companies we can read sold more than the year before.`;
}
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
const jsonLd = [datasetLd, faqLd];
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical="https://www.kculturewire.com/label-accounts">
  <article class="wrap">
    <h1>Which K-pop company earned the most in 2025</h1>
    <p class="lead">
      Six companies behind the groups you follow have to publish their accounts by law. Here is
      what they said, ranked, with every term explained as it comes up. No advice, no opinion —
      just the numbers they filed and what they mean.
    </p>

    <section class="explain">
      <h2>Read this first — three words, and you can read the whole page</h2>
      <dl>
        <dt>Sales</dt>
        <dd>
          Everything the company took in over the year — albums, concert tickets, merchandise,
          rights. It is the biggest number and the easiest one. <b>Bigger sales does not mean the
          company kept more.</b>
        </dd>
        <dt>Profit from the job</dt>
        <dd>
          What was left after paying for doing the job — staff, studios, tours, promotion.
          If this is a minus, the company spent more on the work than the work brought in.
          (Accountants call this <i>operating profit</i>.)
        </dd>
        <dt>What was left at the end</dt>
        <dd>
          The final line, after everything else — taxes, interest, and gains or losses on things
          the company owns, like a stake in another company. A company can do fine at the job and
          still finish the year down here. That is exactly what happened to one of these six.
          (Accountants call this <i>net profit</i>.)
        </dd>
      </dl>
    </section>

    <section>
      <h2>Ranking 1 — who sold the most</h2>
      <p class="note">Won, in hundreds of millions. Artists is how many we can link to each company.</p>
      <table>
        <thead>
          <tr><th>#</th><th>Company</th><th class="n">Sales 2025</th><th class="n">Year before</th><th class="n">Artists</th></tr>
        </thead>
        <tbody>
          {매출순.map((r, i) => (
            <tr>
              <td class="rk">{i + 1}</td>
              <td class="nm">{이름(r)}</td>
              <td class="n big">{억글(r.revenue)}</td>
              <td class="n dim">{억글(r.revenuePrior)}</td>
              <td class="n dim">{아티스트수(r) ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {으뜸 && (
        <p class="say">
          <b>{이름(으뜸)} is {차례말(1)}</b> and sold more than the next two companies put together.
        </p>
      )}
    </section>

    <section>
      <h2>Ranking 2 — who grew the fastest</h2>
      <p class="note">
        How much more they sold than the year before. A small company can top this one and often does.
      </p>
      <table>
        <thead><tr><th>#</th><th>Company</th><th class="n">Grew by</th></tr></thead>
        <tbody>
          {성장순.map((r, i) => (
            <tr>
              <td class="rk">{i + 1}</td>
              <td class="nm">{이름(r)}</td>
              <td class="n big">{(r.revenueChangePct ?? 0) > 0 ? '+' : ''}{r.revenueChangePct}%</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="say">
        The company that sold the most is <b>not</b> the company that grew the most.
        Two different questions, two different answers.
      </p>
    </section>

    <section>
      <h2>Ranking 3 — who actually kept money</h2>
      <p class="note">
        What was left at the very end of the year. A minus means the company finished down.
      </p>
      <table>
        <thead><tr><th>#</th><th>Company</th><th class="n">Kept at the end</th><th>Changed?</th></tr></thead>
        <tbody>
          {남은순.map((r, i) => (
            <tr class={(r.netProfit ?? 0) < 0 ? 'neg' : undefined}>
              <td class="rk">{i + 1}</td>
              <td class="nm">{이름(r)}</td>
              <td class="n big">{억글(r.netProfit)}</td>
              <td class="fine">
                {r.netProfitSwing === 'profit to loss' ? 'was up last year, down this year'
                  : r.netProfitSwing === 'loss to profit' ? 'was down last year, up this year'
                    : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="say">
        <b>This is the ranking that flips.</b> The company at the top of Ranking 1 is at the bottom
        of this one. It sold the most and finished the year with less than it started.
      </p>
      <p>
        Its sales rose and it still earned money from the job itself. Something outside the job —
        the kind of thing that lives on the last line — took more than that away. The filing gives
        us the number and not the reason, so we are not going to invent a reason for you.
      </p>
    </section>

    <section>
      <h2>One more way to look at it — money per artist</h2>
      <p class="note">
        Sales divided by how many artists we can link to the company. It is a division, not a
        judgement: a company with fewer artists looks bigger per head automatically.
      </p>
      <table>
        <thead><tr><th>Company</th><th class="n">Artists</th><th class="n">Sales per artist</th></tr></thead>
        <tbody>
          {매출순.filter((r) => 아티스트수(r)).map((r) => (
            <tr>
              <td class="nm">{이름(r)}</td>
              <td class="n dim">{아티스트수(r)}</td>
              <td class="n">{억글((r.revenue ?? 0) / (아티스트수(r) as number))}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        Artist counts come from our <a href="/cap-per-artist">market value per artist</a> page,
        where they are counted from public records rather than from contracts. They are a floor,
        not a full roster.
      </p>
    </section>

    {못잰것.length > 0 && (
      <section>
        <h2>One company we could not include</h2>
        <p class="note">
          {못잰것.map((r) => 이름(r)).join(', ')} — we have no 2025 accounts for it in the records
          we hold, so it is not in any ranking above. We are naming it rather than quietly leaving
          it out, and we are not putting a zero where we have nothing.
        </p>
      </section>
    )}

    <section class="faq">
      <h2>Questions people actually ask</h2>
      {faq.map(([q, a]) => (
        <div class="qa"><h3>{q}</h3><p>{a}</p></div>
      ))}
    </section>

    <section>
      <h2>Where these numbers come from</h2>
      <p class="note">
        Every company listed on a Korean exchange must publish its accounts once a year. We took
        them from DART, the government system where those filings are posted, and the market
        values from the government data portal for {meta.marketCapAsOf ?? 'the trading day noted'}.
        We did not adjust anything. Built {meta.builtAt}.
      </p>
      <p class="note">
        The rankings are by size, not by merit — a bigger company is not a better one, and none of
        this says anything about the music. <b>This is not investment advice.</b> If you want the
        accountants' version, with the ratios and both dates on every row, it is on our sister
        site: <a href="https://seoulmarkets.com/data/valuation">Korea valuation tape</a>.
      </p>
    </section>

    <KcwRelatedArticles page="/label-accounts" />
  </article>
</WikiTip>

<style>
  .wrap { max-width: 54rem; margin: 0 auto; padding: 1rem 1.1rem 4rem; }
  h1 { font-size: clamp(1.55rem, 4.4vw, 2.2rem); line-height: 1.14; margin: 0 0 .6rem; }
  .lead { font-size: 1.05rem; line-height: 1.62; color: #333; margin: 0 0 1.6rem; }
  section { margin: 2.3rem 0; }
  h2 { font-size: 1.14rem; margin: 0 0 .55rem; }
  h3 { font-size: .99rem; margin: 0 0 .3rem; }
  p { line-height: 1.68; margin: 0 0 .7rem; }
  .note { font-size: .88rem; color: #555; }
  .fine { font-size: .82rem; color: #666; }
  .say { font-size: 1.02rem; line-height: 1.6; background: #f6f4fb; border-left: 3px solid #7c5cd0;
         padding: .7rem .9rem; margin: .8rem 0 .5rem; }
  .explain { background: #fafafa; border: 1px solid #ececec; border-radius: 8px; padding: 1rem 1.1rem; }
  .explain dl { margin: 0; }
  .explain dt { font-weight: 700; margin: .8rem 0 .2rem; }
  .explain dt:first-child { margin-top: 0; }
  .explain dd { margin: 0 0 .2rem; line-height: 1.62; }
  table { border-collapse: collapse; width: 100%; font-size: .93rem; }
  th, td { border-bottom: 1px solid #ececec; padding: .42rem .5rem; text-align: left; }
  thead th { border-bottom: 2px solid #ddd; font-weight: 600; font-size: .85rem; }
  .n { text-align: right; font-variant-numeric: tabular-nums; }
  .big { font-weight: 700; }
  .dim { color: #777; }
  .rk { width: 2rem; color: #7c5cd0; font-weight: 700; }
  .nm { font-weight: 600; }
  tr.neg .big { color: #b3261e; }
  .qa { margin: 0 0 1.1rem; }
  a { color: #5b3fb0; }
  @media (prefers-color-scheme: dark) {
    .lead { color: #cfcfcf; }
    .note { color: #a8a8a8; }
    .fine { color: #9a9a9a; }
    .say { background: #221d33; border-left-color: #9b83e0; }
    .explain { background: #1a1a1a; border-color: #2e2e2e; }
    th, td { border-bottom-color: #2c2c2c; }
    thead th { border-bottom-color: #3a3a3a; }
    .dim { color: #999; }
    .rk { color: #9b83e0; }
    tr.neg .big { color: #f2857c; }
    a { color: #b39ff0; }
  }
</style>
