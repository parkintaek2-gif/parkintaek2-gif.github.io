---
/**
 * K Culture Wire — 웹툰 사업체 396곳. (/webtoon)
 *
 * ── 왜 지면인가 ───────────────────────────────────────────────
 * 같은 자료로 기사(`/article/korea-webtoon-two-economies`)를 이미 냈다.
 * 기사는 「평균이 아무도 설명하지 못한다」는 **한 가지 이야기**이고,
 * 이 지면은 **네 갈래(유형·분야·규모·매출) 전부가 서 있는 자리**다.
 * 2번 지시(0806 23:3x): 「기사는 흐르고 지면은 남는다 — 검색은 지면에 쌓인다」
 *
 * ── ⚠ 순위표로 만들지 않는다 ──────────────────────────────────
 * 갈래끼리 등수를 매기지 않는다. 조사가 나눈 그대로 묶어서 나란히 놓고,
 * **왜 다른지**(자본 구조·사업 성격)를 같이 적는다.
 *
 * ── ⚠ 사례수를 항상 붙인다 ────────────────────────────────────
 * 기타 24곳·출판 28곳처럼 표본이 얇은 칸이 있다. 비율만 크게 보이면 오해한다.
 * 모든 줄에 n 을 박는다.
 *
 * ⛔ 광고 자리를 만들지 않았다. Riot Production 승인 전이다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import KcwRelatedArticles from '../../components/KcwRelatedArticles.astro';
import data from '../../data/wikitip-webtoon.json';

const TITLE = 'Korea’s webtoon businesses, counted';
const DESC =
  'All 396 Korean webtoon businesses surveyed in 2024 — by type, by what they do, by headcount and '
  + 'by revenue. Average revenue, the share earning under ₩1bn, and how much of their income is webtoons.';

type Row = typeof data.rows[number];
const byKey = new Map(data.rows.map((r) => [r.key, r]));
const 전체 = byKey.get('All businesses')!;

/*
 * ⚠ 원자료 단위는 **백만원**이다. 십억원(bn)으로 바꾸려면 **1,000 으로** 나눈다.
 *   처음에 100 으로 나눠 8,061백만원이 「₩80.6bn」으로 나갔다 — **10배**다.
 *   억(1억)과 billion(10억)을 머릿속에서 겹쳐 놓아서 났다. 배포 전에 잡았다.
 *   검산: 8,061백만원 = 80.6억원 = ₩8.06bn · 94,468.4백만원 = 944.7억원 = ₩94.5bn
 */
const 억 = (백만: number | null) =>
  백만 === null ? '—' : '₩' + (백만 / 1000).toLocaleString('en-US', { maximumFractionDigits: 2 }) + 'bn';
const pc = (v: number | null) => (v === null ? '—' : v.toFixed(1) + '%');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: String(data.year),
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://kosis.kr'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} canonical="https://www.kculturewire.com/webtoon">
  <h1>Korea’s webtoon businesses, counted</h1>
  <p class="lead">
    Every figure here comes from one survey of {전체.n} webtoon businesses in {data.year}.
    Revenue is webtoon-related revenue per business. Sample size is shown on every row.
  </p>

  <section>
    <h2>The average is not the industry</h2>
    <div class="flip">
      <div>
        <span class="lab">Average revenue</span>
        <span class="big">{억(전체.mean)}</span>
        <span class="det">across all {전체.n} businesses</span>
      </div>
      <div>
        <span class="lab">Earning under ₩1bn</span>
        <span class="big">{pc(전체.under1)}</span>
        <span class="det">three-quarters of the industry sits below the average’s own bracket</span>
      </div>
    </div>
    <p class="note">
      A small group at the top sets that mean. The tables below show where it comes from.
      {' '}<a href="/article/korea-webtoon-two-economies">Read the full story →</a>
    </p>
  </section>

  {Object.entries(data.groups).map(([g, keys]) => (
    <section>
      <h2>{g === '사업 유형' ? 'By type of business'
         : g === '주사업 분야' ? 'By main line of business'
         : g === '종사자 규모' ? 'By headcount'
         : 'By revenue band'}</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th>Segment</th><th>Businesses</th><th>Avg revenue</th>
              <th>Under ₩1bn</th><th>₩10bn+</th><th>75%+ from webtoons</th>
            </tr>
          </thead>
          <tbody>
            {(keys as string[]).map((k) => {
              const r = byKey.get(k) as Row;
              return (
                <tr>
                  <td class="nm">{k}</td>
                  <td>{r.n?.toLocaleString() ?? '—'}</td>
                  <td class="tot">{억(r.mean)}</td>
                  <td>{pc(r.under1)}</td>
                  <td>{pc(r.over10)}</td>
                  <td>{pc(r.dep75)}</td>
                </tr>
              );
            })}
            <tr class="all">
              <td class="nm">All businesses</td>
              <td>{전체.n}</td><td class="tot">{억(전체.mean)}</td>
              <td>{pc(전체.under1)}</td><td>{pc(전체.over10)}</td><td>{pc(전체.dep75)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      {g === '사업 유형' && (
        <p class="note">
          Platforms distribute; content providers make the work. They are not competing on the same
          field — a distribution business serves the whole market at once and carries the capital to
          do it, while a production studio is small by nature. This is a difference in kind, not in quality.
        </p>
      )}
      {g === '종사자 규모' && (
        <p class="note">
          The last column is the one to read here. The smallest firms are the most dependent on
          webtoons for their income and the least able to absorb a bad year. Diversification and
          cushion sit in the same companies.
        </p>
      )}
    </section>
  ))}

  <KcwRelatedArticles page="/webtoon" />

  <section class="src">
    <h2>Where these numbers come from</h2>
    <ul>
      <li><b>{data.sourceKo}</b> — {data.source}.</li>
      <li>
        <b>Sample sizes are small in places.</b> Publishing is 28 businesses and Other is 24. A
        percentage on a base that size moves a lot for one respondent, so the count is printed on
        every row and should be read with the percentage, never without it.
      </li>
      <li>
        <b>One year only.</b> KOSIS publishes this survey for {data.year} and no earlier year in this
        form, so nothing here says the industry is growing or shrinking.
      </li>
      <li>
        <b>This surveys businesses, not creators.</b> A studio’s revenue is not a cartoonist’s income,
        and the survey does not ask about the second. No figure here describes what an artist earns.
      </li>
      <li>
        <b>No company is named.</b> The survey reports 28 platforms as a group and does not identify
        them, so neither do we.
      </li>
    </ul>
    <p class="note">
      Sources: KOSIS (국가데이터처) and the Webtoon Industry Survey (한국콘텐츠진흥원 「웹툰산업실태조사」), reference year {data.year}.
    </p>
  </section>

  <p class="back"><a href="/">&larr; Back to the front page</a></p>
</WikiTip>

<style>
  h1 { margin: 0 0 .5rem; font-size: 1.7rem; letter-spacing: -.02em; }
  .lead { margin: 0 0 2rem; font-size: 1rem; color: var(--muted); }
  section { margin: 0 0 2.5rem; }
  h2 { font-size: 1.1rem; margin: 0 0 .6rem; letter-spacing: -.01em; }
  .note { font-size: .82rem; color: var(--muted); margin: .9rem 0 0; line-height: 1.6; }

  .flip { display: grid; gap: .8rem; grid-template-columns: 1fr; }
  @media (min-width: 34rem) { .flip { grid-template-columns: 1fr 1fr; } }
  .flip > div { background: var(--card); border-radius: 8px; padding: .9rem 1rem; }
  .lab { display: block; font-size: .76rem; letter-spacing: .04em; text-transform: uppercase;
         color: var(--muted); font-weight: 700; }
  .big { display: block; font-size: 1.5rem; font-weight: 700; margin: .25rem 0 .3rem;
         letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .det { display: block; font-size: .78rem; color: var(--muted); line-height: 1.5; }

  table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  th, td { padding: .48rem .55rem; border-bottom: 1px solid var(--line); text-align: right;
           white-space: nowrap; font-variant-numeric: tabular-nums; }
  th { font-size: .72rem; letter-spacing: .03em; text-transform: uppercase; color: var(--muted);
       font-weight: 700; }
  th:first-child, td.nm { text-align: left; white-space: normal; }
  td.tot { font-weight: 700; }
  /* 전체 줄은 비교 기준이라 배경으로 뗀다 — 등수가 아니라 기준선이다 */
  tr.all td { background: var(--card); font-weight: 700; }

  .src ul { margin: 0; padding-left: 1.1rem; font-size: .85rem; color: var(--muted); line-height: 1.7; }
  .src li { margin: .45rem 0; }
  .src b { color: var(--ink); }
  .back { margin-top: 2.5rem; font-size: .9rem; }
</style>
