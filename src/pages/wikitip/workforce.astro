---
/**
 * K Culture Wire — 엔터·게임 상장사 인력 지면. (/workforce)
 *
 * ── 왜 이 지면인가 (2번 지시 0806 · Ⅲ, Ⅷ) ──────────────────────
 * 「팬은 아이돌을 보지만, 그 회사를 굴리는 사람들의 숫자는 아무도 안 본다.」
 * 우리가 이기는 자리는 속보가 아니라 **숫자**다 — 「그들은 재무를, 우리는 사람을」.
 * 원자료는 DART 직원·임원 현황(🟢 제한 없음). SeoulMarkets 와 같은 한 벌을 쓴다.
 *
 * ── 🔴 순위표로 만들지 않는다 (2번 규칙 3-3) ────────────────────
 * 「근속이 짧은 회사」는 낙인이 된다. **등수를 붙이지 않는다.**
 * 두 갈래(엔터·게임)로 나눠 나란히 놓고, **왜 다른지**(신생 여부·업종 구조)를 같이 적는다.
 *
 * ── 숫자는 rankings.json 에서 빌드시 읽는다 ─────────────────────
 * 하드코딩하면 데이터가 갱신될 때 또 틀린다(2번이 겪음). 컬럼 정의는 rankings.json 의 `cols`.
 *   0 name · 1 ticker · 2 industry · 5 tenure · 6 tenureGap · 7 pay · 9 headcount · 10 femaleShare · 13 age
 * 근속(5)은 2번이 준 값과 대조해 15곳 전부 일치 확인(2026-08-06). 대아티아이(045390)는
 * 「Electrical equipment」(철도신호)라 엔터·게임이 아니어서 뺐다.
 *
 * ── noindex ────────────────────────────────────────────────────
 * 주소(kculturewire.com)가 아직 파킹이라 index.astro 와 같은 이유로 noindex. 살면 함께 푼다.
 */
import WikiTip from '../../layouts/WikiTip.astro';
import rankings from '../../data/rankings.json';

const TITLE = 'Who works in K-pop and Korean games';
const DESC =
  'How long people stay at Korea’s listed entertainment agencies and game studios, and who they are — '
  + 'average tenure, headcount and the gender split, from company filings. Measured, sourced, not ranked.';

// 짧은 영문 표기 (영어 사이트 — 한글 표기 없음)
const SHORT = {
  '352820': 'HYBE', '041510': 'SM Entertainment', '035900': 'JYP Entertainment',
  '122870': 'YG Entertainment', '182360': 'Cube Entertainment', '253450': 'Studio Dragon',
  '036420': 'Contentree JoongAng', '035760': 'CJ ENM',
  '259960': 'Krafton', '251270': 'Netmarble', '036570': 'NCsoft', '263750': 'Pearl Abyss',
  '293490': 'Kakao Games', '078340': 'Com2uS',
};
const AGENCIES = ['352820', '041510', '035900', '122870', '182360', '253450', '036420', '035760'];
const GAMES = ['259960', '251270', '036570', '263750', '293490', '078340'];

const byTicker = new Map(rankings.rows.map((r) => [String(r[1]), r]));
const pick = (codes) =>
  codes
    .map((c) => byTicker.get(c))
    .filter(Boolean)
    .map((r) => ({
      name: SHORT[String(r[1])] || r[0],
      tenure: r[5], gap: r[6], headcount: r[9], female: r[10], age: r[13],
    }))
    .sort((a, b) => a.tenure - b.tenure);

const agencies = pick(AGENCIES);
const games = pick(GAMES);
const all = [...agencies, ...games];
const maxTenure = Math.max(...all.map((c) => c.tenure));
const groups = [
  { key: 'agencies', label: 'Entertainment agencies and producers', rows: agencies,
    note: 'K-pop labels, drama studios and broadcasters. These are younger businesses with high project turnover, and the average time an employee stays is correspondingly short.' },
  { key: 'games', label: 'Game studios', rows: games,
    note: 'Game publishers and developers. They are larger and, on this measure, keep staff longer than the agencies do.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Workforce of Korea’s listed K-pop and game companies',
  description: DESC,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://opendart.fss.or.kr/'],
};

const pct = (v) => (v == null ? '—' : `${v}%`);
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd} noindex>
  <h1>Who works in K-pop and Korean games</h1>
  <p class="lead">
    Fans watch the idols and the games. Almost nobody counts the people who run the companies
    behind them. These are {all.length} listed Korean firms, from their own filings — how long
    staff stay, how many there are, and who they are.
  </p>

  <!-- ── 근속 — 두 갈래로 나눠 놓는다. 등수를 붙이지 않는다 ──────── -->
  <section>
    <h2>How long people stay</h2>
    <p class="sub">
      Company-reported average tenure across all employees, in years, from the latest annual filing.
      Shown in two groups because they are different kinds of business — not as one ranking.
    </p>

    {groups.map((g) => (
      <div class="grp">
        <h3>{g.label}</h3>
        <ul class="rows">
          {g.rows.map((c) => (
            <li>
              <span class="bar" style={`--w:${(c.tenure / maxTenure) * 100}%`}></span>
              <span class="nm">{c.name}</span>
              <span class="meta">
                <b>{c.tenure.toFixed(1)}</b> yr avg · {c.headcount.toLocaleString()} employees ·
                founded {Math.round(c.age)} yr ago
              </span>
            </li>
          ))}
        </ul>
        <p class="note">{g.note}</p>
      </div>
    ))}
  </section>

  <!-- ── 성별 구성 — 데이터가 스스로 말하는 강한 각도 ─────────────── -->
  <section>
    <h2>A workforce split by gender</h2>
    <p class="sub">
      Women as a share of total headcount, from the same filings. The two groups sit on opposite
      sides of the halfway line, and it is not close.
    </p>
    <ul class="rows">
      {all.slice().sort((a, b) => b.female - a.female).map((c) => (
        <li>
          <span class="bar" style={`--w:${c.female}%`}></span>
          <span class="nm">{c.name}</span>
          <span class="meta"><b>{pct(c.female)}</b> women</span>
        </li>
      ))}
    </ul>
    <p class="note">
      The entertainment agencies are majority-women workforces; the game studios are
      majority-men. A 50% line is the reference — this is a composition, not a score.
    </p>
  </section>

  <!-- ── 출처 · 제외 ────────────────────────────────────────────── -->
  <section class="src">
    <h2>Where these numbers come from</h2>
    <ul>
      <li>
        <b>DART electronic disclosure (Financial Supervisory Service)</b> — the employee and
        officer sections of each company’s annual report. Tenure, headcount and gender share are
        as the company filed them; we do not estimate any of them.
      </li>
    </ul>
    <p class="note">
      <b>This is not a ranking, and not a judgement.</b> A short average tenure at a young company
      is not a worse number than a long one at an old company — it is a different one. We put the
      figures side by side and name the reason they differ.
    </p>
    <p class="note">
      <b>Not included:</b> privately held agencies and studios, which file no comparable
      disclosure. One company on our first list — DAEA TI (045390) — was dropped after checking
      its filing: it makes railway signalling equipment, not music or games.
    </p>
    <p class="note">Company filings via DART. Figures reflect the latest annual report on file.</p>
  </section>

  <p class="back"><a href="/">&larr; Back to the front page</a></p>
</WikiTip>

<style>
  h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.25; margin: 1.2rem 0 .8rem; letter-spacing: -.02em; }
  .lead { font-size: 1.05rem; color: var(--muted); margin: 0 0 2.5rem; }
  section { margin: 0 0 3rem; }
  h2 { font-size: 1.12rem; margin: 0 0 .3rem; letter-spacing: -.01em; }
  h3 { font-size: .98rem; margin: 1.6rem 0 .5rem; }
  .sub { font-size: .87rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.6; }
  .note { font-size: .82rem; color: var(--muted); margin: .9rem 0 0; line-height: 1.6; }
  .grp { margin: 0 0 1.4rem; }

  .rows { list-style: none; padding: 0; margin: 0; }
  .rows li {
    position: relative; overflow: hidden;
    padding: .6rem .8rem; border-bottom: 1px solid var(--line);
  }
  .bar {
    position: absolute; left: 0; top: 0; bottom: 0; width: var(--w);
    background: var(--card); border-radius: 0 4px 4px 0;
  }
  .nm, .meta { position: relative; }
  .nm { display: block; font-weight: 600; line-height: 1.35; }
  .meta { display: block; font-size: .82rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .meta b { color: var(--accent); }

  .src ul { padding-left: 1.1rem; margin: 0; font-size: .9rem; }
  .src li { margin: 0 0 .4rem; line-height: 1.6; }
  .back { margin-top: 3rem; font-size: .9rem; }
  .back a { color: var(--muted); }
</style>
