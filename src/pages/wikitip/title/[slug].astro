---
/**
 * K Culture Wire — **작품 한 편** (`/title/<slug>`). 530장이 여기서 나온다.
 *
 * ── 왜 ─────────────────────────────────────────────────────────
 * 손님은 「Squid Game countries」·「Hellbound where did it chart」를 검색한다.
 * 작품이 접혀 있으면 그 말에 안 걸린다. 그리고 이 지면이 파는 물건(「내 작품 여정표」)의
 * **공짜 맛보기**다 — 회사가 자기 작품이 어디까지 갔는지를 여기서 먼저 본다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────
 * ⛔ **얇으면 안 낸다.** 자료 줄이 여섯 미만인 작품은 `hasPage: false` 라 여기서 안 만든다.
 * ⛔ **줄세우지 않는다.** 시장을 「많이 본 순」으로 안 놓는다 — **가나다순**으로 놓고 수를 옆에 적는다.
 * ⛔ **취향을 평가하지 않는다.** 「인기 있다」가 아니라 몇 자리를 차지했나를 적는다.
 * ⛔ 철자가 다른 같은 이름을 **합치지 않았다.** 합쳤다고 오해하지 않게 화면에 적는다.
 * ⛔ 광고 자리를 만들지 않았다. Riot Production(App 866800) 승인 전이다.
 * ⚠ 수를 손으로 적지 않는다. 전부 `wikitip-title-pages.json` 에서 읽는다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import data from '../../../data/wikitip-title-pages.json';
import { 고유문장 } from '../../../../scripts/lib/kcw-title-facts.mjs';
import markets from '../../../data/wikitip-markets.json';
/* ⭐ 열 장에만 붙는 자료. 2번 지시(01:2x) — 530장을 다 고치기 전에 열 장으로 먼저 잰다 */
import deepened from '../../../data/wikitip-deepened.json';

/* ⛔ 시장 주소를 **짐작하지 않는다.** iso2 를 소문자로 만든 것이 주소일 거라 여겼다가
   93장 전부 죽은 링크가 될 뻔했다 — 실제 주소는 나라 이름이다(AR → argentina). */
const 시장주소 = new Map(markets.markets.filter((m) => m.hasPage).map((m) => [m.iso2, m.slug]));

/**
 * 🔴 2026-08-14 — **영어 지면에 한국어가 뜻 없이 나가고 있었다.** 530장 전부다.
 *   자료의 `firms[].roles` 는 원본 라벨(배급·제작·첫방송)을 그대로 담는다. 자료는 그게 옳다.
 *   ⛔ 그런데 **화면까지 그대로 내보내면** 우리 손님(영어권)은 그 칸을 못 읽는다.
 *   ⭐ 6번을 잴 때 쓴 잣대를 나에게 대서 찾았다. 남을 잰 자를 나에게 안 대면 그건 검사가 아니다.
 *
 *   옮기되 **원문을 지운다는 뜻은 아니다** — 뒤에 괄호로 남긴다. 출처를 밝히는 쪽이 맞다.
 *   ⚠ 모르는 라벨이 새로 들어오면 **원문 그대로 둔다.** 지어내서 옮기지 않는다.
 */
/* ⚠ `export` 를 붙이면 Astro 가 이 함수를 **딴 스코프로 옮겨** 맡은일이 안 보인다.
     빌드가 530장 전부 죽었다. 여기서는 export 하지 않는다 — 자가시험은 검사 쪽에 있다 */
const 맡은일 = { 배급: 'Distribution', 제작: 'Production', 첫방송: 'First broadcast' };
const 옮긴일 = (라벨) => (맡은일[라벨] ? `${맡은일[라벨]} (${라벨})` : String(라벨));

export function getStaticPaths() {
  /* ⛔ 얇은 작품은 지면을 안 낸다. 자료가 그렇게 판정해 둔 것을 그대로 따른다 */
  return data.titles.filter((t) => t.hasPage).map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

const { t } = Astro.props;

/* 이 작품에만 있는 사실. ⛔ 온 자료(976편)를 넘겨야 「가장·몇 %」를 말할 수 있다 —
   안 넘기면 그 문장을 아예 안 만든다. 짐작으로 등수를 매기지 않는다 */
const 고유사실 = 고유문장(t, data.titles, data.marketCount);
const 중 = data.medians;

/* ⭐ 2026-08-22 — 「hit or flop」을 묻는 손님에게 **자리**를 알려 주려면 분모가 필요하다.
   ⛔ 지면마다 다시 세지 않는다 — 이 줄은 모듈이 한 번 읽힐 때 한 번 돈다(528장이 같이 쓴다).
   ⚠ 지면이 나는 제목만 센다. 얇아서 지면을 안 낸 것을 분모에 넣으면 우리가 안 보여 준 것으로 자리를 매긴다 */
const 지면나는것 = data.titles.filter((x: any) => x.hasPage);

/**
 * ⭐⭐ 2026-08-22 — **작품에서 작품으로 걸어가는 길.** 두 가지를 한 번에 푼다.
 *
 * ① 색인 — 그날 구글에 직접 물어(URL Inspection API) 알아낸 것: 작품 지면 표본에서
 *   **9장이 「발견만 하고 안 넣음」**이었다. 나간 지면을 다 훑어 세니 528장 중 **519장이
 *   들어오는 링크가 딱 하나**였다. 「발견만」은 보통 안쪽 링크가 얇을 때 난다.
 * ② 머무는 것 — 사장님: 「어떻게 하면 사람들을 우리 안에서 **머물도록** 하냐」.
 *   이레 실측에서 걸어서 닿는 지면은 **0장**이었다. 손님은 이름에서 이름으로 걷는다 —
 *   배우와 제작사가 그 이름이다.
 *
 * ⛔ 지어내지 않는다. 같은 배우가 나온 작품·같은 회사가 크레딧에 있는 작품만 잇는다.
 * ⛔ 지면이 없는 작품은 안 잇는다(죽은 링크가 된다).
 * ⚠ 겹치는 것이 많은 작품이 있어 **여섯 편으로 끊는다** — 스무 편을 늘어놓으면 목록이 되고
 *   목록은 손님이 안 읽는다.
 */
const 배우별 = new Map<string, string[]>();
const 회사별 = new Map<string, string[]>();
for (const x of 지면나는것) {
  for (const c of (x.cast ?? [])) {
    if (!배우별.has(c.name)) 배우별.set(c.name, []);
    배우별.get(c.name)!.push(x.slug);
  }
  for (const f of (x.firms ?? [])) {
    if (!회사별.has(f.firm)) 회사별.set(f.firm, []);
    회사별.get(f.firm)!.push(x.slug);
  }
}
const 제목찾기 = new Map<string, string>(지면나는것.map((x: any) => [x.slug, x.title]));

/** 이 작품과 사람·회사를 나눠 가진 다른 작품. 왜 이어졌는지를 같이 준다 */
function 이웃작품(작품: any, 최대 = 6) {
  const 모음 = new Map<string, Set<string>>();
  const 담기 = (slug: string, 까닭: string) => {
    if (slug === 작품.slug) return;
    if (!모음.has(slug)) 모음.set(slug, new Set());
    모음.get(slug)!.add(까닭);
  };
  for (const c of (작품.cast ?? [])) for (const s of (배우별.get(c.name) ?? [])) 담기(s, c.name);
  for (const f of (작품.firms ?? [])) for (const s of (회사별.get(f.firm) ?? [])) 담기(s, f.firm);
  /* 까닭이 많은 것부터 — 배우 셋을 나눠 가진 작품이 하나를 나눠 가진 것보다 가깝다 */
  return [...모음.entries()]
    .map(([slug, 까닭들]) => ({ slug, title: 제목찾기.get(slug), 까닭: [...까닭들] }))
    .sort((a, b) => b.까닭.length - a.까닭.length || String(a.title).localeCompare(String(b.title)))
    .slice(0, 최대);
}
const 이웃 = 이웃작품(t);
/**
 * 그 작품이 처음 자리를 잡은 해 — 연도 지면으로 가는 길이다.
 * ⛔ 주 문자열이 없으면 만들지 않는다. 그 줄을 아예 안 낸다.
 */
const 첫해 = (typeof t.firstWeek === 'string' && /^\d{4}/.test(t.firstWeek))
  ? t.firstWeek.slice(0, 4)
  : null;
const 지면수 = 지면나는것.length;
const 더넓게 = 지면나는것.filter((x: any) => x.markets > t.markets).length;
const 덜넓게 = 지면나는것.filter((x: any) => x.markets < t.markets).length;
const 갈래 = t.type === 'Films' ? 'film' : 'series';

/**
 * 🔴 2026-08-14 — 폰으로 넘기다 **「1 markets」·「1 weeks」·「1 chart places」**를 봤다.
 *   얇은 작품 지면 140장에 그렇게 나가고 있었다. 영문 매체가 영어를 틀리면
 *   그 옆의 수도 안 믿긴다.
 * ⚠ 수가 1 이 될 때만 나는 흠이라 여느 때는 안 보인다. 그래서 자를 따로 만들었다
 *   (`scripts/check-kcw-plural.mjs`).
 */
const 셈 = (n: number, 하나: string, 여럿 = `${하나}s`) => (n === 1 ? 하나 : 여럿);
/* ⛔ 없으면 `undefined` 다 — 그 지면은 예전 그대로 나간다. 그게 이 실험의 대조군이다 */
const 깊은것 = (deepened.bySlug as Record<string, any>)[t.slug];

/**
 * 🔴 2026-08-23 실측 — 28일 검색어를 낱말로 세 보니 `netflix` 가 노출 268(검색어 20개)로
 *   가장 많이 치는 말이었다. 그런데 **작품 지면 560장 제목에 그 말이 없었다.**
 *   「decision to leave netflix country」로 8.9위에 떠 클릭 0, 「my roommate is a gumiho
 *   netflix which country」로 9.2위에 떠 클릭 0. 손님이 친 말이 제목에 안 보이니
 *   목록에서 우리 줄이 그 물음의 답처럼 안 읽힌다.
 * ⭐ 그래서 작품 이름 **바로 뒤**에 붙인다 — 구글이 60자에서 자르므로 앞에 와야 보인다.
 * ⛔ 낱말을 쌓지 않는다. `on Netflix` 는 이 지면이 실제로 다루는 것이다(넷플릭스 주간 top 10).
 *   참이 아닌 말을 제목에 넣는 것은 검색어를 받는 값으로 너무 비싸다.
 * ⚠ 이 바꿈으로 순위가 어떻게 되는지는 **우리가 못 잰다.** 2주 뒤(9/05) 다시 재서
 *   나빠졌으면 되돌린다. `scripts/measure-kcw-search-words.mjs` 로 같은 자를 다시 댄다.
 */
const TITLE = `${t.title} on Netflix — every country it charted in`;
/**
 * ⭐ 2026-08-22 — 설명에 **손님이 치는 말**을 넣는다. Search Console 실측에서 우리에게 오는
 *   물음은 두 꼴이었다 — 「<제목> netflix country」와 「<제목> hit or flop」.
 *   앞엣것은 답하고 있었고, 뒤엣것은 지면에도 설명에도 없었다(순위 7~10 · 클릭 0).
 * ⛔ 「hit 이다」라고 쓰지 않는다. **그 물음에 우리가 무엇을 줄 수 있는지**를 적는다 —
 *   그것이 답이 아닌 척하지 않으면서 그 검색을 받는 유일한 정직한 길이다.
 */
/**
 * 🔴 2026-08-24 00:3x — 작품 지면에 닿은 검색어를 실제로 열어 봤다.
 * ```
 * 노출 175 · 클릭 2. 그중 「어느 나라」를 묻는 것이 검색어 9개·노출 31.
 *   decision to leave netflix country              8노출 · 8.9위 · 클릭 0
 *   my roommate is a gumiho netflix which country  8노출 · 8.8위 · 클릭 0
 *   what countries can i watch behind your touch…  5노출 · 17.2위 · 클릭 0
 * ```
 * 순위는 9위 안팎인데 클릭이 0이다. 옛 설명문은 이렇게 시작했다 —
 * 「took 6 Netflix top 10 places across **1 of 93 markets**」.
 * ⛔ 「어느 나라?」를 물은 사람에게 **나라 이름이 없고**, 「1 of 93」이 먼저 보인다.
 *   그건 사실이지만 답이 아니라 **적다는 인상**부터 준다.
 * ⭐ 그래서 **물은 것을 앞에 놓는다** — 나라 수와 나라 이름 몇 개를 첫 문장에.
 *   낱말을 쌓는 것이 아니다. 자료에 이미 있는 답(`byMarket`)을 앞으로 옮기는 것이다.
 * ⛔ 「charted」를 「available」로 바꾸지 않는다. 차트에 든 것과 볼 수 있는 것은 다른 말이고,
 *   우리가 가진 것은 앞엣것뿐이다. 본문에 그 차이를 적어 둔다.
 */
const 나라들 = (t.byMarket ?? []).map((m: any) => m.name).filter(Boolean);
const 나라앞자락 = 나라들.length === 0
  ? ''
  : 나라들.length <= 3
    ? `: ${나라들.join(', ')}. `
    : ` — ${나라들.slice(0, 3).join(', ')} and ${나라들.length - 3} more. `;
const DESC =
  `${t.title} charted on Netflix in ${t.markets} `
  + `${t.markets === 1 ? 'country' : 'countries'}${나라앞자락 || '. '}`
  + `${t.places.toLocaleString('en-US')} top 10 ${셈(t.places, 'place')} across `
  + `${t.weeks} ${셈(t.weeks, 'week')}, peaking at number ${t.peak}, `
  + `${t.firstWeek} to ${t.lastWeek}. Counted from Netflix's own country lists — `
  + `charting there is not the same as being available there.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: TITLE,
  description: DESC,
  temporalCoverage: `${t.firstWeek}/${t.lastWeek}`,
  creator: { '@type': 'Organization', name: 'K Culture Wire' },
  isBasedOn: ['https://www.netflix.com/tudum/top10', 'https://www.wikidata.org'],
};
---

<WikiTip title={TITLE} description={DESC} jsonLd={jsonLd}
  canonical={`https://www.kculturewire.com/title/${t.slug}`}>
  <h1>{t.title}</h1>
  <p class="lead">
    A Korean {갈래} that reached a Netflix weekly top 10 in <b>{t.markets}</b> of
    {' '}{data.marketCount} markets, holding <b>{t.places.toLocaleString('en-US')}</b>{' '}
    {셈(t.places, 'chart place')} across {t.weeks} {셈(t.weeks, 'week')} between {t.firstWeek} and{' '}
    {t.lastWeek}. Its best position anywhere was
    {' '}<b>number {t.peak}</b>.
  </p>

  {/*
    ⭐⭐ 2026-08-24 밤 — **이 칸이 판박이를 깨는 자리다.** 사장님 「방문자가 왜 없는지 분석하라」.

    재서 나온 것 —
      갈래       지면수   서로 겹치는 낱말    색인
      title        560        83%          절반이 「발견만」
      article      117        40%          표본 «전부» 색인
      ⇒ 판박이 비율이 색인률을 그대로 예측했다.

    그리고 그 결과 —
      위키 조회 1만 이상 인기작 23편(합 60만 조회/30일) → 우리 노출 39회 · 평균 23.1위
      Squid Game 위키 87,213회 → 우리 노출 3회 · 22위

    🔴 자료는 지면마다 다른데 **그 자료를 감싼 문장이 같았다.** 표는 다르고 글은 같다.
      두 지면을 견줘 보니 «글자까지 똑같은» 문장이 26개 2,483자, 본문의 25%였다.
      구글이 읽는 것은 글이니 560장이 한 장처럼 보인다.

    ⛔ 그렇다고 그 26문장을 지우지 않았다. 전부 «한계와 방법»이고 그것이 우리 강령이다 —
      「못 잰 것은 못 쟀다고 적는다」. 지우는 것은 판박이를 없애는 게 아니라 정직을 버리는 것이다.
    ⭐ 그래서 **지우는 대신 고유한 것을 늘린다.** 같은 자료에서 작품마다 다른 사실을 뽑는다.
      문장 수부터 작품마다 다르다(1~7개) — 조건이 안 맞으면 건너뛴다.
      다 채우려는 순간 이 칸도 판박이가 된다. 그것이 이 설계의 핵심이다.
  */}
  {고유사실.length > 0 && (
    <p class="facts">
      {고유사실.map((s) => <span>{s}{' '}</span>)}
    </p>
  )}
  {/*
    🔴 2026-08-24 — **나라목록을앞으로.** 여기가 손님이 찾던 답이다.
      실측: 지면 앞쪽 두 토막이 판박이 61%·58% 였고, 이 표는 아홉 칸 중 여섯째에 있었다.
      「what countries can i watch behind your touch on netflix」·「18 again netflix countries」
      처럼 **나라를 묻는 검색**이 이 지면에 닿는데, 답을 다섯 칸 뒤에 두고 있었다.
    ⛔ 정의와 한계를 지우지 않았다 — 이 표 **바로 뒤**에 그대로 있다. 순서만 바꿨다.
      답 → 한계 → 견주기. 답 없이 한계부터 읽히면 손님은 답을 못 보고 나간다.
  */}
  <section>
    <h2>Where it charted — all {t.markets} {셈(t.markets, 'market')}</h2>
    <div class="scroll-x">
      <table>
        <thead>
          <tr><th>Market</th><th>Places</th><th>Best position</th><th>First week</th><th>Last week</th></tr>
        </thead>
        <tbody>
          {t.byMarket.map((m) => (
            <tr>
              <td class="nm">{시장주소.has(m.iso2)
                ? <a href={`/market/${시장주소.get(m.iso2)}`}>{m.name}</a>
                : m.name}</td>
              <td class="tot">{m.places}</td>
