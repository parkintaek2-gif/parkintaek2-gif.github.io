---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import HomeCharts from '../components/HomeCharts.astro';
import { SITE, SITE_URL, CATEGORIES } from '../consts';
import { publishedArticles } from '../lib/articles';

const articles = await publishedArticles();
const [lead, ...rest] = articles;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: SITE.name,
  description: SITE.description,
  url: SITE_URL,
  isPartOf: { '@id': `${SITE_URL}/#organization` },
};
---

<Base title="Korean stock market data in English — KOSPI, KOSDAQ, exports, economy" description="Korean stock market and economy data in English: KOSPI and KOSDAQ, Samsung's share of the market, Korea's biggest export and import partners, the won, bonds and prices — every figure from official Korean data, with its source and timestamp." jsonLd={jsonLd}>
  <div class="wrap">
    <AdSlot slot="banner" />

    <div class="page-head">
      <p class="kicker">{SITE.tagline}</p>
      <h1>Korean markets, in numbers</h1>
      <p>
        Stocks, the won, bonds, commodities and the economy behind them. Every story here starts
        from an official Korean government data release and states the exact timestamp of the
        figures it uses. No tips, no targets — just what the data shows and what it does not.
      </p>
    </div>

    {/* 무료 데이터 허브로 가는 눈에 띄는 링크 — 홈(최강 지면)의 권위를 허브로 보내고,
        방문자에게 실수요 질문("how much of the KOSPI is Samsung" 등)을 그대로 노출한다.
        2026-08-24 방문 올인: 내부링크 집중. */}
    <a class="data-hub" href="/data/concentration">
      <span class="dh-tag">Free data</span>
      <span class="dh-body"><b>The Korea Concentration Index</b> — how much of the KOSPI is Samsung,
      how many companies are listed, and who Korea trades with. Charts, a CSV and sources. →</span>
    </a>

    {
      articles.length === 0 ? (
        <>
          <HomeCharts />
          <p class="empty">No articles published yet.</p>
        </>
      ) : (
        <>
          <ul class="stream">
            <ArticleCard entry={lead} lead />
            {rest.slice(0, 4).map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </ul>

          {/* 사장님 지시(2026-08-26): 시장 움직임 패널을 첫 5편 «뒤»로 내린다.
              첫 화면은 무엇을 하는 매체인가(히어로+무료데이터+기사)로 열고,
              시장 대시보드는 스크롤 중간에 둔다. */}
          <HomeCharts />

          {rest.length > 4 && (
            <ul class="stream">
              {rest.slice(4).map((entry) => (
                <ArticleCard entry={entry} />
              ))}
            </ul>
          )}
        </>
      )
    }

    {/* 기사 스트림 **뒤**에 둔다. 첫 화면을 가입 요청으로 막지 않는다 —
        무엇을 하는 매체인지 먼저 보여 주고 그 다음에 권한다. */}
    <Newsletter source="home" />

    <div class="cat-grid">
      {
        CATEGORIES.map((c) => (
          <a class="cat-card" href={`/${c.slug}`}>
            <h3>{c.label}</h3>
            <p>{c.blurb}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .data-hub {
    display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap;
    margin: 0 0 1.4rem; padding: .8rem 1rem;
    border: 1px solid var(--accent, #0f4c81);
    border-left-width: 4px; border-radius: 6px;
    text-decoration: none; color: inherit;
    background: color-mix(in srgb, var(--accent, #0f4c81) 6%, transparent);
  }
  .data-hub:hover { background: color-mix(in srgb, var(--accent, #0f4c81) 12%, transparent); }
  .dh-tag {
    font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700;
    color: #fff; background: var(--accent, #0f4c81); padding: .15rem .5rem; border-radius: 3px; white-space: nowrap;
  }
  .dh-body { font-size: .95rem; line-height: 1.5; }
  .dh-body b { font-weight: 650; }
</style>
