---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import HomeCharts from '../components/HomeCharts.astro';
import { SITE, SITE_URL, CATEGORIES } from '../consts';
import { publishedArticles } from '../lib/articles';

const articles = await publishedArticles();
const [lead, ...rest] = articles;

/* 🔴 첫 화면에 세우는 상품. 「우리가 무엇을 파는가」를 한눈에 보이게 한다.
   ⚠ 여기 적는 한 줄은 «그 지면이 실제로 주는 것»이라야 한다. 부풀리면 손님이 열고 실망한다.
   ⛔ 값은 여기 적지 않는다 — 아래 한 줄(라이선스)과 /data 가 정본이다. 두 곳에 적으면 어긋난다.

   ── 🔴 [2026-09-15] 사장님이 첫 화면에서 이것을 잡아 주셨다 ─────────────────
   > 「Financial Statement Tape … Open → 하면 «What is in the Korean financial-statement tape …
   >  2,570 of 2,709 listed Korean companies …» 이렇게 뜨는데 배포한 지 얼마 안돼 이러는거지?」

   ⛔ 배포 탓이 «아니었다». 라이브와 저장소를 맞대어 재니 글자까지 같았다(실측).
   진짜 까닭은 이것이다 — 하루 전 시장 축(Seoul · Abu Dhabi · Dubai)을 «/data 진열장에만»
   넣고 이 첫 화면은 안 고쳤다. 이 목록은 /data 와 «따로 적힌 목록»이라 따라오지 않는다.
   ⇒ 머리글은 「Asia & Gulf」인데 그 아래 여섯 칸이 전부 한국이었다.
     손님이 열어 보고서야 한국뿐임을 알게 되는 것이고, 그 순간 머리글이 거짓말이 된다.

   ✅ 그래서 칸마다 «어느 시장인가»를 글자로 박는다 — 열기 «전»에 알게 한다.
   ⛔ 두 지면이 서로 다른 시장을 말하면 손님은 둘 다 못 믿는다.
      /data 를 고치면 여기도 «같은 커밋»에서 고친다. 그 반대도 같다.
   ⚠ 여기에 없는 시장(상하이·홍콩·대만·사우디)은 아직 상품이 없다. 머리글 coverage 줄에
      「In build」로 적혀 있고, 그 줄이 정본이다. 없는 것을 이 칸에 미리 세우지 않는다. */
const PRODUCTS = [
  /* 🔴 맨 앞은 스크리너다 — 여기 실린 것 가운데 «두 시장을 한 표에서» 보여 주는 유일한 것이고,
     손님이 자기 물음을 넣을 수 있는 유일한 것이다. 나머지는 우리가 고른 표를 읽는 것이다. */
  { name: 'Asia & Gulf Screener', href: '/data/screener', mkt: 'Seoul · Abu Dhabi · Dubai',
    one: 'Filter 2,834 listed companies yourself, in US dollars — and see how many a filter drops '
      + 'because the figure does not exist rather than because they failed it.', cta: 'Open' },
  { name: 'Financial Statement Tape', href: '/data/financials', mkt: 'Seoul',
    one: 'Filed accounts for Korean listed companies, in English field names.', cta: 'Open' },
  { name: 'Gulf Filings Tape', href: '/data#buy', mkt: 'Abu Dhabi · Dubai',
    one: 'Revenue, net profit and EPS from every ADX and DFM filing, with disclosures ranked by '
      + 'likely price impact.', cta: 'Open' },
  { name: 'Valuation Tape', href: '/data/valuation', mkt: 'Seoul',
    one: 'PER, PBR, ROE and debt ratio — with the statement edition each figure came from.', cta: 'Open' },
  { name: 'Index Tape', href: '/data/indices', mkt: 'Seoul',
    one: '168 KRX indices with English names, constituent counts and base dates.', cta: 'Open' },
  { name: 'Consensus Tape', href: '/data/target-changes', mkt: 'Seoul',
    one: 'Every analyst target we collect, split into raised, cut and newly initiated.', cta: 'Open' },
  { name: 'Ownership Filings', href: '/data/ownership', mkt: 'Seoul',
    one: 'Substantial-shareholding disclosures, including where the share count moved quietly.', cta: 'Open' },
  { name: 'Concentration Index', href: '/data/concentration', mkt: 'Seoul',
    one: 'How much of the KOSPI is one company, and how much of trade is one country.', cta: 'Open' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: SITE.name,
  description: SITE.description,
  url: SITE_URL,
  isPartOf: { '@id': `${SITE_URL}/#organization` },
};
---

<Base title="Asia & Gulf filings data in English — Korea, UAE, and more" description="Filings data from Asia and the Gulf in English under one schema: Korean listed companies (KRX / DART) and the United Arab Emirates (ADX and DFM) live today, with China, Hong Kong, India, Saudi Arabia and Taiwan in build. Financial statements, valuations, indices, analyst consensus and ownership — every figure with its source and timestamp." jsonLd={jsonLd}>
  <div class="wrap">
    {/* 🔴 [2026-09-12 · 5번] 사장님 지시로 첫 화면을 «상품 소개»로 다시 짰다.
        > 「메인을 상품소개 위주로 재구성해라. 우리는 콘텐트 생산이 아닌 영어판 FnGuide임을
        >  유저들이 바로 알 수 있게 해라. 아직 개발이 끝나지 않았더라도 바로 조치하도록」

        전에는 기사 목록이 첫 화면에 서 있었다. 그러면 손님은 이곳을 «글 읽는 곳»으로 읽는다.
        우리가 파는 것은 «자료»다. 그래서 무엇을 파는지를 맨 위로 올린다.
        ⛔ 기사를 없애지 않는다 — 아래로 내린다. 깔때기 노릇은 그대로다. */}
    <div class="page-head">
      <p class="kicker">{SITE.tagline}</p>
      <h1>Asia &amp; Gulf filings data, in English</h1>
      <p>
        We are a data company, not a newsroom. The filings behind Asian and Gulf equities are
        published in Korean, in Arabic, one company at a time, one regulator at a time. We compile
        them into English panel data under a single schema — financial statements, valuations,
        indices, analyst consensus and ownership — delivered as pages you can read, CSV files you
        can licence, and an API. Every figure carries its source and the timestamp it came from.
      </p>
      {/* 🔴 [2026-09-14] 이 칸은 /data 지면의 같은 칸과 «글자까지» 맞춰 둔다.
          두 곳이 다른 나라를 말하면 손님은 둘 다 못 믿는다. 하나를 고치면 다른 하나도 고친다. */}
      <p class="coverage">
        <b>Live</b> — Korea (KRX / DART) · United Arab Emirates (ADX and DFM).{' '}
        <b>In build</b> — China A-shares, Hong Kong, India, Saudi Arabia and Taiwan.{' '}
        <span>Same schema, same licence, same price. A new market is not a new contract.</span>
      </p>
    </div>

    {/* 🔴 [2026-09-14] 광고를 «소개 아래»로 내렸다. 위에 두었더니 휴대폰 400px 에서
        385px 을 먹고 h1 을 y=709 로 밀어, 첫 화면이 통째로 흰 여백이었다(실측).
        ⛔ 광고를 지우지 않는다 — 자리만 바꾼다. */}
    <AdSlot slot="banner" />

    <section class="products" aria-labelledby="products-h">
      <h2 id="products-h">What we sell</h2>
      {/* 🔴 [2026-09-15 · 사장님] 「s마켓츠 **상품 소개를 보다가 바로 결제를 해야 하는 데
          결제할 수 있는 게 없다**」
          ⛔ 맞다. 이 칸은 「What we sell」인데 카드마다 길이 «읽는 지면»으로만 났다.
             사려는 손님은 /data 를 찾아 들어가 스스로 스크롤해야 했다.
             ⇒ 파는 자리에서 «사는 단추»가 안 보이면 안 파는 것과 같다.
          ✅ 그래서 카드마다 길을 «둘»로 낸다 — 무엇인지 보는 길, 그 자리에서 사는 길.
          ⛔ 두 길을 겹치지 않는다. 겉 <a> 안에 <a> 를 넣으면 브라우저가 무너뜨린다 —
             카드 전체를 덮는 링크를 쓰지 않고 «두 단추»를 나란히 둔다. */}
      <ul class="pgrid">
        {PRODUCTS.map((p) => (
          <li class="pcard">
            <div class="pin">
              {/* ⛔ 시장을 제목 «뒤»에 두지 않는다. 손님이 제일 먼저 묻는 것이
                  「내 시장이 있나」라서, 제목보다 먼저 읽히는 자리에 둔다 */}
              <span class="pmkt">{p.mkt}</span>
              <h3><a href={p.href}>{p.name}</a></h3>
              <p>{p.one}</p>
              <div class="pacts">
                <a class="pgo" href={p.href}>{p.cta} →</a>
                <a class="pbuy" href="/data#buy">Licence it →</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
      {/* 🔴 [2026-09-14 · 6번 감수] 값을 여기 새로 적지 않는다 — licence-products.mjs 가
          정본이다(헤더 주석: "지면의 값과 페이팔이 받는 값이 어긋나면 그것이 사고다").
          이전엔 KRW 로 된 옛 값(사장님이 이미 「달러로만」로 바꾸라 하신 것)이 남아 있었다. */}
      <p class="plicence">
        <b>Licence</b> — academic <b>$79</b> one-time · single dataset <b>$990/yr</b> or{' '}
        <b>$99/mo</b> · all datasets <b>$2,990/yr</b> or <b>$299/mo</b>.{' '}
        <a href="/data">See every dataset and what is in it →</a>
      </p>
      {/* ⛔ 값만 적어 두고 끝내지 않는다. 값을 읽은 바로 그 자리에서 살 수 있어야 한다.
          카드가 아니라 «묶음 전체»를 사려는 손님이 갈 곳이 여기다. */}
      <p class="pbuyline">
        <a class="pbuybig" href="/data#buy">Buy a licence now</a>
        <span>Card or PayPal, in US dollars, from any country &mdash; no account with us, and no
        automatic renewal. Need an invoice for procurement?{' '}
        <a href="mailto:admin@klifedesign.net">write to us</a>.</span>
      </p>
      {/* ⛔ 다 된 것처럼 적지 않는다. 어디까지 채워졌는지는 «지면마다» 적혀 있다 */}
      <p class="pnote">
        Coverage, the number of companies and the last update date are stated on each dataset
        page. Where a series is still being filled in, the page says so.
      </p>
    </section>

    {/* 무료 데이터 허브로 가는 눈에 띄는 링크 — 홈(최강 지면)의 권위를 허브로 보내고,
        방문자에게 실수요 질문("how much of the KOSPI is Samsung" 등)을 그대로 노출한다.
        2026-08-24 방문 올인: 내부링크 집중. */}
    <a class="data-hub" href="/data/concentration">
      <span class="dh-tag">Free data</span>
      <span class="dh-body"><b>The Korea Concentration Index</b> — how much of the KOSPI is Samsung,
      how many companies are listed, and who Korea trades with. Charts, a CSV and sources. →</span>
    </a>

    {/* 2026-09-09 · 2번 — P5 무료 지면이 오늘 2/4 로 늘었다(target-changes·ownership).
        최소 조치로 홈에 링크만 더한다 — 기존 자리·문구는 안 건드린다. 배치·문구를
        다시 짜는 것은 4번의 실측(09-12, 지면별 열린 횟수)을 보고 할 일이다(5번 승인). */}
    <a class="data-hub" href="/data/target-changes">
      <span class="dh-tag">Free data</span>
      <span class="dh-body"><b>Who moved a Korean target price</b> — every analyst report we collect,
      sorted by raised, cut or newly initiated. The denominator is on the page, not hidden. →</span>
    </a>

    <a class="data-hub" href="/data/ownership">
      <span class="dh-tag">Free data</span>
      <span class="dh-body"><b>Korean ownership filings</b> — substantial-shareholding disclosures
      where the stake looked unchanged but the share count moved. Charts, a CSV and sources. →</span>
    </a>

    {
      articles.length === 0 ? (
        <>
          <HomeCharts />
          <p class="empty">No articles published yet.</p>
        </>
      ) : (
        <>
          <ul class="stream">
            <ArticleCard entry={lead} lead />
            {rest.slice(0, 4).map((entry) => (
              <ArticleCard entry={entry} />
            ))}
          </ul>

          {/* 사장님 지시(2026-08-26): 시장 움직임 패널을 첫 5편 «뒤»로 내린다.
              첫 화면은 무엇을 하는 매체인가(히어로+무료데이터+기사)로 열고,
              시장 대시보드는 스크롤 중간에 둔다. */}
          <HomeCharts />

          {rest.length > 4 && (
            <ul class="stream">
              {rest.slice(4).map((entry) => (
                <ArticleCard entry={entry} />
              ))}
            </ul>
          )}
        </>
      )
    }

    {/* 기사 스트림 **뒤**에 둔다. 첫 화면을 가입 요청으로 막지 않는다 —
        무엇을 하는 매체인지 먼저 보여 주고 그 다음에 권한다. */}
    <Newsletter source="home" />

    <div class="cat-grid">
      {
        CATEGORIES.map((c) => (
          <a class="cat-card" href={`/${c.slug}`}>
            <h3>{c.label}</h3>
            <p>{c.blurb}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  /* 🔴 [2026-09-14] 덮는 시장을 적는 줄 — /data 지면과 «같은 모양»으로 둔다.
     모양이 다르면 손님은 다른 회사의 지면으로 읽는다. 한쪽을 고치면 다른 쪽도 고친다. */
  .coverage {
    margin: .7rem 0 0; padding: .7rem .9rem;
    border-left: 3px solid var(--accent, #b4884a);
    background: var(--paper-2, rgba(127,127,127,.07));
    font-size: .95rem; line-height: 1.6;
  }
  .coverage span { color: var(--ink-2, #555); }
  .data-hub {
    display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap;
    margin: 0 0 1.4rem; padding: .8rem 1rem;
    border: 1px solid var(--accent, #0f4c81);
    border-left-width: 4px; border-radius: 6px;
    text-decoration: none; color: inherit;
    background: color-mix(in srgb, var(--accent, #0f4c81) 6%, transparent);
  }
  .data-hub:hover { background: color-mix(in srgb, var(--accent, #0f4c81) 12%, transparent); }
  .dh-tag {
    font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700;
    color: #fff; background: var(--accent, #0f4c81); padding: .15rem .5rem; border-radius: 3px; white-space: nowrap;
  }
  .dh-body { font-size: .95rem; line-height: 1.5; }
  .dh-body b { font-weight: 650; }

  /* ── 상품 칸 (2026-09-12) ─────────────────────────────────────────
     ⚠ 390px 에서 눈으로 보고 잡았다 — 카드가 두 줄로 겹치지 않게 최소폭을 잡는다 */
  .products { margin: 0 0 2rem; }
  .products h2 {
    font-size: 1.05rem; letter-spacing: .02em; margin: 0 0 .9rem;
    padding-bottom: .5rem; border-bottom: 2px solid var(--accent, #0f4c81);
  }
  .pgrid {
    list-style: none; margin: 0 0 1rem; padding: 0;
    display: grid; gap: .7rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  .pcard { margin: 0; }
  .pin {
    display: flex; flex-direction: column; height: 100%; padding: .85rem .9rem;
    border: 1px solid var(--line, #e5e5e5); border-radius: 6px;
    background: var(--card, transparent);
  }
  .pin:hover { border-color: var(--accent, #0f4c81); }
  .pcard h3 a { color: inherit; text-decoration: none; }
  .pcard h3 a:hover { text-decoration: underline; }
  /* ⛔ 두 단추를 붙여 두지 않는다 — 손가락으로 누를 때 옆엣것이 눌린다 */
  .pacts { margin-top: auto; display: flex; flex-wrap: wrap; gap: .3rem .9rem; }
  .pbuy { font-size: .8rem; font-weight: 700; color: var(--accent, #0f4c81);
    text-decoration: none; border-bottom: 2px solid currentColor; }
  .pbuy:hover { text-decoration: none; opacity: .8; }
  .pgo { text-decoration: none; }
  .pmkt {
    display: block; margin: 0 0 .2rem;
    font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    color: var(--accent, #0f4c81);
  }
  .pcard h3 { margin: 0 0 .35rem; font-size: .97rem; font-weight: 650; }
  .pcard p { margin: 0 0 .55rem; font-size: .86rem; line-height: 1.5; color: var(--muted, #555); }
  .pgo { font-size: .8rem; font-weight: 650; color: var(--accent, #0f4c81); }
  .pbuyline {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem .9rem;
    margin: 0 0 1rem; font-size: .84rem; color: var(--muted, #555); line-height: 1.5;
  }
  .pbuyline span { flex: 1 1 16rem; }
  .pbuybig {
    display: inline-block; padding: .55rem 1.1rem; border-radius: 6px;
    background: var(--accent, #0f4c81); color: #fff;
    font-size: .92rem; font-weight: 700; text-decoration: none; white-space: nowrap;
  }
  .pbuybig:hover { opacity: .88; }
  .plicence {
    margin: 0 0 .5rem; padding: .7rem .9rem;
    border-left: 4px solid var(--accent, #0f4c81);
    background: color-mix(in srgb, var(--accent, #0f4c81) 6%, transparent);
    font-size: .88rem; line-height: 1.6;
  }
  .pnote { margin: 0; font-size: .8rem; line-height: 1.55; color: var(--muted, #555); }
</style>
