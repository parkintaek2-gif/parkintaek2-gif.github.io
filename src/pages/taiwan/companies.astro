---
/*
 * `/taiwan/companies` — **대만 상장사 지면으로 들어가는 문.**
 *
 * 지면을 찍어 놓고 문이 없으면 검색엔진이 그 안으로 못 들어간다.
 * ⛔ 등수를 매기지 않는다. 회사는 이름 차례다.
 * 🔴 처음에 「TWSE 가 업종 코드만 주고 이름을 안 준다」고 적었다. 틀렸다 —
 *   같은 API 의 t187ap14_L 이 「水泥工業」처럼 이름을 준다. 우리가 안 찾은 것이었다.
 * ⛔ 그래도 사전에 없는 이름은 여전히 null 이다. 짐작해서 붙이지 않는다.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import tape from '../../data/taiwan-financials-tape.json';
import { 주소표만들기 } from '../../lib/company-slug.mjs';
import { 재무줄, 시장줄, 낼만한가, 가운데값, 누계기간, 업종주소 } from '../../lib/taiwan-company-page.mjs';

const 행들 = ((tape as any).rows as any[]).filter((r) => 낼만한가(r));
const meta = (tape as any)._meta ?? {};
const 주소표 = 주소표만들기(행들);

const 회사 = 행들.map((r) => {
  const 줄 = 재무줄(r);
  return {
    code: String(r.code),
    slug: 주소표.get(String(r.code))!,
    name: String(r.name_en),
    revenue: 줄!.revenue,
    net: 줄!.net,
    순이익률: 줄!.순이익률,
    marketCap: 시장줄(r)?.marketCap ?? null,
    업종: String(r.industry_en || '') || null,
    /* 🔴 손익은 그 분기가 아니라 연초부터의 누계다 — 「Q2」가 아니라 「H1」로 적는다 */
    기간: 누계기간(r)?.짧게 ?? null,
  };
}).sort((a, b) => a.name.localeCompare(b.name, 'en'));

const 매출들 = 회사.map((c) => c.revenue).filter((n): n is number => n != null);
const 이익률들 = 회사.map((c) => c.순이익률).filter((n): n is number => n != null);
const 적자 = 회사.filter((c) => c.net != null && c.net < 0).length;
const 순익잰곳 = 회사.filter((c) => c.net != null).length;
const 기간들 = [...new Set(회사.map((c) => c.기간).filter(Boolean))];
const 시총들 = 회사.map((c) => c.marketCap).filter((n): n is number => n != null);
const 시총합 = 시총들.reduce((a, b) => a + b, 0);
/* 업종 문 — 이름이 있는 곳만. ⛔ 못 옮긴 이름으로 지면을 만들지 않았으니 여기도 안 건다 */
const 업종문 = [...회사.reduce((m, c) => {
  if (!c.업종) return m;
  m.set(c.업종, (m.get(c.업종) ?? 0) + 1);
  return m;
}, new Map<string, number>())]
  .map(([이름, 수]) => ({ 이름, 수, 주소: 업종주소(이름) }))
  .filter((x) => x.주소)
  .sort((a, b) => a.이름.localeCompare(b.이름, 'en'));
const 업종없는곳 = 회사.filter((c) => !c.업종).length;

const bn = (n: number | null) =>
  /* ⛔ -0.04 가 「-0」 으로 찍혀 «0인데 음수»처럼 보였다. 소수 한 자리를 늘 남긴다 */
  n == null ? '—' : n.toLocaleString('en-GB', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const pct = (a: number, b: number) =>
  b === 0 ? '—' : `${((a / b) * 100).toLocaleString('en-GB', { maximumFractionDigits: 1 })}%`;
const pc = (n: number | null) =>
  n == null ? '—' : `${(n * 100).toLocaleString('en-GB', { maximumFractionDigits: 1 })}%`;

const title = 'Taiwanese listed companies — financials as filed';
const description = `${회사.length.toLocaleString('en-GB')} Taiwanese listed companies, one page each, built from the year-to-date accounts they file with the Taiwan Stock Exchange. Revenue, profit, assets, liabilities, equity and the ratios computed from them — in New Taiwan dollars.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/taiwan/companies#collection`,
  name: title,
  url: `${SITE_URL}/taiwan/companies`,
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="wrap">
    <nav class="crumbs"><a href="/">SeoulMarkets</a> <span>›</span> Taiwan companies</nav>

    <header>
      <h1>Taiwanese listed companies</h1>
      <p class="lede">
        {회사.length.toLocaleString('en-GB')} companies, one page each, taken from the year-to-date
        accounts they filed with the Taiwan Stock Exchange. In New Taiwan dollars, with no exchange
        rate applied.
      </p>
    </header>

    <p class="warn">
      <b>These figures run from the start of the financial year{기간들.length === 1 ? `, all covering ${기간들[0]}` : ''}.</b>{' '}
      The Taiwan Stock Exchange files income-statement lines cumulatively, so a Q2 filing covers six
      months rather than three; balance-sheet lines are the position on the closing date. Our Korean
      and Japanese pages carry twelve-month accounts, so reading a Taiwanese margin next to a Korean
      one compares unequal spans.
    </p>

    <section class="stats">
      <div><span class="k">Reported a net loss</span><span class="v">{pct(적자, 순익잰곳)}</span><span class="s">{적자} of {순익잰곳}</span></div>
      <div><span class="k">Median revenue</span><span class="v">{bn(가운데값(매출들))}</span><span class="s">TWD bn · {매출들.length} companies</span></div>
      <div><span class="k">Median net margin</span><span class="v">{pc(가운데값(이익률들))}</span><span class="s">{이익률들.length} had both inputs</span></div>
      <div><span class="k">Median market value</span><span class="v">{bn(가운데값(시총들))}</span><span class="s">TWD bn · {시총들.length} companies</span></div>
      <div><span class="k">Combined market value</span><span class="v">{bn(시총합 > 0 ? 시총합 / 1000 : null)}</span><span class="s">TWD trn · the {시총들.length} above, added up</span></div>
    </section>

    <p class="note">
      We show medians, not averages. One very large filer would pull an average far enough to hide
      the ordinary company — and in this market that filer is unusually large.
    </p>

    <section>
      <h2>By classification</h2>
      <p class="note">
        {업종문.length} classifications, named by the exchange itself — we translated the names and
        keep the Chinese on each page.
        {업종없는곳 > 0 && ` ${업종없는곳} companies are not shown here because the exchange did not publish a classification for them; their own pages are still in the list below.`}
      </p>
      <ul class="sectors">
        {업종문.map((s) => (
          <li><a href={`/taiwan/sector/${s.주소}`}>{s.이름}</a> <span class="dim">{s.수}</span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Every company</h2>
      <p class="note">Listed by name, not by size — we do not rank them.</p>
      <div class="scroll">
        <table>
          <thead>
            <tr><th>Company</th><th>Code</th><th>Market value (TWD bn)</th><th>Revenue (TWD bn)</th><th>Net profit (TWD bn)</th><th>Net margin</th></tr>
          </thead>
          <tbody>
            {회사.map((c) => (
              <tr>
                <td class="nm"><a href={`/taiwan/company/${c.slug}`}>{c.name}</a></td>
                <td class="dim">{c.code}</td>
                <td>{bn(c.marketCap)}</td>
                <td>{bn(c.revenue)}</td>
                <td class={c.net != null && c.net < 0 ? 'neg' : ''}>{bn(c.net)}</td>
                <td class={c.순이익률 != null && c.순이익률 < 0 ? 'neg' : ''}>{pc(c.순이익률)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>The other markets on this site</h2>
      <p class="note">Each is built the same way, from filings to that market's own regulator.</p>
      <ul class="more">
        <li><a href="/companies">Korean listed companies</a> — annual accounts, five years</li>
        <li><a href="/japan/companies">Japanese listed companies</a> — annual securities reports</li>
        <li><a href="/uae/companies">UAE listed companies</a> — quarterly filings, Abu Dhabi and Dubai</li>
        <li><a href="/data/screener">Asia &amp; Gulf screener</a> — filter across markets in US dollars</li>
      </ul>
    </section>

    <footer class="src">
      <p>
        <b>Source.</b> Taiwan Stock Exchange (TWSE) open data service, released through Taiwan's
        Open Government Data platform under the Open Government Data License, version 1.0 —
        commercial use permitted with attribution.
        {meta.지은때 && <span class="dim"> Collected {String(meta.지은때).slice(0, 12)}.</span>}
      </p>
      <p>
        <b>Not investment advice.</b> These pages report what was filed. They contain no
        recommendation and no opinion on whether any figure is good or bad.
      </p>
      <p class="dim">
        The exchange publishes these figures in thousands of New Taiwan dollars; we multiply by
        1,000 so every market on this site is stated in whole currency units. We confirmed the unit
        by dividing each company's paid-in capital, published in whole dollars, by its balance-sheet
        capital stock: 388 of 396 came to exactly 1,000.
      </p>
    </footer>
  </article>
</Base>

<style>
  .wrap { max-width: 68rem; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .crumbs { font-size: .85rem; color: #667; margin-bottom: 1rem; }
  .crumbs a { color: #445; text-decoration: none; }
  .crumbs span { margin: 0 .35rem; color: #aab; }
  h1 { font-size: 1.95rem; line-height: 1.25; margin: 0 0 .6rem; }
  .lede { font-size: 1.05rem; color: #334; margin: 0 0 1.2rem; }
  section { margin: 2rem 0; }
  h2 { font-size: 1.2rem; margin: 0 0 .5rem; }
  .note { font-size: .88rem; color: #667; margin: 0 0 .8rem; }
  .warn { font-size: .88rem; color: #665; background: #fbfaf4; border-left: 3px solid #ddd6b8;
          padding: .6rem .85rem; margin: 0 0 1.6rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
           gap: 1rem; margin: 0 0 .8rem; }
  .stats > div { display: grid; gap: .15rem; padding: .9rem 1rem;
                 border: 1px solid #e6e9ef; border-radius: 4px; }
  .stats .k { font-size: .8rem; color: #667; }
  .stats .v { font-size: 1.55rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .stats .s { font-size: .78rem; color: #889; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: .42rem .6rem; border-bottom: 1px solid #e8eaef; text-align: right; }
  thead th { text-align: right; font-size: .82rem; color: #556; border-bottom: 2px solid #d8dbe2; }
  thead th:first-child, tbody td.nm { text-align: left; }
  td.nm a { color: #2a4d8f; text-decoration: none; }
  td.nm a:hover { text-decoration: underline; }
  td.neg { color: #a33; }
  .dim { color: #889; }
  .sectors { list-style: none; padding: 0; margin: .5rem 0 0; display: grid; gap: .3rem 1rem;
             grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .sectors a { color: #2a4d8f; text-decoration: none; font-size: .95rem; }
  .sectors a:hover { text-decoration: underline; }
  .sectors .dim { margin-left: .35rem; }
  .more { list-style: none; padding: 0; margin: 0; display: grid; gap: .35rem; }
  .more a { color: #2a4d8f; text-decoration: none; }
  .more a:hover { text-decoration: underline; }
  .src { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid #e3e6ec;
         font-size: .84rem; color: #556; }
  .src p { margin: .5rem 0; }
  @media (max-width: 640px) { h1 { font-size: 1.5rem; } .wrap { padding: 1rem .8rem 3rem; } }
</style>
